# Template for the gitignored kernel .env (copy to .env, fill in, never commit the .env; the tracked name is env.example because R30 forbids .env.* names). Read by tools/xrun via tools/mkwlancred.py.
# Wi-Fi credentials reach the phone only as the RAM-only WLANCRED blob (docs/specs/SPEC-WIFI.md TRANSPORT block s.3), never as a boot-arg.
PIXOS_WIFI_SSID=
PIXOS_WIFI_PSK=
PIXOS_WIFI_SECURITY=
# static address of the P-W2 ping and its gateway (dotted quads)
PIXOS_WIFI_IP=
PIXOS_WIFI_GW=
