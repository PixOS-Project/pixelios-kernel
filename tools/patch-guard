#!/usr/bin/env python3
"""patch-guard: Claude Code PreToolUse hook (TP-022). A NEW xnu/patches/NNNN-slug.patch may only be created with a number from `tools/patch-numbers next`.

Denies Write/Edit/MultiEdit of a non-existing xnu/patches/NNNN-*.patch, and a Bash command that writes one (redirect, cp, mv, tee, install, git mv/checkout/restore/apply,
format-patch), unless refs/patch-numbers/NNNN reserves that number for that slug (or the same file name is already committed on some branch). Editing an existing patch is
always allowed. The repo that is checked is the one the PATH belongs to (the last `cd DIR` before the path in the command, else the session cwd), and a repo without
tools/patch-numbers (a temp repo, the super repo) is not guarded. Heredoc bodies are ignored. A broken guard fails OPEN (exit 0, no decision).
Guard rail, not a sandbox; the git pre-commit hook (`tools/patch-numbers install-hook`) catches what a script wrote without this hook seeing it.
Second rule (RULES R11, T-eff6): any Write/Edit/MultiEdit, and any Bash command that writes (redirect, cp/mv/tee/install/rsync/ln/rm/touch/chmod/truncate/patch/dd/mkdir, sed -i, git apply/checkout/restore/mv/rm/am),
under the FETCHED upstream XNU tree is denied in every repo: `xnu-pristine/` (Apple's xnu tag, docs/LOCAL-BUILD.md) and `localbuild/work/<label>/xnu/` (the staged copy xnu-local-build patches; tools/xnu-local-build:540).
Reads (cat, grep, diff, cp OUT of the tree) pass. Escape: none from the agent (change the patch in xnu/patches/ and rebuild; a human may edit the tree by hand).
Stdin: the hook JSON. Stdout: a deny decision or nothing. Always exit 0. Test: tools/test_patch_guard.py.
"""
if __import__("sys").argv[1:2] in (["-h"], ["--help"]):  # T-7dff:help: usage before any import or side effect
    print("usage: " + __file__.rsplit("/", 1)[-1] + "\n" + (__doc__ or "".join(l[2:] for l in open(__file__).readlines()[1:60] if l.startswith("# "))).strip()); raise SystemExit(0)
import importlib.machinery, importlib.util, json, os, re, shlex, subprocess, sys

TOK = re.compile(r"(\S*xnu/patches/(\d{4})-([^/\s'\"]+?)\.patch)")
HEREDOC = re.compile(r"<<-?\s*(['\"]?)(\w+)\1[^\n]*\n.*?\n[ \t]*\2[ \t]*(?=\n|$)", re.S)
WRITER = re.compile(r"^\s*(sudo\s+)?(cp|mv|tee|install|rsync|ln)\b|^\s*git\s+(mv|checkout|restore|apply)\b|format-patch|\bsed\s+[^;|&]*\bw\s")


UPSTREAM = re.compile(r"(?:^|/)(?:xnu-pristine|localbuild/work/[^/]+/xnu)(?:/|$)")
SEP = re.compile(r"&&|\|\||;|\||\n")
ALL_ARGS = {"mv", "tee", "rm", "touch", "chmod", "chown", "truncate", "patch", "mkdir", "rmdir", "unlink", "shred"}
DEST_ONLY = {"cp", "install", "rsync", "ln"}
GIT_WRITE = {"apply", "checkout", "restore", "mv", "rm", "am", "clean", "reset", "stash", "cherry-pick", "merge", "pull"}
UP_WHY = ("%s is under the fetched upstream XNU tree (RULES R11): that tree is Apple's source, changes live only as numbered patches in xnu/patches/ (tools/patch-numbers next), "
          "and a hand edit is lost on the next xnu-local-build / CI fetch. Instead: edit or add the patch in xnu/patches/ (get the patched tree from the xnu-buildtree CI artifact or a `tools/xnu-local-build` work tree to diff), "
          "then rebuild. Escape: none (a human may edit the tree by hand outside the agent).")


def is_upstream(path, base):
    p = os.path.normpath(path if os.path.isabs(path) else os.path.join(base, path))
    return bool(UPSTREAM.search(p + "/"))


def upstream_write(cmd, cwd):
    """-> the first path a WRITING command in CMD puts under the upstream XNU tree, else ''. Parsed words, so a command that only reads or quotes the path passes."""
    cmd = HEREDOC.sub(lambda m: m.group(0).split("\n", 1)[0], cmd)
    base = cwd
    for seg in SEP.split(cmd):
        seg = seg.strip()
        if not seg:
            continue
        for m in re.finditer(r"(?<![0-9&>])>>?\s*([^\s&|;<>]+)", seg):
            t = os.path.expanduser(m.group(1).strip("'\""))
            if is_upstream(t, base):
                return t
        try:
            w = shlex.split(seg)
        except ValueError:
            w = seg.split()
        while w and (w[0] in ("sudo", "env", "command", "nohup", "time", "nice") or re.fullmatch(r"\w+=\S*", w[0])):
            w = w[1:]
        if not w:
            continue
        h, args = os.path.basename(w[0]), [os.path.expanduser(x) for x in w[1:]]
        if h in ("cd", "pushd") and args:
            base = os.path.normpath(os.path.join(base, args[0]))
            continue
        ops = [x for x in args if not x.startswith("-") and not re.fullmatch(r"\w+=\S*", x)]
        if h == "dd":
            ops = [x[3:] for x in args if x.startswith("of=")]
            hit = [x for x in ops if is_upstream(x, base)]
        elif h == "sed" and any(re.fullmatch(r"-[A-Za-z]*i[A-Za-z]*|--in-place.*", x) for x in args):
            hit = [x for x in ops if is_upstream(x, base)]
        elif h == "git" and ops and ops[0] in GIT_WRITE:
            hit = [x for x in ops[1:] if is_upstream(x, base)] or ([base] if is_upstream(base, "/") else [])
        elif h in ALL_ARGS or h in DEST_ONLY:
            pick = ops[-1:] if h in DEST_ONLY else ops
            hit = [x for x in pick if is_upstream(x, base)]
            if h == "patch" and not hit and is_upstream(base, "/"):
                hit = [base]      # `cd xnu-pristine && patch -p1 < x` has no path operand
        else:
            hit = []
        if hit:
            return hit[0]
    return ""


def repo_of(path):
    d = path if os.path.isdir(path) else os.path.dirname(path)
    while d and not os.path.isdir(d):
        d = os.path.dirname(d)
    r = subprocess.run(["git", "-C", d or ".", "rev-parse", "--show-toplevel"], capture_output=True, text=True)
    return r.stdout.strip() if r.returncode == 0 else ""


def load_pn(root):
    ldr = importlib.machinery.SourceFileLoader("pn", os.path.join(os.path.dirname(os.path.abspath(__file__)), "patch-numbers"))
    mod = importlib.util.module_from_spec(importlib.util.spec_from_loader("pn", ldr))
    ldr.exec_module(mod)
    mod.ROOT = root
    return mod


def allowed(pn, num, slug):
    n = int(num)
    for k in pn.survey().get(n, {}):
        m = pn.PAT.match(k)
        if m and m.group(2) == slug:
            return True  # already committed under exactly this name somewhere
    r = pn.reservations().get(n)
    return bool(r) and r["name"] in ("?", "", slug)


def deny(why):
    print(json.dumps({"hookSpecificOutput": {"hookEventName": "PreToolUse", "permissionDecision": "deny", "permissionDecisionReason": why}}))


def bash_targets(cmd, cwd):
    """(absolute path, number, slug) of every patch path a WRITING segment of CMD names"""
    cmd = HEREDOC.sub(lambda m: m.group(0).split("\n", 1)[0], cmd)
    out = []
    for m in TOK.finditer(cmd):
        seps = list(re.finditer(r"&&|\|\||;|\||\n", cmd[:m.start()]))
        seg = cmd[seps[-1].end():m.end()] if seps else cmd[:m.end()]
        redirect = re.search(r">>?\s*$", cmd[:m.start()])
        if not (redirect or WRITER.search(seg)):
            continue
        base = cwd
        for c in re.findall(r"(?:^|&&|;|\n)\s*cd\s+(\S+)", cmd[:m.start()]):
            base = os.path.normpath(os.path.join(base, os.path.expanduser(c)))
        tok = os.path.expanduser(m.group(1))
        out.append((os.path.normpath(tok if os.path.isabs(tok) else os.path.join(base, tok)), m.group(2), m.group(3)))
    return out


def main():
    try:
        d = json.load(sys.stdin)
        ti = d.get("tool_input") or {}
        cwd = d.get("cwd") or os.getcwd()
        targets = []
        up = ""
        if d.get("tool_name") in ("Write", "Edit", "MultiEdit", "NotebookEdit"):
            fp = os.path.normpath(ti.get("file_path", "") or ti.get("notebook_path", ""))
            up = fp if is_upstream(fp, cwd) else ""
        elif d.get("tool_name") == "Bash":
            up = upstream_write(ti.get("command", ""), cwd)
        if up:
            deny(UP_WHY % up)
            return 0
        if d.get("tool_name") in ("Write", "Edit", "MultiEdit"):
            fp = os.path.normpath(ti.get("file_path", ""))
            m = TOK.search(fp)
            if m:
                targets.append((fp, m.group(2), m.group(3)))
        elif d.get("tool_name") == "Bash":
            targets = bash_targets(ti.get("command", ""), cwd)
        for path, num, slug in targets:
            if os.path.exists(path):
                continue  # editing an existing patch
            root = repo_of(path)
            if not root or not os.path.isfile(os.path.join(root, "tools", "patch-numbers")):
                continue  # not a kernel repo: not guarded
            if not allowed(load_pn(root), num, slug):
                deny("new xnu patch %s-%s.patch: the number is not reserved for it. Run `tools/patch-numbers next --owner NAME --name %s` and use the number it prints "
                     "(branches diverge, so \"the next number\" collides; see docs/AUTOMATION.md 'One numbering for xnu/patches'). Already wrote it? `tools/patch-numbers claim %s --owner NAME --name %s`."
                     % (num, slug, slug, num, slug))
                return 0
    except Exception as _err:  # noqa: BLE001 - a broken guard must not block work
        print(f"patch-guard GAP: guard crashed ({type(_err).__name__}: {_err}): the patch number was NOT checked", file=sys.stderr)
        return 0
    return 0


if __name__ == "__main__":
    sys.exit(main())
