#!/bin/bash
# One shim probe cycle: phone-state -> build -> USB capture -> fboot -> wait for the result line -> phone back? -> ONE report.
#   tools/probe-run [--touch-probe[=OPTS] | --build-args "..."] [--expect REGEX]... [--timeout S] [--label NAME] [--lock-wait S]
#   tools/probe-run --dry-run --from-dir DIR [--expect REGEX]...     (re-read DIR/usb.txt, touches nothing)
#   tools/probe-run --self-test
# First line: RESULT: PASS|FAIL|HANG|TIMEOUT|ERROR ...   Exit 0 PASS / 1 FAIL, HANG or TIMEOUT / 2 ERROR.
# TIMEOUT (TP-015) = expected line missing at --timeout AND the phone did not come back AND `tools/phone state` says shim-probe AND usb.txt was written in the last PR_STILL (15) s: the shim is still running, raise --timeout, not a hang (AP-14).
# A --reject match is a FAIL even with lines missing. Known gap (review B1 optional): the "last usb line Ns after fboot" figure uses the capture start, not the fboot end.
# --timeout defaults to 600 when the build args contain --wlan-link (the LINK steps need ~170-190 s, AP-14). --reject REGEX (repeatable; default for "LINK summary" expects: stopped=timeout|fault|refused or restore=FAILED) turns a found run into FAIL (TP-015 amendment).
# HANG = expected line never came AND the phone is not back (fastboot/recovery) within the wait window (120 s): hold Power+VolDown.
# The phone legitimately leaves USB for a while when the shim reboots, so "absent" right after the result line is normal.
# Test hooks (self-test only): PR_PHONE (tools/phone) PR_PHONE_STATE PR_TO_FASTBOOT PR_FBOOT PR_USBLOG PR_BUILD PR_BACK (seconds to wait for the phone) PR_USBPRESENT (command: exit 0 if a Google USB device is on the bus).
# The phone leaves USB for about 30 s after a shim run and then shows up in recovery (observed by the Wi-Fi agent, HANDOFF session 28; not re-measured): waiting for it is part of the run (default 120 s), and a slow return is
# reported as such, never as a hang. HANG (hold Power+VolDown) needs: expected lines missing AND no Google USB device at all after the window.
cd "$(dirname "$0")/.." || exit 2
PS=${PR_PHONE_STATE:-tools/phone-state}; PH=${PR_PHONE:-tools/phone}; TOFB=${PR_TO_FASTBOOT:-tools/to-fastboot.sh}; FBOOT=${PR_FBOOT:-tools/fboot.sh}
USBLOG=${PR_USBLOG:-"python3 tools/usb-log.py"}; BUILD=${PR_BUILD:-./build.sh}; BACK=${PR_BACK:-120}; USBP=${PR_USBPRESENT:-"grep -qsx 18d1 /sys/bus/usb/devices/*/idVendor"}
. tools/plock.sh   # TP-020: the phone lock is taken after the build, right before the phone is used

usage() { echo "usage: $0 [--touch-probe[=OPTS] | --build-args \"...\"] [--expect REGEX]... [--reject REGEX]... [--timeout S] [--label NAME] | --dry-run --from-dir DIR | --self-test" >&2; exit 2; }

check_expects() { # LOG -> sets missing (list of unmatched regexes)
	local e; missing=()
	for e in "${expects[@]}"; do grep -Eq -- "$e" "$1" 2>/dev/null || missing+=("$e"); done
}

check_rejects() { # LOG -> sets rejected (first matching --reject regex or empty); review 4 F1: a failed LINK run also matches "LINK summary"
	local e; rejected=""
	for e in "${rejects[@]}"; do grep -Eq -- "$e" "$1" 2>/dev/null && { rejected=$e; return 0; }; done
	return 0
}

keylines() { # LOG -> up to 12 lines
	local log=$1 pat res oth
	if [ -n "$touch" ]; then pat='VARIANT|identify|loopback|rst|ACPM'; else pat=$(IFS='|'; echo "${expects[*]}"); fi
	res=$(grep -E 'SWEET TOUCH RESULT' "$log" 2>/dev/null | tail -12)
	oth=$(grep -E -- "$pat" "$log" 2>/dev/null | grep -v 'SWEET TOUCH RESULT' | tail -n $(( 12 - $(echo -n "$res" | grep -c .) )))
	{ [ -n "$res" ] && echo "$res"; [ -n "$oth" ] && echo "$oth"; } | cut -c1-200 | tail -12
}

report() { # VERDICT TEXT  (uses $dir $log); prints, writes report.txt unless dry
	local v=$1 txt=$2 out
	out=$(echo "RESULT: $v $txt"; [ -s "$log" ] && keylines "$log"; echo "dir: $dir")
	echo "$out"; [ -n "$dry" ] || echo "$out" >"$dir/report.txt"
	case $v in PASS) exit 0 ;; ERROR) exit 2 ;; *) exit 1 ;; esac
}

phone_back() { # waits up to $BACK s for fastboot or recovery (recovery -> to-fastboot once); prints state
	local end=$(( $(date +%s) + BACK ))
	while :; do
		$PS --expect fastboot --wait 1 >/dev/null 2>&1 && { echo fastboot; return 0; }
		if $PS --expect recovery --wait 1 >/dev/null 2>&1; then
			timeout 120 $TOFB 60 >/dev/null 2>&1 && { echo "recovery->fastboot"; return 0; }
			echo recovery; return 0
		fi
		[ "$(date +%s)" -lt "$end" ] || return 1
		sleep 1
	done
}

main() {
	local lockwait=0 args=() timeout="" label=probe from="" touch="" cap="" rc extra
	expects=(); rejects=(); dry=""
	while [ $# -gt 0 ]; do case "$1" in
		--touch-probe|--touch-probe=*) touch=1; args+=(--pstore-fast "$1"); shift ;;
		--build-args) [ $# -ge 2 ] || usage; read -ra extra <<<"$2"; args+=("${extra[@]}"); shift 2 ;;
		--expect) [ $# -ge 2 ] || usage; expects+=("$2"); shift 2 ;;
		--reject) [ $# -ge 2 ] || usage; rejects+=("$2"); shift 2 ;;
		--timeout) timeout=${2:-}; shift 2 ;; --label) label=${2:-}; shift 2 ;;
		--dry-run) dry=1; shift ;; --from-dir) from=${2:-}; shift 2 ;; --lock-wait) lockwait=${2:-0}; [[ $lockwait =~ ^[0-9]+$ ]] || { echo "RESULT: ERROR --lock-wait needs whole seconds"; exit 2; }; shift 2 ;;
		*) usage ;; esac; done
	# the shim sends ~12 sections spaced 3 s apart BEFORE the touch/ACPM lines (first seen at ~65 s): 60 s cut them off
	[ -n "$timeout" ] || { [ -n "$touch" ] && timeout=240 || timeout=60; case "${args[*]}" in *--wlan-link*) timeout=600 ;; esac; }
	[[ "$timeout" =~ ^[0-9]+$ ]] || usage
	label=$(echo "$label" | tr -c 'A-Za-z0-9._-' _)
	[ ${#args[@]} -gt 0 ] || [ -n "$dry" ] || usage
	# railsr/rails print an earlier "rails read:" RESULT: wait for the line that ends the run, or the capture is cut mid-update
	if [ -n "$touch" ] && [ ${#expects[@]} = 0 ]; then
		case "${args[*]}" in *railsr*) expects=("rails read:") ;; *rails*) expects=("rails update:") ;; *) expects=("SWEET TOUCH RESULT") ;; esac
		case "${args[*]}" in *=run*|*,run*) expects=("${expects[@]}" "TOUCH RESULT: opts=") ;; esac	# the run ends with the opts= summary
	fi
	if [ ${#expects[@]} = 0 ]; then [ -n "$dry" ] || usage; expects=("SWEET TOUCH RESULT"); touch=1; fi

	if [ ${#rejects[@]} = 0 ]; then
		local e; for e in "${expects[@]}"; do case "$e" in *"LINK summary"*) rejects=('stopped=(timeout|fault|refused)|restore=FAILED') ;; esac; done
	fi

	if [ -n "$dry" ]; then
		[ -n "$from" ] && [ -f "$from/usb.txt" ] || { echo "RESULT: ERROR --dry-run needs --from-dir with usb.txt"; exit 2; }
		dir=$from log=$from/usb.txt; check_expects "$log"
		check_rejects "$log"; [ -z "$rejected" ] || report FAIL "dry-run: reject pattern matched: $rejected"
		[ ${#missing[@]} = 0 ] && report PASS "dry-run: all ${#expects[@]} expect(s) found"
		report FAIL "dry-run: missing: ${missing[*]}"
	fi

	dir=logs/probe/$(date -u +%Y%m%dT%H%M%SZ)-$label log=$dir/usb.txt; mkdir -p "$dir"
	printf '%s\n' "${args[*]}" >"$dir/run.args"   # review B2: tools/runs groups history by these build args (the form), labels are unique per run
	trap '[ -z "$cap" ] || kill "$cap" 2>/dev/null; plock_drop' EXIT

	# 1. build (no phone lock: builds and gates never hold it)
	# gadget window is only a MINIMUM (shim.c usb_gadget_finish runs after the probe): default 600 s would idle the phone ~10 min before its reset
	mkdir -p shim/out   # shim/out is shared with gates: build under its lock and boot a private copy (same as xrun)
	# under `phone-lock run` the phone is already ours: wait only 60 s for a gate that holds shim/out, otherwise up to an hour (the phone is not held)
	local fw=3600; tools/phone-lock check >/dev/null 2>&1 && fw=60
	( flock -x -w $fw 9 || { echo "shim/out busy: a gate or build in this worktree holds shim/out/.build.lock" >&2; exit 98; }
	  (cd shim && USB_WINDOW=${USB_WINDOW:-30} $BUILD --board bluejay --avb --usb-gadget "${args[@]}" 9>&-) &&
	  { [ ! -f shim/out/shim-boot-avb.img ] || { cp shim/out/shim-boot-avb.img "$dir/shim-boot-avb.img" && cp shim/out/shim-boot-avb.img.meta.json "$dir/shim-boot-avb.img.meta.json" 2>/dev/null; true; }; } ) 9>shim/out/.build.lock >"$dir/build.log" 2>&1 ||
		report ERROR "build failed (see $dir/build.log: $(tail -1 "$dir/build.log" | cut -c1-100))"
	# 2. take the phone, then check it is in fastboot
	plock_take probe-run "$lockwait" || report ERROR "phone lock busy: $PLOCK_MSG"
	if ! $PS --expect fastboot --wait 20 >/dev/null 2>&1; then
		timeout 120 $TOFB 60 >/dev/null 2>&1 && $PS --expect fastboot --wait 20 >/dev/null 2>&1 ||
			report ERROR "phone is not in fastboot: reboot it to the bootloader (hold Power+VolDown) or run tools/to-fastboot.sh, check tools/phone-state"
	fi
	# 3. capture BEFORE the boot (the gadget enumerates seconds after fboot)
	local t0; t0=$(date +%s)
	$USBLOG capture --out "$log" >/dev/null 2>"$dir/capture.err" & cap=$!
	# 4. boot
	$FBOOT --expect probe --max-age-min $(( lockwait / 60 + 30 )) "$dir/shim-boot-avb.img" >"$dir/fboot.log" 2>&1 ||
		report ERROR "fboot refused/failed (see $dir/fboot.log: $(tail -1 "$dir/fboot.log" | cut -c1-100))"
	# 5. wait for every expect, bounded
	local end=$(( $(date +%s) + timeout )) timed_out=""
	while :; do
		check_expects "$log"; [ ${#missing[@]} = 0 ] && break
		[ "$(date +%s)" -lt "$end" ] && { kill -0 "$cap" 2>/dev/null || { sleep 1; check_expects "$log"; break; }; sleep 1; continue; }   # capture ends when the phone leaves USB
		timed_out=1; break
	done
	# 6. phone back? (absent right after the result line is normal). The capture keeps running meanwhile: a shim still logging at the limit is not a hang
	# TP-015: at the limit with lines missing, ask `tools/phone state` BEFORE waiting for fastboot: shim-probe = the shim is still running
	local pstate="" age0=999
	[ -z "$timed_out" ] || { check_expects "$log"; [ ${#missing[@]} = 0 ] || { pstate=$($PH state 2>/dev/null | grep -o 'state=[a-z-]*' | tail -1); [ ! -f "$log" ] || age0=$(( $(date +%s) - $(stat -c %Y "$log") )); }; }
	local back; back=$(phone_back) && rc=0 || rc=1
	[ -z "$cap" ] || { kill "$cap" 2>/dev/null; wait "$cap" 2>/dev/null; cap=""; }   # SIGTERM flushes the last partial line
	check_expects "$log"                                                              # ...and the verdict sees it
	local age=999; [ -f "$log" ] && age=$(( $(date +%s) - $(stat -c %Y "$log") ))
	# 7. verdict
	# review B1: a reject match is a FAIL whether or not lines are missing; TIMEOUT needs the phone NOT back (rc!=0) and the log still growing at the limit
	check_rejects "$log"; [ -z "$rejected" ] || report FAIL "reject pattern matched: $rejected"
	if [ -n "$timed_out" ] && [ ${#missing[@]} != 0 ] && [ $rc != 0 ] && [ "$pstate" = state=shim-probe ] && [ "$age0" -lt "${PR_STILL:-15}" ] && [ "$age" -lt "${PR_STILL:-15}" ]; then
		local last=$(( $(stat -c %Y "$log" 2>/dev/null || echo "$t0") - t0 )); [ $last -ge 0 ] || last=0
		report TIMEOUT "missing: ${missing[*]} shim still running ($pstate), last usb line ${last}s after fboot, ${timeout}s limit: raise --timeout, this is not a hang"
	fi
	if [ -n "$timed_out" ] && [ ${#missing[@]} != 0 ] && [ $rc != 0 ] && [ "$age" -lt "${PR_STILL:-15}" ]; then
		report FAIL "missing: ${missing[*]}; the shim was still logging at the ${timeout}s limit (last line ${age}s ago): raise --timeout, this is not a hang"
	fi
	if [ ${#missing[@]} = 0 ]; then
		[ $rc = 0 ] && report PASS "all ${#expects[@]} expect(s) found, phone back: $back"
		$USBP && report PASS "all ${#expects[@]} expect(s) found, phone on USB but not fastboot/recovery yet after ${BACK}s (tools/phone-state)"
		report PASS "all ${#expects[@]} expect(s) found, phone not back and no Google USB device after ${BACK}s (the lines were found; if tools/phone-state still shows it absent, hold Power+VolDown)"
	fi
	[ $rc = 0 ] && report FAIL "missing: ${missing[*]} (within ${timeout}s), phone back: $back"
	$USBP && report FAIL "missing: ${missing[*]} (within ${timeout}s); the phone is on USB but not fastboot/recovery after ${BACK}s: tools/phone-state"
	report HANG "missing: ${missing[*]} and no Google USB device after ${BACK}s: hold Power+VolDown, then tools/phone-state"
}

selftest() {
	local PRE="" d self fail=0; d=$(mktemp -d); self=$(readlink -f "$0"); trap 'rm -rf "$d"' RETURN
	# phone-state stub: answers from ST_STATE; ST_GONE=1: only the first call (the pre-flight) sees fastboot
	cat >"$d/ps" <<'S'
#!/bin/bash
want=${2:-}; n=$(cat "$ST_CNT" 2>/dev/null || echo 0); echo $((n+1)) >"$ST_CNT"
st=$ST_STATE; [ -z "$ST_GONE" ] || [ "$n" != 0 ] || st=fastboot
[ "$st" = "$want" ] && { echo "RESULT: PASS state=$st"; exit 0; }
echo "RESULT: FAIL state=$st"; exit 1
S
	printf '#!/bin/bash\necho "RESULT: PASS state=${ST_PHONE:-absent} target=none steps=0"\n' >"$d/ph"   # tools/phone state stub
	printf '#!/bin/bash\nexit 1\n' >"$d/tofb"
	printf '#!/bin/bash\nexit 0\n' >"$d/fboot"
	printf '#!/bin/bash\nmkdir -p out\n' >"$d/build"
	cat >"$d/usblog" <<'S'
#!/bin/bash
[ "$1" = capture ] && { [ -z "$ST_LOG" ] || printf '%b' "$ST_LOG" >"$3"; exec sleep 100; }
S
	chmod +x "$d"/*
	local R='SWEET TOUCH: identify: rx\nSWEET TOUCH RESULT: opts=0x1 id=ok\n'
	chk() { # name expected_rc expected_word env...
		local n=$1 erc=$2 w=$3 out rc; shift 3
		rm -rf "$d/cnt" "$d/w" "$d/lock"; mkdir -p "$d/w/tools" "$d/w/shim"; cp "$self" "$d/w/tools/probe-run"
		cp "$(dirname "$self")/phone-lock" "$(dirname "$self")/plock.sh" "$d/w/tools/"; ( cd "$d/w" && PHONE_LOCK_DIR="$d/lock" eval "$PRE" )
		out=$(cd "$d/w" && env PHONE_LOCK_DIR="$d/lock" PR_PHONE_STATE="$d/ps" PR_TO_FASTBOOT="$d/tofb" PR_FBOOT="$d/fboot" PR_USBLOG="$d/usblog" \
			PR_BUILD="$d/build" PR_PHONE="$d/ph" PR_BACK=3 PR_USBPRESENT=${PR_USBPRESENT:-false} PR_STILL=${PR_STILL:-1} ST_CNT="$d/cnt" "$@" ./tools/probe-run --touch-probe=run --timeout 4 --label t $CHK_ARGS 2>&1); rc=$?
		if [ $rc = "$erc" ] && echo "$out" | head -1 | grep -Eq "^RESULT: $w" && echo "$out" | grep -q '^dir: logs/probe/' \
			&& { [ "$w" = ERROR ] || ls "$d"/w/logs/probe/*/report.txt >/dev/null 2>&1; }; then echo "ok   $n"
		else echo "FAIL $n (rc=$rc): $out"; fail=1; fi
	}
	chk success         0 PASS  ST_STATE=fastboot "ST_LOG=$R"
	[ "$(cat "$d"/w/logs/probe/*/run.args 2>/dev/null)" = "--pstore-fast --touch-probe=run" ] && echo "ok   run.args" || { echo "FAIL run.args: $(cat "$d"/w/logs/probe/*/run.args 2>&1)"; fail=1; }   # review round 2 B4: tools/runs groups history by this file
	chk success-gone    0 PASS  ST_STATE=absent ST_GONE=1 "ST_LOG=$R"     # phone absent after the result line: still PASS
	chk expect-missing  1 FAIL  ST_STATE=fastboot 'ST_LOG=noise\n'
	chk never-back      1 HANG  ST_STATE=absent ST_GONE=1 'ST_LOG=noise\n'
	chk start-absent    2 ERROR ST_STATE=absent ST_LOG=
	chk found-usb-present 0 PASS PR_USBPRESENT=true ST_STATE=absent ST_GONE=1 "ST_LOG=$R"
	chk still-logging   1 FAIL PR_STILL=600 ST_STATE=absent ST_GONE=1 'ST_LOG=noise\n'   # review 13 H3: timed out while the shim was still logging: FAIL "raise --timeout", not HANG
	chk missing-usb-present 1 FAIL PR_USBPRESENT=true ST_STATE=absent ST_GONE=1 'ST_LOG=noise\n'   # on USB, not fastboot: FAIL with phone-state advice, not "hold Power+VolDown"
	chk timeout-shim-alive 1 TIMEOUT PR_STILL=600 ST_PHONE=shim-probe ST_STATE=absent ST_GONE=1 'ST_LOG=noise\n'   # TP-015: missing lines + shim-probe + log still growing = TIMEOUT
	chk REV-timeout-but-phone-back 1 "FAIL missing: .* phone back" PR_STILL=600 ST_PHONE=shim-probe ST_STATE=fastboot 'ST_LOG=noise\n'   # review B1a: the phone came back: a real FAIL
	CHK_ARGS="--reject bad" chk REV-timeout-reject-matched 1 FAIL PR_STILL=600 ST_PHONE=shim-probe ST_STATE=absent ST_GONE=1 'ST_LOG=bad\n'   # B1b
	chk REV-shim-listed-but-silent 1 HANG PR_STILL=0 ST_PHONE=shim-probe ST_STATE=absent ST_GONE=1 'ST_LOG=noise\n'   # B1c: listed but the log is not growing
	chk REV2-hung-after-limit 1 HANG PR_STILL=6 ST_PHONE=shim-probe ST_STATE=absent ST_GONE=1 'ST_LOG=noise\n'   # round 2 B2: shim-probe, silent past the limit, phone never back: not TIMEOUT
	chk timeout-not-shim 1 HANG ST_PHONE=absent ST_STATE=absent ST_GONE=1 'ST_LOG=noise\n'
	CHK_ARGS="--reject bad" chk reject-hit 1 FAIL ST_STATE=fastboot "ST_LOG=${R}bad\n"
	PRE='tools/phone-lock acquire --owner other --pid '$$' >/dev/null' chk lock-busy 2 ERROR ST_STATE=fastboot "ST_LOG=$R"   # TP-020: another owner holds the phone
	PRE=
	mkdir -p "$d/run"; printf '%b' "$R" >"$d/run/usb.txt"
	local out rc; out=$("$self" --dry-run --from-dir "$d/run" 2>&1); rc=$?
	if [ $rc = 0 ] && echo "$out" | head -1 | grep -q '^RESULT: PASS' && [ ! -e "$d/run/report.txt" ]; then echo "ok   dry-run"
	else echo "FAIL dry-run (rc=$rc): $out"; fail=1; fi
	[ $fail = 0 ] && echo "self-test PASS" || echo "self-test FAIL"; return $fail
}

[ "${1:-}" = --self-test ] && { selftest; exit $?; }
main "$@"
