# TYPE = u8 u16 u32 u64 s8 s16 s32 s64 x8 x16 x32 x64 string. A memory fetch through $arg4 or %x3 (the ioctl buffer) is refused except P2's `name=+0($arg4):string`. WF_EXPECT must equal the row count (checked at run time).
WF_PROBES=(
	'P1|p:gpwifi/ioctl dhd_wl_ioctl ifidx=$arg2:s32 cmd=+0($arg3):u32 len=+16($arg3):u32 set=+20($arg3):u8'
	'P2|p:gpwifi/iovar dhd_wl_ioctl cmd=+0($arg3):u32 len=+16($arg3):u32 set=+20($arg3):u8 name=+0($arg4):string|cmd == 262 || cmd == 263'
	'P3|r:gpwifi/ioctl_ret dhd_wl_ioctl rc=$retval:s32'
	'P4|p:gpwifi/cfgevent wl_cfg80211_event etype=+4($arg2):x32 status=+8($arg2):x32 reason=+12($arg2):x32'
	'P5|p:gpwifi/supevent wl_cfg80211_sup_event_handler st=+8($arg3):x32 rsn=+12($arg3):x32'
	'P6|p:gpwifi/capcall dhd_get_fw_capabilities'
	'P7|p:gpwifi/scan wl_cfg80211_scan'
	'P7|p:gpwifi/connect wl_cfg80211_connect'
	'P8|p:gpwifi/d2hmb dhd_bus_handle_mb_data mb=$arg2:x32'
	'P9|p:gpwifi/h2dmb dhdpcie_send_mb_data mb=$arg2:x32'
	'P10|p:gpwifi/h2dmbmsg dhd_prot_h2d_mbdata_send_ctrlmsg mb=$arg2:x32'
