		R "cd /sys/class/misc/mali0/device && ls -l && for f in gpuinfo core_mask power_policy dvfs_table clock_info available_frequencies; do echo \"== \$f\"; cat \$f 2>&1; done" mali-sysfs.txt
		R "ls $T/events; ls $T/events/mali $T/events/drm 2>&1; true" trace-events.txt
		R "for p in /sys/devices/system/cpu/cpufreq/policy*; do echo \"== \$p\"; cat \$p/related_cpus \$p/scaling_available_frequencies \$p/cpuinfo_max_freq; done; for z in /sys/class/thermal/thermal_zone*; do echo \$z \$(cat \$z/type \$z/temp); done" cpufreq-thermal.txt
		R "find /config/usb_gadget -type f ! -iname '*serial*' | while read -r f; do echo \"== \$f\"; cat \"\$f\" 2>&1 | head -c 512; echo; done" usb-gadget.txt
		R "ps -A -o PID,PPID,USER,NAME,ARGS" ps.txt
		R "lshal" lshal.txt
		R "cat /vendor/etc/init/*.rc /vendor/etc/fstab.*" vendor-init-fstab.txt
		R "ls -lR /vendor/firmware /vendor/etc/wifi /vendor_dlkm/lib/modules" firmware-list.txt
		R "logcat -d -b all" logcat-boot.txt
		# salvaged from golden-unattended a5669f9: more inventory, all reads (no write, no regmap register read)
		R "cat /proc/config.gz" kernel-config.gz
		R "cat /proc/cpuinfo /proc/meminfo /proc/bus/input/devices" proc-cpu-mem-input.txt
		R "getevent -lp" getevent-lp.txt
		R "for s in SurfaceFlinger display input wifi media.audio_flinger sensorservice battery power; do echo \"== dumpsys \$s\"; dumpsys \$s; done" dumpsys.txt
		R "for d in /sys/bus/platform/devices/*; do echo \"\$d \$(readlink \$d/driver)\"; done" platform-drivers.txt
		R "for d in /sys/bus/pci/devices/*; do echo \"== \$d\"; od -A x -t x4 \$d/config; done" pci-config.txt   # [guess: config-space reads have no side effect; status bits are RW1C, cleared by a WRITE of 1 (PCIe base spec 7.4, spec not on this host)]
		R "ls -l /dev/block/by-name" by-name.txt   # names only
		R "for d in /sys/kernel/debug/regmap/*; do echo \"\$d \$(cat \$d/name)\"; done" regmap-names.txt   # names only: no register reads
		# R keeps only the last command's rc: errors inside the loops land in the files (r1 F2) -> every error text is a GAP per file
		if [ "$dry" = 0 ]; then for f in pinctrl-gpio.txt mali-sysfs.txt trace-events.txt cpufreq-thermal.txt usb-gadget.txt vendor-init-fstab.txt firmware-list.txt dumpsys.txt platform-drivers.txt pci-config.txt regmap-names.txt; do
			# comment lines (^\s*#) are not scanned: the stock vendor fstab comment says 'cannot' (golden-6 false positive, research 105 item 5); every other line still is
			el=$(grep -vE '^[[:space:]]*#' "$out/$f" 2>/dev/null | grep -E 'No such file|Permission denied|Operation not permitted|not found|Invalid argument|cannot|Can.t find service'); n=$(printf '%s' "$el" | grep -c .); [ "${n:-0}" = 0 ] || { echo "GAP: $f holds $n error line(s) (first: $(printf '%s\n' "$el" | head -1))" >&2; bad=$((bad + 1)); }; done; fi ;;
	blobs) Rtar "-C / -cf - vendor_dlkm/lib/modules vendor/firmware vendor/etc vendor/lib64 vendor/bin/hw" blobs.tar
		# READ-only partition images of the running slot (vendor DTB, ramdisks, dtbo) for tools/rea; rule 4: never into git. cat only: no dd, no of=, no redirect to /dev/block.
		R "getprop ro.boot.slot_suffix" slot-suffix.txt
		for p in boot init_boot vendor_boot dtbo; do R "cat /dev/block/by-name/$p\$(getprop ro.boot.slot_suffix)" "part-$p.img"; done ;;
	events-extra)
		R "for e in i2c spi gpio mali drm; do if [ -d $T/events/\$e ]; then echo 1 > $T/events/\$e/enable && echo \"enabled \$e\"; else echo \"MISSING \$e\"; fi; done" events-extra.txt
		[ "$dry" = 1 ] || ! grep -q MISSING "$out/events-extra.txt" || { echo "GAP: event groups missing: $(grep MISSING "$out/events-extra.txt" | tr '\n' ' ')" >&2; bad=$((bad + 1)); } ;;
	start) S "echo > $T/trace; echo overwrite > $T/trace_options; echo 1 > $T/tracing_on" ;;
	kprobes)
		for w in "dword rd32 x32" "word rd16 x16" "byte rd8 x8"; do set -- $w
			S "echo 'p:pcicfg/$2 pci_bus_read_config_$1 devfn=\$arg2:x32 pos=\$arg3:s32 vptr=\$arg4:x64' >> $T/kprobe_events"
			S "echo 'r:pcicfg/${2}_ret pci_bus_read_config_$1 rc=\$retval:s32' >> $T/kprobe_events"
			S "echo 'p:pcicfg/w${2#rd} pci_bus_write_config_$1 devfn=\$arg2:x32 pos=\$arg3:s32 val=\$arg4:$3' >> $T/kprobe_events"
		done
		S "echo 1 > $T/events/pcicfg/enable" ;;
	mark) S "echo 'MARK $1${2:+ $2}' > $T/trace_marker" ;;
	stop-pull)
		S "echo 0 > $T/tracing_on"; R "cat $T/trace" "trace-$1.txt"; # vmallocinfo uses %pK (mm/vmalloc.c:4128 v6.1): kptr_restrict 2 = zeros [obs 20261027T224642Z], 0 = HASHED [obs every 20261028T034021Z file], only 1 + CAP_SYSLOG + euid==uid = real (lib/vsprintf.c:854-899 v6.1): set to 1 only for this read, restored in the same shell
		R "k=/proc/sys/kernel/kptr_restrict; o=\$(cat \$k); echo 1 > \$k; cat /proc/vmallocinfo; echo \$o > \$k; echo kptr_restrict-restored=\$(cat \$k) was=\$o" "vmallocinfo-$1.txt"
		[ "$dry" = 1 ] || grep -qE '^kptr_restrict-restored=([0-9]) was=\1$' "$out/vmallocinfo-$1.txt" || { echo "GAP: stop-pull $1: kptr_restrict not restored (see vmallocinfo-$1.txt)" >&2; bad=$((bad + 1)); }
		[ "$dry" = 1 ] || ! grep -q '^0x0000000000000000-0x0000000000000000 .* ioremap' "$out/vmallocinfo-$1.txt" || { echo "GAP: stop-pull $1: vmallocinfo ioremap rows have zero addresses (VA->PA join impossible)" >&2; bad=$((bad + 1)); }
		[ "$dry" = 1 ] || grep -qE '^0xffff[0-9a-f]{12}-0xffff[0-9a-f]{12} .* ioremap( .*)?$' "$out/vmallocinfo-$1.txt" || { echo "GAP: stop-pull $1: no ioremap row has a kernel VA (0xffff...): pointers hashed or zero, VA->PA join impossible" >&2; bad=$((bad + 1)); }
		 R "cat /proc/interrupts" "interrupts-$1.txt"
		R "for f in $T/per_cpu/cpu*/stats; do echo \$f; cat \$f; done" "tracing-stats-$1.txt"
		[ "$dry" = 1 ] || ! grep -qE '^(overrun|commit overrun|dropped events): [1-9]' "$out/tracing-stats-$1.txt" || { echo "GAP: stop-pull $1: trace buffer overrun (events lost, see tracing-stats-$1.txt)" >&2; bad=$((bad + 1)); } ;;
	wifi-trace-probe)
		# READ-ONLY inventory of the Wi-Fi trace sources (research D.1) + the W0/W8 inputs (stock firmware files with SELinux label and sha256, /proc/interrupts, the global-ns su). Nothing is written on the phone.
		# A missing /proc/dhd_trace, /sys/wifi/wl_dbg_level or events/cfg80211 is INFO (info=N): those are the questions being asked.
		wf_init; wf_secret_init
		fwp=""; for n in "${WF_FW_NAMES[@]}"; do fwp="$fwp $WF_FW_V/$n"; done
		syms=$(for row in "${WF_PROBES[@]}"; do t=$(wf_row_text "$row"); t=${t#?:gpwifi/}; t=${t#* }; t=${t%% *}; echo "${t%%+*}"; done | sort -u)
		symre=$(printf '%s\n' "$syms" | paste -sd'|')
		WF probe-procfs.txt probe_procfs=ok "ls -l /proc/dhd_trace /proc/dhd_ecounters 2>&1; echo probe_procfs=ok"
		WF probe-params.txt probe_params=ok 'for p in /sys/module/bcmdhd4389/parameters/*; do echo "$p=$(cat $p 2>/dev/null | head -c 300)"; done; echo probe_params=ok'
		WF probe-sysfs.txt probe_sysfs=ok "ls -l /sys/wifi/ 2>&1; cat /sys/wifi/wl_dbg_level 2>&1; echo probe_sysfs=ok"
		WF probe-ksym.txt probe_ksym=ok "ls $T/events/cfg80211/ 2>&1; grep -wE '$symre' /proc/kallsyms | cut -d' ' -f2-; echo probe_ksym=ok"
		WF probe-cmd.txt probe_cmd=ok "cmd wifi help 2>&1 | grep -E 'start-scan|list-scan-results|connect-network|forget-network|set-verbose-logging'; echo probe_cmd=ok"
		WF probe-props.txt probe_props=ok "getprop | grep -iE 'wifi|wlan|dhd'; lsmod | grep -E 'bcmdhd|cfg80211'; echo probe_props=ok"
		WF probe-fw.txt probe_fw=ok "ls -lZ$fwp && sha256sum$fwp && echo probe_fw=ok"
		wf_ko_check probe-ko.txt || true
		WF probe-irq.txt probe_irq=ok "grep -iE 'dhd|wlan|pcie' /proc/interrupts; echo probe_irq=ok"
		WF probe-predl.txt predl_end=ok 'd=$(dmesg); if [ -n "$d" ]; then c=$(printf "%s\n" "$d" | grep -c "Took ARM out of Reset"); echo pre_download_count=$c; fi; echo predl_end=ok'
		WF probe-mm.txt probe_mm=ok 'true; echo mm_rc=$?; echo ns_mm=$(readlink /proc/self/ns/mnt); echo ns_init=$(readlink /proc/1/ns/mnt); echo probe_mm=ok' 90 wifi_mask --mount-master
		if [ "$dry" != 1 ]; then w=$out/wifi
			for p in /proc/dhd_trace /proc/dhd_ecounters; do ! grep -q "$p: No such file" "$w/probe-procfs.txt" || wf_info "$p is absent"; done
			! grep -q 'No such file' "$w/probe-sysfs.txt" || wf_info "/sys/wifi or /sys/wifi/wl_dbg_level is absent (see probe-sysfs.txt)"
			! grep -qE '/events/cfg80211.*No such file' "$w/probe-ksym.txt" || wf_info "tracefs events/cfg80211 is absent (cfg80211 not loaded?)"
			! grep -q 'parameters/\*=' "$w/probe-params.txt" || wf_gap "no /sys/module/bcmdhd4389/parameters (module not loaded?)"
			for s in $syms; do grep -qw "$s" "$w/probe-ksym.txt" || wf_gap "symbol $s is not in /proc/kallsyms (the gpwifi probe on it would fail)"; done
			for s in start-scan list-scan-results connect-network; do grep -q -- "$s" "$w/probe-cmd.txt" || wf_gap "'cmd wifi help' does not list $s"; done
			grep -q 'bcmdhd4389' "$w/probe-props.txt" || wf_gap "lsmod does not list bcmdhd4389"
			[ "$(grep -cE '^[0-9a-f]{64}  ' "$w/probe-fw.txt")" = "${#WF_FW_NAMES[@]}" ] || wf_gap "probe-fw.txt does not hold ${#WF_FW_NAMES[@]} sha256 lines"
			[ "$(grep -vcE '^probe_irq=ok$' "$w/probe-irq.txt")" -ge 1 ] || wf_gap "no dhd|wlan|pcie line in /proc/interrupts (driver not up?)"
			pd=$(wf_mk probe-predl.txt pre_download_count); echo "pre_download_count=${pd:-unknown}"
			[[ "$pd" =~ ^[0-9]+$ ]] || wf_gap "dmesg failed or was empty: no pre_download_count (grep -c 'Took ARM out of Reset' of the phone dmesg)"
			[ "$(wf_mk probe-mm.txt mm_rc)" = 0 ] || wf_gap "su --mount-master -c true did not give rc 0"
			a=$(wf_mk probe-mm.txt ns_mm); b=$(wf_mk probe-mm.txt ns_init)
			{ [ -n "$a" ] && [ "$a" = "$b" ]; } || wf_gap "mount ns of su --mount-master ('${a:-unreadable}') != ns of init ('${b:-unreadable}'): not the global ns, a bind mount would not reach request_firmware [guess: equal ns links = same ns]"
		fi ;;
	wifi-fw-bind)
		# W0. UNVERIFIED on the phone. Host first: the 3 files must match the pinned sha256 (REFUSED before any adb call otherwise). Copies are hashed AND pushed (no TOCTOU).
		# Teardown (r1 F1): wf_cleanup (EXIT/INT/TERM/HUP) removes the staged copies and rolls an unfinished bind back, so an interrupt leaves nothing in /data/local/tmp and no half-done bind.
		wf_traps; wf_x=$(mktemp -d) || err "$cmd: mktemp failed"
		# host-side check also under --dry-run (review golden-wifi-trace-r1 F3): a missing file or sha mismatch is a GAP + rc 1 before anything could be pushed
		for n in "${WF_FW_NAMES[@]}"; do
			if [ ! -f "$1/$n" ]; then wf_gap "$1/$n is not a file (nothing pushed)"
			elif ! cp "$1/$n" "$wf_x/$n"; then wf_gap "cannot copy $1/$n (nothing pushed)"
			elif [ "$(sha256sum "$wf_x/$n" | cut -d' ' -f1)" != "${WF_FW_PIN[$n]}" ]; then wf_gap "sha256 of $1/$n is not the pinned ${WF_FW_PIN[$n]:0:12}... (nothing pushed)"; fi
		done
		[ "$bad" = 0 ] || { echo "RESULT: FAIL $cmd gaps=$bad out=$out info=$info"; exit 1; }
		wf_init; pushed=1; [ "$dry" = 1 ] || wf_fw_staged=1
		for n in "${WF_FW_NAMES[@]}"; do Q push "$wf_x/$n" "$WF_FW_S$n" || { wf_gap "adb push of $n failed"; pushed=0; }; done
		if [ "$pushed" = 1 ]; then
			[ "$dry" = 1 ] || wf_fw_bind=1
			WF fw-bind.txt bind_script_end=ok "$(wf_bind_script)" 90 cat --mount-master
			if [ "$dry" != 1 ]; then
				if grep -qx 'bind_already=1' "$out/wifi/fw-bind.txt"; then wf_gap "already bound (second bind without wifi-fw-unbind); nothing changed"; norb=1   # wf_fw_bind stays 1 until the end: wf_cleanup skips the unbind when fw-bind.txt says bind_already=1 (r2 R2-6)
				else
					: > "$out/$wf_stock"
					for n in "${WF_FW_NAMES[@]}"; do
						[ "$(wf_mk fw-bind.txt "bind_$n")" = ok ] || wf_gap "$n was not bound (see fw-bind.txt)"
						[ "$(wf_mk fw-bind.txt "bound_sha_$n")" = "${WF_FW_PIN[$n]}" ] || wf_gap "sha256 read through the bound path $WF_FW_V/$n is not the pinned ${WF_FW_PIN[$n]:0:12}..."
						st=$(wf_mk fw-bind.txt "stock_sha_$n")
						if [[ "$st" =~ ^[0-9a-f]{64}$ ]]; then echo "$st  $n" >> "$out/$wf_stock"; else wf_gap "no valid stock sha256 for $n (got '${st:0:20}')"; fi
						l=$(wf_mk fw-bind.txt "label_$n"); bl=$(wf_mk fw-bind.txt "bound_label_$n")
						{ [ -n "$l" ] && [ "$l" = "$bl" ]; } || wf_gap "SELinux label of the bound $n ('$bl') != stock label ('$l')"
					done
					[ "$(wf_mk fw-bind.txt tmpfs)" = ok ] || wf_gap "tmpfs $WF_FW_D was not mounted"
					WF fw-readback.txt readback_end=ok "$(wf_readback_script)" 90 cat --mount-master
					for n in "${WF_FW_NAMES[@]}"; do [ "$(wf_mk fw-readback.txt "rb_sha_$n")" = "${WF_FW_PIN[$n]}" ] || wf_gap "read-back (2nd su --mount-master process) of $WF_FW_V/$n is not the pinned sha256"; done
				fi
			fi
		fi
		# always (also after a failed push): remove the staged copies in /data/local/tmp (the RAM-only tmpfs is the bind source)
		wf_fw_stageclean || true
		# teardown: a bind that has any GAP is rolled back (except the already-bound refusal, which belongs to the earlier bind)
		if [ "$dry" != 1 ] && [ "$pushed" = 1 ] && [ "$bad" -gt 0 ] && [ "${norb:-0}" != 1 ]; then echo "wifi-fw-bind: GAPs above, rolling the bind back (unbind)" >&2; wf_unbind_run; fi
		wf_fw_bind=0 ;;
	wifi-fw-unbind) wf_init; wf_unbind_run ;;
	wifi-kprobes)
		# P1-P24 + P4b (table WF_PROBES, 29 events). Arms and enables ONLY: no tracing_on write, no buffer clear (the caller runs `start`); events go to the global $T buffer that stop-pull reads (no tracefs instance).
		# Module identity first (r1 F14). Any GAP while arming, or an interrupt, disarms again (r1 F5: no half-probed run); the prior events/cfg80211/enable value is recorded in wifi/cfg80211-prev.txt for wifi-kprobes-off.
		wf_probe_guard; wf_init
		if wf_ko_check kprobes-ko.txt; then
			[ "$dry" = 1 ] || { wf_kp_prev=keep
				if [ -f "$out/wifi/cfg80211-prev.txt" ]; then wf_pv=$(cat "$out/wifi/cfg80211-prev.txt"); [[ "$wf_pv" =~ ^[01]$ ]] || fail "$cmd: $out/wifi/cfg80211-prev.txt does not hold 0 or 1 (r2 R2-2): refused, nothing armed; delete the file if it is stale"; wf_kp_prev=$wf_pv; fi
				wf_kp_armed=1; }   # kprobes.txt is truncated by WF when the arm script starts, so wf_cleanup reads this run's cfg80211_prev (r2 R2-1; a signal in the microseconds before that would read a stale file [guess: not testable])
			WF kprobes.txt kprobes_script_end=ok "$(wf_kp_script)" 90 cat
			if [ "$dry" = 1 ]; then echo "would expect: kprobes_registered=$WF_EXPECT, probe_ok for each of ${#WF_PROBES[@]} events, each filter read back equal, gpwifi_enable=1"
			else w=$out/wifi/kprobes.txt
				pv=$(wf_mk kprobes.txt cfg80211_prev)
				if [[ "$pv" =~ ^[01]$ ]]; then [ -f "$out/wifi/cfg80211-prev.txt" ] || echo "$pv" > "$out/wifi/cfg80211-prev.txt"; wf_kp_prev=$(cat "$out/wifi/cfg80211-prev.txt"); fi
				for row in "${WF_PROBES[@]}"; do ev=$(wf_ev "$(wf_row_text "$row")"); grep -qx "probe_ok=$ev" "$w" || wf_gap "probe ${row%%|*} gpwifi/$ev was not registered (see kprobes.txt: module not loaded or symbol missing?)"; done
				n=$(wf_mk kprobes.txt kprobes_registered); echo "kprobes_registered=${n:-unknown}"
				{ [[ "$n" =~ ^[0-9]+$ ]] && [ "$n" -eq "$WF_EXPECT" ]; } || wf_gap "kprobes_registered=${n:-unknown}, expected $WF_EXPECT"
				for row in "${WF_PROBES[@]}"; do fl=$(wf_row_filter "$row"); [ -n "$fl" ] || continue; ev=$(wf_ev "$(wf_row_text "$row")")
					[ "$(wf_mk kprobes.txt "filter_$ev")" = "$fl" ] || wf_gap "filter read-back of gpwifi/$ev (${row%%|*}) is '$(wf_mk kprobes.txt "filter_$ev")', want '$fl'"; done
				[ "$(wf_mk kprobes.txt gpwifi_enable)" = 1 ] || wf_gap "events/gpwifi/enable does not read 1"
				c=$(wf_mk kprobes.txt cfg80211_enable)
				if [ -n "$c" ]; then [ "$c" = 1 ] || wf_gap "events/cfg80211/enable reads '$c', not 1"
				elif grep -qx 'cfg80211_group=absent' "$w"; then wf_info "tracefs events/cfg80211 group is absent (cfg80211 not loaded?)"
				else wf_gap "kprobes.txt says neither cfg80211_enable nor cfg80211_group=absent"; fi
				if [ "$bad" -gt 0 ]; then echo "wifi-kprobes: GAPs above, disarming (wifi/kprobes-disarm.txt)" >&2; wf_kp_off kprobes-disarm.txt "$wf_kp_prev" || true
				else wf_kp_armed=0; fi   # armed on purpose from here on: wifi-kprobes-off undoes it
			fi
		else echo "wifi-kprobes: module identity check failed, nothing armed" >&2; fi ;;
	wifi-kprobes-off)
		wf_probe_guard; wf_init
		pv=0; if [ "$dry" != 1 ]; then
			if [ -f "$out/wifi/cfg80211-prev.txt" ] && [[ "$(cat "$out/wifi/cfg80211-prev.txt")" =~ ^[01]$ ]]; then pv=$(cat "$out/wifi/cfg80211-prev.txt")
			else wf_info "no recorded prior events/cfg80211/enable (wifi-kprobes never ran in this out dir): writing 0 [assumed]"; fi
		fi
		wf_kp_off kprobes-off.txt "$pv" || true
		[ "$dry" = 1 ] || [ "$bad" -gt 0 ] || rm -f "$out/wifi/cfg80211-prev.txt" ;;
	wifi-scan)
		wf_init; wf_secret_init
		WF wifi-scan.txt scan_list=ok "echo GP-WIFI-SCAN > /dev/kmsg && cmd wifi start-scan && echo scan_start=ok && sleep 8 && cmd wifi list-scan-results && echo scan_list=ok" 90 wifi_scan_mask
		if [ "$dry" != 1 ]; then w=$out/wifi/wifi-scan.txt
			grep -qx 'scan_start=ok' "$w" || wf_gap "no scan_start=ok (start-scan failed or is throttled, see wifi-scan.txt)"
			if grep -q '^No scan results' "$w"; then wf_gap "'No scan results' (scan throttled for the shell package [guess] or no AP in range)"
			else
				[ "$(grep -c '<ssid-masked>' "$w")" -ge 1 ] || wf_gap "no scan result row in wifi-scan.txt"
				u=$(grep -vcE '^$|^scan_(start|list)=ok$|BSSID +Frequency|^  <masked> +[0-9]+ .*<ssid-masked>$' "$w")
				[ "$u" = 0 ] || wf_gap "$u line(s) are neither header, marker nor a masked result row (format differs from ScanResultUtil.dumpScanResults?); wifi-scan.txt may hold SSIDs, do not share"
			fi
		fi ;;
	wifi-trace-pull)
		# Masked pulls (research D.4; /proc/dhd_trace is read ONCE and consumed by the read, r1 F9) + S1. Run after wifi-join, wifi-status, wifi-kprobes-off, stop-pull.
		wf_init; wf_secret_init
		WFR wifi-dmesg-full.txt "dmesg"
		WFR wifi-logcat.txt "logcat -d -b main,system,events,radio | grep -iE 'wifi|wlan|supplicant|wpa_|WifiHAL|dhd'"
		WFR wifi-dhd-trace.txt "if [ -e /proc/dhd_trace ]; then timeout 5 dd if=/proc/dhd_trace bs=4096 count=64 2>/dev/null; else echo 'INFO: no /proc/dhd_trace'; fi"
		WFR wifi-dumpsys.txt "dumpsys wifi | head -c 2000000"
		WFR wifi-dmesg-markers.txt "dmesg | grep -E 'GP-WIFI|idsup|4way|PSK|CONSOLE|wl_dbg|FW supports Inband dw|sent DEEP SLEEP ACK|Deepsleep On|rx_dataoffset'; echo end-of-wifi-markers"
		if [ "$dry" = 1 ]; then echo "would check S1: PSK literal in the whole out dir (grep -F -f mode-600 file), SSID literal and MAC pattern in the 5 files pulled under wifi/"
		else w=$out/wifi
			! grep -q '^INFO: no /proc/dhd_trace' "$w/wifi-dhd-trace.txt" 2>/dev/null || wf_info "no /proc/dhd_trace on this phone"
			grep -qE 'idsup status|4way HS finished' "$w/wifi-dmesg-markers.txt" 2>/dev/null || wf_gap "no PSK_SUP evidence in dmesg (idsup status / 4way HS finished); WL_* may be silent at the default wl_dbg_level [guess], the gpwifi/supevent kprobe rows are then the evidence"
			wf_s1 "$w"/wifi-dmesg-full.txt "$w"/wifi-logcat.txt "$w"/wifi-dhd-trace.txt "$w"/wifi-dumpsys.txt "$w"/wifi-dmesg-markers.txt
		fi ;;
esac
if [ "$dry" = 0 ] && [ -d "$out" ]; then (cd "$out" && find . -maxdepth 1 -type f ! -name SHA256SUMS -printf '%f\n' | sort | xargs -r sha256sum > SHA256SUMS); fi
if [ "$bad" -gt 0 ]; then echo "RESULT: FAIL $cmd gaps=$bad out=$out info=$info"; exit 1; fi
echo "RESULT: PASS $cmd gaps=0 dry=$dry out=$out info=$info"
