wf_probe_guard() { local row nm t fl ev sym f fe fnm ib seen=" " nreg='(\$arg[1-8]|%x([0-9]|[12][0-9]|30))' num='(0x[0-9a-fA-F]{1,4}|0|[1-9][0-9]{0,4})' ty='(u8|u16|u32|u64|s8|s16|s32|s64|x8|x16|x32|x64|string)' re
