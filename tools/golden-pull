		if [ "$wf_fw_bind" = 1 ] && grep -qx 'bind_already=1' "$out/wifi/fw-bind.txt" 2>/dev/null; then echo "wf cleanup: the bind script found an earlier bind (bind_already=1): left as it was" >&2; wf_fw_bind=0; fi
		if [ "$wf_fw_bind" = 1 ]; then ( wf_unbind_run ) || true; fi
