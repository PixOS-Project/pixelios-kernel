	if [[ "$ssid$psk" =~ [[:cntrl:]] ]]; then umask "$um"; fail "$cmd: $wf_secret holds a control character in the SSID or PSK (after stripping CR)"; fi
	printf '%s\n' "$ssid" > "$wf_tmp/ssid.lit"; printf '%s\n' "$psk" > "$wf_tmp/psk.lit"
	hs=$(wf_hexs "$ssid"); printf '%s\n%s\n' "${hs// /}" "${hs// /:}" > "$wf_tmp/ssid.hex.lit"
	hp=$(wf_hexs "$psk"); printf '%s\n%s\n' "${hp// /}" "${hp// /:}" > "$wf_tmp/psk.hex.lit"
	# sed BRE escape: \ / . [ * ^ $ are literal on the pattern side. The SSID hex forms are masked only from 4 bytes on (a 1-3 byte SSID would mask unrelated hex); S1 checks them in every case.
	{ printf 's/%s/<ssid>/g\n' "$(wf_sedlit "$ssid")"; printf 's/%s/<psk>/g\n' "$(wf_sedlit "$psk")"
		printf 's/%s/<psk>/Ig\n' "${hp// /}" ; printf 's/%s/<psk>/Ig\n' "${hp// /:}"
		if [ "$(printf '%s' "$ssid" | wc -c)" -ge 4 ]; then printf 's/%s/<ssid>/Ig\n' "${hs// /}" ; printf 's/%s/<ssid>/Ig\n' "${hs// /:}"; fi; } > "$wf_tmp/mask.sed"
