wf_x=""; wf_sig=""; wf_fw_staged=0; wf_fw_bind=0; wf_kp_armed=0; wf_kp_prev=keep
wf_traps() { exec 7>&1 8>&2; trap wf_cleanup EXIT; trap 'wf_sig=TERM; exit 143' TERM; trap 'wf_sig=INT; exit 130' INT; trap 'wf_sig=HUP; exit 129' HUP; }
# fd 7/8 = the real stdout/stderr: a trap fired inside `Q ... > /dev/null` would otherwise run with that redirection still active and swallow the RESULT line
wf_cleanup() { local rc=$?; trap - EXIT INT TERM HUP; exec 1>&7 2>&8
