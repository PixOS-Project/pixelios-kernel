	'P4b|p:gpwifi/evdata wl_cfg80211_event etype=+4($arg2):x32 st=+8($arg2):x32 dlen=+20($arg2):x32 d0=+0($arg3):u32 d4=+4($arg3):u32 d8=+8($arg3):u32 d12=+12($arg3):u32 d16=+16($arg3):u32|etype == 0x45000000'
