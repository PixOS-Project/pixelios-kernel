	'P19|p:gpwifi/wrcmpl dhd_prot_ring_write_complete ringid=+2($arg2):u16 wr=+8($arg2):u16 h2dupd=+13934($arg1):u8 idmaenb=+13936($arg1):u8 idmaact=+13940($arg1):u32 ifrmenb=+13944($arg1):u8 ifrmact=+13948($arg1):u32'
	'P20|p:gpwifi/capstr dhd_get_fw_capabilities+0x80 cap=+3520(%x20):string'
