wf_init() { wf_traps; [ "$dry" = 1 ] || mkdir -p "$out/wifi" || err "cannot create $out/wifi"; }
# Secret handling (R C-mask, AP-279): SSID/PSK come from GP_WIFI_SECRET (2 lines), are written only to mode-600 files in a private temp dir (removed on exit), never to argv, a log line or the phone.
# CR is stripped (CRLF file, r1 F4); a control character left in either line is a refusal. The secret file must not lie inside the output dir (S1 scans the whole dir; r1 F3). mask.sed = SSID literal -> <ssid>, PSK literal and hex -> <psk>
# (the PSK never reaches the host disk through a masked pull; S1 stays the verifier). The hex forms (plain and colon-separated, any case) are masked before bt_mask so the MAC mask cannot eat half of a colon-hex SSID.
wf_sedlit() { printf '%s' "$1" | sed 's|[].[\\/^$*]|\\&|g'; }
wf_hexs() { printf '%s' "$1" | od -An -v -tx1 | tr -d '\n' | sed 's/^ *//; s/  */ /g'; }
wf_secret_init() { local um ssid psk hs hp
