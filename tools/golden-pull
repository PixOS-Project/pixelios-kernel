		echo "wf cleanup: ${wf_sig:+interrupted by SIG$wf_sig; }undoing what this run left on the phone (staged firmware copies=$wf_fw_staged, active bind=$wf_fw_bind, armed kprobes=$wf_kp_armed)" >&2
