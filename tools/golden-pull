# D: one stdin script (su -c sh) per output file; no nested quoting (golden-6 su-policy-all.txt worked, su-check R with nested quotes did not); used by su-policy-diag and su-check
D() { local f=$1; shift
	if [ "$dry" = 1 ]; then echo "would run: adb shell su -c sh   (script on stdin: $* > $f)"; return; fi
	printf '%s; echo __GP_RC=$?\n' "$*" | timeout 60 adb shell su -c sh > "$out/$f" 2>&1 || { echo "GAP: $cmd: adb shell su -c sh failed for $f" >&2; bad=$((bad + 1)); }
	tr -d '\r' < "$out/$f" > "$out/$f.lf" && mv "$out/$f.lf" "$out/$f"   # CRLF -> LF so the run-plan grep -x answers match (golden-6 r1 F8)
	grep -qx '__GP_RC=0' "$out/$f" || { echo "GAP: $cmd: $f command did not exit 0 (no __GP_RC=0 line, see $f)" >&2; bad=$((bad + 1)); }   # golden-6 r1 F6
	if grep -v '^__GP_RC=' "$out/$f" | grep -q '[^[:space:]]'; then :
	elif [ "$f" = su-magisk-log.txt ] && grep -qx '__GP_RC=0' "$out/$f"; then   # the ONE file allowed empty (rc 0 + nothing printed); the other four keep their GAP (rule 8: named, counted as info=N on RESULT)
