# BT FILE MARKER SCRIPT [TIMEOUT]: one stdin script (su -c sh) -> $out/bt/FILE through the address mask; GAP unless the script printed the exact MARKER line (every step && -chained, D keeps only the last rc: research 106)
BT() { local f=bt/$1 m=$2 s=$3 t=${4:-90}
	if [ "$dry" = 1 ]; then echo "would run: adb shell su -c sh   (script on stdin: $s > $out/$f, marker $m)"; return; fi
	local ef=""; [ "${GP_BT_TRACE-}" != 1 ] || ef=$out/$f.stderr   # opt-in trace (see header): the script runs under `set -x`, remote stderr goes to FILE.stderr instead of the merged stream
