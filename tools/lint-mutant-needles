def dma_rows(mod):
    """tools/test_wlan_dma_mutants.py MUTANTS = (label, [(regex, repl)...], equiv): re.sub(rx, rep, flags=re.S) in order on header() (test_every_mutant_is_killed)."""
    for label, subs, _eq in mod.MUTANTS:
        m = mod.header()
        for rx, rep in subs:
            yield "bsd/dev/sweet_wlan_dma.h", label, rx, len(re.findall(rx, m, re.S))
            m = re.sub(rx, rep, m, flags=re.S)

