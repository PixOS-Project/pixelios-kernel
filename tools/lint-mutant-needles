def tables_of(mod):
    """Module-level list/tuple attributes named *MUTANTS (test_wlan_mutants_cache.py has GATE_WIRING_MUTANTS, K1 review F2)."""
    return [k for k, v in vars(mod).items() if k.endswith("MUTANTS") and isinstance(v, (list, tuple)) and not k.startswith("_")]


def check(tools, root=None, once=False, out=print, adapters=None):
    """Returns (tables, needles, missing, multi, problems)."""
    adapters = ADAPTERS if adapters is None else adapters
    tables = needles = missing = multi = problems = 0
    for path in sorted(glob.glob(os.path.join(tools, "test_*mutants*.py"))):
        base = os.path.basename(path)
        try:
            mod = load(path)
        except Exception as e:      # a needle helper (wlan _t/_f/_fx) raises ValueError at import when its text is gone: that is the same defect, say it loudly
            out("MUTANT NEEDLE MISSING %s: import failed (a table helper could not find its needle): %s: %s" % (base, type(e).__name__, str(e)[:300]))
            problems += 1
            continue
        for tname in tables_of(mod):
            fn = adapters.get((base, tname))
            if fn is None:
                out("MUTANT TABLE UNREGISTERED %s:%s (add an adapter to tools/lint-mutant-needles ADAPTERS; AP-281)" % (base, tname))
                problems += 1
                continue
            tables += 1
            try:
                rows = list(fn(mod, root) if fn is el2_rows else fn(mod))
            except Exception as e:
                out("MUTANT NEEDLE MISSING %s:%s: adapter failed: %s: %s" % (base, tname, type(e).__name__, str(e)[:300]))
                problems += 1
                continue
            for target, label, needle, n in rows:
                needles += 1
                if n == 0:
                    missing += 1
                    out("MUTANT NEEDLE MISSING %s:%s %r -> %s: %s" % (base, tname, label, target, repr(needle)[:160]))
                elif n > 1:
                    multi += 1
                    if once:
                        missing += 1
                    out("MUTANT NEEDLE %s %s:%s %r x%d -> %s: %s" % ("MULTI-FAIL" if once else "MULTI", base, tname, label, n, target, repr(needle)[:100]))
    return tables, needles, missing, multi, problems


# G4: (file, table) -> why it is not passed to run_set. MUTANTS is the header set: run_all() pools it (ThreadPoolExecutor), caches it (make_key) and spot-checks it.
POOL_ALLOW = {("test_wlan_wr_mutants.py", "MUTANTS"): "header set: pooled, cached and spot-checked by run_all()"}
POOL_FILES = ("test_wlan_wr_mutants.py", "test_wlan_dma_mutants.py")
_SUBPROC = {"run", "call", "check_call", "check_output", "Popen", "run_cpu_limited", "run_bounded"}


def _callee(node):
    f = node.func
    return f.id if isinstance(f, ast.Name) else f.attr if isinstance(f, ast.Attribute) else None


def _names(node):
    return {n.id for n in ast.walk(node) if isinstance(n, ast.Name)}


def _compiler_funcs(tree):
    """Names of the file's functions that run a compiler: a subprocess call or the string "gcc" in the body, or a call of such a function (fixed point)."""
    funcs = {n.name: n for n in ast.walk(tree) if isinstance(n, (ast.FunctionDef, ast.AsyncFunctionDef))}
    hot = {k for k, f in funcs.items() if any((isinstance(x, ast.Call) and _callee(x) in _SUBPROC) or (isinstance(x, ast.Constant) and x.value in ("gcc", "cc")) for x in ast.walk(f))}
    while True:
        more = {k for k, f in funcs.items() if k not in hot and any(isinstance(x, ast.Call) and _callee(x) in hot for x in ast.walk(f))}
        if not more:
            return hot
        hot |= more


def _runs_compiler(body, hot):
    for stmt in body:
        for x in ast.walk(stmt):
            if (isinstance(x, ast.Call) and (_callee(x) in hot or _callee(x) in _SUBPROC)) or (isinstance(x, ast.Constant) and x.value in ("gcc", "cc")):
                return True
    return False


def _pool_names(tree):
    """-> (module names bound to wlan_mutant_pool, function names bound to its run_set, [(line, what)] shadows).
    A shadow is a local `def run_set` / `run_set = ...` or `from <other module> import run_set`: a call of it is NOT the pool (bypass c, review gate-2x-s1-r1 F2)."""
    mods, funcs, shadows = {"wlan_mutant_pool"}, {"run_set"}, []
    for n in ast.walk(tree):
        if isinstance(n, ast.Import):
            mods |= {(a.asname or a.name) for a in n.names if a.name == "wlan_mutant_pool"}
        elif isinstance(n, ast.ImportFrom):
            for a in n.names:
                if a.name == "run_set":
                    if n.module == "wlan_mutant_pool":
                        funcs.add(a.asname or a.name)
                    else:
                        shadows.append((n.lineno, "imports run_set from %r, not wlan_mutant_pool" % n.module))
        elif isinstance(n, (ast.FunctionDef, ast.AsyncFunctionDef, ast.ClassDef)) and n.name == "run_set":
            shadows.append((n.lineno, "defines its own `%s run_set`" % ("class" if isinstance(n, ast.ClassDef) else "def")))
        elif isinstance(n, ast.Assign) and any(isinstance(t, ast.Name) and t.id == "run_set" for t in n.targets):
            shadows.append((n.lineno, "rebinds the name run_set"))
    if shadows:
        funcs.discard("run_set")           # the bare name is not the pool's; an alias imported from wlan_mutant_pool stays
    return mods, funcs, shadows


def _is_pool_call(x, mods, funcs):
    if not isinstance(x, ast.Call):
        return False
    f = x.func
    return (isinstance(f, ast.Name) and f.id in funcs) or (isinstance(f, ast.Attribute) and f.attr == "run_set" and isinstance(f.value, ast.Name) and f.value.id in mods)


def _tables(tree):
    """Module-level `NAME = ...`, `NAME += ...`, `NAME: T = ...` with NAME ending MUTANTS or MUTS -> {name: line}."""
    out = {}
    for n in tree.body:
        if isinstance(n, ast.AnnAssign):
            tg = [n.target] if n.value is not None else []
        else:
            tg = [n.target] if isinstance(n, ast.AugAssign) else n.targets if isinstance(n, ast.Assign) else []
        for t in tg:
            if isinstance(t, ast.Name) and t.id.endswith(("MUTANTS", "MUTS")) and not t.id.startswith("_"):
                out.setdefault(t.id, n.lineno)
    return out


_WRAP = {"list", "tuple", "sorted", "reversed", "enumerate", "iter", "set", "frozenset", "dict", "filter", "map", "zip", "chain", "copy", "deepcopy"}


def _alias_sources(val, taint):
    """Tables that `val` is a plain re-export of: a tainted name, a wrapper call (list(T), sorted(T), enumerate(T) ...), a display of tainted items ([*A, *B], A + B), or a pure copy/filter comprehension
    ([m for m in T if ..]). Anything else (a formatted string, a method result, `t = t.replace(..)`) is not an alias: name-based taint on generic names would flag half the file."""
    if isinstance(val, ast.Name):
        return set(taint.get(val.id, ()))
    if isinstance(val, ast.Starred):
        return _alias_sources(val.value, taint)
    if isinstance(val, (ast.List, ast.Tuple, ast.Set)):
        return set().union(*[_alias_sources(e, taint) for e in val.elts]) if val.elts else set()
    if isinstance(val, ast.BinOp) and isinstance(val.op, ast.Add):
        return _alias_sources(val.left, taint) | _alias_sources(val.right, taint)
    if isinstance(val, ast.Call) and _callee(val) in _WRAP:
        return set().union(*[_alias_sources(a, taint) for a in val.args]) if val.args else set()
    if isinstance(val, (ast.ListComp, ast.GeneratorExp, ast.SetComp)) and len(val.generators) == 1:
        tgt = {n.id for n in ast.walk(val.generators[0].target) if isinstance(n, ast.Name)}
        if isinstance(val.elt, (ast.Name, ast.Tuple)) and {n.id for n in ast.walk(val.elt) if isinstance(n, ast.Name)} <= tgt:
            return _alias_sources(val.generators[0].iter, taint)
    if isinstance(val, ast.IfExp):
        return _alias_sources(val.body, taint) | _alias_sources(val.orelse, taint)
    return set()


def _taint(scope_nodes, tables, mods, funcs, seed=None):
    """-> {name: {tables it is an alias of}} within one scope (its nodes), seeded with the enclosing scope: the tables themselves plus `ALIAS = TABLE`, `T = list(TABLE)`, `x = [m for m in TABLE]`.
    The result of a pooled run_set call is not tainted (it is a list of verdicts)."""
    taint = {k: set(v) for k, v in (seed or {t: {t} for t in tables}).items()}
    while True:
        changed = False
        for n in scope_nodes:
            if isinstance(n, ast.Assign):
                tg, val = n.targets, n.value
            elif isinstance(n, (ast.AugAssign, ast.AnnAssign)) and n.value is not None:
                tg, val = [n.target], n.value
            else:
                continue
            if _is_pool_call(val, mods, funcs):
                continue
            src = _alias_sources(val, taint)
            for t in tg:
                if isinstance(t, ast.Name) and src - taint.get(t.id, set()):
                    taint.setdefault(t.id, set()).update(src)
                    changed = True
        if not changed:
            return taint


def _scopes(tree):
    """-> [(nodes, is_function)]: the module's own nodes (not inside any def) and, per def (nested ones included in the outer def too), all its nodes."""
    defs = (ast.FunctionDef, ast.AsyncFunctionDef)
    mod_nodes, stack = [], list(tree.body)
    while stack:
        n = stack.pop()
        if isinstance(n, defs):
            continue
        mod_nodes.append(n)
        stack.extend(ast.iter_child_nodes(n))
    return [(mod_nodes, False)] + [(list(ast.walk(f)), True) for f in ast.walk(tree) if isinstance(f, defs)]


def pooling_problems(tools, out=print, allow=None):
    """-> number of MUTANT SET UNPOOLED findings in POOL_FILES of `tools` (see the docstring, G4).
    Tripwire, not a proof: it follows names (aliases, comprehensions, annotated assignments, `*_MUTS`), resolves run_set to wlan_mutant_pool and flags a local run_set. It does NOT follow a table
    through an attribute, a function return value, getattr/globals()/exec, an import from another file, or a runner that is handed to a pool other than run_set while a different compiler-running
    helper is not named in the same call; S2 must not rely on G4 as proof that nothing compiles outside run_set."""
    allow = POOL_ALLOW if allow is None else allow
    found = 0
    for base in POOL_FILES:
        path = os.path.join(tools, base)
        if not os.path.exists(path):
            continue
        with open(path, encoding="utf-8") as fh:
            tree = ast.parse(fh.read(), path)
        mods, funcs, shadows = _pool_names(tree)
        for line, what in shadows:
            found += 1
            out("MUTANT SET UNPOOLED run_set (%s:%d): the file %s: a mutant table passed to it is not pooled, cached or spot-checked (import wlan_mutant_pool and call wlan_mutant_pool.run_set)" % (base, line, what))
        tables = _tables(tree)
        scopes = _scopes(tree)
        mod_taint = _taint(scopes[0][0], tables, mods, funcs)
        taints = [mod_taint] + [_taint(nodes, tables, mods, funcs, mod_taint) for nodes, _f in scopes[1:]]
        pooled = set()
        for (nodes, _f), taint in zip(scopes, taints):
            for x in nodes:
                if _is_pool_call(x, mods, funcs):
                    for a in list(x.args) + [k.value for k in x.keywords]:
                        pooled |= {t for nm in _names(a) for t in taint.get(nm, ())}
        hot = _compiler_funcs(tree)
        for tname, line in tables.items():
            if tname not in pooled and (base, tname) not in allow:
                found += 1
                out("MUTANT SET UNPOOLED %s (%s:%d): not an argument of run_set and not on POOL_ALLOW (AP-327 family; pool it: tools/wlan_mutant_pool.py)" % (tname, base, line))
        reported = set()

        def flag(tname, lineno, what):
            nonlocal found
            if (tname, lineno, what) not in reported:
                reported.add((tname, lineno, what))
                found += 1
                out("MUTANT SET UNPOOLED %s (%s:%d): %s" % (tname, base, lineno, what))

        for (nodes, _f), taint in zip(scopes, taints):
            def derived(node):
                return sorted({t for nm in _names(node) for t in taint.get(nm, ()) if (base, t) not in allow})
            inside_pool = {id(y) for x in nodes if _is_pool_call(x, mods, funcs) for y in ast.walk(x)}
            for x in nodes:
                if isinstance(x, (ast.For, ast.AsyncFor)) and _runs_compiler(x.body, hot):
                    for t in derived(x.iter):
                        flag(t, x.lineno, "a serial loop over the table runs a compiler outside run_set")
                elif isinstance(x, (ast.ListComp, ast.SetComp, ast.GeneratorExp, ast.DictComp)):
                    elts = [x.key, x.value] if isinstance(x, ast.DictComp) else [x.elt]
                    if _runs_compiler(elts, hot):
                        for g in x.generators:
                            for t in derived(g.iter):
                                flag(t, x.lineno, "a comprehension over the table runs a compiler outside run_set")
                elif isinstance(x, ast.Call) and id(x) not in inside_pool:
                    args = list(x.args) + [k.value for k in x.keywords]
                    for t in sorted({t for a in args for t in derived(a)}):
                        if _callee(x) in hot or any(_runs_compiler([a], hot) or (_names(a) & hot) for a in args):
                            flag(t, x.lineno, "the table is handed to a call that runs a compiler outside run_set")
    return found


def main(argv):
    tools, root, once = HERE, None, False
    a = list(argv)
    while a:
        k = a.pop(0)
        if k == "--tools" and a:
            tools = a.pop(0)
        elif k == "--root" and a:
            root = a.pop(0)
        elif k == "--once":
            once = True
        else:
            print("usage: lint-mutant-needles [--tools DIR] [--root DIR] [--once]", file=sys.stderr)
            return 2
    tables, needles, missing, multi, problems = check(tools, root, once)
    problems += pooling_problems(tools)
    ok = not (missing or problems) and tables > 0
    print("RESULT: %s mutant-needles tables=%d needles=%d missing=%d multi=%d%s" % (
        "PASS" if ok else "FAIL", tables, needles, missing, multi,
        " problems=%d" % problems if problems else (" (no mutant table found in %s)" % tools if tables == 0 else "")))
    return 0 if ok else 1


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
