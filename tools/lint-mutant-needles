def load(path):
    """Import a test module by path (its module-level code builds the tables; none of them runs a mutant)."""
    sys.path.insert(0, os.path.dirname(path))
    try:
        spec = importlib.util.spec_from_file_location("lmn_" + os.path.basename(path)[:-3], path)
        mod = importlib.util.module_from_spec(spec)
        spec.loader.exec_module(mod)
        return mod
    finally:
        sys.path.pop(0)


def wlan_rows(mod):
    """MUTANTS = (label, [(old, new)...], equiv) against the final sweet_wlan_wr.h: every `old` against the unmutated text (run_all's `o not in m`)."""
    text = mod.final_header()
    for label, subs, _eq in mod.MUTANTS:
        for old, _new in subs:
            yield "bsd/dev/sweet_wlan_wr.h", label, old, text.count(old)


def wlan_glue_rows(mod):
    """GLUE_MUTANTS = (label, [(old, new)...]) against glue_function_text(); the substitutions apply in order (test_glue_mutants_are_killed), @move is the special block move."""
    base = mod.glue_function_text()
    for label, subs in mod.GLUE_MUTANTS:
        t = base
        for old, new in subs:
            if old == mod._MOVE:
                continue
            yield "bsd/dev/sweet_wlan.c (glue function)", label, old, t.count(old)
            t = t.replace(old, new)


