def en0_rows(mod):
    """MUTANTS = (name, row, old, new) against shim/wlan_en0.h (the runner itself refuses a pattern that does not occur exactly once)."""
    with open(mod.HDR, encoding="utf-8") as fh:
        text = fh.read()
    for name, _row, old, _new in mod.MUTANTS:
        yield "shim/wlan_en0.h", name, old, text.count(old)


def el2_rows(mod, root=None):
    """MUTANTS = (id, path, regex, replacement, kind, why): re.subn(pattern, ..., flags=re.M) on ROOT/path (test_every_mutant_is_killed)."""
    root = root or mod.ROOT
    for mid, path, pat, _rep, _kind, _why in mod.MUTANTS:
        try:
            with open(os.path.join(root, path)) as fh:
                n = len(re.findall(pat, fh.read(), flags=re.M))
        except OSError as e:
            yield path, mid, "(file unreadable: %s)" % e, 0
            continue
        yield path, mid, pat, n


def _seq_rows(table, base_fn, target, alt=None):
    """(name, [(old, new) | (old, new, "wr")...]) applied IN ORDER to base_fn(mod) (the table's own test: `old in t` then t = t.replace(old, new));
    a third element "wr" targets alt=(target, base_fn) instead (G2_MUTANTS rows on sweet_wlan_wr.h, g2_kill_test)."""
    def rows(mod):
        for name, subs in getattr(mod, table):
            texts = {}
            for sub in subs:
                key = "alt" if len(sub) > 2 and alt is not None else "main"
                tgt, fn = (alt if key == "alt" else (target, base_fn))
                if key not in texts:
                    texts[key] = fn(mod)
                yield tgt, name, sub[0], texts[key].count(sub[0])
                texts[key] = texts[key].replace(sub[0], sub[1])
    return rows


def dp15_rows(mod):
    """tools/test_wlan_dp15_mutants.py MUTANTS = (clause, name, old, new) against the G2 header extracted from the patches (main(): src.count(old) must be 1, each mutant on the unmutated text). T-866b."""
    text = mod.extracted_headers(mod.load_wr_helpers())["sweet_wlan_g2.h"]
    for _clause, name, old, _new in mod.MUTANTS:
        yield "bsd/dev/sweet_wlan_g2.h (dp15)", name, old, text.count(old)


def _shim_hdr_rows(mod, rows, target):
    """HDR_FILES of the l25 / rsne mutant tests are read from shim/ (main(): srcs = {h: open(SHIM/h)}); rows = (name, header or None, old). T-866b."""
    srcs = {}
    for h in mod.HDR_FILES:
        with open(os.path.join(mod.SHIM, h), encoding="utf-8") as fh:
            srcs[h] = fh.read()
    for name, hdr, old in rows:
        yield target, name, old, (srcs[hdr].count(old) if hdr else sum(t.count(old) for t in srcs.values()))


