def _devd_seq_rows(path, table):
    """devd/devsh rows (id, what, [(anchor, replacement)...], killers[, reason]): apply_mutant() in test_devd_mutants.py applies the edits IN ORDER, each
    anchor counted in the text the previous edits produced (and must be exactly 1 there, so a MULTI here is an ERROR in that suite)."""
    with open(path) as fh:
        base = fh.read()
    target = "tools/" + os.path.basename(path)
    for row in table:
        mid, edits = row[0], row[2]
        t = base
        for anchor, repl in edits:
            n = t.count(anchor)
            yield target, mid, anchor, n
            if n == 0:
                break
            t = t.replace(anchor, repl, 1)


def devd_rows(mod):
    """MUTANTS of test_devd_mutants.py against tools/devd.c (DEVD_SRC)."""
    return _devd_seq_rows(mod.DEVD_SRC, mod.MUTANTS)


