def _src_rows(table, src_attr):
    """Rows (name, needle, replacement) applied once to the file at mod.<src_attr> (tools/test_resident_mutants.py: str.replace, count must be 1)."""
    def rows(mod):
        path = getattr(mod, src_attr)
        with open(path) as fh:
            text = fh.read()
        for name, old, _new in getattr(mod, table):
            yield "tools/" + os.path.basename(path), name, old, text.count(old)
    return rows


