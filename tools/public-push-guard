HOOK_PC = """#!/bin/sh
# installed by tools/public-push-guard install-hook (T-536a): refuses a commit whose author/committer e-mail is not a GitHub noreply address (R66).
# Uses this worktree's tools/public-push-guard, else the copy recorded at install time. A missing tool is a loud note, not a block (the pre-push hook still guards the push).
