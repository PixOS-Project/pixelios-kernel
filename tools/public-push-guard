#!/usr/bin/env python3
"""tools/public-push-guard: content guard for pushes to PUBLIC remotes (user order R66, 2026-10-31).

  git pre-push hook:   public-push-guard REMOTE URL   (stdin: `<local ref> <local sha> <remote ref> <remote sha>` lines)
  tools/public-push-guard install-hook      write .git/hooks/pre-push in the common git dir (fails closed when this tool is missing)
  tools/public-push-guard report [REF] [--remote NAME] [--list] [--tip-only]
                                            dry run: scan REF (default HEAD) as if pushed to a public remote; counts per rule, top 15 files;
                                            --tip-only scans only the blobs and paths of REF's tree (the gate step: history is not the gate's business)
  tools/public-push-guard gate [REF] [--write-baseline]
                                            gate step `public-guard` (T-6070): tip tree of REF (default HEAD) against the ratchet tools/public-push-guard-baseline.tsv
                                            (rule<TAB>file<TAB>count, never a value). More findings than the baseline for a rule+file, or any finding of rule e,
                                            or a baseline entry above the actual count = FAIL. Pre-existing findings stay loud (PUBLIC GAP, rule 8) until relocated.
  tools/public-push-guard staged            pre-commit (T-6070, public by default): scan the ADDED lines and new paths of the staged diff, whatever the remote
  tools/public-push-guard msg FILE           commit-msg (T-6070): scan the commit message in FILE (comment lines skipped) and the current branch name
  tools/public-push-guard identity           (T-536a) refuse when this clone's author/committer e-mail (`git var GIT_AUTHOR_IDENT`/`GIT_COMMITTER_IDENT`) is not a GitHub noreply address
                                            (`staged` runs the same check; pre-push and `report` check the e-mails of every pushed commit; `gate` those of BASE..REF, BASE default trunk)
Rules: tools/public-push-guard.rules (reason per rule). Rule e = every non-empty value (>= 6 chars) of the gitignored .env of the
clone and of the super folder, read at runtime, compared as substrings, NEVER printed, hashed or written.
Public remote = url matches a public-url rule, or any substring listed (one per line) in the gitignored tools/public-push-guard.urls.
Scanned: added lines of every pushed commit + every blob and path of the pushed tip tree. No bypass flag or env var.
Exit: 0 pass/skip, 1 findings, 2 usage/internal error. Last line is RESULT: ...
"""
if __import__("sys").argv[1:2] in (["-h"], ["--help"]):  # T-7dff:help: usage before any import or side effect
    print("usage: " + __file__.rsplit("/", 1)[-1] + "\n" + (__doc__ or "".join(l[2:] for l in open(__file__).readlines()[1:60] if l.startswith("# "))).strip()); raise SystemExit(0)
import collections, os, re, subprocess, sys

HERE = os.path.dirname(os.path.abspath(__file__))
RULES = os.path.join(HERE, "public-push-guard.rules")
URLS = os.path.join(HERE, "public-push-guard.urls")
IDENTITIES = os.path.join(HERE, "public-push-guard.identities")   # gitignored extra allowed e-mails (rule 4: never tracked)
BASELINE = os.path.join(HERE, "public-push-guard-baseline.tsv")
BASELINE_REL = "tools/public-push-guard-baseline.tsv"
ZERO = "0" * 40
MIN_SECRET = 6
LIST_CAP = 200

