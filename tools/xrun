#!/bin/bash
# One hardware test cycle -> ONE short report (docs/AUTOMATION.md). Progress goes to <run dir>/xrun.log, stdout is the report.
#   tools/xrun --kernel K [--adt A | --board bluejay] [--cpus N (default 8)] [--qr S|off] [--restart S] [--args "boot-args"] [--gui] [--rails] [--no-rails (rails are the default except --intent el2; sweettouch=0 drops all touch defaults)] [--gpu-handover [--gpu-clk-level 3]] [--wlan-hold [--wlan-level 1|2]] [--dvfs K0,K1,K2|read] [--no-usbnet | --usbdma]   (USB UDP log is ON by default since 2026-10-22; QR only with --qr S) (always --rw: a read-only root panics in mount(8))
#              [--reader "qr-log.py options"]   (e.g. "--workers 3 --average 3 --tiles 1"; QL2 boot-args go in --args: sweetqr_fmt=1|2 sweetqr_ver sweetqr_ecc sweetqr_tiles sweetqr_ms sweetqr_k sweetqr_red sweetqr_fec sweetqr_hold)
#              [--expect REGEX]... [--expect-absent REGEX]... [--duration S] [--label NAME] [--no-flash-check]
#              [recovery (T-322d): refused with exit 2 unless --restart S (S > 0) or --args sweetrestart=S is given, or the run plan has a line `no-recovery: <why, >= 10 chars>` (tools/run-preflight c_recovery, via --intent-check); the timer is armed in XNU, so a hang in the shim before XNU is NOT covered (PR-4 watchdog, T-5d2f)]
#              [needs a run plan docs/runplans/<label>.md (or a plan whose first line names the label) with a "## Questions" table and every --expect/--expect-absent regex verbatim: tools/run-preflight c_runplan, AGENTS rule 9; bypass: give it on the command line, `XRUN_NO_RUNPLAN="reason >= 10 chars" tools/xrun ...` (never export it; an exported one is still accepted, printed by run-preflight and recorded as runplan_bypass); --dry-run is exempt]
#              [checks before the build: tools/usb-port --args (SuperSpeed is the XNU gadget DEFAULT since patch 0173 / user order R27, so a USB 3 link needs no sweetusb3=1; sweetusb3=0 is an explicit opt-out: USB3 WARN on a USB 3 link + `sweetusb3=0 OPT-OUT` in the run summary (AP-177); any other sweetusb3 value than exactly 0 or 1 is exit 2; USB3 WARN for SuperSpeed on a USB 2 link, only when the gadget runs (sweetusb=2, i.e. not with --no-usbnet); exactly one 18d1 device on the bus)
#               and tools/run-preflight --userdata-check (exit 2 unless the newest flashed-userdata.txt line is an iOS root flash; an `erased` line from tools/fboot-android
#               or no file = Android/unknown userdata; bypass `XRUN_USERDATA_BYPASS="reason >= 10 chars" tools/xrun ...`, printed as USERDATA BYPASS and marked userdata_bypass)]
#              [--el2-b3]   (needs --el2-trap, sweetel2=2 instead of =1, no sweetgpu*/sweetwlan*/sweetmali*/sweettouch* arg, build.sh with EL2_B3; passes --el2-b3 to build.sh)
#              [--panic-spin "REASON"]   (T-03ff: a debug= with DB_NMI 0x4, e.g. debug=0xc, spins on the panic screen until the user resets the phone: exit 2 from the build unless this gives a reason >= 10 chars; marked panic_spin= in the run summary)
#              [--el2-trap]   (TP-045: B2 shim = build.sh --el2-trap --boot-xnu (EL2_RESIDENT); needs --intent el2, --cpus 1, sweetel2=1 in --args and a build.sh with EL2_RESIDENT (kernel branch el2/b2-report); refused with --gpu-handover/--wlan-hold/--rails/--dvfs; exit 2 before any build/lock/phone; prints `EL2: resident ... shim sha256 H`, RESULT gets ` intent=el2`)
#              [--pmic-src-clear]   (implies --pmic-src; ADDS the one PMIC write of research 142: writes 0 to S2MPG10 OFFSRC/PWRONSRC + S2MPG11 OFFSRC after the reads and reads them back once; boot-arg sweetpsclr=N, pmicsrc.h)   [--pmic-src]   (shim --pmic-src: READ-ONLY PMIC reset-source latches printed at boot, nothing cleared, no boot-arg; ALL-ON T-02/T-24)   [--mif-clk-level KHZ]   (implies --mif-clk; the ONE MIF request goes to this table row instead of the top row: only the 13 gs101.dtsi mif_int_map rows, else exit 2; ALL-ON T-02)   [--sweet-probe]   (shim READ-ONLY probes of research 161 + boot-arg sweetprobe=1, forwarded to build-xnu-image.sh; needs a kernel with patch 0363; LOWCLK B1-B3)   [--mif-clk | --no-mif-clk]   (T-5030: the shim asks ACPM DVFS dom 0 (MIF) for its table top row once; ON BY DEFAULT with --intent gpu (T-1499), off for every other intent; --no-mif-clk is the old-baseline opt-out)
#              [--intent gpu|timing|wlan|el2]   (tools/run-intents.json: exit 2 before any build when the flags/boot-args that intent needs are missing or a forbidden one is present; a label implying an intent with no/none/other --intent exits 2 unless XRUN_INTENT_OK=1)
#              [--early] [--stop-on REGEX]... [--hard-timeout S] [--lock-wait S] [--remote-reset | --no-remote-reset] [--no-camera] [--fail-on REGEX]... [--overlay DIR [--compress]] [--wlanfw FILE]   (with --intent wlan and --args sweetwlan=N, N >= 24, xrun builds the RAM-only WLANCRED credential blob from the kernel .env by itself, tools/mkwlancred.py; no flag)
#   DEFAULT END (B1, 2026-10-25): every run ends by the host. --expect patterns imply --early (stop when all are seen; --full waits for --duration instead); a run without them ends at --duration.
#                  With --expect-absent too (fast-loop 2026-11-09): a forbidden line ends the run at once (FAIL); after the last --expect the run waits XRUN_ABSENT_GRACE s (30) more, then stops; --full = whole --duration (soak)
#                  (default --restart, else 300 s after fastboot boot) with the software reset; the --restart timer is only the fallback (the B2 "recovery" result of run bl2-timer was a root-mount-failure reset at +207 s, not the timer).
#   --remote-reset  adds boot-arg sweetremote=1 (xnu patch 0100): an early stop (--early / --stop-on) then resets the phone into the bootloader over the USB link (tools/phone goto fastboot sends
#                  UDP SWEET-RESET-BL) instead of waiting for the self-reset timer. --restart N,bootloader (timer path) lands in fastboot directly, not in recovery.
#                  --early / --stop-on turn --remote-reset ON by default (observed working 2026-10-24, run bl1-remote3: phone in fastboot ~95 s after the stop instead of waiting ~700 s); --no-remote-reset disables it.
#   STANDARD ROOT (user 2026-11-09): every boot's overlay = the standard copies (from the flashed image + $A/std-extras) of the files earlier overlays and
#                  devsh pushes changed since the last flash, plus launchd.plist, then this run's --overlay on top (tools/overlay_std.py; OVERLAY STD lines in the
#                  log and the run record; re-prepared and rebuilt under the lock when another run changed the ledger meanwhile; files an overlay ADDED are RESIDUE)
#   --fail-on RX   (repeatable) end the run as soon as RX appears in the log and score it FAIL: a failing run no longer waits out --restart. With --early/--stop-on these default to
#                  `Kernel trap at|panic\(cpu|panic:|Assertion failed`; --fail-on none disables the defaults.
#   SAFETY (RULES H9, docs/SAFETY-CHECKLIST.md, user 2026-11-12): `tools/safety-check pre` after the build and BEFORE the phone lock (a FAIL refuses the run, exit 2),
#                  `safety-check fastboot` under the lock right before the boot (bluejay, battery-voltage, storage-temperature), `safety-check monitor` from
#                  `fastboot boot` to the end (S1 temp >= 45 C, S3 no temp row, S4 soc/vcell, S6 silent boot): a monitor stop ends the boot (report SAFETY STOP)
#                  and parks the phone in fastboot; an S6 stop or a failed park notifies the thread at once (`safety-check notify`) and marks HUMAN-NEEDED.
#                  --no-usbnet, --no-chg and --no-wdt (once the early watchdog is on trunk) are refused by pre: the boot could not be watched. State: $A/safety.
#   --no-wdt       do not add the default boot-arg sweetwdt=60 (SoC watchdog, patch 0278; a hard hang then needs the restart timer or a button)
#   --no-epoch     do not add the default boot-arg sweetepoch=<host unix seconds now> (xnu patch 0345: the phone's calendar starts at the host date instead of 1970; the value is taken when xrun builds the line, so
#                  drift = build-to-boot delay; kernels without 0345 ignore it; an own sweetepoch= in --args is kept; not added for --intent el2)
#   --no-chg       do not add the default boot-args sweetchgi2c=1 sweetchgicl=900 (patches 0284/0287: PixOS charges at 875 mA over USB 3 instead of draining at 500 mA)
#   --no-camera    do not start the ESP camera capture (saves ~5 s, and works without the camera; the report then has no SCREEN line)
#   --lock-wait S  the phone lock (tools/phone-lock, TP-020) is taken only AFTER the image is built, right before the phone is touched; wait up to S s
#                  (queued, in arrival order) for another owner to finish, default 0 = fail at once with who holds it. Under `phone-lock run` it is already held.
#   --stop-on RX   (repeatable; --early = all --expect patterns) end the capture as soon as every pattern is in the merged log, instead of
#                  waiting for the self-reset (restart+300 s). Then the phone is put back in fastboot (to-fastboot.sh) if it has reset or is
#                  reachable; else ONE report line "PHONE: still running; self-reset due in ~Ns / Power+VolDown hold". RESULT PASS + "EARLY: stopped at +Ns (full run would have waited Ms)".
#   --hard-timeout S  cap (from xrun start) on the wait for the run, plus up to XRUN_GRACE s (default 90) when the reset was due but the phone is not back yet; default none (--duration still applies). A FAIL on timeout carries
#                  "PHONE:" from a bounded probe (lsusb, adb get-state, fastboot product; each under its own 5-8 s timeout).
#   tools/xrun --print-bootargs ARGS...   (host only, TP-040) print "implicit: <boot-args xrun adds itself, e.g. sweetremote=1>|none" and the exact
#                                            "boot-args: ..." line this run would build, then exit: no run dir, build, lock or phone; no --kernel/plan/CAM_HOST needed
#   tools/xrun --dry-run --from-dir DIR [--stop-on RX]...   rebuild the report of an existing run dir (no phone); with --stop-on, replay an early stop
#                                            (rewrites report.txt/merged.log in DIR: copy it first if it must stay untouched)
# Cycle: mkadt -> build-xnu-image -> [take the phone lock] -> to-fastboot -> camera/QR capture -> fboot -> wait for the self-reset -> report.
# Exit: 0 PASS, 1 FAIL/PARTIAL, 2 ERROR.  --no-flash-check: skip the to-fastboot step (the phone is already in fastboot).
#   SIM SEAMS (simulation framework, docs/plans/PLAN-SIM.md; env only, default behaviour unchanged, each active one prints `SIM SEAM ACTIVE: NAME=value` on stderr at start, rule 8; tools/test_sim_seams.sh):
#              XRUN_SAFETY=CMD        a command run instead of `python3 -I tools/safety-check` (pre/fastboot/monitor/notify; sandbox only, like the five below)
#              XRUN_SYSFS_USB=DIR     USB sysfs root instead of /sys/bus/usb/devices (xrun, tools/usb-port, tools/xrun_report.py: tools/simseams.py)
#              XRUN_TO_FASTBOOT / XRUN_FBOOT / XRUN_BUILD / XRUN_USB_PORT / XRUN_RUN_PREFLIGHT = a command path run instead of tools/to-fastboot.sh / tools/fboot.sh / tools/build-xnu-image.sh / tools/usb-port / `python3 -I tools/run-preflight`;
#                                     these five replace safety wrappers (AP-299): REFUSED, exit 2, unless PHONE_LOCK_DIR is a test lock (set, not the real lock, under $TMPDIR; tools/simseams.py require)
#              PIXOS_SLEEP_SCALE=F    (decimal 0..1000, at most 30 ASCII digits/dot, default 1) multiplier for the fixed sleeps of xrun (usb wait, camera start, usbnet start, post-wait) and the poll of tools/phone / tools/phone-lock acquire; 0 = no sleep in xrun; anything else = exit 2
#              every active seam is also marked in the run record (run.json sim_seams, xrun.log, report "SIM SEAMS ACTIVE:", rule 8)
#              (XRUN_PHONE / XRUN_POSTMORTEM / XRUN_POSTMORTEM_TIMEOUT below are older hooks and print nothing)
# T-7dff:help: -h/--help prints this header and exits 0 before anything runs
case "${1:-}" in -h|--help) printf 'usage: %s\n' "${0##*/}"; sed -n '2,/^[^#]/{/^#/s/^# \{0,1\}//p}' "${XRUN_SELF:-$0}"; exit 0;; esac
set -euo pipefail
# Run from a private copy (autorecover 2026-11-09, run ar-b-stalltest: tools/xrun was edited in the same worktree while it ran; bash reads a
# script as it goes and died with "syntax error near unexpected token" at the end of a 15-min run, no report). tools-sync pull or any edit
# can do the same to any thread. The copy is unlinked at once (bash keeps the open file); XRUN_SELF carries the real path.
if [ -z "${XRUN_SELF:-}" ]; then
	xsnap=$(mktemp "${TMPDIR:-/tmp}/xrun.XXXXXX") && cp -- "$0" "$xsnap" || { echo "RESULT: ERROR xrun: cannot copy itself to a private file" >&2; exit 2; }
	XRUN_SELF=$(cd "$(dirname "$0")" && pwd)/$(basename "$0") XRUN_SNAP=$xsnap exec bash "$xsnap" "$@"
fi
[ -z "${XRUN_SNAP:-}" ] || rm -f -- "$XRUN_SNAP"
xself=$XRUN_SELF; unset XRUN_SELF XRUN_SNAP   # children (a nested xrun, phone-session) make their own copy
cd "$(dirname "$xself")/.."
# SIM seams: sim_warn names the active override variables (stderr) and refuses a malformed PIXOS_SLEEP_SCALE before any phone lock; sim_sleep is the ONE scaled sleep (shell twin of tools/simseams.py sleep())
sim_warn() { local n; simseams_list=""; for n in "$@"; do [ -z "${!n:-}" ] || { echo "SIM SEAM ACTIVE: $n=${!n}" >&2; simseams_list+="${simseams_list:+,}$n"; }; done
	[ -z "${PIXOS_SLEEP_SCALE:-}" ] || sim_scale_ok "$PIXOS_SLEEP_SCALE" || { echo "SIM SEAM ERROR: PIXOS_SLEEP_SCALE=$PIXOS_SLEEP_SCALE is not a decimal number in 0..1000 (at most 30 ASCII characters)" >&2; exit 2; }; }
sim_scale_ok() { ( export LC_ALL=C; [[ $1 =~ ^[0-9]+(\.[0-9]+)?$ ]] && [ "${#1}" -le 30 ] && awk -v k="$1" 'BEGIN { exit !(k + 0 <= 1000) }' ); }   # LC_ALL=C: a fullwidth digit must not match (the Python twin rejects it)
sim_require() { local n any=""; for n in "$@"; do [ -z "${!n:-}" ] || any=1; done   # the command seams replace safety wrappers: only in a sandbox (review xrun-seams-r1 F1, AP-299)
	[ -z "$any" ] || python3 -I tools/simseams.py require "$@" || exit 2; }
sim_sleep() { local t
	[ -n "${PIXOS_SLEEP_SCALE:-}" ] || { sleep "$1"; return; }
	t=$(LC_ALL=C awk -v s="$1" -v k="$PIXOS_SLEEP_SCALE" 'BEGIN { printf "%.6f", s * k }')
	[ "$t" = 0.000000 ] || sleep "$t"; }
sim_warn XRUN_SYSFS_USB XRUN_TO_FASTBOOT XRUN_FBOOT XRUN_BUILD XRUN_USB_PORT XRUN_RUN_PREFLIGHT PIXOS_SLEEP_SCALE XRUN_SAFETY
sim_require XRUN_TO_FASTBOOT XRUN_FBOOT XRUN_BUILD XRUN_USB_PORT XRUN_RUN_PREFLIGHT XRUN_SAFETY
usbsys=${XRUN_SYSFS_USB:-/sys/bus/usb/devices}; tofb=${XRUN_TO_FASTBOOT:-tools/to-fastboot.sh}; fbootx=${XRUN_FBOOT:-tools/fboot.sh}; bxibin=${XRUN_BUILD:-tools/build-xnu-image.sh}; usbportx=${XRUN_USB_PORT:-tools/usb-port}
pf=(python3 -I tools/run-preflight); [ -z "${XRUN_RUN_PREFLIGHT:-}" ] || pf=("$XRUN_RUN_PREFLIGHT")
sc=(python3 -I tools/safety-check); [ -z "${XRUN_SAFETY:-}" ] || sc=("$XRUN_SAFETY")   # RULES H9
A=${ARTIFACTS:-$HOME/pixelios-artifacts}
R="python3 tools/xrun_report.py"   # not -I: PIL lives in the user site-packages
kernel=""; adt=""; board=bluejay; cpus=8; qr=off; restart=""; args=""; duration=""; label=run; check=1; rw="--rw"; gui=""; usbnet="--usbnet"; usbdma=""; rails=""; handover=""; pmicsrc=""; sweetprobe=""; pmicclr=""; gpuclklvl=""; mifclevel=""; wlan=""; wlanlvl=""; dvfs=()
cpus_set=0; nowdt=0; nochg=0; noepoch=0; intent=""; lockwait=0; remote=""; noremote=0; full=0; nocam=0; failons=(); dry=0; fromdir=""; exps=(); abs=(); stops=(); early=0; hard=""; rawexp=(); reader=""; overlay=""; compress=""; wlanfw=""; printba=0; implicit=""; el2=""; el2b3=""; spin=""; nomif=0; mifclk=""
orig=("$@")   # the option loop below shifts "$@" away
while [ $# -gt 0 ]; do case "$1" in
	--kernel) kernel=$2; shift 2 ;; --adt) adt=$2; shift 2 ;; --board) board=$2; shift 2 ;; --cpus) cpus=$2; cpus_set=1; shift 2 ;;
	--qr) qr=$2; shift 2 ;; --restart) restart=$2; shift 2 ;; --args) args=$2; shift 2 ;; --duration) duration=$2; shift 2 ;;
	--label) label=$2; shift 2 ;; --expect) exps+=("expect=$2"); rawexp+=("$2"); shift 2 ;; --stop-on) stops+=("$2"); shift 2 ;; --early) early=1; shift ;; --hard-timeout) hard=$2; shift 2 ;; --lock-wait) lockwait=$2; [[ $lockwait =~ ^[0-9]+$ ]] || { echo "RESULT: ERROR --lock-wait needs whole seconds"; exit 2; }; shift 2 ;; --full) full=1; shift ;; --remote-reset) remote=1; shift ;; --no-remote-reset) noremote=1; shift ;; --fail-on) failons+=("$2"); shift 2 ;; --no-camera) nocam=1; shift ;; --no-wdt) nowdt=1; shift ;; --no-chg) nochg=1; shift ;; --no-epoch) noepoch=1; shift ;; --expect-absent) abs+=("expect_absent=$2"); shift 2 ;;
	--rw) rw=--rw; shift ;; --rails) rails=--rails; shift ;; --no-rails) norails=1; shift ;; --gpu-handover) handover=--gpu-handover; shift ;; --gpu-clk-level) gpuclklvl=$2; shift 2 ;; --mif-clk-level) mifclk=--mif-clk; mifclevel=${2:?--mif-clk-level needs a MIF table row in kHz}; shift 2 ;; --mif-clk) mifclk=--mif-clk; shift ;; --sweet-probe) sweetprobe=--sweet-probe; shift ;; --pmic-src) pmicsrc=--pmic-src; shift ;; --pmic-src-clear) pmicsrc=--pmic-src; pmicclr=--pmic-src-clear; shift ;; --no-mif-clk) nomif=1; shift ;; --wlan-hold) wlan=--wlan-hold; shift ;; --wlan-level) wlanlvl=$2; shift 2 ;; --dvfs) dvfs=(--dvfs "$2"); shift 2 ;; --gui) gui=--gui; shift ;; --usbnet) usbnet=--usbnet; shift ;; --no-usbnet) usbnet=""; shift ;; --usbdma) usbnet=--usbnet; usbdma=--usbdma; shift ;; --no-flash-check) check=0; shift ;;
	--intent) intent=$2; shift 2 ;; --dry-run) dry=1; shift ;; --from-dir) fromdir=$2; shift 2 ;; --reader) reader=$2; shift 2 ;; --overlay) overlay=$2; shift 2 ;; --compress) compress=--compress; shift ;; --wlanfw) wlanfw=$2; shift 2 ;; --print-bootargs) printba=1; shift ;; --el2-trap) el2=--el2-trap; shift ;; --el2-b3) el2b3=--el2-b3; shift ;; --panic-spin) spin=$2; shift 2 ;;
	*) echo "unknown option $1 (valid options: $(grep -oE '^[[:space:]]*(-[-A-Za-z0-9]+\|?)+\)' "$xself" | tr -d ' \t)' | tr '|\n' '  '); -h prints the header)" >&2; exit 2 ;; esac; done
# GPU INTENT DEFAULTS (goal "GPU result is the default", sprint-gpu 2026-11-09): `tools/xrun --kernel K --intent gpu` alone reproduces the nav44 configuration
# (docs/sprint/2026-11-08-gpu.md GOAL MET: fps-bench v2.1 fps_min 56.7). Every default is overridable (an explicit flag / boot-arg key wins) and listed on the `implicit:` line.
# NOT defaults: the kdebug stream (sweetkdbg), the GIC probe (sweetmali bit 0x40) and the witnesses
# (sweetpcsamp, sweetthrwait, SWEETGL_GAPT/GAPW). The Mali L2 cache (sweetmalicache 2, patch 0266) IS a default since 2026-11-10 (user OK after
# gputest-cache1/cache2: every captured screen matches the llvmpipe reference; gpu_add below).
gpu_add() { case " $args " in *" $1="*) ;; *) args="${args:+$args }$1=$2"; gpuimplicit="${gpuimplicit:+$gpuimplicit }$1" ;; esac; }
# TOUCH DEFAULTS (user 2026-11-11: touch is on for every boot and intent; el2 excluded: it refuses touch args and --rails by design, TP-045).
# Recipe = the one that answered on hardware: 20261022T195946Z-demo1b and the three 20261104T12*Z-demo-gpu-touch-wifi runs (identify 36 48, SWEET TOUCH: ev).
# Rails (shim --touch-probe=rails, ACPM LDO25M/LDO26M): without them the FTM5 never answers (gputest-* 2026-11-10: identify 00 00, MISO low).
# Escape: boot-arg sweettouch=0 (kernel logs a TOUCH GAP, patch 0304) = no touch args and no rails; --no-rails drops only the rails. Explicit keys win.
# Kernel side: sweettouch defaults to 2 (patch 0088), so only the bus/clock/pad keys are passed (~100 boot-arg bytes; gpu line 870 of 1023, patch 0176).
if [ "$intent" != el2 ] && ! [[ " $args " =~ \ sweettouch=(0|-[0-9]+)\  ]]; then
	[ -n "$rails" ] || [ "${norails:-0}" = 1 ] || { rails=--rails; gpuimplicit="${gpuimplicit:+$gpuimplicit }--rails"; }
	gpu_add sweettouchmux 1; gpu_add sweettouchclk 3; gpu_add sweettouchcs 1; gpu_add sweettouchpoke 'm:10c00640=0=10;d:100;m:10c0180c=5=f;'
fi
if [ "$intent" = gpu ]; then
	[ -n "$handover" ] || { handover=--gpu-handover; gpuimplicit="${gpuimplicit:+$gpuimplicit }--gpu-handover"; }
	[ -n "$gpuclklvl" ] || { gpuclklvl=1; gpuclk_dflt=1; gpuimplicit="${gpuimplicit:+$gpuimplicit }--gpu-clk-level=1"; }   # G3D 762 / G3DL2 996 MHz = stock 6a maximum (shim soc.json row 1)
	[ ${#dvfs[@]} -gt 0 ] || { dvfs=(--dvfs "1803000,2253000,2802000"); gpuimplicit="${gpuimplicit:+$gpuimplicit }--dvfs=1803000,2253000,2802000"; }   # A55 / A76 / X1 stock 6a maxima
	[ "$cpus_set" = 1 ] || { cpus=5; gpuimplicit="${gpuimplicit:+$gpuimplicit }--cpus=5"; }
	[ -n "$restart" ] || { restart=640,bootloader; gpuimplicit="${gpuimplicit:+$gpuimplicit }--restart=640,bootloader"; }
	[ -n "$duration" ] || duration=600
	[ -n "$hard" ] || hard=700
	[ "$full" = 1 ] || full=1
	cpuorder=0,6,7,4,5,1,2,3   # /cpus DT order: boot A55, the two A76, the two X1 first, so cpus=5 runs on them (sprint-gpu nav19+)
	if [ -z "$adt" ]; then gpuimplicit="${gpuimplicit:+$gpuimplicit }--adt-cpu-order=$cpuorder"; fi
	if [ ${#stops[@]} -eq 0 ]; then stops+=('SWEET NAV: done reps 3'); fi
	[ ${#failons[@]} -gt 0 ] || failons=('GPU GAP: PLL' 'hfs_mountroot failed' 'Kernel trap at|panic\(cpu|panic:|Assertion failed')
	gpu_add sweetmali 1; gpu_add sweetmaliirq 1; gpu_add sweetmaliovl 1; gpu_add sweetmalipend 3; gpu_add sweetmalicache 2   # GPU L2 caching, PTE index 0 + SH 3 (patch 0266): every captured screen matches the llvmpipe reference (gputest-cache1/cache2, user OK 2026-11-10)
	gpu_add sweetrecores 0x1e   # patch 0270: the A55 boot core (cpu0) takes interrupts and bound kernel threads only; settings-open 51.4 -> 55.0/55.5 (gputest-count4 vs count5/count6, sprint-gpu 2026-11-10)
	gpu_add sweetfvmap 0x206a000
	gpu_add sweetnull devd,backboardd,SpringBoard
	gpu_add sweetenv backboardd:DYLD_INSERT_LIBRARIES=/usr/lib/libsweetgl.dylib,SWEETGL_BOCUT=1,SWEETGL_BOPOOL=1,SWEETGL_FLUSHT=1,SWEETGL_SPLITHEAP=1,SWEETGL_OVERLAP=1
	gpu_add sweetfps 2; gpu_add sweetpace 1; gpu_add sweetperf 1; gpu_add sweetfb_noconsole 1; gpu_add sweetfb_hz 30; gpu_add sweetsubmittm 1
	gpu_add sweetnav 3; gpu_add sweetnavstart 130
fi
# ALL-ON T-02 --mif-clk-level KHZ: only a MIF table row tools/boards.py accepts; exit 2 + RESULT: ERROR before build, lock or phone
if [ -n "$mifclevel" ]; then
	mlerr=$(python3 "$(dirname "$xself")/boards.py" "$board" --mif-clk-level-check "$mifclevel" 2>&1 >/dev/null) || { rc=$?; [ -n "$mlerr" ] || mlerr="MIF GAP: boards.py --mif-clk-level-check failed rc=$rc with no reason"; }
	[ -z "$mlerr" ] || { echo "$mlerr" >&2; echo "RESULT: ERROR $mlerr"; exit 2; }
fi
# T-a214 --gpu-clk-level: only with --gpu-handover and only a pair index tools/boards.py accepts (reason printed); exit 2 + RESULT: ERROR before build, lock or phone
if [ -n "$gpuclklvl" ] && [ "${gpuclk_dflt:-0}" = 0 ]; then
	glerr=""
	[ -n "$handover" ] || glerr="--gpu-clk-level needs --gpu-handover (the shim asks the pair after the rail-on step)"
