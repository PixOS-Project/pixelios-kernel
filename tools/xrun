#!/bin/bash
# One hardware test cycle -> ONE short report (docs/AUTOMATION.md). Progress goes to <run dir>/xrun.log, stdout is the report.
#   tools/xrun --kernel K [--adt A | --board bluejay] [--cpus N] [--qr S|off] [--restart S] [--args "boot-args"] [--gui] [--rails] [--dvfs K0,K1,K2|read] [--no-usbnet | --usbdma]   (USB UDP log is ON by default since 2026-10-22; QR only with --qr S) (always --rw: a read-only root panics in mount(8))
#              [--reader "qr-log.py options"]   (e.g. "--workers 3 --average 3 --tiles 1"; QL2 boot-args go in --args: sweetqr_fmt=1|2 sweetqr_ver sweetqr_ecc sweetqr_tiles sweetqr_ms sweetqr_k sweetqr_red sweetqr_fec sweetqr_hold)
#              [--expect REGEX]... [--expect-absent REGEX]... [--duration S] [--label NAME] [--no-flash-check]
#              [--early] [--stop-on REGEX]... [--hard-timeout S] [--lock-wait S]
#   --lock-wait S  the phone lock (tools/phone-lock, TP-020) is taken only AFTER the image is built, right before the phone is touched; wait up to S s
#                  (queued, in arrival order) for another owner to finish, default 0 = fail at once with who holds it. Under `phone-lock run` it is already held.
#   --stop-on RX   (repeatable; --early = all --expect patterns) end the capture as soon as every pattern is in the merged log, instead of
#                  waiting for the self-reset (restart+300 s). Then the phone is put back in fastboot (to-fastboot.sh) if it has reset or is
#                  reachable; else ONE report line "PHONE: still running; self-reset due in ~Ns / Power+VolDown hold". RESULT PASS + "EARLY: stopped at +Ns (full run would have waited Ms)".
#   --hard-timeout S  absolute cap (from xrun start) on the whole run; default none (--duration still applies). A FAIL on timeout carries
#                  "PHONE:" from a bounded probe (lsusb, adb get-state, fastboot product; each under its own 5-8 s timeout).
#   tools/xrun --dry-run --from-dir DIR [--stop-on RX]...   rebuild the report of an existing run dir (no phone); with --stop-on, replay an early stop
#                                            (rewrites report.txt/merged.log in DIR: copy it first if it must stay untouched)
# Cycle: mkadt -> build-xnu-image -> [take the phone lock] -> to-fastboot -> camera/QR capture -> fboot -> wait for the self-reset -> report.
# Exit: 0 PASS, 1 FAIL/PARTIAL, 2 ERROR.  --no-flash-check: skip the to-fastboot step (the phone is already in fastboot).
set -euo pipefail
cd "$(dirname "$0")/.."
A=${ARTIFACTS:-$HOME/pixelios-artifacts}
R="python3 tools/xrun_report.py"   # not -I: PIL lives in the user site-packages
kernel=""; adt=""; board=bluejay; cpus=1; qr=off; restart=""; args=""; duration=""; label=run; check=1; rw="--rw"; gui=""; usbnet="--usbnet"; usbdma=""; rails=""; dvfs=()
lockwait=0; dry=0; fromdir=""; exps=(); abs=(); stops=(); early=0; hard=""; rawexp=(); reader=""
while [ $# -gt 0 ]; do case "$1" in
	--kernel) kernel=$2; shift 2 ;; --adt) adt=$2; shift 2 ;; --board) board=$2; shift 2 ;; --cpus) cpus=$2; shift 2 ;;
	--qr) qr=$2; shift 2 ;; --restart) restart=$2; shift 2 ;; --args) args=$2; shift 2 ;; --duration) duration=$2; shift 2 ;;
	--label) label=$2; shift 2 ;; --expect) exps+=("expect=$2"); rawexp+=("$2"); shift 2 ;; --stop-on) stops+=("$2"); shift 2 ;; --early) early=1; shift ;; --hard-timeout) hard=$2; shift 2 ;; --lock-wait) lockwait=$2; shift 2 ;; --expect-absent) abs+=("expect_absent=$2"); shift 2 ;;
	--rw) rw=--rw; shift ;; --rails) rails=--rails; shift ;; --dvfs) dvfs=(--dvfs "$2"); shift 2 ;; --gui) gui=--gui; shift ;; --usbnet) usbnet=--usbnet; shift ;; --no-usbnet) usbnet=""; shift ;; --usbdma) usbnet=--usbnet; usbdma=--usbdma; shift ;; --no-flash-check) check=0; shift ;;
	--dry-run) dry=1; shift ;; --from-dir) fromdir=$2; shift 2 ;; --reader) reader=$2; shift 2 ;;
	*) echo "unknown option $1 (see the header of tools/xrun)" >&2; exit 2 ;; esac; done
if [ "$dry" = 1 ]; then [ -d "$fromdir" ] || { echo "--dry-run needs --from-dir DIR" >&2; exit 2; }; a=(); for x in ${stops[@]+"${stops[@]}"}; do a+=(--stop-on "$x"); done; exec $R report "$fromdir" ${a[@]+"${a[@]}"}; fi
[ "$early" = 0 ] || [ ${#stops[@]} -gt 0 ] || stops=("${rawexp[@]}")
[ -f "$kernel" ] || { echo "RESULT: ERROR --kernel FILE is required (got '$kernel')"; exit 2; }
label=$(printf %s "$label" | tr -c 'A-Za-z0-9._-' _)
D=logs/runs/$(date -u +%Y%m%dT%H%M%SZ)-$label; mkdir -p "$D/snaps" "$D/frames"; LOG=$D/xrun.log; : >"$LOG"
secs=${restart%%,*}; [ -n "$duration" ] || duration=$(( ${secs:-60} + 300 ))
. tools/plock.sh
cap=""; usbpid=""
stop_capture() { touch "$D/stop"; [ -z "$usbpid" ] || { wait "$usbpid" 2>/dev/null || true; usbpid=""; }
	[ -z "$cap" ] || { sleep 1; kill "$cap" 2>/dev/null || true; wait "$cap" 2>/dev/null || true; }; }
cleanup() { stop_capture; plock_drop; }
trap cleanup EXIT
die() { $R error "$D" "$*" || exit $?; exit 2; }
tailog() { tail -n 3 "$LOG" | tr '\n' ' ' | cut -c1-200; }

stopkv=(); for x in ${stops[@]+"${stops[@]}"}; do stopkv+=("stop_on=$x"); done
if head=$(git rev-parse --short HEAD 2>/dev/null); then git diff --quiet HEAD || head=$head+dirty; else head=nogit; fi
$R mark "$D" label="$label" kernel="$kernel" cpus="$cpus" qr="$qr" restart="$restart" duration="$duration" \
	git_head="$head" t_start=@now ${hard:+hard_timeout="$hard"} kernel_sha256="$(sha256sum "$kernel" | cut -d' ' -f1)" \
	${stopkv[@]+"${stopkv[@]}"} ${exps[@]+"${exps[@]}"} ${abs[@]+"${abs[@]}"}

if [ "$check" = 1 ]; then
	grep -qsx 18d1 /sys/bus/usb/devices/*/idVendor || die "needs Power+VolDown hold (no Google USB device 18d1 visible)"
fi
if [ -n "$adt" ]; then cp "$adt" "$D/A.adt"; else python3 -I tools/mkadt.py "$D/A.adt" --board "$board" >>"$LOG" 2>&1 || die "mkadt failed: $(tailog)"; fi
tools/build-xnu-image.sh --kernel "$kernel" --adt "$D/A.adt" --qr "$qr" --cpus "$cpus" ${restart:+--restart "$restart"} ${args:+--args "$args"} $rw $rails "${dvfs[@]}" $gui $usbnet $usbdma >"$D/build.out" 2>>"$LOG" \
	|| die "build-xnu-image failed: $(tail -n 3 "$D/build.out" "$LOG" | tr '\n' ' ' | cut -c1-200)"
[ -z "$usbnet" ] || $R mark "$D" usbnet=1
$R mark "$D" boot_args="$(sed -n 's/^boot-args: //p' "$D/build.out")"
cp shim/out/shim-boot-avb.img.meta.json "$D/image.meta.json" 2>/dev/null || true

# the image is ready: only now take the phone (builds and gates never hold the lock)
plock_take xrun "$lockwait" || die "phone lock busy: $PLOCK_MSG"
if [ "$check" = 1 ]; then
	tools/to-fastboot.sh 120 >>"$LOG" 2>&1 || {
		if grep -q REFUSED "$LOG"; then die "device is not bluejay (to-fastboot refused): $(tailog)"; fi
		die "needs Power+VolDown hold (phone not reachable by fastboot/adb)"; }
fi

PYTHONPATH="$A/pylib" python3 tools/qr-log.py --esp --keep-going --follow --out "$D/snaps" --save-dir "$D/frames" --save-every 4 --until-file "$D/stop" $reader >"$D/capture.log" 2>&1 &
cap=$!
sleep 4
kill -0 "$cap" 2>/dev/null || { cap=""; die "camera capture died at start: $(tail -n 2 "$D/capture.log" | tr '\n' ' ' | cut -c1-200)"; }

if [ -n "$usbnet" ]; then
	# root-free UDP listener (stops on $D/stop); the interface address needs the user's one sudo line
	python3 -I tools/usbnet-log.py --out "$D/usbnet.log" --until-file "$D/stop" --quiet >"$D/usbnet.out" 2>&1 &
	usbpid=$!
	sleep 1; kill -0 "$usbpid" 2>/dev/null || { usbpid=""; die "usbnet listener died (port 5140 busy?): $(tail -n 2 "$D/usbnet.out" | tr '\n' ' ')"; }
	echo "USBNET: run once the phone enumerates (needs root): $(tools/sweet-usbnet.sh --stage)" | tee -a "$LOG" >&2
fi
$R mark "$D" t_boot=@now
tools/fboot.sh --expect xnu shim/out/shim-boot-avb.img >>"$LOG" 2>&1 || die "fboot refused/failed: $(tailog)"
tb=$(date +%s)
echo "booted; waiting up to ${duration}s" >>"$LOG"
how=$($R waitusb "$D" || true)
sleep 3
$R mark "$D" t_end=@now
stop_capture; cap=""   # the phone lock stays held until exit: the EARLY/TIMEOUT recovery below still talks to the phone
# bounded probe: every call has its own timeout (never a bare fastboot call)
probe() { local u a f
	u=$(timeout 5 lsusb 2>/dev/null | awk '{print $6}' | grep -E '^(18d1|05ac)' | tr '\n' ' ')
	a=$(timeout 8 adb get-state 2>&1 | head -1 | cut -c1-60)
	f=$(timeout 8 fastboot getvar product 2>&1 | sed -n 's/^product: *//p' | head -1)
	echo "usb ids [${u:-none}] adb [${a:-no answer}] fastboot product [${f:-no answer}]"; }
case "$how" in
EARLY) # every stop pattern seen: recover the phone if it can be reached, else say so in one line
	el=$(( $(date +%s) - tb )); left=$(( ${secs:-0} - el ))
	if grep -qsx 18d1 /sys/bus/usb/devices/*/idVendor && timeout 90 tools/to-fastboot.sh 60 >>"$LOG" 2>&1; then
		$R mark "$D" phone="back in fastboot (stopped early)"
	elif grep -qsx 18d1 /sys/bus/usb/devices/*/idVendor; then $R mark "$D" phone="reachable but to-fastboot failed (see xrun.log); Power+VolDown hold"
	else $R mark "$D" phone="still running; self-reset due in ~$(( left > 0 ? left : 0 ))s / Power+VolDown hold"; fi ;;
TIMEOUT) $R mark "$D" phone="$(probe)" ;;
esac
rc=0; $R report "$D" || rc=$?
$R prune "$D" || true
exit $rc
