#!/usr/bin/env python3
"""gen-wlan-a80211-patch: regenerates xnu patch 0201 (Apple80211 ioctl/event glue on en0) from shim/sweet_wlan_a80211.h, sweet_wlan_sta.h and the glue; shim/build.sh --check refuses a stale patch

Maps (T-7241; the patch and shim/ cannot drift because shim/build.sh runs --check):
  bsd/dev/sweet_wlan_sta.h     = shim/sweet_wlan_sta.h        byte for byte (the X-W1 station handler)
  bsd/dev/sweet_wlan_a80211.h  = shim/sweet_wlan_a80211.h      byte for byte
  bsd/dev/sweet_wlan_radio.h   = shim/sweet_wlan_radio.h       byte for byte (T-431f: the swsta_radio backend over escan result events)
  bsd/dev/sweet_wlan_a80211.c  = shim/wlan_a80211_glue.c.in   byte for byte
  bsd/conf/files               + one line, after the line patch 0199 added (bsd/dev/sweet_wlan_en0.c)

  tools/gen-wlan-a80211-patch [--out FILE]   write the patch (default xnu/patches/0201-sweet-wlan-a80211-glue.patch)
  tools/gen-wlan-a80211-patch --check        exit 1 when the patch on disk differs from what would be written
  tools/gen-wlan-a80211-patch --self-test    inline checks (also run by tools/test_gen_wlan_a80211_patch.py)
Last line: RESULT: PASS|FAIL gen-wlan-a80211-patch ..."""
if __import__("sys").argv[1:2] in (["-h"], ["--help"]):  # T-7dff:help: usage before any import or side effect
    print("usage: " + __file__.rsplit("/", 1)[-1] + "\n" + (__doc__ or "".join(l[2:] for l in open(__file__).readlines()[1:60] if l.startswith("# "))).strip()); raise SystemExit(0)
import hashlib
import os
import sys

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
OUT = os.path.join(ROOT, "xnu", "patches", "0201-sweet-wlan-a80211-glue.patch")

FILES = [
    ("bsd/dev/sweet_wlan_sta.h", "shim/sweet_wlan_sta.h"),
    ("bsd/dev/sweet_wlan_a80211.h", "shim/sweet_wlan_a80211.h"),
    ("bsd/dev/sweet_wlan_radio.h", "shim/sweet_wlan_radio.h"),
    ("bsd/dev/sweet_wlan_a80211.c", "shim/wlan_a80211_glue.c.in"),
]

MSG = """XNU Apple80211 ioctl forward, IEEE80211 media and kernel events on the Wi-Fi en0 ifnet (P-W4, T-7241; goal W-D7; research 110 s.3 and s.5).

Cause: wifid's IO80211 library talks to the interface by SIOCSA80211/SIOCGA80211 (_IOW/_IOWR 'i' 200/201, a 40-byte apple80211req whose req_data is a user
buffer), asks SIOCGIFMEDIA for IFM_IEEE80211 and reads kern_event messages (vendor 1, class 6, subclass 1, ifname[16] first). en0 (patch 0199) answered every
unknown ioctl EOPNOTSUPP and posted no Apple80211 event, so the library could neither bind nor scan.
Fix: new bsd/dev/sweet_wlan_a80211.h (the logic: copy the 40-byte request, copyin/copyout req_len bytes through req_data, call the station handler, wipe the
scratch buffer that held the ASSOCIATE body, refuse over-long and unmapped requests with a GAP line, build the kern_event post, chain every other command to
en0's own if_ioctl so SIOCGIFMEDIA keeps answering IFM_IEEE80211|IFM_AUTO), a verbatim copy of the X-W1 station handler bsd/dev/sweet_wlan_sta.h, and
bsd/dev/sweet_wlan_a80211.c (glue: copyin/copyout, one mutex, kev_post_msg_nowait, and sweet_wlan_a80211_attach() which puts the handler in front of
ifp->if_ioctl). Reachability read from XNU 22.6.0: ifioctl() (bsd/net/if.c:3184) hands an unknown 'i' command to pru_control (in_control, EOPNOTSUPP) and then
to ifnet_ioctl() -> ifp->if_ioctl, with no size check against ifreq. Generated by tools/gen-wlan-a80211-patch from shim/; shim/build.sh refuses a stale copy.
Tests: shim/wlan_a80211_glue_host_test.c (fake radio, fake user memory, fake kev_post_msg, the real en0_ioctl).
Not compiled against XNU here (CI builds the tree), not run on hardware. T-431f adds bsd/dev/sweet_wlan_radio.h (the swsta_radio backend over escan result events,
host-tested by shim/wlan_radio_host_test.c) and sweet_wlan_a80211_radio_attach(), which patch 0199's sweet_wlan_en0_init calls once en0 is up.
T-08fd wires the escan link: swr_replay_escan replays the ESCAN_RESULT events that the boot-time G2 L23 scan (patch 0174) recorded, via sweet_wlan_g2_escan_rec; no bus
access, no store; the listing is the boot-time one and says so (WIFI GAP, stale) on every scan; an empty record refuses the scan with a gap. Events carry an empty payload (WIFI GAP at attach).
"""

TAB = "\t"
CTX_BEFORE = ["bsd/dev/sweet_cpustat.c" + TAB * 3 + "standard", "bsd/dev/sweet_el2.c" + TAB * 3 + "standard", "bsd/dev/sweet_wlan_en0.c" + TAB * 3 + "standard"]
CTX_AFTER = ["bsd/dev/sweet_spmi.c" + TAB * 3 + "standard", "bsd/dev/sweet_usb.c" + TAB * 3 + "standard", "bsd/dev/sweet_usbroot.c" + TAB * 2 + "standard"]
ADD_LINE = "bsd/dev/sweet_wlan_a80211.c" + TAB * 3 + "standard"


def blob_id(data):
    h = hashlib.sha1(b"blob %d\0" % len(data))
    h.update(data)
    return h.hexdigest()[:7]


def source(path):
    with open(os.path.join(ROOT, path), "r", encoding="utf-8") as fh:
        return fh.read()


def new_file_hunk(dest, text):
    data = text.encode("utf-8")
    lines = text.split("\n")
    if lines[-1] == "":
        lines.pop()
    out = ["diff --git a/%s b/%s" % (dest, dest), "new file mode 100644", "index 0000000..%s" % blob_id(data),
           "--- /dev/null", "+++ b/%s" % dest, "@@ -0,0 +1,%d @@" % len(lines)]
    out.extend("+" + ln for ln in lines)
    return "\n".join(out) + "\n"


def build():
    parts = [MSG, "\n"]
    parts.append("diff --git a/bsd/conf/files b/bsd/conf/files\n--- a/bsd/conf/files\n+++ b/bsd/conf/files\n@@ -116,6 +116,7 @@ bsd/dev/sweet_cpustat.c\t\t\tstandard\n")
    parts.extend(" " + ln + "\n" for ln in CTX_BEFORE)
    parts.append("+" + ADD_LINE + "\n")
    parts.extend(" " + ln + "\n" for ln in CTX_AFTER)
    for dest, src in FILES:
        parts.append(new_file_hunk(dest, source(src)))
    return "".join(parts)


def self_test():
    sample = "line one\n\tline two\n"
    hunk = new_file_hunk("bsd/dev/x.h", sample)
    body = [ln[1:] for ln in hunk.split("\n") if ln.startswith("+") and not ln.startswith("+++")]
    ok = body == ["line one", "\tline two"] and "@@ -0,0 +1,2 @@" in hunk and hunk.startswith("diff --git a/bsd/dev/x.h b/bsd/dev/x.h\n")
    ok = ok and blob_id(b"") == "e69de29"                      # git's empty blob
    ok = ok and len(CTX_BEFORE) == 3 and len(CTX_AFTER) == 3    # hunk header says -116,6 +116,7
    print("RESULT: %s gen-wlan-a80211-patch self-test" % ("PASS" if ok else "FAIL"))
    return 0 if ok else 1


def main(argv):
    if "--self-test" in argv:
        return self_test()
    out = argv[argv.index("--out") + 1] if "--out" in argv else OUT
    text = build()
    if "--check" in argv:
        try:
            with open(out, "r", encoding="utf-8") as fh:
                same = fh.read() == text
        except OSError as e:
            print("GAP: gen-wlan-a80211-patch --check cannot read %s: %s" % (out, e), file=sys.stderr)
            same = False
        print("RESULT: %s gen-wlan-a80211-patch --check %s" % ("PASS" if same else "FAIL (stale: run tools/gen-wlan-a80211-patch)", os.path.basename(out)))
        return 0 if same else 1
    with open(out, "w", encoding="utf-8") as fh:
        fh.write(text)
    print("RESULT: PASS gen-wlan-a80211-patch wrote %s (%d bytes)" % (os.path.basename(out), len(text)))
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
