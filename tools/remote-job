fi

[ "$ran" = offload-host ] && [ "$keep" = 1 ] && { sshc bash -s <<<"touch \"$rdir/keep\"" >/dev/null 2>&1 || echo "remote-job: WARNING could not write the keep marker in offload-host:$rdir"; }
