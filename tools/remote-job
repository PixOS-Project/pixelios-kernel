		if [ "$where" = offload-host ]; then echo "REMOTE: offload-host run failed ($why), no fallback"; die "offload-host resubmit check failed for infra reasons ($why)"; fi
		fallback=$why; usable=0; echo "REMOTE: offload-host unavailable ($why), running local"
	fi
	[ -z "$collect" ] || die "--collect: the collect block did not exit (internal error); nothing submitted"
	if [ "${usable:-0}" = 1 ]; then
		if run_remote; then ran=offload-host
		elif [ $lockref = 1 ]; then echo "REMOTE: $why: operator error, not an outage; no local fallback"; [ $started = 1 ] && remote_cleanup; die "$why"
		elif [ "$where" = offload-host ]; then echo "REMOTE: offload-host run failed ($why), no fallback"; [ $started = 1 ] && remote_cleanup; die "offload-host run failed for infra reasons ($why), not falling back (--where offload-host)"
		else [ $started = 1 ] && remote_cleanup; fallback=$why; fell_back "$why"; fi
