remote_cleanup() {   # kill BOTH remote process groups (runner pid file, job group jpg), the container, remove the remote dir; loud on any failure
	local o
	o=$(sshc bash -s 2>&1 <<<"d=\"$rdir\"; gs=; for f in pid jpg; do g=\$(cat \"\$d/\$f\" 2>/dev/null); case \$g in ''|*[!0-9]*) ;; *) kill -KILL -- \"-\$g\" 2>/dev/null; gs=\"\$gs \$g\" ;; esac; done
\"$dkk\" kill \"rj-${rdir##*/}\" >/dev/null 2>&1
\"$dkk\" kill \"rj-xnub-${rdir##*/}\" >/dev/null 2>&1
[ -z \"\$gs\" ] || sleep 1
for g in \$gs; do kill -0 -- \"-\$g\" 2>/dev/null && echo \"REMOTE: WARNING process group \$g survived SIGKILL (offload-host:$rdir)\"; done
rm -rf \"\$d\"") || echo "REMOTE: WARNING could not kill/remove the remote job offload-host:$rdir; it may still run"
	grep -h '^REMOTE:' <<<"$o"
	return 0
}
on_signal() {   # Ctrl-C / TERM / HUP / PIPE: kill the ssh, the remote job groups, remove the remote dir and the bundle (review r2 cond. 4)
	trap - INT TERM HUP; trap '' PIPE   # PIPE: stdout/stderr were a tee that is gone (heavy-job aborted, scope stopped); a write error here must not end the cleanup
	[ "${1:-}" != PIPE ] || exec >&2   # our output pipe is dead: say it on stderr (the job log when heavy-job runs us), the RESULT line may not reach anyone
	echo "REMOTE: remote-job interrupted, cleaning up"
	[ -z "$sp" ] || kill "$sp" 2>/dev/null
	[ -z "$bundle" ] || { rm -f "$bundle"; echo "remote-job: removed $bundle"; }
	if [ "$started" = 1 ]; then remote_cleanup; echo "REMOTE: remote job group killed and offload-host:$rdir removed (the flock dies with the job)"; fi
	die "interrupted"
}
trap on_signal INT TERM HUP; trap "on_signal PIPE" PIPE   # SIGPIPE used to kill remote-job silently, leaving the remote job running and its result uncollected
lockref=0; gaps=0; fallback=${fallback:-}; rc=; prov=; t0=$(date +%s)
gapw=$(sed -n 's/.*--where auto|local|\([a-z-]*\)|.*/\1/p' "${BASH_SOURCE[0]}" | head -1); gapw=${gapw:-offload}   # the host word, read from the usage line so no host literal is added here
fell_back() {   # T-4ecb rule 8: transport lost AFTER the job started: one loud GAP line, counted as gaps=N in the RESULT line
	gaps=1; echo "${gapw^^} GAP: fell back to local, the offload host was lost mid-job ($1)"; echo "REMOTE: $gapw died mid-job ($1), running local"
}

# TP-042 resubmit check. Remote script runs as `bash -s` on stdin (fish). rc: 0 = clear, 1 = infra (reason in $why), exit 2 = refused.
rj_check() {
	local o ents e d have f lines=0 n_res=0 n_orph=0 s
	o=$({ printf 'job=%q; killorph=%q\n' "$job" "$killorph"
		[ "$hl" = 0 ] || printf 'rjdk=%q\n' "$hlpodman"
	cat <<'CHK'
d=$RJW/jobs; now=$(date +%s)
dk=${rjdk:-}; [ -n "$dk" ] || { dk=$HOME/.local/bin/docker; [ -x "$dk" ] || dk=$(command -v docker || { rc=$?; [ $rc = 1 ] || echo "remote-job GAP: command -v docker failed rc=$rc" >&2; }); }
cn=; [ -z "$dk" ] || cn=$("$dk" ps --format '{{.Names}}' 2>/dev/null)
for p in "$d/$job".[0-9]*.[0-9]*; do
	[ -d "$p" ] || continue; [ ! -e "$p/keep" ] || continue
	b=${p##*/}; pid=$(cat "$p/pid" 2>/dev/null); jpg=$(cat "$p/jpg" 2>/dev/null)
	alive=0; case $pid in ''|*[!0-9]*) ;; *) kill -0 "$pid" 2>/dev/null && alive=1 ;; esac
	galive=0; case $jpg in ''|*[!0-9]*) ;; *) kill -0 -- "-$jpg" 2>/dev/null && galive=1 ;; esac
	cl=; for cc in "rj-$b" "rj-xnub-$b"; do grep -qx "$cc" <<<"$cn" && cl="$cl,$cc"; done   # the gate container AND the in-slot XNU build container (review offload-xnub-r1 F5)
	cont=${cl#,}; cont=${cont:-none}
	act=
	if [ "$killorph" = 1 ] && [ $alive = 0 ]; then   # only this dir's own container/group, and only when its runner pid is dead
		[ "$cont" = none ] || { for cc in ${cont//,/ }; do "$dk" kill "$cc" >/dev/null 2>&1; done; act="$act killed-container"; cont=none; }
		[ $galive = 0 ] || { kill -KILL -- "-$jpg" 2>/dev/null; act="$act killed-group"; galive=0; }
	fi
	have=; for f in job.log job.rc prov out; do [ ! -e "$p/$f" ] || have="$have,$f"; done
	echo "ENTRY $b rc=$(cat "$p/job.rc" 2>/dev/null || echo none) age=$((now - $(stat -c %Y "$p")))s runner_alive=$alive group_alive=$galive container=$cont have=${have#,}${act:+ action=$act}"
done
for p in "$RJW"/mut-cache-root/*.bad-*; do   # TP-048: quarantined mutant caches, listed only (pruning is TP-033)
	[ -d "$p" ] || continue
	echo "BADCACHE ${p##*/} age=$((now - $(stat -c %Y "$p")))s size=$(du -sk "$p" | cut -f1)KiB"
done
CHK
	} | sshc bash -s 2>&1) || { why="resubmit check ssh failed: ${o:0:80}"; return 1; }
	ents=$(grep '^ENTRY ' <<<"$o")
	grep '^BADCACHE ' <<<"$o" | sed "s#^BADCACHE #REMOTE: MUTCACHE quarantined dir $([ "$hl" = 1 ] && echo lab-host || echo offload-host):$rwork/mut-cache-root/#" || true
	if [ -n "$collect" ]; then
		[[ $collect =~ ^$job\.[0-9]+\.[0-9]+$ ]] || die "bad --collect '$collect' (want $job.<time>.<pid>)"
		e=$(grep "^ENTRY $collect " <<<"$ents") || die "--collect $collect: no such dir on offload-host (or it has a keep marker)"
		grep -q 'runner_alive=0 group_alive=0 container=none' <<<"$e" || { echo "$e"; echo "RESULT: ERROR resubmit $job: --collect $collect refused, its runner or container is still alive"; exit 2; }
		have=$(sed -n 's/.* have=\([^ ]*\).*/\1/p' <<<"$e")
		d=$ldir/$collect; mkdir -p "$d" || die "cannot create $d"
		for f in ${have//,/ }; do
			"$scp_" -q -r "${sshopt[@]}" "$host:$rwork/jobs/$collect/$f" "$d/" >/dev/null 2>&1 || { echo "RESULT: ERROR resubmit $job: collect of $collect/$f failed, remote dir kept"; exit 2; }
		done
		sshc bash -s <<<"rm -rf \"\$RJW/jobs/$collect\"" >/dev/null 2>&1 || { echo "RESULT: ERROR resubmit $job: collected $collect to $d but could not remove the remote dir"; exit 2; }
		echo "remote-job: collected offload-host:$collect -> $d (have: ${have:-nothing}) and removed the remote dir"
		echo "RESULT: PASS collected $collect -> $d (no job submitted)"; exit 0   # --collect only collects (AP-194): never falls through to the submit
	fi
	while IFS= read -r e; do
		[ -n "$e" ] || continue
		grep -q ' runner_alive=1 ' <<<"$e" && continue   # a RUNNING job is not a leftover: the per-name flock below refuses it with "already running" (keeps that message)
		echo "REMOTE: $e"
		if grep -q ' rc=none ' <<<"$e"; then n_orph=$((n_orph + 1)); else n_res=$((n_res + 1)); fi
	done <<<"$ents"
	lines=$((n_res + n_orph)); [ "$lines" -gt 0 ] || return 0; s="uncollected result"; [ "$n_res" -gt 0 ] || s="orphan"
	[ "$n_orph" -gt 0 ] && [ "$n_res" -gt 0 ] && s="uncollected result|orphan"
	echo "RESULT: ERROR resubmit $job has $s ($lines dir(s) on offload-host; use --collect DIR, --kill-orphan, or --keep on the earlier run)"; exit 2
}

run_remote() {   # 0 = job ran (rc in job.rc), 1 = infra problem (reason in $why)
	why=
	for i in $inputs; do
		[ -z "$(git status --porcelain --untracked-files=normal -- "$i")" ] || { why="uncommitted changes in $i: the bundle carries commits only"; return 1; }
	done
	if [ "$kind" != gpu ]; then   # every tracked path must be clean, not only the inputs (review r2 cond. 8)
		[ -z "$(git status --porcelain --untracked-files=no)" ] || { why="uncommitted tracked changes (git status --porcelain): the bundle carries commits only"; return 1; }
	fi
