	"$scp_" -q "${sshopt[@]}" "$bundle" "$host:$rdir/repo.bundle" >/dev/null 2>&1 & sp=$!; wait "$sp"; local s=$?; sp=; rm -f "$bundle"; bundle=
	[ $s = 0 ] || { why="scp of the bundle failed (rc $s)"; return 1; }
	if [ -n "$adt_on" ]; then   # outside the job dir: survives the job cleanup, copied only when the remote sha256 differs; never in the bundle, git or an image
		local lh rh
