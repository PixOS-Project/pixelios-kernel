		rh=$(sshc bash -s <<<'f=$RJW/adt/d22ap.adt; [ -f "$f" ] && sha256sum <"$f" | cut -d" " -f1; exit 0' 2>/dev/null | tail -1)
		if [ "$rh" != "$lh" ]; then
			echo "remote-job: shipping the ADT to offload-host:$rwork/adt (sha256 $lh; remote ${rh:-none})"
			sshc bash -s <<<'mkdir -p "$RJW/adt"' >/dev/null 2>&1 || { why="ssh mkdir adt failed"; return 1; }
			"$scp_" -q "${sshopt[@]}" "$adt_f" "$host:$rwork/adt/d22ap.adt.new.$$" >/dev/null 2>&1 || { why="scp of the ADT failed"; return 1; }
			sshc bash -s <<<"cd \"\$RJW/adt\" && [ ! -L d22ap.adt.new.$$ ] && mv -f d22ap.adt.new.$$ d22ap.adt" >/dev/null 2>&1 || { why="ssh mv adt failed"; return 1; }
		fi
	fi
	if [ -n "$sup_on" ]; then   # outside the job dir like the ADT; two small stdlib tools, always re-copied (their text is the test input), mounted read-only at /super-tools
		local st
		sshc bash -s <<<'mkdir -p "$RJW/super-tools"' >/dev/null 2>&1 || { why="ssh mkdir super-tools failed"; return 1; }
		for st in wake triage-settle-guard; do
			"$scp_" -q "${sshopt[@]}" "$sup_d/$st" "$host:$rwork/super-tools/$st.new.$$" >/dev/null 2>&1 || { why="scp of super tool $st failed"; return 1; }
			sshc bash -s <<<"cd \"\$RJW/super-tools\" && [ ! -L $st.new.$$ ] && mv -f $st.new.$$ $st" >/dev/null 2>&1 || { why="ssh mv super tool $st failed"; return 1; }
		done
		echo "remote-job: shipped super tools (wake, triage-settle-guard) to the remote host work dir $rwork/super-tools"
	fi
	if [ -n "$golden_ts" ]; then   # outside the job dir; only the two traces, copied only when the remote sha256 differs
		local gp gn gh grh
		sshc bash -s <<<"mkdir -p \"\$RJW/golden/$golden_ts\"" >/dev/null 2>&1 || { why="ssh mkdir golden failed"; return 1; }
		for gp in $golden_sha; do
			gn=${gp%%:*}; gh=${gp#*:}
			grh=$(sshc bash -s <<<"f=\$RJW/golden/$golden_ts/trace-$gn.txt; [ -f \"\$f\" ] && sha256sum <\"\$f\" | cut -d' ' -f1; exit 0" 2>/dev/null | tail -1)
			if [ "$grh" != "$gh" ]; then
				echo "remote-job: shipping golden trace-$gn.txt to offload-host:$rwork/golden/$golden_ts (sha256 $gh; remote ${grh:-none})"
				"$scp_" -q "${sshopt[@]}" "$g_dir/trace-$gn.txt" "$host:$rwork/golden/$golden_ts/trace-$gn.txt.new.$$" >/dev/null 2>&1 || { why="scp of golden $gn failed"; return 1; }
				sshc bash -s <<<"cd \"\$RJW/golden/$golden_ts\" && [ ! -L trace-$gn.txt.new.$$ ] && mv -f trace-$gn.txt.new.$$ trace-$gn.txt" >/dev/null 2>&1 || { why="ssh mv golden $gn failed"; return 1; }
			fi
		done
	fi
	# one ssh: clone, then run; any nonzero ssh rc (255 = connection) is infra, because the runner itself exits 0 whatever the job did
	{ printf 'set -e; cd "%s"; echo $$ >pid; exec 9>"$RJW/jobs/.%s.lock"\nflock -n 9 || { echo "REMOTE: job %s already running on offload-host (lock)"; exit 99; }\nexec 8>>"$RJW/jobs/.heavy.lock"; flock -n 8 || echo "REMOTE: offload-host heavy lock held by: $(cat "$RJW/jobs/.heavy.lock" 2>/dev/null); waiting up to %s s"\nflock -w %s 8 || { echo "REMOTE: offload-host heavy lock held (waited %s s)"; exit 97; }\necho "%s $$" >"$RJW/jobs/.heavy.lock"\n' "$rdir" "$job" "$job" "$hw" "$hw" "$hw" "$job"
	  if [ "$kind" = gpu ]; then   # update the ci-local GPU clone to the requested commit
		printf 'g=$RJW/ci-local/gpuci; nd=$(git -C "$g" status --porcelain | wc -l); [ "$nd" = 0 ] || echo "REMOTE: gpuci clone was dirty ($nd entries), resetting to the commit"; git -C "$g" reset -q --hard; git -C "$g" clean -fdxq; git -C "$g" for-each-ref --format="%%(refname)" refs/rj-bundle | xargs -r -n1 git -C "$g" update-ref -d; git -C "$g" fetch -q "$PWD/repo.bundle" "+refs/*:refs/rj-bundle/*"; git -C "$g" checkout -q --detach %q\n' "$gsha"
	  else   # every ref mirrored (validate-repo reads the other branches and the reservation refs); tools/third_party linked in ONLY when the commit does not carry it (T-93e6 vendored it: `ln -s` onto the tracked dir made untracked tools/third_party/third_party = +dirty and a wrong identity hash; T-78bc)
		printf 'git init -q src; git -C src symbolic-ref HEAD refs/heads/rj-none; git -C src fetch -q ../repo.bundle "+refs/*:refs/*"; git -C src checkout -q --detach %q\n' "$sha"
		printf 'tp=$RJW/gate-k/tools/third_party; [ -d "$tp" ] && [ ! -e src/tools/third_party ] && ln -s "$tp" src/tools/third_party\ncd src\n'
	  fi
	  echo 'set +e'
	  runner "$rdir" 1; echo 'exit 0'; } | sshc setsid -w bash -s >"$ldir/ssh.out" 2>&1 &
	sp=$!; wait "$sp"; s=$?; sp=   # background + wait: a trapped signal interrupts `wait`, not a foreground child
	grep -h '^REMOTE:' "$ldir/ssh.out"
	[ $s != 97 ] || { lockref=1; why="offload-host heavy lock not free within ${hw}s"; return 1; }
	[ $s != 99 ] || { lockref=1; why="job already running on offload-host (lock)"; return 1; }
	[ $s = 0 ] || { why="ssh run failed (rc $s): $(grep -h REMOTE: "$ldir/ssh.out" | tail -1)"; return 1; }
	"$scp_" -q -r "${sshopt[@]}" "$host:$rdir/job.log" "$host:$rdir/job.rc" "$host:$rdir/prov" "$host:$rdir/out" "$ldir/" >/dev/null 2>&1 || { why="copy-back failed"; return 1; }
	return 0
}

run_local() { runner "$ldir" 0 | (cd "$root" && bash -s); }

ran=
if [ "$where" != local ]; then
	if [ "$where" = auto ]; then
		reason=$(timeout 5 bash -c "$(declare -p ssh_ host maxload minfree tooldir rwork hl ouse OFFLOAD_USES; declare -f sshc probe hl_ssh hl_scp offload_off_reason); probe" 2>&1) && usable=1 || usable=0
		if [ $usable = 0 ]; then fallback=${reason:-probe timed out}; fi
	else reason=$(timeout 5 bash -c "$(declare -p ssh_ host maxload minfree tooldir rwork hl ouse OFFLOAD_USES; declare -f sshc probe hl_ssh hl_scp offload_off_reason); probe" 2>&1) && usable=1 || { usable=0; fallback=${reason:-probe timed out}; }; fi   # --where offload-host: disk/presence check only (maxload lifted, queue admission decides load)
	[ -z "$collect" ] || [ "${usable:-0}" = 1 ] || die "offload-host unreachable: cannot collect, nothing submitted (${fallback:-probe failed})"
