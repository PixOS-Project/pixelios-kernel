rc=$(cat "$ldir/job.rc" 2>/dev/null); [[ $rc =~ ^[0-9]+$ ]] || die "no job rc ($ran run)"
prov=$(cat "$ldir/prov" 2>/dev/null); gccv=$(sed -n 's/.* gcc=\([^ ]*\) .*/\1/p' <<<"$prov")
rn=offload-host; [ "$hl" = 0 ] || rn=lab-host; ranlab=$ran; [ "$ran" != offload-host ] || ranlab=$rn   # label host name (lab-host lane); offload-host strings unchanged
if [ "$ran" = offload-host ] && [ -n "$note" ]; then label="$rn gcc$gccv ${note//offload-host/$rn}"
elif [ "$ran" = offload-host ]; then label="$rn gcc$gccv (pre-validation)"; else label="local gcc$gccv${fallback:+ (fallback: $fallback)}"; fi
el=$(( $(date +%s) - t0 ))
mkdir -p "$ldir/out"; vnote=; missing=
if { [ "$job" = gate-pre ] || [ "$job" = gate-identity ]; } && [ "$ran" = offload-host ]; then
	# identity: formal only when the container's own tools/gate-identity output equals the committed expectation AND the remote checkout is this HEAD
	idf=$ldir/out/identity.txt; exp=$(cat "$tooldir/tools/gate-identity.expected" 2>/dev/null); idnote=   # the TOOL repo's pin, never the commit under test's
	if [ ! -s "$idf" ]; then idnote="identity MISSING"
	elif [ -z "$exp" ] || grep -q TODO <<<"$exp"; then idnote="identity MISMATCH (tool-side tools/gate-identity.expected missing or has TODO fields)"
	elif [ "$(grep -c '^adt=' "$idf")" != 1 ] || [ "$(tail -n 1 "$idf" | grep -c '^adt=')" != 1 ]; then idnote="identity MISMATCH (no single trailing adt= line: the container did not record the ADT state)"
	elif ! diff -u <(echo "$exp") <(grep -v '^adt=' "$idf") >"$ldir/identity.diff"; then idnote="identity MISMATCH (see $ldir/identity.diff)"
	elif ! printf '%s\n%s\n' "$sha" "$(git ls-tree -r HEAD tools | sha256sum)" | diff -q - "$ldir/out/commit.txt" >/dev/null 2>&1; then idnote="identity MISMATCH (remote checkout is not this HEAD/tools tree)"
	fi
	if [ -n "$idnote" ]; then label="$rn gcc$gccv pre-validation ($rn container, $idnote, NOT formal)"
	else label="$rn gcc$gccv formal ($rn container, identity sha256:$(sha256sum <"$idf" | cut -d' ' -f1), image $(sed -n 's/^image=//p' "$idf" | head -1))"; fi
	if [ "$job" = gate-identity ]; then   # no gate ran: show what gate-pre would be labelled, never call this run formal
