# TP-042 OFFLOAD-HOST QUEUE: every route that may reach offload-host takes the machine-wide FIFO slot first (tools/heavy-job offload-host run: FIFO + admission on
# offload-host load/memory/rj- containers/foreign heavy processes). The child sees OFFLOAD_QUEUE_HELD and goes on. --where local never queues; --collect and
# --kill-orphan take no CPU and must work while the slot is busy or refused (r2 F1: the orphan they kill is what makes admission refuse), so they never queue.
# --where auto: this probe decision is FINAL (r2 F2): "offload-host unavailable" here means where=local, the later probe can never route to offload-host unqueued.
[ "$where" != offload-host ] || maxload=1000000   # the queue admission replaces the load threshold on offload-host routes; the disk/presence check stays
if [ "$where" != local ] && [ "$hl" = 0 ] && [ -z "${OFFLOAD_QUEUE_HELD:-}" ] && [ -z "$collect" ] && [ "$killorph" = 0 ]; then
	qgo=1
	if [ "$where" = auto ]; then
		qreason=$(timeout 5 bash -c "$(declare -p ssh_ host maxload minfree tooldir rwork hl ouse OFFLOAD_USES; declare -f sshc probe hl_ssh hl_scp offload_off_reason); probe" 2>&1) || { qgo=0; where=local; fallback=${qreason:-probe timed out}; echo "REMOTE: offload-host unavailable ($fallback), running local (decided before the queue)"; }
	fi
	[ "$where" != auto ] || export HEAVY_JOB_FALLBACK_LOCAL=1   # T-4ecb: same as --fallback-local (kept off the exec line below)
	[ $qgo = 0 ] || HEAVY_JOB_QUIET=1 exec "$tooldir/tools/heavy-job" offload-host run --owner "${REMOTE_JOB_OWNER:-${USER:-unknown}}" --label "rj-$job" --use "$ouse" -- "$tooldir/tools/remote-job" "${origargs[@]}"
fi
# LAB-HOST LOCK (TP-050): the job holds the SAME lock a driver's local check-all holds, by running under tools/heavy-job (class gate: one lock file, the load/PSI/memory
# gate, a log under logs/heavy-job/). Chosen over opening the lock file here because heavy-job's lock file name, holder line, nesting rule and gate are then one definition.
# No offload-host queue slot: the offload-host FIFO is for offload-host. --collect / --kill-orphan take no CPU and never wait for the lock.
# Admission (review lab-host-lane-r1 F2): ONE memory check, heavy-job's class-gate default (need 4 + reserve 8 GB, MemAvailable + ZFS ARC freeable),
# the same rule a local check-all meets; no own floor here (the old mem-gb 12 + reserve 8 = 20 GB double count). Never throttles GATE_JOBS/GATE_MUT_JOBS.
# RJ_LAB_HELD is trusted only when the lock really is held for this label by an ancestor of this process (F1: setting it by hand skips nothing).
hlab=rj-$job-lab-host
hl_lock_ok() {
	local lf=${HEAVY_JOB_LOCK:-$HOME/.cache/pixelios/heavy-job.lock} l c p q hb=${HEAVY_JOB_HELD:-}
	# hb = the label heavy-job exported: rj-JOB-lab-host, or an OUTER heavy-job label when the lane runs nested in one (review lab-host-lane-r2: nesting)
	[ -n "$hb" ] || { echo "HEAVY_JOB_HELD is empty"; return 1; }
	read -r l c p _ <"$lf" 2>/dev/null || { echo "no holder line in $lf"; return 1; }
	{ [ "$l" = "$hb" ] && [[ $p =~ ^[0-9]+$ ]]; } || { echo "holder of $lf is '$l $c $p', not HEAVY_JOB_HELD=$hb"; return 1; }
	command -v flock >/dev/null || { echo "flock missing, cannot prove the lock"; return 1; }   # r2: fail closed
	[ -r "$lf" ] || { echo "$lf unreadable"; return 1; }
	if flock -n "$lf" true; then echo "$lf is not locked"; return 1; fi
	q=$$
	while [[ $q =~ ^[0-9]+$ ]] && [ "$q" -gt 1 ]; do [ "$q" = "$p" ] && return 0; q=$(ps -o ppid= -p "$q" 2>/dev/null | tr -d ' '); done
	echo "holder pid $p is not an ancestor of $$"; return 1
}
if [ "$hl" = 1 ] && [ -z "$collect" ] && [ "$killorph" = 0 ]; then
	if [ -z "${RJ_LAB_HELD:-}" ]; then
