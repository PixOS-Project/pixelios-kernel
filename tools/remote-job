#!/bin/bash
# remote-job: run one named host-only job (a job table, defined once below) on the second build host or on this host.
#   tools/remote-job [--where auto|local|offload-host|lab-host] [--timeout S] [--keep] [--collect DIR] [--kill-orphan] JOB (--collect DIR only collects and exits, never submits; --kill-orphan WITHOUT --collect kills the orphan and then goes on to submit JOB)     [--commit GPUSHA] (jobs: wlan-mutants mutants-proof unit gate-pre gate-identity ci-local selftest selftest-fail)
# DESIGN RULE (user): the remote host (offload-host) is never a dependency, it is pluggable. `auto` (default) probes it in <=5 s (ssh BatchMode,
# ConnectTimeout=3; load <= 12; >= OFFLOAD_MIN_FREE_GB (20) free in $OFFLOAD_ROOT/work; $OFFLOAD_ROOT/work present). If unavailable it prints
#   REMOTE: offload-host unavailable (<reason>), running local
# (rule 8: loud) and runs the SAME job table entry on this host. Fallback to local happens ONLY when the remote died for infra reasons
# (probe failed, ssh rc 255, scp failure, connection drop mid-run). A job that ran and FAILed is never re-run elsewhere (no fallback-shopping).
# A drop AFTER the job started (T-4ecb) prints exactly one gap line (fell back to local, lost mid-job (<why>)) and adds `gaps=1` to the RESULT line; `--where auto` also passes
# `--fallback-local` to the heavy-job offload slot, which does the same (`gaps=1`) when the host is lost between the caller's probe and the admission. Test: tools/test_offload_fallback.sh.
# USES (per-use switches): every job has an offload use (build gate test sync ci, tools/offload-conf.sh): unit/gate-pre/gate-identity = gate, ci-local = ci, the rest = test. The web board's master row or the row of
#   THAT use makes the probe fail with `OFFLOAD OFF: use=<use> ...`; `--where auto` then runs local (one REMOTE: line), an offload-only job refuses (no fallback). A job already on the host is never touched.
# Remote: committed HEAD travels as a git bundle (dirty tracked files are refused), cloned into $OFFLOAD_ROOT/work/jobs/NAME/src, run under
# `nice -n 19 ionice -c3 timeout`, job.log/job.rc/prov/out/ copied back to logs/remote-jobs/NAME/, remote job dir removed (unless --keep).
# The remote shell is fish: every remote command is `bash -s` with the script on stdin. Nothing outside $OFFLOAD_ROOT/work is touched there.
# Refuses any phone word (adb fastboot xrun phone probe-run ...) anywhere in the arguments and in REMOTE_JOB_HOST/SSH/SCP. Gates never call this tool.
# Env: REMOTE_JOB_HOST (default OFFLOAD_HOST from tools/offload-host.conf; none = no offload host, runs local), REMOTE_JOB_SSH / REMOTE_JOB_SCP (default ssh / scp; the host test fakes them),
#      REMOTE_JOB_MAXLOAD (12), REMOTE_JOB_MINFREE_GIB (5), REMOTE_JOB_GPU_REPO (local GPU repo clone, ci-local only).
# gate-pre ALWAYS runs through the pinned container prefix built below (nice docker run --network=none ... pixos-gate:trixie-20261111, [obs] brief; recipe: tools/gate-image/; staged read-only test inputs + ping sysctl: tools/remote-job-inputs.sh, R13);
#      REMOTE_JOB_GATE_PREFIX replaces it for the host test only. `formal` is earned ONLY when tools/gate-identity run inside the prefix produced
#      out/identity.txt equal to the TOOL repo's tools/gate-identity.expected (never the commit under test's; the identity script is shipped from the tool repo too, REMOTE_JOB_REPO selects the commit under test) AND out/commit.txt matches the local HEAD; else `identity MISSING|MISMATCH, NOT formal`.
#      REMOTE_JOB_IDENTITY_PROOF is gone (an env string could earn the word).
#      ADT: when REPO/research/ipsw-x/d22ap.adt exists locally, gate-pre/gate-identity ship it to offload-host:$OFFLOAD_ROOT/work/adt/d22ap.adt (only when the remote sha256 differs; never in the bundle/git/image) and the
#      container mounts it READ-ONLY at /job/research/ipsw-x/d22ap.adt (/job = the checkout; mkadt.py:46). Inside the container tmp/rj-adt appends ONE trailing `adt=<sha256>|none` line to identity.txt
#      Golden traces (never in git/bundle/image, rule 4): the TS comes from GOLDEN= in the commit's tools/test_golden_gpu_analyze.py; when ~/pixelios-artifacts/golden/TS/{trace-gpu,trace-dpu}.txt exist locally and match that dir's SHA256SUMS they are shipped to offload-host:$OFFLOAD_ROOT/work/golden/TS (only when the sha256 differs) and mounted READ-ONLY at the same path under the in-container home; absent = loud REMOTE: line, no mount; a SHA256SUMS mismatch refuses the job (exit 2).
#      (hashed with it in the label; the pin compare ignores that line; gate-identity itself is unchanged). Absent locally: no mount, adt=none. tools/gate-import-remote accepts an a=1 tree only on a matching adt=.
# Jobs (offload-only = `--where local` is refused with a REMOTE: line and there is never a lab-host fallback):
#   unit        offload-only. tools/gate-unit-shards (GATE_UNIT_SHARDS=3; check-all.sh has no way to run just the unit step); logs in out/unit-shards/.
#   gate-pre    offload-only. tools/check-all.sh in the job dir: GATE_HOST_LOCK=0 + HEAVY_JOB_HELD=offload-gate-pre (F4), GATE_PASS_DIR under the job dir, GATE_MUT_CACHE=/mut-cache/<image id 12> = the PERSISTENT offload-host $OFFLOAD_ROOT/work/mut-cache-root/<image id 12> (TP-048, root mode 0700 mounted -v rw,Z at /mut-cache; one cache per gate image; survives jobs, keyed by content, spot-checked, quarantined to <id>.bad-<epoch> on a mismatch) (TMPDIR is the container's /tmp, NEVER inside the checkout, rj-check refuses a git work tree: AP-110), GATE_UNIT_SHARDS=3, GATE_MUT_VERDICTS (optional output: ABSENT is
#               printed when the commit has no GATE_MUT_VERDICTS support), fake adb/fastboot (exit 127) first on PATH; GATE_STEP_TIMEOUT is NOT set
#               (it overrides EVERY step budget incl. the 300 s ones [src check-all.sh:89]; the per-step defaults are kept). Before the gate starts, a check INSIDE the container
#               (tmp/rj-check, written into the job dir) must prove: `type -aP adb fastboot` (bash has no command -v -a) resolves only to the job stub dir; /usr/bin /usr/local/bin /bin /sbin /usr/sbin
#               hold no adb/fastboot/heimdall; /dev/bus/usb and /dev/ttyUSB* are absent; and the docker run line has no --device/--privileged/-v /dev. Any failure = job rc 93 =
#               remote-job exit 2 with a REMOTE: line. The old repo scan for absolute adb/fastboot paths is GONE on purpose: it was a heuristic that refused harmless
#               tests (tools/test_phone_guard.py); the control is now the environment (container has no phone tools, no USB devices, --network=none), not the text of the scripts.
#               Fetches out/gate.log, identity.txt, commit.txt, verdicts.json. RESULT says `pre-validation (offload-host, NOT the gate)`; nothing is written to the lab-host
#               gate stamp / gate-pass registry (the pass dir lives and dies in the remote job dir and is never copied back).
#               RESULT tail `mutcache=HITS/FRESH/STATE warn=N` comes from the MUTCACHE line of out/gate-full.log; a missing line, STATE not ok, store_failed>0 or a spot-check MISMATCH
#               prints `REMOTE: MUTCACHE ...` and counts in warn= (rule 8; no fallback to a per-job cache). `formal` provenance does not depend on the cache (gate-identity unchanged). warn= is ADVISORY (driver 20l, review offload-mutcache-r1 F4): tools/gate-import-remote imports a PASS with warn>0, because a cache fault only costs time and a spot-check MISMATCH already fails the gate (test_wlan_wr_mutants.py assertEqual on run_all.mismatch).
#               wlan-mutants / mutants-proof run on the offload-host host itself (no container) with the default cache dir (~/.cache/pixelios/wlan-mutants), which is already persistent; unit does not run the mutants.
#   test-run    offload-only. `test-run -- CMD...` (heavy-job --light routing, tools/heavy-job-offload.sh): CMD in the pinned gate image on the committed HEAD, --network=none, adb/fastboot stubs, only the checkout writable; job.log = CMD's output, job rc = CMD's rc.
#   ci-local    offload-only. Input is a GPU-repo commit (--commit SHA, repo = $REMOTE_JOB_GPU_REPO), shipped as a bundle, checked out in
#               $OFFLOAD_ROOT/work/ci-local/gpuci, then tools/ci-local --stage all; $OFFLOAD_ROOT/work/ci-local/artifacts/runs/<head12>-* copied to out/.
# The bundle carries every ref (HEAD --branches --remotes refs/patch-numbers/*) so validate-repo sees the numbering state; tools/third_party is symlinked
# from $OFFLOAD_ROOT/work/gate-k/tools/third_party. Each run has its own remote dir (jobs/NAME.<time>.<pid>) and a flock jobs/.NAME.lock (second run refuses).
# TP-042 resubmit check (offload-host runs): before submitting JOB, $OFFLOAD_ROOT/work/jobs/JOB.<time>.<pid> dirs still on offload-host (no `keep` marker) and docker containers
#      rj-JOB.* are listed (dir, job.rc, age, container; also `mut-cache-root/*.bad-*` quarantine dirs with age + size, listing only, never deleted); any = `RESULT: ERROR resubmit JOB has uncollected result|orphan ...` exit 2. `--collect DIR` COLLECTS ONLY AND EXITS (never submits; AP-194) - it copies
#      job.log/job.rc/prov/out to logs/remote-jobs/JOB/DIR/ and removes the remote dir (refused while its runner or container is alive); `--kill-orphan` kills
#      ONLY a container / process group of a JOB dir whose runner pid is dead (never another job; the dir stays, collect it). `--keep` writes the `keep` marker.
#      Every run also holds a machine-wide flock jobs/.heavy.lock on offload-host (bounded wait REMOTE_JOB_HEAVY_WAIT, default 1800 s) besides the per-name flock.
# LAB-HOST LANE (TP-050, R12): `--where lab-host` runs gate-pre (ONLY gate-pre among the offload-only jobs; the others refuse with a REMOTE: line) on THIS host as if it were the
#      remote: same bundle/run_remote/collect/cleanup code and the same $OFFLOAD_ROOT/work/jobs layout and flocks, with ssh/scp replaced by tools/rj-local-transport (no sshd on lab-host).
#      Container runtime = /usr/bin/podman only (rootless proved by `podman info`, else job rc 95); lab-host's rootful docker is never used (REMOTE_JOB_LAB_PODMAN replaces the path
#      for the host test only, loud WARNING, basename must stay podman). The job holds tools/heavy-job (class gate, the same lock as a driver's local check-all) around the whole run
#      (re-exec, RJ_LAB_HELD stops a loop); no offload-host queue. Admission = heavy-job's class-gate memory gate only (4 + 8 GB reserve, MemAvailable + ZFS ARC freeable; review r1 F2) (never throttles
#      GATE_JOBS/GATE_MUT_JOBS). RESULT says where=lab-host and provenance=lab-host ... formal (lab-host container, ...); tools/gate-import-remote accepts exactly the two matching shapes.
# XNU BUILD IN THE OFFLOAD-HOST SLOT (W35 R22 "lane jam", 20w): the offload-host route of gate-pre compiles HEAD's xnu/patches INSIDE the held offload-host slot (job script, after the container
#      identity/ADT checks, before the gate), in the pinned image pixos-xnub:trixie-20261111 (tools/gate-image/Dockerfile.xnub) with the toolchain staged in $OFFLOAD_ROOT/work/xnub-art mounted at
#      the in-container home pixelios-artifacts (the lab-host path, so absolute paths in the built deps stay valid), --network=none, fixed work-tree label offload-gate (warm ~63 s, cold 7-11 min). The offload-host
#      route therefore NEVER takes the lab-host heavy-job lock (the old local pre-step waited on it behind 6+ jobs while offload-host idled; AP-257 text is the driver's). Afterwards every other work tree
#      under xnub-art/localbuild/work is pruned (offload-host disk is small) with one `XNUB: pruned N work tree(s): ...` line. Failure = job rc 98 (`gate-pre: XNU stack did not build in the offload-host slot`),
#      gate not run; missing image / toolchain dirs / $XA/git-mirror (the pinned stager sources, checked INSIDE the build container with the commit's tools/xnu-src-mirror env: same image/uid/git as the build; the build is offline) = rc 95 naming tools/offload-stage-xnub
#      (run as `tools/heavy-job offload-host run --owner NAME --label xnub-stage -- tools/offload-stage-xnub`); a commit without tools/gate-xnu-build or tools/xnu-src-mirror, or whose stagers xnu-src-mirror cannot parse (RESULT: ERROR) = rc 98 naming the cause. The run line is
#      tools/xnub-line.sh (its TEXT is passed as RJ_XNUB and shared with `tools/offload-stage-xnub --validate`). The XNUB: lines (image id, build RESULT, prune count) reach the console as `REMOTE: XNUB: ...`
#      and the image id is `xnub=<id12>` on the RESULT line. An `rj-xnub-<job dir>` container counts as the job's container for --kill-orphan / --collect.
#      REMOTE_JOB_XNUB_PREFIX replaces the whole docker prefix for the host test only. The `--where lab-host` lane keeps the LOCAL xnu pre-step (tools/gate-xnu-build on this host, BEFORE the lane's own lock: xnu-local-build then takes its own class-build heavy-job lock, so that lane waits on the local lock twice in a row, build then gate; review offload-xnub-r1 F10, left as is).
# Last line: RESULT: PASS|FAIL remote-job ... provenance=... Exit 0 = job passed, 1 = job failed, 2 = infra / usage / refused.
# T-7dff:help: -h/--help prints this header and exits 0 before anything runs
case "${1:-}" in -h|--help) printf 'usage: %s\n' "${0##*/}"; sed -n '2,/^[^#]/{/^#/s/^# \{0,1\}//p}' "$0"; exit 0;; esac
set -uo pipefail
tooldir=$(cd "$(dirname "$0")/.." && pwd) || exit 2   # the repo that contains THIS tool: the only source of the identity script and its pin
# REMOTE_JOB_REPO (default: tooldir): the repo whose HEAD is the commit under test, so a trunk tool can label a commit that predates tools/gate-identity
cd "${REMOTE_JOB_REPO:-$tooldir}" || exit 2
root=$PWD
die() { echo "RESULT: ERROR remote-job${job:+ $job}: $*"; exit 2; }   # exit 2 = infra/usage/refused: ERROR, never FAIL (TP-042 review F2)

# ---- the job table: name | command (bash, run in the repo root, $OUTD = output dir) | inputs (paths that must be committed for a remote run) | outputs (files expected in $OUTD)
J='J=$(nproc); [ "$J" -gt 12 ] && J=12; export GATE_MUT_JOBS=$J; t="python3 -m unittest discover -s tools -p test_wlan_wr_mutants.py"'
job_def() {
	outs=; opt=; inputs=; offload_only=0; kind=kernel; deftmo=; note=; ouse="test"   # ouse = the offload USE of the job (tools/offload-conf.sh OFFLOAD_USES): the web board's per-use switch
	case $1 in
		wlan-mutants) cmd="$J; \$t"; inputs="tools xnu shim soc device" ;;   # the test reads xnu/patches and builds shim: uncommitted edits there must be refused remotely
		mutants-proof)    # PLAN-FAST-GATE steps 5-6: cold run A (cold only if the verdict cache is empty), warm run B, verdict dumps must be equal
			cmd="$J; GATE_MUT_VERDICTS=\"\$OUTD/A.json\" \$t || exit 1; GATE_MUT_VERDICTS=\"\$OUTD/B.json\" \$t || exit 1; python3 -c 'import json,sys; a,b=(json.load(open(p)) for p in sys.argv[1:3]); sys.exit(0 if a==b else 1)' \"\$OUTD/A.json\" \"\$OUTD/B.json\" && echo 'MUTPROOF A==B'"
			inputs="tools xnu shim soc device"; outs="A.json B.json" ;;
		unit) offload_only=1; ouse=gate; inputs="tools xnu shim soc device"
			cmd='export TMPDIR="$WD/tmp"; mkdir -p "$TMPDIR"; GATE_UNIT_SHARDS=3 GATE_UNIT_OUT="$OUTD/unit-shards" tools/gate-unit-shards' ;;
		gate-pre) offload_only=1; ouse=gate; inputs="tools xnu shim soc device"; outs="gate.log gate-full.log"; opt="verdicts.json"; deftmo=21600; note="pre-validation (offload-host container, NOT formal)"
			cmd='[ -e tools/third_party ] || { echo "gate-pre: tools/third_party missing on offload-host"; exit 98; }
J=$PWD; mkdir -p stubs tmp rj-out
ex=$(git rev-parse --git-path info/exclude); mkdir -p "$(dirname "$ex")"   # job scaffolding only, in the checkout-local exclude (never the commit'"'"'s .gitignore), so check-all.sh sees a clean tree and can stamp GATE PASS <sha> without +dirty
printf "%s\n" /stubs/ /tmp/ /rj-out/ /gate-pass/ /mut-cache/ /tools/rj-fakeroot/ >>"$ex"
for t in adb fastboot; do printf "#!/bin/sh\necho \"STUB %s: phone commands are refused in gate-pre\" >&2\nexit 127\n" "$t" >"stubs/$t"; chmod +x "stubs/$t"; done
M=/job; [ -z "${RJ_GATE_PREFIX:-}" ] || M=$J
# TP-048: the mutant verdict cache is PERSISTENT across gate-pres (content-keyed + spot-checked + quarantined by tools/wlan_mutant_cache.py): the ROOT $OFFLOAD_ROOT/work/mut-cache-root on offload-host, mode 0700, is mounted at /mut-cache
# and the cache itself is the SUBDIR /mut-cache/<gate image id, 12 hex> (review offload-mutcache-r1 F1: quarantine() renames the cache dir, and a rename of a bind-mount point fails with EBUSY [obs unshare -rm];
# F2: one cache per gate image, a rebuilt image with the same gcc banner starts empty). Quarantine = /mut-cache/<id>.bad-<epoch> on the same mount.
# Host test (RJ_GATE_PREFIX): jobs/mut-cache-root next to the job dirs, never inside the checkout (AP-110). No fallback to a per-job dir: a broken cache must show in the MUTCACHE line (rule 8).
MC=$RJW/mut-cache-root; GMC=/mut-cache; [ -z "${RJ_GATE_PREFIX:-}" ] || MC=$J/../../mut-cache-root
mkdir -p -m 0700 "$MC" || { echo "gate-pre: cannot create the persistent mutant cache root $MC"; exit 94; }
[ -z "${RJ_GATE_PREFIX:-}" ] || GMC=$(cd "$MC" && pwd)
# HEAVY_JOB_HELD: the container (no shared HOME, an ephemeral ~/.cache) must count as "already inside heavy-job": the offload-host .heavy.lock + the queue slot taken on this side ARE the lock (TP-042 review F4)
# GATE_JOBS=8 GATE_MUT_JOBS=12: the measured formal-gate sizing (dedicated box, nice 19); GATE_CPU_BUDGET would halve lane C and risk its 5400 s step cap (review gate-cpu-budget-r1 F2)
export HEAVY_JOB_HELD=offload-gate-pre GATE_HOST_LOCK=0 GATE_XNU_BUILD=0 GATE_PASS_DIR="$M/gate-pass" GATE_UNIT_SHARDS=3 GATE_JOBS=8 GATE_MUT_JOBS=12 GATE_MUT_VERDICTS="$M/rj-out/verdicts.json"
pf=()
if [ -n "${RJ_GATE_PREFIX:-}" ]; then   # host test only: set -f so the words are never globbed
	set -f; read -ra pf <<<"$RJ_GATE_PREFIX"; set +f; export PATH="$M/stubs:$PATH" GATE_IMAGE_ID=test-prefix GATE_MUT_CACHE="$GMC/test-prefix"; mkdir -p -m 0700 "$GMC/test-prefix"
	mkdir -p "$J/../tmp"; export TMPDIR; TMPDIR=$(cd "$J/../tmp" && pwd)   # sibling of the checkout, never inside its work tree (AP-110)
	FR=$J/tools/rj-fakeroot; mkdir -p "$FR/usr/bin" "$FR/dev"; ln -sf "$(type -P git)" "$FR/usr/bin/git"; CHK=(stubs "$FR/usr/bin" "$FR" "$FR/usr/bin")   # host test: fake root instead of the container fs
else
	IMG=pixos-gate:trixie-20261111;   # recipe (Dockerfile, hash-pinned requirements, verlist.sh): tools/gate-image/; the build context lives in $RJW/gate-image-20261111
	DK=${RJ_DK:-$HOME/.local/bin/docker}
		if [ -n "${RJ_DK:-}" ]; then [ "$("$DK" info --format "{{.Host.Security.Rootless}}" 2>/dev/null)" = true ] || { echo "gate-pre: $DK is not rootless podman (Host.Security.Rootless != true); lab-host never runs a rootful runtime"; exit 95; }; fi
	GATE_IMAGE_ID=$("$DK" image inspect --format "{{.Id}}" "$IMG") || { echo "gate-pre: image $IMG not found on offload-host"; exit 95; }
	export GATE_IMAGE_ID GATE_VERLIST=/gate-image/verlist.sh
	MCID=${GATE_IMAGE_ID#sha256:}; MCID=${MCID:0:12}; [[ $MCID =~ ^[0-9a-z]+$ ]] || { echo "gate-pre: gate image id $GATE_IMAGE_ID gives no [0-9a-z] cache subdir name"; exit 95; }
	export GATE_MUT_CACHE="$GMC/$MCID"; mkdir -p -m 0700 "$MC/$MCID" || { echo "gate-pre: cannot create the mutant cache $MC/$MCID"; exit 94; }; mkdir -p "$J/tmp/art" || { echo "gate-pre: cannot create $J/tmp/art"; exit 94; }
	pf=(nice -n 19 "$DK" run --rm --name "rj-${WD##*/}" --network=none --userns=keep-id --user 1000:1000 -e HOME=/home/user --sysctl "net.ipv4.ping_group_range=1000 1000")   # R13: ICMP datagram sockets for gid 1000 (test_pixping Host), private netns so nothing leaves; "0 2147483647" is refused by rootless crun (IDs unmapped), "0 65535" gives EACCES (range checked on host-translated gids) [obs 2026-11-11]
	for v in $(compgen -e | grep "^GATE_[A-Z_]*$"); do pf+=(-e "$v"); done
	pf+=(-e HEAVY_JOB_HELD)
	am=()   # the Apple ADT (never in git/bundle/image): shipped by remote-job to $RJW/adt, mounted READ-ONLY at the path mkadt.py:46 reads (REPO/research/ipsw-x/d22ap.adt; the checkout is /job)
	if [ -n "${RJ_ADT:-}" ]; then
		A=$RJW/adt/d22ap.adt; [ -s "$A" ] || { echo "gate-pre: ADT $A missing on offload-host"; exit 96; }
		mkdir -p research/ipsw-x; : >research/ipsw-x/d22ap.adt   # mount point only (research/ is gitignored); created ONLY when mounting, an empty file would be a fake ADT
		am=(-v "$A:/job/research/ipsw-x/d22ap.adt:ro,Z")
	fi
	gm=()   # golden traces (never in git/bundle/image): shipped to $RJW/golden/TS, sha256 re-checked here against the host values, mounted READ-ONLY where the test expands ~/pixelios-artifacts/golden/TS
	if [ -n "${RJ_GOLDEN:-}" ]; then
		GD=$RJW/golden/$RJ_GOLDEN
		for gp in $RJ_GOLDEN_SHA; do
			gn=${gp%%:*}; gh=${gp#*:}; gf=$GD/trace-$gn.txt
			[ -f "$gf" ] && [ ! -L "$gf" ] || { echo "gate-pre: golden $gf missing on offload-host"; exit 96; }
			[ "$(sha256sum <"$gf" | cut -d" " -f1)" = "$gh" ] || { echo "gate-pre: golden $gf sha256 differs from the host value $gh"; exit 96; }
		done
		case $RJ_GOLDEN_SHA in gpu:*" dpu:"*) ;; *) echo "gate-pre: golden RJ_GOLDEN_SHA incomplete ($RJ_GOLDEN_SHA)"; exit 96 ;; esac
		mkdir -p "$J/tmp/art/golden/$RJ_GOLDEN" || { echo "gate-pre: cannot create the golden mount point $J/tmp/art/golden/$RJ_GOLDEN"; exit 94; }   # created HERE (owned by us): a mount point podman creates is a sub-uid dir the host cannot remove, so the finished job dir stayed as an orphan [obs offload-host f3x 2026-10-31]
		gm=(-v "$GD:/home/user/pixelios-artifacts/golden/$RJ_GOLDEN:ro,Z")
	fi
	sm=()   # super tools (T-78bc): shipped to $RJW/super-tools, mounted READ-ONLY; the three tools that look for the super repo take the paths from env
	if [ -n "${RJ_SUPER:-}" ]; then
		for st in wake triage-settle-guard; do [ -f "$RJW/super-tools/$st" ] && [ ! -L "$RJW/super-tools/$st" ] || { echo "gate-pre: super tool $RJW/super-tools/$st missing on the remote host"; exit 96; }; done
		sm=(-v "$RJW/super-tools:/super-tools:ro,Z" -e JOB_WAKE_TOOL=/super-tools/wake -e PHONE_LOCK_WAKE=/super-tools/wake -e AGENT_GUARD_TRIAGE_MOD=/super-tools/triage-settle-guard)
	fi
	pf+=("${sm[@]}")
	xm=()   # T-78bc: tools/stack-apply needs the pristine XNU clone and the pinned stager mirror, and the container has no network: mount the staged copies (the xnub staging tool) READ-ONLY below the container artifacts dir (the HOME the run line sets + /pixelios-artifacts); mount points created HERE like the golden one. Absent = loud WARN (stack-apply then prints "NOT RUN: no network" and the GATE line is not importable)
	ca=; for xe in "${pf[@]}"; do case $xe in HOME=*) ca=${xe#HOME=} ;; esac; done; ca=$ca/pixelios-artifacts
	for xd in xnu-pristine git-mirror; do
		if [ -d "$RJW/xnub-art/$xd" ]; then
			mkdir -p "$J/tmp/art/$xd" || { echo "gate-pre: cannot create the mount point $J/tmp/art/$xd"; exit 94; }
			xm+=(-v "$RJW/xnub-art/$xd:$ca/$xd:ro,Z")
		else echo "gate-pre: WARN $RJW/xnub-art/$xd missing on the remote host (run the xnub staging tool named by the rc 95 message): tools/stack-apply will be NOT RUN (no network) and the gate line will not import"; fi
	done
	pf+=("${xm[@]}"); [ -z "${RJ_INPUTS:-}" ] || { eval "$RJ_INPUTS"; rj_input_mounts; }   # R13: RJ_INPUTS = the TEXT of rj_input_mounts in tools/remote-job-inputs.sh (set by stage_inputs)
