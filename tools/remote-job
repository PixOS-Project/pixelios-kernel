	cat <<'RUN'
case $WD in /*) ;; *) WD=$HOME/$WD ;; esac; OUTD=$WD/out
export OUTD WD; mkdir -p "$OUTD"
nr=(nice -n 19); command -v ionice >/dev/null 2>&1 && nr+=(ionice -c3)
gccv=$(gcc -dumpversion 2>/dev/null | cut -d. -f1); glibc=$(getconf GNU_LIBC_VERSION 2>/dev/null | cut -d' ' -f2)
echo "host=$(hostname) gcc=${gccv:-none} glibc=${glibc:-unknown} nice=$("${nr[@]}" nice)" >"$WD/prov"
