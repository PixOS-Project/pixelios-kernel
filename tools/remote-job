[ -d "$d" ] || { echo "no work root $d on offload-host"; exit 3; }
echo "load=$(cut -d' ' -f1 "${REMOTE_LOADAVG:-/proc/loadavg}") free=$(df -Pk "$d" | awk 'NR==2{print int($4/1048576)}') mount=$(df -Pk "$d" | awk 'NR==2{print $6}')"
P
	) || { echo "ssh probe failed: ${out:0:80}"; return 1; }
