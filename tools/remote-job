common="$job where=$ranlab sha=$shalab$([ "$ran" = offload-host ] && echo "$shadirty")${gsha:+ gpu=${gsha:0:12}} elapsed=${el}s$mcn$xn $prov provenance=$label$vnote log=$ldir/job.log"
finish() { echo "$1" | tee "$ldir/out/RESULT"; }   # the RESULT line is also persisted for the stamp importer
if [ "$rc" != 0 ]; then
	tail -20 "$ldir/job.log"
	[ "$rc" != 93 ] || { echo "REMOTE: $job refused before the gate started (container check, rc 93)"; finish "RESULT: FAIL remote-job refused (container check) $common"; exit 2; }
	why="job rc $rc"; [ "$rc" = 124 ] && why="job timed out after $tmo s (rc 124)"
	finish "RESULT: FAIL remote-job $why $common"; exit 1
fi
[ -z "$missing" ] || { finish "RESULT: FAIL remote-job job ok but outputs missing:$missing $common"; exit 1; }
finish "RESULT: PASS remote-job $common"
