		if [ -n "$mcq" ]; then echo "REMOTE: MUTCACHE spot-check MISMATCH, the cache dir was quarantined: $rn:$rwork/mut-cache-root/${mcq##*/} (WARN)"
		else echo "REMOTE: MUTCACHE spot-check MISMATCH and the cache was NOT quarantined ($(grep -a -o 'MUTCACHE MISMATCH: quarantine failed.*' "$ldir/out/gate-full.log" | tail -n 1 | cut -c1-120)): delete $rn:$rwork/mut-cache-root/<image id> by hand before the next gate-pre (WARN)"; fi
	fi
	mcn=" mutcache=$mch/$mcf/$mcs warn=$mcw"
	mpk=$(head -n 1 "$ldir/out/memory.peak" 2>/dev/null)   # R12: container cgroup memory.peak in bytes (page cache included), read inside the container at gate end
	if [[ $mpk =~ ^[0-9]+$ ]]; then mcn="$mcn mempeak=${mpk}B"
	else mcn="$mcn mempeak=UNKNOWN"; echo "REMOTE: memory.peak not recorded (${mpk:-out/memory.peak missing}): no cgroup v2 memory.peak in the container, or the container was killed before the gate ended (WARN)"; fi
