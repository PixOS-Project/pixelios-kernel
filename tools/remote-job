	if [[ $xnid =~ ^[0-9a-z]+$ ]]; then xn=" xnub=${xnid:0:12}"
	else xn=" xnub=UNKNOWN"; echo "REMOTE: XNUB image id not recorded (${xnid:-out/xnub-image.txt missing}): the job stopped before the in-slot build, or the file was not copied back (WARN)"; fi
fi
mcn=; if [ "$job" = gate-pre ]; then   # TP-048 rule 8: the persistent mutant cache must be visible in every gate-pre RESULT, and a bad state counted
	mcw=0; mcl=$(grep -a -o 'MUTCACHE cache=[a-z]* hits=[0-9]* fresh=[0-9]* stored=[0-9]* store_failed=[0-9]*.*' "$ldir/out/gate-full.log" 2>/dev/null | tail -n 1)
	if [ -z "$mcl" ]; then mcw=1; mch="?"; mcf="?"; mcs=missing; echo "REMOTE: MUTCACHE line missing in out/gate-full.log (cache state unknown, WARN)$([ "$rc" = 0 ] || echo "; the gate failed (rc=$rc), lane C may have been stopped before the mutants ran")"
	else
		mch=$(sed 's/.* hits=\([0-9]*\).*/\1/' <<<"$mcl"); mcf=$(sed 's/.* fresh=\([0-9]*\).*/\1/' <<<"$mcl"); mcs=$(sed 's/^MUTCACHE cache=\([a-z]*\) .*/\1/' <<<"$mcl"); mcsf=$(sed 's/.* store_failed=\([0-9]*\).*/\1/' <<<"$mcl")
		case $mcs in ok|on) ;; *) mcw=$((mcw + 1)); echo "REMOTE: MUTCACHE state cache=$mcs (not ok): the persistent cache is not usable (WARN): $mcl" ;; esac
		[ "$mcsf" = 0 ] || { mcw=$((mcw + 1)); echo "REMOTE: MUTCACHE store_failed=$mcsf (WARN): $mcl"; }
	fi
