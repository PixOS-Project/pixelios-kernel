def pre(h, only=None):
    """-> (kind, rule, reason) or None."""
    NOTES.clear()
    c = Ctx(h)
    for name, kind, fn in RULES:
        if only and name not in only:
            continue
        try:
            r = fn(c)
        except Exception as x:  # noqa: BLE001 - one crashing rule must not disable the others (review 3 A1)
            print("agent-guard GAP: rule %s crashed (%s: %s): skipped" % (name, type(x).__name__, x), file=sys.stderr)
            continue
        if r:
