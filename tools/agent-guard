def pre(h, only=None):
    """-> (kind, rule, reason) or None."""
    c = Ctx(h)
    for name, kind, fn in RULES:
        if only and name not in only:
            continue
        try:
            r = fn(c)
        except Exception:  # noqa: BLE001 - one crashing rule must not disable the others (review 3 A1)
            continue
        if r:
            return kind, name, r
    return None


def post(h):
    r = h.get("tool_response")
    ok = h.get("tool_name") == "Bash" and isinstance(r, dict) and isinstance(r.get("stdout"), str)
    so = r["stdout"] if ok else ""
    if not verdict("S2", ok, "cut" if len(so) > OUT_CAP else ""):
        return None
    os.makedirs(OUTDIR, exist_ok=True)
    p = os.path.join(OUTDIR, re.sub(r"\W", "_", str(h.get("tool_use_id") or "x")) + ".txt")
    with open(os.open(p, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600), "w") as f:
        f.write(so)
    cut = f"\n[agent-guard: {len(so)} chars cut; full output in {p}; grep it, do not cat it]\n"
    return {"hookSpecificOutput": {"hookEventName": "PostToolUse", "updatedToolOutput": {**r, "stdout": so[:KEEP] + cut + so[-KEEP:]}}}


def context(h):
    n = ctx_tokens(h.get("transcript_path"))
    if verdict("S1h", True, "x" if n > HARD else ""):
        msg = f"CONTEXT {n // 1000}k > HARD {HARD // 1000}k: finish the step, handoff, rollover NOW."
    elif verdict("S1s", True, "x" if n > SOFT else ""):
        msg = f"context {n // 1000}k > {SOFT // 1000}k: reaching rollover (200k): tidy up now, finish or park in-flight work, write the handoff, then roll over at the next safe point."
    else:
        return None
    return {"hookSpecificOutput": {"hookEventName": "UserPromptSubmit", "additionalContext": msg}}


def session(h):
    p = os.path.join(os.environ.get("CLAUDE_PROJECT_DIR", "."), "docs/state.md")
    if os.path.isfile(p):
        return {"hookSpecificOutput": {"hookEventName": "SessionStart",
                                       "additionalContext": open(p).read()[:7000] + "\nRead this, not HANDOFF.md/NOTES.md in full."}}
    return None


def statusline(h):
    u = (h.get("context_window") or {}).get("current_usage") or {}
    n = sum(u.get(k) or 0 for k in ("input_tokens", "cache_read_input_tokens", "cache_creation_input_tokens"))
    tag = "ROLL OVER NOW" if n > HARD else "roll over soon" if n > SOFT else "ok"
    return f"{(h.get('model') or {}).get('display_name', '?')} ctx {n // 1000}k/{HARD // 1000}k {tag}"


def decide(mode, h):
    """stdout text for MODE (None = print nothing)."""
    if mode in ("--pre", "--brief"):
        r = pre(h, BRIEF if mode == "--brief" else None)
        if r:
            return json.dumps({"hookSpecificOutput": {"hookEventName": "PreToolUse", "permissionDecision": r[0],
                                                      "permissionDecisionReason": "agent-guard %s: %s" % (r[1], r[2])}})
        return None
    if mode == "--statusline":
        return statusline(h)
    o = {"--post": post, "--context": context, "--context-nudge": context, "--session": session}[mode](h)
    return json.dumps(o) if o else None


