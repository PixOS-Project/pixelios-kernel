# R42: every deny/ask text must say what to do instead: a literal `Instead:` (or `Do instead`) part that holds a concrete command (a `backticked`
# span, a tools/ path or $!); bare verbs (run/use/read ..) do not count. Rules in THREE_PART also carry WHY (an AP/rule ref) and `Escape: <marker|none>`.
WHY_RX = re.compile(r"AP-\d+|AGENTS\.md|\brule \d|WORKFLOW\.md|\bR\d+\b")
DO_CMD = re.compile(r"`[^`\n]+`|\btools/[\w./-]+|\$!")
THREE_PART = {"E2a", "E2c", "E3a", "E3c", "E4", "E5", "E6", "E10", "S3b", "E18", "E25", "E26", "E27", "E28", "E29", "E30", "E31", "E32", "E33", "E34", "TF"}


def no_solution(rule, msg):
    """-> list of the parts a deny/ask text lacks ([] = ok)."""
    miss = []
    m = re.search(r"(?:Instead:|Do instead:?)(.*?)(?:Escape:|$)", msg, re.S)
    if not (m and DO_CMD.search(m.group(1))):
        miss.append("Instead-command")
    if rule in THREE_PART:
        if not WHY_RX.search(msg):
            miss.append("why-ref")
        if "Escape:" not in msg:
            miss.append("Escape")
    return miss


