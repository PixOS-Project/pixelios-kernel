def tf_where(path, cwd):
    """(queue root, repo-relative path, 'super'|'clone') when `path` is protected, else None."""
    p = os.path.realpath(path if os.path.isabs(path) else os.path.join(cwd, path))
    d = p
    while d and not os.path.isdir(d) and d != os.path.dirname(d):
        d = os.path.dirname(d)
    common = git(d, "rev-parse", "--path-format=absolute", "--git-common-dir")
    top = git(d, "rev-parse", "--show-toplevel")
    kind = root = None
    if common:
        common = os.path.realpath(common)
        base = os.path.dirname(common) if os.path.basename(common) == ".git" else ""
        m = re.match(r"^(.*?)/pixos-project/", common + "/")
        if base and os.path.isfile(os.path.join(base, "docs", "queue", "lanes.tsv")):
            kind, root = "super", base
        elif m:
            kind, root = "clone", m.group(1)
    elif re.search(r"/pixos-project/", p):
        kind, root, top = "clone", re.match(r"^(.*?)/pixos-project/", p).group(1), None
    if not kind:
        return None
    root = os.path.realpath(os.environ.get("QUEUE_ROOT") or root)
    rel = os.path.relpath(p, top) if top else os.path.relpath(p, root)
    if kind == "super" and (rel == "docs/queue" or rel.startswith(("docs/queue/", "logs/")) or rel == "logs"):
        return None
    if top and git(d, "check-ignore", "-q", p) is not None:   # `git check-ignore -q` prints nothing: rc 0 -> "" (ignored), rc 1 -> None
        return None
    return root, rel, kind


def tf_owned(root, thread):
