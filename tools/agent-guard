            s = text_of(c or "").strip()
            if s and not s.startswith("<"):
                out.append(s)
    return out


def tf_session(root, h):
    """-> (class, ticket id|None, escape reason|None); class 'triage'|'ticket'|'interactive'|'unknown' (transcript or classifier unreadable)."""
    m, tp = tf_tsg(root), h.get("transcript_path")
    if m is None or not tp or not os.path.isfile(tp):
        return "unknown", None, None
    try:
        prompts = tf_prompts(tp, m.text_of)
    except OSError:
        return "unknown", None, None
    tm = m.TICKET_PROMPT.match(prompts[0]) if prompts else None
    cls = "triage" if prompts and prompts[0].startswith(m.PROMPT) else ("ticket" if tm else "interactive")
    esc = None
    for k, s in enumerate(prompts):
        if k == 0 and cls != "interactive":
            continue   # a launch message is agent-written: it cannot lift the rule
        e = TF_ESC.search(s)
        if e:
            esc = e.group(1).strip()
    return cls, (tm.group(1) if tm else None), esc


def tf_targets(c):
    """[(path, what)] this tool call writes (Write family: the file; Bash: the forms the parser sees, see Known gaps above)."""
    if c.t in TF_WRITE:
        p = c.i.get("file_path") or c.i.get("notebook_path") or ""
        return [(p, "write " + p)] if p else []
    if not c.cmd:
        return []
    out, moved = [], False
    for w, wd in walk(c.cmd, c.cwd):
        hd = head(w)
        if not hd:
            continue
        moved |= hd[0] in ("cd", "pushd", "popd")
        if wd is None:
            continue
        prog, a = hd[0], hd[1]
        ops = [x for x in a if not x.startswith("-")]
        res = lambda x: os.path.join(wd, os.path.expanduser(x))  # noqa: E731
        if prog in ("sed", "perl") and any(x.startswith("-i") or x == "--in-place" for x in a):
            out += [(res(x), prog + " -i " + x) for x in ops[1:]]
        elif prog in ("tee", "truncate", "patch"):
            out += [(res(x), prog + " " + x) for x in ops]
        elif prog in ("cp", "mv", "install", "ln") and ops:
            out += [(res(ops[-1]), prog + " into " + ops[-1])]
        elif prog == "git" and git_sub(a) == "commit":
            gd = opt_val(a, "-C")
            gd = res(gd) if gd and "$" not in gd and "`" not in gd else wd
            rest = a[a.index("commit") + 1:] if "commit" in a else []
            spec = rest[rest.index("--") + 1:] if "--" in rest else []
            if spec:
                out += [(os.path.join(gd, x), "git commit " + x) for x in spec]
            else:
                st = git(gd, "diff", "--cached", "--name-only") or ""
                files = st.splitlines() or (["."] if any(re.fullmatch(r"-[A-Za-z]*a[A-Za-z]*", x) or x == "--all" for x in rest) else [])
                top = git(gd, "rev-parse", "--show-toplevel") or gd
                out += [(os.path.join(top, x), "git commit with " + x + " staged") for x in files]
    for t in redirect_targets(c.cmd):
        if os.path.isabs(os.path.expanduser(t)) or not moved:
            out.append((os.path.join(c.cwd, os.path.expanduser(t)), "redirect into " + t))
    return out


def r_tf(c):
    if c.t not in TF_WRITE and c.t != "Bash":
