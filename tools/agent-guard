                fails.append(f"{lbl}: got {got} want {want}")
        rules = {x[0] for x in RULES} | {"S2", "S1h", "S1s"}
        for r in sorted(rules):
            if COV.get(r) != {"ok", "viol"}:
                fails.append(f"coverage: rule {r} saw {sorted(COV.get(r, []))}, needs ok and viol fixtures")
        surv = []
        for r in sorted(rules):   # the rule-toggle mutants replay every fixture 2x per rule: skip them once the verdict is already FAIL
            for mode in ("off", "on") if not fails else ():
                MUT = (r, mode)
                if all(got == want for _, (got, want) in res()):
                    surv.append(f"{r}/{mode}")
        MUT = None
        fails += [f"mutant survived: {s}" for s in surv]
        # CLI contract: fail open, exit 0, JSON shape
        for inp, mode in (("{broken", "--pre"), ("", "--post"), ("[]", "--context")):
            p = subprocess.run([sys.executable, "-B", me, mode], input=inp, capture_output=True, text=True, timeout=20)
            if p.returncode != 0 or p.stdout:
                fails.append(f"fail-open {mode} {inp!r}: rc={p.returncode} out={p.stdout!r}")
        p = subprocess.run([sys.executable, "-B", me, "--pre"], input=json.dumps({"tool_name": "Bash", "tool_input": {"command": "git stash"}}),
                           capture_output=True, text=True, timeout=20)
        try:
            o = json.loads(p.stdout)["hookSpecificOutput"]
            assert p.returncode == 0 and o["hookEventName"] == "PreToolUse" and o["permissionDecision"] == "deny" and o["permissionDecisionReason"]
        except (ValueError, KeyError, AssertionError):
            fails.append(f"CLI deny shape: rc={p.returncode} out={p.stdout!r}")
        for f in fails:
            print("FAIL", f)
        print("RESULT: %s fixtures=%d rules=%d mutants=%d survived=%d failures=%d" % (
            "FAIL" if fails else "PASS", n, len(rules), 2 * len(rules), len(surv), len(fails)))
        return 1 if fails else 0
    finally:
        os.chdir(cwd0)
        STATE, OUTDIR, SHARED = saved[:3]
