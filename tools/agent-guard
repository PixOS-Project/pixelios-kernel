_PL = []


def lock_held():
    """(held, why): held iff phone-lock read_live() finds a lock whose holder is alive (status removes a dead one); loaded in-process like phone-guard.
    A broken load counts as free (fail open)."""
    if not _PL:
        try:
            ld = importlib.machinery.SourceFileLoader("phone_lock", os.path.join(HERE, "phone-lock"))
            m = importlib.util.module_from_spec(importlib.util.spec_from_loader("phone_lock", ld))
            ld.exec_module(m)
            _PL.append(m)
        except Exception:  # noqa: BLE001 - fail open
            _PL.append(None)
    try:
        i = _PL[0].read_live() if _PL[0] else None  # a dead holder (stale lock) counts as free
    except Exception as x:  # noqa: BLE001
        print("agent-guard GAP: phone-lock read failed (%s: %s): treated as not held" % (type(x).__name__, x), file=sys.stderr)
        i = None
    return i is not None, "held by %s pid=%s" % ((i or {}).get("owner", "?"), (i or {}).get("pid"))


