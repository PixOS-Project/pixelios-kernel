ROLL_RX = re.compile(r"roll[- ]?" + "over|successor|hand[- ]?(?:off|over)|watcher|take over (?:from|this|the)", re.I)
SUCC_ESC = re.compile(r"successor-ok:\s*(\S[^\n]*)")


def r_e30(c):
    """A thread launch (t3_thread_launch, create_threads, `t3 thread start`) is denied when its title/message names a successor, handoff or watcher thread (ROLL_RX), or when
    the caller is a ticket thread (owns a running ticket) and the launch is not a ticket launch (`T-xxxx` title + `Execute ticket T-xxxx` message: the
    dispatcher's shape, judged by tools/triage-settle-guard --pre). Escape: a user prompt `successor-ok: <reason>` (logged to logs/ticket-first.log)."""
    mcp = c.t.endswith(("t3_thread_launch", "create_threads"))
    bash = any(p == "t3" and a[:2] == ["thread", "start"] for p, a, _, _ in c.heads)
    if not (mcp or bash):
        return None
    text = json.dumps(c.i, default=str) if mcp else c.cmd
    if mcp and re.match(r"T-[0-9a-f]{4}\b", str(c.i.get("title") or "")) and re.match(r"\s*Execute ticket T-[0-9a-f]{4}\b", str(c.i.get("message") or c.i.get("prompt") or "")):
        return verdict("E30", True, "")
    w = tf_where(os.path.join(c.cwd, "shim", "x"), c.cwd)
    root = w[0] if w else (os.environ.get("QUEUE_ROOT") or ORIG_PROJ or os.environ.get("CLAUDE_PROJECT_DIR") or "")
    thread = os.environ.get("T3CODE_THREAD_ID", "")
    word = ROLL_RX.search(text)
    owner = bool(thread and root and tf_owned(root, thread))
    if not (word or owner):
        return verdict("E30", True, "")
    esc = None
    try:
        m, tp = tf_tsg(root), c.h.get("transcript_path")
        if m is not None and tp and os.path.isfile(tp):
            for k, sp in enumerate(tf_prompts(tp, m.text_of)):
                e = SUCC_ESC.search(sp) if k else None   # the first prompt is agent-written in a launched thread
                esc = e.group(1).strip() if e else esc
    except OSError:   # lint-silent: expected an unreadable transcript finds no escape, so the deny stands (fail closed)
        pass
    what = ("the launch text says %r" % word.group(0)) if word else "a ticket thread launches nothing but its ticket-shaped successor tickets through the dispatcher"
    if esc:
        tf_log(root, "successor escape allow tool=%s reason=%s" % (c.t, esc))
        return verdict("E30", True, "")
    tf_log(root, "deny successor launch tool=%s thread=%s (%s)" % (c.t, thread or "-", what))
    return verdict("E30", True, ("no successor threads (AGENTS.md, docs/recipes/ticket-thread.md: successor threads were retired 2026-10-31, user 2026-11-01): %s. A context limit means "
                                 "finish the step, log state, split the ticket. Instead: `tools/queue log T-id \"...\"` then `tools/queue close T-id --split` (the dispatcher "
                                 "relaunches the child). Escape: the user types `successor-ok: <reason>` in a prompt of this session (logged to logs/ticket-first.log)." % what))


