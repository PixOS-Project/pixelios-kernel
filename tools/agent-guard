def redirect_targets(cmd):
    """file names after > >> &> >| in the outer command (quotes and heredoc bodies as in parse; bash -c strings are not followed)."""
    cmd = prep(cmd)
    lex = shlex.shlex(cmd, posix=True, punctuation_chars=True)
    lex.whitespace_split = True
    lex.commenters = ""
    out, prev = [], None
    try:
        for t in lex:
            if prev is not None and REDIR_OUT.fullmatch(prev) and not re.fullmatch(r"[;&|()<>]+", t):
                out.append(t)
            prev = t
    except ValueError:   # lint-silent: expected an unbalanced quote in the model-written command stops the tokenizer; the tokens so far are the answer
        pass
    return out


