def session(h):
    """R41 H1: the state block is generated live at every session start (tools/gen-state.py --stdout), never read from a committed snapshot (a stale docs/state.md misled every session for 5 days). A failure is loud, not a silent fallback to old text."""
    d = os.environ.get("CLAUDE_PROJECT_DIR", ".")
    why = ""
    try:
        r = subprocess.run([sys.executable, os.path.join(d, "tools/gen-state.py"), "--root", d, "--stdout"],
                           capture_output=True, text=True, timeout=7)
        txt = "".join(l for l in r.stdout.splitlines(True) if not l.startswith("RESULT:"))
        if r.returncode == 0 and txt.strip():
            ctx = txt[:7000] + "\nRead this, not HANDOFF.md/NOTES.md in full."
        else:
            why = "rc=%d %s" % (r.returncode, (r.stderr or r.stdout).strip()[-200:])
    except (OSError, subprocess.SubprocessError) as e:
        why = "%s: %s" % (e.__class__.__name__, e)
    if why:
        ctx = ("SESSION STATE UNAVAILABLE (agent-guard S8, R41 H1): tools/gen-state.py failed: %s. Read the last section of docs/HANDOFF.md "
               "(grep -n '^## STATE' docs/HANDOFF.md) and your row in docs/GOALS.md yourself; run tools/gen-state.py --stdout to see the error." % why)
    return {"hookSpecificOutput": {"hookEventName": "SessionStart", "additionalContext": ctx}}


def statusline(h):
