# AP-303: os.kill(-1, SIGKILL) kills every process of the host user (the T3 server and all threads died four times). Judged on raw text because the
# call sits in a Python file body or a heredoc, which the parsed-words rules never see.
KILL_PY = re.compile(r"\bos\.kill\(\s*(?:pid\s*=\s*)?(?:-\s*\(?\s*0*1\b|~\s*0\b)|\bkill\(\s*-1\s*,|\bkill\s*\(?\s*[\w-]+\s*,\s*-\s*0*1\b|\bProcess\.kill\([^,)]+,\s*-1\b")   # python, perl, ruby, signal-first
KILL_SH = re.compile(r"\bkillall5\b|\bkill\s+(?:(?:(?:-s|-n|--signal)[= ]\S+|-[A-Za-z0-9]+)\s+(?:--\s+)?|--\s+)-0*1(?![\w.])")                       # text of a shell file (quotes removed)
PID1_CHECK = re.compile(r"getpid\(\)\s*==\s*1\b|\bos\.getpid\(\)\s*!=\s*1\b|\$\$\s*(?:-eq|==)\s*1\b")
CODE_PROGS = re.compile(r"python[\d.]*|perl|ruby|node|nodejs")
KILL_ALL_MSG = ("kill of pid -1 (os.kill(-1, ..), kill(-1, ..), `kill -9 -1`, killall5) SIGKILLs every process of the host user and killed the T3 server and all threads "
                "four times (AP-303). Instead: guard the call with `os.getpid() == 1` in the same function (kernel sim/sim-0d e08df59: kill_rest refuses "
                "unless pid 1 of a fresh userns), trap `os.kill` in mutant tests, or run it inside `unshare -r -p -f CMD`. Escape: none (a pid-1 check or unshare -p in the same file/command passes).")


def kill_all_text(text, sh=True):
    """AP-303: does this CODE text (a file body, a heredoc written as code, a python -c string) kill pid -1? Full-line comments and quotes are dropped
    first; sh=False skips the shell forms (`kill -9 -1` inside a python string that is only printed)."""
    t = "\n".join(l for l in text.split("\n") if not l.lstrip().startswith("#")).replace('"', "").replace("'", "")
    if KILL_PY.search(t) or (sh and KILL_SH.search(t)):
        return True
    for m in re.finditer(r"\b(\w+)\s*=\s*-\s*0*1\b", t):      # n=-1 ... kill -9 $n / os.kill(n, 9)
        v = re.escape(m.group(1))
        if re.search((r"\bkill\b[^\n;|&]*\$\{?%s\b|" % v if sh else "") + r"\bkill\(\s*%s\b" % v, t[m.end():]):
            return True
    return False


def kill_operands(a):
    """the pid operands of a shell `kill` (quotes already removed by the parse): after `-9`, `-KILL`, `-s SIG`, `-n 9`, `--signal=X`, `--`."""
    i, sig = 0, False
    while i < len(a):
        if a[i] in ("-s", "-n", "--signal") and i + 1 < len(a):
            i, sig = i + 2, True
        elif a[i].startswith("--signal="):
            i, sig = i + 1, True
        elif a[i] == "--":
            i += 1
            break
        elif re.fullmatch(r"-[A-Za-z0-9]+", a[i]) and not sig:
            i, sig = i + 1, True
        else:
            break
    return a[i:]


def pidns_unshare(cmd):
    """a real PID namespace: `unshare` with -p / --pid (-f alone only forks)."""
    for words, _ in (s for p in parses(cmd) for s in p):
        h = head(words)
        if h and h[0] == "unshare":
            for x in h[1]:
                if not x.startswith("-"):
                    break
                if re.fullmatch(r"-[A-Za-z]*p[A-Za-z]*", x) or x.startswith("--pid"):
                    return True
    return False


def e28_segments(cmd, depth=0):
    """every word list of a Bash command: the parses of bash -c / eval, and what follows `unshare OPTS` (those are not wrapper heads)."""
    for p in parses(cmd):
        for words, _ in p:
            yield words
            h = head(words)
            if h and h[0] == "unshare" and depth < 3:
                rest = list(h[1])
                while rest and rest[0].startswith("-"):
                    rest.pop(0)
                if rest:
                    yield from e28_segments(shlex.join(rest), depth + 1)


def bash_kills_all(cmd):
    neg = set()
    segs = list(e28_segments(cmd))
    for words in segs:
        for x in words:
            m = re.fullmatch(r"(\w+)=-0*1", x)
            if m:
                neg.add(m.group(1))
    for words in segs:
        h = head(words)
        if not h:
            continue
        if h[0] == "killall5":
            return True
        if h[0] == "kill":
            ops = kill_operands(h[1])
            if any(re.fullmatch(r"-0*1", x) or any(re.fullmatch(r"\$\{?%s\}?" % re.escape(v), x) for v in neg) for x in ops):
                return True
        elif CODE_PROGS.fullmatch(h[0]):
            code = "\n".join(h[1])
            if kill_all_text(code, bool(re.search(r"os\.system|subprocess|popen|\bsystem\(", code))):
                return True
    for m in HEREDOC.finditer(cmd):       # bodies are cut from the parse: judge those written as code (python/perl/sh stdin, or a redirect to a non-doc file)
        intro, body = cmd[cmd.rfind("\n", 0, m.start()) + 1:m.start()] + m.group(0).split("\n", 1)[0], m.group(0).split("\n", 1)[1]
        writes = re.search(r">>?\s*(\S+)|\btee\s+(?:-a\s+)?(\S+)", intro)
        if re.match(r"\s*(?:sudo\s+)?(?:python[\d.]*|perl|ruby|node|nodejs)\b", intro):
            if kill_all_text(body, bool(re.search(r"os\.system|subprocess|popen|\bsystem\(", body))):
                return True
        elif re.match(r"\s*(?:sudo\s+)?(?:ba?sh|sh)\b", intro) or (writes and not (writes.group(1) or writes.group(2)).strip("'\"").endswith((".md", ".txt"))):
            if kill_all_text(body):
                return True
    return False


def r_e28(c):
    """AP-303: deny a tool/test file edit or a Bash command that kills pid -1 without a pid-1 check (or an `unshare -p` namespace) in the same file/command.
    Bash is judged on parsed words (a `kill` head, a python/perl -c string, a heredoc written as code), so a command that only quotes the pattern
    (grep, git commit -m, gh, echo, a .md heredoc) passes."""
    if c.t == "Bash":
        if not c.cmd or not bash_kills_all(c.cmd):
            return None
        guarded = PID1_CHECK.search(c.cmd) or pidns_unshare(c.cmd)
        return verdict("E28", True, "" if guarded else KILL_ALL_MSG)
    if c.t not in ("Write", "Edit", "MultiEdit"):
        return None
    p = c.i.get("file_path") or ""
    if os.path.basename(p) in ("agent-guard", "test_agent_guard.py") or p.endswith((".md", ".txt")):
        return None      # the guard's own fixtures name the pattern; docs describe it
    new = [c.i.get("content"), c.i.get("new_string")] + [e.get("new_string") for e in c.i.get("edits") or [] if isinstance(e, dict)]
    text = "\n".join(x for x in new if isinstance(x, str))
    if not kill_all_text(text):
        return None
    if c.t != "Write":      # an edit sees only its new text: a pid-1 check elsewhere in the same file counts
        try:
            text += "\n" + open(p, encoding="utf-8", errors="replace").read()
        except OSError:   # lint-silent: expected an absent optional file contributes no text to the PID1 check
            pass
    return verdict("E28", True, "" if PID1_CHECK.search(text) else KILL_ALL_MSG)


