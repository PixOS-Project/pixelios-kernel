def run_fx(f):
    """fixture -> (got, want); got/want are 'allow' or 'kind:rule' (or 'out:...' for the non-PreToolUse modes)."""
    mode, h, want, pre_hook = f["mode"], f["h"], f["want"], f.get("setup")
    if pre_hook:
        pre_hook()
    if mode == "--pre":
        try:
            r = pre(h)
        except Exception as e:  # noqa: BLE001 - a crash is a failed fixture, not a harness error
            return f"crash:{type(e).__name__}", want
        return (f"{r[0]}:{r[1]}" if r else "allow") + (f["check"]() if f.get("check") else ""), want
    if mode == "--post":
        r = post(h)
        so = r["hookSpecificOutput"]["updatedToolOutput"]["stdout"] if r else ""
        if not r:
            return "allow", want
        full = open(re.search(r"full output in (\S+);", so).group(1)).read()
        orig = h["tool_response"]["stdout"]
        return ("cut" if len(so) <= 9000 and len(full) == len(orig) and so.endswith(orig[-KEEP:]) and so.startswith(orig[:KEEP]) else "badcut"), want
    if mode == "--context":
        r = context(h)
        return ("allow" if not r else ("hard" if "CONTEXT" in r["hookSpecificOutput"]["additionalContext"] else "soft")), want
    return None, want


