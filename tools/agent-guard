            files += (git(root, "diff", "--name-only") or "").split() + (git(root, "ls-files", "--others", "--exclude-standard") or "").split()
        tf = [f for f in files if TOOLPATH.match(f)]
        if tf and "EMERGENCY-TOOL-FIX" not in c.cmd:
            bad = (f"tool change {tf[0]} committed on stream branch {br} (AP-58): commit it on trunk (or tools/<slug> from trunk), gate, merge down; "
                   "emergency: put EMERGENCY-TOOL-FIX in the message and cherry-pick -x it to trunk this session")
    return verdict("E22", seen, bad) if seen else None


def r_e2c(c):
    ks, bad = False, ""
    for p in parses(c.cmd) if c.cmd else []:
        for k, (w, op) in enumerate(p):
            h = head(w)
            if not h:
                continue
            if h[0] in ("pkill", "killall"):
                ks = True
                bad = f"{h[0]} picks processes by name and hits other owners' (AP-36, AP-56): kill only a PID you started ($!) or looked up and read"
            elif h[0] == "kill":
                ks = True
                nxt = head(p[k + 1][0]) if k + 1 < len(p) else None
                if any(re.search(r"(\$\(|`)\s*(pgrep|pidof)\b", x) for x in h[1]) or (w[-1].endswith("$") and "(" in op and nxt and nxt[0] in ("pgrep", "pidof")):
                    bad = "kill $(pgrep ...) picks a process by name (AP-36): look the PID up, read it, then kill that PID (or use $! of your own job)"
            elif h[0] in ("pgrep", "pidof") and op == "|":
                m = k + 1
                while m < len(p):
                    hh = head(p[m][0])
                    if hh and hh[0] == "kill" and "xargs" in hh[2]:
                        ks = True
                        bad = "pgrep | xargs kill picks a process by name (AP-36): look the PID up, read it, then kill that PID"
                    if p[m][1] != "|":
                        break
                    m += 1
    return verdict("E2c", ks, bad)


def git_sub(a):
    """the git subcommand: first word after the leading options."""
    i = 0
    while i < len(a) and a[i].startswith("-"):
        i += 2 if a[i] in ("-C", "-c", "--git-dir", "--work-tree", "--namespace", "--exec-path") else 1
    return a[i] if i < len(a) else None


def r_e9(c):
    st = [1 for p, a, _, w in c.heads if p == "git" and git_sub(a) == "stash"]
    return verdict("E9", any(p == "git" for p, *_ in c.heads), "git stash is banned (AP-28): commit a wip commit instead" if st else "")


