        rules = {x[0] for x in RULES} | {"S2", "S1h", "S1s"}
        for r in sorted(rules):
            if COV.get(r) != {"ok", "viol"}:
                fails.append(f"coverage: rule {r} saw {sorted(COV.get(r, []))}, needs ok and viol fixtures")
        surv = []
        for r in sorted(rules):
            for mode in ("off", "on"):
                MUT = (r, mode)
                if all(got == want for _, (got, want) in res()):
                    surv.append(f"{r}/{mode}")
        MUT = None
        fails += [f"mutant survived: {s}" for s in surv]
        # CLI contract: fail open, exit 0, JSON shape
        for inp, mode in (("{broken", "--pre"), ("", "--post"), ("[]", "--context")):
            p = subprocess.run([sys.executable, "-B", __file__, mode], input=inp, capture_output=True, text=True, timeout=20)
            if p.returncode != 0 or p.stdout:
                fails.append(f"fail-open {mode} {inp!r}: rc={p.returncode} out={p.stdout!r}")
        p = subprocess.run([sys.executable, "-B", __file__, "--pre"], input=json.dumps({"tool_name": "Bash", "tool_input": {"command": "git stash"}}),
                           capture_output=True, text=True, timeout=20)
        try:
            o = json.loads(p.stdout)["hookSpecificOutput"]
            assert p.returncode == 0 and o["hookEventName"] == "PreToolUse" and o["permissionDecision"] == "deny" and o["permissionDecisionReason"]
        except (ValueError, KeyError, AssertionError):
            fails.append(f"CLI deny shape: rc={p.returncode} out={p.stdout!r}")
        for f in fails:
            print("FAIL", f)
        print("RESULT: %s fixtures=%d rules=%d mutants=%d survived=%d failures=%d" % (
            "FAIL" if fails else "PASS", n, len(rules), 2 * len(rules), len(surv), len(fails)))
        return 1 if fails else 0
    finally:
        STATE, OUTDIR, SHARED = saved[:3]
        os.environ.clear()
        os.environ.update(saved[3])
        subprocess.run([sys.executable, "-B", os.path.join(HERE, "phone-lock"), "release", "--owner", "agent-guard-test"],
                       capture_output=True, env={**saved[3], "PHONE_LOCK_DIR": os.path.join(tmp, "phone.lock")})
        shutil.rmtree(tmp, ignore_errors=True)


def run_fx(f):
    """fixture -> (got, want); got/want are 'allow' or 'kind:rule' (or 'out:...' for the non-PreToolUse modes)."""
    mode, h, want, pre_hook = f["mode"], f["h"], f["want"], f.get("setup")
    if pre_hook:
        pre_hook()
    if mode == "--pre":
        r = pre(h)
        return (f"{r[0]}:{r[1]}" if r else "allow") + (f["check"]() if f.get("check") else ""), want
    if mode == "--post":
        r = post(h)
        so = r["hookSpecificOutput"]["updatedToolOutput"]["stdout"] if r else ""
        if not r:
            return "allow", want
        full = open(re.search(r"full output in (\S+);", so).group(1)).read()
        orig = h["tool_response"]["stdout"]
        return ("cut" if len(so) <= 9000 and len(full) == len(orig) and so.endswith(orig[-KEEP:]) and so.startswith(orig[:KEEP]) else "badcut"), want
    if mode == "--context":
        r = context(h)
        return ("allow" if not r else ("hard" if "CONTEXT" in r["hookSpecificOutput"]["additionalContext"] else "soft")), want
    return None, want


