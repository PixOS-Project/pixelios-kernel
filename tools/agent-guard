sys.dont_write_bytecode = True
HERE = os.path.dirname(os.path.realpath(__file__))
BIG, OUT_CAP, KEEP = 40_000, 12_000, 4_000      # bytes for a whole-file Read; Bash stdout chars (cap, kept each end)
SOFT, HARD = 180_000, 200_000                    # context tokens, absolute
STATE = os.environ.get("AGENT_GUARD_STATE", "/tmp/agent-guard")
OUTDIR = os.environ.get("AGENT_GUARD_OUT", "/tmp/claude-out")
SHARED = os.environ.get("AGENT_GUARD_SHARED") or os.path.join(
    os.environ.get("CLAUDE_PROJECT_DIR") or os.path.expanduser("~/.t3/projects/pixelios"), "pixos-project/pixelios-kernel")

HOT = re.compile(r"(NOTES\.md|HANDOFF\.md|ANTIPATTERNS\.md|test-bluejay-boot\.py|\.jsonl|usbnet\.log|usb\.txt|gate\.log)$")
NOLIMIT = {".png", ".jpg", ".jpeg", ".gif", ".webp", ".bmp", ".pdf", ".ipynb"}
HOT_DOCS = {"NOTES.md", "HANDOFF.md", "ANTIPATTERNS.md"}
LOADED_DOCS = {"AGENTS.md", "CLAUDE.md"}
NEWWORK = {"xrun", "probe-run", "check-all.sh", "xnu-local-build", "ci-kernel"}
CHECKS = {"check-all.sh", "validate-repo.py", "probe-run", "xrun"}
PIPE_FILTERS = {"tail", "head", "grep", "egrep", "fgrep"}
DELEGATE = ("Agent", "Task")
PHONE_TOOLS = {"probe-run", "xrun", "fboot.sh", "plock.sh", "phone-lock", "phone", "fflash-userdata.sh"}
WRAP = {"sudo", "env", "exec", "nohup", "time", "timeout", "nice", "stdbuf", "setsid", "xargs", "watch", "command", "builtin"}
KEYWORDS = {"then", "do", "else", "elif", "while", "until", "if", "!", "{", "}"}
ASSIGN = re.compile(r"^[A-Za-z_]\w*=")
REDIR = {"<", ">", ">>", "<<", "&>", ">&", "<<<"}
HEREDOC = re.compile(r"<<-?\s*(['\"]?)(\w+)\1[^\n]*\n.*?\n[ \t]*\2[ \t]*(?=\n|$)", re.S)
SHELLS = {"bash", "sh", "zsh", "dash"}
INTERP = SHELLS | {"python3", "python"}

MUT = None   # (rule, 'off'|'on') during --self-test
COV = {}     # rule -> {'ok','viol'} seen


def verdict(name, applies, bad):
    """None if the rule does not apply or passes, else the reason. Self-test mutants: 'off' never fires, 'on' always fires."""
    if not applies:
        return None
    viol = bool(bad)
    COV.setdefault(name, set()).add("viol" if viol else "ok")
    mode = MUT[1] if MUT and MUT[0] == name else None
    if mode == "off":
        viol = False
    elif mode == "on":
        viol, bad = True, bad or "mutant"
    return bad if viol else None


# ---- command parsing (phone-guard's rules: quotes and heredoc bodies are not commands) ----
_PARSE = {}


def parse(cmd):
    """[(words, op_after)] split at ; && || | & ( ) and newlines (memoised per command text: the rules only read the result)."""
    if cmd not in _PARSE:
        _PARSE[cmd] = _parse(cmd)
    return _PARSE[cmd]


def _parse(cmd):
    cmd = HEREDOC.sub(lambda m: m.group(0).split("\n", 1)[0], cmd).replace("\n", " ; ")
    lex = shlex.shlex(cmd, posix=True, punctuation_chars=True)
    lex.whitespace_split = True
    out, seg, skip = [], [], False
    try:
        for t in lex:
            if re.fullmatch(r"[;&|()<>]+", t):
                if t in REDIR:
                    skip = True        # the word after a redirection is a file name
                    continue
                if seg:
                    out.append((seg, t))
                elif out and ")" in t:      # `(cd x;)`: the close follows an empty segment; keep it visible on the last real one
                    out[-1] = (out[-1][0], out[-1][1] + t)
                seg = []
            elif skip:
                skip = False
            else:
                seg.append(t)
    except ValueError:
        pass
    if seg:
        out.append((seg, ""))
    return out


def head(words):
    """(program basename, args, wrappers seen) after env assignments, keywords and wrappers; `python3 x.py` -> x.py."""
    i, wr = 0, set()
    while i < len(words):
        t = words[i]
        b = os.path.basename(t)
        if b in KEYWORDS or ASSIGN.match(t):
            i += 1
        elif b in WRAP:
            wr.add(b)
            i += 1
            if b in ("sudo", "env") and words[i:i + 1] and words[i] in ("-u", "-g", "-C", "-h", "-p", "-U"):
                i += 2
            while i < len(words) and (words[i].startswith("-") or ASSIGN.match(words[i]) or re.fullmatch(r"\d+(\.\d+)?[smhd]?", words[i])):
                i += 1
        else:
            break
    if i >= len(words):
        return None
    prog, args = os.path.basename(words[i]), words[i + 1:]
    if prog in INTERP and args and not args[0].startswith("-"):
        prog, args = os.path.basename(args[0]), args[1:]
    return prog, args, wr


def parses(cmd, depth=0):
    """the outer parse plus the parses of bash -c / eval strings."""
    p = parse(cmd)
    out = [p]
    if depth < 3:
        for words, _ in p:
            i = 0
            while i < len(words) and (ASSIGN.match(words[i]) or os.path.basename(words[i]) in WRAP | KEYWORDS):
                i += 1
            if i >= len(words):
                continue
            b = os.path.basename(words[i])
            rest = words[i + 1:]
            if b == "eval" and rest:
                out += parses(" ".join(rest), depth + 1)
            elif b in SHELLS:
                for k, x in enumerate(rest):
                    if re.fullmatch(r"-[a-z]*c[a-z]*", x) and k + 1 < len(rest):
                        out += parses(rest[k + 1], depth + 1)
                        break
    return out


def heads(cmd):
    """every (prog, args, wrappers, words) of a Bash command, including bash -c strings."""
    for p in parses(cmd):
        for words, _ in p:
            h = head(words)
            if h:
                yield h + (words,)


# ---- context size ----
def ctx_tokens(tp):
    """tokens of the last assistant usage in the transcript tail (hooks may see the file one turn late)."""
    try:
        with open(tp, "rb") as f:
            f.seek(0, 2)
            f.seek(max(0, f.tell() - 400_000))
            lines = f.read().decode("utf-8", "replace").splitlines()
    except (OSError, TypeError):
        return 0
    for line in reversed(lines):
        if '"usage"' not in line:
            continue
        try:
            d = json.loads(line)
            if d.get("type") != "assistant":
                continue
            u = d["message"]["usage"]
            n = sum(u.get(k) or 0 for k in ("input_tokens", "cache_read_input_tokens", "cache_creation_input_tokens"))
        except (ValueError, KeyError, TypeError, AttributeError):
            continue
        if n:
            return n
    return 0


class Ctx:
    def __init__(self, h):
        self.h, self.t, self.i = h, h.get("tool_name", ""), h.get("tool_input") or {}
        self.cmd = self.i.get("command", "") if self.t == "Bash" and isinstance(self.i.get("command"), str) else ""
        self._n = None
        self._heads = None

    @property
    def n(self):
        if self._n is None:
            self._n = ctx_tokens(self.h.get("transcript_path"))
        return self._n

    @property
    def heads(self):
        if self._heads is None:
            self._heads = list(heads(self.cmd)) if self.cmd else []
        return self._heads

    @property
    def is_delegate(self):
        return self.t in DELEGATE or self.t.endswith("delegate_task")

    @property
    def prompt(self):
        p = self.i.get("prompt") or self.i.get("task")
        return p if isinstance(p, str) else None

    @property
    def cwd(self):
        return self.h.get("cwd") or os.getcwd()


def git(cwd, *a):
    try:
        r = subprocess.run(["git", "-C", cwd, *a], capture_output=True, text=True, timeout=5)
        return r.stdout.strip() if r.returncode == 0 else None
    except (OSError, subprocess.SubprocessError):
        return None


def rootish(a, cwd):
    """the AGENTS.md/CLAUDE.md the session already loaded: the file directly under the project dir (bare names resolve against cwd)."""
    pd = os.environ.get("CLAUDE_PROJECT_DIR")
    p = os.path.realpath(os.path.join(cwd, os.path.expanduser(a)))
    return bool(pd and os.path.basename(a) in LOADED_DOCS and os.path.dirname(p) == os.path.realpath(pd))


# ---- rules: fn(ctx) -> None | reason (through verdict) ----
def r_s1(c):
    if c.h.get("agent_id"):     # a subagent has its own window (A11, guess: the transcript_path may be the parent's)
        return None
    new = c.is_delegate or any(p in NEWWORK or (p == "phone-lock" and "run" in a) for p, a, _, _ in c.heads)
    if not new:
        return None
    return verdict("S1", True, f"context {c.n // 1000}k > {HARD // 1000}k: no new work; commit, write the handoff, run the rollover skill"
                   if c.n > HARD else "")


def r_s3a(c):
    if c.t != "Read":
        return None
    p = c.i.get("file_path") or ""
    size = os.path.getsize(p) if os.path.isfile(p) else 0
    if os.path.splitext(p)[1].lower() in NOLIMIT:     # images/PDFs/notebooks: `limit` does not apply (a PDF is bounded by `pages`)
        return None
    try:
        lim = int(c.i.get("limit") or 0)
    except (TypeError, ValueError):
        lim = 0
    bad = (HOT.search(p) or size > BIG) and (not lim or lim > 300)
    return verdict("S3a", True, f"{os.path.basename(p)} is {size // 1000} KB, limit {lim or 'none'}: grep -n KEY first, then Read with offset/limit (<= 300 lines)" if bad else "")


def r_s3b(c):
    hit = []
    for w, wd in walk(c.cmd, c.cwd):
        h = head(w)
        if h and wd is not None and h[0] in ("cat", "less", "more", "head", "tail", "sed", "bat") \
                and not (h[0] == "sed" and any(x.startswith("-i") or x == "--in-place" for x in h[1])) and any(rootish(x, wd) for x in h[1]):
            hit.append(1)
    return verdict("S3b", bool(c.heads) and any(p in ("cat", "less", "more", "head", "tail", "sed", "bat") for p, *_ in c.heads),
                   "AGENTS.md/CLAUDE.md are already in context; do not re-read them" if hit else "")


def r_s3c(c):
    dump = [1 for p, a, _, _ in c.heads if p in ("cat", "less", "more") and any(os.path.basename(x) in HOT_DOCS for x in a)]
    return verdict("S3c", any(p in ("cat", "less", "more") for p, *_ in c.heads),
                   "whole-file read of a hot doc: grep -n KEY, then sed -n A,Bp (<= 300 lines)" if dump else "")


def spans(prog, a):
    """line counts requested by sed -n A,Bp / head -n N / head -N / tail -n N (tail -n +N is a start line: skipped)."""
    out = []
    if prog == "sed" and "-n" in a:
        for x in a:
            m = re.fullmatch(r"(\d+),(\d+)p", x)
            if m:
                out.append(int(m.group(2)) - int(m.group(1)) + 1)
    elif prog in ("head", "tail"):
        for k, x in enumerate(a):
            m = re.fullmatch(r"-n?(\d+)", x) or (re.fullmatch(r"-n", x) and k + 1 < len(a) and re.fullmatch(r"\d+", a[k + 1]) and re.match(r"(\d+)", a[k + 1]))
            if m:
                out.append(int(m.group(1)))
    return out


def r_s3d(c):
    ap = [(p, a) for p, a, _, _ in c.heads if p in ("sed", "head", "tail")]
    bad = any(s > 300 for p, a in ap for s in spans(p, a))
    return verdict("S3d", bool(ap), "range > 300 lines: narrow it with grep -n first" if bad else "")


def secs(x):
    if x in ("infinity", "inf"):
        return float("inf")
    m = re.fullmatch(r"(\d+(?:\.\d+)?)([smhd]?)", x)
    return float(m.group(1)) * {"": 1, "s": 1, "m": 60, "h": 3600, "d": 86400}[m.group(2)] if m else 0


def r_s5a(c):
    sl = [a for p, a, _, _ in c.heads if p == "sleep"]
    bad = any(sum(secs(x) for x in a) > 30 for a in sl)
    return verdict("S5a", bool(sl) and c.i.get("run_in_background") is not True,
                   "sleep > 30 s: no timed polling; run the work in the background and wait for the completion notification" if bad else "")


def r_s5b(c):
    if not re.search(r"(task_status|t3_thread_list|t3_thread_read)$", c.t):
        return None
    key = hashlib.sha1(json.dumps(c.i, sort_keys=True, default=str).encode()).hexdigest()[:12]
    f = os.path.join(STATE, re.sub(r"\W", "_", c.h.get("session_id") or "x") + "." + re.sub(r"\W", "_", c.t) + "." + key + ".poll")
    recent = os.path.exists(f) and time.time() - os.path.getmtime(f) < 600
    r = verdict("S5b", True, "status polled < 10 min ago: wait for the completion notification" if recent else "")
    if not recent:
        os.makedirs(STATE, exist_ok=True)
        open(f, "w").close()
    return r


def r_s6a(c):
    p = c.prompt
    return verdict("S6a", c.is_delegate and p is not None, f"brief {len(p or '')} chars > 6000: cite file:line ranges instead of pasting" if len(p or "") > 6000 else "")


def r_s6b(c):
    p = c.prompt
    return verdict("S6b", c.is_delegate and p is not None, "" if re.search(r"\bat most \d+ lines\b", p or "", re.I) else 'brief must say "Return a summary of at most N lines"')


def r_s4a(c):
    if c.t not in DELEGATE:
        return None
    bad = c.i.get("subagent_type") in (None, "", "general-purpose") and "ROLE-EXEMPT:" not in (c.prompt or "")
    return verdict("S4a", True, "use subagent_type researcher/implementer/reviewer/reverser (or ROLE-EXEMPT: <why>)" if bad else "")


def r_s4b(c):
    tg = c.i.get("target")
    m = c.i.get("model") or (tg.get("model") if isinstance(tg, dict) else None)     # delegate_task: tool_input.target.model
    opus = "opus" in str(m or "").lower()
    return verdict("S4b", c.is_delegate and opus, "" if "HW-WRITE" in (c.prompt or "") else "Opus only for hardware-writing/safety work: add HW-WRITE to the brief or drop model")


def r_e6(c):
    p = c.prompt
    miss = [k for k, rx in (("Work alone", r"work alone"), ("ANTIPATTERNS", r"antipatterns"), ("Verif", r"\bverif")) if not re.search(rx, p or "", re.I)]
    return verdict("E6", c.is_delegate and p is not None, f"brief lacks: {', '.join(miss)} (AGENTS.md rule 6)" if miss else "")


def r_e1(c):
    bad = ""
    for p in parses(c.cmd) if c.cmd else []:
        pf = False
        for k, (w, op) in enumerate(p):
            h = head(w)
            if h and h[0] == "set" and any("pipefail" in x for x in h[1]):
                pf = True
            if not h or op != "|" or pf or not (h[0] in CHECKS or (h[0] == "tool-proposals" and "validate" in h[1])):
                continue
            nxt = head(p[k + 1][0]) if k + 1 < len(p) else None
            m = k + 1
            while m < len(p) and p[m][1] == "|":
                m += 1
            if nxt and nxt[0] in PIPE_FILTERS and m < len(p) and p[m][1] == "&&":
                bad = f"`{h[0]} | {nxt[0]} && ...` hides the check's exit code (AP-09/AP-21): use `set -o pipefail` or redirect to a file and test $?"
    appl = any(h[0] in CHECKS or h[0] == "tool-proposals" for h in (head(w) for p in (parses(c.cmd) if c.cmd else []) for w, _ in p) if h)
    return verdict("E1", appl, bad)


def r_e2a(c):
    pk = [a for p, a, _, _ in c.heads if p == "pkill"]
    bad = any(re.fullmatch(r"-[A-Za-z0-9]*f[A-Za-z0-9]*|--full", x) for a in pk for x in a)
    return verdict("E2a", bool(pk), "pkill -f matches other agents' processes (AP-20, AP-36): kill by PID" if bad else "")


def r_e2b(c):
    bad, loops = "", 0
    for p in parses(c.cmd) if c.cmd else []:
        for k, (w, _) in enumerate(p):
            if not ({"while", "until"} & set(w[:2])):
                continue
            loops += 1
            for w2, _ in p[k:]:
                if w2[0] == "do":
                    break
                h = head(w2)
                if any(os.path.basename(x) == "pgrep" for x in w2) or (h and h[0] in ("[", "[[", "test") and "-s" in h[1]):
                    bad = "wait loop on pgrep / file size (AP-01, AP-02): use run_in_background and the completion notification"
    return verdict("E2b", bool(loops), bad)


def r_e3a(c):
    if not re.search(r"\b(adb|fastboot)\b", c.cmd):
        return None
    pg = _phone_guard()
    bad = pg.offending(c.cmd) if pg else None
    return verdict("E3a", True, ("hand-typed `%s`: use the built tools (xrun, probe-run, fboot.sh, fflash-userdata.sh, phone); they hold the phone lock "
                                 "and verify bluejay. Read-only fastboot devices|getvar, adb devices|get-state pass." % bad) if bad else "")


def r_e3b(c):
    blocking = []
    for p, a, wr, _ in c.heads:
        if p in ("adb", "fastboot"):
            sub, j = None, 0
            while j < len(a):
                if a[j] in ("-s", "-t", "-H", "-P", "-p"):
                    j += 2
                elif a[j].startswith("-"):
                    j += 1
                else:
                    sub = a[j]
                    break
            if (p, sub) in (("fastboot", "getvar"), ("adb", "wait-for-device")):
                blocking.append("timeout" in wr)
    return verdict("E3b", bool(blocking), "fastboot getvar / adb wait-for-device block (120 s / forever): run under `timeout N`" if not all(blocking) else "")


def walk(cmd, cwd):
    """(words, dir) for every segment, in order; `cd X` / `pushd X` update dir; dir is None once a target is unknown ($, backtick, `-`,
    after `popd`, or after a `( ... )` / `$( ... )` that changed it) and in every bash -c / eval string when the outer line moves at all."""
    ps = parses(cmd) if cmd else []
    moved = any((h := head(w)) and h[0] in ("cd", "pushd", "popd") for p in ps for w, _ in p)
