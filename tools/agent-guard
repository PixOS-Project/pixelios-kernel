    p = os.path.realpath(c.i.get("file_path") or "")
    if not (os.path.basename(p) in PHONE_TOOLS and os.path.dirname(p) == os.path.realpath(os.path.join(SHARED, "tools"))):
        return None
    try:
        r = subprocess.run([sys.executable, "-B", os.path.join(HERE, "phone-lock"), "status"], capture_output=True, text=True, timeout=5)
