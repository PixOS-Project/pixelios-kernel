def walk(cmd, cwd):
    """(words, dir) for every segment, in order; `cd X` / `pushd X` update dir; dir is None once a target is unknown ($, backtick, `-`,
    after `popd`, or after a `( ... )` / `$( ... )` that changed it) and in every bash -c / eval string when the outer line moves at all."""
    ps = parses(cmd) if cmd else []
    moved = any((h := head(w)) and h[0] in ("cd", "pushd", "popd") for p in ps for w, _ in p)
    for n, p in enumerate(ps):
        cur = None if n and moved else cwd
        for w, op in p:
            h = head(w)
            if h and h[0] in ("cd", "pushd"):
                t = [x for x in h[1] if not x.startswith("-") or x == "-"]
                t = t[0] if t else "~"
                cur = None if cur is None or "$" in t or "`" in t or t == "-" else os.path.normpath(os.path.join(cur, os.path.expanduser(t)))
            elif h and h[0] == "popd":
                cur = None
            yield w, cur
            if ("(" in op or ")" in op or op == "&") and cur != cwd:   # `a & b`: a runs in a background subshell
                cur = None


