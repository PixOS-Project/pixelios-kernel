def self_test():
    fails = []
    tmp = tempfile.mkdtemp(prefix="lintsilent.")

    def tree(name, files, allow=""):
        r = os.path.join(tmp, name)
        os.makedirs(os.path.join(r, "tools"))
        os.makedirs(os.path.join(r, "shim"))
        os.makedirs(os.path.join(r, "xnu", "patches"))
        for p, body in files.items():
            os.makedirs(os.path.dirname(os.path.join(r, p)), exist_ok=True)
            open(os.path.join(r, p), "w").write(body)
        open(os.path.join(r, ALLOW), "w").write(allow)
        return r

    def expect(label, root, rc, want=None):
        import io
        buf = io.StringIO()
        got = report(root, buf)
        if got != rc or (want and want not in buf.getvalue()):
            fails.append("%s: rc=%d want %d %s\n%s" % (label, got, rc, want or "", buf.getvalue()))

    try:
        for k, body in SELF_C_BAD.items():
            expect("c bad " + k, tree("cb-" + k, {"shim/x.c": body}), 1, "shim/x.c:")
        for k, body in SELF_C_GOOD.items():
            expect("c good " + k, tree("cg-" + k, {"shim/x.c": body}), 0)
        expect("py bare except pass", tree("pyb", {"tools/a.py": "try:\n    x()\nexcept:\n    pass\n"}), 1, "PY-EXCEPT tools/a.py:3")
        expect("py return None", tree("pyr", {"tools/a.py": "def f():\n    try:\n        return x()\n    except OSError:\n        return None\n"}), 1, "PY-EXCEPT")
        expect("py logged ok", tree("pyl", {"tools/a.py": "try:\n    x()\nexcept OSError as e:\n    print('X GAP: %s' % e)\n"}), 0)
        expect("py raise ok", tree("pyx", {"tools/a.py": "try:\n    x()\nexcept OSError:\n    raise\n"}), 0)
        expect("sh assignment", tree("sha", {"tools/a.sh": "#!/bin/bash\nn=$(grep -c x f || true)\n"}), 1, "SH-OR-TRUE tools/a.sh:2")
        expect("sh tested", tree("sht", {"tools/a.sh": "#!/bin/bash\nfoo > out.txt || true\n[ -s out.txt ] && echo ok\n"}), 1, "SH-OR-TRUE tools/a.sh:2")
        expect("sh cleanup ok", tree("shc", {"tools/a.sh": "#!/bin/bash\nrm -f x || true\nmkdir -p y || true\nkill $p || true\n"}), 0)
        expect("sh plain ok", tree("shp", {"tools/a.sh": "#!/bin/bash\nfoo || true\necho done\n"}), 0)
        bad = {"shim/x.c": "int g(void)\n{\n\treturn ENOSYS;\n}\n"}
        sg = file_sig(tree("sg", bad), "shim/x.c", scan(os.path.join(tmp, "sg"))[0]["shim/x.c"])
        expect("allowlisted", tree("al", bad, "shim/x.c hits=1 sig=%s stub kept until the driver exists\n" % sg), 0)
        expect("allow grew", tree("alg", {"shim/x.c": bad["shim/x.c"] + "int h(void)\n{\n\treturn ENOTSUP;\n}\n"}, "shim/x.c hits=1 sig=%s stub kept until the driver exists\n" % sg), 1, "ALLOW-GREW")
        expect("allow shrank", tree("als", bad, "shim/x.c hits=2 sig=%s stub kept until the driver exists\n" % sg), 1, "ALLOW-SHRUNK")
        expect("allow stale", tree("alst", {"shim/x.c": "int g(void) { return 0; }\n"}, "shim/x.c hits=1 sig=%s stub kept until the driver exists\n" % sg), 1, "ALLOW-SHRUNK")
        expect("allow swapped", tree("alsw", {"shim/x.c": "int g(void)\n{\n\treturn ENOTSUP;\n}\n"}, "shim/x.c hits=1 sig=%s stub kept until the driver exists\n" % sg), 1, "ALLOW-CHANGED")
        expect("allow no reason", tree("alnr", bad, "shim/x.c hits=1 sig=%s\n" % sg), 1, "ALLOW-NO-REASON")
        expect("allow no sig", tree("alns", bad, "shim/x.c hits=1 stub kept until the driver exists\n"), 1, "ALLOW-NO-SIG")
        expect("allow no pin", tree("alnp", bad, "shim/x.c stub kept until the driver exists\n"), 1, "ALLOW-NO-PIN")
        expect("allow missing file", tree("almf", {}, "shim/gone.c hits=1 sig=%s removed a long time ago\n" % sg), 1, "ALLOW-MISSING-FILE")
        expect("allow duplicate", tree("aldup", bad, "shim/x.c hits=1 sig=%s first reason text\nshim/x.c hits=1 sig=%s second reason text\n" % (sg, sg)), 1, "ALLOW-DUPLICATE")
        r = tree("noallow", {})
        os.remove(os.path.join(r, ALLOW))
        expect("allow file missing", r, 1, "MISSING-ALLOWLIST")
        # patch: only ADDED lines count; a context-only unsupported return is not ours
        patch = ("--- a/IOKit/X.cpp\n+++ b/IOKit/X.cpp\n@@ -10,4 +10,6 @@ IOReturn X::m(int sel)\n {\n \tif (sel == 3)\n \t\treturn kIOReturnUnsupported;\n"
                 "+\tif (sel == 4)\n+\t\treturn kIOReturnUnsupported;\n \treturn 0;\n }\n")
        expect("patch added", tree("pa", {"xnu/patches/0001-x.patch": patch}), 1, "xnu/patches/0001-x.patch:")
        ctx_only = patch.replace("+\tif (sel == 4)\n+\t\treturn kIOReturnUnsupported;\n", "")
        expect("patch context only", tree("pc", {"xnu/patches/0001-x.patch": ctx_only}), 0)
        logged = patch.replace("+\t\treturn kIOReturnUnsupported;\n", "+\t\treturn (printf(\"SWEET GAP: 4\\n\"), kIOReturnUnsupported);\n")
        expect("patch logged", tree("pl", {"xnu/patches/0001-x.patch": logged}), 0)
    finally:
        shutil.rmtree(tmp, ignore_errors=True)
    for f in fails:
        print("FAIL", f)
    print("RESULT: %s self-test failures=%d" % ("FAIL" if fails else "PASS", len(fails)))
    return 1 if fails else 0


def main(argv):
    if argv[:1] == ["--self-test"]:
        return self_test()
    root = os.path.dirname(HERE)
    if argv[:1] == ["--root"] and len(argv) == 2:
        root = argv[1]
    elif argv == ["--sigs"]:
        return print_sigs(root)
    elif argv[:1] == ["--sigs"] and len(argv) == 3 and argv[1] == "--root":
        return print_sigs(argv[2])
    elif argv:
        print("usage: lint-silent [--root DIR | --sigs [--root DIR] | --self-test]", file=sys.stderr)
        return 2
    return report(root)


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
