def cmd_turn(a):
    rec, st, guests = hs.status()
    print('shared session of %s; guests %s; turn holder %s (cap %ss); queue %s' % (rec['owner'], guests or 'none', st.get('holder'), rec.get('turn_max'), [q['name'] for q in st['queue']]))
    print('RESULT: PASS hot turn status')
    return 0


NAV_FLAGS = {0x100: 'capture repetition', 0x200: 'scanout tap', 0x400: 'App-Library-only pass'}


def nav_check(value):
    """kern.sweetnavrun value check (patch 0275 navRestart: reps = low byte 1..5, flags 0x100/0x200/0x400). Returns (int, text) or raises Fail."""
    try:
        v = int(value, 0)
    except ValueError:
        raise Fail('hot nav: %r is not a number' % value)
    reps, flags = v & 0xff, v & ~0xff
    if not 1 <= reps <= 5:
        raise Fail('hot nav: 0x%x has %d repetitions; the kernel refuses anything but 1..5 in the low byte (EINVAL). '
                   'The App-Library-only pass is 0x401, a capture session 0x303' % (v, reps))
    bad = flags & ~sum(NAV_FLAGS)
    if bad:
        raise Fail('hot nav: 0x%x has unknown flag bits 0x%x (known: %s)' % (v, bad, ', '.join('0x%x %s' % kv for kv in NAV_FLAGS.items())))
    return v, '%d rep(s)%s' % (reps, ''.join(' + ' + t for f, t in NAV_FLAGS.items() if v & f))


def dispatch(a, env):
    if a.cmd == 'ping':
        return devsh(env, ['ping'])[0]
    if a.cmd in ('push', 'pull'):
        return devsh(env, [a.cmd, a.src, a.dst])[0]
    if a.cmd == 'run':
        return devsh(env, ['run'] + a.prog)[0]
    if a.cmd == 'signal':
        return devsh(env, ['signal', a.pid, a.signo])[0]
    if a.cmd == 'ps':
        return devsh(env, ['run', PIXPS] + ([a.name[:16]] if a.name else []))[0]
    if a.cmd == 'restart':
        return cmd_restart(a, env)
    if a.cmd == 'nav':   # user 2026-11-11 via the coordinator: the nav value check lives in the tool (alcum1 sent 0x400 and was refused)
        v, what = nav_check(a.value)
        rc, out, err = devsh(env, ['run', '/usr/local/bin/fcapctl', 'nav', '0x%x' % v], capture=True)
        sys.stdout.write(out + err)
        if rc != 0 or 'nav session started' not in out:
            raise Fail('hot nav: kern.sweetnavrun 0x%x (%s) not started (rc %d; needs fcapctl in the overlay; EBUSY = a nav session still runs)' % (v, what, rc))
        print('RESULT: PASS hot nav 0x%x (%s) started; wait for "SWEET NAV: done" in the run\'s usbnet.log' % (v, what))
        return 0
    if a.cmd == 'swap':
        rc = devsh(env, ['push', a.src, a.dst])[0]
        if rc != 0:
            raise Fail('hot swap: push %s -> %s failed (rc %d), nothing restarted' % (a.src, a.dst, rc))
        return cmd_restart(a, env, a.rname or os.path.basename(a.dst))


def main(argv=None):
    ap = argparse.ArgumentParser(description=__doc__.split('\n')[0], formatter_class=argparse.RawDescriptionHelpFormatter, epilog=__doc__)
    ap.add_argument('--owner', help='owner name of your running boot\'s phone lock (else $HOT_OWNER)')
    ap.add_argument('--turn-wait', type=float, default=1800, help='shared session: seconds I wait for my turn (default 1800)')
    sub = ap.add_subparsers(dest='cmd', required=True)
    s = sub.add_parser('stage')
    s.add_argument('--into', required=True)
    s.add_argument('--launchd-base')
    s.add_argument('--drop-job', action='append')
    s.add_argument('--build-dir', default=BUILD_DIR)
    sub.add_parser('ping')
    for c, n in (('push', 2), ('pull', 2)):
        p = sub.add_parser(c)
        p.add_argument('src')
        p.add_argument('dst')
    p = sub.add_parser('run')
    p.add_argument('prog', nargs=argparse.REMAINDER)
    p = sub.add_parser('signal')
    p.add_argument('pid')
    p.add_argument('signo')
    p = sub.add_parser('ps')
    p.add_argument('name', nargs='?')
    p = sub.add_parser('nav')
    p.add_argument('value', help='kern.sweetnavrun: reps 1..5 in the low byte | 0x100 capture | 0x200 tap | 0x400 App-Library-only (e.g. 0x401)')
    p = sub.add_parser('restart')
    p.add_argument('name')
    p.add_argument('--sig', type=int, default=15)
    p = sub.add_parser('swap')
    p.add_argument('src')
    p.add_argument('dst')
    p.add_argument('--restart', dest='rname')
    p.add_argument('--sig', type=int, default=15)
    p = sub.add_parser('join')
    p.add_argument('--kernel', help='your kernel image: must have the same sha256 as the session kernel')
    sub.add_parser('leave')
    p = sub.add_parser('turn')
    p.add_argument('what', choices=('status',))
    for p in sub.choices.values():   # `hot join --owner ME` as well as `hot --owner ME join`
        if p.prog.split()[-1] != 'session':
            p.add_argument('--owner', dest='owner', default=argparse.SUPPRESS)
    se = sub.add_parser('session')
    ssub = se.add_subparsers(dest='scmd', required=True)
    ss = ssub.add_parser('start')
    ss.add_argument('--owner', required=True)
    ss.add_argument('--overlay', required=True)
    ss.add_argument('--kernel', required=True)
    ss.add_argument('--intent')
    ss.add_argument('--max', type=int, default=7200)
    ss.add_argument('--names', help='more sweetnull names (comma separated) for your programs\' stdout in the USB log')
    ss.add_argument('--args', help='more boot-args')
    ss.add_argument('--launchd-base', help='as hot stage --launchd-base (a tree without its own launchd.plist)')
    ss.add_argument('--compress', action='store_true')
    ss.add_argument('--camera', action='store_true', help='keep the ESP camera capture (default off in a session)')
    ss.add_argument('--shared', action='store_true', help='let other owners join as guests on the same kernel (hot join); iterations take turns')
    ss.add_argument('--turn-max', type=int, default=hs.DEFAULT_TURN_MAX, help='shared: per-turn cap in seconds (default 600)')
    for n in ('end', 'status'):
        x = ssub.add_parser(n)
        x.add_argument('--owner', required=True)
        if n == 'end':
            x.add_argument('--reason')
    a = ap.parse_args(argv)
    try:
        if a.cmd == 'stage':
            return cmd_stage(a)
        if a.cmd == 'session':
            return cmd_session(a)
        if a.cmd == 'join':
            return cmd_join(a)
        if a.cmd == 'leave':
            return cmd_leave(a)
        if a.cmd == 'turn':
            return cmd_turn(a)
        if a.cmd in ('push', 'swap'):
            check_push_dst(a.dst)
        if a.cmd == 'nav':
            nav_check(a.value)   # refuse a bad value before any phone step
        env = devsh_env(a, need_lock=a.cmd != 'ping')
        owner = a.owner or os.environ.get('HOT_OWNER')
        if a.cmd == 'ping' or not (owner and hs.active_or_none()):
            return dispatch(a, env)
        rl = hs.role(owner)
        with hs.turn(owner, a.turn_wait):
            hs.note_push(owner, rl, a.cmd, [getattr(a, k) for k in ('src', 'dst', 'name', 'pid', 'signo') if getattr(a, k, None)] + (getattr(a, 'prog', None) or []))
            return dispatch(a, env)
    except Fail as e:
        print('RESULT: FAIL ' + str(e))
        return 1
    except hs.Refused as e:
        print('RESULT: FAIL hot: ' + str(e))
        return 1
    except (Err, OSError, plistlib.InvalidFileException, ValueError) as e:
        print('RESULT: ERROR ' + str(e))
        return 2


if __name__ == '__main__':
    sys.exit(main())
