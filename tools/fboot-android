#!/bin/bash
# RAM-boot the pinned Magisk-patched stock boot image on the Pixel 6a for the golden-trace session (TP-035, docs/research/85 s.2, s.6 steps 2-4).
#   tools/fboot-android [--build cp3a|bp31] [--image IMG | --unattended [--image IMG]] [--cmdline STR] [--slot-ok X] [--erase-userdata --yes-erase-userdata] [--dry-run] [--identity-only]
#   --build (default cp3a = today's behaviour): picks the PIN. cp3a = PIN (the cp3a Magisk image); bp31 = PIN_BP31, the Magisk-patched BP31 OTA boot (golden-pull magisk-patch
#   with GOLDEN_MAGISK_IN), default image ~/pixelios-factory/magisk_patched-bp31-<PIN8>.img; a PIN_BP31 that is not a sha256 FAILs loudly (also with --dry-run). --dry-run prints build + PIN.
#   --unattended (TP-037): boot the derived image (default: ~/pixelios-factory/golden-unattended-<PIN8>-<sha8 of the CURRENT ~/.android/adbkey.pub>.img) instead of the pinned one; before ANY fastboot call
#   `tools/golden-unattended-image verify IMG` (current host key, rebuild compare) must PASS and its manifest base sha256 must equal PIN; the booted private copy must equal the verified image sha256. No sha override option.
#   --identity-only: getvar identity + slot check, append to getvar-before.txt, then exit before any erase/boot (research 85 step 14)
# Refuses: no phone lock (TP-020), product != bluejay, unlocked != yes, current-slot != b (unless --slot-ok names the observed slot),
# an image whose sha256 differs from the pinned one (no override option), anything but exactly one fastboot device. Writes only `userdata` (`fastboot erase userdata`, both flags needed); never `-w`
# (it also erases metadata+cache, AP-116), never any other partition. After the erase it appends `erased <UTC> fboot-android` to ${FLASH_STATE:-~/pixelios-artifacts/flashed-userdata.txt}
# (tools/xrun then refuses XNU until tools/fflash-userdata.sh re-flashes the iOS root; a failed write is a FBOOT GAP line + gaps=1 on RESULT). Ends with RESULT: PASS|FAIL|ERROR (exit 0/1/2).
# T-7dff:help: -h/--help prints this header and exits 0 before anything runs
case "${1:-}" in -h|--help) printf 'usage: %s\n' "${0##*/}"; sed -n '2,/^[^#]/{/^#/s/^# \{0,1\}//p}' "$0"; exit 0;; esac
set -uo pipefail
cd "$(dirname "$0")/.." || exit 2
PIN=98cbf66be30e4d24eaba123764cc24d9d3b278edd99626a0eef36ff63e207bf0   # ~/pixelios-factory/magisk_patched-30700_vxeG1.img
PIN_BP31=eba6a2a1078199fb37a3ea95a56051dbfc8ea5e99a20b6576f838d3d522a4134   # ~/pixelios-factory/magisk_patched-bp31-eba6a2a1.img = golden-pull magisk-patch of the OTA boot.img a18afa36 [obs golden-bp31-a 20261029T074041Z-b2 row A5; host A6: cfg = 30700's, SHA1 = sha1(OTA boot), kernel bytes equal]
img=$HOME/pixelios-factory/magisk_patched-30700_vxeG1.img
build=cp3a
cmdline="trace_event=rwmmio:rwmmio_write,rwmmio:rwmmio_post_read trace_buf_size=64M trace_clock=global trace_options=nooverwrite"  # research 85 s.6 step 4
slot_ok=b; erase=0; yes=0; dry=0; idonly=0; unatt=0; imgset=0
need() { [ "$1" -ge 2 ] || { echo "RESULT: ERROR $2 needs a value"; exit 2; }; }
while [ $# -gt 0 ]; do case "$1" in
	--build) need $# "$1"; build=$2; shift 2 ;;
	--image) need $# "$1"; img=$2; imgset=1; shift 2 ;; --unattended) unatt=1; shift ;; --cmdline) need $# "$1"; cmdline=$2; shift 2 ;;
	--slot-ok) need $# "$1"; slot_ok=$2; shift 2 ;; --erase-userdata) erase=1; shift ;; --yes-erase-userdata) yes=1; shift ;;
	--dry-run) dry=1; shift ;; --identity-only) idonly=1; shift ;; *) echo "RESULT: ERROR unknown argument '$1'"; exit 2 ;; esac; done
fail() { echo "REFUSED: $1" >&2; echo "RESULT: FAIL $1"; exit 1; }
case "$build" in
	cp3a) ;;
	bp31) [[ "$PIN_BP31" =~ ^[0-9a-f]{64}$ ]] || fail "bp31 PIN not set: run golden-pull magisk-patch with GOLDEN_MAGISK_IN first, then pin the patched image as PIN_BP31 in tools/fboot-android"
		PIN=$PIN_BP31; [ "$imgset" = 1 ] || img=$HOME/pixelios-factory/magisk_patched-bp31-${PIN_BP31:0:8}.img ;;
	*) echo "RESULT: ERROR unknown --build '$build' (cp3a|bp31)"; exit 2 ;;
esac
if [ "$unatt" = 1 ] && [ "$imgset" = 0 ]; then   # derived image for the CURRENT host key (TP-037 F2); verified below before any fastboot call
	if [ -s "$HOME/.android/adbkey.pub" ]; then
		img=$HOME/pixelios-factory/golden-unattended-${PIN:0:8}-$(sha256sum < "$HOME/.android/adbkey.pub" | cut -c1-8).img
	elif [ "$dry" = 1 ]; then img="<golden-unattended-PIN8-KEY8.img>"
	else fail "--unattended: ~/.android/adbkey.pub is missing or empty"; fi
fi
[ "$erase" = 0 ] || [ "$yes" = 1 ] || fail "--erase-userdata erases userdata; pass --yes-erase-userdata after the user confirmed"
[ "$yes" = 0 ] || [ "$erase" = 1 ] || fail "--yes-erase-userdata without --erase-userdata"
[ "$idonly" = 0 ] || [ "$erase" = 0 ] || fail "--identity-only never erases: drop --erase-userdata"
[[ "$cmdline" =~ ^[A-Za-z0-9_:,.=\ -]*$ ]] || { echo "RESULT: ERROR --cmdline has a character outside [A-Za-z0-9_:,.= -] (newlines/quotes would bypass the token check)"; exit 2; }
read -ra toks <<< "$cmdline"
for t in "${toks[@]}"; do [[ "$t" =~ ^(trace_event|trace_buf_size|trace_clock|trace_options|tp_printk|ftrace_dump_on_oops)(=[A-Za-z0-9_:,.=-]*)?$ ]] || { echo "RESULT: ERROR --cmdline token '$t' not allowed"; exit 2; }; done
[[ "$slot_ok" =~ ^[ab]$ ]] || { echo "RESULT: ERROR bad --slot-ok"; exit 2; }
if [ "$dry" = 1 ]; then
	echo "DRY-RUN (no fastboot call is made; phone-lock and image checks skipped)"
	echo "build=$build PIN=$PIN"
	echo "would run: fastboot devices (exactly one required; later calls use -s SERIAL)"
	for v in product unlocked current-slot version-bootloader slot-successful:b; do echo "would run: fastboot getvar $v"; done
	if [ "$unatt" = 1 ]; then echo "would run FIRST: tools/golden-unattended-image verify $img --build $build (must PASS; manifest base sha256 = PIN $PIN); the private copy must equal the verified image sha256"
	echo "would check: product=bluejay unlocked=yes current-slot=$slot_ok"
	else echo "would check: sha256($img) = $PIN; product=bluejay unlocked=yes current-slot=$slot_ok"; fi
	[ "$erase" = 0 ] || echo "would run: fastboot -s SERIAL erase userdata"
	echo "would run: fastboot -s SERIAL boot --cmdline \"$cmdline\" <private copy of $img>"
	echo "RESULT: PASS dry-run"; exit 0
fi
[ -f "$img" ] || fail "image not found: $img"
tmp=$(mktemp -d) || { echo "RESULT: ERROR mktemp -d failed"; exit 2; }; trap 'rm -rf "$tmp"' EXIT
case "$tmp" in /*) ;; *) echo "RESULT: ERROR temp dir '$tmp' is not absolute (TMPDIR)"; exit 2 ;; esac
cp -- "$img" "$tmp/boot.img" || fail "copy of the image failed"
got=$(sha256sum "$tmp/boot.img" | cut -d' ' -f1)
if [ "$unatt" = 1 ]; then   # TP-037: the derived image must verify (rebuild from the manifest inputs) and descend from PIN; the copy we boot must be the verified bytes
	vout=$(tools/golden-unattended-image verify "$img" --build "$build" 2>&1) || fail "--unattended: golden-unattended-image verify did not PASS (refusing before any fastboot call)"
	vsha=$(printf '%s\n' "$vout" | sed -n 's/^image_sha256=//p' | head -1)
	msha=$(python3 -I -c 'import json,sys; print(json.load(open(sys.argv[1]))["base_sha256"])' "$img.manifest.json" 2>/dev/null)
	[ "$(tail -c 64 "$tmp/boot.img" | head -c 4)" = AVBf ] || fail "--unattended: the image copy has no AVB footer (ABL would not run it)"
	[ "$msha" = "$PIN" ] || fail "--unattended: manifest base sha256 '$msha' is not the pinned $PIN"
	[ -n "$vsha" ] && [ "$got" = "$vsha" ] || fail "--unattended: image copy sha256 $got is not the verified one"
else
	[ "$got" = "$PIN" ] || fail "image sha256 $got is not the pinned $PIN"
fi
tools/phone-lock check >&2 || fail "the phone lock is not held by you (tools/phone-lock run --owner NAME -- CMD)"
# Column 2 is not reliable: fastboot 34.0.5-debian prints "SERIAL<TAB> <DEL>" for a bluejay in fastboot [obs 2026-10-27, golden-1 row 1].
# Count every non-empty row (r1 F1: a filter can undercount), then the one serial must be alphanumeric (a no-permissions row shows ????????????);
# bluejay is proven by getvar below.
mapfile -t devs < <(timeout 15 fastboot devices | awk 'NF {print $1}')
[ "${#devs[@]}" = 1 ] || fail "need exactly one fastboot device, found ${#devs[@]}"
sn=${devs[0]}   # never echoed
[[ "$sn" =~ ^[0-9A-Za-z]+$ ]] || fail "the fastboot device row has no usable serial (no permissions?)"
gv() { timeout 15 fastboot -s "$sn" getvar "$1" 2>&1 | sed -n "s/^$1: *//p" | head -1; }
prod=$(gv product); unl=$(gv unlocked); slot=$(gv current-slot); bl=$(gv version-bootloader); sok=$(gv slot-successful:b)
[ "$prod" = bluejay ] || fail "device product is '$prod', not bluejay"
[ "$unl" = yes ] || fail "bootloader unlocked='$unl', not yes"
[ "$(gv is-userspace)" = no ] || fail "device is not in the bootloader (is-userspace != no; fastbootd?)"   # 'is-userspace: no' on bluejay ABL [obs 2026-10-27]
echo "identity: product=$prod unlocked=$unl current-slot=$slot version-bootloader=$bl slot-successful:b=$sok"
mkdir -p "$HOME/pixelios-artifacts/golden" && echo "$(date -u +%FT%TZ) product=$prod unlocked=$unl current-slot=$slot version-bootloader=$bl slot-successful:b=$sok" >> "$HOME/pixelios-artifacts/golden/getvar-before.txt" || fail "cannot write ~/pixelios-artifacts/golden/getvar-before.txt"
[ "$slot" = "$slot_ok" ] || fail "current-slot is '$slot', expected '$slot_ok' (re-run with --slot-ok $slot only after the user agreed)"
[ "$idonly" = 0 ] || { echo "RESULT: PASS identity-only product=$prod current-slot=$slot (no erase, no boot)"; exit 0; }
gap=""
if [ "$erase" = 1 ]; then
	timeout 120 fastboot -s "$sn" erase userdata; erc=$?
	# AP-179: mark the userdata as Android/erased (same state file as tools/fflash-userdata.sh) so tools/xrun refuses XNU until the iOS root is re-flashed.
	# Written after a failed erase too: a partial erase is not an iOS root either.
	state=${FLASH_STATE:-${ARTIFACTS:-$HOME/pixelios-artifacts}/flashed-userdata.txt}
	echo "erased $(date -u +%FT%TZ) fboot-android" >> "$state" || { gap=" gaps=1 ERASE MARKER NOT WRITTEN to $state (tools/xrun will not see the Android userdata)"; echo "FBOOT GAP: erase marker not written to $state: tools/xrun will not refuse XNU on this Android userdata" >&2; }
	[ "$erc" = 0 ] || { echo "RESULT: ERROR fastboot erase userdata failed$gap"; exit 2; }
fi
timeout 300 fastboot -s "$sn" boot --cmdline "$cmdline" "$tmp/boot.img" || { echo "RESULT: ERROR fastboot boot failed (erased_userdata=$erase: restore per research 85 step 15)$gap"; exit 2; }
echo "RESULT: PASS booted $(basename "$img") slot=$slot bootloader=$bl erased_userdata=$erase$gap"
