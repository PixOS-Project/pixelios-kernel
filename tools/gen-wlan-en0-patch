#!/usr/bin/env python3
"""gen-wlan-en0-patch: regenerates xnu/patches/0199-sweet-wlan-en0-ifnet.patch from the host-tested shim sources (wlan_en0.h, sweet_wlan_data*.h, glue); called by hand when those change and by shim/build.sh --check

Maps (T-4d29; the patch and shim/ cannot drift because shim/build.sh runs --check):
  bsd/dev/sweet_wlan_en0.h       = shim/wlan_en0.h             byte for byte
  bsd/dev/sweet_wlan_data.h      = shim/sweet_wlan_data.h      one line swapped: <stdio.h> -> <sys/systm.h> (the kernel has no stdio.h)
  bsd/dev/sweet_wlan_data_plan.h = shim/sweet_wlan_data_plan.h byte for byte
  bsd/dev/sweet_wlan_en0.c       = shim/wlan_en0_glue.c.in     byte for byte
  bsd/conf/files                 + one line

  tools/gen-wlan-en0-patch [--out FILE]   write the patch (default xnu/patches/0199-sweet-wlan-en0-ifnet.patch)
  tools/gen-wlan-en0-patch --check        exit 1 when the patch on disk differs from what would be written
  tools/gen-wlan-en0-patch --self-test    inline checks (also run by tools/test_gen_wlan_en0_patch.py)
Last line: RESULT: PASS|FAIL gen-wlan-en0-patch ..."""
if __import__("sys").argv[1:2] in (["-h"], ["--help"]):  # T-7dff:help: usage before any import or side effect
    print("usage: " + __file__.rsplit("/", 1)[-1] + "\n" + (__doc__ or "".join(l[2:] for l in open(__file__).readlines()[1:60] if l.startswith("# "))).strip()); raise SystemExit(0)
import hashlib
import os
import sys

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
OUT = os.path.join(ROOT, "xnu", "patches", "0199-sweet-wlan-en0-ifnet.patch")
STDIO = "#include <stdio.h>\n"
SYSTM = "#include <sys/systm.h>   /* snprintf: the kernel has no <stdio.h> (shim/ host builds include it) */\n"

FILES = [
    ("bsd/dev/sweet_wlan_en0.h", "shim/wlan_en0.h", False),
    ("bsd/dev/sweet_wlan_data.h", "shim/sweet_wlan_data.h", True),
    ("bsd/dev/sweet_wlan_data_plan.h", "shim/sweet_wlan_data_plan.h", False),
    ("bsd/dev/sweet_wlan_en0.c", "shim/wlan_en0_glue.c.in", False),
]

MSG = """XNU en0 ifnet in poll mode over the reviewed Wi-Fi data path (P-W3, T-4d29; SPEC-WIFI Part E EN0 block, rows EN1-EN12).

Cause: patch 0073's ue0 ifnet is a USB ECM pattern: LEGACY without NX_NOAUTO, RX without the 2-byte pad, no BPF attach or taps, no link event, a silent
EOPNOTSUPP in ioctl, and a static address hard-coded in the patch (rule 4, rule 8). Wi-Fi needs the same ifnet with the E-1..E-7 rules of SPEC-WIFI.
Fix: new bsd/dev/sweet_wlan_en0.h (the logic: ifnet_allocate_extended with IFNET_INIT_LEGACY|IFNET_INIT_NX_NOAUTO, attach, lladdr after attach from the caller,
bpf_attach + taps, RX mbuf chain with pad and per-buffer lengths, pkt_hdr handoff, TX output -> swdp_build_txpost + swdp_plan_tx + swdp_audit, a poll function
that reads the D2H write index and reposts rx buffers, no interrupt registration, link events through ifnet_event, SIOCGIFMEDIA, ioctl GAP lines, the static
address only from boot-arg pixos_en0_ip), the two data-path headers it uses (verbatim copies of shim/sweet_wlan_data.h and sweet_wlan_data_plan.h, the
reviewed layouts of T-71e2, with the one <stdio.h> line swapped for <sys/systm.h>), and bsd/dev/sweet_wlan_en0.c (glue: KPI headers, if_xflags, the SIOCAIFADDR
socket, the unwired DP15 bus whose exec() refuses). Generated by tools/gen-wlan-en0-patch from shim/; shim/build.sh refuses a stale copy.
Tests: shim/wlan_en0_host_test.c (stub ifnet/mbuf/bpf, fake bus) with one mutant per rule in tools/test_wlan_en0_mutants.py. Not compiled against XNU here
(CI builds the tree), not run on hardware; nothing calls sweet_wlan_en0_init() yet (T-4505 wires it). The msgbuf transport (DP15) is not wired.
"""

TAB = "\t"
CTX_BEFORE = ["bsd/dev/sweet_surfcpu.c" + TAB * 2 + "standard", "bsd/dev/sweet_cpustat.c" + TAB * 3 + "standard", "bsd/dev/sweet_el2.c" + TAB * 3 + "standard"]
CTX_AFTER = ["bsd/dev/sweet_spmi.c" + TAB * 3 + "standard", "bsd/dev/sweet_usb.c" + TAB * 3 + "standard", "bsd/dev/sweet_usbroot.c" + TAB * 2 + "standard"]
ADD_LINE = "bsd/dev/sweet_wlan_en0.c" + TAB * 3 + "standard"


def blob_id(data):
    h = hashlib.sha1(b"blob %d\0" % len(data))
    h.update(data)
    return h.hexdigest()[:7]


def source(path, swap):
    with open(os.path.join(ROOT, path), "r", encoding="utf-8") as fh:
        text = fh.read()
    if swap:
        if text.count(STDIO) != 1:
            raise SystemExit("%s: expected exactly one %r" % (path, STDIO.strip()))
        text = text.replace(STDIO, SYSTM)
    return text


def new_file_hunk(dest, text):
    data = text.encode("utf-8")
    lines = text.split("\n")
    if lines[-1] == "":
        lines.pop()
    out = ["diff --git a/%s b/%s" % (dest, dest), "new file mode 100644", "index 0000000..%s" % blob_id(data),
           "--- /dev/null", "+++ b/%s" % dest, "@@ -0,0 +1,%d @@" % len(lines)]
    out.extend("+" + ln for ln in lines)
    return "\n".join(out) + "\n"


def build():
    parts = [MSG, "\n"]
    parts.append("diff --git a/bsd/conf/files b/bsd/conf/files\n--- a/bsd/conf/files\n+++ b/bsd/conf/files\n@@ -116,6 +116,7 @@ bsd/dev/sweet_thrcpu.c\t\t\tstandard\n")
    parts.extend(" " + ln + "\n" for ln in CTX_BEFORE)
    parts.append("+" + ADD_LINE + "\n")
    parts.extend(" " + ln + "\n" for ln in CTX_AFTER)
    for dest, src, swap in FILES:
        parts.append(new_file_hunk(dest, source(src, swap)))
    return "".join(parts)


def self_test():
    sample = "line one\n\tline two\n"
    hunk = new_file_hunk("bsd/dev/x.h", sample)
    body = [ln[1:] for ln in hunk.split("\n") if ln.startswith("+") and not ln.startswith("+++")]
    ok = body == ["line one", "\tline two"] and "@@ -0,0 +1,2 @@" in hunk and hunk.startswith("diff --git a/bsd/dev/x.h b/bsd/dev/x.h\n")
    ok = ok and blob_id(b"") == "e69de29"                      # git's empty blob
    ok = ok and len(CTX_BEFORE) == 3 and len(CTX_AFTER) == 3    # hunk header says -116,6 +116,7
    print("RESULT: %s gen-wlan-en0-patch self-test" % ("PASS" if ok else "FAIL"))
    return 0 if ok else 1


def main(argv):
    if "--self-test" in argv:
        return self_test()
    out = argv[argv.index("--out") + 1] if "--out" in argv else OUT
    text = build()
    if "--check" in argv:
        try:
            with open(out, "r", encoding="utf-8") as fh:
                same = fh.read() == text
        except OSError as e:
            print("GAP: gen-wlan-en0-patch --check cannot read %s: %s" % (out, e), file=sys.stderr)
            same = False
        print("RESULT: %s gen-wlan-en0-patch --check %s" % ("PASS" if same else "FAIL (stale: run tools/gen-wlan-en0-patch)", os.path.basename(out)))
        return 0 if same else 1
    with open(out, "w", encoding="utf-8") as fh:
        fh.write(text)
    print("RESULT: PASS gen-wlan-en0-patch wrote %s (%d bytes)" % (os.path.basename(out), len(text)))
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
