#!/usr/bin/env python3
"""tools/job-wake HOOK JOB RC: wake the owner thread when a background job ended (R4, T-afd9; docs/recipes/local-webhook.md).
Called by `tools/heavy-job detach --wake-hook HOOK` and `tools/remote-job --wake-hook HOOK` after the job's end marker; it does ONE POST through the
shared sender tools/wake (T-76a1) with the event `job <JOB> rc=<RC>` (label and rc only, no log text, no paths).
  HOOK  label of a hook file ~/.t3/scratch_sec/HOOK.hook (the secret `<task id>/<token>` never reaches argv, stdout or logs)
  JOB   job label (plain: letters, digits, . _ -);  RC  the job's exit code (integer)
Output (stdout, so it lands in the job log; the job's own result is NOT changed by it, rule 8):
  `WAKE ok: hook=H job=J rc=N`
  `WAKE FAIL: <code> hook=H job=J (<why>)`   code = http status (404 task gone/bad token, 409 disabled, 429 rate limit), `refused`, `noanswer`, `off` (no hook file), `tool-missing`, `usage`
Exit 0 woken, 1 WAKE FAIL. tools/wake: env JOB_WAKE_TOOL, else <super repo>/tools/wake found through the kernel repo's git common dir.
`--self-test` runs a stub server and prints `RESULT: PASS job-wake N/N` (needs the super repo's tools/wake)."""
if __import__("sys").argv[1:2] in (["-h"], ["--help"]):  # T-7dff:help: usage before any import or side effect
    print("usage: " + __file__.rsplit("/", 1)[-1] + "\n" + (__doc__ or "".join(l[2:] for l in open(__file__).readlines()[1:60] if l.startswith("# "))).strip()); raise SystemExit(0)
import http.server, json, os, pathlib, re, subprocess, sys, tempfile, threading

LABEL = re.compile(r"^[A-Za-z0-9._-]{1,64}$")


def wake_tool():
    p = os.environ.get("JOB_WAKE_TOOL")
    if p:
        return p if os.path.isfile(p) else None
    here = os.path.dirname(os.path.abspath(__file__))
    try:
        c = subprocess.run(["git", "-C", here, "rev-parse", "--path-format=absolute", "--git-common-dir"], capture_output=True, text=True, timeout=10).stdout.strip()
    except (OSError, subprocess.SubprocessError):   # lint-silent: expected git absent or not a repo: no wake script, the job just ends without a wake
        return None
    p = os.path.join(os.path.dirname(os.path.dirname(os.path.dirname(c))), "tools", "wake") if c else ""
    return p if os.path.isfile(p) else None


def job_wake(hook, job, rc):
    if not (LABEL.match(hook or "") and LABEL.match(job or "") and re.fullmatch(r"[0-9]{1,3}", str(rc))):
        print("WAKE FAIL: usage hook=%s job=%s (HOOK and JOB are plain labels, RC an integer)" % (str(hook)[:40], str(job)[:40])); return 1
    tool = wake_tool()
    if not tool:
        print("WAKE FAIL: tool-missing hook=%s job=%s (tools/wake not found; set JOB_WAKE_TOOL)" % (hook, job)); return 1
    event = "job %s rc=%s" % (job, rc)
    try:
        r = subprocess.run([sys.executable, "-I", tool, hook, "--event", event, "--id", job], capture_output=True, text=True, timeout=30)
        code, err = r.returncode, (r.stderr or "").strip().splitlines()
    except (OSError, subprocess.SubprocessError) as e:
        code, err = 1, ["%s: %s" % (type(e).__name__, e)]
    if code == 0:
        print("WAKE ok: hook=%s job=%s rc=%s" % (hook, job, rc)); return 0
    why = " ".join(err[-1:]) if err else "no output"
    m = re.search(r"http (\d+)", why)
    c = m.group(1) if m else ("off" if "WAKE OFF" in why else "refused" if "ConnectionRefused" in why else "noanswer")
    print("WAKE FAIL: %s hook=%s job=%s (%s)" % (c, hook, job, why[:160])); return 1


def self_test():
    seen = []

    class H(http.server.BaseHTTPRequestHandler):
        def do_POST(self):
            n = int(self.headers.get("content-length") or 0); seen.append((self.path, json.loads(self.rfile.read(n) or b"{}")))
            mode = self.path.split("/")[3].split("%3A")[-1]
            self.send_response({"ok": 202, "gone": 404, "off": 409}.get(mode, 500)); self.end_headers(); self.wfile.write(b"{}")
        def log_message(self, *a): pass

    srv = http.server.ThreadingHTTPServer(("127.0.0.1", 0), H); threading.Thread(target=srv.serve_forever, daemon=True).start()
    tool = wake_tool(); n = bad = 0
    def ok(name, cond, extra=""):
        nonlocal n, bad
        n += 1
        if not cond: bad += 1
        print("%s %s%s" % ("ok  " if cond else "FAIL", name, "" if cond else " :: " + extra))
    if not tool:
        print("RESULT: FAIL job-wake self-test: tools/wake not found (set JOB_WAKE_TOOL)"); return 1
    with tempfile.TemporaryDirectory() as d:
        env = {"WAKE_BASE": "http://127.0.0.1:%d" % srv.server_address[1], "WAKE_SECRETS_DIR": d, "WAKE_LOG": os.path.join(d, "wake.log"), "JOB_WAKE_TOOL": tool}
        for mode in ("ok", "gone", "off"):
            p = pathlib.Path(d, "h-%s.hook" % mode); p.write_text("scheduled-task%%3A%s/tok%s\n" % (mode, "A" * 40)); p.chmod(0o600)
        def run(args, extra_env=None):
            e = dict(os.environ, **env); e.update(extra_env or {})
            return subprocess.run([sys.executable, "-I", os.path.abspath(__file__)] + args, capture_output=True, text=True, env=e)
        r = run(["h-ok", "build-1", "0"])
        ok("202: exit 0, one POST, event 'job build-1 rc=0'", r.returncode == 0 and "WAKE ok: hook=h-ok job=build-1 rc=0" in r.stdout and len(seen) == 1 and seen[0][1].get("event") == "job build-1 rc=0", r.stdout + str(seen))
        ok("payload carries label and rc only (event/id/from keys); the token is not printed", set(seen[0][1]) <= {"event", "id", "from"} and "tok" not in r.stdout + r.stderr, str(seen[0]) + r.stdout)
        r = run(["h-ok", "gate-x", "7"])
        ok("rc=7 is carried in the event, still exactly one more POST", len(seen) == 2 and seen[1][1].get("event") == "job gate-x rc=7", str(seen))
        r = run(["h-gone", "j", "1"])
        ok("404: 'WAKE FAIL: 404 hook=h-gone', exit 1", r.returncode == 1 and "WAKE FAIL: 404 hook=h-gone job=j" in r.stdout, r.stdout)
        r = run(["h-off", "j", "1"])
        ok("409: 'WAKE FAIL: 409 hook=h-off', exit 1", r.returncode == 1 and "WAKE FAIL: 409 hook=h-off job=j" in r.stdout, r.stdout)
        r = run(["h-ok", "j", "1"], {"WAKE_BASE": "http://127.0.0.1:1"})
        ok("connection refused: 'WAKE FAIL: refused hook=h-ok', exit 1", r.returncode == 1 and "WAKE FAIL: refused hook=h-ok job=j" in r.stdout, r.stdout)
        r = run(["nohook", "j", "1"])
        ok("no hook file: 'WAKE FAIL: off hook=nohook', exit 1", r.returncode == 1 and "WAKE FAIL: off hook=nohook job=j" in r.stdout, r.stdout)
        before = len(seen)
        r = run(["h-ok", "j", "x1"])
        ok("bad rc / bad label: usage FAIL, no POST", r.returncode == 1 and "WAKE FAIL: usage" in r.stdout and len(seen) == before, r.stdout)
        r = run(["h-ok", "j", "1"], {"JOB_WAKE_TOOL": os.path.join(d, "missing")})
        ok("tools/wake missing: 'WAKE FAIL: tool-missing', exit 1", r.returncode == 1 and "WAKE FAIL: tool-missing" in r.stdout, r.stdout)
    srv.shutdown()
    print("RESULT: %s job-wake %d/%d" % ("PASS" if not bad else "FAIL", n - bad, n)); return 1 if bad else 0


if __name__ == "__main__":
    if sys.argv[1:] == ["--self-test"]: sys.exit(self_test())
    if len(sys.argv) != 4:
        print("WAKE FAIL: usage (tools/job-wake HOOK JOB RC)"); sys.exit(1)
    sys.exit(job_wake(*sys.argv[1:]))
