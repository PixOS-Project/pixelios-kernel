	menv=$("$ROOT/tools/xnu-src-mirror" env --stack "$stack" --dir "$A/git-mirror" 2>"$merr") || menv=""
	cat "$merr" >>"$LOG"; mnames=$(sed -n 's/^xnu-src-mirror: NOT mirrored: \([^ ]*\) .*/\1/p' "$merr" | tr '\n' ' '); mn=$(sed -n 's/^RESULT: PASS mirrored=\([0-9]*\) of \([0-9]*\) .*/\1 of \2/p' "$merr"); rm -f "$merr"
