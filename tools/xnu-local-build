#!/bin/bash
# Build the patched XNU kernel on this Linux box (no Mac, no Xcode) the way CI (.github/workflows/xnu.yml -> blacktop
# darwin-xnu-build) does, and compare it with a CI kernel. ONE report ending RESULT: PASS|FAIL|ERROR.
#   tools/xnu-local-build [--stack DIR] [--label NAME] [--jobs N] [--timeout SEC] [--fresh] [--deps-only] [--make-args STR]
#                         [--compare KERNEL]
#   --stack DIR      directory holding the *.sh stagers and *.patch files (default: <repo>/xnu/patches)
#   --label NAME     work tree name under $LOCALBUILD/work (default: main). A changed stack is synced into the same tree, so only the
#                    files whose patched content changed are rebuilt; a different label is a separate tree.
#   --jobs N         make -jN (default 4, capped at 4: the dev machine runs out of memory)
#   --make-args STR  extra arguments for the final make (debugging, e.g. "-d" or "-n")
#   --timeout SEC    kill the whole run after SEC seconds (default 3600)
#   --fresh          delete the work dir first (cold build)
#   --deps-only      only fetch/build the host toolchain and dependencies, no kernel
#   --compare KERNEL a CI kernel to compare with (default none): size, sha256, external and SWEET symbol sets, section sizes
# Output kernel: $LOCALBUILD/out/kernel.development.sweet (also left in the work tree under fakeroot/System/Library/Kernels).
# Everything big lives in $LOCALBUILD (default ~/pixelios-artifacts/localbuild), never in git or /tmp. No sudo: flex and
# bison, if missing, are unpacked from the Debian .deb files into $LOCALBUILD/hostroot (apt-get download + dpkg -x).
# Method (ideas from hackios-xnu-kernel/xnu-deps, own code): stock clang as a Mach-O cross compiler (-target
# arm64-apple-macos14.0), theos cctools (ld64, libtool, nm, otool, strip), MacOSX14.0.sdk, a fake xcrun, mig/unifdef/csh built
# from source, Apple's closed iig replaced by pre-generated DriverKit headers from the SDK plus generated stubs.
# Progress: ~/pixelios-artifacts/scratch/xnu-local-build.log. Exit: 0 PASS, 1 FAIL, 2 ERROR.
set -euo pipefail
ARGS=("$@"); SELF=$(readlink -f "$0"); cd "$(dirname "$SELF")/.."
ROOT=$PWD
A=${ARTIFACTS:-$HOME/pixelios-artifacts}
LB=${LOCALBUILD:-$A/localbuild}
TAG=xnu-8796.141.3
stack=$ROOT/xnu/patches; label=""; makeargs=""; jobs=4; tmo=3600; fresh=0; depsonly=0; compare=""
while [ $# -gt 0 ]; do case "$1" in
	--stack) stack=$(cd "$2" && pwd); shift 2 ;; --label) label=$2; shift 2 ;;
	--jobs) jobs=$2; shift 2 ;; --make-args) makeargs=$2; shift 2 ;; --timeout) tmo=$2; shift 2 ;; --fresh) fresh=1; shift ;;
	--deps-only) depsonly=1; shift ;; --compare) compare=$2; shift 2 ;;
	*) echo "unknown option $1 (see the header of tools/xnu-local-build)" >&2; exit 2 ;; esac; done
[ "$jobs" -le 4 ] 2>/dev/null || jobs=4
mkdir -p "$A/scratch" "$LB"; LOG=$A/scratch/xnu-local-build.log; : >"$LOG"
START=$(date +%s)
finish() { local res=$1; shift; { echo "RESULT: $res $1"; shift; [ $# -eq 0 ] || printf '%s\n' "$@"; echo "log: $LOG"; }; case $res in PASS) exit 0 ;; ERROR) exit 2 ;; *) exit 1 ;; esac; }
say() { echo "[$(( $(date +%s) - START ))s] $*" | tee -a "$LOG" >&2; }
# the whole run is bounded
if [ -z "${XLB_INNER:-}" ]; then
	set +e; XLB_INNER=1 timeout --foreground "$tmo" bash "$SELF" "${ARGS[@]}"; rc=$?; set -e
	[ $rc -ne 124 ] || { echo "RESULT: ERROR timeout after ${tmo}s (log: $LOG)"; exit 2; }
	exit $rc
fi

# ---------------------------------------------------------------- prerequisites
miss=""
for t in git curl tar xz make cc clang clang++ perl python3 m4 autoreconf automake awk rsync dpkg apt-get; do command -v $t >/dev/null || miss="$miss $t"; done
[ -z "$miss" ] || finish ERROR "missing host tools:$miss" "install them with: sudo apt install git curl xz-utils make clang perl python3 m4 autoconf automake gawk rsync"

THEOS=$LB/theos; CCT=$THEOS/toolchain/linux/iphone/bin; SDK=$LB/sdk/MacOSX14.0.sdk
D=$LB/deps; HB=$D/host/bin; HI=$D/host/inc; FRB=$D/fakeroot-base
MACSDK_SHA=5e4d3be6b445f0eacc0333ff2117e93e4433d8c4fe44053a14f735033a98aaa9
TC_SHA=a72a7a577e2fbe2838b6b5e9c72034fa7d114af96f0e1d4b016f18730ce4056e
MACSDK_URL=https://github.com/joseluisq/macosx-sdks/releases/download/14.0/MacOSX14.0.sdk.tar.xz
TC_URL=https://github.com/L1ghtmann/llvm-project/releases/download/test-210562a/iOSToolchain-x86_64.tar.xz
fetchsha() { # DIR URL SHA|TAG
	[ -d "$1/.git" ] && return 0
	rm -rf -- "$1"; git init -q "$1"
	git -C "$1" fetch -q --depth 1 "$2" "$3" >>"$LOG" 2>&1 || finish ERROR "cannot fetch $3 from $2 (network?)"
	git -C "$1" -c advice.detachedHead=false checkout -q FETCH_HEAD
}

# ---------------------------------------------------------------- 1. cctools + SDK (theos pieces, macOS SDK)
if [ ! -x "$CCT/ld" ]; then
	say "fetching theos cctools toolchain (86 MB)"
	mkdir -p "$THEOS/toolchain" "$LB/dl"
	curl -sfL -o "$LB/dl/tc.tar.xz" "$TC_URL" || finish ERROR "cannot download $TC_URL"
	[ "$(sha256sum "$LB/dl/tc.tar.xz" | cut -d' ' -f1)" = "$TC_SHA" ] || finish ERROR "sha256 mismatch for $TC_URL"
	tar -xJf "$LB/dl/tc.tar.xz" -C "$THEOS/toolchain"
fi
if [ ! -d "$THEOS/sdks/iPhoneOS16.5.sdk/usr" ]; then
	say "fetching theos iPhoneOS16.5.sdk (233 MB)"
	rm -rf "$LB/dl/sdks"
	git clone -q --depth 1 --filter=blob:none --sparse https://github.com/theos/sdks "$LB/dl/sdks" >>"$LOG" 2>&1 || finish ERROR "cannot clone theos/sdks"
	git -C "$LB/dl/sdks" sparse-checkout set iPhoneOS16.5.sdk >>"$LOG" 2>&1
	mkdir -p "$THEOS/sdks"; mv "$LB/dl/sdks/iPhoneOS16.5.sdk" "$THEOS/sdks/"
fi
if [ ! -d "$SDK/usr/include" ]; then
	# CI = Xcode 15.0.1 (first Xcode_* by sort -V) = macOS 14.0 SDK (the CI kernel says sdk 14.0)
	say "fetching MacOSX14.0.sdk (67 MB download, 1.5 GB unpacked)"
	mkdir -p "$LB/sdk" "$LB/dl"
	curl -sfL -o "$LB/dl/MacOSX14.0.sdk.tar.xz" "$MACSDK_URL" || finish ERROR "cannot download $MACSDK_URL"
	[ "$(sha256sum "$LB/dl/MacOSX14.0.sdk.tar.xz" | cut -d' ' -f1)" = "$MACSDK_SHA" ] || finish ERROR "sha256 mismatch for $MACSDK_URL"
	tar -xJf "$LB/dl/MacOSX14.0.sdk.tar.xz" -C "$LB/sdk"
fi
# flex/bison without root
if ! command -v flex >/dev/null || ! command -v bison >/dev/null; then
	if [ ! -x "$LB/hostroot/usr/bin/flex" ] || [ ! -x "$LB/hostroot/usr/bin/bison" ]; then
		say "flex/bison not installed: unpacking the Debian packages into $LB/hostroot (no root)"
		mkdir -p "$LB/dl/debs" "$LB/hostroot"
		( cd "$LB/dl/debs" && apt-get download flex bison libfl2 libfl-dev ) >>"$LOG" 2>&1 \
			|| finish ERROR "cannot download flex/bison" "install them with: sudo apt install flex bison"
		for deb in "$LB"/dl/debs/*.deb; do dpkg -x "$deb" "$LB/hostroot"; done
	fi
	export PATH=$LB/hostroot/usr/bin:$PATH BISON_PKGDATADIR=$LB/hostroot/usr/share/bison
	export LIBRARY_PATH=$LB/hostroot/usr/lib/x86_64-linux-gnu C_INCLUDE_PATH=$LB/hostroot/usr/include
fi
# the syscall tables (bsd/kern/makesyscalls.sh) need gawk-style "\\(" handling; mawk emits a backslash
if ! awk --version 2>&1 | grep -q GNU; then
	if [ ! -x "$LB/hostroot/usr/bin/gawk" ]; then
		say "awk is not GNU awk: unpacking gawk into $LB/hostroot (no root)"
		mkdir -p "$LB/dl/debs" "$LB/hostroot"
		( cd "$LB/dl/debs" && apt-get download gawk libsigsegv2 ) >>"$LOG" 2>&1 || finish ERROR "cannot download gawk" "install it with: sudo apt install gawk"
		for deb in "$LB"/dl/debs/gawk_*.deb "$LB"/dl/debs/libsigsegv2_*.deb; do dpkg -x "$deb" "$LB/hostroot"; done
	fi
	mkdir -p "$HB"; printf '#!/bin/sh\nLD_LIBRARY_PATH=%s/hostroot/usr/lib/x86_64-linux-gnu exec %s/hostroot/usr/bin/gawk "$@"\n' "$LB" "$LB" >"$HB/awk"; chmod +x "$HB/awk"
fi
command -v flex >/dev/null && command -v bison >/dev/null || finish ERROR "flex/bison unusable" "install them with: sudo apt install flex bison"

# ---------------------------------------------------------------- 2. host wrappers (generated, own code)
mkdir -p "$HB" "$HI"
# generated files are only rewritten when their content changes: the force-included headers are dependencies of every object
upd() { cmp -s "$1.new" "$1" && rm -f "$1.new" || mv "$1.new" "$1"; }
w() { cat >"$HB/$1.new"; chmod +x "$HB/$1.new"; upd "$HB/$1"; }
hdr() { cat >"$1.new"; upd "$1"; }
# stock clang as the Mach-O cross compiler. The kernel is arm64 (CI: plain arm64, macOS platform, minos 14.0).
w xnu-clang <<EOF
#!/bin/bash
case "\$(basename "\$0")" in *++) drv=clang++; extra=(-fno-use-cxa-atexit) ;; *) drv=clang; extra=() ;; esac
a=()
for x in "\$@"; do case "\$x" in
	-enable-trivial-auto-var-init-zero-knowing-it-will-be-removed-from-clang|-fapple-kext-vtable-verify|-Wno-vla-cxx-extension) ;;
	-Werror|-Werror=*|-Weverything|-pedantic-errors) ;;
	*) a+=("\$x") ;; esac; done
exec /usr/bin/\$drv -include $HI/xnu_clang_compat.h -target arm64-apple-macos14.0 -mcpu=cortex-a76 --ld-path=$CCT/ld -w "\${extra[@]}" "\${a[@]}"
EOF
ln -sfn xnu-clang "$HB/xnu-clang++"
# host-side build tools of the kernel build (SETUP/*): native Linux clang, Apple-only flags dropped
w host-cc <<EOF
#!/bin/bash
a=(); skip=0
for x in "\$@"; do
	if [ \$skip = 1 ]; then skip=0; continue; fi
	case "\$x" in -isysroot) skip=1 ;; -mmacosx-version-min=*|-Werror|-Werror=*) ;; *) a+=("\$x") ;; esac
done
exec /usr/bin/clang -include $HI/hostcompat.h -I$HI -I\${XLB_XNU:-.}/EXTERNAL_HEADERS -D_GNU_SOURCE -w "\${a[@]}"
EOF
w xcrun <<EOF
#!/bin/bash
# the one question set the XNU makefiles ask xcrun
find=""; show=""
while [ \$# -gt 0 ]; do case "\$1" in
	-sdk|--sdk) shift 2 ;; -verbose|--verbose) shift ;;
	-find|--find|-f) find=\$2; shift 2 ;;
	-show-sdk-path|--show-sdk-path) show=path; shift ;;
	-show-sdk-version|--show-sdk-version|-show-sdk-platform-version|--show-sdk-platform-version) show=version; shift ;;
	-show-sdk-platform-path|--show-sdk-platform-path) show=platform; shift ;;
	*) break ;; esac; done
case "\$show" in path) echo $SDK; exit 0 ;; version) echo 14.0; exit 0 ;; platform) echo $D/host/Platforms/MacOSX.platform; exit 0 ;; esac
if [ -n "\$find" ]; then
	case "\$find" in clang) echo $HB/xnu-clang; exit 0 ;; clang++) echo $HB/xnu-clang++; exit 0 ;; esac
	for d in $HB $D/host/cct /usr/bin; do [ -x "\$d/\$find" ] && { echo "\$d/\$find"; exit 0; }; done
	exit 1
fi
[ \$# -gt 0 ] && exec "\$@"
EOF
mkdir -p "$D/host/Platforms/MacOSX.platform"
# Apple's closed iig (DriverKit interface generator): header = the pre-generated one in the SDK, implementation = a stand-in
# generated from that header by iig-impl.py (metaclasses, Dispatch stubs, wrappers that call the kernel's own X_Impl).
w iig <<EOF
#!/bin/bash
def=""; hdr=""; impl=""
while [ \$# -gt 0 ]; do case "\$1" in --def) def=\$2; shift 2 ;; --header) hdr=\$2; shift 2 ;; --impl) impl=\$2; shift 2 ;; --) break ;; *) shift ;; esac; done
name=\$(basename "\$def" .iig)
src=\$(find $SDK/System/Library/Frameworks/Kernel.framework/Headers -path '*DriverKit*' -name "\$name.h" | head -1)
[ -n "\$src" ] || { echo "iig stand-in: no pre-generated header for \$name" >&2; exit 1; }
cp "\$src" "\$hdr"
python3 -I $HB/iig-impl.py "\$src" "\$impl" "\${XLB_XNU:-.}" || exit 1
# both outputs get the .iig file's time: the makefile makes every X.iig.cpp depend on every generated header, so a header written
# after an impl would recompile that impl on every run
touch -r "\$def" "\$hdr" "\$impl"
EOF
w iig-impl.py <<'EOF'
#!/usr/bin/env python3
# usage: iig-impl.py PREGENERATED_HEADER OUT.iig.cpp XNU_ROOT
# Stand-in for the implementation file Apple's iig would generate. For every DriverKit class in the header:
#  - the OSMetaClass definition, unless the kernel itself already defines it;
#  - Dispatch(), MetaClass::Dispatch(), _Dispatch() and X_Invoke(): RPC from a user-space driver is not supported (kIOReturnUnsupported);
#  - for every method that has a kernel-side X_Impl: the public wrapper calls X_Impl directly (the supermethod argument only
#    matters for a driver running in user space). Methods that take an IORPC (replies to a driver) return kIOReturnUnsupported.
import re, subprocess, sys
hdr, out, xnu = sys.argv[1:4]
t = open(hdr).read()

def macro(name):
    ls = t.split('\n')
    for i, l in enumerate(ls):
        if re.match(r'#define %s\b' % re.escape(name), l):
            body = [l.split(None, 2)[2] if len(l.split(None, 2)) > 2 else '']
            while body[-1].endswith('\\') and i + 1 < len(ls):
                i += 1; body[-1] = body[-1][:-1]; body.append(ls[i])
            body[-1] = body[-1].rstrip('\\')
            return '\n'.join(body)
    return ''

def kernel_has(pattern):
    r = subprocess.run(['grep', '-rEq', '--include=*.cpp', '--include=*.c', '--include=*.h', pattern,
                        xnu + '/iokit', xnu + '/libkern', xnu + '/osfmk', xnu + '/bsd'])
    return r.returncode == 0

def split_args(a):
    parts, depth, cur = [], 0, ''
    for ch in a:
        depth += ch in '(<'; depth -= ch in ')>'
        if ch == ',' and depth == 0: parts.append(cur.strip()); cur = ''
        else: cur += ch
    if cur.strip(): parts.append(cur.strip())
    return parts

o = ['/* generated by tools/xnu-local-build (iig stand-in) from %s */' % hdr.split('/')[-1],
     '#include <IOKit/IOLib.h>', '#include <IOKit/IOReturn.h>', '#include <IOKit/IOService.h>', '#include <IOKit/IOUserClient.h>',
     '#include <IOKit/IOUserServer.h>', '#include <IOKit/IOBufferMemoryDescriptor.h>', '#include <IOKit/IODMACommand.h>',
     '#include <DriverKit/IODispatchSource.h>', '#include <DriverKit/IODispatchQueue.h>', '#include <DriverKit/IOEventLink.h>',
     '#include <DriverKit/IOWorkGroup.h>', '#include <DriverKit/OSAction.h>', '#include <DriverKit/IOMemoryMap.h>',
     '#include <DriverKit/IODataQueueDispatchSource.h>', '#include <DriverKit/IOInterruptDispatchSource.h>',
     '#include <DriverKit/IOServiceNotificationDispatchSource.h>', '#include <DriverKit/IOServiceStateNotificationDispatchSource.h>', '']
decl = {m.group(1): (m.group(2), m.group(3)) for m in re.finditer(r'^class\s+(?:__attribute__\(\((?:[^()]|\((?:[^()]|\([^()]*\))*\))*\)\)\s+)?(\w+)\s*:\s*public\s+(\w+)[^{]*\{\s*(OSDeclare\w+)\(', t, re.M)}
for cls in re.findall(r'^#define (\w+)_Methods\b', t, re.M):
    if cls in decl:
        sup, dm = decl[cls]
        if not kernel_has(r'OSDefineMetaClass\w*\(\s*%s\s*,' % cls):
            o.append('OSDefineMetaClassAnd%sStructors(%s, %s);' % ('Abstract' if 'Abstract' in dm else '', cls, sup))
    o.append('kern_return_t %s::Dispatch(const IORPC rpc) { return kIOReturnUnsupported; }' % cls)
    o.append('kern_return_t %s::MetaClass::Dispatch(const IORPC rpc) { return kIOReturnUnsupported; }' % cls)
    body = macro(cls + '_Methods') + '\n' + macro(cls + '_KernelMethods')
    body = re.sub(r'/\*.*?\*/', ' ', body, flags=re.S)
    decls = []
    for st in body.split(';'):
        st = re.sub(r'\b(public|protected|private)\s*:', ' ', st)
        st = re.sub(r'__attribute__\(\((?:[^()]|\((?:[^()]|\([^()]*\))*\))*\)\)', ' ', st)
        st = ' '.join(st.split())
        d = re.match(r'^(?P<pre>[^()]*?)\b(?P<name>\w+)\s*\((?P<args>.*)\)\s*(?P<post>[\w ]*)$', st)
        if d: decls.append(d)
    impls = {d.group('name')[:-5] for d in decls if d.group('name').endswith('_Impl')}
    calls = {d.group('name') for d in decls if d.group('name').endswith('_Call')}
    for d in decls:
        n, args = d.group('name'), re.sub(r'\s*=\s*NULL\b', '', d.group('args'))
        if n.endswith('_Impl') or n == 'Dispatch' or d.group('pre').split()[:1] == ['typedef']: continue
        ps = split_args(args)
        ret = ' '.join(x for x in d.group('pre').split() if x not in ('static', 'virtual', 'inline'))
        post = ' const' if 'const' in d.group('post').split() else ''
        has_super = re.search(r'OSDispatchMethod\s+supermethod\s*$', args) is not None
        argl = split_args(macro(args.strip())) if re.fullmatch(r'\w+_Args', args.strip()) else ps   # X_Call(Cls_X_Args)
        names = [re.search(r'(\w+)\s*$', p).group(1) for p in argl[:-1 if has_super else None]]
        unsupported = '' if ret == 'void' else ('return kIOReturnUnsupported;' if ret == 'kern_return_t' else 'return %s();' % ret)
        if (cls, n) == ('IOUserClient', 'CreateActionKernelCompletion'):
            # the action that completes an async external method in the kernel: typed OSAction_IOUserClient_KernelCompletion
            stmt = ('OSString * t = OSString::withCString("OSAction_IOUserClient_KernelCompletion"); '
                    'kern_return_t r = OSAction::CreateWithTypeName(this, IOUserClient_KernelCompletion_ID, IOUserClient_AsyncCompletion_ID, '
                    'referenceSize, t, action); OSSafeReleaseNULL(t); return r;')
        elif n.endswith('_Call'):   # static entry the RPC server side uses to reach the kernel's X_Impl
            stmt = ('' if ret == 'void' else 'return ') + '%s_Impl(%s);' % (n[:-5], ', '.join(names)) if kernel_has(r'\b%s::%s_Impl\b' % (cls, n[:-5])) else unsupported
        elif n.endswith('_Invoke') or n == '_Dispatch':
            stmt = unsupported   # server side of the RPC from a user-space driver
        elif has_super and ps[0].startswith('IORPC') or has_super and n not in impls:
            stmt = unsupported   # a reply to / a call into a user-space driver
        elif has_super or ('static' in d.group('pre').split() and n in impls and n + '_Call' not in calls and not kernel_has(r'^%s::%s\b' % (cls, n))):
            if not kernel_has(r'\b%s::%s_Impl\b' % (cls, n)): stmt = unsupported
            else: stmt = ('' if ret == 'void' else 'return ') + '%s_Impl(%s);' % (n, ', '.join(names))
        else: continue
        o.append('%s %s::%s(%s)%s { %s }' % (ret, cls, n, ', '.join(ps), post, stmt))
open(out, 'w').write('\n'.join(o) + '\n')
EOF
# BSD install -S (safe copy) does not exist in GNU install, where it eats the next argument
w install <<EOF
#!/bin/bash
a=(); for x in "\$@"; do [ "\$x" = -S ] || a+=("\$x"); done
exec /usr/bin/install "\${a[@]}"
EOF
w true-tool <<EOF
#!/bin/sh
exit 0
EOF
ln -sfn true-tool "$HB/codesign"
ln -sfn /usr/bin/python3 "$HB/python"   # the lldbmacros install rules run "env python"
