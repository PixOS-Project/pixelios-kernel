hdr "$HI/xnu_clang_compat.h" <<'EOF'
/* Force-included in every kernel TU. Stock clang lacks Apple clang's kalloc_type builtins (the CI toolchain has them).
 * Approximation (a deliberate loss of fidelity, see docs/AUTOMATION.md): the type "summary" tells the allocator whether a
 * type holds pointers, data or both. Here: scalars/enums/arrays of them = data, pointers = pointer, C structs = mixed,
 * C++ polymorphic classes = mixed, other C++ classes = data. Every choice allocates fine; only the zone segregation (a
 * hardening feature) differs from Apple's. Pretend to be Xcode 15.0's clang (15000100) where the tree keys on that. */
#ifndef __apple_build_version__
#define __apple_build_version__ 15000100
#endif
#if !defined(__ASSEMBLER__) && !defined(ASSEMBLER) && !__has_builtin(__builtin_xnu_type_signature)
#define XNU_NO_TYPE_BUILTINS 1
#ifdef __cplusplus
template <class T> struct __xlb_sum { enum : unsigned { v = (__is_class(T) || __is_union(T)) ? (__is_polymorphic(T) ? 7u : 5u) : 5u }; };
template <class T> struct __xlb_sum<T *> { enum : unsigned { v = 3u }; };
template <class T> struct __xlb_sum<T *const> { enum : unsigned { v = 3u }; };
template <class T> struct __xlb_sum<T *volatile> { enum : unsigned { v = 3u }; };
template <class T> struct __xlb_sum<const T> : __xlb_sum<T> {};
template <class T> struct __xlb_sum<volatile T> : __xlb_sum<T> {};
template <class T, decltype(sizeof(0)) N> struct __xlb_sum<T[N]> : __xlb_sum<T> {};
#define __builtin_xnu_type_summary(type) (__xlb_sum<type>::v)
#define __builtin_xnu_type_signature(type) (__xlb_sum<type>::v == 5u ? "2" : (__xlb_sum<type>::v == 3u ? "1" : "12"))
#define __builtin_xnu_types_compatible(a, b) __is_same(a, b)
#else
#define __xlb_cls(type) __builtin_classify_type(*(type *)0)
#define __builtin_xnu_type_summary(type) (__xlb_cls(type) == 5 ? 3U : ((__xlb_cls(type) == 12 || __xlb_cls(type) == 13) ? 7U : 5U))
#define __builtin_xnu_type_signature(type) (__xlb_cls(type) == 5 ? "1" : ((__xlb_cls(type) == 12 || __xlb_cls(type) == 13) ? "12" : "2"))
#define __builtin_xnu_types_compatible(a, b) __builtin_types_compatible_p(a, b)
#endif
#endif
EOF
hdr "$HI/hostcompat.h" <<'EOF'
/* force-included in the kernel build's host tools (SETUP/*): what BSD libc has and glibc lacks */
#include <errno.h>
#include <fcntl.h>
#include <libgen.h>
#include <stdbool.h>
#include <stdint.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <sys/param.h>
#include <sys/stat.h>
#include <sys/types.h>
#include <unistd.h>
#include <byteswap.h>
extern char *program_invocation_short_name;
static inline const char *getprogname(void) { return program_invocation_short_name; }
#ifndef __unused
#define __unused __attribute__((unused))
#endif
#ifndef __dead2
#define __dead2 __attribute__((noreturn))
#endif
#ifndef __printflike
#define __printflike(a, b) __attribute__((format(printf, a, b)))
