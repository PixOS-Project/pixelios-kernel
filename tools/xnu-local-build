	say "libfirehose_kernel.a (arm64)"
	mkdir -p "$W/build/firehose"
	PH=$FR/System/Library/Frameworks/Kernel.framework
	xnu-clang -c -Os -arch arm64 -mkernel -nostdinc -Wno-packed -DKERNEL=1 -DDISPATCH_USE_DTRACE=0 -DOS_ATOMIC_CONFIG_MEMORY_ORDER_DEPENDENCY=1 \
		-DOS_ATOMIC_CONFIG_STARVATION_FREE_ONLY=0 -I"$D/libdispatch" -I"$PH/PrivateHeaders" -I"$PH/Headers" -I"$FR/usr/local/include/os" -I"$FR/usr/local/include/firehose" \
		-I"$FR/usr/local/include/kernel" -I"$SDK/System/Library/Frameworks/Kernel.framework/Headers" \
		-o "$W/build/firehose/firehose_buffer.o" "$D/libdispatch/src/firehose/firehose_buffer.c" >"$W/firehose.log" 2>&1 \
		|| finish ERROR "libfirehose_kernel did not compile" "$(grep -m5 'error' "$W/firehose.log" | cut -c1-200)" "see $W/firehose.log"
	# what Apple's toolchain links in but stock clang/this host does not provide (documented in docs/LOCAL-BUILD.md):
	#  - __cxa_atexit: stock clang lowers a static destructor (KLDBootstrap) to __cxa_atexit, Apple's to __mod_term_func
	#  - the compiler-rt PGO entry points OSKext.cpp references (kext PGO data is not collected here)
	cat >"$W/build/firehose/xlb_stubs.c" <<'EOT'
typedef unsigned long long u64;
int __cxa_atexit(void (*f)(void *), void *arg, void *dso) { (void)f; (void)arg; (void)dso; return 0; }
u64 __llvm_profile_get_size_for_buffer_internal(const char *a, const char *b, const char *c, const char *d, const char *e, const char *f) { (void)a; (void)b; (void)c; (void)d; (void)e; (void)f; return 0; }
int __llvm_profile_write_buffer_internal(char *buf, const char *a, const char *b, const char *c, const char *d, const char *e, const char *f) { (void)buf; (void)a; (void)b; (void)c; (void)d; (void)e; (void)f; return -1; }
EOT
	xnu-clang -c -Os -arch arm64 -mkernel -nostdinc -o "$W/build/firehose/xlb_stubs.o" "$W/build/firehose/xlb_stubs.c" >>"$W/firehose.log" 2>&1 \
		|| finish ERROR "stub object did not compile" "see $W/firehose.log"
	libtool -static -o "$FH" "$W/build/firehose/firehose_buffer.o" "$W/build/firehose/xlb_stubs.o" >>"$W/firehose.log" 2>&1
fi
KERN=$FR/System/Library/Kernels/kernel.development.sweet
rm -f "$KERN"   # never report a kernel left over from an earlier build
BT=$(date +%s); : >"$W/.make-stamp"   # the guard: an object newer than this stamp was compiled by this make
say "make install (DEVELOPMENT ARM64 SWEET) -j$jobs -k"
set +e
# shellcheck disable=SC2086  # $makeargs is the user's --make-args word list, split on purpose
nice "${MK[@]}" install -j"$jobs" -k TARGET_CONFIGS="DEVELOPMENT ARM64 SWEET" $makeargs >"$W/build.log" 2>&1
mrc=$?; set -e
BWALL=$(( $(date +%s) - BT ))
say "make exit $mrc after ${BWALL}s"
errs=$(grep -c -E 'error:|\*\*\* \[' "$W/build.log" || { rc=$?; [ $rc = 1 ] || echo "xnu-local-build GAP: grep failed rc=$rc" >&2; })
if ! [ -f "$KERN" ] || [ $mrc -ne 0 ]; then   # the guard records what this failed make compiled, so the next (fixed) incremental build can prove those objects (no verdict here)
	CFG=$(dirname "$(find "$OBJ" -maxdepth 2 -name kernel.development.sweet.unstripped -print -quit 2>/dev/null)" 2>/dev/null); [ -d "$CFG" ] && [ "$CFG" != . ] || CFG=$(find "$OBJ" -mindepth 1 -maxdepth 1 -type d -name '*_ARM64_*' -print -quit 2>/dev/null)
	[ -z "$CFG" ] || say "$(python3 -I "$ROOT/tools/xnu-build-guard.py" --cfg "$CFG" --tree "$W" --stamp "$W/.make-stamp" --manifest "$W/.guard-manifest.json" --kernel "$CFG/kernel.development.sweet.unstripped" \
		--installed "$KERN" --root "$LB" --root "$SDK" --root /usr/lib/llvm-19 --root /usr/include --record-only 2>&1 | grep -m1 '^XNU BUILD GUARD' || echo 'XNU BUILD GUARD: record-only gave no line')"
fi
[ -f "$KERN" ] && [ $mrc -eq 0 ] || finish FAIL "build failed ($errs error lines, make exit $mrc, ${BWALL}s)" "$(grep -m8 -E 'error:|\*\*\* \[|undefined' "$W/build.log" | cut -c1-220)" "build log: $W/build.log"
# stale-object guard (every build): each linked object is either compiled by this make or proven, by the content hash of every source it
# was compiled from, unchanged since the last verified build of this tree; no dependency in another work tree; kernel relinked after them.
# A FAIL removes this label's out/ kernel so no run picks up the stale one.
CFG=$(dirname "$(find "$OBJ" -maxdepth 2 -name kernel.development.sweet.unstripped -print -quit)")
gout=$(python3 -I "$ROOT/tools/xnu-build-guard.py" --cfg "$CFG" --tree "$W" --stamp "$W/.make-stamp" --manifest "$W/.guard-manifest.json" \
	--kernel "$CFG/kernel.development.sweet.unstripped" --installed "$KERN" --root "$LB" --root "$SDK" --root /usr/lib/llvm-19 --root /usr/include 2>&1) && grc=0 || grc=$?
say "$(grep -m1 '^XNU BUILD GUARD' <<<"$gout" || echo "XNU BUILD GUARD: no verdict (rc $grc)")"
if [ $grc -ne 0 ]; then
	rm -f "$LB/out/$label/kernel.development.sweet"
	finish FAIL "stale-object guard: $(sed -n 's/^RESULT: [A-Z]* //p' <<<"$gout" | tail -n 1 | cut -c1-300)" "$(grep '^  ' <<<"$gout" | head -n 12)" "no kernel copied to $LB/out/$label (old copy removed); rerun with --fresh, or fix the tree"
fi
sha=$(sha256sum "$KERN" | cut -d' ' -f1)
# per-label copy: one shared out/ file let a second label's build overwrite the kernel a run was about to use (21c, 2026-10-28)
mkdir -p "$LB/out/$label"; cp -f "$KERN" "$LB/out/$label/kernel.development.sweet"
rm -f "$LB/out/kernel.development.sweet"   # the old shared copy is stale by definition (review localbuild-per-label-r1 F1)
rep=("kernel: $LB/out/$label/kernel.development.sweet" "sha256: $sha" "size: $(stat -c %s "$KERN") bytes" "build wall: ${BWALL}s ($( [ -f "$W/.cold" ] && echo cold || echo incremental)), total run $(( $(date +%s) - START ))s, -j$jobs" "patches: $(cat "$W/patches.txt")" "make exit $mrc, $errs error lines (CI uses make -k too; see $W/build.log)")
rm -f "$W/.cold"
if [ -n "$compare" ]; then
	[ -f "$compare" ] || finish ERROR "--compare kernel not found: $compare"
	export LC_ALL=C
	# symbol names without the compiler's per-build suffixes (.site.N, .N, .llvm.N, .cold outlines)
	norm() { sed -E 's/\.cold$//; s/(\.site)?\.[0-9]+$//; s/\.llvm\.[0-9]+$//' | sort -u; }
	for k in ci:"$compare" local:"$KERN"; do
		nm -g "${k#*:}" 2>/dev/null | awk '{print $NF}' | norm >"$W/ext.${k%%:*}"
		nm "${k#*:}" 2>/dev/null | awk '{print $NF}' | norm | grep -E -i 'sweet|appleclcd' >"$W/sweet.${k%%:*}" || true
		otool -l "${k#*:}" 2>/dev/null | awk '/segname/ && !/sectname/{g=$2} /sectname/{s=$2} /      size /{print g"/"s, strtonum($2)}' | sort -u >"$W/sect.${k%%:*}"
	done
	join -a1 -a2 -e 0 -o 0,1.2,2.2 "$W/sect.ci" "$W/sect.local" | awk '$2!=$3{printf "%s CI=%d local=%d (%+d)\n",$1,$2,$3,$3-$2}' >"$W/sect.diff"
	e_l=$(comm -13 "$W/ext.ci" "$W/ext.local" | wc -l); e_c=$(comm -23 "$W/ext.ci" "$W/ext.local" | wc -l)
	s_l=$(comm -13 "$W/sweet.ci" "$W/sweet.local" | wc -l); s_c=$(comm -23 "$W/sweet.ci" "$W/sweet.local" | wc -l)
	comm -23 "$W/ext.ci" "$W/ext.local" >"$W/ext.only-ci"; comm -13 "$W/ext.ci" "$W/ext.local" >"$W/ext.only-local"
	comm -23 "$W/sweet.ci" "$W/sweet.local" >"$W/sweet.only-ci"; comm -13 "$W/sweet.ci" "$W/sweet.local" >"$W/sweet.only-local"
	rep+=("compare with $compare: size $(stat -c %s "$compare") CI vs $(stat -c %s "$KERN") local, sha256 $( [ "$(sha256sum "$compare" | cut -d' ' -f1)" = "$sha" ] && echo IDENTICAL || echo differs)"
		"external symbols: $(wc -l <"$W/ext.ci") CI, $(wc -l <"$W/ext.local") local, $e_c only CI, $e_l only local (lists: $W/ext.only-ci, $W/ext.only-local)"
		"SWEET/AppleCLCD symbols (all, normalized): $(wc -l <"$W/sweet.ci") CI, $(wc -l <"$W/sweet.local") local, $s_c only CI, $s_l only local (lists: $W/sweet.only-*)"
		"section size differences ($(wc -l <"$W/sect.diff") of $(wc -l <"$W/sect.ci")): $W/sect.diff")
	od=$(command -v llvm-objdump-19 || command -v llvm-objdump || echo /usr/lib/llvm-19/bin/llvm-objdump)
	if [ -x "$od" ]; then
		insn_ci=$("$od" -d "$compare" 2>/dev/null | grep -c -E '\<(xpaci|paciasp|autiasp|stlur|stlurb|stlurh|ldapur|eor3|rax1|xar|bcax)\>' || { rc=$?; [ $rc = 1 ] || echo "xnu-local-build GAP: grep failed rc=$rc" >&2; })
		insn_loc=$("$od" -d "$KERN" 2>/dev/null | grep -c -E '\<(xpaci|paciasp|autiasp|stlur|stlurb|stlurh|ldapur|eor3|rax1|xar|bcax)\>' || { rc=$?; [ $rc = 1 ] || echo "xnu-local-build GAP: grep failed rc=$rc" >&2; })
		rep+=("unsupported v8.3+/PAC/LRCPC2/SHA3 insns: $insn_ci CI vs $insn_loc local")
	fi
fi
# R26 ledger (tools/xnu-remote-build): where this kernel was built; not written inside the offload-host container (the dispatcher records offload-host builds on the lab-host side)
if [ "${XNUB_IN_SLOT:-}" != 1 ]; then
	"$ROOT/tools/xnu-remote-build" ledger-add --dir "$LB" --sha "$sha" --label "$label" --where "${XNU_LEDGER_WHERE:-lab-host-local}" --reason "${XNU_LEDGER_REASON:-}" >>"$LOG" 2>&1 \
		|| say "WARNING: built-on ledger entry not written ($LB/built-on.tsv): tools/xrun will print 'XNU BUILD: unknown'"
fi
finish PASS "kernel.development.sweet built locally in ${BWALL}s" "${rep[@]}"
