stage_tree() {
	local t=$1 s p applied=0 skipped=""
	rm -rf -- "$t"; mkdir -p "$t"; cp -a "$P/." "$t/"
	cd "$t"
	sed -i 's|^AVAILABILITY_PL="${SDKROOT}/${DRIVERKITROOT}|AVAILABILITY_PL="${FAKEROOT_DIR}|g' bsd/sys/make_symbol_aliasing.sh
	sed -i 's|^#include.*BSD.xcconfig.*||g' libsyscall/Libsyscall.xcconfig
	# not CI: the directory cscope.genhdrs is touched by each run, which regenerated sysproto.h and recompiled ~80 BSD files every time
	sed -i -E 's/^(syscall\.h|sysproto\.h): (\$\(TARGET\)\/bsd\.syscalls\.master) (\$\(OBJROOT\)\/cscope\.genhdrs)/\1: \2 | \3/' bsd/sys/Makefile
	sed -i 's|^LDFLAGS_KERNEL_SDK	= -L$(SDKROOT).*|LDFLAGS_KERNEL_SDK	= -L$(FAKEROOT_DIR)/usr/local/lib/kernel -lfirehose_kernel|g' makedefs/MakeInc.def
	sed -i 's|^\(INCFLAGS_SDK[[:space:]]*=\) -I$(SDKROOT)/usr/local/include/\(kernel\)\{0,1\}|\1 -I$(FAKEROOT_DIR)/usr/local/include/kernel|' makedefs/MakeInc.def
	sed -i 's|export MIG := $(shell $(XCRUN) -sdk $(SDKROOT) -find mig)|export MIG := $(shell find $(FAKEROOT_DIR) -name "mig")|g' makedefs/MakeInc.cmd
	sed -i 's|export MIGCOM := $(shell $(XCRUN) -sdk $(SDKROOT) -find migcom)|export MIGCOM := $(shell find $(FAKEROOT_DIR) -name "migcom")|g' makedefs/MakeInc.cmd
	for s in "${stagers[@]}"; do
		env PATH="$HB:$PATH" MACHINE_CONFIG=SWEET MACOS_VERSION=$MACOS_VERSION KDKROOT=$KDKROOT bash "$s" >>"$LOG" 2>&1 || finish ERROR "stager $(basename "$s") failed (network?)" "$(tail -n 5 "$LOG" | cut -c1-200)"
	done
	# CI copies ours next to blacktop's top-level patches and applies the lot, skipping any that does not git-apply --check
	mapfile -t allp < <(for p in "${ours[@]}" "$LB"/dxb/patches/*.patch; do echo "$p"; done | awk -F/ '{print $NF"\t"$0}' | LC_ALL=C sort | cut -f2)
	for p in "${allp[@]}"; do
		if git apply --check "$p" >>"$LOG" 2>&1; then git apply "$p" >>"$LOG" 2>&1; applied=$((applied + 1)); else skipped="$skipped $(basename "$p")"; fi
	done
	echo "$applied patches applied; skipped (CI skips them too):${skipped:- none}" | tee "$W/patches.txt" >>"$LOG"
	# not CI steps, work-copy edits only. SETUP/config/doconf is a csh script and there is no /bin/csh without root: use our tcsh.
	sed -i "1s|.*|#!$HB/tcsh -f|" SETUP/config/doconf
	# stock clang (C++) rejects *(void *) inside __typeof__; Apple clang's kalloc_type macros rely on it only for a compile-time check
	perl -0pi -e 's/(#define KALLOC_TYPE_IS_COMPATIBLE_PTR\(ptr, type\)).*?\n\n/$1 (1)\n\n/s' osfmk/kern/kalloc.h
