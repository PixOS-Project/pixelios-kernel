#!/usr/bin/env python3
"""pixping-stage: build, sign and pack the pixping + pixopen overlay (sprint-wifi rungs W-IOSPING and W-UI).

  PIXOS_WIFI_GW=A.B.C.D tools/pixping-stage [--src tools/pixping.c] [--out-dir DIR] [--launchd-base FILE] [--gateway A.B.C.D]

Builds tools/pixping.c for iOS like tools/devd-stage does for devd (clang -target arm64-apple-ios16.0 + theos ld64 + `ldid -Cadhoc -S`
under the final name `pixping`, same toolchain env DEVD_SDK / DEVD_THEOS_BIN / DEVD_CLANG), checks the result (arm64 Mach-O, minos <= 16.0,
ad-hoc signature with Identifier=pixping, no PAC/LDAPUR instructions) and stages:

  DIR/tree/usr/local/bin/pixping               0755  signed binary
  DIR/tree/usr/local/bin/pixnet                0755  signed binary (tools/pixnet.c: DNS/TCP/TLS/HTTP proof, no boot job; run as root by a resident job)
  DIR/tree/usr/local/bin/pixopen               0755  signed binary, entitlements in the signature (see below)
  DIR/tree/System/Library/xpc/launchd.plist    0644  only with --launchd-base: the base plist + jobs org.pixelios.pixping, org.pixelios.pixopen
  DIR/pixping-overlay.bin                            packed SWEET DEV archive (tools/mkdevoverlay.py --owner 0:0)

pixopen (tools/pixopen.c, rung W-UI) opens a URL in the foreground (default prefs:root=WIFI = Settings > Wi-Fi) through
SpringBoardServices SBSOpenSensitiveURLAndUnlock. It is built like pixping plus `-framework CoreFoundation` and signed with
`ldid -Cadhoc -S<entitlements.plist>`; the plist (OPEN_ENTITLEMENTS below) carries com.apple.springboard.opensensitiveurl and
com.apple.springboard.launchapplications. The kernel honours it: patch 0035 parses the XML entitlements blob of every code
signature (checked against the code directory hash) and answers entitlement queries from it, nothing else needed for ad-hoc.
The build step re-reads the signature (`ldid -e`) and FAILs if an entitlement is missing. Its job runs as mobile (SpringBoard's user),
RunAtLoad, `pixopen -d 60 -r 3 prefs:root=WIFI`: 60 s after its start (SpringBoard up) it opens the URL, retries a false return up to 3 times.

The job: RunAtLoad, root, Program /usr/local/bin/pixping, ProgramArguments `pixping -c 10 -s 200 -W 180 <gateway>`. The gateway is NEVER in git: it
comes from --gateway or the environment variable PIXOS_WIFI_GW at staging time (the driver sources the gitignored kernel .env) and ends up
only in the overlay plist under ~/pixelios-artifacts. Its stdout reaches the kernel console through patch 0048: launchd points job stdout at
/dev/null and the kernel tees what processes named in boot arg `sweetnull` write there as `|pixping| text`; so the run needs
`--args "... sweetnull=backboardd,SpringBoard,pixping,pixopen"` (the default list is backboardd,SpringBoard only) and `tools/xrun --overlay DIR/tree`.
--launchd-base is a plist taken from the FLASHED image (never fetched; the overlay replaces the whole cache file, see devd-stage).
The base may already carry the devd job; this tool only adds its own. Does not edit or import-run anything of devd-stage except its helpers.
Nothing here touches the phone. Last line RESULT: PASS|FAIL|ERROR ...; exit 0/1/2.
"""
import argparse, hashlib, importlib.machinery, importlib.util, ipaddress, os, plistlib, re, shutil, sys

HERE = os.path.dirname(os.path.abspath(__file__))
_loader = importlib.machinery.SourceFileLoader('devd_stage_for_pixping', os.path.join(HERE, 'devd-stage'))
_spec = importlib.util.spec_from_loader('devd_stage_for_pixping', _loader)
ds = importlib.util.module_from_spec(_spec)
_loader.exec_module(ds)
Fail, Err = ds.Fail, ds.Err

NAME = 'pixping'
JOB_LABEL = 'org.pixelios.pixping'
JOB_KEY = '/System/Library/LaunchDaemons/%s.plist' % JOB_LABEL   # combined-cache key shape: see devd-stage JOB_KEY
JOB2_LABEL = 'org.pixelios.pixping2'   # W-UI: a second ping while Settings > Wi-Fi is open (pixopen opens it at +60 s)
JOB2_KEY = '/System/Library/LaunchDaemons/%s.plist' % JOB2_LABEL
JOB2_DELAY = 110
STATE_NAME = 'pixstate'                 # W-UI: read-only witness of wifid's current network + configd's en0 keys (tools/pixstate.c)
STATE_LABEL = 'org.pixelios.pixstate'
STATE_JOB_KEY = '/System/Library/LaunchDaemons/%s.plist' % STATE_LABEL
STATE_ENTITLEMENTS = ['com.apple.wifi.manager-access']
OPEN_NAME = 'pixopen'
OPEN_LABEL = 'org.pixelios.pixopen'
OPEN_JOB_KEY = '/System/Library/LaunchDaemons/%s.plist' % OPEN_LABEL
OPEN_URL = 'prefs:root=WIFI'
OPEN_DELAY = 60
OPEN_TRIES = 3
# entitlements of pixopen: opensensitiveurl is the one lsd reads (CoreServices 0x181cb1348, string 0x181d43378, iOS 16.7 20H392);
# launchapplications puts it in FBSystemService's trusted set (docs/research T-9524 Q2.2)
OPEN_ENTITLEMENTS = ['com.apple.springboard.opensensitiveurl', 'com.apple.springboard.launchapplications']
DEFAULT_OUT = os.path.join(ds.HOME, 'pixelios-artifacts/pixping-stage')
PERF_NAME = 'pixperf'                   # Part A: throughput client (tools/pixperf.c); server tools/pixperf-server on PIXOS_PERF_HOST (gitignored .env)
PERF_LABEL = 'org.pixelios.pixperf'
PERF_JOB_KEY = '/System/Library/LaunchDaemons/%s.plist' % PERF_LABEL
PERF_DELAY = 200                        # after pixping2 (110 s + 10 pings) and Settings > Wi-Fi open (60 s): the link is up and configd owns en0


def perf_job_args(host):
    return [PERF_NAME, '-D', str(PERF_DELAY), '-W', '300', '-t', '30', '-u', '20000', host]
NET_NAME = 'pixnet'                     # lowclk 2026-11-13: DNS/TCP/TLS/HTTP proof (tools/pixnet.c), binary only, run by a resident job or tools/hot run; Security + CoreFoundation
BOOT_ARG = 'sweetnull=backboardd,SpringBoard,pixping,pixopen,pixperf,pixnet'


def check_gateway(gw):
    """Dotted IPv4 only (a hostname or IPv6 would make pixping print a GAP at run time)."""
    if not gw:
        raise Err('pixping-stage: no gateway: set PIXOS_WIFI_GW=A.B.C.D or pass --gateway')
    if not re.fullmatch(r'\d{1,3}(\.\d{1,3}){3}', gw):
        raise Err('pixping-stage: gateway is not a dotted IPv4 address')
    try:
        ipaddress.IPv4Address(gw)
    except ValueError:
        raise Err('pixping-stage: gateway is not a valid IPv4 address')
    return gw


def job_args(gw):
    return [NAME, '-c', '10', '-s', '200', '-W', '180', gw]


def job2_args(gw):
    return [NAME, '-D', str(JOB2_DELAY), '-c', '10', '-s', '1000', '-W', '120', gw]


def add_job(plist, gw):
    """Add the pixping job to a combined launchd cache dict in place; refuses a cache that already has it."""
    jobs = plist.get('LaunchDaemons')
    if not isinstance(jobs, dict):
        raise Err('pixping-stage: --launchd-base has no LaunchDaemons dict (not a combined launchd cache)')
    if JOB_KEY in jobs or any(isinstance(j, dict) and j.get('Label') == JOB_LABEL for j in jobs.values()):
        raise Err('pixping-stage: --launchd-base already has %s (take the base from the flashed image, not from a staged overlay)' % JOB_LABEL)
    # one-shot: no KeepAlive (a down Wi-Fi would respawn it), no _PanicOnCrash
    jobs[JOB_KEY] = {'Label': JOB_LABEL, 'Program': '/usr/local/bin/' + NAME, 'ProgramArguments': job_args(gw),
                     'UserName': 'root', 'RunAtLoad': True}
    if JOB2_KEY in jobs or any(isinstance(j, dict) and j.get('Label') == JOB2_LABEL for j in jobs.values()):
        raise Err('pixping-stage: --launchd-base already has %s' % JOB2_LABEL)
    jobs[JOB2_KEY] = {'Label': JOB2_LABEL, 'Program': '/usr/local/bin/' + NAME, 'ProgramArguments': job2_args(gw),
                      'UserName': 'root', 'RunAtLoad': True}


def open_job_args(url=OPEN_URL):
    return [OPEN_NAME, '-d', str(OPEN_DELAY), '-r', str(OPEN_TRIES), url]


def add_open_job(plist, url=OPEN_URL):
    """Add the pixopen job (mobile, RunAtLoad, one-shot) to a combined launchd cache dict in place; refuses a cache that already has it."""
    jobs = plist.get('LaunchDaemons')
    if not isinstance(jobs, dict):
        raise Err('pixping-stage: --launchd-base has no LaunchDaemons dict (not a combined launchd cache)')
    if OPEN_JOB_KEY in jobs or any(isinstance(j, dict) and j.get('Label') == OPEN_LABEL for j in jobs.values()):
        raise Err('pixping-stage: --launchd-base already has %s (take the base from the flashed image, not from a staged overlay)' % OPEN_LABEL)
    jobs[OPEN_JOB_KEY] = {'Label': OPEN_LABEL, 'Program': '/usr/local/bin/' + OPEN_NAME, 'ProgramArguments': open_job_args(url),
                          'UserName': 'mobile', 'RunAtLoad': True}


def state_job_args():
    return [STATE_NAME, '-d', '95', '-n', '40', '-i', '20']   # Part A: Settings' RSSI sampled through the whole throughput window (40 x 20 s)


def add_state_job(plist):
    jobs = plist['LaunchDaemons']
    if STATE_JOB_KEY in jobs or any(isinstance(j, dict) and j.get('Label') == STATE_LABEL for j in jobs.values()):
        raise Err('pixping-stage: --launchd-base already has %s' % STATE_LABEL)
    jobs[STATE_JOB_KEY] = {'Label': STATE_LABEL, 'Program': '/usr/local/bin/' + STATE_NAME, 'ProgramArguments': state_job_args(),
                           'UserName': 'root', 'RunAtLoad': True}


def add_perf_job(plist, host):
    jobs = plist['LaunchDaemons']
    if PERF_JOB_KEY in jobs or any(isinstance(j, dict) and j.get('Label') == PERF_LABEL for j in jobs.values()):
        raise Err('pixping-stage: --launchd-base already has %s' % PERF_LABEL)
    jobs[PERF_JOB_KEY] = {'Label': PERF_LABEL, 'Program': '/usr/local/bin/' + PERF_NAME, 'ProgramArguments': perf_job_args(host),
                          'UserName': 'root', 'RunAtLoad': True}


def entitlements_xml(keys):
    return plistlib.dumps({k: True for k in keys}, fmt=plistlib.FMT_XML)


def stage_plist(base, tree, gw, perf_host=None):
    with open(base, 'rb') as f:
        pl = plistlib.load(f)
    add_job(pl, gw)
    add_open_job(pl)
    add_state_job(pl)
    if perf_host:
        add_perf_job(pl, perf_host)
    dst = os.path.join(tree, 'System/Library/xpc/launchd.plist')
    os.makedirs(os.path.dirname(dst), exist_ok=True)
    with open(dst, 'wb') as f:
        f.write(plistlib.dumps(pl, fmt=plistlib.FMT_BINARY))
    os.chmod(dst, 0o644)
    return len(pl['LaunchDaemons'])


def build(src, work, tc=None, name=NAME, entitlements=None, frameworks=()):
    """Build + sign src under the final name `name`; every acceptance check must pass. Returns (path, [info lines]).
    entitlements: list of boolean-true entitlement keys put into the ad-hoc signature (ldid -S<plist>), re-read with `ldid -e`."""
    tc = tc or ds.toolchain()
    why = ds.toolchain_missing(tc)
    if why:
        raise Err('pixping-stage: cannot build, ' + why)
    if not os.path.isfile(src):
        raise Err('pixping-stage: no source ' + src)
    work = os.path.join(work, name)
    raw, final = os.path.join(work, 'raw'), os.path.join(work, 'final')
    for d in (raw, final):
        shutil.rmtree(d, ignore_errors=True)
        os.makedirs(d)
    out = os.path.join(final, name)
    fw = [a for f in frameworks for a in ('-framework', f)]
    p = ds.run([tc['clang'], '-target', 'arm64-apple-ios16.0', '-isysroot', tc['sdk'], '-O2', '-Wall', '-Wextra',
                '--ld-path=' + tc['ld'], '-o', os.path.join(raw, name), src] + fw, 'clang')
    info = []
    if p.stderr.strip():
        info.append('SWEET GAP: pixping-stage: clang printed %d warning line(s) for %s; first: %s'
                    % (len(p.stderr.strip().splitlines()), name, p.stderr.strip().splitlines()[0][:160]))
    shutil.copyfile(os.path.join(raw, name), out)
    os.chmod(out, 0o755)
    if entitlements:
        ent_file = os.path.join(work, name + '.entitlements.plist')
        with open(ent_file, 'wb') as f:
            f.write(entitlements_xml(entitlements))
        ds.run([tc['ldid'], '-Cadhoc', '-S' + ent_file, out], 'ldid -Cadhoc -S<entitlements>')
    else:
        ds.run([tc['ldid'], '-Cadhoc', '-S', out], 'ldid -Cadhoc -S')
    desc = ds.run(['file', '-b', out], 'file').stdout
    if 'Mach-O 64-bit arm64' not in desc:
        raise Fail('acceptance: file says "%s", want Mach-O 64-bit arm64' % desc.strip())
    vt = ds.run([tc['vtool'], '-show-build', out], 'vtool').stdout
    m = re.search(r'^\s*minos\s+(\d+)(?:\.(\d+))?', vt, re.M)
    if not m:
        raise Fail('acceptance: vtool shows no minos')
    minos = (int(m.group(1)), int(m.group(2) or 0))
    if minos > (16, 0):
        raise Fail('acceptance: minos %d.%d > 16.0' % minos)
    lh = ds.run([tc['ldid'], '-h', out], 'ldid -h').stdout
    if not re.search(r'flags=0x[0-9a-f]+\(adhoc\)', lh):
        raise Fail('acceptance: ldid -h shows no adhoc flag')
    if not re.search(r'^Identifier=%s$' % name, lh, re.M):
        raise Fail('acceptance: ldid -h Identifier is not ' + name)
    ents = ds.run([tc['ldid'], '-e', out], 'ldid -e').stdout
    for k in entitlements or ():
        if not re.search(r'<key>%s</key>\s*<true/>' % re.escape(k), ents):
            raise Fail('acceptance: ldid -e shows no %s = true in the signature' % k)
    if not entitlements and '<key>' in ents:
        raise Fail('acceptance: %s carries entitlements nobody asked for' % name)
    dis = ds.run([tc['objdump'], '-d', out], 'llvm-objdump').stdout
    bad = [l.strip() for l in dis.splitlines() if '\t' in l and ds.BAD_INSN.search(l.split('\t')[1])]
    if bad:
        raise Fail('acceptance: %d PAC/LDAPUR-class instruction(s), first: %s' % (len(bad), bad[0][:100]))
    data = open(out, 'rb').read()
    info.append('build: %s %d bytes sha256 %s minos %d.%d adhoc Identifier=%s, %d entitlement(s) in the signature, 0 PAC-class instructions'
                % (out, len(data), hashlib.sha256(data).hexdigest(), minos[0], minos[1], name, len(entitlements or ())))
    return out, info


def main(argv=None):
    ap = argparse.ArgumentParser(description=__doc__.split('\n')[0])
    ap.add_argument('--src', default=os.path.join(HERE, 'pixping.c'))
    ap.add_argument('--open-src', default=os.path.join(HERE, 'pixopen.c'))
    ap.add_argument('--state-src', default=os.path.join(HERE, 'pixstate.c'))
    ap.add_argument('--out-dir', default=os.environ.get('PIXPING_STAGE_OUT', DEFAULT_OUT))
    ap.add_argument('--launchd-base', help='plist from the flashed image to add the boot job to (never fetched)')
    ap.add_argument('--gateway', help='IPv4 to ping (default: environment variable PIXOS_WIFI_GW)')
    ap.add_argument('--perf-src', default=os.path.join(HERE, 'pixperf.c'))
    ap.add_argument('--net-src', default=os.path.join(HERE, 'pixnet.c'))
    ap.add_argument('--perf-host', help='LAN host running tools/pixperf-server (default: PIXOS_PERF_HOST); with it the boot job org.pixelios.pixperf is staged')
    a = ap.parse_args(argv)
    try:
        gw = check_gateway(a.gateway or os.environ.get('PIXOS_WIFI_GW', ''))
        out_dir = os.path.abspath(a.out_dir)
        if a.launchd_base and not os.path.isfile(a.launchd_base):
            raise Err('pixping-stage: --launchd-base %s is not a file' % a.launchd_base)
        os.makedirs(out_dir, exist_ok=True)
        binary, info = build(a.src, os.path.join(out_dir, 'build'))
        open_binary, open_info = build(a.open_src, os.path.join(out_dir, 'build'), name=OPEN_NAME,
                                       entitlements=OPEN_ENTITLEMENTS, frameworks=('CoreFoundation',))
        state_binary, state_info = build(a.state_src, os.path.join(out_dir, 'build'), name=STATE_NAME,
                                         entitlements=STATE_ENTITLEMENTS, frameworks=('CoreFoundation',))
        perf_binary, perf_info = build(a.perf_src, os.path.join(out_dir, 'build'), name=PERF_NAME)
        net_binary, net_info = build(a.net_src, os.path.join(out_dir, 'build'), name=NET_NAME, frameworks=('CoreFoundation', 'Security'))
        perf_host = a.perf_host or os.environ.get('PIXOS_PERF_HOST', '')
        perf_host = check_gateway(perf_host) if perf_host else None
        for l in info + open_info + state_info + perf_info + net_info:
            print(l)
        tree = os.path.join(out_dir, 'tree')
        shutil.rmtree(tree, ignore_errors=True)
        for nm, src in ((NAME, binary), (OPEN_NAME, open_binary), (STATE_NAME, state_binary), (PERF_NAME, perf_binary), (NET_NAME, net_binary)):
            dst = os.path.join(tree, 'usr/local/bin/' + nm)
            os.makedirs(os.path.dirname(dst), exist_ok=True)
            shutil.copyfile(src, dst)
            os.chmod(dst, 0o755)
        if a.launchd_base:
            n = stage_plist(a.launchd_base, tree, gw, perf_host)
            print('launchd: job %s (pixping -c 10 -s 200 -W 180 <gateway from PIXOS_WIFI_GW/--gateway, not printed>) added (%d jobs now)' % (JOB_KEY, n))
            print('launchd: job %s (mobile: %s) added' % (OPEN_JOB_KEY, ' '.join(open_job_args())))
            print('launchd: job %s (root: %s) added' % (STATE_JOB_KEY, ' '.join(state_job_args())))
            print('launchd: job %s (pixping -D %d -c 10 -s 1000 -W 120 <gateway, not printed>) added' % (JOB2_KEY, JOB2_DELAY))
            if perf_host:
                print('launchd: job %s (pixperf -D %d -W 300 -t 30 -u 20000 <perf host, not printed>) added' % (PERF_JOB_KEY, PERF_DELAY))
            else:
                print('SWEET GAP: pixping-stage: no PIXOS_PERF_HOST/--perf-host, pixperf boot job NOT staged (binary only, run it with tools/hot run)')
        else:
            print('SWEET GAP: pixping-stage: no launchd base given, boot job NOT staged')
        out_bin = os.path.join(out_dir, 'pixping-overlay.bin')
        ents, msg = ds.pack(tree, out_bin)
        print(msg)
        print('overlay: %s' % out_bin)
        print('xrun: tools/xrun --overlay %s --args "<usual args> %s"   (stdout of the jobs reaches the console as `|pixping| ...` and `|pixopen| ...` via patch 0048)'
              % (tree, BOOT_ARG))
        print('RESULT: PASS pixping-stage files=%d launchd=%s overlay=%s' % (len(ents), 'staged' if a.launchd_base else 'NOT-staged', out_bin))
        return 0
    except Fail as e:
        print('RESULT: FAIL ' + str(e))
        return 1
    except (Err, OSError, plistlib.InvalidFileException, ValueError) as e:
        print('RESULT: ERROR ' + str(e))
        return 2


if __name__ == '__main__':
    sys.exit(main())
