#!/usr/bin/env python3
"""Static analysis over the shim C (TP-014): cppcheck + clang-tidy-19 with the shim/build.sh flags. Read-only, no device.
  tools/lint-c [--files shim/a.c ...] [--strict] [--out DIR]
Default files: shim/*.c except *_host_test.c (host builds, hosted libc). Logs: shim/out/lint-c/.
--out DIR (relative to the repo root, default shim/out): where board_config.h / wlan_seq.h come from. The gate no longer refreshes shim/out, so after a gate
run use --out shim/out/gate/build-0 (a header from an old build is silently stale otherwise).
RESULT: PASS|FAIL|ERROR files=N findings=N   exit 0 clean / 1 findings / 2 tool or shim/out/board_config.h missing.
Findings = cppcheck error|warning|portability + every clang-tidy diagnostic (--strict adds cppcheck style).
Env (tests): LINT_ROOT, LINT_CPPCHECK, LINT_TIDY, LINT_TIMEOUT (s per tool per file).
Disabled on purpose: bugprone-easily-swappable-parameters (style noise on every uint32 register helper)."""
import argparse, glob, os, re, shutil, subprocess, sys

ROOT = os.environ.get("LINT_ROOT") or os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
# per-file -D from shim/build.sh (the code is compiled out without them)
EXTRA = {"wlansmc.c": ["-DWLAN_SMC_READ", "-DWLAN_ISO_RUN"], "wlanen.c": ["-DWLAN_EN_RUN"], "wlanlink.c": ["-DWLAN_LINK_RUN"],
         "gpurailon.c": ["-DGPU_RAIL_ON"], "gpujob.c": ["-DGPU_JOB"]}
TIDY_CHECKS = "-*,clang-analyzer-*,bugprone-*,-bugprone-easily-swappable-parameters"
DIAG = re.compile(r"^\S+?:\d+:(?:\d+:)? (error|warning)\b")
CPP = re.compile(r"^(\S+?):(\d+): (\w+): (.*)")


def run(cmd, log, timeout):
    try:
        p = subprocess.run(cmd, cwd=ROOT, capture_output=True, text=True, timeout=timeout)
        out, rc = p.stdout + p.stderr, p.returncode
    except subprocess.TimeoutExpired:
        out, rc = "TIMEOUT after %ss\n" % timeout, 124
    with open(log, "a") as f:
        f.write("$ %s\n%s\n" % (" ".join(cmd), out))
    return out, rc


def main():
    ap = argparse.ArgumentParser(description=__doc__.split("\n")[0])
    ap.add_argument("--files", nargs="+")
    ap.add_argument("--strict", action="store_true")
    ap.add_argument("--out", default="shim/out")
    a = ap.parse_args()
    cpp = os.environ.get("LINT_CPPCHECK") or shutil.which("cppcheck")
    tidy = os.environ.get("LINT_TIDY") or shutil.which("clang-tidy-19") or shutil.which("clang-tidy")
    bc = os.path.join(ROOT, a.out, "board_config.h")
    miss = [n for n, v in (("cppcheck", cpp), ("clang-tidy", tidy)) if not v]
    if not os.path.exists(bc):
        miss.append("%s/board_config.h (python3 tools/boards.py bluejay %s/board_config.h, or --out shim/out/gate/build-0 after a gate run)" % (a.out, a.out))
    if miss:
        print("RESULT: ERROR missing: %s files=0 findings=0" % ", ".join(miss))
        return 2
    files = a.files or sorted(f for f in (os.path.relpath(p, ROOT) for p in glob.glob(os.path.join(ROOT, "shim/*.c")))
                              if not f.endswith(("_host_test.c", "host_test.c")))
    ld = os.path.join(ROOT, "shim/out/lint-c")
    os.makedirs(ld, exist_ok=True)
    to = int(os.environ.get("LINT_TIMEOUT", "180"))
    common = ["-DSOC_GS101=1", "-Ishim", "-I" + a.out]
    findings, style, lines = 0, 0, []
    for f in files:
        d = EXTRA.get(os.path.basename(f), [])
        inc = ["-I" + os.path.dirname(os.path.abspath(os.path.join(ROOT, f)))]  # a file outside shim/ finds its header
        log = os.path.join(ld, os.path.basename(f) + ".log")
        open(log, "w").close()
        out, rc = run([cpp, "--enable=warning,portability,style", "--quiet", "--template={file}:{line}: {severity}: {id}: {message}",
                       "--include=" + a.out + "/board_config.h"] + common + d + inc + [f], log, to)
        for l in out.splitlines():
            m = CPP.match(l)
            if not m:
                continue
            if m.group(3) == "style":
                style += 1
            elif m.group(3) != "information":
                findings += 1
                lines.append(l)
        if rc == 124:
            findings += 1
            lines.append("%s: cppcheck timeout" % f)
        out, rc = run([tidy, "--checks=" + TIDY_CHECKS, "--quiet", f, "--", "--target=aarch64-none-elf", "-ffreestanding", "-nostdlib",
                       "-include", a.out + "/board_config.h"] + common + d + inc, log, to)
        for l in out.splitlines():
            if DIAG.match(l) and "noipa" not in l:  # noipa: GCC-only attribute, clang warns
                findings += 1
                lines.append(l)
        if rc == 124:
            findings += 1
            lines.append("%s: clang-tidy timeout" % f)
    if a.strict:
        findings += style
    for l in lines[:3]:
        print(l[:200])
    if len(lines) > 3:
        print("... %d more in %s" % (len(lines) - 3, os.path.relpath(ld, ROOT)))
    print("cppcheck style notes: %d (%s); logs: %s" % (style, "counted" if a.strict else "not counted, --strict counts them", os.path.relpath(ld, ROOT)))
    print("RESULT: %s files=%d findings=%d" % ("PASS" if findings == 0 else "FAIL", len(files), findings))
    return 0 if findings == 0 else 1


sys.exit(main())
