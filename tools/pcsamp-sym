#!/usr/bin/env python3
"""pcsamp-sym: symbolise SWEET PCSAMP rows (patch 0263) of a run into per-thread function profiles (sprint-gpu 2026-11-08).

usage: tools/pcsamp-sym RUN_DIR [--from NS --to NS] [--action NAME] [--top N] [--jobs N]
  --action NAME   only the PCSAMP seconds whose t falls in [begin, begin + 1.5 s] of every repetition of that nav action
  --from/--to     only seconds with t in [from, to] (ns, the SWEET SWAPT/NAV clock)
Symbols: a pc inside libsweetgl (`SWEETGL: BASE pid P image B ... size S`) -> llvm-nm of the overlay dylib (PIXOS_SWEETGL_DYLIB, default
~/pixelios-artifacts/ov-34eb/usr/lib/libsweetgl.dylib); otherwise pc - slide (`SWEET PCSAMP: pid <p> P slide S`) -> `ipsw dyld a2s` on the
dyld cache (PIXOS_DSC, default ~/pixelios-artifacts/work/dsc/cache/dyld_shared_cache_arm64), cached in ~/pixelios-artifacts/work/pcsamp-a2s.json.
kind 2 rows (thread interrupted in the kernel) are listed as `[kernel] <user syscall site>` with the kernel pc.
Row keys are bb/sb/pf (backboardd SpringBoard Preferences) or, with boot-arg sweetpcsampproc=a,b,c (patch 0353), p0/p1/p2 named by the `SWEET PCSAMP: slots` line.
Unresolved pcs print as `?0x...` and are counted (never dropped).
"""
if __import__("sys").argv[1:2] in (["-h"], ["--help"]):  # T-7dff:help: usage before any import or side effect
    print("usage: " + __file__.rsplit("/", 1)[-1] + "\n" + (__doc__ or "").strip()); raise SystemExit(0)
import re, sys, os, json, bisect, subprocess, collections
from concurrent.futures import ThreadPoolExecutor

H = os.path.expanduser("~")
DYLIB = os.environ.get("PIXOS_SWEETGL_DYLIB", H + "/pixelios-artifacts/ov-34eb/usr/lib/libsweetgl.dylib")
DSC = os.environ.get("PIXOS_DSC", H + "/pixelios-artifacts/work/dsc/cache/dyld_shared_cache_arm64")
A2SC = os.path.join(os.path.dirname(DSC), "a2s.cache")
IPSW = os.environ.get("PIXOS_IPSW", H + "/pixelios-artifacts/tools/ipsw")
NM = os.environ.get("PIXOS_NM", "llvm-nm-19")
CACHE = H + "/pixelios-artifacts/work/pcsamp-a2s.json"

# header: `... hits H bb B sb S pf P entries ...` (default) or `... hits H p0 A p1 B p2 C entries ...` (boot-arg sweetpcsampproc, patch 0353): only the leading fields are read
HDR = re.compile(r"SWEET PCSAMP: t (\d+) rounds (\d+) reached (\d+) hits (\d+)")
SLOTS = re.compile(r"SWEET PCSAMP: slots p0=(\S+) p1=(\S+) p2=(\S+)")
ROW = re.compile(r"SWEET PCSAMP: pc (\w+) 0x([0-9a-f]+) k (\d) pc 0x([0-9a-f]+) lr 0x([0-9a-f]+) kpc 0x([0-9a-f]+) n (\d+)")
TID = re.compile(r"SWEET PCSAMP: tid (\w+) 0x([0-9a-f]+) n (\d+) user (\d+)")
SLD = re.compile(r"SWEET PCSAMP: pid (\w+) (\d+) slide 0x([0-9a-f]+)")
BASE = re.compile(r"\|(\w+)\| SWEETGL: BASE pid (\d+) image 0x([0-9a-f]+) slide 0x[0-9a-f]+ size (\d+)")
ACT = re.compile(r"SWEET NAV: ACTION (\S+) begin rep (\d+) now (\d+)")
PNAME = {"backboardd": "bb", "SpringBoard": "sb", "Preferences": "pf"}


def nm_table(path):
    out = subprocess.run([NM, "-n", "--defined-only", path], capture_output=True, text=True).stdout
    addrs, names = [], []
    for l in out.splitlines():
        p = l.split()
        if len(p) >= 3 and p[1] in "tT":
            addrs.append(int(p[0], 16))
            names.append(p[2])
    return addrs, names


def a2s(addr, cache):
    k = "%x" % addr
    if k in cache:
        return cache[k]
    r = subprocess.run([IPSW, "dyld", "a2s", DSC, "--cache", A2SC, "0x" + k], capture_output=True, text=True)
    m = re.search(r"0x[0-9a-f]+: (.+)$", r.stdout.strip().splitlines()[-1] if r.stdout.strip() else "")
    v = re.sub(r" \+ \d+$", "", m.group(1)) if m else None
    cache[k] = v
    return v


def main(argv):
    if not argv or argv[0] in ("-h", "--help"):
        print(__doc__)
        return 0 if argv else 2
    run = argv[0]
    opt = {argv[i]: argv[i + 1] for i in range(1, len(argv) - 1) if argv[i].startswith("--")}
    top = int(opt.get("--top", "25"))
    lo, hi = int(opt.get("--from", "0")), int(opt.get("--to", str(1 << 63)))
    secs, slides, bases, acts = parse(open(os.path.join(run, "usbnet.log"), "rb"))
    if not secs:
        print("RESULT: FAIL pcsamp-sym no SWEET PCSAMP rows (boot-arg sweetpcsamp=N on a 0263 kernel)")
        return 1
    return report(run, opt, top, lo, hi, secs, slides, bases, acts)


def parse(lines):
    """usbnet.log lines (bytes or str) -> (secs, slides, bases, acts). Row keys are bb/sb/pf or, with a `slots` line, p0/p1/p2; the SWEETGL BASE
    process names are mapped to the row key the same way (default names unless a slots line was seen)."""
    secs, slides, braw, acts = [], {}, {}, collections.defaultdict(list)
    pname = dict(PNAME)
    cur = None
    for raw in lines:
        l = raw.decode("utf-8", "replace") if isinstance(raw, bytes) else raw
        m = SLOTS.search(l)
        if m:
            pname = {m.group(i + 1): "p%d" % i for i in range(3) if m.group(i + 1) != "-"}
            continue
        m = HDR.search(l)
        if m:
            cur = {"t": int(m.group(1)), "rows": [], "tids": []}
            secs.append(cur)
            continue
        m = ROW.search(l)
        if m and cur is not None:
            cur["rows"].append((m.group(1), m.group(2), int(m.group(3)), int(m.group(4), 16), int(m.group(5), 16), int(m.group(6), 16), int(m.group(7))))
            continue
        m = TID.search(l)
        if m and cur is not None:
            cur["tids"].append((m.group(1), m.group(2), int(m.group(3)), int(m.group(4))))
            continue
        m = SLD.search(l)
        if m:
            slides[m.group(1)] = int(m.group(3), 16)
            continue
        m = BASE.search(l)
        if m:
            braw[m.group(1)] = (int(m.group(3), 16), int(m.group(4)))
            continue
        m = ACT.search(l)
        if m:
            acts[m.group(1)].append(int(m.group(3)))
    bases = {pname.get(n, n): v for n, v in braw.items()}
    return secs, slides, bases, acts


def report(run, opt, top, lo, hi, secs, slides, bases, acts):
    # a PCSAMP header carries the END of its second: the samples are in (t - 1 s, t]
    if "--action" in opt:
        wins = [(b, b + 1500_000_000) for b in acts.get(opt["--action"], [])]
        if not wins:
            print(f"RESULT: FAIL pcsamp-sym no `SWEET NAV: ACTION {opt['--action']} begin` marker")
            return 1
        sel = [s for s in secs if any(s["t"] - 1_000_000_000 < w1 and s["t"] > w0 for w0, w1 in wins)]
    else:
        sel = [s for s in secs if lo <= s["t"] <= hi]
    addrs, names = nm_table(DYLIB)
    cache = json.load(open(CACHE)) if os.path.exists(CACHE) else {}
    need = set()
    for s in sel:
        for p, tid, k, pc, lr, kpc, n in s["rows"]:
            b = bases.get(p)
            if pc and not (b and b[0] <= pc < b[0] + b[1]) and p in slides:
                need.add(pc - slides[p])
    with ThreadPoolExecutor(int(opt.get("--jobs", "8"))) as ex:
        list(ex.map(lambda a: a2s(a, cache), sorted(need)))
    os.makedirs(os.path.dirname(CACHE), exist_ok=True)
    json.dump(cache, open(CACHE, "w"))

    def sym(p, pc):
        if pc == 0:
            return "?0"
        b = bases.get(p)
        if b and b[0] <= pc < b[0] + b[1]:
            off = pc - b[0]
            i = bisect.bisect_right(addrs, off) - 1
            return ("sweetgl:" + names[i]) if i >= 0 else "sweetgl:?0x%x" % off
        if p in slides:
            v = cache.get("%x" % (pc - slides[p]))
            return v if v else "?0x%x" % (pc - slides[p])
        return "?0x%x(noslide)" % pc

    prof = collections.defaultdict(collections.Counter)
    tot = collections.Counter()
    unres = 0
    for s in sel:
        for p, tid, k, pc, lr, kpc, n in s["rows"]:
            f = sym(p, pc)
            if f.startswith("?"):
                unres += n
            key = f if k == 1 else "[kernel kpc 0x%x] via %s" % (kpc, f)
            prof[(p, tid)][key] += n
            tot[(p, tid)] += n
    hits = sum(int(HDR.search(f"SWEET PCSAMP: t {s['t']} rounds 0 reached 0 hits 0").group(4)) for s in sel)  # placeholder 0
    print(f"run {run}: seconds {len(sel)} of {len(secs)}, rows-samples {sum(tot.values())}, unresolved {unres}")
    for (p, tid), n in tot.most_common(8):
        print(f"== {p} 0x{tid}: {n} samples (top-row share of the per-second tables)")
        for f, c in prof[(p, tid)].most_common(top):
            print(f"  {c:6d} {100.0 * c / n:5.1f}%  {f}")
    print(f"RESULT: PASS pcsamp-sym seconds={len(sel)} samples={sum(tot.values())} unresolved={unres}")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
