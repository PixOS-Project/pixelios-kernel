#!/bin/bash
# Tracked shell scripts (*.sh, or a sh/bash/dash shebang on line 1), one path per line, relative to the repo root.
# Used by the gate's `shellcheck` step and by tools/test_shellcheck_step.py: the one place that defines "a shell script here".
cd "$(dirname "$0")/.." || exit 2
{
	git ls-files '*.sh'
	git grep -nIE '^#!' -- . | grep -E ':1:#![[:space:]]*(/usr/bin/env[[:space:]]+)?(/[a-z/]*/)?(ba|da)?sh([[:space:]]|$)' | cut -d: -f1
} | sort -u | while IFS= read -r f; do [ -f "$f" ] && echo "$f"; done
