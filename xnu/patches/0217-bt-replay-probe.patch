+static void
+sbu_replay_probe(void)
+{
+	static const uint8_t par_rnd[7] = { 0x00, 0xe0, 0x01, 0x30, 0x00, 0x01, 0x00 };    /* bluetoothd's LE Set Scan Parameters, bt-up4/5 trace */
+	static const uint8_t par_off[2] = { 0x00, 0x00 };                                    /* LE Set Scan Enable: off (witness only, never enable) */
+	uint8_t par[255], rp[SBU_PM_SUPP], none[1] = { 0 }, st, s7, sb;
+	size_t rpn;
+	unsigned timeouts = 0, ran = 0, flip = 0, trunc = 0;
+	uint16_t flip_op = 0;
+	int e;
+
+	printf("BT PROBE: replay start (sweetbtleprobe=2, patch 0217): %zu steps of bluetoothd's bt-up5 instance-1 command sequence, 0x2007 after each; replay timing differs from bluetoothd (sequential, each answer awaited)\n", SBU_RM_N);
+	if ((e = sbu_cmd(0x2007, none, 0, &s7, rp, sizeof(rp), &rpn)) == 0) {
+		printf("BT PROBE: replay pos=0 baseline (unbooted ROM after the baud-probe Reset) 2007 status=%#04x (%s)\n", s7, sbu_pstatus(s7));
+	} else {
+		timeouts++;
+		printf("BT PROBE: replay pos=0 baseline 2007 NO ANSWER (error %d)\n", e);
+	}
+	for (size_t i = 0; i < SBU_RM_N; i++) {
+		const struct sbu_rstep *r = &sbu_rm[i];
+		unsigned pos = (unsigned)i + 1;
+		size_t known;
+		char hex[8 * 3 + 1];
+		size_t shown;
+
+		memset(par, 0, sizeof(par));
+		known = sbu_hexparse(r->hex, par, sizeof(par));
+		if (known == (size_t)-1 || known > r->plen) {
+			SBU_GAP(SG_OTHER, "replay pos=%u op=0x%04x: payload table row malformed (known %ld of %u); step skipped, the replay is incomplete", pos, r->op, (long)known, r->plen);
+			timeouts++;
+			continue;
+		}
+		if (known < r->plen) {
+			trunc++;
+			printf("BT PROBE: replay pos=%u op=0x%04x payload truncated: %zu of %u bytes known from the bt-up5 trace, the rest is zero (fidelity gap, not a byte-exact replay)\n", pos, r->op, known, r->plen);
+		}
+		shown = r->plen < 8 ? r->plen : 8;
+		for (size_t k = 0; k < shown; k++) {
+			snprintf(hex + 3 * k, 4, "%02x ", par[k]);
+		}
+		hex[3 * shown] = 0;
+		st = 0xff;
+		s7 = 0xff;
+		ran++;
+		if ((e = sbu_cmd(r->op, par, r->plen, &st, rp, sizeof(rp), &rpn)) != 0) {
+			timeouts++;
+			printf("BT PROBE: replay pos=%u op=0x%04x plen=%u par=[%s%s] NO ANSWER (error %d)\n", pos, r->op, r->plen, hex, r->plen > shown ? "..." : "", e);
+		}
+		ran++;
+		if ((e = sbu_cmd(0x2007, none, 0, &s7, rp, sizeof(rp), &rpn)) != 0) {
+			timeouts++;
+			printf("BT PROBE: replay pos=%u after op=0x%04x 2007 NO ANSWER (error %d)\n", pos, r->op, e);
+			continue;
+		}
+		printf("BT PROBE: replay pos=%u op=0x%04x plen=%u par=[%s%s] status=%#04x (%s) then 2007 status=%#04x (%s)%s\n", pos, r->op, r->plen, hex, r->plen > shown ? "..." : "", st, sbu_pstatus(st), s7, sbu_pstatus(s7),
+		    s7 == 0x0c ? " DISALLOWED" : "");
+		if (s7 != 0 && flip == 0) {
+			flip = pos;
+			flip_op = r->op;
+			printf("BT PROBE: first-disallowed-after=%u op=0x%04x (2007 status %#04x)\n", pos, r->op, s7);
+			/* witnesses at the flip: bluetoothd's own 0x200b, and Scan Enable OFF once (status 0 would mean a scan is running, 0x0c is the matrix baseline) */
+			sb = 0xff;
+			ran++;
+			if (sbu_cmd(0x200b, par_rnd, 7, &sb, rp, sizeof(rp), &rpn) == 0) {
+				printf("BT PROBE: at-flip 200b(bluetoothd random) status=%#04x (%s)\n", sb, sbu_pstatus(sb));
+			} else {
+				timeouts++;
+				printf("BT PROBE: at-flip 200b NO ANSWER\n");
+			}
+			sb = 0xff;
+			ran++;
+			if (sbu_cmd(0x200c, par_off, 2, &sb, rp, sizeof(rp), &rpn) == 0) {
+				printf("BT PROBE: at-flip 200c(scan enable OFF) status=%#04x (%s)\n", sb, sbu_pstatus(sb));
+			} else {
+				timeouts++;
+				printf("BT PROBE: at-flip 200c NO ANSWER\n");
+			}
+		}
+	}
+	if (flip == 0) {
+		/* H-B: no step flipped; bluetoothd's 0x200b came ~10 s after its 0x2007. Ask again after the last step, then after 25 s. */
+		sb = 0xff;
+		ran++;
+		if (sbu_cmd(0x200b, par_rnd, 7, &sb, rp, sizeof(rp), &rpn) == 0) {
+			printf("BT PROBE: no-flip after pos=%zu: 200b(bluetoothd random) status=%#04x (%s)\n", SBU_RM_N, sb, sbu_pstatus(sb));
+		} else {
+			timeouts++;
+			printf("BT PROBE: no-flip 200b NO ANSWER\n");
+		}
+		sbu.hw.msleep(25000);
+		s7 = sb = 0xff;
+		ran += 2;
+		if (sbu_cmd(0x2007, none, 0, &s7, rp, sizeof(rp), &rpn) == 0 && sbu_cmd(0x200b, par_rnd, 7, &sb, rp, sizeof(rp), &rpn) == 0) {
+			printf("BT PROBE: no-flip after 25 s wait: 2007 status=%#04x (%s) 200b status=%#04x (%s)\n", s7, sbu_pstatus(s7), sb, sbu_pstatus(sb));
+		} else {
+			timeouts++;
+			printf("BT PROBE: no-flip 25 s wait: NO ANSWER\n");
+		}
+	}
+	printf("BT PROBE: replay done: steps=%zu commands=%u no-answer=%u truncated-payloads=%u first-disallowed-after=%u op=0x%04x\n", SBU_RM_N, ran, timeouts, trunc, flip, flip_op);
+	if (timeouts != 0) {
+		SBU_GAP(SG_OTHER, "replay probe: %u steps got no answer or a malformed row; the bisect is incomplete", timeouts);
+	}
+}
