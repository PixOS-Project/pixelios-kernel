+/* "0b 00" -> bytes; returns the byte count, or (size_t)-1 on a malformed string (rule 8: the caller logs it, nothing is sent) */
+static size_t
+sbu_hexparse(const char *s, uint8_t *out, size_t max)
+{
+	size_t n = 0;
+
+	while (*s != 0) {
+		int hi, lo;
+
+		if (*s == ' ') {
+			s++;
+			continue;
+		}
+		hi = (s[0] >= '0' && s[0] <= '9') ? s[0] - '0' : (s[0] >= 'a' && s[0] <= 'f') ? s[0] - 'a' + 10 : -1;
+		lo = (hi < 0 || s[1] == 0) ? -1 : (s[1] >= '0' && s[1] <= '9') ? s[1] - '0' : (s[1] >= 'a' && s[1] <= 'f') ? s[1] - 'a' + 10 : -1;
+		if (lo < 0 || n >= max) {
+			return (size_t)-1;
+		}
+		out[n++] = (uint8_t)(hi << 4 | lo);
+		s += 2;
+	}
+	return n;
+}
