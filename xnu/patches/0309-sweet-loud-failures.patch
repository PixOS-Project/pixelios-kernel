+	*report = 0;
+	*full = 0;
+	lck_spin_lock(&sweet_null_lck);
+	for (i = 0; i < SWEET_NULL_SEEN; i++) {
+		if (sweet_null_seen[i].name[0] == 0 || strncmp(sweet_null_seen[i].name, name, sizeof(sweet_null_seen[i].name)) == 0) {
+			break;
+		}
+	}
+	if (i == SWEET_NULL_SEEN) {
+		sweet_null_full_drops++;
+		if ((sweet_null_full_drops & (sweet_null_full_drops - 1)) == 0) {
+			*full = sweet_null_full_drops;
+		}
+	} else {
+		if (sweet_null_seen[i].name[0] == 0) {
+			strlcpy(sweet_null_seen[i].name, name, sizeof(sweet_null_seen[i].name));
+		}
+		sweet_null_seen[i].writes++;
+		sweet_null_seen[i].bytes += c;
+		mirror = sweet_null_seen[i].writes <= SWEET_NULL_MIRROR;
+		uint32_t w = sweet_null_seen[i].writes;
+		if (w >= 10 && (w == 10 || w == 100 || w == 1000 || w == 10000 || w == 100000 || w == 1000000)) {
+			*report = w;
+			*bytes = sweet_null_seen[i].bytes;
+		}
+	}
+	lck_spin_unlock(&sweet_null_lck);
+	return mirror;
+}
