+/* 1 = mirror this write, 0 = counted only; *report = write count to print as a summary (0 = none), *full = table full (print once per drop power of 2) */
+static int
+sweet_null_unlisted(const char *name, user_size_t c, uint32_t *report, uint64_t *bytes, uint32_t *full)
+{
+	int i, mirror = 0;
