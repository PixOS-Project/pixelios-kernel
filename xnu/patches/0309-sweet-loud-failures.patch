+/*
+ * Patch 0309 (ALL-ON, user 2026-11-11 "errors must scream"; audit finding 2): wdt=-1 + this stub meant a userspace hang (watchdogd stops
+ * checking in: a deadlocked SpringBoard/backboardd or watchdogd itself) was noticed by nobody. The check-in interval of watchdogd on PixOS is
+ * not known (rule 6), so it is MEASURED: the 1st/10th/100th/... check-in logs the mean and the largest interval seen; a 30 s timer logs
+ * 'WDT GAP: no watchdogd check-in for N s' when the gap exceeds 3x the largest interval seen (at least 30 s), again each time the gap
+ * doubles. Detection only: nothing is reset (the SoC watchdog of patch 0278 is the kernel's own).
+ */
+static volatile uint64_t sweet_wdt_ci_n, sweet_wdt_ci_last, sweet_wdt_ci_first, sweet_wdt_ci_maxgap_ns;
+static uint64_t sweet_wdt_ci_reported_ns;
+static thread_call_t sweet_wdt_ci_call;
+
+static uint64_t
+sweet_wdt_now_ns(void)
+{
+	uint64_t ns;
+	absolutetime_to_nanoseconds(mach_absolute_time(), &ns);
+	return ns;
+}
+
+static void
+sweet_wdt_ci_check(__unused thread_call_param_t p0, __unused thread_call_param_t p1)
+{
+	uint64_t now = sweet_wdt_now_ns(), last = sweet_wdt_ci_last, mx = sweet_wdt_ci_maxgap_ns;
+	uint64_t lim = 3 * mx > 30000000000ULL ? 3 * mx : 30000000000ULL;
+
+	if (sweet_wdt_ci_n > 0 && now - last > lim && now - last > 2 * sweet_wdt_ci_reported_ns) {
+		sweet_wdt_ci_reported_ns = now - last;
+		IOLog("WDT GAP: no watchdogd check-in for %llu s (largest interval seen %llu ms, %llu check-ins): userspace hang? nothing resets it (wdt=-1, stub)\n",
+		    (now - last) / 1000000000ULL, mx / 1000000ULL, (unsigned long long)sweet_wdt_ci_n);
+	}
+	uint64_t dl;
+	clock_interval_to_deadline(30, NSEC_PER_SEC, &dl);
+	thread_call_enter_delayed(sweet_wdt_ci_call, dl);   /* every 30 s */
+}
 
