+ * once per name it could not track. Decisions under a spin lock, printing after it. sweetnull=- still turns the whole tee off.
+ */
+#define SWEET_NULL_SEEN 64
+#define SWEET_NULL_MIRROR 2
+static LCK_GRP_DECLARE(sweet_null_grp, "sweet_null");
