+	int nf_said[THW_NP] = { 0, 0, 0 }, trunc_said[THW_NP] = { 0, 0, 0 }, notask_said[THW_NP] = { 0, 0, 0 }, noregs_said[THW_NP] = { 0, 0, 0 }, seenfull_said[THW_NP] = { 0, 0, 0 };
