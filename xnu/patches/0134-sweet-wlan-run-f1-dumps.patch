+/* The firmware console: hnd_cons_t at cons (a shared-structure word): buffer address, size, write index (all read, range-checked). The text is the last min(size, SWW_CON_MAX) bytes before the write index, oldest first (DHD's
+ * order, dhd_pcie.c:4850-4852), read at most 16 words at a time and printed as lines. A pointer or size that fails the checks is reported and nothing is read: 0 (a refusal is not a stop), negative = stopped. */
+static inline int
+swl_f1_console(struct swl_wx *x, uint32_t sw, uint32_t cons)
+{
+	uint32_t end = SWW_RAM_BASE + x->ram_bytes, h[3], cw[16], buf, size, idx, len, p, left, wi, b, c, need, k, j;
+	struct swl_f1_ln ln = { { 0 }, 0, 0, 0 };
+	int rc;
+
+	if (!swl_f1_span_ok(end, sw, cons, SWW_CON_IDX + 4u)) {
+		printf("SWEET WLAN: F1 console pointer %#x is not a hnd_cons_t in the RAM window, not read\n", cons);
+		return 0;
+	}
+	rc = swl_f1_block(x, sw, cons + SWW_CON_BUF, 3, h);
+	if (rc != 0) {
+		return rc < 0 ? rc : 0;
+	}
+	buf = h[0];
+	size = h[1];
+	idx = h[2];
+	printf("SWEET WLAN: F1 console %#x: buffer %#x size %u write index %u\n", cons, buf, size, idx);
+	if (size == 0 || (size & 3u) != 0 || !swl_f1_span_ok(end, sw, buf, size)) {
+		printf("SWEET WLAN: F1 console buffer %#x size %u is not a word aligned part of the RAM window, not read\n", buf, size);
+		return 0;
+	}
+	if (idx > size) {                       /* review 0134 F5: DHD refuses a write index beyond the buffer as corrupt (dhd_pcie.c:4732-4734) */
+		printf("SWEET WLAN: F1 console write index %u beyond size %u (DHD refuses it), not read\n", idx, size);
+		return 0;
+	}
+	len = size < SWW_CON_MAX ? size : SWW_CON_MAX;
+	p = (idx % size + size - len) % size;
+	for (left = len; left != 0;) {
+		wi = p / 4u;
+		b = p % 4u;
+		need = (b + left + 3u) / 4u;
+		c = size / 4u - wi;
+		c = c < need ? c : need;
+		c = c < 16u ? c : 16u;
+		rc = swl_f1_block(x, sw, buf + 4u * wi, c, cw);
+		if (rc != 0) {
+			swl_f1_flush(&ln);
+			return rc < 0 ? rc : 0;
+		}
+		for (k = 0; k < c && left != 0; k++) {
+			for (j = k == 0 ? b : 0; j < 4u && left != 0; j++) {
+				swl_f1_put(&ln, (cw[k] >> (8u * j)) & 0xFFu);
+				left--;
+				p++;
+			}
+		}
+		if (p >= size) {
+			p -= size;
+		}
+	}
+	swl_f1_flush(&ln);
+	printf("SWEET WLAN: F1 console: %u bytes in %u lines, %u not printed\n", len, ln.lines + ln.dropped, ln.dropped);
+	x->f1 |= SWW_F1_CON;
+	return 0;
+}
+
+/* The host controller side, read only, no window needed: the ELBI interrupt status and enables, then the EP Command. Any RC interrupt enable that is on is the IRQ gate of W16 again (an interrupt line that could reach the GIC): a stop. */
+static inline int
+swl_f1_host(struct swl_wx *x)
+{
+	uint32_t rc0, rc1, rc2, en0, en1, en2, cmd;
+
+	SWW_RD(x, SWW_ELBI, 0, SWW_RC_IRQ0, rc0);
+	SWW_RD(x, SWW_ELBI, 0, SWW_RC_IRQ0 + 4u, rc1);
+	SWW_RD(x, SWW_ELBI, 0, SWW_RC_IRQ0 + 8u, rc2);
+	SWW_RD(x, SWW_ELBI, 0, SWW_RC_IRQ0_EN, en0);
+	SWW_RD(x, SWW_ELBI, 0, SWW_RC_IRQ1_EN, en1);
+	SWW_RD(x, SWW_ELBI, 0, SWW_RC_IRQ2_EN, en2);
+	printf("SWEET WLAN: F1 RC irq0 %#x/%#x irq1 %#x/%#x irq2 %#x/%#x\n", rc0, en0, rc1, en1, rc2, en2);
+	if ((en0 | en1 | en2) != 0) {
+		return swl_stop(x, SWW_E_IRQ);
+	}
+	x->f1 |= SWW_F1_ELBI;
+	SWW_RD(x, SWW_CFG, 0, 0x04u, cmd);
+	printf("SWEET WLAN: F1 EP command %#x\n", cmd);
+	x->f1 |= SWW_F1_CFG;
+	return 0;
+}
+
+/* The dongle's PCIe core registers (BAR0 window SWW_WIN_PCIE), read only, AFTER the re-halt of W17 (review 0134 F1: the window selects are the only stores F1 makes, so none is made while the CA7 runs, and a failed select cannot leave the CA7
+ * running: nothing is armed any more). The window goes back to the CA7 wrapper BEFORE the values are judged, so a value stop never leaves BAR0 on the PCIe page. Any all-ones read is a dead link; a mailbox mask that is not 0 is the IRQ gate
+ * of W16 again (the firmware could have written it; the PCIe core is not reset by the CA7 reset): a stop (the CA7 is already in reset, swl_w17 keeps the restore result). */
+static inline int
+swl_f1_pcie(struct swl_wx *x)
+{
+	uint32_t fi, fm, pi, mint, mask, pw;
+
+	SWW_TRY(swl_win(x, SWW_WIN_PCIE));
+	SWW_RD(x, SWW_BAR0, SWW_WIN_PCIE, SWW_PCI_FUNCINT, fi);
+	SWW_RD(x, SWW_BAR0, SWW_WIN_PCIE, SWW_PCI_FUNCINT + 4u, fm);
+	SWW_RD(x, SWW_BAR0, SWW_WIN_PCIE, SWW_PCI_PWRINT, pi);
+	SWW_RD(x, SWW_BAR0, SWW_WIN_PCIE, SWW_MBINT, mint);
+	SWW_RD(x, SWW_BAR0, SWW_WIN_PCIE, SWW_MBMASK, mask);
+	SWW_RD(x, SWW_BAR0, SWW_WIN_PCIE, SWW_SRPWR, pw);
+	SWW_TRY(swl_win(x, SWW_WIN_CA7WRAP));
+	printf("SWEET WLAN: F1 PCIe core funcint %#x funcmask %#x powerint %#x mailbox int %#x mask %#x srpwr %#x (after the re-halt)\n", fi, fm, pi, mint, mask, pw);
+	if (fi == 0xFFFFFFFFu || fm == 0xFFFFFFFFu || pi == 0xFFFFFFFFu || mint == 0xFFFFFFFFu || mask == 0xFFFFFFFFu || pw == 0xFFFFFFFFu) {
+		return swl_stop(x, SWW_E_DEAD);
+	}
+	if (mask != 0) {
+		return swl_stop(x, SWW_E_IRQ);
+	}
+	x->f1 |= SWW_F1_PCI;
+	return 0;
+}
+
+/* F1 proper, after W17 found the shared structure at sh (window sw) with flags fl: a firmware that reports ASSERT or TRAP is a stop (the restore re-halts). Then the host controller state, the whole shared structure (SWW_SH_WORDS words, fewer if
+ * the RAM or the window ends first), the two mailbox data words, the ring_info block and the five ring_mem entries it points to, the console; then the
+ * flags word once more (the poll for ASSERT/TRAP goes on during the dumps); the preconditions are re-checked before the console and before that last read (review 0134 F4). The PCIe core registers are read by W17 after the re-halt (swl_f1_pcie).
+ * A range that fails the checks is reported and skipped; F1 makes no store (the two BAR0 window selects are swl_f1_pcie's). 0 = done, negative = stopped. */
+static inline int
+swl_f1(struct swl_wx *x, uint32_t sh, uint32_t sw, uint32_t fl)
+{
+	uint32_t lim = swl_f1_lim(SWW_RAM_BASE + x->ram_bytes, sw), n, sd[SWW_SH_WORDS] = { 0 }, ri[SWW_RI_WORDS] = { 0 }, rm[SWW_RM_WORDS] = { 0 }, mb[2] = { 0 }, fl2, i;
+	int rc, ok0, ok1;
+
+	x->row = 17;
+	x->f1 = 0;
+	if ((fl & (SWW_SH_ASSERT | SWW_SH_TRAP)) != 0) {
+		printf("SWEET WLAN: F1 firmware flags %#x report assert/trap\n", fl);
+		return swl_stop(x, SWW_E_FWFAIL);
+	}
+	SWW_TRY(swl_f1_host(x));
+	if (swl_wpre(x)) {
+		return swl_stop(x, SWW_E_PRE);
+	}
+	n = sh < lim ? (lim - sh) / 4u : 0;
+	n = n < SWW_SH_WORDS ? n : SWW_SH_WORDS;
+	rc = swl_f1_block(x, sw, sh, n, sd);
+	if (rc < 0) {
+		return rc;
+	}
+	if (rc == 0) {
+		printf("SWEET WLAN: F1 shared structure %#x, %u of %u words\n", sh, n, SWW_SH_WORDS);
+		swl_f1_dump("shared", sd, n);
+		x->f1 |= SWW_F1_SH;
+	} else {
+		printf("SWEET WLAN: F1 shared structure %#x is not a readable range, not read\n", sh);
+	}
+	ok0 = swl_f1_block(x, sw, sd[SWW_SH_H2D_MB], 1, &mb[0]);
+	ok1 = ok0 != 0 ? ok0 : swl_f1_block(x, sw, sd[SWW_SH_D2H_MB], 1, &mb[1]);
+	if (ok0 < 0 || ok1 < 0) {
+		return ok0 < 0 ? ok0 : ok1;
+	}
+	if (ok0 == 0 && ok1 == 0) {
+		printf("SWEET WLAN: F1 mailbox data: host to dongle [%#x] = %#x, dongle to host [%#x] = %#x\n", sd[SWW_SH_H2D_MB], mb[0], sd[SWW_SH_D2H_MB], mb[1]);
+		x->f1 |= SWW_F1_MB;
+	} else {
+		printf("SWEET WLAN: F1 mailbox data pointers %#x %#x are not readable words, not read\n", sd[SWW_SH_H2D_MB], sd[SWW_SH_D2H_MB]);
+	}
+	rc = swl_f1_block(x, sw, sd[SWW_SH_RINGINFO], SWW_RI_WORDS, ri);
+	if (rc < 0) {
+		return rc;
+	}
+	if (rc == 0) {
+		printf("SWEET WLAN: F1 ring_info %#x\n", sd[SWW_SH_RINGINFO]);
+		swl_f1_dump("ring_info", ri, SWW_RI_WORDS);
+		x->f1 |= SWW_F1_RI;
+		rc = swl_f1_block(x, sw, ri[0], SWW_RM_WORDS, rm);
+		if (rc < 0) {
+			return rc;
+		}
+		if (rc == 0) {
+			for (i = 0; i < SWW_RM_N; i++) {
+				printf("SWEET WLAN: F1 ring_mem %u: idx %u type %u max_item %u len_items %u base %08x%08x\n", i, rm[4u * i] & 0xFFFFu, (rm[4u * i] >> 16) & 0xFFu, rm[4u * i + 1u] & 0xFFFFu, rm[4u * i + 1u] >> 16, rm[4u * i + 3u], rm[4u * i + 2u]);
+			}
+			x->f1 |= SWW_F1_RM;
+		} else {
+			printf("SWEET WLAN: F1 ringmem_ptr %#x is not a readable range, not read\n", ri[0]);
+		}
+	} else {
+		printf("SWEET WLAN: F1 rings_info_ptr %#x is not a readable range, not read\n", sd[SWW_SH_RINGINFO]);
+	}
+	if (swl_wpre(x)) {                      /* review 0134 F4: the firmware may have turned on bus mastering during the ~1100 reads */
+		return swl_stop(x, SWW_E_PRE);
+	}
+	SWW_TRY(swl_f1_console(x, sw, sd[SWW_SH_CONSOLE]));
+	if (swl_wpre(x)) {
+		return swl_stop(x, SWW_E_PRE);
+	}
+	SWW_RD(x, SWW_BAR2, sw, sh - sw, fl2);
+	if (fl2 == 0xFFFFFFFFu) {
+		return swl_stop(x, SWW_E_DEAD);
+	}
+	printf("SWEET WLAN: F1 flags %#x before the dumps, %#x after\n", fl, fl2);
+	if ((fl2 & (SWW_SH_ASSERT | SWW_SH_TRAP)) != 0) {
+		return swl_stop(x, SWW_E_FWFAIL);
+	}
+	printf("SWEET WLAN: F1 done mask %#x\n", x->f1);
+	return 0;
+}
+
 /* W17: the CA7 ran for the first time. Poll the shared-area word (ram_end - 4, the token until the firmware replaces it) 100 times, 50 ms apart (OpenBSD if_bwfm_pci.c:866-883; DHD
  * dhd_pcie.c:13637-13705: loop while the word is 0 or the token, all-ones is the link-down error): every change is printed. A shared address must be 4-aligned and inside [SWW_RAM_BASE, ram_end - 4); its first word
  * is read (the version byte is printed, a version outside 5..7 only logged). A timeout prints the last word and the CA7 wrapper state and stops. Whatever happens the run ends with the stop action
@@ -1636,6 +1968,9 @@ swl_w17(struct swl_wx *x)
 	x->version = fl & SWW_VER_MASK;
 	printf("SWEET WLAN: W17 shared structure bp %#x after %u polls: flags 0x%08x version %u%s\n", sh, x->polls, fl, x->version,
 	       x->version < SWW_VER_MIN || x->version > SWW_VER_MAX ? " (outside 5..7, not accepted by DHD)" : "");
+	if (x->level >= SWW_F1_LEVEL) {         /* run F1 (patch 0134): read-only dumps of the running firmware, then the same stop action */
+		SWW_TRY(swl_f1(x, sh, sw, fl));
+	}
 	swl_restore(x);
 	x->halted = x->ca_ok;
 	if (!x->halted) {
@@ -1644,6 +1979,14 @@ swl_w17(struct swl_wx *x)
 		printf("SWEET WLAN: W17 STOP: %s (code %d), restore=%s\n", swl_ename(SWW_E_HALT), SWW_E_HALT, swl_rsname(x->restore));
 		return -SWW_E_HALT;
 	}
+	if (x->level >= SWW_F1_LEVEL && x->restore == SWW_RS_OK) {   /* run F1 (review 0134 F1): the PCIe core group with the CA7 in reset */
+		int rs = x->restore, rc = swl_f1_pcie(x);
+
+		if (rc) {
+			x->restore = rs;        /* the stop's own swl_restore found nothing armed and wrote SWW_RS_NONE; the CA7 restore above held */
+			return rc;
+		}
+	}
 	x->flags |= SWF_W17;
 	return 0;
 }
