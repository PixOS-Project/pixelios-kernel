+/* ---- run F1 (patch 0134): read-only dumps of the running firmware, between the poll and the re-halt of W17 ---- */
+
+/* the first backplane address the BAR2 window `sw` (cfg 0x84) does not reach, or the end of the RAM (ram_end) if that comes first */
+static inline uint32_t
+swl_f1_lim(uint32_t end, uint32_t sw)
+{
+	return sw + SWW_TCM_BYTES < end ? sw + SWW_TCM_BYTES : end;
+}
+
+/* 1 when [addr, addr + bytes) is a non-empty, word aligned part of the RAM [SWW_RAM_BASE, ram_end) that the window `sw` reaches. Every pointer the firmware hands over goes through this before it is read (no address wraps: the
+ * comparisons are against lim - addr). The window is the one W17 already selected: no store is made for a pointer outside it (it is reported as not read). */
+static inline int
+swl_f1_span_ok(uint32_t end, uint32_t sw, uint32_t addr, uint32_t bytes)
+{
+	uint32_t lim = swl_f1_lim(end, sw);
+
+	return bytes != 0 && (addr & 3u) == 0 && (bytes & 3u) == 0 && addr >= SWW_RAM_BASE && addr >= sw && addr < lim && bytes <= lim - addr;
+}
+
+/* n words at the backplane address addr through the window sw into out[0..n); 0 = read, 1 = refused by swl_f1_span_ok (nothing read), negative = stopped (swl_stop ran). A block of 2 or more words that is all ones is a dead link: stop. */
+static inline int
+swl_f1_block(struct swl_wx *x, uint32_t sw, uint32_t addr, uint32_t n, uint32_t *out)
+{
+	uint32_t i, v, ones = 0;
+
+	if (x->level < SWW_F1_LEVEL) {
+		return swl_stop(x, SWW_E_LEVEL);
+	}
+	if (n == 0 || n > 1024u || !swl_f1_span_ok(SWW_RAM_BASE + x->ram_bytes, sw, addr, 4u * n)) {
+		return 1;
+	}
+	for (i = 0; i < n; i++) {
+		SWW_RD(x, SWW_BAR2, sw, addr + 4u * i - sw, v);
+		ones += v == 0xFFFFFFFFu;
+		out[i] = v;
+	}
+	if (n >= 2u && ones == n) {
+		printf("SWEET WLAN: F1 %u words at %#x are all ones\n", n, addr);
+		return swl_stop(x, SWW_E_DEAD);
+	}
+	return 0;
+}
+
+/* one line of up to 4 words: "SWEET WLAN: F1 <tag> +0x<byte offset>: w w w w" */
+static inline void
+swl_f1_row(const char *tag, uint32_t off, const uint32_t *w, uint32_t n)
+{
+	char b[4 * 9 + 1];
+	uint32_t i, k, p = 0;
+
+	for (i = 0; i < n && i < 4u; i++) {
+		b[p++] = ' ';
+		for (k = 0; k < 8u; k++) {
+			b[p++] = "0123456789abcdef"[(w[i] >> (28u - 4u * k)) & 0xFu];
+		}
+	}
+	b[p] = 0;
+	printf("SWEET WLAN: F1 %s +0x%03x:%s\n", tag, off, b);
+}
+
+static inline void
+swl_f1_dump(const char *tag, const uint32_t *w, uint32_t n)
+{
+	uint32_t i;
+
+	for (i = 0; i < n; i += 4u) {
+		swl_f1_row(tag, 4u * i, w + i, n - i < 4u ? n - i : 4u);
+	}
+}
+
+struct swl_f1_ln { char b[SWW_CON_LINE + 1]; uint32_t n, lines, dropped; };
+
+static inline void
+swl_f1_flush(struct swl_f1_ln *l)
+{
+	if (l->n != 0) {
+		if (l->lines < SWW_CON_LINES) {
+			l->b[l->n] = 0;
+			printf("SWEET WLAN: F1 con: %s\n", l->b);
+			l->lines++;
+		} else {
+			l->dropped++;
+		}
+		l->n = 0;
+	}
+}
+
+/* one console byte: LF ends a line, CR and NUL are dropped, anything else outside printable ASCII is shown as '.', a long line is wrapped */
+static inline void
+swl_f1_put(struct swl_f1_ln *l, uint32_t c)
+{
+	if (c == '\n') {
+		swl_f1_flush(l);
+		return;
+	}
+	if (c == 0 || c == '\r') {
+		return;
+	}
+	if (l->n == SWW_CON_LINE) {
+		swl_f1_flush(l);
+	}
+	l->b[l->n++] = c >= 0x20u && c < 0x7Fu ? (char)c : '.';
+}
