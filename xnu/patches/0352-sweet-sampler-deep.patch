 static char sweet_sample_names[128];
 
+/* SMP_CORE_BEGIN: pure parts, compiled by tools/test_sweet_sample_core.py on the host */
+#define SMP_FIRST_S      90      /* first sample after start, seconds */
+#define SMP_IV_DEF       120     /* sweetsampleiv default, seconds */
+#define SMP_IV_MIN       5
+#define SMP_IV_MAX       600
+#define SMP_MAX_DEF      40      /* sweetsamplemax default */
+#define SMP_MAX_MIN      1
+#define SMP_MAX_MAX      60
+#define SMP_ROW_LIM      200     /* every printed row is shorter than this */
+#define SMP_ROW_ADDRS    8       /* addresses per row at most */
+#define SMP_ADDR_LEN     19      /* " 0x" + 16 hex digits, the longest address */
+
+/* Plain decimal s in [lo, hi] -> 0 and *out = value. Anything else (empty, sign, hex,
+ * trailing text, out of range) -> -1 and *out = def. */
+static int
+sweet_sample_dec(const char *s, int lo, int hi, int def, int *out)
+{
+	long v = 0;
+	int nd = 0;
+	*out = def;
+	for (; s != NULL && *s >= '0' && *s <= '9'; s++, nd++) {
+		if (nd >= 6) {
+			return -1;
+		}
+		v = v * 10 + (*s - '0');
+	}
+	if (s == NULL || *s != '\0' || nd == 0 || v < lo || v > hi) {
+		return -1;
+	}
+	*out = (int)v;
+	return 0;
+}
+
+/* One row of the backtrace of thread tn, starting at frame k of bt[0..nbt-1]. The first row
+ * (first != 0) is the old format with pc/lr/sp, later rows carry "bt[k]". Returns how many
+ * frames went on the row (0 only if not even one fits, which the caller reports). */
+static int
+sweet_sample_row(char *buf, size_t sz, const char *name, int tn, uint64_t pc, uint64_t lr, uint64_t sp,
+    const uint64_t *bt, int nbt, int k, int first)
+{
+	int n, cnt = 0;
+	if (first) {
+		n = snprintf(buf, sz, "SMP %s t%d pc 0x%llx lr 0x%llx sp 0x%llx bt", name, tn,
+		    (unsigned long long)pc, (unsigned long long)lr, (unsigned long long)sp);
+	} else {
+		n = snprintf(buf, sz, "SMP %s t%d bt[%d]", name, tn, k);
+	}
+	if (n < 0 || n >= SMP_ROW_LIM) {
+		return 0;
+	}
+	while (k + cnt < nbt && cnt < SMP_ROW_ADDRS && n + SMP_ADDR_LEN < SMP_ROW_LIM && (size_t)(n + SMP_ADDR_LEN) < sz) {
+		n += snprintf(buf + n, sz - n, " 0x%llx", (unsigned long long)bt[k + cnt]);
+		cnt++;
+	}
+	return cnt;
+}
+/* SMP_CORE_END */
+
+/* Print the whole backtrace of one thread (osfmk/kern/exception.c, task lock held). */
+void sweet_sample_print_bt(const char *name, int tn, uint64_t pc, uint64_t lr, uint64_t sp, const uint64_t *bt, int nbt);
+
+void
+sweet_sample_print_bt(const char *name, int tn, uint64_t pc, uint64_t lr, uint64_t sp, const uint64_t *bt, int nbt)
+{
+	char row[SMP_ROW_LIM + 8];
+	int k = 0, got;
+	bool first = true;
+	do {
+		got = sweet_sample_row(row, sizeof(row), name, tn, pc, lr, sp, bt, nbt, k, first);
+		if (got == 0 && (!first || nbt > 0)) {
+			printf("SWEET GAP: sweetsample: %s t%d bt row cannot hold a frame, %d frame(s) dropped\n", name, tn, nbt - k);
+			if (first) {
+				/* still print the pc/lr/sp row, without frames */
+				(void)snprintf(row, sizeof(row), "SMP %s t%d pc 0x%llx lr 0x%llx sp 0x%llx bt", name, tn,
+				    (unsigned long long)pc, (unsigned long long)lr, (unsigned long long)sp);
+				printf("%s\n", row);
+			}
+			return;
+		}
+		printf("%s\n", row);
+		k += got;
+		first = false;
+	} while (k < nbt);
+}
+
+/* value of a boot-arg already read as a string (valid: found): decimal in [lo, hi], else GAP + def */
+static int
+sweet_sample_chk(const char *argname, const char *val, int lo, int hi, int def)
+{
+	int v;
+	if (sweet_sample_dec(val, lo, hi, def, &v) != 0) {
+		printf("SWEET GAP: %s=\"%s\" is not a decimal number in %d..%d, keeping the default %d\n", argname, val, lo, hi, def);
+	}
+	return v;
+}
