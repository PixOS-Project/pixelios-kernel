+
+	*en = rb[1];
+	printf("SWEET WLAN IRQ: attach INTID %u rc %d (SPI left disabled) group %u enabled %u icfgr %#x irouter %#x\n", SW_IRQ_INTID, r, rb[0], rb[1], rb[2], rb[3]);
+	return r;
+}
+
+static int
+sw_irq_spi_enable(void *cx __unused, uint32_t *en)
+{
+	return sweet_spi_enable(SW_IRQ_INTID, en);
+}
+
+static int
+sw_irq_spi_unmask(void *cx __unused)
+{
+	return sweet_spi_unmask(SW_IRQ_INTID);
+}
+
+static int
+sw_irq_spi_detach(void *cx __unused)
+{
+	return sweet_spi_detach(SW_IRQ_INTID);
+}
+
+/* every note of the core: the GAP texts are fixed strings (<= 63 chars, the key of the gap table) */
+static void
+sw_irq_note(void *cx __unused, int code, uint32_t a, uint32_t b)
+{
+	static const struct { int code; const char *txt; } t[] = {
+		{ SWI_G_GATE, "gate closed (link, DS state or bus), not armed" },
+		{ SWI_G_C34ORIG, "0xC34 is neither 0 nor 0xFFFF, not armed" },
+		{ SWI_G_RD, "a register read failed" },
+		{ SWI_G_WR, "a register write failed" },
+		{ SWI_G_REFUSED, "the swi judge refused an access" },
+		{ SWI_G_C30STUCK, "0xC30 not zero after ack and drain" },
+		{ SWI_G_ELBISTUCK, "IRQ0 bit 14 still set after its W1C" },
+		{ SWI_G_ENOTHER, "IRQ0_EN has bits other than 14 set" },
+		{ SWI_G_ATTACH, "GIC attach failed or SPI not left disabled" },
+		{ SWI_G_ENABLE, "GIC enable failed or not read back" },
+		{ SWI_G_VERIFY, "read-back differs from the value written" },
+		{ SWI_G_STORM, "storm, too many ISR entries in one second" },
+		{ SWI_G_NOIRQ, "200 poll passes found work, no interrupt" },
+		{ SWI_G_SPUR, "ISR entries without IRQ0 bit 14 in a row" },
+		{ SWI_G_ISRERR, "the ISR could not read or write ELBI" },
+		{ SWI_G_UNMASK, "SPI unmask failed" },
+		{ SWI_G_TEARDOWN, "a teardown step failed" },
+		{ SWI_G_EMPTY, "empty interrupts in a row (0xC30 0, no work): stuck line" },
+		{ SWI_G_GATECLOSE, "thread gate closed: no BAR0 access, SPI left masked" },
+		{ SWI_G_GATEOPEN, "thread gate open again, doorbell resumes" },
+	};
+	unsigned i;
+
+	if (code == SWI_N_STEP) {
+		printf("SWEET WLAN IRQ: arm step %u done (value %#x)\n", a, b);
+		return;
+	}
+	for (i = 0; i < sizeof t / sizeof t[0]; i++) {
+		if (t[i].code == code) {
+			swl_gap("irq", t[i].txt, "high");
+			printf("SWEET WLAN IRQ GAP: %s (a=%#x b=%#x)\n", t[i].txt, a, b);
+			return;
+		}
+	}
+	swl_gap("irq", "unknown note code", "high");
+	printf("SWEET WLAN IRQ GAP: unknown note code %d (a=%#x b=%#x)\n", code, a, b);
+}
+
+/* the doorbell mode went off (first time seen): one loud line, the poll goes on alone */
+static void
+sw_irq_report_off(void)
+{
+	if (sw_irq.why != SWI_Y_NONE && !sw_irq_reported) {
+		sw_irq_reported = 1;
+		swl_gap("irq", "doorbell mode off, polling only", "high");
+		printf("SWEET WLAN IRQ GAP: doorbell mode OFF (%s): ELBI IRQ0 bit 14 enable off, INTID %u detached, 0xC34 back to %#x; the 5 ms poll carries the data path alone\n", swi_mode_str(&sw_irq), SW_IRQ_INTID, sw_irq.c34_orig);
+	}
+}
+
+/* keep thread, before its loop (en0 is up): sweetwifiirq=1 runs the arm sequence under the lock; =2 only announces the read-only log */
+static void
+sw_irq_start(void)
+{
+	struct sw_hw *h = sw_gb.ctx;
+	int mode = sw_irq_mode(), r;
+
+	if (mode == 0 || h == NULL) {
+		return;
+	}
+	sw_irq_ops = (struct swi_ops){ .ctx = h, .rd = sw_irq_rd, .wr = sw_irq_wr, .gate = sw_irq_gate, .spi_attach_off = sw_irq_spi_attach, .spi_enable = sw_irq_spi_enable,
+		.spi_unmask = sw_irq_spi_unmask, .spi_detach = sw_irq_spi_detach, .drain = sw_irq_drain, .wake = sw_irq_wake, .note = sw_irq_note };
+	sw_irq_isr_ops = (struct swi_ops){ .ctx = h, .rd = sw_irq_isr_rd, .wr = sw_irq_isr_wr, .wake = sw_irq_wake };
+	if (mode == SWI_MODE_RO) {
+		printf("SWEET WLAN IRQ: sweetwifiirq=2 read-only logging: ELBI +0x000, +0x010 and BAR0 PCIe core +0xC30 are READ once a second while the link is up and the dongle awake; nothing is written, no interrupt is attached\n");
+		return;
+	}
+	if (!sw_irq_rows_on) {
+		swl_gap("irq", "doorbell rows missing, sweetwifiirq=1 off", "high");
+		printf("SWEET WLAN IRQ GAP: sweetwifiirq=1 without its bus-judge rows (see the line at list build): not armed\n");
+		sw_irq.mode = 0;
+		return;
+	}
+	sw_en0_lock();
+	r = swi_arm(&sw_irq, &sw_irq_ops);
+	sw_en0_unlock();
+	if (r == 0) {
+		printf("SWEET WLAN IRQ: doorbell ARMED: INTID %u (ELBI IRQ0_EN bit 14, GIC enabled, 0xC34 := 0xFFFF last), poll kept as fallback; irq storm limit %u/s, off after %u poll-found-work passes with no interrupt; the \"interrupts off\" GAP lines of D4b / EN7 / DP9 printed earlier are stale from here on\n", SW_IRQ_INTID, SWI_STORM_MAX, SWI_NOIRQ_MAX);
+	} else {
+		printf("SWEET WLAN IRQ GAP: arm refused at step %d (mode %s): teardown ran, the poll carries the data path alone\n", -r, swi_mode_str(&sw_irq));
+		sw_irq_report_off();
+	}
+}
+
+/* keep thread, lock held, before the drain: mode 1 = ack first (swi_pre); mode 2 = take the read-only sample when a second has passed (reads only). Returns 1 when a sample was taken (*ro filled), 2 when the gate skipped it */
+static int
+sw_irq_pre(struct swi_ro *ro, uint64_t *t_ro)
+{
+	static uint64_t iv;
+	uint64_t now;
+	int r;
+
+	if (sw_irq.mode == SWI_MODE_DB) {
+		(void)swi_pre(&sw_irq, &sw_irq_ops);
+		return 0;
+	}
+	if (sw_irq.mode != SWI_MODE_RO) {
+		return 0;
+	}
+	if (iv == 0) {
+		nanoseconds_to_absolutetime(NSEC_PER_SEC, &iv);
+	}
+	now = mach_absolute_time();
+	if (*t_ro != 0 && now - *t_ro < iv) {
+		return 0;
+	}
+	*t_ro = now;
+	r = swi_ro_sample(&sw_irq, &sw_irq_ops, ro);
+	return r == -1 ? 2 : 1;
+}
+
+/* keep thread, lock held, after the first drain (got items): mode 1 = the re-read loop, the unmask, the counters, the storm window; mode 2 = print the sample. Returns extra items drained */
+static uint32_t
+sw_irq_post(uint32_t got, int ro_have, const struct swi_ro *ro)
+{
+	uint32_t ex = 0;
+	uint64_t ns;
+
+	if (sw_irq.mode == SWI_MODE_DB) {
+		ex = swi_post(&sw_irq, &sw_irq_ops, got);
+		absolutetime_to_nanoseconds(mach_absolute_time(), &ns);
+		swi_tick(&sw_irq, &sw_irq_ops, (uint32_t)(ns / 1000000ull));
+		sw_irq_report_off();
+		return ex;
+	}
+	if (ro_have == 1) {
+		printf("SWEET WLAN IRQ: ro elbi0=%#x en0=%#x c30=%#x rings_work=%u%s\n", ro->elbi0, ro->en0, ro->c30, got != 0u ? 1u : 0u, ro->err != 0u ? " (a read failed: field 0xffffffff)" : "");
+		if (ro->err != 0u) {
+			swl_gap("irq", "ro sample read failed", "medium");
+		}
+	} else if (ro_have == 2) {
+		uint32_t n = sw_irq.ro_skip;
+
+		if ((n & (n - 1u)) == 0u) {       /* 1st, 2nd, 4th ... */
+			swl_gap("irq", "ro sample skipped, gate closed", "medium");
+			printf("SWEET WLAN IRQ GAP: ro sample skipped, link/DS/bus gate closed (x%u)\n", n);
+		}
+	}
+	return 0;
+}
+
+/* keep thread, outside the lock: the summary line every 5 s (both modes) */
+static void
+sw_irq_summary(uint64_t *t_irq5, uint64_t iv5)
+{
+	if (sw_irq.mode == 0 || mach_absolute_time() - *t_irq5 < iv5) {
+		return;
+	}
+	*t_irq5 = mach_absolute_time();
+	printf("SWEET WLAN IRQ: irqs %u missed %u spurious %u storm %u mode %s\n", sw_irq.irqs, sw_irq.missed, sw_irq.spurious, sw_irq.storm, swi_mode_str(&sw_irq));
+}
+
+/* the poll thread should not go to sleep over an interrupt that arrived during the pass (the ISR's wakeup came before the wait was asserted) */
+static int
+sw_irq_peek(void)
+{
+	return sw_irq.mode == SWI_MODE_DB && sw_irq.on && !sw_irq.gate_closed && (__atomic_load_n(&sw_irq.pend, __ATOMIC_ACQUIRE) != 0u || sw_irq.spurious != sw_irq.seen_spur);
+}
+
+/* every way out of the keep thread (sw_keep_end, lock held): study-check order, ELBI enable off, then SPI detach; no BAR0 access (the engine's own undo writes 0xC34 := 0 right after) */
+static void
+sw_irq_end(const char *why)
+{
+	uint64_t h = 0, u = 0;
+	uint32_t ul = 0;
+
+	if (sw_irq.mode != SWI_MODE_DB || sw_irq_ops.ctx == NULL || (!sw_irq.on && !sw_irq.elbi_on && !sw_irq.spi_att)) {
+		return;
+	}
+	swi_teardown(&sw_irq, &sw_irq_ops, 0);
+	if (sw_irq.why == SWI_Y_NONE) {
+		sw_irq.why = SWI_Y_END;
+	}
+	sweet_spi_counts(SW_IRQ_INTID, &h, &u, &ul);
+	printf("SWEET WLAN IRQ: end (%s): IRQ0 bit 14 enable off (left %u), INTID %u detached; irqs %u isr_total %u spurious %u missed %u acks %u unmasks %u refused %u gic_deferred %llu gic_unmasked %llu gic_unhandled %llu (last %u)\n", why,
+	    sw_irq.elbi_on, SW_IRQ_INTID, sw_irq.irqs, sw_irq.isr_total, sw_irq.spurious, sw_irq.missed, sw_irq.ack_writes, sw_irq.unmasks, sw_irq.refused, sweet_spi_deferred, sweet_spi_unmasked, u, ul);
+}
+
