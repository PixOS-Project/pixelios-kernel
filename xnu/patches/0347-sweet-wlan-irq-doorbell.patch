diff --git a/bsd/dev/sweet_wlan_irq.h b/bsd/dev/sweet_wlan_irq.h
new file mode 100644
index 0000000..c842c1e
--- /dev/null
+++ b/bsd/dev/sweet_wlan_irq.h
@@ -0,0 +1,677 @@
+/* sweet_wlan_irq.h - patch 0347 (lowclk 2026-11-13): the Wi-Fi INTx doorbell (stage A) and its read-only logging mode, behind boot-arg sweetwifiirq.
+ * Design notes: lowclk irq study as CORRECTED by study-check (ack order W1, enable order W2, threaded IRQ W3, shared SPI W4, link/DS W5, teardown order W6).
+ * sweetwifiirq absent or 0 = nothing in this file runs (every entry point returns before any hardware access). 2 = read-only logging: the only accesses are READS of
+ * ELBI+0x000, ELBI+0x010 and BAR0 PCIe core +0xC30, once a second. 1 = stage A: the corrected enable sequence, the ISR (ELBI only) and the thread (BAR0 only).
+ *
+ * The block between SWI_CORE_BEGIN and SWI_CORE_END is pure C (no kernel type, no printf, no MMIO): tools/test_wlan_irq_core.py compiles it with the host compiler
+ * and drives it with fake hardware. The kernel glue (struct swi_ops implementations, the SPI calls of patch 0346, the log lines) is in sweet_wlan.c.
+ *
+ * EVERY access goes through swi_io(): one table (swi_rows[], space/offset/access/mode) plus the value rules of swi_value_ok(), independent of the g2l[] judge of sweet_wlan.c
+ * (which has its own rows for the BAR0 words, added only for sweetwifiirq=1). A refused access is counted and never reaches the bus. Sources of each row: the comments below.
+ * Not run on hardware. */
+#ifndef SWEET_WLAN_IRQ_H
+#define SWEET_WLAN_IRQ_H
+
+#include <stddef.h>
+#include <stdint.h>
+
+/* SWI_CORE_BEGIN */
+/* Registers. ELBI offsets: Pixel kernel pcie-exynos-rc.h PCIE_IRQ0 +0x000 (status, bit 14 = INTA), PCIE_IRQ0_EN +0x010 (bit 14 = INTA enable) [read refs/wlan-stage1/dwc-whi/pcie-exynos-rc.h:19-20,31-32; study-check item 3, 4].
+ * BAR0 PCIe core: MAILBOXINT +0xC30 (write-1-to-clear), MAILBOXMASK +0xC34, D2H doorbell bits 0..15 = 0xFFFF [read bwfm-host/if_bwfm_pci.h:55-74, if_bwfm_pci.c:2426-2434; study-check item 8, 9]. */
+#define SWI_ELBI_IRQ0     0x000u
+#define SWI_ELBI_IRQ0_EN  0x010u
+#define SWI_INTA          0x4000u   /* IRQ0 bit 14: INTA assert (status) / INTA enable (EN) */
+#define SWI_MBX_INT       0xC30u
+#define SWI_MBX_MASK      0xC34u
+#define SWI_MBX_ALL       0xFFFFu
+
+enum { SWI_SP_ELBI = 1, SWI_SP_BAR0 };          /* BAR0 = the PCIe core page (window already cfg 0x80 = PCIe, enforced by the glue) */
+enum { SWI_R = 1, SWI_W = 2 };
+enum { SWI_MODE_0 = 0, SWI_MODE_DB = 1, SWI_MODE_RO = 2 };
+enum { SWI_ISR_DONE = 0, SWI_ISR_MASK = 1, SWI_ISR_DEFER = 2 };  /* handler returns: 2 = SWEET_SPI_DEFER of patch 0346 */
+enum { SWI_E_REFUSED = -100, SWI_E_IO = -101 };
+
+/* why the doorbell mode is off (st->why); 0 = not off */
+enum { SWI_Y_NONE = 0, SWI_Y_GATE, SWI_Y_ARM, SWI_Y_STORM, SWI_Y_NOIRQ, SWI_Y_C30, SWI_Y_SPUR, SWI_Y_ISR, SWI_Y_LINK, SWI_Y_END, SWI_Y_UNMASK, SWI_Y_REFUSED, SWI_Y_EMPTY };
+
+/* notes to the glue (it prints them; every GAP-class code is a loud line + swl_gap): code, a, b */
+enum {
+	SWI_N_STEP = 1,        /* informational: arm step a done, value b */
+	SWI_G_GATE = 100,      /* link not known up / dongle not awake / bus dead: nothing touched */
+	SWI_G_C34ORIG,         /* 0xC34 neither 0 nor 0xFFFF (a = value): not armed */
+	SWI_G_RD,              /* read failed (a = step) */
+	SWI_G_WR,              /* write failed (a = step) */
+	SWI_G_REFUSED,         /* the swi judge refused (a = space, b = offset) */
+	SWI_G_C30STUCK,        /* 0xC30 not zero after the ack/drain loop (a = last value) */
+	SWI_G_ELBISTUCK,       /* IRQ0 bit 14 still set after its W1C (a = value read) */
+	SWI_G_ENOTHER,         /* IRQ0_EN has bits other than 14 set (a = value): not armed */
+	SWI_G_ATTACH,          /* GIC attach rc (a = rc, b = enable read-back) */
+	SWI_G_ENABLE,          /* GIC enable rc (a = rc, b = enable read-back) */
+	SWI_G_VERIFY,          /* read-back differs (a = want, b = got) */
+	SWI_G_STORM,           /* more ISR entries in one second than SWI_STORM_MAX (a = entries) */
+	SWI_G_NOIRQ,           /* SWI_NOIRQ_MAX poll passes found ring work and no interrupt ever fired (a = passes) */
+	SWI_G_SPUR,            /* SWI_SPUR_MAX ISR entries in a row without IRQ0 bit 14 (a = count) */
+	SWI_G_ISRERR,          /* the ISR could not read or write ELBI, or the judge refused there (a = count) */
+	SWI_G_UNMASK,          /* sweet_spi_unmask failed (a = rc) */
+	SWI_G_TEARDOWN,        /* a teardown step failed (a = step: 1 ELBI read, 2 ELBI write, 3 detach, 4 restore 0xC34) */
+	SWI_G_EMPTY,           /* SWI_EMPTY_MAX interrupts in a row whose thread pass found 0xC30 == 0 and no ring work: a stuck line (a = run, b = irqs so far) */
+	SWI_G_GATECLOSE,       /* thread gate closed after arming (engine stopped / DS / dead bus / link): no BAR0 access, no unmask, SPI left masked (a = closes so far) */
+	SWI_G_GATEOPEN         /* thread gate open again (a = closes so far) */
+};
+
+#define SWI_ACK_TRIES   8u      /* ack/drain rounds per pass before 0xC30 is called stuck [decision] */
+#define SWI_STORM_MAX   5000u   /* ISR entries in a one-second window above which the mode turns itself off [guess: the busy poll runs at most every 100 us = 10000 passes/s, one interrupt per pass; half of it] */
+#define SWI_NOIRQ_MAX   200u    /* poll passes that found ring work while NO interrupt ever fired, then off (task order; same number as the GPU's "200 jobs without a JOB interrupt", patch 0272) */
+#define SWI_SPUR_MAX    3u      /* ISR entries without IRQ0 bit 14 in a row [decision] */
+#define SWI_EMPTY_MAX   64u     /* interrupts in a row whose thread pass finds 0xC30 == 0 and no ring work, then off BEFORE the unmask (review 0346 F1; the value is a decision, 64 x 250 us = 16 ms of spin at most) */
+
+struct swi_ops {
+	void *ctx;
+	int (*rd)(void *ctx, int sp, uint32_t off, uint32_t *v);       /* 0 = ok */
+	int (*wr)(void *ctx, int sp, uint32_t off, uint32_t v);        /* 0 = ok, store done and ordered */
+	int (*gate)(void *ctx);                                         /* 0 = link up, dongle awake, bus alive */
+	int (*spi_attach_off)(void *ctx, uint32_t *enabled_rb);         /* GIC attach, SPI left disabled; *enabled_rb = ISENABLER bit read back; 0 = ok */
+	int (*spi_enable)(void *ctx, uint32_t *enabled_rb);             /* 0 = ok */
+	int (*spi_unmask)(void *ctx);                                   /* 0 = ok */
+	int (*spi_detach)(void *ctx);
+	uint32_t (*drain)(void *ctx);                                   /* the existing ring work (ring 2 + rings 3/4), returns the items found; thread context, en0 lock held */
+	void (*wake)(void *ctx);                                        /* wake the keep thread (ISR safe) */
+	void (*note)(void *ctx, int code, uint32_t a, uint32_t b);
+};
+
+struct swi {
+	uint8_t mode;                   /* SWI_MODE_*, set once */
+	volatile uint8_t on;            /* the doorbell is armed: the ISR works; 0 again at the first teardown */
+	uint8_t why;                    /* SWI_Y_*: set once, by the first disable */
+	uint8_t elbi_on, spi_att, spi_en;      /* what this file changed and not yet undone */
+	uint8_t c34_known, en_valid, c30_valid;
+	uint32_t c34_orig, c34_cur;     /* 0xC34 at arm time (0 or 0xFFFF) and as this file left it */
+	uint32_t en_last, c30_last;     /* the last values read, the base of the value rules (valid flags above; a write consumes them) */
+	/* ISR-written (single writer = the interrupt on the boot CPU) */
+	volatile uint32_t isr_total, irqs, spurious, isr_err, isr_off;
+	volatile uint32_t refused;      /* swi_io refusals (judge), ISR or thread: atomic add */
+	volatile uint32_t pend;         /* set by the ISR, taken by the thread */
+	/* thread-written */
+	uint32_t seen, seen_spur, spur_run, p_pend, p_defer;
+	uint32_t missed, storm, work_events, ack_writes, unmasks, loops, extra_items, ro_n, ro_skip;
+	uint32_t win_ms, win_isr;
+	uint32_t p_c30, empty_run, gate_closes;     /* p_c30: the 0xC30 value swi_pre read this pass (0xFFFFFFFF = not read); empty_run: see SWI_EMPTY_MAX */
+	uint8_t gate_closed, owe_unmask;            /* gate closed at the last thread pass; an unmask the closed gate postponed */
+};
+
+struct swi_ro { uint32_t elbi0, en0, c30; uint32_t err; };
+
+struct swi_row { uint8_t sp, acc, modes; uint16_t off; };
+#define SWI_MB(m) ((uint8_t)(1u << (m)))
+/* THE allowlist of this feature (independent of the bus judge): exactly these accesses, in these modes. Writes also need swi_value_ok(). */
+static const struct swi_row swi_rows[] = {
+	{ SWI_SP_ELBI, SWI_R, SWI_MB(SWI_MODE_DB) | SWI_MB(SWI_MODE_RO), SWI_ELBI_IRQ0 },       /* latch-or-level question (U-A): status read */
+	{ SWI_SP_ELBI, SWI_W, SWI_MB(SWI_MODE_DB),                       SWI_ELBI_IRQ0 },       /* W1C of bit 14 only */
+	{ SWI_SP_ELBI, SWI_R, SWI_MB(SWI_MODE_DB) | SWI_MB(SWI_MODE_RO), SWI_ELBI_IRQ0_EN },    /* enable read */
+	{ SWI_SP_ELBI, SWI_W, SWI_MB(SWI_MODE_DB),                       SWI_ELBI_IRQ0_EN },    /* bit 14 set (arm) or clear (teardown) only */
+	{ SWI_SP_BAR0, SWI_R, SWI_MB(SWI_MODE_DB) | SWI_MB(SWI_MODE_RO), SWI_MBX_INT },         /* MAILBOXINT read */
+	{ SWI_SP_BAR0, SWI_W, SWI_MB(SWI_MODE_DB),                       SWI_MBX_INT },         /* W1C of the bits read in the same pass */
+	{ SWI_SP_BAR0, SWI_R, SWI_MB(SWI_MODE_DB),                       SWI_MBX_MASK },        /* MAILBOXMASK read (arm: orig value, read-back) */
+	{ SWI_SP_BAR0, SWI_W, SWI_MB(SWI_MODE_DB),                       SWI_MBX_MASK },        /* := 0 (mask) or := 0xFFFF (unmask, last) */
+};
+
+/* The value rules. 1 = allowed. old-based rules use the value this file read last (valid flag), never a guess. */
+static int
+swi_value_ok(const struct swi *st, int sp, uint32_t off, uint32_t v)
+{
+	if (sp == SWI_SP_ELBI && off == SWI_ELBI_IRQ0) {
+		return v == SWI_INTA;                                   /* W1C: bit 14 and nothing else (study-check W4: not the whole status word) */
+	}
+	if (sp == SWI_SP_ELBI && off == SWI_ELBI_IRQ0_EN) {
+		if (!st->en_valid) {
+			return 0;
+		}
+		return (v == (st->en_last | SWI_INTA) && (st->en_last & ~SWI_INTA) == 0u) || v == (st->en_last & ~SWI_INTA);   /* set bit 14 over an otherwise clear word, or clear bit 14 only */
+	}
+	if (sp == SWI_SP_BAR0 && off == SWI_MBX_INT) {
+		return st->c30_valid && v != 0u && (v & ~SWI_MBX_ALL) == 0u && (v & ~st->c30_last) == 0u;   /* only bits read in this pass */
+	}
+	if (sp == SWI_SP_BAR0 && off == SWI_MBX_MASK) {
+		if (v == 0u) {
+			return 1;
+		}
+		/* the rewritten F9 rule (review 0174-w-d4b-hwwrite-r1 F9 said: never unmask while an RC enable is set): unmask only when BOTH halves of the path are armed
+		 * (IRQ0 bit 14 enabled by us and the SPI enabled) or both are off (restore to the state before this file ran) */
+		return v == SWI_MBX_ALL && ((st->elbi_on && st->spi_en) || (!st->elbi_on && !st->spi_en));
+	}
+	return 0;
+}
+
+/* for the bus judge row of sweet_wlan.c: same rule as above */
+static int
+swi_ack_value_ok(const struct swi *st, uint32_t v)
+{
+	return swi_value_ok(st, SWI_SP_BAR0, SWI_MBX_INT, v);
+}
+
+static int
+swi_row_ok(const struct swi *st, int sp, int acc, uint32_t off)
+{
+	unsigned i;
+
+	for (i = 0; i < sizeof swi_rows / sizeof swi_rows[0]; i++) {
+		if (swi_rows[i].sp == sp && swi_rows[i].acc == acc && swi_rows[i].off == off && (swi_rows[i].modes & SWI_MB(st->mode)) != 0u) {
+			return 1;
+		}
+	}
+	return 0;
+}
+
+/* THE access: judge, then bus. A write consumes the value it was judged against (en_valid, c30_valid): the next write needs a new read. */
+static int
+swi_io(struct swi *st, const struct swi_ops *o, int sp, int acc, uint32_t off, uint32_t *v)
+{
+	int rc;
+
+	if (!swi_row_ok(st, sp, acc, off) || (acc == SWI_W && !swi_value_ok(st, sp, off, *v))) {
+		__atomic_fetch_add(&st->refused, 1u, __ATOMIC_RELAXED);
+		return SWI_E_REFUSED;
+	}
+	if (acc == SWI_R) {
+		rc = o->rd(o->ctx, sp, off, v);
+		if (rc != 0) {
+			return SWI_E_IO;
+		}
+		if (sp == SWI_SP_ELBI && off == SWI_ELBI_IRQ0_EN) {
+			st->en_last = *v;
+			st->en_valid = 1;
+		} else if (sp == SWI_SP_BAR0 && off == SWI_MBX_INT) {
+			st->c30_last = *v;
+			st->c30_valid = 1;
+		}
+		return 0;
+	}
+	rc = o->wr(o->ctx, sp, off, *v);
+	if (rc != 0) {
+		return SWI_E_IO;
+	}
+	if (sp == SWI_SP_ELBI && off == SWI_ELBI_IRQ0_EN) {
+		st->en_valid = 0;
+	} else if (sp == SWI_SP_BAR0 && off == SWI_MBX_INT) {
+		st->c30_valid = 0;
+	}
+	return 0;
+}
+
+/* ---- ISR (interrupt context: no lock, no print, ELBI only, the judge and nothing else) ---- */
+static int
+swi_isr(struct swi *st, const struct swi_ops *o)
+{
+	uint32_t s = 0, w = SWI_INTA;
+
+	if (!st->on) {
+		st->isr_off++;
+		return SWI_ISR_MASK;                    /* disabled or never armed: let the dispatcher mask the line (patch 0272 safety net) */
+	}
+	st->isr_total++;
+	if (swi_io(st, o, SWI_SP_ELBI, SWI_R, SWI_ELBI_IRQ0, &s) != 0) {
+		st->isr_err++;
+		return SWI_ISR_MASK;
+	}
+	if ((s & SWI_INTA) == 0u) {
+		st->spurious++;                         /* not ours (IRQ1/IRQ2 bits are never enabled here, study-check W4): the line may still be up, so MASK it; the thread decides */
+		if (o->wake != NULL) {
+			o->wake(o->ctx);                    /* so the thread unmasks (or turns the mode off) at once */
+		}
+		return SWI_ISR_DEFER;
+	}
+	if (swi_io(st, o, SWI_SP_ELBI, SWI_W, SWI_ELBI_IRQ0, &w) != 0) {      /* W1C of bit 14 only */
+		st->isr_err++;
+		return SWI_ISR_MASK;
+	}
+	st->irqs++;
+	__atomic_store_n(&st->pend, 1u, __ATOMIC_RELEASE);
+	if (o->wake != NULL) {
+		o->wake(o->ctx);
+	}
+	return SWI_ISR_DEFER;                       /* the line may still be up until the thread acks 0xC30: mask at the GIC, the thread unmasks (patch 0346) */
+}
+
+static void
+swi_gap(const struct swi_ops *o, int code, uint32_t a, uint32_t b)
+{
+	if (o->note != NULL) {
+		o->note(o->ctx, code, a, b);
+	}
+}
+
+static void
+swi_say(const struct swi_ops *o, uint32_t step, uint32_t val)
+{
+	if (o->note != NULL) {
+		o->note(o->ctx, SWI_N_STEP, step, val);
+	}
+}
+
+/* the thread gate (review 0346 F2), one GAP per state change. 0 = open, -1 = closed: the caller does no BAR0 access and no unmask. */
+static int
+swi_gate_pass(struct swi *st, const struct swi_ops *o)
+{
+	if (o->gate(o->ctx) != 0) {
+		if (!st->gate_closed) {
+			st->gate_closed = 1;
+			st->gate_closes++;
+			swi_gap(o, SWI_G_GATECLOSE, st->gate_closes, 0u);
+		}
+		return -1;
+	}
+	if (st->gate_closed) {
+		st->gate_closed = 0;
+		swi_gap(o, SWI_G_GATEOPEN, st->gate_closes, 0u);
+	}
+	return 0;
+}
+
+/* ---- teardown: ALWAYS runs every step, in the order of study-check s.4: ELBI enable off, SPI detach, then (thread context, bus alive) 0xC34 back to its value before arming.
+ * bar0_ok = 0 when the bus is gone (engine end: the engine's own undo writes 0xC34 := 0). Every step is tried even when an earlier one failed. */
+static void
+swi_teardown(struct swi *st, const struct swi_ops *o, int bar0_ok)
+{
+	uint32_t en = 0, w;
+
+	st->on = 0;                                 /* from here the ISR only masks */
+	if (st->elbi_on) {
+		if (swi_io(st, o, SWI_SP_ELBI, SWI_R, SWI_ELBI_IRQ0_EN, &en) != 0) {
+			swi_gap(o, SWI_G_TEARDOWN, 1u, en);
+		} else {
+			w = en & ~SWI_INTA;
+			if (swi_io(st, o, SWI_SP_ELBI, SWI_W, SWI_ELBI_IRQ0_EN, &w) != 0) {
+				swi_gap(o, SWI_G_TEARDOWN, 2u, w);
+			} else {
+				st->elbi_on = 0;
+			}
+		}
+	}
+	if (st->spi_att) {
+		if (o->spi_detach(o->ctx) != 0) {
+			swi_gap(o, SWI_G_TEARDOWN, 3u, 0u);
+		}
+		st->spi_att = 0;
+		st->spi_en = 0;
+	}
+	if (bar0_ok && st->c34_known && st->c34_cur != st->c34_orig && !st->elbi_on && !st->spi_en) {
+		w = st->c34_orig;
+		if (swi_io(st, o, SWI_SP_BAR0, SWI_W, SWI_MBX_MASK, &w) != 0) {
+			swi_gap(o, SWI_G_TEARDOWN, 4u, w);
+		} else {
+			st->c34_cur = w;
+		}
+	}
+}
+
+/* first disable wins: records why, runs the teardown, tells the glue (the glue prints a loud line) */
+static void
+swi_disable(struct swi *st, const struct swi_ops *o, int why, int code, uint32_t a)
+{
+	if (st->why != SWI_Y_NONE) {
+		return;
+	}
+	st->why = (uint8_t)why;
+	if (code != 0) {
+		swi_gap(o, code, a, 0u);
+	}
+	swi_teardown(st, o, 1);
+}
+
+/* ack/drain loop (study-check W1): read 0xC30, W1C exactly the bits read, drain the rings, re-read, until zero. Returns 0 = zero reached, -1 = stuck/failed (caller disables), -2 = the gate closed after a drain (no more BAR0 access). *extra += drained items */
+static int
+swi_ack_loop(struct swi *st, const struct swi_ops *o, uint32_t *extra)
+{
+	uint32_t c = 0, n = 0;
+	int r;
+
+	for (;;) {
+		r = swi_io(st, o, SWI_SP_BAR0, SWI_R, SWI_MBX_INT, &c);
+		if (r != 0) {
+			swi_gap(o, r == SWI_E_REFUSED ? SWI_G_REFUSED : SWI_G_RD, SWI_SP_BAR0, SWI_MBX_INT);
+			return -1;
+		}
+		if (c == 0u) {
+			return 0;
+		}
+		if (n++ >= SWI_ACK_TRIES) {
+			swi_gap(o, SWI_G_C30STUCK, c, 0u);
+			return -1;
+		}
+		r = swi_io(st, o, SWI_SP_BAR0, SWI_W, SWI_MBX_INT, &c);
+		if (r != 0) {
+			swi_gap(o, r == SWI_E_REFUSED ? SWI_G_REFUSED : SWI_G_WR, SWI_SP_BAR0, SWI_MBX_INT);
+			return -1;
+		}
+		st->ack_writes++;
+		st->loops++;
+		if (extra != NULL) {
+			*extra += o->drain(o->ctx);
+		}
+		if (swi_gate_pass(st, o) != 0) {         /* the drain may have stopped the engine (swg_keep_r2): no further BAR0 access */
+			return -2;
+		}
+	}
+}
+
+/* ---- arm: the corrected stage-A write list (study-check s.4), in this order. 0 = armed; <0 = refused at step -N, the teardown ran and st->why is set.
+ * 0 gate; 1 0xC34 := 0; 2 0xC30 ack loop to 0; 3 ELBI IRQ0 W1C bit 14 (+ read-back clear); 4 GIC attach, SPI left disabled; 5 ELBI IRQ0_EN |= bit 14 (+ read-back);
+ * 6 SPI enable; 7 0xC34 := 0xFFFF LAST (+ read-back). */
+static int
+swi_arm(struct swi *st, const struct swi_ops *o)
+{
+	uint32_t v = 0, rb = 0, ex = 0;
+	int r, step = 0, why = SWI_Y_ARM;
+
+	if (st->mode != SWI_MODE_DB) {
+		return -100;
+	}
+	if (o->gate(o->ctx) != 0) {
+		swi_disable(st, o, SWI_Y_GATE, SWI_G_GATE, 0u);
+		return -100;
+	}
+	step = 1;
+	if (swi_io(st, o, SWI_SP_BAR0, SWI_R, SWI_MBX_MASK, &v) != 0) {
+		swi_gap(o, SWI_G_RD, 1u, 0u);
+		goto fail;
+	}
+	if (v != 0u && v != SWI_MBX_ALL) {
+		swi_gap(o, SWI_G_C34ORIG, v, 0u);
+		goto fail;
+	}
+	st->c34_orig = st->c34_cur = v;
+	st->c34_known = 1;
+	if (v != 0u) {
+		v = 0u;
+		if (swi_io(st, o, SWI_SP_BAR0, SWI_W, SWI_MBX_MASK, &v) != 0) {
+			swi_gap(o, SWI_G_WR, 1u, 0u);
+			goto fail;
+		}
+		st->c34_cur = 0u;
+	}
+	swi_say(o, 1u, 0u);
+	step = 2;
+	r = swi_ack_loop(st, o, &ex);
+	if (r != 0) {
+		why = r == -2 ? SWI_Y_GATE : SWI_Y_C30;
+		goto fail;
+	}
+	st->extra_items += ex;
+	swi_say(o, 2u, 0u);
+	step = 3;
+	v = 0u;
+	if (swi_io(st, o, SWI_SP_ELBI, SWI_R, SWI_ELBI_IRQ0, &v) != 0) {
+		swi_gap(o, SWI_G_RD, 3u, 0u);
+		goto fail;
+	}
+	if ((v & SWI_INTA) != 0u) {
+		uint32_t w = SWI_INTA;
+
+		if (swi_io(st, o, SWI_SP_ELBI, SWI_W, SWI_ELBI_IRQ0, &w) != 0) {
+			swi_gap(o, SWI_G_WR, 3u, 0u);
+			goto fail;
+		}
+		v = 0u;
+		if (swi_io(st, o, SWI_SP_ELBI, SWI_R, SWI_ELBI_IRQ0, &v) != 0 || (v & SWI_INTA) != 0u) {
+			swi_gap(o, SWI_G_ELBISTUCK, v, 0u);
+			goto fail;
+		}
+	}
+	swi_say(o, 3u, v);
+	step = 4;
+	r = o->spi_attach_off(o->ctx, &rb);
+	if (r != 0 || rb != 0u) {
+		swi_gap(o, SWI_G_ATTACH, (uint32_t)r, rb);
+		st->spi_att = (uint8_t)(r == 0);        /* attached but read back enabled: the teardown must detach it */
+		st->spi_en = (uint8_t)(rb != 0u);
+		goto fail;
+	}
+	st->spi_att = 1;
+	swi_say(o, 4u, rb);
+	step = 5;
+	v = 0u;
+	if (swi_io(st, o, SWI_SP_ELBI, SWI_R, SWI_ELBI_IRQ0_EN, &v) != 0) {
+		swi_gap(o, SWI_G_RD, 5u, 0u);
+		goto fail;
+	}
+	if ((v & ~SWI_INTA) != 0u) {
+		swi_gap(o, SWI_G_ENOTHER, v, 0u);
+		goto fail;
+	}
+	{
+		uint32_t w = v | SWI_INTA;
+
+		if (swi_io(st, o, SWI_SP_ELBI, SWI_W, SWI_ELBI_IRQ0_EN, &w) != 0) {
+			swi_gap(o, SWI_G_WR, 5u, 0u);
+			goto fail;
+		}
+		st->elbi_on = 1;                        /* set before the read-back: a failed read-back still owes a teardown */
+		v = 0u;
+		if (swi_io(st, o, SWI_SP_ELBI, SWI_R, SWI_ELBI_IRQ0_EN, &v) != 0 || v != w) {
+			swi_gap(o, SWI_G_VERIFY, w, v);
+			goto fail;
+		}
+	}
+	swi_say(o, 5u, v);
+	step = 6;
+	st->on = 1;                                 /* before the enable: the ISR may run at once */
+	rb = 0u;
+	r = o->spi_enable(o->ctx, &rb);
+	if (r != 0 || rb == 0u) {
+		swi_gap(o, SWI_G_ENABLE, (uint32_t)r, rb);
+		goto fail;
+	}
+	st->spi_en = 1;
+	swi_say(o, 6u, rb);
+	step = 7;
+	v = SWI_MBX_ALL;
+	if (swi_io(st, o, SWI_SP_BAR0, SWI_W, SWI_MBX_MASK, &v) != 0) {
+		swi_gap(o, SWI_G_WR, 7u, 0u);
+		goto fail;
+	}
+	st->c34_cur = SWI_MBX_ALL;
+	v = 0u;
+	if (swi_io(st, o, SWI_SP_BAR0, SWI_R, SWI_MBX_MASK, &v) != 0 || v != SWI_MBX_ALL) {
+		swi_gap(o, SWI_G_VERIFY, SWI_MBX_ALL, v);
+		goto fail;
+	}
+	swi_say(o, 7u, v);
+	return 0;
+fail:
+	swi_disable(st, o, why, 0, 0u);
+	return -step;
+}
+
+/* ---- thread, before the drain: ack first (W1). Returns 1 when the ISR fired (or an entry without bit 14 masked the line) since the last pass. */
+static int
+swi_pre(struct swi *st, const struct swi_ops *o)
+{
+	uint32_t c = 0, sp;
+
+	st->p_pend = 0;
+	st->p_defer = 0;
+	st->p_c30 = 0xFFFFFFFFu;
+	if (!st->on) {
+		return 0;
+	}
+	if (swi_gate_pass(st, o) != 0) {              /* gate first (review 0346 F2): closed = no BAR0 access; the interrupt stays pending for the next pass */
+		return 0;
+	}
+	st->p_pend = __atomic_exchange_n(&st->pend, 0u, __ATOMIC_ACQ_REL);
+	sp = st->spurious;
+	if (sp != st->seen_spur) {
+		st->p_defer = 1;
+		st->spur_run += sp - st->seen_spur;
+		st->seen_spur = sp;
+	}
+	if (st->owe_unmask) {                         /* a closed gate postponed the unmask of the line the ISR masked */
+		st->p_defer = 1;
+		st->owe_unmask = 0;
+	}
+	if (st->p_pend) {
+		st->p_defer = 1;
+		st->spur_run = 0;
+		if (swi_io(st, o, SWI_SP_BAR0, SWI_R, SWI_MBX_INT, &c) == 0) {
+			st->p_c30 = c;
+		}
+		if (st->p_c30 != 0xFFFFFFFFu && c != 0u) {
+			if (swi_io(st, o, SWI_SP_BAR0, SWI_W, SWI_MBX_INT, &c) == 0) {      /* the bits just read, before any ring is touched */
+				st->ack_writes++;
+			}
+		}
+	}
+	return (int)(st->p_pend | st->p_defer);
+}
+
+/* ---- thread, after the first drain (got = items it found): missed/auto-disable bookkeeping, the re-read loop, then the unmask. Returns extra items drained. */
+static uint32_t
+swi_post(struct swi *st, const struct swi_ops *o, uint32_t got)
+{
+	uint32_t ex = 0, now = st->isr_total, aw0;
+	int fired, r;
+
+	if (!st->on) {
+		return 0;
+	}
+	if (st->gate_closed) {                        /* gate first (review 0346 F2): nothing below touches BAR0 or the GIC while it is closed */
+		return 0;
+	}
+	if ((st->p_pend || st->p_defer || got != 0u) && swi_gate_pass(st, o) != 0) {      /* the engine may have stopped inside this pass */
+		if (st->p_defer) {
+			st->owe_unmask = 1;
+		}
+		return 0;
+	}
+	fired = now != st->seen;
+	st->seen = now;
+	if (got != 0u) {
+		st->work_events++;
+		if (!st->p_pend && !fired) {
+			st->missed++;                       /* the poll found work and no interrupt fired since the last pass */
+		}
+	}
+	if (st->isr_err != 0u) {
+		swi_disable(st, o, SWI_Y_ISR, SWI_G_ISRERR, st->isr_err);
+		return 0;
+	}
+	if (st->refused != 0u) {                    /* the judge refused something: a bug in this file, never silent */
+		swi_disable(st, o, SWI_Y_REFUSED, SWI_G_REFUSED, st->refused);
+		return 0;
+	}
+	if (st->spur_run >= SWI_SPUR_MAX) {
+		swi_disable(st, o, SWI_Y_SPUR, SWI_G_SPUR, st->spur_run);
+		return 0;
+	}
+	if (st->irqs == 0u && st->work_events >= SWI_NOIRQ_MAX) {
+		swi_disable(st, o, SWI_Y_NOIRQ, SWI_G_NOIRQ, st->work_events);
+		return 0;
+	}
+	aw0 = st->ack_writes;
+	if (st->p_pend || got != 0u) {
+		r = swi_ack_loop(st, o, &ex);
+		if (r == -2) {                          /* the gate closed during the loop: no unmask, owed for when it opens */
+			if (st->p_defer) {
+				st->owe_unmask = 1;
+			}
+			return ex;
+		}
+		if (r != 0) {
+			swi_disable(st, o, SWI_Y_C30, 0, 0u);
+			return ex;
+		}
+	}
+	/* F1 (review 0346): an interrupt whose pass finds 0xC30 == 0 (pre and loop) and no ring work is "empty"; SWI_EMPTY_MAX in a row = a line that stays asserted: off BEFORE the unmask so it cannot spin the thread */
+	if (st->p_pend && st->p_c30 == 0u && got == 0u && ex == 0u && st->ack_writes == aw0) {
+		st->empty_run++;
+	} else if (st->p_pend || got != 0u || ex != 0u) {
+		st->empty_run = 0;
+	}
+	if (st->empty_run >= SWI_EMPTY_MAX) {
+		swi_gap(o, SWI_G_EMPTY, st->empty_run, st->irqs);
+		swi_disable(st, o, SWI_Y_EMPTY, 0, 0u);
+		return ex;
+	}
+	st->extra_items += ex;
+	if (st->p_defer) {                          /* the line was masked by the ISR (deferred or entry without bit 14): re-enable it, last */
+		int r = o->spi_unmask(o->ctx);
+
+		if (r != 0) {
+			swi_disable(st, o, SWI_Y_UNMASK, SWI_G_UNMASK, (uint32_t)r);
+			return ex;
+		}
+		st->unmasks++;
+	}
+	return ex;
+}
+
+/* ---- once per pass: the storm window (ISR entries per second). now_ms = any monotonic millisecond clock */
+static void
+swi_tick(struct swi *st, const struct swi_ops *o, uint32_t now_ms)
+{
+	uint32_t d;
+
+	if (!st->on) {
+		return;
+	}
+	if (st->win_ms == 0u) {
+		st->win_ms = now_ms == 0u ? 1u : now_ms;
+		st->win_isr = st->isr_total;
+		return;
+	}
+	if (now_ms - st->win_ms >= 1000u) {
+		d = st->isr_total - st->win_isr;
+		st->win_ms = now_ms;
+		st->win_isr = st->isr_total;
+		if (d > SWI_STORM_MAX) {
+			st->storm++;
+			swi_disable(st, o, SWI_Y_STORM, SWI_G_STORM, d);
+		}
+	}
+}
+
+/* ---- mode 2: ONE read-only sample (no write exists in this mode: the judge has no W row for it). Returns 0 = all three read, -1 = gate closed (nothing touched), -2 = a read failed (field = 0xFFFFFFFF) */
+static int
+swi_ro_sample(struct swi *st, const struct swi_ops *o, struct swi_ro *r)
+{
+	r->elbi0 = r->en0 = r->c30 = 0xFFFFFFFFu;
+	r->err = 0;
+	if (st->mode != SWI_MODE_RO) {
+		return -1;
+	}
+	if (o->gate(o->ctx) != 0) {
+		st->ro_skip++;
+		return -1;
+	}
+	if (swi_io(st, o, SWI_SP_ELBI, SWI_R, SWI_ELBI_IRQ0, &r->elbi0) != 0) {
+		r->elbi0 = 0xFFFFFFFFu;
+		r->err |= 1u;
+	}
+	if (swi_io(st, o, SWI_SP_ELBI, SWI_R, SWI_ELBI_IRQ0_EN, &r->en0) != 0) {
+		r->en0 = 0xFFFFFFFFu;
+		r->err |= 2u;
+	}
+	if (swi_io(st, o, SWI_SP_BAR0, SWI_R, SWI_MBX_INT, &r->c30) != 0) {
+		r->c30 = 0xFFFFFFFFu;
+		r->err |= 4u;
+	}
+	st->ro_n++;
+	return r->err != 0u ? -2 : 0;
+}
+
+/* the text after "mode " of the 5 s summary */
+static const char *
+swi_mode_str(const struct swi *st)
+{
+	static const char *const why[] = { "", "off:gate", "off:arm", "off:storm", "off:noirq", "off:c30stuck", "off:spurious", "off:isr", "off:link", "off:end", "off:unmask", "off:refused", "off:emptyirq" };
+
+	if (st->mode == SWI_MODE_RO) {
+		return "ro";
+	}
+	if (st->why != SWI_Y_NONE && st->why < sizeof why / sizeof why[0]) {
+		return why[st->why];
+	}
+	return st->on ? "doorbell" : (st->mode == SWI_MODE_DB ? "off:notarmed" : "off:0");
+}
