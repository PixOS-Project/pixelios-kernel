index add576c..2cdc639 100644
--- a/bsd/dev/sweet_bt.c
+++ b/bsd/dev/sweet_bt.c
@@ -123,6 +123,10 @@ int i = sbt_index(ref);
 	if (i < 0) {
 		return EINVAL;
 	}
+	if (sweet_bt_uart_bringup_busy()) {      /* patch 0296: the async bring-up owns the UART (patchram download); a client now would interleave bytes with it. BlueTool answers result 1, bluetoothd retries boot */
+		SBT_GAP(G_BUSY, "kctl %s: controller bring-up (patchram download) still running; connect refused with EBUSY, the client retries", i ? SBT_CTL_SK : SBT_CTL_PLAIN);
+		return EBUSY;
+	}
 	if (__atomic_exchange_n(&sbt.uart_busy, 1, __ATOMIC_ACQ_REL)) {      /* both controls drive ONE UART: one client at a time across them (review r1 F6) */
 		SBT_GAP(G_BUSY, "kctl %s: the UART already has a client (one UART, one client across both controls); connect refused", i ? SBT_CTL_SK : SBT_CTL_PLAIN);
 		return EBUSY;
