+/*
+ * Patch 0190 (X-G7): the timer re-arms only while something needs it: a registered client (vsync
+ * notifications), a frame waiting to be shown, a blank pass still to do, or the QR log holding the panel.
+ * Called with fLock held. Every way back to "needed" goes through a client (swap, power change, notify
+ * port), and addClient() restarts a parked timer.
+ */
+bool
+AppleCLCD::needsVsync(void)
+{
+	return fClients->getCount() != 0 || (fDirty && !fPowerOff) || (fPowerOff && fFadeStep == 0) || sweet_qr_hold;
 }
 
 void
 AppleCLCD::addClient(IOMobileFramebufferUserClient *client)
 {
 	IOLockLock(fLock);
 	fClients->setObject(client);
+	bool kick = fVsyncIdle;
+	fVsyncIdle = false;
 	IOLockUnlock(fLock);
+	if (kick) {
+		/* patch 0190: restart the parked vsync timer for the new client */
+		fVsync->setTimeoutUS(SWEET_FB_VSYNC_US);
+		IOLog("SWEET FB: vsync timer resumed (client)\n");
+	}
 }
 
 void
 AppleCLCD::removeClient(IOMobileFramebufferUserClient *client)
 {
 	IOLockLock(fLock);
 	unsigned int i = fClients->getNextIndexOfObject(client, 0);
 	if (i != (unsigned int)-1) {
 		fClients->removeObject(i);
 	}
 	IOLockUnlock(fLock);
 }
 
