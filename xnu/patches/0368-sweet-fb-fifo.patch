+/*
+ * Patch 0368 (lowclk, research 166 levers 1-2, boot-args sweetfb_fifo=N and sweetfb_gatekick=1, both default off = behaviour unchanged; counters and the per-second row
+ * `SWEET FB: presents P drawn D held H replaced R gatekick K fifo_full F` with sweetfb_copytime=1, sweetfb_drawn=1 or either lever on): the swap queue accounting.
+ * Two entries at most: the HEAD (fPending, shown at the next tick) and one HOLD (fHold). sweetfb_fifo=0: a swap that arrives while the head is unshown replaces it
+ * (latest wins, counted replaced). N >= 1: it goes to the HOLD instead (counted held) and the head is shown first; a 3rd swap replaces the HOLD (counted replaced and
+ * fifo_full). After a present that leaves a HOLD, the HOLD becomes the head and `standing` counts that tick; N = 1..254 caps the queue: when standing >= N and the HOLD
+ * is complete on the GPU, the head is dropped (counted catchup and replaced) and the HOLD is shown instead. N = 255: never. Pure logic, host-tested (tools/test_sweet_fifo368.py).
+ */
+/* SFQ-PURE-BEGIN */
+#define SFQ_UNCAPPED    255u
+#define SFQ_JOBS_UNK    0xffffffffu
+#define SFQ_DRAWN_JOBS  4u      /* a present is "drawn" when its swap had MORE than this many GPU jobs since the previous swap (tools/fps-wholerun JOBS_DRAWN) */
+enum { SFQ_A_HEAD = 0, SFQ_A_HOLD, SFQ_A_REPL_HEAD, SFQ_A_REPL_HOLD };
+struct sfq_row {
+	uint32_t presents, drawn, held, replaced, kicks, fifo_full, catchup, standing;
+	uint32_t k_armed, k_stale, k_notdone;
+};
+struct sfq {
+	uint32_t fifo;          /* 0 = latest wins, 1..254 = cap in standing ticks, 255 = uncapped */
+	bool     head_valid;    /* an unshown swap is in fPending (a redraw with no new swap is not one) */
+	bool     hold_valid;
+	uint32_t head_jobs, hold_jobs;   /* GPU jobs since the previous swap, SFQ_JOBS_UNK = unknown */
+	uint32_t standing;      /* consecutive presents that left a HOLD behind */
+	struct sfq_row r;       /* this second */
+};
+
+/* a swap arrives: which slot it goes to; the caller moves the record and the surfaces the same way */
+static int
+sfq_arrive(struct sfq *q, uint32_t jobs)
+{
+	if (!q->head_valid) {
+		q->head_valid = true;
+		q->head_jobs = jobs;
+		return SFQ_A_HEAD;
+	}
+	if (q->fifo == 0) {
+		q->head_jobs = jobs;
+		q->r.replaced++;
+		return SFQ_A_REPL_HEAD;
+	}
+	if (!q->hold_valid) {
+		q->hold_valid = true;
+		q->hold_jobs = jobs;
+		q->r.held++;
+		return SFQ_A_HOLD;
+	}
+	q->hold_jobs = jobs;
+	q->r.replaced++;
+	q->r.fifo_full++;
+	return SFQ_A_REPL_HOLD;
+}
+
+/* tick start: true = the head must be dropped and the HOLD becomes the head (the caller moves record, seqno and surfaces) */
+static bool
+sfq_catchup(struct sfq *q, bool hold_ready)
+{
+	if (q->fifo == 0 || q->fifo == SFQ_UNCAPPED || !q->hold_valid || !hold_ready || q->standing < q->fifo) {
+		return false;
+	}
+	q->head_jobs = q->hold_jobs;
+	q->hold_valid = false;
+	q->standing = 0;
+	q->r.catchup++;
+	q->r.replaced++;
+	return true;
+}
+
+/* the head was copied out to be shown: true = the HOLD became the head (the caller moves record, seqno and surfaces) */
+static bool
+sfq_take(struct sfq *q, bool by_kick)
+{
+	q->r.presents++;
+	if (by_kick) {
+		q->r.kicks++;
+	}
+	if (q->head_valid && q->head_jobs != SFQ_JOBS_UNK && q->head_jobs > SFQ_DRAWN_JOBS) {   /* a redraw with no swap behind it is not a drawn present */
+		q->r.drawn++;
+	}
+	q->head_valid = false;
+	if (q->hold_valid) {
+		q->head_valid = true;
+		q->head_jobs = q->hold_jobs;
+		q->hold_valid = false;
+		q->standing++;
+		return true;
+	}
+	q->standing = 0;
+	return false;
+}
+
+/* once per second: hand out the counters of the second and start the next */
+static void
+sfq_row_take(struct sfq *q, struct sfq_row *o)
+{
+	*o = q->r;
+	o->standing = q->standing;
+	memset(&q->r, 0, sizeof(q->r));
+}
+
+static bool
+sfq_row_nonzero(const struct sfq_row *o)
+{
+	return (o->presents | o->held | o->replaced | o->kicks | o->fifo_full | o->catchup | o->k_armed | o->k_stale | o->k_notdone) != 0;
+}
+/* SFQ-PURE-END */
