+/*
+ * Patch 0368 (sweetfb_gatekick=1, default off: no hook registered, the sm_thread loop pays one load of a NULL pointer): tell the framebuffer driver when the in-order
+ * completion watermark (seq_done) passes a seqno it armed, instead of leaving it to find out at its next 60 Hz tick. sweet_mali_kick_arm(seq) stores the seqno, then
+ * re-reads seq_done (both seq_cst); sm_kick_tick() (sm_thread, after the unlock, so after the seq_done store of finish()) fences, then reads the armed seqno. Either the
+ * arm sees the completion (returns 1: the caller kicks itself, the hook will not) or the hook sees the arm (compare-exchange to 0 decides who fires, exactly one does).
+ * The hook runs with no Mali lock held and only calls the registered function (a one-shot timer enter in the framebuffer driver, no sleep, no register access).
+ * Not armed / Mali not up: sweet_mali_kick_arm returns -1 and the caller keeps today's behaviour (the next tick copies). No polling: the hook runs when sm_thread has run anyway.
+ */
+static void (*volatile sm_kick_fn)(void);
+static volatile uint64_t sm_kick_seq;
+
+int
+sweet_mali_kick_register(void (*fn)(void))
+{
+	if (fn == NULL) {
+		return EINVAL;
+	}
+	__atomic_store_n(&sm_kick_fn, fn, __ATOMIC_RELEASE);
+	return 0;
+}
+
+int
+sweet_mali_kick_arm(uint64_t seq)
+{
+	if (!sm.up || sm.dead || __atomic_load_n(&sm_kick_fn, __ATOMIC_ACQUIRE) == NULL) {
+		return -1;
+	}
+	if (seq == 0) {
+		return 1;
+	}
+	__atomic_store_n(&sm_kick_seq, seq, __ATOMIC_SEQ_CST);
+	if (__atomic_load_n(&sm.seq_done, __ATOMIC_SEQ_CST) >= seq) {
+		uint64_t exp = seq;
+		if (__atomic_compare_exchange_n(&sm_kick_seq, &exp, 0, false, __ATOMIC_SEQ_CST, __ATOMIC_SEQ_CST)) {
+			return 1;
+		}
+	}
+	return 0;
+}
+
+static void
+sm_kick_tick(void)
+{
+	void (*fn)(void) = __atomic_load_n(&sm_kick_fn, __ATOMIC_ACQUIRE);
+	if (fn == NULL) {
+		return;
+	}
+	__atomic_thread_fence(__ATOMIC_SEQ_CST);
+	uint64_t ks = __atomic_load_n(&sm_kick_seq, __ATOMIC_SEQ_CST);
+	if (ks == 0 || __atomic_load_n(&sm.seq_done, __ATOMIC_SEQ_CST) < ks) {
+		return;
+	}
+	if (__atomic_compare_exchange_n(&sm_kick_seq, &ks, 0, false, __ATOMIC_SEQ_CST, __ATOMIC_SEQ_CST)) {
+		fn();
+	}
+}
