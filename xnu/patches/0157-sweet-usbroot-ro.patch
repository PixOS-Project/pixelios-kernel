+/* Queue one raw Ethernet frame on the bulk IN endpoint (same queue and lock as ud_if_output). */
+bool
+sweet_usb_raw_tx(const void *frame, uint32_t len)
+{
+	mbuf_t m = NULL;
+
+	if (ud.lock == NULL || len < ETHER_HDR_LEN || len > ETHER_MAX_LEN - ETHER_CRC_LEN) {
+		return false;
+	}
+	if (mbuf_gethdr(MBUF_DONTWAIT, MBUF_TYPE_DATA, &m) != 0) {
+		return false;
+	}
+	if (mbuf_mclget(MBUF_DONTWAIT, MBUF_TYPE_DATA, &m) != 0 || !(mbuf_flags(m) & MBUF_EXT) ||
+	    mbuf_maxlen(m) < len) {
+		mbuf_freem(m);
+		return false;
+	}
+	memcpy(mbuf_data(m), frame, len);
+	mbuf_setlen(m, len);
+	mbuf_pkthdr_setlen(m, len);
+	lck_mtx_lock(ud.lock);
+	if (ud.txq_count == UD_TXQ || !ud.configured) {
+		lck_mtx_unlock(ud.lock);
+		mbuf_freem(m);
+		return false;
+	}
+	ud.txq[(ud.txq_head + ud.txq_count) % UD_TXQ] = m;
+	ud.txq_count++;
+	ud_tx_kick_locked();
+	lck_mtx_unlock(ud.lock);
+	return true;
+}
