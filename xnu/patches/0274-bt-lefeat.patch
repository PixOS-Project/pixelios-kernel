 		printf("BT UART: patchram download verified; bluetoothd will meet the patched controller\n");
+		if (PE_parse_boot_argn("sweetbtlefeat", &v, sizeof(v)) && v == 1) {      /* patch 0274 */
+			int le = sbu_lefeat();
+
+			if (le != 0) {
