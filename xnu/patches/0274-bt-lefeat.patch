 		return 0;
 	}
 	printf("BT GAP: sweetbtpatchram=1 FAILED (error %d): power-cycling the controller back to the unpatched ROM for bluetoothd\n", e);
+	sbu_lefeat_unused("patchram failed");
 	(void)sbu_power_off();
 	e = sbu_probe_one(cand);
 	if (e != 0) {
@@ -2558,6 +2633,9 @@ sweet_bt_uart_attach(void)
 					sbu_rfwit_unused("the backend did not start after the patchram step");
 					return;
 				}
+				if (v != 1) {
+					sbu_lefeat_unused("sweetbtpatchram=1 is not set");      /* patch 0274 */
+				}
 			}
 			{       /* patch 0229 (T-b0b4): boot-arg sweetbtrfwit=1, RF witness (LE scan 100% duty + classic Inquiry) on the controller bluetoothd will meet; before the rx thread */
 				int v = 0;
