-					if (v == 3) {       /* patch 0219: replay v3, pass A (no probes between steps), power-cycle, pass B (control with a probe after every step) */
+				if (PE_parse_boot_argn("sweetbtleprobe", &v, sizeof(v)) && (v == 1 || v == 2 || v == 3 || v == 4)) {
+					if (v == 4) {       /* patch 0221: injection-position sweep, power-cycles between the passes */
+						e = sbu_sweep(&use[win]);
