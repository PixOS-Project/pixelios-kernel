+							return;
+						}
+					} else if (v == 3) {       /* patch 0219: replay v3, pass A (no probes between steps), power-cycle, pass B (control with a probe after every step) */
 						sbu_replay3(false);
 						(void)sbu_power_off();
 						e = sbu_probe_one(&use[win]);
@@ -1456,7 +1598,7 @@ sweet_bt_uart_attach(void)
 	if (!settled) {
 		int v = 0;
 
-		if (PE_parse_boot_argn("sweetbtleprobe", &v, sizeof(v)) && (v == 1 || v == 2 || v == 3)) {
+		if (PE_parse_boot_argn("sweetbtleprobe", &v, sizeof(v)) && (v == 1 || v == 2 || v == 3 || v == 4)) {
 			printf("BT GAP: sweetbtleprobe=%d ignored: the baud probe did not settle the clock (the matrix needs the answered HCI Reset first)\n", v);
 		}
 	}
