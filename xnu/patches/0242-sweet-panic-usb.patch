 }
 
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+/*
+ * PixOS patch 0242 (T-15e0): with no panic region SavePanicInfo returns before print_all_backtraces (patch 0182 for
+ * panic_info == NULL, stock for debug_buf_size == 0), so the panic log held only the panic(cpu line (run
+ * 20261107T172408Z-panic-usb-forced: cap=98, no backtrace). This prints the part of do_print_all_backtraces that needs
+ * no panic region, in its own format: message, kernel version / UUID / slide, the other CPUs' last pc/lr (cpu_data
+ * reads), the panicked task and the panicked thread's backtrace (print_one_backtrace: pmap_find_phys + physical reads
+ * with not_in_kdp = 0, as print_all_backtraces sets it). Left out, said in the GAP line: the panic_info header and the
+ * stackshot (both need the region), panic_display_hung_cpus_help (UTTDBG PC-sample MMIO reads), zone / compressor
+ * stats, boot args / ECID, kext lists. No MMIO and no lock of its own: paniclog_append_noflush takes the same path as
+ * the panic(cpu line printed just before it (screen console + debug_putc, observed in run 20261107T172408Z-panic-usb-
+ * forced), and debug_putc's 0242 capture keeps it for the USB send at the start of the 0224 hold, which runs after this.
+ */
+static boolean_t sweet_noregion_bt_done;
+
+static void __attribute__((noinline))
+sweet_noregion_backtrace(const char *message)
+{
+	cpu_data_t *cpu_data_ptr = getCpuDatap();
+	unsigned int initial_not_in_kdp = not_in_kdp;
+	thread_t cur_thread = current_thread();
+	uintptr_t cur_fp;
+	task_t task;
+	struct proc *proc;
+
+	if (sweet_noregion_bt_done || panic_bt_depth != 0 || cpu_data_ptr->PAB_active) {
+		paniclog_append_noflush("SWEET PANIC GAP: nested panic, the backtrace is not printed again (patch 0242)\n");
+		return;
+	}
+	sweet_noregion_bt_done = TRUE;
+	panic_bt_depth++;
+	cpu_data_ptr->PAB_active = TRUE;
+	not_in_kdp = 0;         /* print_all_backtraces: pmap routines without pmap locks */
+
+	__asm__ volatile ("add %0, xzr, fp":"=r"(cur_fp));
+	paniclog_append_noflush("Debugger message: %.1200s\n", message ? message : "(none)");
+	paniclog_append_noflush("Kernel version: %.512s\n", version);
+	panic_display_kernel_uuid();
+	panic_display_kernel_aslr();
+	panic_display_last_pc_lr();
+	if (panic_get_thread_proc_task(cur_thread, &task, &proc)) {
+		paniclog_append_noflush("Panicked task %p: %d threads: ", task, task->thread_count);
+		if (proc) {
+			char name[MAXCOMLEN + 1];
+			proc_name_kdp(proc, name, sizeof(name));
+			paniclog_append_noflush("pid %d: %s\n", proc_pid(proc), name);
+		} else {
+			paniclog_append_noflush("unknown task\n");
+		}
+	}
+	if (cur_fp < VM_MAX_KERNEL_ADDRESS) {
+		paniclog_append_noflush("Panicked thread: %p, backtrace: 0x%llx, tid: %llu\n",
+		    cur_thread, (addr64_t)cur_fp, thread_tid(cur_thread));
+		print_one_backtrace(kernel_pmap, cur_fp, "\t", TRUE, FALSE);
+	} else {
+		paniclog_append_noflush("Could not print panicked thread backtrace:"
+		    "frame pointer outside kernel vm.\n");
+	}
+	paniclog_append_noflush("SWEET PANIC GAP: no panic region: no panic header, stackshot, UTTDBG PC samples, zone/compressor "
+	    "stats, boot args or kext lists in this log (patch 0242; real fix PR-3)\n");
+
+	not_in_kdp = initial_not_in_kdp;
+	cpu_data_ptr->PAB_active = FALSE;
+	panic_bt_depth--;
+}
+#endif /* ARM64_BOARD_CONFIG_SWEET */
