+		sum = (sum & 0xffff) + (sum >> 16);
+	}
+	sum = ~sum & 0xffff;
+	f[10] = (uint8_t)(sum >> 8); f[11] = (uint8_t)sum;
+	/* UDP (RFC 768): 5140 -> 5140, checksum 0 = none (allowed over IPv4) */
+	f[20] = 0x14; f[21] = 0x14; f[22] = 0x14; f[23] = 0x14;
+	f[24] = (uint8_t)(udl >> 8); f[25] = (uint8_t)udl; f[26] = 0; f[27] = 0;
+	memcpy(f + 28, payload, len);
+	flen = ETHER_HDR_LEN + 28 + len;
+	memcpy((void *)(ud.dma + UD_TX), ud_panic_frame, flen);
+	if ((flen % 512) == 0) {         /* as ud_tx_kick_locked: a pad byte instead of a zero-length packet */
+		((uint8_t *)(ud.dma + UD_TX))[flen++] = 0;
+	}
+	/* ud_start_trb(EP_TX, UD_TRB_TX, UD_TX, flen, TRBCTL_NORMAL) without its printf/delay in the command wait */
+	ctl = TRBCTL_NORMAL | TRB_HWO | TRB_LST | TRB_ISP_IMI | TRB_IOC;
+	t[0] = (uint32_t)(ud.dma_pa + UD_TX);
+	t[1] = (uint32_t)((ud.dma_pa + UD_TX) >> 32);
+	t[2] = flen;
+	t[3] = ctl;
+	ud_sync(UD_TRB_TX, 16);
+	ud_sync(UD_TX, flen);
+	ud.tx_busy = true;              /* the TX state is ud_thread's, which never runs again before the reset */
+	dwc_wr(DEPCMDPAR0(EP_TX), (uint32_t)((ud.dma_pa + UD_TRB_TX) >> 32));
+	dwc_wr(DEPCMDPAR1(EP_TX), (uint32_t)(ud.dma_pa + UD_TRB_TX));
+	dwc_wr(DEPCMDPAR2(EP_TX), 0);
+	dwc_wr(DEPCMD(EP_TX), DEPCMD_STARTTRANSFER | DEPCMD_CMDACT);
+	for (i = 0; (dwc_rd(DEPCMD(EP_TX)) & DEPCMD_CMDACT) && i < UD_PANIC_WAIT_US / 10; i++) {
+		ud_panic_spin_us(10);
+	}
+	if (dwc_rd(DEPCMD(EP_TX)) & DEPCMD_CMDACT) {
+		return 6;
+	}
+	if ((dwc_rd(DEPCMD(EP_TX)) >> 12) & 0xf) {
+		return 8;
+	}
+	for (i = 0; ud_panic_tx_trb_hwo() && i < UD_PANIC_WAIT_US / 10; i++) {
+		ud_panic_ack_events();
+		ud_panic_spin_us(10);
+	}
+	ud_panic_ack_events();
+	if (ud_panic_tx_trb_hwo()) {
+		return 9;
+	}
+	ud.tx_frames++;
+	return 0;
+}
