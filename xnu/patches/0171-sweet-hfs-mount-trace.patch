+uint64_t sweet_hfstrace_ms(void);
+uint64_t
+sweet_hfstrace_ms(void)
+{
+	uint64_t t = 0, ns = 0;
+	clock_get_uptime(&t);
+	absolutetime_to_nanoseconds(t, &ns);
+	return ns / NSEC_PER_MSEC;
