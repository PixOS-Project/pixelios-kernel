diff --git a/bsd/dev/sweet_gpu_job.c b/bsd/dev/sweet_gpu_job.c
new file mode 100644
index 0000000..585543e
--- /dev/null
+++ b/bsd/dev/sweet_gpu_job.c
@@ -0,0 +1,182 @@
+/*
+ * First Mali-G78 job from inside XNU: power the tiler/L2/shaders if they are not on, map 5 pages through AS0 (4-level, 4 KB granule) and run one
+ * Valhall WRITE_VALUE job on JS0 that stores 0x504958454C494F53 ("PIXELIOS") to a word of the data page. Boot-arg sweetgpujob=1, on top of sweetgpu=<base>
+ * (bsd/dev/sweet_gpu_gs101.c calls sweet_gpu_job_run() only after its PMU gate passed). The sequence and every constant are those of the shim's
+ * observed-on-hardware run job1 (shim/gpujob.c, docs/research/28 sections 7-11), with RAM from kmem_alloc_contig and CPU cache maintenance for XNU's cacheable
+ * mappings instead of the shim's MMU-off accesses. Power: kbase order TILER_PWRON (also powers the L2 on JM) then SHADER_PWRON (docs/research/31 s.5.2, shim/gpupower.c);
+ * the shader rail BUCK2S must already be on (shim --gpu-handover): XNU has no ACPM client. Not done here: soft reset, config registers (JM/SHADER/L2_MMU_CONFIG,
+ * COHERENCY_ENABLE), IRQs, power-off. Nothing runs without the boot-arg. Every wait is bounded (100 ms) and a failed step stops the sequence.
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <kern/kalloc.h>
+#include <kern/clock.h>
+#include <vm/vm_kern.h>
+#include <mach/vm_param.h>
+#include <pexpert/pexpert.h>
+#include <stdint.h>
+
+extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
+extern void flush_dcache64(addr64_t, unsigned, int);
+extern vm_offset_t kvtophys(vm_offset_t);
+
+#define R_SHADER_PRESENT 0x100u
+#define R_SHADER_READY   0x140u
+#define R_TILER_READY    0x150u
+#define R_L2_READY       0x160u
+#define R_SHADER_PWRON   0x180u
+#define R_TILER_PWRON    0x190u
+#define R_SHADER_TRANS   0x200u
+#define R_L2_TRANS       0x220u
+#define R_JOB_RAW        0x1000u
+#define R_JOB_CLEAR      0x1004u
+#define R_JS0_STATUS     0x1824u
+#define R_JS0_CMD        0x1820u
+#define R_JS0_HEAD_NEXT  0x1840u
+#define R_JS0_AFF_NEXT   0x1850u
+#define R_JS0_CFG_NEXT   0x1858u
+#define R_JS0_CMD_NEXT   0x1860u
+#define R_MMU_RAW        0x2000u
+#define R_MMU_CLEAR      0x2004u
+#define R_AS0_TRANSTAB   0x2400u
+#define R_AS0_MEMATTR    0x2408u
+#define R_AS0_COMMAND    0x2418u
+#define R_AS0_FAULTSTAT  0x241Cu
+#define R_AS0_STATUS     0x2428u
+#define R_AS0_TRANSCFG   0x2430u
+/* values: shim/out/board_config.h GPU_JOB_* from tools/boards.py _gpu_job_values(), pinned by tools/test_boards_gpuclk.py; observed in run job1 (docs/research/28 s.11) */
+#define SHADERS          0x779FFFu
+#define TRANSCFG_ON      0x42000006u
+#define TRANSCFG_OFF     0x42000001u
+#define MEMATTR_LO       0x888D8F88u
+#define MEMATTR_HI       0x00004C8Du
+#define JS_CONFIG        0x00083B00u
+#define PTE_TABLE        0x403u
+#define PTE_LEAF         0x457u
+#define HDR_W4           0x10004u
+#define WV_IMM64         0x7u
+#define JOB_VA           0x1000u
+#define TARGET_VA        0x1100u
+#define MAGIC            0x504958454C494F53ull
+#define SLOT0_BITS       0x00010001u
+
+static volatile uint32_t *sg;          /* GPU block */
+
+static uint32_t rr(uint32_t off) { return sg[off / 4]; }
+static void wr(uint32_t off, uint32_t v) { sg[off / 4] = v; }
+
+/* poll cond for up to 100 ms; 0 = timed out */
+#define WAIT(cond) ({ int ok_ = 0; for (unsigned i_ = 0; i_ < 5000; i_++) { if (cond) { ok_ = 1; break; } delay(20); } ok_; })
+
+static int
+sg_power(void)
+{
+	if (rr(R_L2_READY) != 1u || rr(R_TILER_READY) != 1u) {
+		wr(R_TILER_PWRON, 1u);
+		if (!WAIT(rr(R_L2_READY) == 1u && rr(R_L2_TRANS) == 0 && rr(R_TILER_READY) == 1u)) {
+			printf("SWEET GPUJOB: tiler/L2 did not come up (L2_READY=%#x TILER_READY=%#x)\n", rr(R_L2_READY), rr(R_TILER_READY));
+			return 1;
+		}
+	}
+	if (rr(R_SHADER_READY) != SHADERS) {
+		if (rr(R_SHADER_PRESENT) != SHADERS) {
+			printf("SWEET GPUJOB: SHADER_PRESENT=%#x is not the observed mask, refusing\n", rr(R_SHADER_PRESENT));
+			return 1;
+		}
+		wr(R_SHADER_PWRON, SHADERS);
+		if (!WAIT(rr(R_SHADER_READY) == SHADERS && rr(R_SHADER_TRANS) == 0)) {
+			printf("SWEET GPUJOB: shaders did not come up (SHADER_READY=%#x TRANS=%#x): is the BUCK2S rail on?\n", rr(R_SHADER_READY), rr(R_SHADER_TRANS));
+			return 1;
+		}
+	}
+	return 0;
+}
+
+static int
+as0_update(uint32_t cfg, uint32_t tab_lo, uint32_t tab_hi)
+{
+	wr(R_AS0_TRANSCFG, cfg);
+	wr(R_AS0_TRANSCFG + 4, 0);
+	wr(R_AS0_TRANSTAB, tab_lo);
+	wr(R_AS0_TRANSTAB + 4, tab_hi);
+	wr(R_AS0_MEMATTR, MEMATTR_LO);
+	wr(R_AS0_MEMATTR + 4, MEMATTR_HI);
+	if (!WAIT(!(rr(R_AS0_STATUS) & 1u))) {
+		return 1;
+	}
+	wr(R_AS0_COMMAND, 1u);       /* UPDATE */
+	return !WAIT(!(rr(R_AS0_STATUS) & 1u));
+}
+
+void
+sweet_gpu_job_run(volatile uint32_t *gpu)
+{
+	vm_offset_t va = 0;
+	uint32_t sub = 0;
+	int waited = 0;
+
+	sg = gpu;
+	if (rr(R_JOB_RAW) & SLOT0_BITS || rr(R_MMU_RAW) || (rr(R_AS0_STATUS) & 1u) || rr(R_JS0_CMD_NEXT) != 0) {
+		printf("SWEET GPUJOB: refused, stale job/MMU state (JOB_RAW=%#x MMU_RAW=%#x AS0_STATUS=%#x CMD_NEXT=%#x)\n",
+		    rr(R_JOB_RAW), rr(R_MMU_RAW), rr(R_AS0_STATUS), rr(R_JS0_CMD_NEXT));
+		return;
+	}
+	if (sg_power()) {
+		return;
+	}
+	if (kmem_alloc_contig(kernel_map, &va, 0x8000, PAGE_MASK, 0, 0, KMA_DATA | KMA_ZERO | KMA_PERMANENT, VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
+		printf("SWEET GPUJOB: no memory\n");
+		return;
+	}
+	uint64_t pa = (uint64_t)kvtophys(va);
+	volatile uint64_t *l0 = (volatile uint64_t *)va, *l1 = (volatile uint64_t *)(va + 0x1000), *l2 = (volatile uint64_t *)(va + 0x2000),
+	    *l3 = (volatile uint64_t *)(va + 0x3000);
+	volatile uint32_t *d = (volatile uint32_t *)(va + 0x4000);
+	l0[0] = (pa + 0x1000) | PTE_TABLE;
+	l1[0] = (pa + 0x2000) | PTE_TABLE;
+	l2[0] = (pa + 0x3000) | PTE_TABLE;
+	l3[1] = (pa + 0x4000) | PTE_LEAF;                 /* VA 0x1000 -> data page */
+	d[0x10 / 4] = HDR_W4;                             /* job header word 4: index 1 << 16 | Write Value (2) << 1 */
+	*(volatile uint64_t *)(va + 0x4020) = TARGET_VA;  /* payload: address */
+	d[0x28 / 4] = WV_IMM64;                           /* type: immediate 64 */
+	*(volatile uint64_t *)(va + 0x4030) = MAGIC;
+	*(volatile uint64_t *)(va + 0x4100) = 0xa5a5a5a5a5a5a5a5ull;
+	flush_dcache64((addr64_t)pa, 0x5000, TRUE);       /* clean+invalidate: the GPU reads DRAM */
+	if (as0_update(TRANSCFG_ON, (uint32_t)pa, (uint32_t)(pa >> 32))) {
+		printf("SWEET GPUJOB: AS0 UPDATE failed, nothing submitted (AS0_STATUS=%#x)\n", rr(R_AS0_STATUS));
+		return;
+	}
+	wr(R_JS0_HEAD_NEXT, JOB_VA);
+	wr(R_JS0_HEAD_NEXT + 4, 0);
+	wr(R_JS0_AFF_NEXT, SHADERS);
+	wr(R_JS0_AFF_NEXT + 4, 0);
+	wr(R_JS0_CFG_NEXT, JS_CONFIG);
+	wr(R_JS0_CMD_NEXT, 1u);                           /* START */
+	sub = 1;
+	waited = WAIT((rr(R_JOB_RAW) & SLOT0_BITS) || rr(R_MMU_RAW));
+	if (!waited) {
+		wr(R_JS0_CMD, 7u);                            /* HARD_STOP_1, once, as the shim does */
+		waited = WAIT((rr(R_JOB_RAW) & SLOT0_BITS) || rr(R_MMU_RAW));
+	}
+	uint32_t jraw = rr(R_JOB_RAW), mraw = rr(R_MMU_RAW), jst = rr(R_JS0_STATUS), fst = rr(R_AS0_FAULTSTAT);
+	flush_dcache64((addr64_t)pa + 0x4000, 0x1000, TRUE);
+	uint64_t target = *(volatile uint64_t *)(va + 0x4100);
+	uint32_t hexc = d[0];
+	if (jst == 0x08u) {                               /* still ACTIVE: stop it before AS0 goes away */
+		wr(R_JS0_CMD, 7u);
+		(void)WAIT(rr(R_JS0_STATUS) != 0x08u);
+	}
+	int off = as0_update(TRANSCFG_OFF, 0, 0);
+	if (rr(R_JOB_RAW) & SLOT0_BITS) {
+		wr(R_JOB_CLEAR, SLOT0_BITS);
+	}
+	if (rr(R_MMU_RAW) & SLOT0_BITS) {
+		wr(R_MMU_CLEAR, SLOT0_BITS);
+	}
+	printf("SWEET GPUJOB: submit=%s wait=%s JOB_RAW=%#x MMU_RAW=%#x JS0_STATUS=%#x AS0_FAULT=%#x header_exc=%#x target=%#llx (%s) as0_off=%s\n",
+	    sub ? "ok" : "no", waited ? ((jraw & 0x10000u) ? "failed" : (mraw ? "mmu-fault" : "done")) : "timeout", jraw, mraw, jst, fst, hexc, target,
+	    target == MAGIC ? "MAGIC" : target == 0xa5a5a5a5a5a5a5a5ull ? "unchanged" : "other", off ? "FAILED" : "ok");
+}
+
+#endif /* ARM64_BOARD_CONFIG_SWEET */
