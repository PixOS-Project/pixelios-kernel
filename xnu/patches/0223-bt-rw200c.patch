SWEET Bluetooth: boot-arg sweetbtrw200c=1 (patch 0223, ticket T-08f7, W-BTUP): diagnostic status rewrite 0x0c -> 0x00 on bluetoothd's rx stream for the Command Complete of LE Set Scan Enable (0x200c), same parser/safety as the 0x200b rewrite of patch 0217 (rx stream to bluetoothd only; no register store, no controller write; every rewrite prints a BT GAP row; the BT HCI trace keeps the chip's real bytes). bt-up8 [obs 20261107T061644Z-bt-up8]: bluetoothd's 0x200c ON (01 0c 20 02 01 01) is answered 0x0c and bluetoothd exits 1 in the same ms; host decompile [bin bluetoothd, docs/reviews/T-08f7-proof.md]: handleScanStoppedEvent(status != 0) -> exit(1). Default behaviour unchanged.

diff --git a/bsd/dev/sweet_bt_uart.c b/bsd/dev/sweet_bt_uart.c
index d6bcde6..8d7adc6 100644
--- a/bsd/dev/sweet_bt_uart.c
+++ b/bsd/dev/sweet_bt_uart.c
@@ -1296,6 +1296,8 @@ sbu_sweep(const struct sbu_cand *c)
  * Only the rx stream of the kctl path is touched; the probe (sbu_cmd) reads the FIFO itself and never sees a rewrite.
  */
 static bool sbu_rw200b_on;
+static bool sbu_rw200c_on;           /* patch 0223 (T-08f7): boot-arg sweetbtrw200c=1, same rewrite for the status of LE Set Scan Enable (0x200c). bt-up8 [obs 20261107T061644Z-bt-up8]: with 0x200b rewritten, bluetoothd's scan enable ON (01 0c 20 02 01 01) is answered 0x0c and bluetoothd exits in the same ms; decompile [bin]: sub_1005798d4 handleScanStoppedEvent(status!=0) -> exit(1). Diagnostic only, no register store, no controller write */
+static unsigned sbu_rw200c_n;
 static unsigned sbu_rw200b_n, sbu_rw_off, sbu_rw_plen, sbu_rw_other;
 static uint8_t sbu_rw_evt, sbu_rw_opl;
 static uint16_t sbu_rw_opc;
@@ -1311,6 +1313,7 @@ sbu_rw200b(uint8_t *p, size_t n)
 				sbu_rw_off = 1;
 			} else if (b == 0x02 || b == 0x03 || b == 0x05) {   /* ACL/SCO/ISO packet: its payload would be scanned for 0x04 and fake an event; the knob stops for the rest of the boot (review T-4c2c #4) */
 				sbu_rw200b_on = false;
+				sbu_rw200c_on = false;
 				SBU_GAP(SG_OTHER, "sweetbtrw200b: non-event packet type %#x: rewrite disabled for the rest of the boot", b);
 				return;
 			} else {        /* garbage: pass through, framing resumes at the next 0x04; counted loudly */
@@ -1325,7 +1328,11 @@ sbu_rw200b(uint8_t *p, size_t n)
 		case 4: sbu_rw_opl = b; break;
 		case 5: sbu_rw_opc = (uint16_t)(sbu_rw_opl | (b << 8)); break;
 		case 6:
-			if (sbu_rw_evt == 0x0e && sbu_rw_plen >= 4 && sbu_rw_opc == 0x200b && b == 0x0c) {
+			if (sbu_rw_evt == 0x0e && sbu_rw_plen >= 4 && sbu_rw_opc == 0x200c && sbu_rw200c_on && b == 0x0c) {
+				p[i] = 0x00;
+				sbu_rw200c_n++;
+				printf("BT GAP: sweetbtrw200c=1 rewrote the status of the Command Complete for opcode 0x200c from 0x0c (command disallowed, the chip's real answer) to 0x00 for bluetoothd (x%u); diagnostic only, the controller refused the command (scan is NOT running)\n", sbu_rw200c_n);
+			} else if (sbu_rw_evt == 0x0e && sbu_rw_plen >= 4 && sbu_rw_opc == 0x200b && sbu_rw200b_on && b == 0x0c) {
 				p[i] = 0x00;
 				sbu_rw200b_n++;
 				printf("BT GAP: sweetbtrw200b=1 rewrote the status of the Command Complete for opcode 0x200b from 0x0c (command disallowed, the chip's real answer) to 0x00 for bluetoothd (x%u); diagnostic only, the controller refused the command\n", sbu_rw200b_n);
@@ -1357,7 +1364,7 @@ sbu_rx_poll(void)
 	if (err != 0) {
 		sbu.rx_err++;
 		SBU_GAP(SG_RXERR, "uart16 rx error flags %#x (overrun/frame/break); bytes may be lost", err);
-		if (sbu_rw200b_on && sbu_rw_off != 0) {     /* patch 0217: bytes may be lost, the H4 framing of the rewrite parser is no longer known: restart at the next 0x04 */
+		if ((sbu_rw200b_on || sbu_rw200c_on) && sbu_rw_off != 0) {     /* patch 0217: bytes may be lost, the H4 framing of the rewrite parser is no longer known: restart at the next 0x04 */
 			sbu_rw_off = 0;
 			SBU_GAP(SG_RXERR, "sweetbtrw200b: framing reset after rx error");
 		}
@@ -1369,7 +1376,7 @@ sbu_rx_poll(void)
 	if (n != 0) {
 		sbu.rx_bytes += (uint32_t)n;
 		sbu_trace("rx", buf, n);       /* the trace shows the chip's real bytes, before any sweetbtrw200b rewrite */
-		if (sbu_rw200b_on) {
+		if (sbu_rw200b_on || sbu_rw200c_on) {
 			sbu_rw200b(buf, n);
 		}
 		(void)sweet_bt_rx(buf, n);
@@ -1610,6 +1617,14 @@ sweet_bt_uart_attach(void)
 			printf("BT GAP: sweetbtrw200b=1 active: Command Complete status 0x0c for opcode 0x200b is rewritten to 0x00 on the way to bluetoothd (diagnostic knob, not a fix; one BT GAP row per rewrite)\n");
 		}
 	}
+	{       /* patch 0223 (T-08f7): boot-arg sweetbtrw200c=1, the same diagnostic status rewrite for LE Set Scan Enable; default off */
+		int v = 0;
+
+		if (PE_parse_boot_argn("sweetbtrw200c", &v, sizeof(v)) && v == 1) {
+			sbu_rw200c_on = true;
+			printf("BT GAP: sweetbtrw200c=1 active: Command Complete status 0x0c for opcode 0x200c is rewritten to 0x00 on the way to bluetoothd (diagnostic knob, not a fix; the controller is NOT scanning; one BT GAP row per rewrite)\n");
+		}
+	}
 	if (!settled && (sbu_power_on() != 0 || sbu_uart_open(115200) != 0)) {       /* 115200: A12 initial baud [guess], HAL string 115200 (AO:34) */
 		printf("BT GAP: hci uart backend failed to start; powering the controller off\n");
 		(void)sbu_power_off();
