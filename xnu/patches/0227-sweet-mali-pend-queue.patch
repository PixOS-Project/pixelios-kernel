+/* patch 0227: the one place that writes a job into the hardware (moved verbatim out of sweet_mali_submit_tm; lock held, no job in flight). Returns 0 started, EBUSY slot/IRQ state
+ * not clean (nothing written). Same checks, same register writes, same order as before. */
+static int
+sm_start_locked(uint64_t jc, unsigned slot, uint64_t seq)
+{
+	if (rr(R_JS_BASE(slot) + JS_COMMAND_NEXT) != 0 || rr(R_JOB_RAW) != 0 || rr(R_MMU_RAW) != 0) {
+		printf("SWEET MALI: submit refused, slot %u not clean (CMD_NEXT=%#x JOB_RAW=%#x MMU_RAW=%#x)\n", slot, rr(R_JS_BASE(slot) + JS_COMMAND_NEXT), rr(R_JOB_RAW), rr(R_MMU_RAW));
+		return EBUSY;
+	}
+	sm.busy_seq = seq;
+	sm.busy_slot = slot;
+	sm.stopped = 0;
+	sm.faulted = 0;
+	sm.busy_start_us = now_us();
+	perf_start_us = sm.busy_start_us;
+	if (perf_last_done_us != 0) {   /* patch 0212: completion seen -> this job's start stamp, lock held */
+		uint64_t h = perf_start_us - perf_last_done_us;
+		if (h >= HO_FAR_US) {
+			ho_far++;
+		} else {
+			ho_n++;
+			ho_sum += h;
+			if (h > ho_max) {
+				ho_max = h;
+			}
+			ho_hist[h < 25 ? 0 : h < 50 ? 1 : h < 100 ? 2 : h < 200 ? 3 : h < 500 ? 4 : h < 1000 ? 5 : 6]++;
+		}
+		perf_last_done_us = 0;
+	}
+	wr(R_JS_BASE(slot) + JS_HEAD_NEXT, (uint32_t)jc);
+	wr(R_JS_BASE(slot) + JS_HEAD_NEXT + 4, (uint32_t)(jc >> 32));
+	wr(R_JS_BASE(slot) + JS_AFFINITY_NEXT, SHADERS);
+	wr(R_JS_BASE(slot) + JS_AFFINITY_NEXT + 4, 0);
+	wr(R_JS_BASE(slot) + JS_CONFIG_NEXT, sm_js_config);
+	sm.busy = 1;
+	wr(R_JS_BASE(slot) + JS_COMMAND_NEXT, JS_CMD_START);
+	return 0;
+}
