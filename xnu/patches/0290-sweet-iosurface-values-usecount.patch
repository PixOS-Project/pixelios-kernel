+/*
+ * Patch 0290 (rule 7 sweep, research 134 s.2/s.5): IOSurface values. Before, SetValue (sel 9) was answered with a zeroed success, so
+ * IOSurfaceCopyValue/CopyAllValues returned nothing in every process (SpringBoard sets IOSurfaceColorSpace, IOSurfaceICCProfile, IOSurfaceName,
+ * ExtendedPixelsTop/Bottom/Left/Right, CAWindowServerSurface; CA::Render::Surface::encode ships CopyAllValues to backboardd).
+ * Wire format [obs research 134]: sel 9 in = u32 id, 4 pad, OSSerializeBinary CFArray [value, key] or [dictionary]; out = u32 generation.
+ * sel 10 in = u32 id, pad, u8 0; out = u32 0, u32 generation, OSSerializeBinary dictionary (size = real length; 0xe00002db when too small).
+ * sel 11 in = u32 id, pad, key UTF-8 + NUL (empty key = remove all); out = u32 generation. Generation = (old + 2) | 1 per change.
+ * Shared state page: u32 generation at +0x20, u32 serialized size at +0x28 (client refresh test, research 134 s.2).
+ */
+#define SWEET_SURFACE_STATE_VALGEN      0x20
+#define SWEET_SURFACE_STATE_VALSIZE     0x28
+#define SWEET_IOS_BUFFER_TOO_SMALL      ((IOReturn)0xe00002db)
+
+/* serialized size of s->values (0 when empty); caller holds sweet_surface_lock */
+static uint32_t
+sweet_values_publish(SweetSurface *s)
+{
+	uint32_t size = 0;
+	if (s->values != NULL && s->values->getCount() > 0) {
+		OSSerialize *ser = OSSerialize::binaryWithCapacity(1024);
+		if (ser != NULL && s->values->serialize(ser)) {
+			size = ser->getLength();
+		}
+		OSSafeReleaseNULL(ser);
+	}
+	uint8_t *page = (uint8_t *)s->state->getBytesNoCopy();
+	__atomic_store_n((uint32_t *)(page + SWEET_SURFACE_STATE_VALSIZE), size, __ATOMIC_RELEASE);
+	__atomic_store_n((uint32_t *)(page + SWEET_SURFACE_STATE_VALGEN), s->valueGen, __ATOMIC_RELEASE);
+	return size;
+}
+
+static IOReturn
+sweet_values_reply_gen(IOExternalMethodArguments *args, uint32_t gen)
+{
+	return sweet_struct_out(args, &gen, sizeof(gen));
+}
+
+static IOReturn
+sweet_values_set(IOExternalMethodArguments *args)
+{
+	if (args->structureInput == NULL || args->structureInputSize <= 8) {
+		return kIOReturnBadArgument;
+	}
+	uint32_t id;
+	memcpy(&id, args->structureInput, 4);
+	SweetSurface *s = sweet_surface_copy(id);
+	if (s == NULL) {
+		return kIOReturnNotFound;
+	}
+	OSString *perr = NULL;
+	OSObject *o = OSUnserializeBinary((const char *)args->structureInput + 8, args->structureInputSize - 8, &perr);
+	OSArray *arr = OSDynamicCast(OSArray, o);
+	IOReturn ret = kIOReturnBadArgument;
+	uint32_t gen = 0;
+	if (arr != NULL && (arr->getCount() == 2 || arr->getCount() == 1)) {
+		IOLockLock(sweet_surface_lock);
+		if (s->values == NULL) {
+			s->values = OSDictionary::withCapacity(8);
+		}
+		if (s->values != NULL) {
+			if (arr->getCount() == 2) {
+				OSString *k = OSDynamicCast(OSString, arr->getObject(1));
+				OSObject *v = arr->getObject(0);
+				if (k != NULL && v != NULL) {
+					s->values->setObject(k, v);
+					ret = kIOReturnSuccess;
+				}
+			} else {
+				OSDictionary *d = OSDynamicCast(OSDictionary, arr->getObject(0));
+				if (d != NULL) {
+					s->values->merge(d);
+					ret = kIOReturnSuccess;
+				}
+			}
+		} else {
+			ret = kIOReturnNoMemory;
+		}
+		if (ret == kIOReturnSuccess) {
+			s->valueGen = (s->valueGen + 2) | 1;
+			gen = s->valueGen;
+			sweet_values_publish(s);
+		}
+		IOLockUnlock(sweet_surface_lock);
+	}
+	OSSafeReleaseNULL(o);
+	OSSafeReleaseNULL(perr);
+	s->release();
+	if (ret != kIOReturnSuccess) {
+		sweet_note_ignored("sel 9 SetValue", "refused: input is not [value, key] or [dict]", 0xffffffffu);
+		return ret;
+	}
+	return sweet_values_reply_gen(args, gen);
+}
+
+static IOReturn
+sweet_values_copy(IOExternalMethodArguments *args)
+{
+	if (args->structureInput == NULL || args->structureInputSize < 4) {
+		return kIOReturnBadArgument;
+	}
+	uint32_t id;
+	memcpy(&id, args->structureInput, 4);
+	SweetSurface *s = sweet_surface_copy(id);
+	if (s == NULL) {
+		return kIOReturnNotFound;
+	}
+	OSSerialize *ser = NULL;
+	uint32_t hdr[2] = { 0, 0 };
+	IOLockLock(sweet_surface_lock);
+	hdr[1] = s->valueGen;
+	if (s->values != NULL && s->values->getCount() > 0) {
+		ser = OSSerialize::binaryWithCapacity(1024);
+		if (ser != NULL && !s->values->serialize(ser)) {
+			OSSafeReleaseNULL(ser);
+		}
+	}
+	IOLockUnlock(sweet_surface_lock);
+	s->release();
+	uint32_t len = ser != NULL ? ser->getLength() : 0;
+	uint32_t total = 8 + len;
+	IOReturn ret;
+	if (args->structureOutputDescriptor != NULL) {
+		if (total > args->structureOutputDescriptor->getLength()) {
+			ret = SWEET_IOS_BUFFER_TOO_SMALL;
+		} else {
+			ret = sweet_desc_write(args->structureOutputDescriptor, 0, hdr, 8);
+			if (ret == kIOReturnSuccess && len) {
+				ret = sweet_desc_write(args->structureOutputDescriptor, 8, ser->text(), len);
+			}
+			if (ret == kIOReturnSuccess) {
+				args->structureOutputDescriptorSize = total;
+			}
+		}
+	} else if (args->structureOutput == NULL || total > args->structureOutputSize) {
+		ret = SWEET_IOS_BUFFER_TOO_SMALL;
+	} else {
+		memcpy(args->structureOutput, hdr, 8);
+		if (len) {
+			memcpy((uint8_t *)args->structureOutput + 8, ser->text(), len);
+		}
+		args->structureOutputSize = total;
+		ret = kIOReturnSuccess;
+	}
+	OSSafeReleaseNULL(ser);
+	return ret;
+}
+
+static IOReturn
+sweet_values_remove(IOExternalMethodArguments *args)
+{
+	if (args->structureInput == NULL || args->structureInputSize < 9) {
+		return kIOReturnBadArgument;
+	}
+	uint32_t id;
+	memcpy(&id, args->structureInput, 4);
+	SweetSurface *s = sweet_surface_copy(id);
+	if (s == NULL) {
+		return kIOReturnNotFound;
+	}
+	char key[256];
+	uint32_t klen = args->structureInputSize - 8;
+	if (klen > sizeof(key) - 1) {
+		klen = sizeof(key) - 1;
+	}
+	memcpy(key, (const uint8_t *)args->structureInput + 8, klen);
+	key[klen] = 0;
+	uint32_t gen;
+	IOLockLock(sweet_surface_lock);
+	if (s->values != NULL) {
+		if (key[0] == 0) {
+			s->values->flushCollection();
+		} else {
+			s->values->removeObject(key);
+		}
+	}
+	s->valueGen = (s->valueGen + 2) | 1;
+	gen = s->valueGen;
+	sweet_values_publish(s);
+	IOLockUnlock(sweet_surface_lock);
+	s->release();
+	return sweet_values_reply_gen(args, gen);
+}
