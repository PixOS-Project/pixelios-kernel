+/*
+ * Patch 0290 (research 134 s.6): use counts. The client keeps its own per-category counts and calls trap 0 when a category goes 0 -> 1 in that
+ * process and trap 1 when it goes 1 -> 0; IsInUse / IsInUseForCategory read u32 counters at state page +0x18 (category 0) and +0x1c
+ * (category 1). The kernel counts the clients holding each category; a client's hold ends with its reference (release or task exit).
+ * Before this patch both traps were no-ops: every surface looked unused, so CA's backing stores / image queues could reuse a buffer that was
+ * still being read.
+ */
+static void
+sweet_surface_use_adjust(SweetSurface *s, unsigned cat, int delta)
+{
+	sweet_surface_init_lock();
+	IOLockLock(sweet_surface_lock);
+	if (delta > 0) {
+		s->useCount[cat]++;
+	} else if (s->useCount[cat] > 0) {
+		s->useCount[cat]--;
+	}
+	if (s->state != NULL) {
+		__atomic_store_n((uint32_t *)((uint8_t *)s->state->getBytesNoCopy() + 0x18 + 4 * cat), s->useCount[cat], __ATOMIC_RELEASE);
+	}
+	IOLockUnlock(sweet_surface_lock);
+}
+
+IOReturn
+IOSurfaceRootUserClient::trapUseIncrement(void *id, void *category, void *, void *, void *, void *)
+{
+	return useHold((uint32_t)(uintptr_t)id, (uint32_t)(uintptr_t)category, true);
+}
+
+IOReturn
+IOSurfaceRootUserClient::trapUseDecrement(void *id, void *category, void *, void *, void *, void *)
+{
+	return useHold((uint32_t)(uintptr_t)id, (uint32_t)(uintptr_t)category, false);
+}
+
+IOReturn
+IOSurfaceRootUserClient::useHold(uint32_t id, uint32_t cat, bool hold)
+{
+	SweetSurfCpuScope cpuScope(1, 0);   /* patch 0194: traps 0 and 1 */
+	if (cat >= 2) {
+		sweet_note_ignored("use-count trap", "category >= 2 refused", cat);
+		return kIOReturnBadArgument;
+	}
+	IOLockLock(fLock);
+	SweetSurfaceRef *ref = findRef(id, NULL);
+	SweetSurface *s = NULL;
+	if (ref != NULL && ref->uses[cat] != (hold ? 1 : 0)) {
+		ref->uses[cat] = hold ? 1 : 0;
+		s = ref->surface;
+		s->retain();
+	}
+	bool found = ref != NULL;
+	IOLockUnlock(fLock);
+	if (s != NULL) {
+		sweet_surface_use_adjust(s, cat, hold ? 1 : -1);
+		s->release();
+	}
+	return found ? kIOReturnSuccess : kIOReturnNotFound;
+}
