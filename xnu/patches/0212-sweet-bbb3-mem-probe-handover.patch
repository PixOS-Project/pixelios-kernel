+/*
+ * SWEET MEM (patch 0212, T-bbb3, log only; ticket question: is memory the clock-independent limiter of the GPU path?). One kernel thread, started once after every
+ * selected CPU is up (SweetCPU.cpp, before launchd), binds itself to each online CPU in turn and measures cached kernel memory (kalloc_data, normal WB): read (sum of 64-bit
+ * loads, 4 accumulators), copy (memcpy) and dependent pointer chase (random cycle over 64 B lines) at sizes inside L1/L2, inside L2/L3 and past L3, 3 repeats each, median printed:
+ *   `SWEET MEM: cpu=N midr=0x.. size=S read_mbps=.. copy_mbps=.. chase_ns=.. rep=3`   (MB/s = 1e6 bytes/s; chase_ns = ns per dependent load)
+ * No MMIO and no register write (MIDR_EL1 is read). A failed allocation or bind prints `SWEET GAP: MEM ...`; the thread ends after the last line (`SWEET MEM: done`).
+ */
+#define MEM_NSZ 6
+#define MEM_REP 3
+static const size_t mem_sizes[MEM_NSZ] = { 32u << 10, 128u << 10, 512u << 10, 2u << 20, 8u << 20, 32u << 20 };
+
+static uint64_t
+mem_ns(void)
+{
+	uint64_t t, ns;
+	clock_get_uptime(&t);
+	absolutetime_to_nanoseconds(t, &ns);
+	return ns;
+}
+
+static uint64_t
+mem_med3(uint64_t a, uint64_t b, uint64_t c)
+{
+	if (a > b) { uint64_t x = a; a = b; b = x; }
+	if (b > c) { b = c; }
+	return a > b ? a : b;
+}
+
+static void
+mem_probe_cpu(unsigned cpu, uint8_t *buf, size_t bufsz)
+{
+	uint64_t midr = 0;
+	processor_t pr = cpu_to_processor((int)cpu);
+	if (pr == PROCESSOR_NULL) {
+		printf("SWEET GAP: MEM cpu=%u has no processor, skipped\n", cpu);
+		return;
+	}
+	processor_t prev = thread_bind(pr);
+	thread_block(THREAD_CONTINUE_NULL);
+	if ((unsigned)cpu_number() != cpu) {
+		printf("SWEET GAP: MEM cpu=%u bind failed (running on cpu %d), skipped\n", cpu, cpu_number());
+		thread_bind(prev);
+		return;
+	}
+	__asm__ volatile ("mrs %0, midr_el1" : "=r" (midr));
+	for (unsigned si = 0; si < MEM_NSZ; si++) {
+		size_t sz = mem_sizes[si];
+		uint64_t rd[MEM_REP], cp[MEM_REP], ch[MEM_REP];
+		if (2 * sz > bufsz) {
+			printf("SWEET GAP: MEM size %zu exceeds the buffer, skipped\n", sz);
+			continue;
+		}
+		uint64_t *a = (uint64_t *)buf, *b = (uint64_t *)(buf + sz);
+		size_t nw = sz / 8, nl = sz / 64;
+		uint32_t *perm = (uint32_t *)b;   /* chase scratch: nl * 4 bytes <= sz, reused as the copy destination afterwards */
+		for (size_t i = 0; i < nl; i++) {
+			perm[i] = (uint32_t)i;
+		}
+		uint64_t rng = 0x9e3779b97f4a7c15ull ^ sz;
+		for (size_t i = nl - 1; i > 0; i--) {   /* Sattolo: one cycle through every line */
+			rng ^= rng << 13; rng ^= rng >> 7; rng ^= rng << 17;
+			size_t j = (size_t)(rng % i);
+			uint32_t t = perm[i]; perm[i] = perm[j]; perm[j] = t;
+		}
+		for (size_t i = 0; i < nl; i++) {
+			a[(size_t)perm[i] * 8] = (uint64_t)(uintptr_t)&a[(size_t)perm[(i + 1) % nl] * 8];
+		}
+		for (size_t i = 0; i < nw; i++) {
+			if ((i & 7) != 0) {
+				a[i] = i;
+			}
+		}
+		size_t passes = ((64u << 20) / sz) ? ((64u << 20) / sz) : 1;
+		for (unsigned r = 0; r < MEM_REP; r++) {
+			volatile uint64_t sink;
+			uint64_t t0 = mem_ns(), s0 = 0, s1 = 0, s2 = 0, s3 = 0;
+			for (size_t p = 0; p < passes; p++) {
+				for (size_t i = 0; i + 4 <= nw; i += 4) {
+					s0 += a[i]; s1 += a[i + 1]; s2 += a[i + 2]; s3 += a[i + 3];
+				}
+			}
+			sink = s0 + s1 + s2 + s3;
+			(void)sink;
+			uint64_t dt = mem_ns() - t0;
+			rd[r] = dt ? (uint64_t)passes * sz * 1000ull / dt : 0;
+			t0 = mem_ns();
+			for (size_t p = 0; p < passes; p++) {
+				memcpy(b, a, sz);
+			}
+			dt = mem_ns() - t0;
+			cp[r] = dt ? (uint64_t)passes * sz * 1000ull / dt : 0;
+			/* the copy destroyed the chase scratch only (b), a is intact: chase over a */
+			uint64_t *q = a;
+			size_t steps = 1u << 21;
+			t0 = mem_ns();
+			for (size_t i = 0; i < steps; i++) {
+				q = (uint64_t *)(uintptr_t)*q;
+			}
+			dt = mem_ns() - t0;
+			sink = (uint64_t)(uintptr_t)q;
+			ch[r] = dt * 10 / steps;   /* ns x10 */
+		}
+		uint64_t c10 = mem_med3(ch[0], ch[1], ch[2]);
+		printf("SWEET MEM: cpu=%u midr=0x%llx size=%zu read_mbps=%llu copy_mbps=%llu chase_ns=%llu.%llu rep=%d\n", cpu, midr, sz,
+		    mem_med3(rd[0], rd[1], rd[2]), mem_med3(cp[0], cp[1], cp[2]), c10 / 10, c10 % 10, MEM_REP);
+	}
+	thread_bind(prev);
+}
+
+static void
+mem_probe_thread(void *arg, wait_result_t w __unused)
+{
+	unsigned ncpu = (unsigned)(uintptr_t)arg;
+	size_t bufsz = 2 * mem_sizes[MEM_NSZ - 1];
+	uint8_t *buf = kalloc_data(bufsz, Z_WAITOK | Z_ZERO);
+	if (buf == NULL) {
+		printf("SWEET GAP: MEM allocation of %zu bytes failed, no SWEET MEM lines\n", bufsz);
+		thread_terminate_self();
+		return;
+	}
+	printf("SWEET MEM: start ncpu=%u buf=%zu cache line 64 B, sizes 32K..32M, rep %d (patch 0212, log only)\n", ncpu, bufsz, MEM_REP);
+	for (unsigned c = 0; c < ncpu; c++) {
+		mem_probe_cpu(c, buf, bufsz);
+	}
+	kfree_data(buf, bufsz);
+	printf("SWEET MEM: done\n");
+	thread_terminate_self();
+}
+
+void
+sweet_mem_probe_start(unsigned ncpu)
+{
+	static int started;
+	thread_t th;
+	uint32_t on = 0;
+	if (__sync_lock_test_and_set(&started, 1)) {
+		return;
+	}
+	/* T-f7d7: the probe's 64 MiB kalloc_data takes the free pages below the UFS DMA buffer and the Wi-Fi DMA blocks (UFS DMA 0x8854dc000 -> 0x8894a4000), which pushed the
+	 * G1 block outside the reviewed G2 window; so it runs only on request (xrun --intent gpu passes sweetmem=1). Off is logged, never silent. */
+	if (!PE_parse_boot_argn("sweetmem", &on, sizeof(on)) || on == 0) {
+		printf("SWEET MEM: probe off (boot-arg sweetmem=1 runs the 64 MiB cached-memory probe, patch 0212)\n");
+		return;
+	}
+	if (kernel_thread_start(mem_probe_thread, (void *)(uintptr_t)ncpu, &th) != KERN_SUCCESS) {
+		printf("SWEET GAP: MEM probe thread did not start\n");
+		return;
+	}
+	thread_deallocate(th);
+}
