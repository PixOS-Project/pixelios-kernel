+/* Slot of block key in the overlay hash: true and *idx set when present, false with *idx the empty slot to use
+ * (UINT32_MAX if the table were full, which cow_dirty <= cow_cap <= cow_tsize / 2 rules out). ur_lock held. */
+static bool
+ur_cow_find(uint32_t key, uint32_t *idx)
+{
+	uint32_t mask = ur.cow_tsize - 1, i = (key * 2654435761u) & mask;
+
+	for (uint32_t n = 0; n < ur.cow_tsize; n++, i = (i + 1) & mask) {
+		if (ur.cow_tab[i].key == key) {
+			*idx = i;
+			return true;
+		}
+		if (ur.cow_tab[i].key == 0) {
+			*idx = i;
+			return false;
+		}
+	}
+	*idx = UINT32_MAX;
+	return false;
+}
+
+/* The 4 KiB block at byte pos (a multiple of UR_COW_BLK) as the host has it, through the read window. ur_lock held. */
+static int
+ur_cow_base(uint64_t pos, uint8_t *out)
+{
+	if (!ur.cache_valid || pos < ur.cache_off || pos + UR_COW_BLK > ur.cache_off + ur.cache_len) {
+		int error = ur_fill(pos);
+		if (error) {
+			return error;
+		}
+	}
+	if (pos < ur.cache_off || pos + UR_COW_BLK > ur.cache_off + ur.cache_len) {
+		return EIO;
+	}
+	memcpy(out, ur.buf + (pos - ur.cache_off), UR_COW_BLK);
+	return 0;
+}
+
+/* Store n bytes at offset boff of block blk (boff + n <= UR_COW_BLK). ENOSPC at the cap. ur_lock held. */
+static int
+ur_cow_put(uint32_t blk, uint32_t boff, const uint8_t *src, uint32_t n)
+{
+	uint32_t idx = UINT32_MAX;
+	uint8_t *p;
+
+	if (boff >= UR_COW_BLK || n == 0 || n > UR_COW_BLK - boff) {
+		return EINVAL;
+	}
+	if (ur_cow_find(blk + 1, &idx)) {
+		memcpy(ur.cow_pool + (size_t)ur.cow_tab[idx].slot * UR_COW_BLK + boff, src, n);
+		return 0;
+	}
+	if (idx == UINT32_MAX) {
+		return EIO;
+	}
+	if (ur.cow_dirty >= ur.cow_cap) {
+		if (!ur.cow_full_logged) {
+			ur.cow_full_logged = true;
+			printf("SWEET USBROOT: RAM overlay full (%u blocks), writes now fail with ENOSPC\n", ur.cow_cap);
+		}
+		return ENOSPC;
+	}
+	p = ur.cow_pool + (size_t)ur.cow_dirty * UR_COW_BLK;   /* preallocated: the strategy path never allocates */
+	if (n < UR_COW_BLK) {
+		/* partial block: start from the host's bytes */
+		int error = ur_cow_base((uint64_t)blk * UR_COW_BLK, p);
+		if (error) {
+			return error;
+		}
+	}
+	memcpy(p + boff, src, n);
+	ur.cow_tab[idx].key = blk + 1;
+	ur.cow_tab[idx].slot = ur.cow_dirty;
+	ur.cow_dirty++;
+	return 0;
+}
+
+/* Free the overlay and clear every field of it (also the error paths of ur_rootdev). ur.cow off = read-only root. */
+static void
+ur_cow_free(void)
+{
+	if (ur.cow_tab != NULL) {
+		kfree_data(ur.cow_tab, (size_t)ur.cow_tsize * sizeof(*ur.cow_tab));
+	}
+	if (ur.cow_pool != NULL) {
+		kfree_data(ur.cow_pool, (size_t)ur.cow_cap * UR_COW_BLK);
+	}
+	ur.cow = false;
+	ur.cow_cap = ur.cow_dirty = ur.cow_tsize = 0;
+	ur.cow_tab = NULL;
+	ur.cow_pool = NULL;
+}
