 };
 OSDefineMetaClassAndStructors(SweetHIDTouch, IOHIDEventService);
 
+#define SWEET_SWIPE_STEPS 20
+#define SWEET_SWIPE_MAX 400   /* default number of swipes; boot-arg sweetswipecount overrides (patch 0155) */
