 #define EXECUTABLE_KEY "executable_path="
 
+#ifdef ARM64_BOARD_CONFIG_SWEET
+/*
+ * sweetenv boot-arg: "name:A=b,C=d;name2:E=f". On exec of an executable whose
+ * base name equals a name, each assignment is appended to the environment.
+ */
+#define SWEETENV_MAX    512
+#define SWEETENV_ASSIGN 128
+static char sweetenv_buf[SWEETENV_MAX];
+static boolean_t sweetenv_read = FALSE;
+
+static int
+exec_add_sweet_env(struct image_params *imgp, int new_ptr_size)
+{
+	const char *exe, *base, *p, *end;
+	size_t baselen;
+
+	if (!sweetenv_read) {
+		sweetenv_buf[0] = '\0';
+		(void)PE_parse_boot_argn("sweetenv", sweetenv_buf, sizeof(sweetenv_buf));
+		sweetenv_buf[SWEETENV_MAX - 1] = '\0';
+		sweetenv_read = TRUE;
+	}
+	if (sweetenv_buf[0] == '\0') {
+		return 0;
+	}
+	if (strncmp(imgp->ip_strings, EXECUTABLE_KEY, strlen(EXECUTABLE_KEY)) != 0) {
+		return 0;
+	}
+	exe = imgp->ip_strings + strlen(EXECUTABLE_KEY);
+	base = exe;
+	for (p = exe; *p != '\0'; p++) {
+		if (*p == '/') {
+			base = p + 1;
+		}
+	}
+	baselen = strlen(base);
+	if (baselen == 0) {
+		return 0;
+	}
+
+	p = sweetenv_buf;
+	while (*p != '\0') {
+		const char *ent = p;
+		const char *colon = NULL;
+
+		/* entry runs to ';' or end; remember first ':' inside it */
+		for (end = ent; *end != '\0' && *end != ';'; end++) {
+			if (colon == NULL && *end == ':') {
+				colon = end;
+			}
+		}
+		p = (*end == ';') ? end + 1 : end;
+
+		if (colon == NULL || (size_t)(colon - ent) != baselen ||
+		    strncmp(ent, base, baselen) != 0) {
+			continue;
+		}
+
+		/* first matching entry: add its assignments, then stop */
+		const char *a = colon + 1;
+		while (a < end) {
+			const char *ae = a;
+			char tmp[SWEETENV_ASSIGN];
+			size_t alen;
+			int error;
+
+			while (ae < end && *ae != ',') {
+				ae++;
+			}
+			alen = (size_t)(ae - a);
+			if (alen > 0 && alen < sizeof(tmp)) {
+				memcpy(tmp, a, alen);
+				tmp[alen] = '\0';
+				error = exec_add_user_string(imgp, CAST_USER_ADDR_T(tmp), UIO_SYSSPACE, TRUE);
+				if (error) {
+					return error;
+				}
+				if (imgp->ip_argspace < new_ptr_size) {
+					return E2BIG;
+				}
+				imgp->ip_argspace -= new_ptr_size;
+				imgp->ip_envc++;
+				printf("SWEET ENV: %s <- %s\n", base, tmp);
+			}
+			a = (ae < end) ? ae + 1 : ae;
+		}
+		break;
+	}
+	return 0;
+}
+#endif /* ARM64_BOARD_CONFIG_SWEET */
