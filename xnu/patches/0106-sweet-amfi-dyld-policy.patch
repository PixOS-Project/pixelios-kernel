--- a/bsd/kern/sweet_amfi.c
+++ b/bsd/kern/sweet_amfi.c
@@ -411,6 +411,53 @@
 
 static mac_policy_handle_t sweet_amfi_mac_handle;
 
+/*
+ * Policy "AMFI": dyld calls __mac_syscall("AMFI", 0x5a, &{u64 in_flags; u64 *out_flags}) (check dyld policy) before it honours DYLD_*
+ * variables; any failure means "honour none", so DYLD_INSERT_LIBRARIES (the sweetgl EAGL shim in backboardd, docs/research/18 s.1.5, 33) was
+ * silently dropped. Flags 0x7b = allow @paths, path variables, fallback paths, print variables, failed insertions (a bad dylib must not kill
+ * backboardd), interposing [src: ios-sailfish xnu/patches/0139 (0x7b) and hackios kern_minimac.c (0xff), both with the {flags in, ptr out}
+ * argument]. Other operations fail with ENOPOLICY as before. The first call of each process name is logged.
+ */
+#define SWEET_AMFI_OP_CHECK_DYLD_POLICY 0x5a
+#define SWEET_AMFI_DYLD_FLAGS           0x7bull
+
+static int
+sweet_dyld_amfi_syscall(struct proc *p, int call, user_addr_t arg)
+{
+	struct {
+		uint64_t in_flags;
+		user_addr_t out_flags;
+	} a;
+	uint64_t flags = SWEET_AMFI_DYLD_FLAGS;
+	static int logged;
+
+	if (call != SWEET_AMFI_OP_CHECK_DYLD_POLICY) {
+		return ENOPOLICY;
+	}
+	if (copyin(arg, &a, sizeof(a)) != 0 || a.out_flags == 0) {
+		return EFAULT;
+	}
+	if (logged < 16) {
+		char name[32];
+		logged++;
+		proc_name(proc_pid(p), name, sizeof(name));
+		printf("SWEET AMFI: dyld policy for %s in=%#llx -> %#llx\n", name, a.in_flags, flags);
+	}
+	return copyout(&flags, a.out_flags, sizeof(flags));
+}
+
+static const struct mac_policy_ops sweet_dyld_amfi_ops = {
+	.mpo_policy_syscall = sweet_dyld_amfi_syscall,
+};
+
+static struct mac_policy_conf sweet_dyld_amfi_conf = {
+	.mpc_name = "AMFI",
+	.mpc_fullname = "SWEET dyld policy stand-in",
+	.mpc_ops = &sweet_dyld_amfi_ops,
+};
+
+static mac_policy_handle_t sweet_dyld_amfi_handle;
+
 /* Called from bsd_init once MAC policies can register, before any exec. */
 void sweet_amfi_policy_register(void);
 
@@ -423,5 +470,7 @@
 	error = mac_policy_register(&sweet_sandbox_mac_conf, &sweet_sandbox_mac_handle, NULL);
 	printf("SWEET Sandbox: permissive policy %s (%d)\n",
 	    error ? "NOT registered" : "registered", error);
+	error = mac_policy_register(&sweet_dyld_amfi_conf, &sweet_dyld_amfi_handle, NULL);
+	printf("SWEET AMFI: dyld policy \"AMFI\" %s (%d)\n", error ? "NOT registered" : "registered", error);
 }
 #endif /* ARM64_BOARD_CONFIG_SWEET */
