+/* Checked allocator for inflate (stock zcalloc would bzero(NULL) on failure); a 16-byte header remembers the size. */
+static voidpf
+sd_zalloc(voidpf opaque, uInt items, uInt size)
+{
+	(void)opaque;
+	uint64_t n = (uint64_t)items * size + 16;
+	if (n > (1u << 24)) {
+		return Z_NULL;
+	}
+	uint8_t *p = SD_ALLOC((size_t)n);
+	if (!p) {
+		return Z_NULL;
+	}
+	*(uint64_t *)(void *)p = n;
+	return p + 16;
+}
+
+static void
+sd_zfree(voidpf opaque, voidpf ptr)
+{
+	(void)opaque;
+	if (ptr) {
+		uint8_t *p = (uint8_t *)ptr - 16;
+		SD_FREE(p, (size_t)*(uint64_t *)(void *)p);
+	}
+}
+
+/* Sequential reader of one entry's bytes (v1: a copy, v2: bounded streaming inflate). Never produces more than usize. */
+struct sd_rd {
+	const struct sd_ent *e;
+	z_stream zs;
+	uint64_t off;
+};
+
+static int
+sd_rd_open(struct sd_rd *r, const struct sd_ent *e)
+{
+	memset(r, 0, sizeof(*r));
+	r->e = e;
+	if (!e->z) {
+		return 0;
+	}
+	r->zs.zalloc = sd_zalloc;
+	r->zs.zfree = sd_zfree;
+	r->zs.next_in = (Bytef *)(uintptr_t)e->zdata;
+	r->zs.avail_in = (uInt)(e->size - 8);          /* size <= SD_MAXZ was checked in sd_next */
+	return inflateInit(&r->zs) == Z_OK ? 0 : ENOMEM;
+}
+
+/* Exactly n bytes (n <= SD_CHUNK, off + n <= usize) into out, or EIO/EINVAL. */
+static int
+sd_rd_get(struct sd_rd *r, uint8_t *out, uint32_t n)
+{
+	if (n > SD_CHUNK || n > r->e->usize - r->off) {
+		return EINVAL;
+	}
+	if (!r->e->z) {
+		memcpy(out, r->e->data + r->off, n);
+		r->off += n;
+		return 0;
+	}
+	r->zs.next_out = out;
+	r->zs.avail_out = n;
+	while (r->zs.avail_out) {
+		uInt ai = r->zs.avail_in, ao = r->zs.avail_out;
+		int rc = inflate(&r->zs, Z_NO_FLUSH);
+		if (rc == Z_STREAM_END ? r->zs.avail_out != 0 : rc != Z_OK) {
+			return EIO;                                 /* bad stream, or it ends before the declared size */
+		}
+		if (r->zs.avail_in == ai && r->zs.avail_out == ao) {
+			return EIO;                                 /* no progress: truncated stream (never loop) */
+		}
 	}
+	r->off += n;
 	return 0;
 }
 
+/* Release inflate; for v2 also require the stream to be complete with nothing after it. */
+static int
+sd_rd_close(struct sd_rd *r, int err)
+{
+	if (r->e->z && r->zs.state) {
+		if (!err) {
+			uint8_t one;
+			r->zs.next_out = &one;
+			r->zs.avail_out = 1;
+			if (r->off != r->e->usize || inflate(&r->zs, Z_NO_FLUSH) != Z_STREAM_END || r->zs.avail_out != 1 || r->zs.avail_in != 0) {
+				err = EIO;                              /* more output than declared, trailing bytes, or no end marker */
+			}
+		}
+		inflateEnd(&r->zs);
+	}
+	return err;
+}
+
+/* 1 if the entry's bytes (inflated for v2) have the declared crc; v2 also checks the stream is well formed and exactly usize long. */
+static int
+sd_verify(const struct sd_ent *e, uint8_t *buf)
+{
+	if (!e->z) {
+		return sd_crc32(e->data, e->size) == e->crc;
+	}
+	struct sd_rd r;
+	uint32_t crc = 0;
+	int err = sd_rd_open(&r, e);
+	for (uint64_t off = 0; off < e->usize && !err; ) {
+		uint32_t n = (uint32_t)MIN(e->usize - off, (uint64_t)SD_CHUNK);
+		if ((err = sd_rd_get(&r, buf, n)) == 0) {
+			crc = sd_crc32_cont(crc, buf, n);
+		}
+		off += n;
+	}
+	return sd_rd_close(&r, err) == 0 && crc == e->crc;
+}
