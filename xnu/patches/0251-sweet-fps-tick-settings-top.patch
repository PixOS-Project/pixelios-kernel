+/*
+ * Patch 0251 (T-49fb, G-10b-nav): the SWEET FPS statistics of patch 0141 / 0244 moved to file scope so that the vsync timer can print a pending bin too.
+ * Until now a bin was printed only by the next swap that arrived >= 1 s after the previous line, so an animation that stopped inside the second after a
+ * line (the Clock launch of nav5 rep 1: 37 swaps in 0.25 s, then none) was stamped when the NEXT action's first swap came (4.4 s later, outside its action's
+ * window): `gpu-nav-score` saw no bin for the action [obs run 20261108T062128Z-gputest-nav5: app-launch rep 1 'no-anim', its 37 swaps sit in the app-idle bin
+ * stamped 181.093]. sweet_fps_tick() runs from vsyncFired every vsync and prints the bin once it is >= 1 s old and holds a distinct frame, with the same line
+ * format; an idle second is not printed and does not move sec_start (the first swap after idle still prints its own 1-swap lead bin). sweet_fps_emit() is
+ * entered by one thread at a time (OSCompareAndSwap try-lock, a contender skips: the next swap or tick prints); the counters themselves stay unlocked as before.
+ * Log only.
+ */
+static int fps_on = -1, fps_dense;
+static uint32_t last_hash, n_swaps, n_dist, idle_secs;
+static uint32_t n_dist4k, n_small, dense_prev[64 * 64];   /* patch 0244 */
+static bool dense_have, dense_gap_said;
+static uint64_t sec_start, last_dist_t, max_gap_ns;
+static volatile UInt32 fps_emit_busy;
+
+static void
+sweet_fps_emit(uint64_t now_ns, bool tick)
+{
+	if (!OSCompareAndSwap(0, 1, &fps_emit_busy)) {
+		return;
+	}
+	if (sec_start != 0 && now_ns - sec_start >= 1000000000ull) {
+		bool pending = n_dist > 0 || n_dist4k > 0;
+		if (pending || (!tick && (++idle_secs % 10) == 0)) {
+			if (fps_dense) {
+				IOLog("SWEET FPS: swaps %u distinct %u max_gap_ms %u distinct4k %u small_chg %u\n", n_swaps, n_dist, (uint32_t)(max_gap_ns / 1000000), n_dist4k, n_small);
+			} else {
+				IOLog("SWEET FPS: swaps %u distinct %u max_gap_ms %u\n", n_swaps, n_dist, (uint32_t)(max_gap_ns / 1000000));
+			}
+		}
+		if (pending || !tick) {
+			n_swaps = n_dist = n_dist4k = n_small = 0;
+			max_gap_ns = 0;
+			sec_start = now_ns;
+		}
+	}
+	OSCompareAndSwap(1, 0, &fps_emit_busy);
+}
+
+static void
+sweet_fps_tick(uint64_t now_ns)
+{
+	if (fps_on > 0) {
+		sweet_fps_emit(now_ns, true);
+	}
+}
