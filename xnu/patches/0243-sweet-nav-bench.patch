+void
+SweetHIDTouch::navFired(OSObject *owner, IOTimerEventSource *sender)
+{
+	SweetHIDTouch *self = (SweetHIDTouch *)owner;
+	unsigned i = self->fNavIdx, st = self->fNavStep;
+
+	if (self->fNavRep >= self->fNavReps) {
+		IOLog("SWEET NAV: done reps %u\n", self->fNavReps);   /* the host stops on this line */
+		return;
+	}
+	const SweetNavAct *a = &sweetNavActs[i];
+	unsigned ticks = a->kind == 2 ? 0 : (a->ms >= 10 ? a->ms / 10 : 1);
+	if (st == 0) {
+		IOLog("SWEET NAV: ACTION %s begin rep %u now %llu\n", a->name, self->fNavRep, sweetNavNs());
+	}
+	if (a->kind != 2 && st <= ticks) {
+		int x = a->x0 + (a->x1 - a->x0) * (int)st / (int)ticks;
+		int y = a->y0 + (a->y1 - a->y0) * (int)st / (int)ticks;
+		self->touch(0, true, x, y);
+		self->fNavStep = st + 1;
+		sender->setTimeoutMS(10);
+		return;
+	}
+	if (a->kind != 2 && st == ticks + 1) {
+		self->touch(0, false, a->x1, a->y1);
+	}
+	if (st <= ticks + 1) {   /* finger up (or the wait started): observe the animation for `settle` ms */
+		IOLog("SWEET NAV: ACTION %s inputend rep %u now %llu\n", a->name, self->fNavRep, sweetNavNs());
+		self->fNavStep = ticks + 2;
+		sender->setTimeoutMS(a->settle);
+		return;
+	}
+	IOLog("SWEET NAV: ACTION %s end rep %u now %llu\n", a->name, self->fNavRep, sweetNavNs());
+	self->fNavStep = 0;
+	self->fNavIdx = i + 1;
+	if (self->fNavIdx >= SWEET_NAV_N) {
+		self->fNavIdx = 1;   /* later repetitions skip the unlock */
+		self->fNavRep++;
+		if (self->fNavRep >= self->fNavReps) {
+			sender->setTimeoutMS(4000);
+			return;
+		}
+	}
+	self->fNavRng = self->fNavRng * 1664525u + 1013904223u;
+	sender->setTimeoutMS(150 + (self->fNavRng >> 16) % 451);   /* think time 150..600 ms */
+}
