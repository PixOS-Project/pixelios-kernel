+/* Patch 0243 (T-5020, G-10b): the built-in navigation session of sweetnav=R. kind 0 = tap (finger down `ms` ms), 1 = drag from (x0,y0) to (x1,y1) over `ms` ms
+ * (10 ms per touch sample), 2 = wait (no input). `settle` = ms the action is observed after the finger lifts (the animation / app launch under test).
+ * Coordinates: 1080x2400 touch space; unlock, home swipe, Settings icon (page 1), General and About rows are calibrated on hardware
+ * [obs docs/research/61-gpu-black-icons-sampler2drect.md, G-11b g79-g82]; the edge back-swipe, list scrolls and Spotlight pull-down are NOT calibrated [guess]:
+ * a wrong guess shows as a missing animation in the per-action table, never as a silent pass. Typing is not injectable (no HID keyboard path): see the GAP line. */
+struct SweetNavAct { const char *name; unsigned char kind; short x0, y0, x1, y1; unsigned short ms, settle; };
+static const SweetNavAct sweetNavActs[] = {
+	{ "unlock",           1,  540, 2350,  540,  900, 200, 2500 },   /* index 0: first repetition only */
+	{ "home-page-next",   1,  900, 1200,  200, 1200, 250,  700 },
+	{ "home-page-prev",   1,  200, 1200,  900, 1200, 250,  700 },
+	{ "settings-open",    0,  676, 1720,    0,    0, 100, 3000 },
+	{ "general-open",     0,  500, 1900,    0,    0, 100, 1500 },
+	{ "about-open",       0,  500,  370,    0,    0, 100, 1800 },
+	{ "about-scroll-up",  1,  540, 1800,  540,  700, 350,  900 },
+	{ "about-scroll-down", 1, 540,  700,  540, 1800, 350,  900 },
+	{ "about-back",       1,    5, 1200,  700, 1200, 250, 1200 },   /* edge back-swipe [guess] */
+	{ "general-back",     1,    5, 1200,  700, 1200, 250, 1200 },
+	{ "settings-scroll-up", 1, 540, 1800, 540,  700, 350,  900 },
+	{ "settings-scroll-down", 1, 540, 700, 540, 1800, 350,  900 },
+	{ "app-home",         1,  540, 2398,  540, 1200, 200, 1500 },   /* calibrated: 2350 does not work inside an app */
+	{ "app-launch",       0,  676, 1720,    0,    0, 100, 3000 },   /* Settings icon (page 1) from the home screen after app-home: the same tap as settings-open, which animated 3/3 in nav1 [obs]; no longer behind Spotlight (T-b872) */
+	{ "app-idle",         2,    0,    0,    0,    0,   0, 3000 },
+	{ "app-close",        1,  540, 2398,  540, 1200, 200, 1500 },
+	{ "spotlight-open",   1,  540,  500,  540, 1500, 300, 1500 },   /* pull-down on the home screen [guess] */
+	{ "spotlight-close",  1,  540, 2398,  540, 1200, 250, 1500 },   /* home swipe (the app-home gesture): nav1's swipe-up animated 1 of 3 reps and the app-launch tap after it 0 of 3 [guess: Spotlight stayed open under its keyboard]; verified by the camera frame at this marker (T-b872) */
+};
+#define SWEET_NAV_N ((unsigned)(sizeof(sweetNavActs) / sizeof(sweetNavActs[0])))
+static uint64_t
+sweetNavNs(void)
+{
+	uint64_t ns;
+	absolutetime_to_nanoseconds(mach_absolute_time(), &ns);   /* the clock `SWEET SWAPT: now` prints (patch 0186) */
+	return ns;
+}
