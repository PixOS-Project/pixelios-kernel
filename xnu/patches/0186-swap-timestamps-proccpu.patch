+ */
+extern char *proc_name_address(void *p);   /* bsd/kern/kern_proc.c:1390 (declared only locally there, kern_proc.c:225) */
+extern kern_return_t task_info(task_t, task_flavor_t, task_info_t, mach_msg_type_number_t *);   /* osfmk/kern/task.c:4907, MIG routine, as used by bsd/kern/kern_resource.c:1004 */
+
+struct pc_find {
+	int bb_pid, sb_pid;
+	uint64_t bb_us, sb_us;
+	int bb_kr, sb_kr;   /* 0 = task_info ok; else its error, or -1 when proc_task() was NULL (review pg0-r1 F4) */
+};
+
+static int
+pc_callout(proc_t p, void *arg)
+{
+	struct pc_find *f = (struct pc_find *)arg;
+	const char *nm = proc_name_address(p);
+	int is_bb = (strncmp(nm, "backboardd", MAXCOMLEN) == 0), is_sb = (strncmp(nm, "SpringBoard", MAXCOMLEN) == 0);
+	if (is_bb || is_sb) {
+		task_t t = proc_task(p);
+		task_absolutetime_info_data_t ti;
+		mach_msg_type_number_t cnt = TASK_ABSOLUTETIME_INFO_COUNT;
+		int kr = -1;
+		uint64_t us = 0;
+		if (t != TASK_NULL) {
+			kr = (int)task_info(t, TASK_ABSOLUTETIME_INFO, (task_info_t)&ti, &cnt);
+			if (kr == KERN_SUCCESS) {
+				uint64_t ns;
+				absolutetime_to_nanoseconds(ti.total_user + ti.total_system, &ns);
+				us = ns / 1000;
+			}
+		}
+		if (is_bb) {
+			f->bb_pid = proc_pid(p);
+			f->bb_us = us;
+			f->bb_kr = kr;
+		} else {
+			f->sb_pid = proc_pid(p);
+			f->sb_us = us;
+			f->sb_kr = kr;
+		}
+	}
