+	struct pc_find f = { -1, -1, 0, 0, 0, 0 };
+	proc_iterate(PROC_ALLPROCLIST | PROC_NOWAITTRANS, pc_callout, &f, NULL, NULL);
+	if (f.bb_pid < 0 && !bb_said) {
+		bb_said = 1;
+		printf("SWEET PROCCPU: backboardd not found\n");
+	}
+	if (f.sb_pid < 0 && !sb_said) {
+		sb_said = 1;
+		printf("SWEET PROCCPU: SpringBoard not found\n");
+	}
+	if (f.bb_pid >= 0 && f.bb_kr != 0 && !bb_tf_said) {
+		bb_tf_said = 1;
+		printf("SWEET PROCCPU: backboardd pid %d task_info failed (%d)\n", f.bb_pid, f.bb_kr);
+	}
+	if (f.sb_pid >= 0 && f.sb_kr != 0 && !sb_tf_said) {
+		sb_tf_said = 1;
+		printf("SWEET PROCCPU: SpringBoard pid %d task_info failed (%d)\n", f.sb_pid, f.sb_kr);
+	}
+	printf("SWEET PROCCPU: bb_pid %d bb_us %llu sb_pid %d sb_us %llu\n", f.bb_pid, f.bb_us, f.sb_pid, f.sb_us);
+}
