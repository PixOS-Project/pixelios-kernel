+/*
+ * patch 0209 (T-289d, log only): re-read PLL_G3D / PLL_G3D_L2 CON0..CON4 (reads only, the window mapped above) and print them like the boot print, under
+ * the names g3d-t<sec> / g3dl2-t<sec>. Called every 30 s from the Mali poll thread (sweet_mali.c sm_perf_tick, boot-arg sweetperf=1). A clock that
+ * fell back after the probe shows as another khz; a pdiv == 0 prints the counted `GPU GAP: PLL` line (sg_pll_print). No-op before the mux gate passed.
+ */
+static volatile uint32_t *sg_cmu_keep;
+void sweet_gpu_pll_reprint(unsigned sec);
+void
+sweet_gpu_pll_reprint(unsigned sec)
+{
+	uint32_t pg[5], pl[5];
+	char ng[24], nl[24];
+
+	if (sg_cmu_keep == NULL) {
+		return;
+	}
+	for (unsigned i = 0; i < 5; i++) {
+		pg[i] = sg_cmu_keep[(0x140 + 4 * i) / 4];
+		pl[i] = sg_cmu_keep[(0x180 + 4 * i) / 4];
+	}
+	snprintf(ng, sizeof(ng), "g3d-t%u", sec);
+	snprintf(nl, sizeof(nl), "g3dl2-t%u", sec);
+	sg_pll_print(ng, pg, printf);
+	sg_pll_print(nl, pl, printf);
+}
