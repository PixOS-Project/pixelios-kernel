+		}
+	}
+	x->img_crc_rb = ~all;
+	if (x->img_crc_rb != x->img_crc || x->img_next != words) {
+		printf("SWEET WLAN: W10 read-back CRC %#010x != container %#010x (words %u of %u)\n", x->img_crc_rb, x->img_crc, x->img_next, words);
+		return swl_stop(x, SWW_E_READBACK);
+	}
+	return swl_done(x, SWF_W10);
+}
