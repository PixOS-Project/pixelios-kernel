+static inline uint32_t
+swl_crc_b(uint32_t c, uint32_t b)
+{
+	int k;
+
+	c ^= b & 0xFFu;
+	for (k = 0; k < 8; k++) {
+		c = (c >> 1) ^ (0xEDB88320u & (0u - (c & 1u)));
+	}
