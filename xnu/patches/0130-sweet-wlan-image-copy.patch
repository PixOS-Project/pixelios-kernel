+/* the image handed over is usable and its CRC32 (computed here from the bytes) equals the container's; no store has happened yet when this fails at W8 */
+static inline int
+swl_img_check(struct swl_wx *x)
+{
+	uint32_t w, words, src = SWW_CRC_INIT;
+
+	if (x->img == NULL || x->img_len == 0 || x->img_len > SWW_IMG_MAX) {
+		printf("SWEET WLAN: W%u no usable image (%u bytes, at most %u)\n", x->row, x->img_len, SWW_IMG_MAX);
+		return swl_stop(x, SWW_E_IMG);
+	}
+	words = (x->img_len + 3u) / 4u;
+	for (w = 0; w < words; w++) {
+		src = swl_crc_word(src, swl_img_word(x, w), w, x->img_len);
+	}
+	if (~src != x->img_crc) {
+		printf("SWEET WLAN: W%u image CRC %#010x != container %#010x\n", x->row, ~src, x->img_crc);
+		return swl_stop(x, SWW_E_IMG);
+	}
+	return 0;
+}
+
+/* W8: cfg 0x84 (BAR2 window) := SWW_WIN_TAIL, only when the last RAM word lies beyond BAR2 window 0 (ram_end > 0x400000); armed for restore to 0 until W9 is done */
+static inline int
+swl_w8(struct swl_wx *x)
+{
+	x->row = 8;
+	SWW_TRY(swl_img_check(x));
+	if (SWW_RAM_BASE + x->ram_bytes > SWW_TCM_BYTES) {
+		SWW_TRY(swl_wr(x, SWW_CFG, 0, SWW_CFG_WIN2, SWW_WIN_TAIL));
+		printf("SWEET WLAN: W8 cfg 0x84 := %#x (ram_end %#x > %#x)\n", SWW_WIN_TAIL, SWW_RAM_BASE + x->ram_bytes, SWW_TCM_BYTES);
+	} else {
+		printf("SWEET WLAN: W8 no BAR2 window change (ram_end %#x <= %#x)\n", SWW_RAM_BASE + x->ram_bytes, SWW_TCM_BYTES);
+	}
+	x->flags |= SWF_W8;
+	return 0;
+}
+
+/* W9: the last RAM word (backplane ram_end - 4) := 0, read back; then cfg 0x84 back to 0 if W8 moved it */
+static inline int
+swl_w9(struct swl_wx *x)
+{
+	uint32_t end = SWW_RAM_BASE + x->ram_bytes, win = end > SWW_TCM_BYTES ? SWW_WIN_TAIL : 0u;
+
+	x->row = 9;
+	SWW_TRY(swl_wr(x, SWW_BAR2, win, end - 4u - win, 0u));
+	printf("SWEET WLAN: W9 last RAM word bp %#x (BAR2 window %#x offset %#x) := 0, read back 0\n", end - 4u, win, end - 4u - win);
+	if (win != 0) {
+		x->row = 8;
+		SWW_TRY(swl_wr(x, SWW_CFG, 0, SWW_CFG_WIN2, 0u));
+		printf("SWEET WLAN: W8 cfg 0x84 := 0 (window restored)\n");
+		x->row = 9;
+	}
+	return swl_done(x, SWF_W9);
+}
+
+/* W10: the image, ascending 32-bit stores from SWW_RAM_BASE; after each 64 KiB chunk the chunk is read back and its CRC must equal the CRC of the source bytes; at the end the CRC of the
+ * whole read-back must equal the container's. Nothing is released: the CA7 stays halted. */
+static inline int
+swl_w10(struct swl_wx *x)
+{
+	uint32_t words, nch, ch, w, w1, v, sc, rc, all = SWW_CRC_INIT;
+
+	x->row = 10;
+	SWW_TRY(swl_img_check(x));
+	words = (x->img_len + 3u) / 4u;
+	x->img_next = 0;
+	nch = (words + SWW_CHUNK_W - 1u) / SWW_CHUNK_W;
+	for (ch = 0; ch < nch; ch++) {
+		w1 = (ch + 1u) * SWW_CHUNK_W < words ? (ch + 1u) * SWW_CHUNK_W : words;
+		sc = rc = SWW_CRC_INIT;
+		for (w = ch * SWW_CHUNK_W; w < w1; w++) {
+			sc = swl_crc_word(sc, swl_img_word(x, w), w, x->img_len);
+			SWW_TRY(swl_wr(x, SWW_BAR2, 0, SWW_RAM_BASE + 4u * w, swl_img_word(x, w)));
+		}
+		for (w = ch * SWW_CHUNK_W; w < w1; w++) {
+			SWW_RD(x, SWW_BAR2, 0, SWW_RAM_BASE + 4u * w, v);
+			rc = swl_crc_word(rc, v, w, x->img_len);
+			all = swl_crc_word(all, v, w, x->img_len);
+		}
+		printf("SWEET WLAN: W10 chunk %u/%u words %u..%u crc %#010x source %#010x\n", ch + 1u, nch, ch * SWW_CHUNK_W, w1 - 1u, ~rc, ~sc);
+		if (rc != sc) {
