+/* patch 0273 (sprint-wifi Part A): the block accessors of struct swg_bus (sweet_wlan_g2.h rd_blk / wr_blk). Host (G1) and DATA blocks only; both are one linear kernel mapping (sw3_ptr: h->g2va / h->dva + off),
+ * so [a, a + 4 nw) is checked at both ends and is then one run. */
+static int
+sw_g2_blk_map(struct sw_hw *h, int sp, uint32_t a, uint32_t nw, volatile uint32_t **p, uint64_t *pa)
+{
+	const int space = sp == SWG_SP_HOST ? SW3_HOST : sp == SWG_SP_DATA ? SW3_DATA : -1;
+	volatile uint32_t *p0, *pn;
+
+	if (space < 0 || nw == 0u || nw > 1024u || (p0 = sw3_ptr(h, space, a)) == NULL || (pn = sw3_ptr(h, space, a + 4u * (nw - 1u))) == NULL || pn != p0 + (nw - 1u)) {
+		return -1;
+	}
+	*p = p0;
+	*pa = (space == SW3_HOST ? h->g2pa : h->dpa) + a;
+	return space;
+}
+
+/* nw words: ONE clean+invalidate pass over the range (flush_dcache64 = dc civac per line + dsb sy, the rule of sw_g2_rd for every host/DATA word), then the words. = nw sw_g2_rd calls */
+static int
+sw_g2_rd_blk(void *ctx, int sp, uint32_t a, uint32_t *v, uint32_t nw)
+{
+	struct sw_hw *h = ctx;
+	volatile uint32_t *p;
+	uint64_t pa;
+	uint32_t k;
+
+	if (sw_g2_blk_map(h, sp, a, nw, &p, &pa) < 0) {
+		swl_gap("g2", "glue: batched host/DATA read outside the block refused", "high");
+		return -1;
+	}
+	{
+		SWP_T0();
+		flush_dcache64((addr64_t)pa, 4u * nw, TRUE);
+		SWP_ADD(swp_t_cache);
+	}
+	for (k = 0; k < nw; k++) {
+		v[k] = p[k];
+	}
+	return 0;
+}
+
+/* the link precondition of sw3_g2_ok (review r1 F1) for a host/DATA store, read the same way: ISO, LTSSM, ATU regions 0 and 1. 0 = known up */
+static int
+sw3_g2_link(struct sw_hw *h)
+{
+	uint32_t iso = 0, ltssm = 0, a0[7] = { 0 }, a1[7] = { 0 };
+	unsigned i;
+	int bad;
+	SWP_T0();
+
+	bad = sw3_rd(h, SWW_ISO, 0, 0, &iso) != 0 || sw3_rd(h, SWW_ELBI, 0, 0x2C8u, &ltssm) != 0;
+	for (i = 0; i < 7u; i++) {
+		bad |= sw3_rd(h, SWW_ATU, 0, 4u * i, &a0[i]) != 0 || sw3_rd(h, SWW_ATU, 0, 0x200u + 4u * i, &a1[i]) != 0;
+	}
+	SWP_ADD(swp_t_link);
+	swp_n_link++;
+	if (bad || swl_pre_link(iso, ltssm, a0, a1) != 0) {
+		swl_gap("g2", "glue: store refused, the link is not known up", "high");
+		printf("SWEET WLAN: G2 glue: batched store refused: link check failed (iso %#x ltssm %#x)\n", iso, ltssm);
+		return -1;
+	}
+	return 0;
+}
