+/* THE batched store (sweet_wlan_g2.h swg_put_blk only). Accepted only where the per-word path (sw3_wr -> sw3_g2_ok -> sw_l25w_judge) would accept each word: while G2 runs (h->g2, level and g2ok
+ * as sw3_g2_ok), with the L25 judge live, the link known up BEFORE the first word and again AFTER the last (the per-word path checks before each word; a link lost inside the batch fails the
+ * plan before its doorbell, as a refused word would), and swl25w_ok_blk's verdict for every word (sweet_wlan_l25_wl.h: the per-word rules of L3/L4/L5, nothing else is batched). Then the
+ * words, dsb, swl25w_done for each word (a no-op for these classes, kept so the bookkeeping is literally the per-word one), one clean+invalidate pass (sw_g2_wr civacs each word after its store). */
+static uint32_t sw_g2_blk_oldw[1024];
+static uint32_t sw_g2_blk_n, sw_g2_blk_words;
+static int
+sw_g2_wr_blk(void *ctx, int sp, uint32_t a, const uint32_t *v, uint32_t nw)
+{
+	struct sw_hw *h = ctx;
+	volatile uint32_t *p;
+	uint64_t pa;
+	const char *why = "";
+	uint32_t k;
+	int space, cls;
+
+	space = sw_g2_blk_map(h, sp, a, nw, &p, &pa);
+	if (space < 0) {
+		swl_gap("g2", "glue: batched host/DATA store outside the block refused", "high");
+		return -1;
+	}
+	if (!h->g2 || h->l3 < SWW_F3_LEVEL || !h->g2ok || !sw_l25w_live(h)) {
+		swl_gap("g2", "glue: batched store outside the live L25 judge refused", "high");
+		printf("SWEET WLAN: G2 glue: batched store space %d off %#x x%u refused: not G2 with the L25 judge live\n", sp, a, nw);
+		return -1;
+	}
+	if (!sw_plan_link && sw3_g2_link(h) != 0) {     /* perf-d: inside an open plan the opening check covers it */
+		return -1;
+	}
+	if (sw_g2_rd_blk(h, sp, a, sw_g2_blk_oldw, nw) != 0) {     /* the old words the judge sees (sw_l25w_judge reads each through sw_g2_rd) */
+		swl_gap("l25", "glue: L25 store refused, the old word is unreadable", "high");
+		return -1;
+	}
+	{
+		SWP_T0();
+		cls = swl25w_ok_blk(&h->l25w, space == SW3_HOST ? SWL25W_SP_HOST : SWL25W_SP_DATA, a, v, sw_g2_blk_oldw, nw, &why);
+		SWP_ADD(swp_t_judge);
+	}
+	if (cls < 0) {
+		swl_gap("l25", "glue: L25 store refused by the whitelist", "high");
+		printf("SWEET WLAN: L25 glue: batched store space %d off %#x x%u refused (values withheld): %s\n", sp, a, nw, why);
+		return -1;
+	}
+	for (k = 0; k < nw; k++) {
+		p[k] = v[k];
+	}
+	__builtin_arm_dsb(0xf);
+	for (k = 0; k < nw; k++) {
+		swl25w_done(&h->l25w, space == SW3_HOST ? SWL25W_SP_HOST : SWL25W_SP_DATA, a + 4u * k, v[k], sw_g2_blk_oldw[k], cls);
+	}
+	flush_dcache64((addr64_t)pa, 4u * nw, TRUE);
+	if (!sw_plan_link && sw3_g2_link(h) != 0) {     /* perf-d: inside a plan the doorbell's own check comes next */
+		return -1;
+	}
+	sw_g2_blk_n++;
+	sw_g2_blk_words += nw;
+	return 0;
+}
