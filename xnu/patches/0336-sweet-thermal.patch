+static int sweet_reset_ready;       /* patch 0336: /sweet-reset node and both offsets parsed (sweet_restart_start) */
+
+/*
+ * Patch 0336 (SWEET THERMAL CRIT, bsd/dev/sweet_thermal.c): the same orderly path as the remote reset to the bootloader (sweet_remote_thread): filesystem sync (bounded to 15 s),
+ * then sweet_machine_reset(1), so the phone cools in fastboot. No new register: the PMU SMC mode write and software reset are the ones every reset already makes. Returns -1 (GAP)
+ * instead of resetting when the reset node was never parsed, because then the offsets are 0 and the SMC store would go to the wrong address. Does not return on success.
