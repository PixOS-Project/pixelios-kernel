-void
-sweet_chg_tick(int log_pending)
+static void
+sweet_chg_tick_locked(int log_pending)
 {
 	if (chg_stage >= 2) {
 		sweet_chg_i2c_tick(log_pending);        /* patch 0284: phase 2 (bsd/dev/sweet_chg_i2c.c), default off, one-shot */
@@ -552,3 +562,32 @@ sweet_chg_tick(int log_pending)
 	}
 	chg_stage_b();
 }
+
+/*
+ * Patch 0336: the charger engine (phase 1, the phase 2/3 state machine, the fuel-gauge temperature sampler of bsd/dev/sweet_thermal.c) now has two callers, the USB log thread
+ * and the thermal thread. One try-lock serialises them: a caller that does not get it skips this call (every caller is periodic and re-entrant by design), so neither ever
+ * blocks on the other and the I2C controller never sees two transfers.
+ */
+static volatile int chg_busy;
+
+int
+sweet_chg_enter(void)
+{
+	return __sync_lock_test_and_set(&chg_busy, 1) == 0;
+}
+
+void
+sweet_chg_leave(void)
+{
+	__sync_lock_release(&chg_busy);
+}
+
+void
+sweet_chg_tick(int log_pending)
+{
+	if (!sweet_chg_enter()) {
+		return;
+	}
+	sweet_chg_tick_locked(log_pending);
+	sweet_chg_leave();
+}
