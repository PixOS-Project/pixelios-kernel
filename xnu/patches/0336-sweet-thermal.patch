diff --git a/bsd/dev/sweet_thermal.c b/bsd/dev/sweet_thermal.c
new file mode 100644
--- /dev/null
+++ b/bsd/dev/sweet_thermal.c
@@ -0,0 +1,232 @@
+/*
+ * SWEET THERMAL (xnu patch 0336, ALL-ON safety, user 2026-11-12: battery 51.6-53 C under stress with no throttle). Facts: docs/research/150-thermal-path.md.
+ *
+ * A kernel thread (every boot; boot-arg sweetthermal=0 turns it off, default on) samples the battery temperature of the MAX77759 fuel gauge (FG 0x36 reg 0x08, the read
+ * patch 0307 already does for the SWEET CHG MON rows; no new register) and the FG Current (0x0a, sign: positive = charging) every 10 s through
+ * sweet_chg_fg_sample() (bsd/dev/sweet_chg_i2c.c), independent of the USB link and of every job. The policy (thresholds, hysteresis, what each state does) is
+ * bsd/dev/sweet_thermal.h, which the host test compiles unchanged. This file holds the three actuators and the value iOS reads:
+ *   - X1 cores: sched_perfcontrol_update_recommended_cores(), the call patch 0270 makes once at boot (a scheduler hint, no register);
+ *   - charge limit: sweet_chg_icl_thermal() (CNFG_09 back to the original value / back to 875 mA, the only chip register this series ever writes);
+ *   - CRIT: sweet_thermal_reboot_bootloader() (bsd/dev/sweet_restart.c: the orderly clean-stop + reset-to-bootloader the remote reset already uses);
+ *   - sweet_thermal_get(): the latest good value, read by SweetBattery (IOPMPowerSource Temperature) and SweetHIDTemperature (HID type 0xF events).
+ */
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <kern/clock.h>
+#include <mach/mach_time.h>
+#include <machine/machine_routines.h>
+#include <pexpert/pexpert.h>
+#include <libkern/libkern.h>
+#include <stdint.h>
+
+#define TH_LOG(...) printf(__VA_ARGS__)
+#include "sweet_thermal.h"
+
+extern kern_return_t kernel_thread_start(thread_continue_t, void *, thread_t *);
+extern void thread_deallocate(thread_t);
+extern void sched_perfcontrol_update_recommended_cores(uint32_t recommended_cores);   /* osfmk/kern/sched_prim.c; the call of patch 0270 */
+extern unsigned int ml_get_cpu_count(void);                                          /* patch 0270 */
+extern int sweet_chg_fg_sample(int32_t *deci_c, int32_t *cur_uA);                    /* bsd/dev/sweet_chg_i2c.c (patch 0336) */
+extern int sweet_chg_icl_thermal(int hold);                                          /* bsd/dev/sweet_chg_i2c.c (patch 0336) */
+extern void sweet_chg_tick(int log_pending);                                         /* bsd/dev/sweet_chg.c */
+extern int sweet_thermal_reboot_bootloader(void);                                    /* bsd/dev/sweet_restart.c (patch 0336) */
+
+#define TH_KICK_MS 60000u       /* drive charger phase 1 from this thread when the USB log thread has not by this uptime (60 s: on a USB boot its first tick comes within seconds) */
+
+static int th_on = -1;                  /* -1 = boot-arg not read yet */
+static struct th_ctl th_c;
+static uint32_t th_boot_mask;
+static volatile int32_t th_g_cc;        /* latest good value, centi-C (published before th_g_ms with a release store; read after an acquire load of th_g_ms: review 0336 F8) */
+static volatile uint32_t th_g_state;
+static volatile uint64_t th_g_ms;       /* when th_g_cc was read; 0 = never */
+
+static uint64_t
+th_now_ms(void)
+{
+	uint64_t ns;
+
+	absolutetime_to_nanoseconds(mach_absolute_time(), &ns);
+	return ns / 1000000u;
+}
+
+/* literal name in the call: tools/run-preflight --gen-bootargs finds boot-args by scanning PE_parse_boot_arg*("name", ...) */
+int
+sweet_thermal_enabled(void)
+{
+	uint32_t v = 1;
+
+	if (th_on < 0) {
+		th_on = !(PE_parse_boot_argn("sweetthermal", &v, sizeof(v)) && v == 0);
+	}
+	return th_on;
+}
+
+/*
+ * TEST ONLY boot-arg sweetthermalramp=<deciC per sample> (1..100): the backstop's state machine sees real + ramp * samples-since-start (sweet_thermal.h th_tick); what sweet_thermal_get() publishes
+ * (IOPMPowerSource Temperature, HID TG0B) stays the real value. Returns 1 and the value when the arg is present. Literal name here: tools/run-preflight --gen-bootargs scans for it.
+ */
+static int
+th_ramp_arg(uint32_t *v)
+{
+	*v = 0;
+	return PE_parse_boot_argn("sweetthermalramp", v, sizeof(*v)) ? 1 : 0;
+}
+
+/* 1 = a good sample exists (age in ms, may be stale: the caller decides, TH_STALE_MS), 0 = none yet or the thread is off. */
+int
+sweet_thermal_get(int32_t *centi_c, uint32_t *state, uint32_t *age_ms)
+{
+	uint64_t t = __atomic_load_n(&th_g_ms, __ATOMIC_ACQUIRE);
+
+	if (t == 0) {
+		return 0;
+	}
+	*centi_c = th_g_cc;
+	*state = th_g_state;
+	*age_ms = (uint32_t)(th_now_ms() - t);
+	return 1;
+}
+
+static void
+th_op_x1(int drop, int32_t dC)
+{
+	uint32_t m = drop ? (th_boot_mask & TH_X1_DROP_MASK) : th_boot_mask;
+
+	(void)dC;
+	if (m == 0) {
+		printf("SWEET THERMAL GAP: X1 drop mask 0x%x & boot mask 0x%x is empty: cores left as they are\n", TH_X1_DROP_MASK, th_boot_mask);
+		return;
+	}
+	sched_perfcontrol_update_recommended_cores(m);
+	printf("SWEET THERMAL: recommended cores now 0x%x (%s; boot value 0x%x, patch 0270 call)\n", m, drop ? "X1 dropped" : "restored", th_boot_mask);
+}
+
+static int
+th_op_chg(int hold, int32_t dC)
+{
+	(void)dC;
+	return sweet_chg_icl_thermal(hold);
+}
+
+static int
+th_op_crit(int32_t dC)
+{
+	(void)dC;
+	return sweet_thermal_reboot_bootloader();
+}
+
+static const struct th_ops th_ops_k = { th_op_x1, th_op_chg, th_op_crit };
+
+static void
+sweet_thermal_thread(void *arg __unused, wait_result_t wr __unused)
+{
+	uint64_t t0 = th_now_ms();
+	uint32_t i;
+
+	for (i = 0; i < 20; i++) {      /* let the charger phase 1 (USB log thread) and the rest of early boot go first; the first sample is at ~20 s */
+		delay_for_interval(1000, 1000 * 1000);
+	}
+	for (;;) {
+		int32_t dC = 0, cur = 0;
+		int rd = sweet_chg_fg_sample(&dC, &cur);
+		uint64_t now = th_now_ms();
+
+		if (rd == TH_RD_NOTREADY && now - t0 >= TH_KICK_MS) {
+			sweet_chg_tick(1);      /* the USB log thread never drove charger phase 1 (no USB link): drive it from here, reads only (patch 0283 stage A/B). log_pending=1 (review 0336 F6): the stage A -> B
+					 * and P2 group pacing (CHG_FORCE_MS / I2C_FORCE_MS, 10 s, with their GAP line) is kept instead of running stage B / the next group at once */
+		}
+		th_tick(&th_c, &th_ops_k, rd, dC, cur, now);
+		if (rd == TH_RD_OK && th_c.last_ok_ms == now) {
+			/* the REAL sensor value, never the test-ramp one (th_c.last_dC) */
+			th_g_cc = th_c.last_real_dC * 10;
+			th_g_state = (uint32_t)th_state(&th_c);
+			__atomic_store_n(&th_g_ms, now ? now : 1, __ATOMIC_RELEASE);     /* last: a reader that sees this time sees the value stored before it (review 0336 F8) */
+		}
+		for (i = 0; i < TH_PERIOD_MS / 1000u; i++) {
+			delay_for_interval(1000, 1000 * 1000);
+		}
+	}
+}
+
+/*
+ * Review 0336 F7: the X1-drop mask 0x18 is the A76 pair only under tools/xrun's cpu order (cpus=5, /cpus order 0,6,7,4,5, the one patch 0270's sweetrecores=0x1e assumes).
+ * Read the physical core of every logical cpu from the topology (the MPIDR 'reg' of the ADT cpu node, Aff1) and say loudly when the assumption does not hold. The backstop stays active
+ * (a different mask still lowers the load and can never be empty, th_op_x1); only what the line claims changes.
+ */
+static void
+th_check_cpu_order(unsigned int cpus)
+{
+	const ml_topology_info_t *ti = ml_get_topology_info();
+	uint32_t phys[32] = { 0 };
+	unsigned n = 0, i, g;
+
+	if (ti != NULL && ti->cpus != NULL) {
+		for (i = 0; i < ti->num_cpus && i < 32u; i++) {
+			phys[i] = (ti->cpus[i].phys_id >> 8) & 0xffu;
+			n++;
+		}
+	}
+	g = th_order_gaps(cpus, n ? phys : NULL, n, th_boot_mask);
+	if (g == 0) {
+		printf("SWEET THERMAL: X1 drop mask 0x%x = logical cpu3,4 = physical A76 pair 4,5 (cpus=%u, tools/xrun /cpus order 0,6,7,4,5: the order patch 0270 sweetrecores=0x1e assumes)\n", TH_X1_DROP_MASK, cpus);
+		return;
+	}
+	if (g & 4u) {
+		printf("SWEET THERMAL GAP: cpu topology unavailable: cannot tell which physical cores the X1 drop mask 0x%x keeps (it assumes logical cpu3,4 = the A76 pair, tools/xrun cpus=5 /cpus order 0,6,7,4,5)\n", TH_X1_DROP_MASK);
+	}
+	if (g & 1u) {
+		printf("SWEET THERMAL GAP: cpus=%u, the X1 drop mask 0x%x is made for cpus=%u (logical cpu0 = A55, cpu1/2 = X1, cpu3/4 = A76): a drop also takes the other cores outside the mask\n", cpus, TH_X1_DROP_MASK,
+		    TH_X1_DROP_NCPU);
+	}
+	if (g & 2u) {
+		printf("SWEET THERMAL GAP: /cpus order differs from tools/xrun's 0,6,7,4,5: X1 drop mask 0x%x keeps logical cpus whose physical cores are NOT the A76 pair 4,5 (physical cores by logical cpu:", TH_X1_DROP_MASK);
+		for (i = 0; i < n; i++) {
+			printf(" %u", phys[i]);
+		}
+		printf("): the line \"X1 dropped\" does not describe the cores that stay\n");
+	}
+}
+
+/* Called once from sweet_restart_start() (patch 0336). */
+void
+sweet_thermal_start(void)
+{
+	thread_t th;
+	uint32_t rc = 0, rv;
+	unsigned int ncpu = ml_get_cpu_count();
+	uint32_t online = ncpu >= 32 ? 0xffffffffu : ((1u << ncpu) - 1);
+
+	if (!sweet_thermal_enabled()) {
+		if (th_ramp_arg(&rv)) {
+			printf("SWEET THERMAL GAP: sweetthermalramp=%u (test only) refused: sweetthermal=0, no thermal backstop is running to test: no ramp\n", rv);
+		}
+		printf("SWEET THERMAL GAP: disabled by sweetthermal=0: no thermal backstop (no X1 drop, no charge hold, no CRIT reboot), IOPMPowerSource Temperature stays the constant 25.00 C (estimated), no HID temperature service\n");
+		return;
+	}
+	/* the boot-time mask patch 0270 set (sweetrecores) is what a restore goes back to */
+	th_boot_mask = online;
+	if (PE_parse_boot_argn("sweetrecores", &rc, sizeof(rc)) && (rc & online) != 0 && (rc & ~online) == 0) {
+		th_boot_mask = rc;
+	}
+	th_init(&th_c);
+	if (th_ramp_arg(&rv)) {
+		if (th_ramp_set(&th_c, rv) == 0) {
+			printf("SWEET THERMAL GAP: sweetthermalramp=%u (test only): the backstop sees real + %u.%u C per sample; a CRIT park is expected\n", rv, rv / 10u, rv % 10u);
+		} else {
+			printf("SWEET THERMAL GAP: sweetthermalramp=%u (test only) refused: outside %d..%d (deci-C per sample): no ramp, the backstop sees the real temperature\n", rv, TH_RAMP_MIN_DC, TH_RAMP_MAX_DC);
+		}
+	}
+	th_check_cpu_order(ncpu);
+	printf("SWEET THERMAL: on (patch 0336, sweetthermal=0 disables): sample %u s | X1 drop >= %d.%d C restore <= %d.%d C (mask 0x%x of boot 0x%x) | charge hold >= %d.%d C while charging, release <= %d.%d C | CRIT >= %d.%d C x%u samples -> reboot to bootloader\n",
+	    TH_PERIOD_MS / 1000u, TH_X1_DROP_DC / 10, TH_X1_DROP_DC % 10, TH_X1_RESTORE_DC / 10, TH_X1_RESTORE_DC % 10, TH_X1_DROP_MASK, th_boot_mask, TH_CHG_HOLD_DC / 10, TH_CHG_HOLD_DC % 10,
+	    TH_CHG_RELEASE_DC / 10, TH_CHG_RELEASE_DC % 10, TH_CRIT_DC / 10, TH_CRIT_DC % 10, TH_CRIT_CONFIRM);
+	/* what note 150 says stays unknown or has no backend (rule 7: say it on every boot) */
+	printf("SWEET THERMAL GAP: sensor->hotspot mapping of thermalmonitord (D22AP plist) is unresolved (note 150 A4): the TG0B battery value may feed analytics and the pressure level only, not every hotspot\n");
+	printf("SWEET THERMAL GAP: iOS CPU/GPU load clamps (CPUPowerTarget, GPUMaxPerf, pkg-low-power-target on AppleCLPC/ApplePPM/AGXAccelerator) have no kernel backend: only this backstop reduces compute\n");
+	printf("SWEET THERMAL GAP: no ACPM client in XNU (patch 0103): no clock step-down; AppleChargeRateLimitIndex (thermalmonitord's charger write) has no handler\n");
+	if (kernel_thread_start(sweet_thermal_thread, NULL, &th) == KERN_SUCCESS) {
+		thread_deallocate(th);
+	} else {
+		printf("SWEET THERMAL GAP: kernel_thread_start failed: no thermal sampling on this boot\n");
+	}
+}
diff --git a/bsd/dev/sweet_thermal.h b/bsd/dev/sweet_thermal.h
new file mode 100644
--- /dev/null
+++ b/bsd/dev/sweet_thermal.h
@@ -0,0 +1,307 @@
+/*
+ * SWEET THERMAL policy (xnu patch 0336, ALL-ON safety, user 2026-11-12: battery 51.6-53 C under stress with no throttle).
+ * Facts: docs/research/150-thermal-path.md ("the note"; was 146). Pure C, no kernel calls: the includer defines TH_LOG(...) (printf-like) BEFORE
+ * including this file; bsd/dev/sweet_thermal.c is the kernel glue and tools/sweet_thermal_host_test.c is the host harness (tools/test_sweet_thermal.py).
+ *
+ * Temperature unit everywhere here: deci-degrees C (dC), the unit mon_row() of patch 0307 already computes from the fuel gauge (MAX77759 FG 0x36 reg 0x08).
+ */
+#ifndef SWEET_THERMAL_H
+#define SWEET_THERMAL_H
+
+#include <stdint.h>
+#ifdef SWEET_THERMAL_HOST
+#include <stdio.h>      /* snprintf; the kernel gets it from libkern/libkern.h via the includer */
+#endif
+
+#ifndef TH_LOG
+#error "define TH_LOG(...) before including sweet_thermal.h"
+#endif
+
+/* ==================================================================================================================================
+ * THE THRESHOLD TABLE. One place; every value with the reason it has this number. dC = deci-degrees C.
+ * User 2026-11-12 = the task text of this patch (thresholds and hysteresis were chosen by the user, not derived here).
+ * ================================================================================================================================== */
+#define TH_PERIOD_MS        10000u   /* sample every 10 s: user 2026-11-12. Observed rise 0.63 C/min (note 150 C3) = 0.1 C per sample; the 30 s MON cadence gave 0.3 C. */
+#define TH_LOG_EVERY_MS     60000u   /* periodic state line once per 60 s: user 2026-11-12 */
+#define TH_X1_DROP_DC       480      /* >= 48.0 C: drop the X1 cores. User 2026-11-12; the note's D(ii) "compute" row uses the same 48 C ("user target"). */
+#define TH_X1_RESTORE_DC    440      /* <= 44.0 C: restore. User 2026-11-12 (4.0 C hysteresis; the D22AP plist ReleaseHysteresis is 2.0, note A4: 4.0 is stricter). */
+#define TH_CHG_HOLD_DC      450      /* >= 45.0 C AND charging: CNFG_09 back to its original value. User 2026-11-12; note D(ii) "charge" row: 45 C = the plist MLBLowHS target, note A4. */
+#define TH_CHG_RELEASE_DC   420      /* <= 42.0 C: back to 875 mA. User 2026-11-12 (3.0 C hysteresis). */
+#define TH_CRIT_DC          550      /* >= 55.0 C: CRIT + orderly reboot to the bootloader. User 2026-11-12; plist THERMAL_TRAP_LOAD is 53-58 C, THERMAL_TRAP_SLEEP 55-60 C (note A4). */
+#define TH_CRIT_CONFIRM     2u       /* consecutive samples >= TH_CRIT_DC before the reboot is requested (20 s). DESIGN CHOICE, not from the user: a single bad I2C word must not
+                                      * reboot the phone; cost 10 s at 0.63 C/min = 0.1 C. */
+#define TH_X1_DROP_MASK     0x18u    /* cores 3,4 (A76) stay recommended, cores 0..2 do not: user 2026-11-12 "mask 0x18"; note C2 (cpu1/2 = X1 at 2801 MHz, cpu3/4 = A76 2252 MHz, cpu0 = A55) */
+#define TH_X1_DROP_NCPU     5u       /* the cpu count the mask is made for: cpus=5 with tools/xrun's /cpus order 0,6,7,4,5 (rule-8 review 0336 F7) */
+#define TH_SANE_MIN_DC      (-200)   /* a reading outside [-20.0, 90.0] C is a failed read (GAP, no action). DESIGN CHOICE [guess]: outside any Li-ion cell state worth acting on */
+#define TH_SANE_MAX_DC      900
+#define TH_STALE_MS         60000u   /* no good sample for 60 s: the value is stale (GAP once, consumers stop trusting it). DESIGN CHOICE */
+#define TH_GAP_EVERY_MS     60000u   /* a repeating failure GAPs on the first occurrence and then once per 60 s (rule 7: never silent, never a flood) */
+#define TH_CHG_RETRY_MAX    4u       /* a charge HOLD that failed (-1) is asked again at the next sample (rule-8 review 0336 F3), at most this many times per hot period; DESIGN CHOICE: a permanent
+                                      * cause (foreign CNFG_09 value, stopped bus) repeats its callee GAP lines, so the retry is bounded; a busy engine / closed gate (2) is not counted */
+#define TH_RAMP_MIN_DC      1        /* boot-arg sweetthermalramp=<deciC per sample>, TEST ONLY (user 2026-11-13: prove every backstop action without heating the battery): accepted range 1..100 */
+#define TH_RAMP_MAX_DC      100      /* (100 = 10 C per sample). 1 C per 10 s sample (=10) walks 35 C real to X1 drop 48 C in ~2 min and to the CRIT park 55 C (x2) in ~3.5 min */
+#define TH_RAMP_START_N     3u       /* the ramp starts at the 3rd good sample: bias = ramp * (good samples - 2), so the 3rd sample is the first biased one */
+#define TH_RAMP_BIAS_CAP_DC 1000     /* bias never above 100.0 C (int overflow guard; a CRIT park is long past) */
+
+/*
+ * Rule-8 review 0336 F7: TH_X1_DROP_MASK (0x18) is "the A76 pair" only under ONE logical cpu order. Logical ids are assigned by /cpus DT order (xnu), and the order
+ * 0,6,7,4,5,... (logical cpu0 = A55, cpu1/2 = the X1 pair, cpu3/4 = the A76 pair) comes from tools/xrun --adt-cpu-order (applied when no --adt is given) together with cpus=5, the order
+ * patch 0270's sweetrecores=0x1e assumes. Under the plain DT order 0x18 = physical cpu3 (A55) + cpu4 (A76) and the "X1 dropped" line would be wrong.
+ * phys[i] = physical core number (gs101 MPIDR Aff1: A55 0-3, A76 4-5, X1 6-7) of logical cpu i, nphys entries (NULL / 0 = topology unknown).
+ * Returns a bit set: 1 = ncpu != TH_X1_DROP_NCPU, 2 = a logical cpu of the kept mask (boot_mask & 0x18) is not a physical A76 (4, 5), 4 = physical ids unknown.
+ */
+static inline unsigned
+th_order_gaps(unsigned ncpu, const uint32_t *phys, unsigned nphys, uint32_t boot_mask)
+{
+	unsigned g = 0, i;
+	uint32_t m = boot_mask & TH_X1_DROP_MASK;
+
+	if (ncpu != TH_X1_DROP_NCPU) {
+		g |= 1u;
+	}
+	if (phys == 0 || nphys == 0) {
+		return g | 4u;
+	}
+	for (i = 0; i < 32u; i++) {
+		if (((m >> i) & 1u) != 0 && (i >= nphys || (phys[i] != 4u && phys[i] != 5u))) {
+			g |= 2u;
+		}
+	}
+	return g;
+}
+
+enum { TH_RD_OK = 0, TH_RD_NOTREADY = 1, TH_RD_BUSY = 2, TH_RD_FAIL = -1, TH_RD_DEAD = -2, TH_RD_NOENGINE = -3 };
+
+/* The three actuators. chg() returns 0 = done, 1 = nothing to do (lever not engaged), 2 = engine busy (asked again at the next sample), -1 = refused/failed (GAP already printed by the callee). */
+struct th_ops {
+	void (*x1)(int drop, int32_t dC);
+	int (*chg)(int hold, int32_t dC);
+	int (*crit)(int32_t dC);                /* 0 = reboot path entered (does not return on hardware), -1 = refused (GAP printed by the callee; CRIT is requested again at the next sample) */
+};
+
+struct th_ctl {
+	uint8_t x1_dropped, chg_held, crit_n, crit_req, have_temp, stale_said, chg_retry;
+	int32_t last_dC, last_cur_uA;   /* last_dC = the value the state machine used (real + test bias); last_real_dC = the sensor value: ONLY this one is ever published to iOS */
+	int32_t last_real_dC, bias_dC;
+	int last_state;
+	uint32_t fail_n, samples;
+	uint64_t last_ok_ms, last_log_ms, last_gap_ms, last_nochg_ms;
+	uint8_t gap_said, nochg_said, ramp_gap_said;
+	uint16_t ramp_dC;               /* test ramp, deci-C per good sample from sample TH_RAMP_START_N on; 0 = off (the normal boot) */
+};
+
+static inline void
+th_fmt(char *b, unsigned n, int32_t dC)
+{
+	int32_t a = dC < 0 ? -dC : dC;
+
+	snprintf(b, n, "%s%d.%d", dC < 0 ? "-" : "", (int)(a / 10), (int)(a % 10));
+}
+
+/* state number printed as `state S`: 0 normal, 1 charge-hold, 2 X1-drop, 3 X1-drop + charge-hold, 4 CRIT */
+static inline int
+th_state(const struct th_ctl *c)
+{
+	return c->crit_req ? 4 : (c->x1_dropped ? 2 : 0) + (c->chg_held ? 1 : 0);
+}
+
+static inline const char *
+th_state_name(int s)
+{
+	static const char *const n[] = { "NORMAL", "CHG-HOLD", "X1-DROP", "X1-DROP+CHG-HOLD", "CRIT" };
+
+	return s >= 0 && s <= 4 ? n[s] : "?";
+}
+
+static inline void
+th_init(struct th_ctl *c)
+{
+	*c = (struct th_ctl){ .last_state = -1 };
+}
+
+/* TEST ONLY (boot-arg sweetthermalramp): 0 = armed, -1 = refused (outside 1..100: no ramp, the backstop keeps seeing the real temperature). The bias is added inside th_tick() to the value the
+ * STATE MACHINE uses; the value published to iOS (last_real_dC) is never biased. */
+static inline int
+th_ramp_set(struct th_ctl *c, uint32_t dC_per_sample)
+{
+	if (dC_per_sample < TH_RAMP_MIN_DC || dC_per_sample > TH_RAMP_MAX_DC) {
+		c->ramp_dC = 0;
+		return -1;
+	}
+	c->ramp_dC = (uint16_t)dC_per_sample;
+	return 0;
+}
+
+static inline void
+th_gap(struct th_ctl *c, uint64_t now_ms, const char *what, int rc)
+{
+	if (c->gap_said && now_ms - c->last_gap_ms < TH_GAP_EVERY_MS) {
+		return;
+	}
+	c->gap_said = 1;
+	c->last_gap_ms = now_ms;
+	TH_LOG("SWEET THERMAL GAP: %s (read rc %d, %u in a row): no thermal action taken on this sample, state %s kept\n", what, rc, (unsigned)c->fail_n,
+	    th_state_name(th_state(c)));
+}
+
+/*
+ * One sample. rd = the read result (TH_RD_*), dC/cur_uA valid only for TH_RD_OK. A failed or implausible read changes NOTHING (GAP only): neither a mitigation nor
+ * its release (user 2026-11-12 "sensor read failure -> GAP and no action").
+ */
+static inline void
+th_tick(struct th_ctl *c, const struct th_ops *ops, int rd, int32_t dC, int32_t cur_uA, uint64_t now_ms)
+{
+	char t[16], lim[16], extra[96], tag[80], rb[16], bb[16];
+	int st;
+	int32_t real = dC;
+
+	if (rd == TH_RD_OK && (dC < TH_SANE_MIN_DC || dC > TH_SANE_MAX_DC)) {
+		c->fail_n++;
+		if (c->ramp_dC && !c->ramp_gap_said) {
+			c->ramp_gap_said = 1;
+			TH_LOG("SWEET THERMAL GAP: sweetthermalramp (test only) refused on this sample: the sensor value is implausible: no bias is added and the ramp does not advance until a good read\n");
+		}
+		th_gap(c, now_ms, "fuel-gauge temperature outside the plausible range -20.0..90.0 C", rd);
+		return;
+	}
+	if (rd != TH_RD_OK) {
+		if (rd == TH_RD_BUSY) {
+			return;                 /* the charger engine was in use by its own tick: not a failure, try again at the next sample */
+		}
+		c->fail_n++;
+		if (c->ramp_dC && !c->ramp_gap_said) {
+			c->ramp_gap_said = 1;
+			TH_LOG("SWEET THERMAL GAP: sweetthermalramp (test only) refused on this sample: the sensor read is failing (rc %d): no bias is added and the ramp does not advance until a good read\n", rd);
+		}
+		th_gap(c, now_ms,
+		    rd == TH_RD_NOTREADY ? "no fuel-gauge temperature yet (charger I2C engine not up)" :
+		    rd == TH_RD_NOENGINE ? "no fuel-gauge temperature source on this boot (charger I2C engine unavailable)" :
+		    rd == TH_RD_DEAD ? "fuel-gauge temperature unavailable: the charger I2C bus was stopped by an earlier transfer error" :
+		    "fuel-gauge temperature read failed", rd);
+		if (c->have_temp && !c->stale_said && now_ms - c->last_ok_ms > TH_STALE_MS) {
+			c->stale_said = 1;
+			th_fmt(t, sizeof(t), c->last_real_dC);
+			TH_LOG("SWEET THERMAL GAP: battery temperature STALE, last good %s C %u s ago (state %s kept; consumers must not trust it)\n", t,
+			    (unsigned)((now_ms - c->last_ok_ms) / 1000u), th_state_name(th_state(c)));
+		}
+		return;
+	}
+	c->fail_n = 0;
+	c->gap_said = 0;
+	c->stale_said = 0;
+	c->ramp_gap_said = 0;
+	c->have_temp = 1;
+	c->last_real_dC = real;
+	c->last_cur_uA = cur_uA;
+	c->last_ok_ms = now_ms;
+	c->samples++;
+	tag[0] = 0;
+	c->bias_dC = 0;
+	if (c->ramp_dC) {
+		/* TEST ONLY: the state machine below sees real + ramp * (good samples since the ramp started); only reached for a GOOD read (a failed one returned above) */
+		if (c->samples >= TH_RAMP_START_N) {
+			int32_t b = (int32_t)c->ramp_dC * (int32_t)(c->samples - (TH_RAMP_START_N - 1u));
+
+			c->bias_dC = b > TH_RAMP_BIAS_CAP_DC ? TH_RAMP_BIAS_CAP_DC : b;
+			dC = real + c->bias_dC;
+			if (c->samples == TH_RAMP_START_N) {
+				th_fmt(rb, sizeof(rb), real);
+				TH_LOG("SWEET THERMAL GAP: sweetthermalramp (test only) starts at good sample %u (real %s C): from now the backstop sees real + %u.%u C per sample, iOS keeps the real value\n",
+				    (unsigned)c->samples, rb, (unsigned)(c->ramp_dC / 10u), (unsigned)(c->ramp_dC % 10u));
+			}
+		}
+		th_fmt(rb, sizeof(rb), real);
+		th_fmt(bb, sizeof(bb), c->bias_dC);
+		snprintf(tag, sizeof(tag), " (real %s C, test bias +%s C)", rb, bb);
+	}
+	c->last_dC = dC;
+	th_fmt(t, sizeof(t), dC);
+
+	if (dC >= TH_CRIT_DC) {
+		if (c->crit_n < 255) {
+			c->crit_n++;
+		}
+	} else {
+		c->crit_n = 0;
+	}
+	if (!c->x1_dropped && dC >= TH_X1_DROP_DC) {
+		c->x1_dropped = 1;
+		th_fmt(lim, sizeof(lim), TH_X1_DROP_DC);
+		TH_LOG("SWEET THERMAL ACTION: batt %s C%s >= %s C: drop the X1 cores (recommended mask 0x%x)\n", t, tag, lim, TH_X1_DROP_MASK);
+		ops->x1(1, dC);
+	} else if (c->x1_dropped && dC <= TH_X1_RESTORE_DC) {
+		c->x1_dropped = 0;
+		th_fmt(lim, sizeof(lim), TH_X1_RESTORE_DC);
+		TH_LOG("SWEET THERMAL ACTION: batt %s C%s <= %s C: restore the recommended cores\n", t, tag, lim);
+		ops->x1(0, dC);
+	}
+	if (dC < TH_CHG_HOLD_DC) {
+		c->nochg_said = 0;
+	}
+	if (!c->chg_held && dC >= TH_CHG_HOLD_DC && cur_uA > 0) {
+		int r;
+
+		c->nochg_said = 0;
+		c->chg_held = 1;
+		th_fmt(lim, sizeof(lim), TH_CHG_HOLD_DC);
+		TH_LOG("SWEET THERMAL ACTION: batt %s C%s >= %s C and charging (%d uA): charge input limit back to the original value (CNFG_09)\n", t, tag, lim, (int)cur_uA);
+		r = ops->chg(1, dC);
+		if (r == 2) {
+			c->chg_held = 0;        /* engine busy / gate closed for now: the condition still holds, ask again at the next sample */
+		} else if (r < 0 && c->chg_retry < TH_CHG_RETRY_MAX) {
+			c->chg_retry++;         /* review 0336 F3: a failed hold leaves CNFG_09 at 875 mA on a hot, charging battery: ask again at the next sample, bounded */
+			c->chg_held = 0;
+		} else if (r >= 0) {
+			c->chg_retry = 0;
+		}
+		extra[0] = 0;
+		if (r < 0) {
+			if (c->chg_held == 0) {
+				snprintf(extra, sizeof(extra), ", asked again at the next sample (retry %u of %u)", (unsigned)c->chg_retry, TH_CHG_RETRY_MAX);
+			} else {
+				snprintf(extra, sizeof(extra), ", %u retries used: not asked again until <= %d.%d C", (unsigned)c->chg_retry, TH_CHG_RELEASE_DC / 10, TH_CHG_RELEASE_DC % 10);
+			}
+		}
+		TH_LOG("SWEET THERMAL ACTION: charge-hold request at %s C%s -> %s%s\n", t, tag, r == 0 ? "done" : r == 2 ? "engine busy, retried at the next sample" : r > 0 ? "nothing to do (CNFG_09 is not raised on this boot)" :
+		    "FAILED (see the GAP above)", extra);
+	} else if (!c->chg_held && dC >= TH_CHG_HOLD_DC) {
+		/* hot but NOT charging (current <= 0): there is no input current to hold. Said once per hot period and again every TH_LOG_EVERY_MS (never a silent skip; the hold is taken at the
+		 * first sample that is hot AND charging) */
+		if (!c->nochg_said || now_ms - c->last_nochg_ms >= TH_LOG_EVERY_MS) {
+			c->nochg_said = 1;
+			c->last_nochg_ms = now_ms;
+			th_fmt(lim, sizeof(lim), TH_CHG_HOLD_DC);
+			TH_LOG("SWEET THERMAL ACTION: batt %s C%s >= %s C but not charging (current %d uA): not charging, nothing to hold\n", t, tag, lim, (int)cur_uA);
+		}
+	} else if (c->chg_held && dC <= TH_CHG_RELEASE_DC) {
+		int r;
+
+		c->chg_held = 0;
+		c->chg_retry = 0;
+		th_fmt(lim, sizeof(lim), TH_CHG_RELEASE_DC);
+		TH_LOG("SWEET THERMAL ACTION: batt %s C%s <= %s C: charge input limit back to 875 mA\n", t, tag, lim);
+		r = ops->chg(0, dC);
+		if (r == 2) {
+			c->chg_held = 1;
+		}
+		TH_LOG("SWEET THERMAL ACTION: charge-release request at %s C%s -> %s\n", t, tag, r == 0 ? "done" : r == 2 ? "engine busy, retried at the next sample" : r > 0 ? "nothing to do" : "FAILED (see the GAP above)");
+	}
+	if (!c->crit_req && c->crit_n >= TH_CRIT_CONFIRM) {
+		c->crit_req = 1;
+		th_fmt(lim, sizeof(lim), TH_CRIT_DC);
+		TH_LOG("SWEET THERMAL CRIT: batt %s C%s >= %s C on %u samples in a row: requesting the orderly reboot to the bootloader so the phone cools in fastboot\n", t, tag, lim,
+		    (unsigned)c->crit_n);
+		if (ops->crit(dC) != 0) {
+			c->crit_req = 0;        /* refused: stay loud, ask again at the next sample */
+		}
+	}
+
+	st = th_state(c);
+	if (st != c->last_state || c->last_log_ms == 0 || c->ramp_dC || now_ms - c->last_log_ms >= TH_LOG_EVERY_MS) {
+		c->last_state = st;
+		c->last_log_ms = now_ms ? now_ms : 1;
+		TH_LOG("SWEET THERMAL: batt %s C%s state %s (%d) current %d uA samples %u\n", t, tag, th_state_name(st), st, (int)cur_uA, (unsigned)c->samples);
+	}
+}
+
+#endif /* SWEET_THERMAL_H */
