+bool
+SweetHIDTemperature::start(IOService *provider)
+{
+	if (!sweet_thermal_enabled()) {
+		IOLog("SWEET THERMAL GAP: sweetthermal=0: no HID temperature service (thermalmonitord gets no temperature)\n");
+		return false;
+	}
+	if (!IOHIDEventService::start(provider)) {
+		return false;
+	}
+	fLastCC = 0;
+	fSent = false;
+	fGapSaid = 0;
+	fTick = IOTimerEventSource::timerEventSource(this, &SweetHIDTemperature::tickFired);
+	if (fTick && _hidWorkLoop->addEventSource(fTick) == kIOReturnSuccess) {
+		fTick->setTimeoutMS(SWEET_HIDTEMP_PERIOD_MS);
+	} else {
+		OSSafeReleaseNULL(fTick);
+		IOLog("SWEET THERMAL GAP: HID temperature timer unavailable: events only on copyEvent(), none pushed\n");
+	}
+	registerService();
+	IOLog("SWEET HID: temperature registered (Product TG0B, ProductID 0x54473042, page 0xff00 usage 5, every %d s)\n", SWEET_HIDTEMP_PERIOD_MS / 1000);
+	return true;
+}
+
+/* true = a fresh good sample (<= 60 s old); otherwise false with a GAP once per kind (none yet / stale). */
+bool
+SweetHIDTemperature::sample(IOFixed *out, int32_t *cc)
+{
+	uint32_t st = 0, age = 0;
+	int32_t v = 0;
+	int said;
+
+	if (!sweet_thermal_get(&v, &st, &age)) {
+		said = 1;
+	} else if (age > SWEET_HIDTEMP_STALE_MS) {
+		said = 2;
+	} else {
+		fGapSaid = 0;
+		*cc = v;
+		*out = (IOFixed)(((int64_t)v * 65536) / 100);
+		return true;
+	}
+	if (said != fGapSaid) {
+		fGapSaid = said;
+		IOLog("SWEET THERMAL GAP: HID temperature event withheld: %s\n", said == 1 ? "no fuel-gauge sample yet" : "the latest fuel-gauge sample is STALE (> 60 s)");
+	}
+	return false;
+}
+
+IOHIDEvent *
+SweetHIDTemperature::copyEvent(IOHIDEventType type, IOHIDEvent *matching __unused, IOOptionBits options __unused)
+{
+	IOFixed f;
+	int32_t cc;
+
+	if (type != kIOHIDEventTypeTemperature || !sample(&f, &cc)) {
+		return NULL;
+	}
+	return IOHIDEvent::temperatureEvent(mach_absolute_time(), f);
+}
+
+void
+SweetHIDTemperature::tickFired(OSObject *owner, IOTimerEventSource *sender)
+{
+	SweetHIDTemperature *self = (SweetHIDTemperature *)owner;
+	IOFixed f;
+	int32_t cc;
+
+	if (self->sample(&f, &cc) && (!self->fSent || cc != self->fLastCC)) {
+		IOHIDEvent *event = IOHIDEvent::temperatureEvent(mach_absolute_time(), f);
+		if (event) {
+			self->fSent = true;
+			self->fLastCC = cc;
+			self->dispatchEvent(event);
+			event->release();
+		}
+	}
+	sender->setTimeoutMS(SWEET_HIDTEMP_PERIOD_MS);
+}
