+		                 * also runs the pending-transfer checks (AUTO_CONF.MASTER_RUN / INT_STATUS) that the P2 path runs at its first group */
+	} else if (chg_i2c_read(0x36, 0x0a, 2, cu) != 0 || chg_i2c_read(0x36, 0x08, 2, tc) != 0) {
+		(void)i2c_wr(I_INTEN, 0);
+		i2c_log("SWEET CHG GAP: THERMAL fuel-gauge read failed: bus stopped, no more battery temperature this boot\n");
+		rc = -1;
+	} else {
+		(void)i2c_wr(I_INTEN, 0);
+		i2c_xfer_seen = 1;
+		*cur_uA = ((int32_t)(int16_t)(cu[0] | ((uint32_t)cu[1] << 8)) * 3125) / 10;
+		*deci_c = ((int32_t)(int16_t)(tc[0] | ((uint32_t)tc[1] << 8)) * 10) / 256;
+	}
+	sweet_chg_leave();
+	return rc;
+}
+
+/*
+ * The charge lever of the thermal backstop. hold=1: put CNFG_09 back to its original value (the restore 0287 performs when the link is lost: same register, same value);
+ * hold=0: write the 875 mA value again. Returns 0 = done and read back, 1 = nothing to do (the 0287 raise is not in place: sweetchgicl=900 not given, refused, or already
+ * restored; or already in the wanted state; or, for the release, the P3 watcher has ended), 2 = engine busy (the caller asks again), -1 = refused or failed (GAP printed). A hold requested before the raise happened is
+ * remembered (p3_therm_hold): p3_step then refuses to raise. The release re-raises only while the SuperSpeed link and CHGTYP SDP/CDP still hold (the 0287 raise preconditions).
+ */
+int
+sweet_chg_icl_thermal(int hold)
+{
+	uint8_t c9 = 0, r9 = 0, want;
+	int rc = 0;
+
+	if (!sweet_chg_enter()) {
+		return 2;
+	}
+	p3_therm_hold = hold;
+	if (p3_mode != (int)ICL_ARG_UP || !p3_orig_valid || p3_nwrites != 1) {
+		i2c_log("SWEET CHG P3: thermal %s: nothing to do (CNFG_09 is not raised by sweetchgicl=900 now: mode %d stage %d writes %d)%s\n", hold ? "hold" : "release", p3_mode, p3_stage, p3_nwrites,
+		    hold && p3_stage < 9 && p3_nwrites == 0 ? "; the raise will be refused while the hold lasts" : "");
+		rc = 1;
+	} else if (i2c_group < 9 || !i2c_loaded || i2c_dead) {
+		i2c_log("SWEET CHG GAP: P3 thermal %s: charger bus not usable (group %d loaded %d dead %d): CNFG_09 left as it is\n", hold ? "hold" : "release", i2c_group, i2c_loaded, i2c_dead);
+		rc = -1;
+	} else if (!i2c_gate(!i2c_xfer_seen)) {
+		i2c_log("SWEET CHG GAP: P3 thermal %s: charger gate closed for now (GAP above): CNFG_09 left as it is, asked again at the next sample\n", hold ? "hold" : "release");
+		rc = 2;         /* patch 0336 F3: transient (the touch driver moves pads of the shared bank), same as the busy engine: the policy asks again */
+	} else if (chg_i2c_read(0x69, 0xc2, 1, &c9) != 0) {
+		i2c_log("SWEET CHG GAP: P3 thermal %s: CNFG_09 read failed (bus stopped): CNFG_09 left as it is\n", hold ? "hold" : "release");
+		rc = -1;
+	} else if (c9 == (hold ? p3_orig : p3_intended)) {
+		i2c_log("SWEET CHG P3: thermal %s: CNFG_09 already 0x%x\n", hold ? "hold" : "release", c9);
+		rc = 1;
+	} else if (c9 != (hold ? p3_intended : p3_orig)) {
+		i2c_log("SWEET CHG GAP: P3 thermal %s: CNFG_09 is 0x%x, not the 0x%x / 0x%x we know: not touched\n", hold ? "hold" : "release", c9, p3_orig, p3_intended);
+		rc = -1;
+	} else if (!hold && p3_twrites >= THERM_MAX_WRITES) {
+		/* patch 0336 F1: the release (raise) bound of this boot is used up. Refused here, BEFORE the write guard, so the bus is not stopped by a plain refusal; CNFG_09 stays at the original */
+		i2c_log("SWEET CHG GAP: P3 thermal release refused: %u thermal writes this boot (bound %u): CNFG_09 stays at the original 0x%x (500 mA), bus kept\n", p3_twrites, THERM_MAX_WRITES, p3_orig);
+		rc = 1;
+	} else if (!hold && (p3_stage >= 9 || sweet_usb_ss_configured() == 0 || p3_chgtyp_ok() != 1)) {
+		i2c_log("SWEET CHG GAP: P3 thermal release: the SuperSpeed link or CHGTYP SDP/CDP is gone, or the P3 watcher has ended (stage %d): CNFG_09 stays at the original 0x%x (500 mA)\n", p3_stage, p3_orig);
+		rc = 1;
+	} else {
+		want = hold ? p3_orig : p3_intended;
+		p3_therm_arm = 1;
+		rc = i2c_cnfg09_write(c9, want);
+		p3_therm_arm = 0;
+		if (rc != 0 && !i2c_dead) {
+			/* patch 0336 F1: the write guard refused and nothing was sent (a transfer failure sets i2c_dead inside i2c_cnfg09_write): the bus stays usable */
+			i2c_log("SWEET CHG GAP: P3 thermal %s: CNFG_09 write 0x%x refused by the write guard, nothing sent, bus kept: CNFG_09 stays 0x%x\n", hold ? "hold" : "release", want, c9);
+			rc = -1;
+		} else if (rc == 0 && chg_i2c_read(0x69, 0xc2, 1, &r9) == 0 && r9 == want) {
+			i2c_xfer_seen = 1;
+			i2c_log("SWEET CHG P3: thermal %s: CNFG_09 before=0x%x (%u mA) wrote=0x%x read back=0x%x (%u mA)\n", hold ? "hold" : "release", c9, chg_icl_ma(c9 & 0x7fu), want, r9,
+			    chg_icl_ma(r9 & 0x7fu));
+		} else {
+			i2c_log("SWEET CHG GAP: P3 thermal %s: CNFG_09 write 0x%x or read-back failed (read back 0x%x): all further transfers stopped\n", hold ? "hold" : "release", want, r9);
+			i2c_dead = 1;
+			rc = -1;
+		}
+		(void)i2c_wr(I_INTEN, 0);
+	}
+	sweet_chg_leave();
+	return rc;
+}
