+
+/*
+ * One fuel-gauge sample for the thermal thread: FG 0x36 reg 0x08 (Temp, signed, 1/256 C, battery thermistor: the read patch 0307 added to mon_row) and reg 0x0a (Current,
+ * 312.5 uA/LSB, positive = charging: the read p3_sample / mon_row already do). Reads only, through chg_i2c_read and the same i2c_gate(0) check as p3_sample. Returns the
+ * TH_RD_* codes of sweet_thermal.h: 0 ok, 1 engine not up yet, 2 engine in use by the other caller, -1 gate/read failed this time, -2 bus stopped by an earlier error,
+ * -3 no engine on this boot. A failed read stops the bus (chg_i2c_read sets i2c_dead) exactly as for mon_row.
+ */
+int
+sweet_chg_fg_sample(int32_t *deci_c, int32_t *cur_uA)
+{
+	uint8_t cu[2], tc[2];
+	int rc = 0;
+
+	if (!sweet_chg_enter()) {
+		return 2;
+	}
+	if (i2c_group < 9) {
+		rc = 1;
+	} else if (!i2c_loaded || !sweet_chg_gate_established()) {
+		rc = -3;        /* patch 0336 F5: phase 1 never opened the gate (sweetchgprobe=0 / closed at boot): NOENGINE, rate-limited by the policy, no gate GAP lines every 10 s */
