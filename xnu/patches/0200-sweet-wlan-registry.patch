diff --git a/iokit/Kernel/arm/SweetWlanRegistry.h b/iokit/Kernel/arm/SweetWlanRegistry.h
new file mode 100644
index 0000000..b6c1d4c
--- /dev/null
+++ b/iokit/Kernel/arm/SweetWlanRegistry.h
@@ -0,0 +1,125 @@
+/* wlan_registry.h - the IORegistry objects wifid and configd look for, as plain tables (P-W4, T-2144; SPEC-WIFI Part F rows W1-W3).
+ *
+ * Pure C, no IOKit: the C++ glue (wlan_registry_glue.cpp.in -> xnu patch 0200) walks these tables and calls setProperty(), so the names and values below
+ * are exactly what the host test (shim/wlan_registry_host_test.c) compares against the cited rows. Nothing here is a hardware constant.
+ *
+ * Sources (obs-RE = read from the iOS 16.7 binaries by the reversers):
+ *   docs/research/110-apple80211-io80211-ios167.md s.4.1 (wifid discovery), s.4.4 (configd), s.7 (MobileGestalt), s.8.1 rows 1-3
+ *   docs/research/W-D7-wifid-startup-reads.md D-1 (interface reads), D-2 (parent), D-3 (complete wifid registry reads), D-8..D-10 (SystemConfiguration), D-16
+ * The objects (what is published):
+ *   controller  class chain IOService > IONetworkController > IO80211Controller > SweetWLANController, attached under the IOService root,
+ *               property IOMACAddress (6 bytes, CFData) read by configd from the interface's PARENT (D-8, D-10).
+ *   interface   class chain IOService > IONetworkInterface > SweetWLANInterface, attached under the controller, published with registerService().
+ * Every property that the reversers saw read but whose value is not decided is listed in wr_gaps[] and printed as a `WIFI GAP:` line at publish time (rule 8).
+ */
+#ifndef WLAN_REGISTRY_H
+#define WLAN_REGISTRY_H
+
+#include <stdint.h>
+#include <stddef.h>
+#include <string.h>
+
+enum wr_kind { WR_STR = 1, WR_NUM = 2, WR_BOOL = 3, WR_ADT_DATA = 4 };
+
+struct wr_prop {
+	const char *key;
+	enum wr_kind kind;
+	const char *str;        /* WR_STR value; WR_ADT_DATA: "<adt path> <property>" the 6 bytes come from at publish time */
+	uint64_t num;           /* WR_NUM / WR_BOOL value */
+	uint32_t bits;          /* WR_NUM width, as setProperty(key, value, bits) */
+	uint32_t len;           /* WR_ADT_DATA: expected length in bytes */
+};
+
+#define WR_MAXCHAIN 6u
+
+struct wr_obj {
+	const char *name;                       /* what the glue calls it in logs */
+	const char *chain[WR_MAXCHAIN];         /* class chain root first, leaf last, NULL padded */
+	const struct wr_prop *props;
+	size_t nprops;
+};
+
+/* The ADT inputs of the same ticket (tools/mkadt.py): launchd's device-tree gate and the MAC source. */
+#define WR_ADT_GATE_NAME  "wlan"            /* IODTFindMatchingEntries(root, kIODTRecursive, "wlan"): the gate launchd evaluates (R110 s.1) */
+#define WR_MAC_SRC        "/chosen mac-address-wifi0"
+#define WR_MAC_LEN        6u
+#define WR_BOOTARG        "sweetwlanreg"    /* =0 skips the whole publish (A/B runs); default publish */
+
+#define WR_IFNAME_PREFIX  "en"
+#define WR_IFNAME_UNIT    0u
+#define WR_IFNAME         "en0"             /* R110 s.4.1: IOInterfaceName="en0" (or prefix "en" + unit 0) */
+#define WR_IFTYPE_ETH     6u                /* D-9: IOInterfaceType == 6 (ethernet family) is the precondition of the IO80211Controller conformance test */
+#define WR_ROLE           "Infrastructure"  /* wifid match dict 0x100238c38 and D-3 compare string 0x1000903a8 */
+
+static const struct wr_prop wr_controller_props[] = {
+	/* D-8/D-10: configd reads IOMACAddress from the parent of the interface and requires CFData; 6 bytes copied from /chosen mac-address-wifi0 by the glue. */
+	{ "IOMACAddress", WR_ADT_DATA, WR_MAC_SRC, 0, 0, WR_MAC_LEN },
+};
+
+static const struct wr_prop wr_interface_props[] = {
+	{ "IOInterfaceName",       WR_STR, WR_IFNAME,        0, 0, 0 },                      /* D-1: first choice of WiFiDeviceCreate */
+	{ "IOInterfaceNamePrefix", WR_STR, WR_IFNAME_PREFIX, 0, 0, 0 },                      /* D-1 fallback pair, also read by configd (D-8, D-10) */
+	{ "IOInterfaceUnit",       WR_NUM, NULL,             WR_IFNAME_UNIT, 32, 0 },        /* D-1: must be a number; same keys read by configd */
+	{ "IOInterfaceType",       WR_NUM, NULL,             WR_IFTYPE_ETH, 8, 0 },          /* D-9: tested == 6 before the IO80211Controller conformance */
+	{ "IO80211InterfaceRole",  WR_STR, WR_ROLE,          0, 0, 0 },                      /* wifid IOPropertyMatch key (R110 s.4.1, D-3) */
+};
+
+/* W-UI (sprint 2026-11-08): the properties that exist only once the en0 ifnet does, set by sweet_wlan_registry_set_bsd_name() after en0_attach (xnu patch 0268 keep hand-over). The glue fills WR_BSD_NAME with the
+ * ifnet's name (if_name). Sources: "BSD Name" = kIOBSDNameKey, iokit/IOKit/IOBSD.h:36 (an OSString) of the XNU tree, read by configd through copyIORegistryProperties / IODictionaryCopyBSDName (D-8, D-10);
+ * IOPrimaryInterface is in the 11 interface keys configd reads (D-8; a Boolean, the value true is [guess]: how configd uses it is not traced); IOBuiltin: D-10 says an IEEE80211 interface is forced builtin and the
+ * property is optional, set true anyway [no harm]; IOLocation: D-10 drops an empty string (0x19064a954-0x19064a97c), so '' is the "no location" answer. All four are interface-side reads (D-8). */
+#define WR_BSD_NAME_KEY "BSD Name"
+#define WR_BSD_NAME     NULL            /* the value is the ifnet's name, supplied at run time */
+static const struct wr_prop wr_live_props[] = {
+	{ WR_BSD_NAME_KEY,       WR_STR,  WR_BSD_NAME, 0, 0, 0 },    /* D-5/D-8/D-10: the key configd needs to list en0 */
+	{ "IOPrimaryInterface",  WR_BOOL, NULL,        1, 0, 0 },    /* D-8 (value is a guess) */
+	{ "IOBuiltin",           WR_BOOL, NULL,        1, 0, 0 },    /* D-8/D-10 */
+	{ "IOLocation",          WR_STR,  "",          0, 0, 0 },    /* D-8/D-10: an empty string is dropped by configd */
+};
+#define WR_NLIVE (sizeof wr_live_props / sizeof wr_live_props[0])
+
+static const struct wr_obj wr_controller = {
+	"controller",
+	{ "IOService", "IONetworkController", "IO80211Controller", "SweetWLANController", NULL, NULL },
+	wr_controller_props, sizeof wr_controller_props / sizeof wr_controller_props[0],
+};
+
+static const struct wr_obj wr_interface = {
+	"interface",
+	{ "IOService", "IONetworkInterface", "SweetWLANInterface", NULL, NULL, NULL },
+	wr_interface_props, sizeof wr_interface_props / sizeof wr_interface_props[0],
+};
+
+/* Reads that the reversers saw and whose value this ticket does not choose; the glue prints each as a WIFI GAP line when it publishes. */
+static const char *const wr_gaps[] = {
+	"WIFI GAP: W3 BSD Name, IOPrimaryInterface, IOBuiltin and IOLocation exist only once the en0 ifnet does: they are set by sweet_wlan_registry_set_bsd_name (patch 0268 keep hand-over, line `SWEET WIFI: registry`); without it configd D-5 will not list en0",
+	"WIFI GAP: W3 IOFeatures and SelfNamed (parent) are read by configd (D-8, D-10) but no value is traced as required; none is published",
+	"WIFI GAP: W3 IO80211ControllerInfo and the IO80211Skywalk interface properties are named in CoreWiFi strings only (D-17 open); none is published",
+	"WIFI GAP: W3 no IOUserClient: IOServiceOpen on the controller/interface fails (W6)",
+};
+#define WR_NGAPS (sizeof wr_gaps / sizeof wr_gaps[0])
+
+static inline const struct wr_prop *wr_find(const struct wr_obj *o, const char *key)
+{
+	size_t i;
+	for (i = 0; i < o->nprops; i++) {
+		if (strcmp(o->props[i].key, key) == 0) {
+			return &o->props[i];
+		}
+	}
+	return NULL;
+}
+
+/* class chain contains `cls` (what IOObjectConformsTo / IOServiceMatching's metaCast evaluate) */
+static inline int wr_conforms(const struct wr_obj *o, const char *cls)
+{
+	unsigned i;
+	for (i = 0; i < WR_MAXCHAIN && o->chain[i] != NULL; i++) {
+		if (strcmp(o->chain[i], cls) == 0) {
+			return 1;
+		}
+	}
+	return 0;
+}
+
+#endif /* WLAN_REGISTRY_H */
diff --git a/iokit/Kernel/arm/SweetWlanRegistry.cpp b/iokit/Kernel/arm/SweetWlanRegistry.cpp
new file mode 100644
index 0000000..e939745
--- /dev/null
+++ b/iokit/Kernel/arm/SweetWlanRegistry.cpp
@@ -0,0 +1,231 @@
+/*
+ * SweetWlanRegistry.cpp - publishes the IO80211 controller and the en0 interface object that wifid and configd look for (xnu patch 0200, T-2144;
+ * SPEC-WIFI Part F rows W1-W3). What is published, and the cited reason for every name, is in iokit/Kernel/arm/SweetWlanRegistry.h (a verbatim copy
+ * of shim/wlan_registry.h, host-tested by shim/wlan_registry_host_test.c); this file only turns those tables into IOKit calls.
+ *
+ * The real classes live in IONetworkingFamily / IO80211Family kexts, which this kernel does not have (precedent: IONetworkStack, patch 0099), so
+ * IONetworkController, IO80211Controller and IONetworkInterface here are empty IOService subclasses that exist only so the class chain answers
+ * IOObjectConformsTo / IOServiceMatching (iokit/Kernel/IOService.cpp:7560-7564 matches IOProviderClass with metaCast). They carry no behaviour: there is
+ * no network driver behind them, and no user client (IOServiceOpen fails, SPEC-WIFI W6).
+ * Gate: published only when the ADT has the `wlan` node launchd's _LimitLoadToDeviceTree evaluates (WR_ADT_GATE_NAME) and boot-arg sweetwlanreg is not 0.
+ * Not compiled against a device here (CI builds the tree), not run on hardware.
+ */
+#include <pexpert/arm64/board_config.h>   /* defines SWEET (as SweetPlatformExpert.cpp) */
+
+#if defined(SWEET)
+#include <IOKit/IOService.h>
+#include <IOKit/IOLib.h>
+#include <IOKit/IODeviceTreeSupport.h>
+#include <libkern/c++/OSData.h>
+#include <libkern/c++/OSCollectionIterator.h>
+#include <libkern/OSAtomic.h>
+#include <pexpert/pexpert.h>
+
+#include "SweetWlanRegistry.h"
+
+class IONetworkController : public IOService {
+	OSDeclareDefaultStructors(IONetworkController);
+};
+OSDefineMetaClassAndStructors(IONetworkController, IOService);
+
+class IO80211Controller : public IONetworkController {
+	OSDeclareDefaultStructors(IO80211Controller);
+};
+OSDefineMetaClassAndStructors(IO80211Controller, IONetworkController);
+
+class SweetWLANController : public IO80211Controller {
+	OSDeclareDefaultStructors(SweetWLANController);
+};
+OSDefineMetaClassAndStructors(SweetWLANController, IO80211Controller);
+
+class IONetworkInterface : public IOService {
+	OSDeclareDefaultStructors(IONetworkInterface);
+};
+OSDefineMetaClassAndStructors(IONetworkInterface, IOService);
+
+class SweetWLANInterface : public IONetworkInterface {
+	OSDeclareDefaultStructors(SweetWLANInterface);
+};
+OSDefineMetaClassAndStructors(SweetWLANInterface, IONetworkInterface);
+
+/* The 6 MAC bytes the table names (WR_MAC_SRC = /chosen mac-address-wifi0); NULL when the ADT lacks them (the caller prints the GAP). */
+static OSData *
+sweet_wlan_reg_mac(void)
+{
+	IORegistryEntry *chosen = IORegistryEntry::fromPath("/chosen", gIODTPlane);
+	OSData *mac = NULL;
+
+	if (chosen != NULL) {
+		OSData *d = OSDynamicCast(OSData, chosen->getProperty("mac-address-wifi0"));
+		if (d != NULL && d->getLength() == WR_MAC_LEN) {
+			mac = d;
+			mac->retain();
+		}
+		chosen->release();
+	}
+	return mac;
+}
+
+/* returns the number of properties set; every property that cannot be set is a WIFI GAP line, never a silent skip. `props`/`nprops`: wr_obj tables at publish time, wr_live_props (W-UI) after the ifnet exists;
+ * `bsd_name` replaces the NULL string of the BSD Name row. */
+static unsigned
+sweet_wlan_reg_props_of(IOService *to, const char *oname, const struct wr_prop *props, size_t nprops, const char *bsd_name)
+{
+	unsigned set = 0;
+
+	for (size_t i = 0; i < nprops; i++) {
+		const struct wr_prop *p = &props[i];
+		bool ok = false;
+
+		switch (p->kind) {
+		case WR_STR:
+			if (p->str == NULL && bsd_name == NULL) {
+				break;
+			}
+			ok = to->setProperty(p->key, p->str != NULL ? p->str : bsd_name);
+			break;
+		case WR_NUM:
+			ok = to->setProperty(p->key, p->num, p->bits);
+			break;
+		case WR_BOOL:
+			ok = to->setProperty(p->key, p->num != 0);
+			break;
+		case WR_ADT_DATA: {
+			OSData *mac = sweet_wlan_reg_mac();
+			if (mac == NULL) {
+				IOLog("WIFI GAP: W2 %s: ADT has no 6-byte %s; %s.%s not published\n", oname, p->str, oname, p->key);
+			} else {
+				ok = to->setProperty(p->key, mac);
+				mac->release();
+			}
+			break;
+		}
+		}
+		if (ok) {
+			set++;
+		} else if (p->kind != WR_ADT_DATA) {
+			IOLog("WIFI GAP: W3 %s.%s setProperty failed\n", oname, p->key);
+		}
+	}
+	return set;
+}
+
+static unsigned
+sweet_wlan_reg_props(IOService *to, const struct wr_obj *o)
+{
+	return sweet_wlan_reg_props_of(to, o->name, o->props, o->nprops, NULL);
+}
+
+/* W-UI (sprint 2026-11-08): the interface object, kept after the publish so the ifnet's name can be put on it when en0 exists (sweet_wlan_registry_set_bsd_name). A tiny spin flag guards the pointer and the pending
+ * name only (no IOKit call under it); the properties are set outside it (setProperty is idempotent, a double set is harmless). The publish runs from SweetPlatformExpert::start, the caller from the keep thread after the
+ * boot join: normally the publish is first, a name that arrives earlier is kept and applied by the publish (printed as pending). */
+static IOService *sweet_wlan_reg_ifc;
+static char sweet_wlan_reg_pending[16];
+static volatile UInt32 sweet_wlan_reg_busy;
+
+static void
+sweet_wlan_reg_enter(void)
+{
+	while (!OSCompareAndSwap(0, 1, &sweet_wlan_reg_busy)) {
+	}
+}
+
+static void
+sweet_wlan_reg_leave(void)
+{
+	(void)OSCompareAndSwap(1, 0, &sweet_wlan_reg_busy);
+}
+
+static void
+sweet_wlan_reg_apply_live(IOService *ifc, const char *name)
+{
+	unsigned n = sweet_wlan_reg_props_of(ifc, "interface", wr_live_props, WR_NLIVE, name);
+
+	IOLog("SWEET WIFI: registry: %s set on the interface object (%u of %u props: %s, IOPrimaryInterface, IOBuiltin, IOLocation)\n", WR_BSD_NAME_KEY, n, (unsigned)WR_NLIVE, name);
+	if (n != WR_NLIVE) {
+		IOLog("WIFI GAP: W3 registry: only %u of %u live properties could be set on the interface object\n", n, (unsigned)WR_NLIVE);
+	}
+}
+
+/* Called once the en0 ifnet exists (patch 0268 keep hand-over). Returns 0 = set, 1 = the interface object is not published yet (the name is kept and set by the publish; a GAP line says so), -1 = refused. */
+extern "C" int
+sweet_wlan_registry_set_bsd_name(const char *name)
+{
+	IOService *ifc;
+
+	if (name == NULL || name[0] == 0 || strlen(name) >= sizeof sweet_wlan_reg_pending) {
+		IOLog("WIFI GAP: W3 registry: BSD Name not set: no valid interface name given\n");
+		return -1;
+	}
+	sweet_wlan_reg_enter();
+	ifc = sweet_wlan_reg_ifc;
+	if (ifc != NULL) {
+		ifc->retain();
+	} else {
+		strlcpy(sweet_wlan_reg_pending, name, sizeof sweet_wlan_reg_pending);
+	}
+	sweet_wlan_reg_leave();
+	if (ifc == NULL) {
+		IOLog("WIFI GAP: W3 registry: BSD Name %s pending: the interface object is not published yet (sweetwlanreg=0, no ADT wlan node, or the publish has not run)\n", name);
+		return 1;
+	}
+	sweet_wlan_reg_apply_live(ifc, name);
+	ifc->release();
+	return 0;
+}
+
+extern "C" void
+sweet_wlan_registry_publish(void)
+{
+	uint32_t on = 1;
+	(void)PE_parse_boot_argn(WR_BOOTARG, &on, sizeof(on));
+	if (on == 0) {
+		IOLog("WIFI GAP: W3 %s=0, IO80211 controller and en0 interface not published\n", WR_BOOTARG);
+		return;
+	}
+
+	IORegistryEntry *root = IORegistryEntry::fromPath("/", gIODTPlane);
+	OSCollectionIterator *it = (root != NULL) ? IODTFindMatchingEntries(root, kIODTRecursive, WR_ADT_GATE_NAME) : NULL;
+	IORegistryEntry *wlan = (it != NULL) ? OSDynamicCast(IORegistryEntry, it->getNextObject()) : NULL;
+	bool gate = (wlan != NULL);
+	OSSafeReleaseNULL(it);
+	OSSafeReleaseNULL(root);
+	if (!gate) {
+		IOLog("WIFI GAP: W1 no ADT node named '%s': IO80211 controller and en0 interface not published\n", WR_ADT_GATE_NAME);
+		return;
+	}
+
+	SweetWLANController *ctl = OSTypeAlloc(SweetWLANController);
+	SweetWLANInterface *ifc = OSTypeAlloc(SweetWLANInterface);
+	bool ok = (ctl != NULL && ifc != NULL && ctl->init() && ifc->init() && ctl->attach(IOService::getServiceRoot()));
+	if (ok) {
+		unsigned nc = sweet_wlan_reg_props(ctl, &wr_controller);
+		ok = ifc->attach(ctl);
+		if (ok) {
+			unsigned ni = sweet_wlan_reg_props(ifc, &wr_interface);
+			char pend[sizeof sweet_wlan_reg_pending];
+
+			ctl->registerService();
+			ifc->registerService();
+			ifc->retain();
+			sweet_wlan_reg_enter();
+			sweet_wlan_reg_ifc = ifc;
+			strlcpy(pend, sweet_wlan_reg_pending, sizeof pend);
+			sweet_wlan_reg_leave();
+			if (pend[0] != 0) {
+				sweet_wlan_reg_apply_live(ifc, pend);
+			}
+			IOLog("SWEET WIFI: published %s (%u props) and %s %s (%u props) role=%s\n", wr_controller.chain[3], nc, wr_interface.chain[2],
+			    WR_IFNAME, ni, WR_ROLE);
+		}
+	}
+	if (!ok) {
+		IOLog("WIFI GAP: W3 IO80211 controller/interface allocation or attach failed: nothing published\n");
+	}
+	for (size_t g = 0; g < WR_NGAPS; g++) {
+		IOLog("%s\n", wr_gaps[g]);
+	}
+	OSSafeReleaseNULL(ifc);
+	OSSafeReleaseNULL(ctl);
+}
+#endif /* SWEET */
