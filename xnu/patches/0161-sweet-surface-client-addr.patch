+	if (d == NULL || addr == 0) {
+		OSSafeReleaseNULL(d);
+		return kIOReturnBadArgument;
+	}
+	sweet_dict_put(d, "IOSurfaceWidth", f[0], 32);
+	sweet_dict_put(d, "IOSurfaceHeight", f[1], 32);
+	sweet_dict_put(d, "IOSurfacePixelFormat", f[2], 32);
+	sweet_dict_put(d, "IOSurfaceBytesPerElement", f[3], 32);
+	sweet_dict_put(d, "IOSurfaceBytesPerRow", f[4], 32);
+	sweet_dict_put(d, "IOSurfaceAllocSize", f[5], 32);
+	sweet_dict_put(d, "IOSurfaceAddress", addr, 64);
+	IOReturn ret = createFromProps(d, args);
+	d->release();
+	return ret;
+}
