+/* Patch 0161 (G-11 icons): QuartzCore's GL renderer wraps its CPU images into IOSurfaces whose pixels live in the CLIENT's memory: IOSurfaceCreate with the key
+ * IOSurfaceAddress (20 of 35 image formats) or selector 6 (WrapClientImage). Our create ignored the address and handed out zeroed memory, so every icon image
+ * reached the GPU empty (g92: 19 backboardd 180x180 surfaces, locks 2 / wunlocks 1 by backboardd, 0 nonzero words, never written by anyone). The surface now
+ * keeps a copy of the client's rows: read with the owner's task (IOMemoryDescriptor::withAddressRange), written through the surface's own descriptor
+ * (writeBytes flushes), at create and again at every lock trap of the same process (QuartzCore refreshes a changed image with Lock(0,0) + Unlock).
+ * Boot-arg sweetsurf_clientaddr=0 disables it. Row by row, so the client's pitch and ours (64-aligned) may differ. */
+#define SWEET_SURFACE_CLIENT_MAX (64u << 20)
+/* Returns true when every row was copied. Runs only in the context of the process that owns `task` (copyin reads the CURRENT map): the callers check
+ * current_task() == fTask (Opus review 0161 finding 1/2: no cross-process read, no page pinning, one row at a time). */
+static bool
+sweet_surface_sync_client(SweetSurface *s, task_t task)
+{
+	if (s->clientAddr == 0 || s->memory == NULL || task == NULL || task != current_task() || s->clientBpr == 0 || s->planeCount != 0) {
+		return false;
+	}
+	uint32_t rows = sweet_div_up(s->height, s->elementHeight);
+	uint32_t rowBytes = sweet_div_up(s->width, s->elementWidth) * s->bytesPerElement;
+	uint64_t srcLen = (uint64_t)s->clientBpr * rows;
+	if (rows == 0 || rowBytes == 0 || rowBytes > s->clientBpr || rowBytes > s->bytesPerRow || srcLen > SWEET_SURFACE_CLIENT_MAX ||
+	    s->clientAddr + srcLen < s->clientAddr ||
+	    (uint64_t)s->offset + (uint64_t)s->bytesPerRow * rows > s->allocSize) {
+		return false;
+	}
+	uint8_t *tmp = (uint8_t *)IOMallocData(rowBytes);
+	if (tmp == NULL) {
+		return false;
+	}
+	bool ok = true;
+	for (uint32_t y = 0; y < rows; y++) {
+		if (copyin((user_addr_t)(s->clientAddr + (uint64_t)y * s->clientBpr), tmp, rowBytes) != 0) {
+			ok = false;
+			break;
+		}
+		s->memory->writeBytes((uint64_t)s->offset + (uint64_t)y * s->bytesPerRow, tmp, rowBytes);
+	}
+	IOFreeData(tmp, rowBytes);
+	return ok;
+}
