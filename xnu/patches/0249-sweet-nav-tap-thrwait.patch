diff --git a/osfmk/kern/exception.c b/osfmk/kern/exception.c
index c3ede9c..9ce335c 100644
--- a/osfmk/kern/exception.c
+++ b/osfmk/kern/exception.c
@@ -1169,6 +1169,84 @@ sweet_thrsample_task(task_t task, uint64_t tid, struct sweet_thrsmp *o)
 	return rc;
 }
 
+/*
+ * SWEET thread wait witness (patch 0249, bsd/dev/sweet_thrwait.c, boot-arg sweetthrwait=N): one sample of every thread of `task` into `out`, 6 words per thread
+ * {tid, kind, hint, wait_event, pc, lr} for the first `max` threads in task->threads queue order; *total = number of threads in the queue. kind 0 = not in
+ * TH_WAIT (hint/event/pc/lr 0), 1 = TH_WAIT with a 64-bit user state (pc, lr from it), 2 = TH_WAIT without one (pc = lr = 0). Locking as in sweet_thrcpu_task above
+ * (task_lock around the queue walk: fill_taskthreadinfo, osfmk/kern/bsd_kern.c:1073-1112) and per thread splsched + thread_lock around the field reads, the
+ * discipline of thread_info_internal (osfmk/kern/thread.c:2057-2062, retrieve_thread_basic_info thread.c:1966). TH_WAIT, block_hint and wait_event are written
+ * together under the thread lock when a thread starts waiting (thread_mark_wait_locked osfmk/kern/sched_prim.c:1119-1129, waitq_thread_insert osfmk/kern/waitq.c:569,
+ * called with the thread locked from waitq.c:1383-1386), so a TH_WAIT read under the lock sees a matching hint and event. When the waitq wakes the thread
+ * (thread_clear_waitq_state, waitq.c:584-593) the event is reset to NO_EVENT64 (= 0, kern_types.h:80) and the hint to 0 while TH_WAIT stays set until the thread
+ * runs: such a row reads hint 0 ev 0x0. The hint is also reset when the thread is dispatched (sched_prim.c:925). TH_WAIT is set from assert_wait on, before the
+ * thread has switched out. Only values stored in the thread structure and in its saved user state (thread->machine.upcb, find_user_regs, osfmk/arm64/status.c:1688)
+ * are read: nothing the event, a port, a waitq or user memory points to is dereferenced or copied in (no copyin, no vm_map_read_user). The saved state is the one
+ * of the last kernel entry [guess: it is not rewritten while the thread waits; sweet_sample_task reads it the same way, under task_lock only]. No printf here.
+ * Returns 0.
+ */
+int sweet_thrwait_task(task_t task, uint64_t *out, int max, int *total);
+
+int
+sweet_thrwait_task(task_t task, uint64_t *out, int max, int *total)
+{
+	thread_t thread;
+	int idx = 0;
+
+	task_lock(task);
+	queue_iterate(&task->threads, thread, thread_t, task_threads) {
+		if (idx < max) {
+			uint64_t *o = &out[idx * 6];
+			uint64_t tid = thread_tid(thread);
+			spl_t s = splsched();
+
+			thread_lock(thread);
+			if (thread->state & TH_WAIT) {
+				arm_saved_state_t *ss = find_user_regs(thread);
+
+				o[1] = 2;
+				o[2] = (uint64_t)thread->block_hint;
+				o[3] = (uint64_t)thread->wait_event;
+				o[4] = 0;
+				o[5] = 0;
+				if (ss != NULL && is_saved_state64(ss)) {
+					o[1] = 1;
+					o[4] = get_saved_state_pc(ss);
+					o[5] = get_saved_state_lr(ss);
+				}
+			} else {
+				o[1] = o[2] = o[3] = o[4] = o[5] = 0;
+			}
+			thread_unlock(thread);
+			splx(s);
+			o[0] = tid;
+		}
+		idx++;
+	}
+	*total = idx;
+	task_unlock(task);
+	return 0;
+}
+
+/*
+ * Shared-cache slide of `task` for the wait witness rows (patch 0249): vm_shared_region_get takes task_lock and the shared region lock itself and returns a
+ * referenced region (osfmk/vm/vm_shared_region.c:233-259), called from the sampler thread exactly as sweet_sample_task and sweet_thrsample_task above do,
+ * with the caller holding a proc reference. sr_slide: osfmk/vm/vm_shared_region.h:223. Returns 0 and *slide, or -1 when the task has no shared region.
+ */
+int sweet_thrwait_slide(task_t task, uint64_t *slide);
+
+int
+sweet_thrwait_slide(task_t task, uint64_t *slide)
+{
+	vm_shared_region_t sr = vm_shared_region_get(task);
+
+	if (sr == NULL) {
+		return -1;
+	}
+	*slide = sr->sr_slide;
+	vm_shared_region_deallocate(sr);
+	return 0;
+}
+
