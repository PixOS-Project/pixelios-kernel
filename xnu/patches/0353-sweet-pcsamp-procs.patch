+#define PCS_NM      (MAXCOMLEN + 1)
+#define PCS_ARGLEN  128
+
+/* SWEET_PCSAMP_PARSE_BEGIN (host test tools/test_pcsamp_procs_core.py compiles this block with a C compiler; no kernel header is used inside it) */
+#define PCS_G_EMPTY 1u   /* an empty entry (",," or a leading / trailing comma) */
+#define PCS_G_LONG  2u   /* an entry longer than MAXCOMLEN (it can never equal a p_comm) */
+#define PCS_G_MANY  4u   /* more than 3 entries */
+/*
+ * Split a comma list into up to `np` names of at most `nm - 1` characters each. Empty and too-long entries are skipped and reported in *gaps; entries
+ * after the np-th valid one are dropped (more than np entries sets PCS_G_MANY). Unused out[] slots are "" (they match nothing). Returns the number of names taken.
+ */
+static int
+sweet_pcsamp_parse_procs(const char *s, char out[][PCS_NM], int np, unsigned *gaps)
+{
+	int taken = 0, entries = 0;
+
+	*gaps = 0;
+	for (int i = 0; i < np; i++) {
+		out[i][0] = '\0';
+	}
+	for (;;) {
+		size_t len = 0;
+
+		while (s[len] != ',' && s[len] != '\0') {
+			len++;
+		}
+		entries++;
+		if (len == 0) {
+			*gaps |= PCS_G_EMPTY;
+		} else if (len > PCS_NM - 1) {
+			*gaps |= PCS_G_LONG;
+		} else if (taken < np) {
+			for (size_t i = 0; i < len; i++) {
+				out[taken][i] = s[i];
+			}
+			out[taken][len] = '\0';
+			taken++;
+		}
+		if (s[len] == '\0') {
+			break;
+		}
+		s += len + 1;
+	}
+	if (entries > np) {
+		*gaps |= PCS_G_MANY;
+	}
+	return taken;
+}
+/* SWEET_PCSAMP_PARSE_END */
