+static char pcs_names[PCS_NP][PCS_NM] = { "backboardd", "SpringBoard", "Preferences" };
+static const char *pcs_short[PCS_NP] = { "bb", "sb", "pf" };   /* p0 p1 p2 with boot-arg sweetpcsampproc (patch 0353) */
 
