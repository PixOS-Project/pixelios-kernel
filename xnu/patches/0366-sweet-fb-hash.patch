+/*
+ * Patch 0366 (lowclk, research 164 B2 e1, LOG ONLY, boot-arg sweetfbhash=1, default off = byte-identical): did the panel PIXELS change at this present?
+ * Hash of the SOURCE surfaces of the present (what the panel copy reads), compared with the previous present's hash; the result is counted per second split by
+ * the GPU job count of the swap (the seqno delta SWEET SWAPT shows, patch 0186: jobs = gpu_seq of this swap - gpu_seq of the previous swap). The hash is a sampled
+ * grid: every SFH_N-th row, and on it every SFH_M-th 32-bit word (start column shifted by 1 word per sampled row so the grid is not one column set).
+ * Cost calc [arithmetic; measured per present at runtime, row field cost_p50/max]: 1080x2400x4 B surface: 2400/32 = 75 rows x ceil(1080/32) = 34 words = 2550 loads,
+ * each on its own 128 B stride = its own 64 B cache line; independent loads (the hash chain does not serialise the addresses), ~100 ns DRAM latency / ~8 in flight =
+ * ~13 ns -> ~33 us, plus 2550 xor+multiply (~3 cycles each, ~3 us) = ~36 us (budget <= ~50 us). A change confined to fewer than 32 rows, or to the columns between
+ * two samples, can be missed: "unchanged" here means "no sampled word changed", an upper bound on the unchanged presents.
+ */
+/* SFH-PURE-BEGIN */
+#define SFH_N           32u
+#define SFH_M           32u
+#define SFH_COST_MAX    256u
+#define SFH_FNV_OFF     14695981039346656037ull
+#define SFH_FNV_PRIME   1099511628211ull
+enum { SFH_B_J0 = 0, SFH_B_J12, SFH_B_J34, SFH_B_J5P, SFH_B_UNK, SFH_B_N };
+struct sfh_state {
+	bool      have_prev;            /* a previous present has a hash to compare with */
+	uint64_t  prev;
+	uint32_t  pres[SFH_B_N];        /* presents compared this second, per bucket */
+	uint32_t  chg[SFH_B_N];         /* of them changed */
+	uint32_t  nohash;               /* presents with no hash (source not mappable) this second */
+	uint32_t  cost_n;               /* cost samples stored (us), at most SFH_COST_MAX */
+	uint32_t  cost[SFH_COST_MAX];
+	uint32_t  cost_max;             /* max cost this second, also past SFH_COST_MAX */
+	uint32_t  first_logged;         /* "first changed" rows printed since boot */
+};
+
+static inline uint64_t
+sfh_mix(uint64_t h, uint64_t v)
+{
+	return (h ^ v) * SFH_FNV_PRIME;
+}
+
+/* hash of one layer's source: base = first byte of the surface content, pitch bytes per row, w x hgt 32-bit words; touch (may be NULL) is called with each sampled address first */
+static uint64_t
+sfh_grid(uint64_t h, const uint8_t *base, uint32_t pitch, uint32_t w, uint32_t hgt, void (*touch)(const uint8_t *))
+{
+	for (uint32_t r = 0; r < hgt; r += SFH_N) {
+		const uint8_t *row = base + (uint64_t)r * pitch;
+		for (uint32_t c = (r / SFH_N) % SFH_M; c < w; c += SFH_M) {
+			uint32_t px;
+			if (touch != NULL) {
+				touch(row + (uint64_t)c * 4);
+			}
+			memcpy(&px, row + (uint64_t)c * 4, 4);
+			h = sfh_mix(h, px);
+		}
+	}
+	return h;
+}
+
+/* bucket of a swap's GPU job count; known = false (no seqno, first swap): unknown */
+static int
+sfh_bucket(bool known, uint32_t jobs)
+{
+	if (!known) {
+		return SFH_B_UNK;
+	}
+	return jobs == 0 ? SFH_B_J0 : jobs <= 2 ? SFH_B_J12 : jobs <= 4 ? SFH_B_J34 : SFH_B_J5P;
+}
+
+/* one present with a hash: returns 1 = changed, 0 = unchanged, -1 = first (nothing to compare with, not counted) */
+static int
+sfh_account(struct sfh_state *s, uint64_t hash, int bucket)
+{
+	int r = -1;
+	if (s->have_prev) {
+		r = hash != s->prev;
+		s->pres[bucket]++;
+		s->chg[bucket] += (uint32_t)r;
+	}
+	s->have_prev = true;
+	s->prev = hash;
+	return r;
+}
+
+/* a present with no hash: counted, and the next present has nothing to compare with */
+static void
+sfh_nohash(struct sfh_state *s)
+{
+	s->nohash++;
+	s->have_prev = false;
+}
+
+static void
+sfh_cost_add(struct sfh_state *s, uint32_t us)
+{
+	if (s->cost_n < SFH_COST_MAX) {
+		s->cost[s->cost_n++] = us;
+	}
+	if (us > s->cost_max) {
+		s->cost_max = us;
+	}
+}
+
+/* p50 of the stored cost samples (rank ceil(n/2), 1-based), 0 when none */
+static uint32_t
+sfh_cost_p50(const struct sfh_state *s)
+{
+	uint32_t tmp[SFH_COST_MAX];
+	uint32_t n = s->cost_n;
+	if (n == 0) {
+		return 0;
+	}
+	for (uint32_t i = 0; i < n; i++) {
+		uint32_t v = s->cost[i], j = i;
+		while (j > 0 && tmp[j - 1] > v) {
+			tmp[j] = tmp[j - 1];
+			j--;
+		}
+		tmp[j] = v;
+	}
+	return tmp[(n + 1) / 2 - 1];
+}
+
+/* per-second reset: counters and cost samples; the previous hash and the first-changed count stay */
+static void
+sfh_reset(struct sfh_state *s)
+{
+	memset(s->pres, 0, sizeof(s->pres));
+	memset(s->chg, 0, sizeof(s->chg));
+	s->nohash = 0;
+	s->cost_n = 0;
+	s->cost_max = 0;
+}
+/* SFH-PURE-END */
