+/*
+ * Patch 0269 (sprint-gpu 2026-11-08, user OK; nav-session calibration, input choice only, read-only): the General row of the Settings root list is not at a fixed
+ * height. The list comes back from settings-scroll-down at a varying scroll offset (search bar shown or not, overscroll): camera frames nav27 r1 (+~50 touch px) and
+ * nav31 r1/r2 (+~150 px) put the calibrated tap 500,1900 into the section gap or onto Screen Time [obs]. The nav session asks this probe for the General row just before
+ * the tap: in the last presented layer-0 surface (logical 1125x2436, panel = logical - (fOffX, fOffY), copied 1:1 by present()), scan the icon column (touch x 40..215, every 4 px; >= 5 samples per class)
+ * from top to bottom, classify each row by its samples as grey (|R-G|,|G-B| < 14, 90 <= R <= 205: the General / Control Center icon) or purple (B > R+50, B > G+50: Focus /
+ * Screen Time), and return the centre of the first grey run of >= 30 rows that starts below a purple row, in touch y. 0 = not found (the caller keeps 1900 and logs a GAP).
+ */
+extern "C" uint32_t sweet_fb_last_surface;
+uint32_t sweet_fb_last_surface;
+extern "C" int sweet_fb_probe_general(int *out_y, int *runs, int *purple_last);
+int
+sweet_fb_probe_general(int *out_y, int *runs, int *purple_last)
+{
+	*out_y = 0;
+	*runs = 0;
+	*purple_last = -1;
+	uint32_t id = sweet_fb_last_surface;
+	SweetSurface *s = id ? sweet_surface_copy(id) : NULL;
+	if (s == NULL || s->kernelAddress() == 0 || s->memory == NULL || s->elementWidth != 1 || s->elementHeight != 1 ||
+	    s->width < 1125 || s->height < 2436 || (uint64_t)s->offset + (uint64_t)s->height * s->bytesPerRow > s->memory->getLength()) {
+		OSSafeReleaseNULL(s);
+		return -1;
+	}
+	const int offx = ((int)s->width - 1080) / 2, offy = ((int)s->height - 2400) / 2;
+	int run0 = -1;
+	bool seen_purple = false;
+	for (int ty = 200; ty < 2380; ty++) {
+		const uint8_t *row = (const uint8_t *)(s->kernelAddress() + s->offset + (uint64_t)(ty + offy) * s->bytesPerRow);
+		int grey = 0, purple = 0;
+		for (int tx = 40; tx <= 215; tx += 4) {
+			uint32_t px;
+			memcpy(&px, row + (uint64_t)(tx + offx) * 4, 4);
+			int r = (px >> 16) & 0xff, g = (px >> 8) & 0xff, b = px & 0xff;
+			int dr = r - g, dg = g - b;
+			if (dr < 0) {
+				dr = -dr;
+			}
+			if (dg < 0) {
+				dg = -dg;
+			}
+			if (dr < 14 && dg < 14 && r >= 90 && r <= 205) {
+				grey++;
+			} else if (b > r + 50 && b > g + 50) {
+				purple++;
+			}
+		}
+		if (purple >= 5) {
+			seen_purple = true;
+			*purple_last = ty;
+		}
+		bool isgrey = grey >= 5;
+		if (isgrey && run0 < 0) {
+			run0 = ty;
+		} else if (!isgrey && run0 >= 0) {
+			(*runs)++;
+			if (seen_purple && *purple_last < run0 && ty - run0 >= 30) {
+				*out_y = (run0 + ty - 1) / 2;
+				break;
+			}
+			run0 = -1;
+		}
+	}
+	OSSafeReleaseNULL(s);
+	return *out_y > 0 ? 0 : -2;
+}
