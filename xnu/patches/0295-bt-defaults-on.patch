+/*
+ * patch 0295 (bt/defaults 2026-11-11): the four boot-args every proven Bluetooth boot passed (sweetbt, sweetbtkeepbaud, sweetbtpatchram, sweetbtlefeat; bt-va2 and the
+ * A2DP/pairing runs) are ON by default. Absent = on; 0 = off (one `BT GAP:` line naming the knob, sbu_defaults_log); 1 = on; any other value = on plus a BT GAP (never a
+ * silent switch). Every other BT knob (sweetbtrfwit, sweetbtromread, sweetbtvsc, sweetbtnopcf, ...) keeps its own default: off.
+ */
+static int
+sbu_knob_default_on(const char *name)
+{
+	int v = 0;
+
+	if (!PE_parse_boot_argn(name, &v, sizeof(v))) {
+		return 1;
+	}
+	return v != 0;
+}
+
+static void
+sbu_defaults_log(void)
+{
+	static const struct { const char *name, *off; } k[] = {
+		{ "sweetbt", "the controller is not powered, kctl and /dev/bt* fail every transfer" },
+		{ "sweetbtkeepbaud", "TIOCSETA moves the host UART to bluetoothd's requested baud although nobody ran the controller's baud-change VSC" },
+		{ "sweetbtpatchram", "no patchram download, bluetoothd meets the unpatched ROM" },
+		{ "sweetbtlefeat", "no LE feature bit 13 clearing, bluetoothd's 0x204a can make the controller refuse every legacy LE command" },
+	};
+
+	for (size_t i = 0; i < sizeof(k) / sizeof(k[0]); i++) {
+		int v = 0;
+
+		if (!PE_parse_boot_argn(k[i].name, &v, sizeof(v))) {
+			continue;
+		}
+		if (v == 0) {
+			printf("BT GAP: %s=0: default-on knob switched off by boot-arg: %s\n", k[i].name, k[i].off);
+		} else if (v != 1) {
+			printf("BT GAP: %s=%d is not 0 or 1: treated as on (the default)\n", k[i].name, v);
+		}
+	}
+}
+
