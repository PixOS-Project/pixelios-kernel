+/* Patch 0162 (AP-102, silent-success stubs; loud format 'SWEET GAP: <area> <what> xCOUNT (process)'): every IOSurface create key we do not read, and every selector we accept-and-ignore (default branch) or answer
+ * Unsupported, is logged ONCE per boot with its name, then again when its count reaches 10 / 100 / 1000 / 10000, so the next missing feature shows in the log
+ * (IOSurfaceAddress was ignored for two days and every call "succeeded"). Entries: "key <name>" or "sel <n> (<why>)". */
+#define SWEET_IGN_MAX 48
+static struct { char name[64]; uint32_t n; } sweet_ign[SWEET_IGN_MAX + 1];   /* [SWEET_IGN_MAX] collects the overflow */
+static uint32_t sweet_ign_count;
+
+static void
+sweet_note_ignored(const char *kind, const char *what, uint32_t sel)
+{
+	char name[64];
+	if (sel != 0xffffffffu) {
+		snprintf(name, sizeof(name), "%s %u (%s)", kind, sel, what);
+	} else {
+		snprintf(name, sizeof(name), "%s %s", kind, what);
+	}
+	uint32_t i, n = 0;
+	sweet_surface_init_lock();   /* review 0162: the lock may not exist yet */
+	IOLockLock(sweet_surface_lock);
+	for (i = 0; i < sweet_ign_count; i++) {
+		if (strncmp(sweet_ign[i].name, name, sizeof(name)) == 0) {
+			break;
+		}
+	}
+	if (i == sweet_ign_count) {
+		if (sweet_ign_count < SWEET_IGN_MAX) {
+			strlcpy(sweet_ign[i].name, name, sizeof(sweet_ign[i].name));
+			sweet_ign[i].n = 0;
+			sweet_ign_count++;
+		} else {
+			i = SWEET_IGN_MAX;   /* table full */
+			strlcpy(sweet_ign[i].name, "(table full)", sizeof(sweet_ign[i].name));
+		}
+	}
+	n = ++sweet_ign[i].n;
+	IOLockUnlock(sweet_surface_lock);
+	if (n == 1 || n == 10 || n == 100 || n == 1000 || n == 10000) {
+		char proc[32];
+		proc_selfname(proc, sizeof(proc));
+		IOLog("SWEET GAP: surface %s x%u (%s)\n", name, n, proc);
+	}
+}
+
+static bool
+sweet_known_create_key(const char *k)
+{
+	static const char *const known[] = { "IOSurfaceWidth", "IOSurfaceHeight", "IOSurfaceBytesPerElement", "IOSurfaceElementWidth", "IOSurfaceElementHeight",
+		"IOSurfacePixelFormat", "IOSurfaceCacheMode", "IOSurfaceOffset", "IOSurfaceBytesPerRow", "IOSurfaceAllocSize", "IOSurfacePlaneInfo", "IOSurfaceAddress" };
+	for (unsigned i = 0; i < sizeof(known) / sizeof(known[0]); i++) {
+		if (strcmp(k, known[i]) == 0) {
+			return true;
+		}
+	}
+	return false;
+}
