SWEET per-thread CPU time (patch 0187, R0 log only, no register writes; PLAN-60FPS P-G1 slice 2, spec G-S4, research 116): under boot-arg sweetthrcpu=1 (default off) a kernel thread (bsd/dev/sweet_thrcpu.c, started from sweet_ufs next to sweet_sample_start) prints once per second, for backboardd and SpringBoard and for each thread, `SWEET THRCPU: pid %d n %d tid 0x%llx idx %d user_us %llu sys_us %llu st 0x%x` (cumulative THREAD_BASIC_INFO times, st = flags<<8 | run_state, idx = position in the task thread queue). The queue is walked under task_lock in sweet_thrcpu_task (osfmk/kern/exception.c, same pattern as fill_taskthreadinfo, bsd_kern.c:1073); printf only after all locks are dropped. Loud once: `<name> not found`, `unavailable (...)`, truncation above 128 threads; cap 50000 lines then `cap reached 50000`.
--- a/osfmk/kern/exception.c
+++ b/osfmk/kern/exception.c
@@ -1056,6 +1056,43 @@
 	task_unlock(task);
 }
 
+/*
+ * SWEET per-thread CPU time (patch 0187, bsd/dev/sweet_thrcpu.c, boot-arg sweetthrcpu=1): snapshot of every thread of a task into `out`, 4 words per
+ * thread {tid, user_us, sys_us, st} for the first `max` threads in task->threads queue order; *total = number of threads in the queue. Same locking as
+ * fill_taskthreadinfo (osfmk/kern/bsd_kern.c:1073-1112): task_lock held while walking the queue (threads leave it under the task lock) and calling
+ * thread_info_internal(THREAD_BASIC_INFO) (osfmk/kern/thread.c:2040; splsched + thread_lock inside, retrieve_thread_basic_info thread.c:1964). No printf
+ * and no other lock here: the caller prints from the snapshot. Returns KERN_SUCCESS or the first thread_info_internal error (the walk stops there).
+ */
+int sweet_thrcpu_task(task_t task, uint64_t *out, int max, int *total);
+
+int
+sweet_thrcpu_task(task_t task, uint64_t *out, int max, int *total)
+{
+	thread_t thread;
+	int idx = 0;
+	int kr = KERN_SUCCESS;
+
+	task_lock(task);
+	queue_iterate(&task->threads, thread, thread_t, task_threads) {
+		if (idx < max) {
+			thread_basic_info_data_t bi;
+			mach_msg_type_number_t cnt = THREAD_BASIC_INFO_COUNT;
+			kr = thread_info_internal(thread, THREAD_BASIC_INFO, (thread_info_t)&bi, &cnt);
+			if (kr != KERN_SUCCESS) {
+				break;
+			}
+			out[idx * 4 + 0] = thread_tid(thread);
+			out[idx * 4 + 1] = (uint64_t)bi.user_time.seconds * 1000000ULL + (uint64_t)bi.user_time.microseconds;
+			out[idx * 4 + 2] = (uint64_t)bi.system_time.seconds * 1000000ULL + (uint64_t)bi.system_time.microseconds;
+			out[idx * 4 + 3] = ((uint64_t)(uint32_t)bi.flags << 8) | (uint32_t)(bi.run_state & 0xff);
+		}
+		idx++;
+	}
+	*total = idx;
+	task_unlock(task);
+	return kr;
+}
+
 #endif /* ARM64_BOARD_CONFIG_SWEET */
 
