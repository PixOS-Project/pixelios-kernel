+++ b/bsd/dev/sweet_thrcpu.c
@@ -0,0 +1,129 @@
+/*
+ * SWEET per-thread CPU time (patch 0187, boot-arg sweetthrcpu=1, default off; PLAN-60FPS P-G1 slice 2, spec G-S4). R0: log only, no register writes.
+ *
+ * Once per second, for backboardd and SpringBoard, one line per thread:
+ *   SWEET THRCPU: pid %d n %d tid 0x%llx idx %d user_us %llu sys_us %llu st 0x%x
+ * n = threads in the task, idx = position in the task's thread queue, user_us/sys_us = cumulative (THREAD_BASIC_INFO), st = flags << 8 | run_state.
+ *
+ * Context: its own kernel thread (like bsd/dev/sweet_sample.c), NOT the Mali sm_thread tick: that thread polls job completion every 200 us and must
+ * not stall behind up to ~100 printf lines per second; this one also works without the Mali driver.
+ * Locking: proc_iterate(PROC_ALLPROCLIST | PROC_NOWAITTRANS) as in patch 0186 (bsd/kern/kern_proc.c:3583; proc ref held per callout, no lock held
+ * otherwise); the task's thread queue is walked under task_lock in sweet_thrcpu_task (osfmk/kern/exception.c). The snapshot goes into static buffers
+ * (single thread, no sharing) and every printf happens after both locks are dropped.
+ */
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/proc.h>
+#include <sys/proc_internal.h>
+#include <kern/task.h>
+#include <kern/thread.h>
+#include <mach/kern_return.h>
+#include <pexpert/pexpert.h>
+
+extern task_t proc_task(proc_t);
+extern char *proc_name_address(void *p);      /* bsd/kern/kern_proc.c:1390 */
+extern int hz;
+extern int sweet_thrcpu_task(task_t task, uint64_t *out, int max, int *total);   /* osfmk/kern/exception.c */
+extern void sweet_thrcpu_start(void);
+
+#define THR_MAX_T   128        /* threads kept per process per second; more are counted in n and reported once */
+#define THR_CAP     50000      /* lines per boot */
+
+struct thr_proc {
+	int pid;                   /* -1 = not found */
+	int n;                     /* threads in the queue */
+	int kept;                  /* min(n, THR_MAX_T) */
+	int kr;                    /* 0 ok, -1 no task, else thread_info error */
+	uint64_t ent[THR_MAX_T * 4];
+};
+
+static struct thr_proc thr_p[2];      /* [0] backboardd, [1] SpringBoard */
+
+static int
+thr_callout(proc_t p, __unused void *arg)
+{
+	const char *nm = proc_name_address(p);
+	int which = (strncmp(nm, "backboardd", MAXCOMLEN) == 0) ? 0 : ((strncmp(nm, "SpringBoard", MAXCOMLEN) == 0) ? 1 : -1);
+	if (which >= 0) {
+		struct thr_proc *t = &thr_p[which];
+		task_t task = proc_task(p);
+		t->pid = proc_pid(p);
+		t->n = 0;
+		t->kept = 0;
+		t->kr = -1;
+		if (task != TASK_NULL) {
+			t->kr = sweet_thrcpu_task(task, t->ent, THR_MAX_T, &t->n);
+			t->kept = (t->n < THR_MAX_T) ? t->n : THR_MAX_T;
+		}
+	}
+	return PROC_RETURNED;
+}
+
+static void
+sweet_thrcpu_thread(__unused void *arg, __unused wait_result_t wr)
+{
+	static int chan;
+	static const char *const names[2] = { "backboardd", "SpringBoard" };
+	int nf_said[2] = { 0, 0 }, trunc_said[2] = { 0, 0 }, unavail_said = 0;
+	unsigned lines = 0;
+
+	for (;;) {
+		(void)tsleep(&chan, PZERO, "sweetthr", hz);
+		if (lines >= THR_CAP) {
+			continue;       /* capped: idle (a kernel thread function must not return) */
+		}
+		thr_p[0].pid = thr_p[1].pid = -1;
+		proc_iterate(PROC_ALLPROCLIST | PROC_NOWAITTRANS, thr_callout, NULL, NULL, NULL);
+		/* no lock held from here on */
+		for (int w = 0; w < 2; w++) {
+			struct thr_proc *t = &thr_p[w];
+			if (t->pid < 0) {
+				if (!nf_said[w]) {
+					nf_said[w] = 1;
+					printf("SWEET THRCPU: %s not found\n", names[w]);
+				}
+				continue;
+			}
+			if (t->kr != 0) {
+				if (!unavail_said) {
+					unavail_said = 1;
+					if (t->kr == -1) {
+						printf("SWEET THRCPU: unavailable (%s pid %d has no task)\n", names[w], t->pid);
+					} else {
+						printf("SWEET THRCPU: unavailable (thread_info error %d, %s pid %d)\n", t->kr, names[w], t->pid);
+					}
+				}
+				continue;
+			}
+			if (t->n > t->kept && !trunc_said[w]) {
+				trunc_said[w] = 1;
+				printf("SWEET THRCPU: %s pid %d has %d threads, only the first %d are printed\n", names[w], t->pid, t->n, THR_MAX_T);
+			}
+			for (int i = 0; i < t->kept; i++) {
+				if (lines >= THR_CAP) {
+					break;
+				}
+				printf("SWEET THRCPU: pid %d n %d tid 0x%llx idx %d user_us %llu sys_us %llu st 0x%x\n", t->pid, t->n,
+				    t->ent[i * 4 + 0], i, t->ent[i * 4 + 1], t->ent[i * 4 + 2], (unsigned)t->ent[i * 4 + 3]);
+				if (++lines == THR_CAP) {
+					printf("SWEET THRCPU: cap reached %d\n", THR_CAP);
+				}
+			}
+		}
+	}
+}
+
+void
+sweet_thrcpu_start(void)
+{
+	int v = 0;
+	thread_t thread;
+	if (!PE_parse_boot_argn("sweetthrcpu", &v, sizeof(v)) || v == 0) {
+		return;
+	}
+	if (kernel_thread_start(sweet_thrcpu_thread, NULL, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	} else {
+		printf("SWEET THRCPU: unavailable (kernel_thread_start failed)\n");
+	}
+}
