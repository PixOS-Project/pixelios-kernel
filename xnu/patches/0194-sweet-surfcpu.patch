+			}
+			if (p != PROC_NULL) {
+				proc_rele(p);
+			}
+		}
+		if (cur_target != shown_target) {
+			if (sc_on || sm_on) {
+				printf("SWEET SURFCPU: target tid 0x%llx -> 0x%llx (tid counters restart)\n", shown_target, cur_target);
+			}
+			shown_target = cur_target;
+			os_atomic_store(&sc_target, cur_target, relaxed);
+			sc_rebase_target();
+		}
+		if (sc_on) {
+			sc_print_scope(0, 0);
+			if (cur_target != 0) {
+				sc_print_scope(1, cur_target);
+			} else if (!said_nt && sm_on) {
+				said_nt = 1;
+				printf("SWEET SURFCPU: no target tid yet (auto: no backboardd thread used >= 50 ms CPU in a second)\n");
+			}
+		}
+		if (sm_on) {
+			printf("SWEET THRSAMPLE: sec %u tid 0x%llx hz %d samples %d busy %d idle %d miss %d\n", sec, cur_target, sm_hz, nsamp, nbusy,
+			    nsamp - nbusy, nmiss);
+			if (nbusy > 0 && rows < SC_ROW_CAP) {
+				printf("SMP backboardd[%d] slide 0x%llx mh 0x%llx\n", bb_pid, sm_buf[0].slide, sm_buf[0].mh);
+				for (int i = 0; i < nbusy && rows < SC_ROW_CAP; i++) {
+					struct sweet_thrsmp *s = &sm_buf[i];
+					char line[240];
+					int l = snprintf(line, sizeof(line), "SMP backboardd t%d pc 0x%llx lr 0x%llx sp 0x%llx bt", s->idx, s->pc, s->lr, s->sp);
+					for (int b = 0; b < s->nbt && l < (int)sizeof(line) - 48; b++) {
+						l += snprintf(line + l, sizeof(line) - l, " 0x%llx", s->bt[b]);
+					}
+					snprintf(line + l, sizeof(line) - l, " tid 0x%llx st 0x%x", cur_target, (s->flags << 8) | (s->run_state & 0xff));
+					printf("%s\n", line);
+					if (++rows == SC_ROW_CAP) {
+						printf("SWEET THRSAMPLE: cap reached %d rows\n", SC_ROW_CAP);
+					}
+				}
+			}
+		}
+		nsamp = nbusy = nmiss = 0;
+	}
+}
+
+/* sweetthrsample=<tid>@<hz> | auto@<hz>; tid decimal or 0x hex */
+static int
+sc_parse_sample(const char *s)
+{
+	const char *p = s;
+	if (strncmp(p, "auto", 4) == 0) {
+		sm_auto = 1;
+		p += 4;
+	} else {
+		int base = 10;
+		uint64_t v = 0;
+		int nd = 0;
+		if (p[0] == '0' && (p[1] == 'x' || p[1] == 'X')) {
+			base = 16;
+			p += 2;
+		}
+		for (;; p++) {
+			int d;
+			if (*p >= '0' && *p <= '9') {
+				d = *p - '0';
+			} else if (base == 16 && *p >= 'a' && *p <= 'f') {
+				d = *p - 'a' + 10;
+			} else if (base == 16 && *p >= 'A' && *p <= 'F') {
+				d = *p - 'A' + 10;
+			} else {
+				break;
+			}
+			v = v * base + d;
+			nd++;
+		}
+		if (nd == 0 || v == 0) {
+			return -1;
+		}
+		sm_tid = v;
+	}
+	if (*p == '@') {
+		int h = 0;
+		for (p++; *p >= '0' && *p <= '9'; p++) {
+			h = h * 10 + (*p - '0');
+		}
+		if (h < 1 || h > SC_HZ_MAX) {
+			return -1;
+		}
+		sm_hz = h;
+	}
+	return *p == '\0' ? 0 : -1;
+}
+
+void
+sweet_surfcpu_start(void)
+{
+	int v = 0;
+	char arg[40];
+	thread_t thread;
+
+	sc_on = (PE_parse_boot_argn("sweetsurfcpu", &v, sizeof(v)) && v != 0);
+	if (PE_parse_boot_argn("sweetthrsample", arg, sizeof(arg))) {
+		if (sc_parse_sample(arg) == 0) {
+			sm_on = 1;
+		} else {
+			printf("SWEET THRSAMPLE: unavailable (bad boot-arg sweetthrsample='%s', want <tid>@<hz> or auto@<hz>)\n", arg);
+		}
+	}
+	if (!sc_on && !sm_on) {
+		return;
+	}
+	if (kernel_thread_start(sweet_surfcpu_thread, NULL, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	} else {
+		printf("SWEET SURFCPU: unavailable (kernel_thread_start failed)\n");
+		sc_on = 0;
+	}
+}
