+static int sm_on;                      /* sweetthrsample given and valid */
+static int sm_auto;
+static uint64_t sm_tid;                /* explicit tid */
+static int sm_hz = 50;
+
+#define SM_BUF (SC_HZ_MAX + 8)
+static struct sweet_thrsmp sm_buf[SM_BUF];     /* busy samples of the current second */
+
+/* one sample of the target thread into sm_buf; counts via the pointers */
+static void
+sc_sample_once(uint64_t target, int *nsamp, int *nbusy, int *nmiss, unsigned *said)
+{
+	proc_t p = bb_pid >= 0 ? proc_find(bb_pid) : PROC_NULL;
+	task_t task = p != PROC_NULL ? proc_task(p) : TASK_NULL;
+	if (task == TASK_NULL || target == 0) {
+		(*nmiss)++;
+	} else {
+		struct sweet_thrsmp s;
+		int rc = sweet_thrsample_task(task, target, &s);
+		if (rc == 0) {
+			(*nsamp)++;
+			if (s.run_state == 1 /* TH_STATE_RUNNING */ && *nbusy < SM_BUF) {
+				sm_buf[(*nbusy)++] = s;
+			}
+		} else {
+			(*nmiss)++;
+			if (!(*said & (1u << rc))) {
+				*said |= 1u << rc;
+				if (rc == 1) {
+					printf("SWEET THRSAMPLE: tid 0x%llx not found in backboardd pid %d\n", target, bb_pid);
+				} else if (rc == 2) {
+					printf("SWEET THRSAMPLE: tid 0x%llx has no 64-bit user state\n", target);
+				} else {
+					printf("SWEET THRSAMPLE: unavailable (thread_info error rc %d, tid 0x%llx)\n", rc, target);
+				}
+			}
+		}
+	}
+	if (p != PROC_NULL) {
+		proc_rele(p);
+	}
+}
