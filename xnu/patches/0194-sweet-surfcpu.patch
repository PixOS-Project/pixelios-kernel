+		if (!sm_on) {
+			printf("SWEET SURFCPU: no target tid (sweetthrsample unset): the `tid` lines are off\n");
+		}
+	}
+	if (sm_on) {
+		printf("SWEET THRSAMPLE: on target %s hz %d (rows are SMP lines with a trailing `tid`/`st`)\n", sm_auto ? "auto" : "explicit", sm_hz);
+	}
+	if (cur_target != 0) {
+		shown_target = cur_target;
+		os_atomic_store(&sc_target, cur_target, relaxed);
+	}
