+/*
+ * SWEET single-thread sampler (patch 0194, bsd/dev/sweet_surfcpu.c, boot-arg sweetthrsample): one sample of thread `tid` of `task`: user pc/lr/sp from the saved
+ * user state (find_user_regs, same source as sweet_sample_task above, so the pc is the one of the last kernel entry), THREAD_BASIC_INFO run_state/flags, the
+ * task's thread-queue index (= the tN of the SMP rows), the shared-cache slide and main-binary mach header, and up to 6 frame-pointer callers. The queue walk
+ * and thread_info_internal run under task_lock exactly as in sweet_thrcpu_task; the frame walk (vm_map_read_user, may fault) runs after the lock is dropped, on
+ * the registers copied under it: the caller holds a proc reference, so task and map stay valid. Returns 0 ok, 1 tid not in the task, 2 no 64-bit user state,
+ * 3 thread_info_internal failed. No printf here.
+ */
+struct sweet_thrsmp {
+	uint64_t pc, lr, sp, slide, mh;
+	uint32_t run_state, flags;
+	int idx, nbt;
+	uint64_t bt[6];
+};
+int sweet_thrsample_task(task_t task, uint64_t tid, struct sweet_thrsmp *o);
+
+int
+sweet_thrsample_task(task_t task, uint64_t tid, struct sweet_thrsmp *o)
+{
+	vm_map_t map = get_task_map(task);
+	vm_shared_region_t sr = vm_shared_region_get(task);
+	thread_t thread;
+	uint64_t fp = 0;
+	int idx = 0;
+	int rc = 1;
+
+	bzero(o, sizeof(*o));
+	if (sr != NULL) {
+		o->slide = sr->sr_slide;
+		vm_shared_region_deallocate(sr);
+	}
+	o->mh = task->mach_header_vm_address;
+
+	task_lock(task);
+	queue_iterate(&task->threads, thread, thread_t, task_threads) {
+		if (thread_tid(thread) == tid) {
+			arm_saved_state_t *ss = find_user_regs(thread);
+			thread_basic_info_data_t bi;
+			mach_msg_type_number_t cnt = THREAD_BASIC_INFO_COUNT;
+
+			if (thread_info_internal(thread, THREAD_BASIC_INFO, (thread_info_t)&bi, &cnt) != KERN_SUCCESS) {
+				rc = 3;
+			} else if (ss == NULL || !is_saved_state64(ss)) {
+				rc = 2;
+			} else {
+				o->run_state = (uint32_t)bi.run_state;
+				o->flags = (uint32_t)bi.flags;
+				o->idx = idx;
+				o->pc = get_saved_state_pc(ss);
+				o->lr = get_saved_state_lr(ss);
+				o->sp = get_saved_state_sp(ss);
+				fp = get_saved_state_fp(ss);
+				rc = 0;
+			}
+			break;
+		}
+		idx++;
+	}
+	task_unlock(task);
+
+	for (int i = 0; rc == 0 && i < 6 && fp != 0 && (fp & 7) == 0; i++) {
+		uint64_t frame[2];
+		if (vm_map_read_user(map, fp, frame, sizeof(frame)) != KERN_SUCCESS) {
+			break;
+		}
+		o->bt[o->nbt++] = frame[1];
+		if (frame[0] <= fp) {
+			break;
+		}
+		fp = frame[0];
+	}
+	return rc;
+}
