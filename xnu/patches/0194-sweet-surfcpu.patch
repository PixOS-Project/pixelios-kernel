+/*
+ * SWEET IOSurface user-client time + single-thread sampler (patch 0194; PLAN-60FPS P-G1 slice 4, research 125). R0: log only, no register writes,
+ * both parts default off.
+ *
+ * Boot-arg sweetsurfcpu=1: iokit/Kernel/arm/SweetSurface.cpp brackets IOSurfaceRootUserClient::externalMethod (kind "sel") and the six external
+ * traps (kind "trap": 0/1 use count, 2 lock, 3 unlock, 4/5 release) with sweet_surfcpu_enter/leave. Only calls made by a process named backboardd
+ * are counted: calls and elapsed mach_absolute_time (wall time inside the function, including any sleep on a lock; it excludes the Mach trap and
+ * argument-marshalling code around the function), per selector/trap index, twice: [0] all backboardd threads, [1] the target thread (below).
+ * Once per second the deltas of that second are printed, only for entries with calls:
+ *   SWEET SURFCPU: sel N calls C us U         (all backboardd threads; N = 63 means 63 and above)
+ *   SWEET SURFCPU: trap N calls C us U
+ *   SWEET SURFCPU: tid 0xT sel N calls C us U (the target thread only; same for trap)
+ * Loud once: `on`, `no target tid` (tid lines are off), `target tid ... -> ...` (the tid baseline restarts), `cap reached`.
+ *
+ * Boot-arg sweetthrsample=<tid>@<hz> or auto@<hz> (hz default 50, 1..100; tid decimal or 0x hex): every 1/hz s one sample of the target thread of
+ * backboardd: user pc/lr/sp from the saved user state (osfmk/kern/exception.c sweet_thrsample_task, same source as the 0054 SMP rows) and a
+ * frame-pointer backtrace of 6 callers. `auto` picks, once per second, the backboardd thread with the largest user+sys CPU delta of the last second
+ * (kept unless another thread beats it by 1.5x), because the tid of the CA render thread (0x27d in run 115a) is not known before the boot.
+ * Output, per second:
+ *   SWEET THRSAMPLE: sec S tid 0xT hz H samples N busy B idle I miss M
+ *   SMP backboardd[pid] slide S mh M          (header, then one row per BUSY sample, readable by tools/rea/smp-sym.py as is)
+ *   SMP backboardd tIDX pc 0x.. lr 0x.. sp 0x.. bt 0x.. ... tid 0xT st 0xS
+ * busy = THREAD_BASIC_INFO run_state RUNNING (running or runnable, st = flags << 8 | run_state as in SWEET THRCPU); idle samples are only counted.
+ * Limit (read from source): a user pc comes from the saved state, which is written at kernel entry (syscall, trap, interrupt): a thread that runs in
+ * user mode between two entries shows its last entry, not its live pc. Loud once: tid not found, no task, no user state, cap reached.
+ *
+ * One kernel thread does both (like bsd/dev/sweet_thrcpu.c, patch 0187); it never holds a lock while printing.
+ */
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/proc.h>
+#include <sys/proc_internal.h>
+#include <kern/task.h>
+#include <kern/thread.h>
+#include <kern/clock.h>
+#include <mach/kern_return.h>
+#include <pexpert/pexpert.h>
+#include <libkern/libkern.h>
+#include <machine/atomic.h>
+
+extern task_t proc_task(proc_t);
+extern char *proc_name_address(void *p);      /* bsd/kern/kern_proc.c */
+extern int hz;
+extern int sweet_thrcpu_task(task_t task, uint64_t *out, int max, int *total);   /* osfmk/kern/exception.c (patch 0187) */
+
+struct sweet_thrsmp {                          /* osfmk/kern/exception.c (this patch) */
+	uint64_t pc, lr, sp, slide, mh;
+	uint32_t run_state, flags;
+	int idx, nbt;
+	uint64_t bt[6];
+};
+extern int sweet_thrsample_task(task_t task, uint64_t tid, struct sweet_thrsmp *o);
+
+extern void sweet_surfcpu_start(void);
+extern uint64_t sweet_surfcpu_enter(void);
+extern void sweet_surfcpu_leave(int kind, uint32_t idx, uint64_t t0);
+
+#define SC_SEL      64         /* index SC_SEL - 1 = "that and above" */
+#define SC_THR_MAX  128
+#define SC_HZ_MAX   100
+#define SC_LINE_CAP 50000      /* SURFCPU lines per boot */
+#define SC_ROW_CAP  40000      /* busy SMP rows per boot */
+
+static int sc_on;                              /* sweetsurfcpu=1 */
+static uint64_t sc_calls[2][2][SC_SEL];        /* [all|target][sel|trap][index] */
+static uint64_t sc_abs[2][2][SC_SEL];
+static uint64_t sc_target;                     /* target tid, 0 = none (read by sweet_surfcpu_leave) */
+
+uint64_t
+sweet_surfcpu_enter(void)
+{
+	if (!sc_on) {
+		return 0;
+	}
+	if (strncmp(proc_name_address(current_proc()), "backboardd", MAXCOMLEN) != 0) {
+		return 0;
+	}
+	return mach_absolute_time();
+}
+
+void
+sweet_surfcpu_leave(int kind, uint32_t idx, uint64_t t0)
+{
+	if (t0 == 0) {
+		return;
+	}
+	uint64_t dt = mach_absolute_time() - t0;
+	uint64_t tg = os_atomic_load(&sc_target, relaxed);
+	if (idx >= SC_SEL) {
+		idx = SC_SEL - 1;
+	}
+	os_atomic_add(&sc_calls[0][kind][idx], 1, relaxed);
+	os_atomic_add(&sc_abs[0][kind][idx], dt, relaxed);
+	if (tg != 0 && thread_tid(current_thread()) == tg) {
+		os_atomic_add(&sc_calls[1][kind][idx], 1, relaxed);
+		os_atomic_add(&sc_abs[1][kind][idx], dt, relaxed);
+	}
+}
+
+static int bb_pid = -1;
+
+static int
+sc_find_cb(proc_t p, __unused void *arg)
+{
+	if (strncmp(proc_name_address(p), "backboardd", MAXCOMLEN) == 0) {
+		bb_pid = proc_pid(p);
+	}
+	return PROC_RETURNED;
+}
