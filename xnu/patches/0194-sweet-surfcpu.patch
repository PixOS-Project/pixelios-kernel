+static uint64_t
+sc_us(uint64_t abs)
+{
+	uint64_t ns;
+	absolutetime_to_nanoseconds(abs, &ns);
+	return ns / 1000;
+}
+
+/* auto target: the thread with the largest user+sys delta since the last call (cur kept unless beaten by 1.5x; < 50 ms of CPU in the second = keep cur). */
+static uint64_t ap_tid[SC_THR_MAX], ap_tot[SC_THR_MAX];
+static int ap_n;
+
+static uint64_t
+sc_auto_pick(const uint64_t *ent, int kept, uint64_t cur)
+{
+	uint64_t best = 0, bd = 0, curd = 0;
+	for (int i = 0; i < kept; i++) {
+		uint64_t tid = ent[i * 4], tot = ent[i * 4 + 1] + ent[i * 4 + 2], prev = 0;
+		for (int j = 0; j < ap_n; j++) {
+			if (ap_tid[j] == tid) {
+				prev = ap_tot[j];
+				break;
+			}
+		}
+		uint64_t d = tot >= prev ? tot - prev : 0;
+		if (tid == cur) {
+			curd = d;
+		}
+		if (d > bd) {
+			bd = d;
+			best = tid;
+		}
+	}
+	for (int i = 0; i < kept; i++) {
+		ap_tid[i] = ent[i * 4];
+		ap_tot[i] = ent[i * 4 + 1] + ent[i * 4 + 2];
+	}
+	ap_n = kept;
+	if (best == 0 || bd < 50000) {
+		return cur;
+	}
+	return (cur == 0 || best == cur || bd * 2 > curd * 3) ? best : cur;
+}
+
+static uint64_t sc_prev_c[2][2][SC_SEL], sc_prev_a[2][2][SC_SEL];   /* baselines of the last print, [all|target][sel|trap][index] */
+static unsigned sc_lines;
+
+static void
+sc_print_scope(int scope, uint64_t tid)
+{
+	static const char *const kn[2] = { "sel", "trap" };
+	for (int k = 0; k < 2; k++) {
+		for (int i = 0; i < SC_SEL; i++) {
+			uint64_t c = os_atomic_load(&sc_calls[scope][k][i], relaxed);
+			uint64_t a = os_atomic_load(&sc_abs[scope][k][i], relaxed);
+			uint64_t dc = c - sc_prev_c[scope][k][i], da = a - sc_prev_a[scope][k][i];
+			sc_prev_c[scope][k][i] = c;
+			sc_prev_a[scope][k][i] = a;
+			if (dc == 0 || sc_lines >= SC_LINE_CAP) {
+				continue;
+			}
+			if (scope == 0) {
+				printf("SWEET SURFCPU: %s %d calls %llu us %llu\n", kn[k], i, dc, sc_us(da));
+			} else {
+				printf("SWEET SURFCPU: tid 0x%llx %s %d calls %llu us %llu\n", tid, kn[k], i, dc, sc_us(da));
+			}
+			if (++sc_lines == SC_LINE_CAP) {
+				printf("SWEET SURFCPU: cap reached %d\n", SC_LINE_CAP);
+			}
+		}
+	}
+}
+
+static void
+sc_rebase_target(void)
+{
+	for (int k = 0; k < 2; k++) {
+		for (int i = 0; i < SC_SEL; i++) {
+			sc_prev_c[1][k][i] = os_atomic_load(&sc_calls[1][k][i], relaxed);
+			sc_prev_a[1][k][i] = os_atomic_load(&sc_abs[1][k][i], relaxed);
+		}
+	}
+}
