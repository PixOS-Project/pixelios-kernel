+#define SWEET_WLAN_JOIN_FW_H
+
+#ifndef SWEET_WLAN_JOIN_H
+#error "sweet_wlan_join_fw.h: include the parent header, not this file"
+#endif
+
+/* ------------------------------------------------------------------ firmware payloads (H1-H5, H8-H10) */
+/* wsec_key: BW struct bwfm_wsec_key (bwfmreg.h:629-648) = S5 wl_wsec_key_t (wlioctl.h.new:1993-2013). Both sum to 164 bytes:
+ * index 4 + len 4 + data 32 + pad 72 + algo 4 + flags 4 + pad 12 + iv_initialized 4 + pad 4 + rxiv 8 + pad 8 + ea 6 + pad 2 = 164. */
+#define SWJ_WSEC_KEY_SIZE   164u
+#define SWJ_WSEC_OFF_INDEX  0u
+#define SWJ_WSEC_OFF_LEN    4u
+#define SWJ_WSEC_OFF_DATA   8u
+#define SWJ_WSEC_OFF_ALGO   112u
+#define SWJ_WSEC_OFF_FLAGS  116u
+#define SWJ_WSEC_OFF_IVINIT 132u
+#define SWJ_WSEC_OFF_EA     156u
+
+static inline int swj_wsec_key(uint8_t out[SWJ_WSEC_KEY_SIZE], uint32_t index, const uint8_t *key, uint32_t klen, uint32_t algo,
+    uint32_t flags, const uint8_t *ea)
+{
+	if (klen > 32u)
+		return -1;
+	memset(out, 0, SWJ_WSEC_KEY_SIZE);
+	swj_put_le32(out + SWJ_WSEC_OFF_INDEX, index);
+	swj_put_le32(out + SWJ_WSEC_OFF_LEN, klen);
+	memcpy(out + SWJ_WSEC_OFF_DATA, key, klen);
+	swj_put_le32(out + SWJ_WSEC_OFF_ALGO, algo);
+	swj_put_le32(out + SWJ_WSEC_OFF_FLAGS, flags);
+	if (ea)
+		memcpy(out + SWJ_WSEC_OFF_EA, ea, 6);
+	return 0;
+}
+
+/* H8: pairwise key = TK (PTK[32..48)), index 0, AES_CCM, carries the AP MAC. H9: group key, index = GTK id, PRIMARY flag, no ea. */
+static inline int swj_wsec_key_pairwise(const struct swj_ctx *c, uint8_t out[SWJ_WSEC_KEY_SIZE])
+{
+	return swj_wsec_key(out, 0, c->tptk + 32, 16, SWJ_ALGO_AES_CCM, 0, c->aa);
+}
+static inline int swj_wsec_key_group(const struct swj_ctx *c, uint8_t out[SWJ_WSEC_KEY_SIZE])
+{
+	return swj_wsec_key(out, c->gtk_id, c->gtk, 16, SWJ_ALGO_AES_CCM, SWJ_WSEC_PRIMARY_KEY, NULL);
+}
+
+/* H10: GET wsec -> clear WEP|TKIP|AES -> set the key's cipher bit -> SET wsec [BW/bwfm.c:2956-2959]. */
+static inline uint32_t swj_wsec_merge(uint32_t cur, uint32_t cipher_bit)
+{
+	return (cur & ~(SWJ_WSEC_WEP | SWJ_WSEC_TKIP | SWJ_WSEC_AES)) | cipher_bit;
+}
+
+/* SET_VAR / GET_VAR payload: "name\0" + data [R108 s.2.2]. Returns the length, or 0 (with a GAP) when it does not fit. */
+static inline uint32_t swj_var_buf(uint8_t *out, uint32_t cap, const char *name, const void *data, uint32_t dlen)
+{
+	uint32_t nl = (uint32_t)strlen(name) + 1u;
+
+	if (nl + dlen > cap) {
+		SWJ_GAP("WIFI GAP: iovar payload does not fit the buffer");
+		return 0;
+	}
+	memcpy(out, name, nl);
+	if (dlen)
+		memcpy(out + nl, data, dlen);
+	return nl + dlen;
+}
+static inline uint32_t swj_var_u32(uint8_t *out, uint32_t cap, const char *name, uint32_t v)
+{
+	uint8_t d[4];
+
+	swj_put_le32(d, v);
+	return swj_var_buf(out, cap, name, d, 4);
+}
+
+/* H5: extended join params. TWO layouts exist (T-4ba0):
+ *  v0 [BW bwfm_ext_join_params: bwfmreg.h ssid 36 + scan 20 + assoc 12 = 68] = S5 wl_extjoin_params_t (wlioctl.h.new:1505-1512). The BCM4389 answered it
+ *  with status -18 = BCME_BADSSIDLEN (bcmerror.h:77) [obs run 20261107T085006Z-wlan-runG2-join24].
+ *  v1 = S5 wl_extjoin_params_v1_t (wlioctl.h.new:1514-1523): u16 version, u16 pad, ssid 36, scan 20, assoc_v1 16 (u16 version, u16 flags, bssid 6, u16 bssid_cnt,
+ *  i32 chanspec_num) = 76 B (WL_EXTJOIN_PARAMS_FIXED_SIZE_V1, :1527). The stock driver sends v1 when its firmware reports a new enough wlc_ver
+ *  (wl_cfg80211.c.new:18512-18519, join_iovar_ver) and its v1 fill code (wl_fillup_assoc_params_v1, :6270-6330) never sets either version field (the buffer is
+ *  zeroed, so both are 0) nor the assoc flags without a BSSID hint [read from source]. A v1 firmware reads SSID_len at byte 4 of a v0 payload = the first 4 SSID
+ *  characters as a u32 (> 32) = BCME_BADSSIDLEN [model, consistent with the observed -18; NOT yet observed with v1].
+ * and the SET_SSID fallback [BW bwfm_join_params = ssid 36 + assoc 12 = 48]. scan_type -1, nprobes/active/passive/home -1 (BW/bwfm.c:2054-2062;
+ * DHD wl_cfg80211.c.new:6308-6318 with chan_cnt 0). */
+#define SWJ_EXT_JOIN_SIZE    68u
+#define SWJ_EXT_JOIN_V1_SIZE 76u
+#define SWJ_JOIN_SIZE        48u
+static inline void swj_assoc_params(uint8_t *o, const uint8_t bssid[6])
+{
+	memset(o, 0, 12);
+	memcpy(o, bssid, 6);		/* pad 2, chanspec_num 0 */
+}
+static inline int swj_join_ext(uint8_t out[SWJ_EXT_JOIN_SIZE], const uint8_t *ssid, uint32_t slen, const uint8_t bssid[6])
+{
+	if (slen == 0 || slen > SWJ_MAX_SSID)
+		return -1;
+	memset(out, 0, SWJ_EXT_JOIN_SIZE);
+	swj_put_le32(out, slen); memcpy(out + 4, ssid, slen);
+	memset(out + 36, 0xff, 20);	/* scan_type -1 (0xff), nprobes/active/passive/home -1; the 3 pad bytes after scan_type are zero */
+	out[37] = out[38] = out[39] = 0;
+	swj_assoc_params(out + 56, bssid);
+	return 0;
+}
+/* v1 (the form swj_join_cmds sends): version 0, pad 0, SSID_len u32 at 4, SSID at 8, scan at 40 (scan_type 0xff + 3 pad, four -1 words), assoc_v1 at 60:
+ * version 0, flags 0, bssid, bssid_cnt 0, chanspec_num 0 (all channels), no chanspec_list */
+static inline int swj_join_ext_v1(uint8_t out[SWJ_EXT_JOIN_V1_SIZE], const uint8_t *ssid, uint32_t slen, const uint8_t bssid[6])
+{
+	if (slen == 0 || slen > SWJ_MAX_SSID)
+		return -1;
+	memset(out, 0, SWJ_EXT_JOIN_V1_SIZE);
+	swj_put_le32(out + 4, slen); memcpy(out + 8, ssid, slen);
+	memset(out + 40, 0xff, 20);	/* scan_type -1 (0xff) and nprobes/active/passive/home -1 */
+	out[41] = out[42] = out[43] = 0;	/* the 3 pad bytes after scan_type */
+	memcpy(out + 64, bssid, 6);	/* assoc_v1.bssid; version, flags, bssid_cnt, chanspec_num stay 0 */
+	return 0;
+}
+static inline int swj_join_plain(uint8_t out[SWJ_JOIN_SIZE], const uint8_t *ssid, uint32_t slen, const uint8_t bssid[6])
+{
+	if (slen == 0 || slen > SWJ_MAX_SSID)
+		return -1;
+	memset(out, 0, SWJ_JOIN_SIZE);
+	swj_put_le32(out, slen); memcpy(out + 4, ssid, slen);
+	swj_assoc_params(out + 36, bssid);
+	return 0;
+}
+
+/* H1-H5 in order: sup_wpa 0, wpa_auth, wsec, auth open, mfp none, join (BW/bwfm.c:569, 2031-2062). Each command is SET_VAR (263)
+ * with a "name\0"+u32 payload except the join (SET_VAR "join", the 76 B v1 params, T-4ba0). Returns the count (6), or 0 with a GAP. */
+struct swj_cmd { uint32_t cmd; const char *row; uint8_t buf[96]; uint32_t len; };
+static inline unsigned swj_join_cmds(struct swj_cmd out[6], const uint8_t *ssid, uint32_t slen, const uint8_t bssid[6], int group_tkip)
+{
+	static const char *const names[5] = { "sup_wpa", "wpa_auth", "wsec", "auth", "mfp" };
+	static const char *const rows[6] = { "H1", "H2", "H3", "H4", "H4", "H5" };
+	uint32_t vals[5];
+	uint8_t ext[SWJ_EXT_JOIN_V1_SIZE];
+	unsigned i;
+
+	vals[0] = 0; vals[1] = SWJ_WPA2_AUTH_PSK; vals[2] = SWJ_WSEC_AES | (group_tkip ? SWJ_WSEC_TKIP : 0u); vals[3] = 0; vals[4] = 0;
+	if (swj_join_ext_v1(ext, ssid, slen, bssid) != 0) {
+		SWJ_GAP("WIFI GAP: join refused: ssid length not 1..32");
+		return 0;
+	}
+	for (i = 0; i < 5; i++) {
+		out[i].cmd = SWJ_WLC_SET_VAR; out[i].row = rows[i];
+		out[i].len = swj_var_u32(out[i].buf, sizeof out[i].buf, names[i], vals[i]);
+	}
+	out[5].cmd = SWJ_WLC_SET_VAR; out[5].row = rows[5];
+	out[5].len = swj_var_buf(out[5].buf, sizeof out[5].buf, "join", ext, sizeof ext);
+	return out[5].len ? 6u : 0u;
+}
+
+/* ALL-ON T-32: the firmware keep-alive, SET_VAR "mkeep_alive" + the packed wl_mkeep_alive_pkt_v1_t header of 11 bytes, little endian: u16 version = 1, u16 length = 11 (WL_MKEEP_ALIVE_FIXED_LEN),
+ * u32 period_msec, u16 len_bytes = 0 (0 = the firmware sends a NULL data frame), u8 keep_alive_id = 0; no data[] [src docs/research/138-wlan-keepalive.md s.1/s.2: bcmdhd bcm4389 dhd_common.c:7257-7295 (null packet, id 0, len_bytes 0),
+ * wlioctl.h:7274-7290; mainline brcmfmac fwil_types.h:1221-1237 is the same layout; the Pixel build period is 30000 ms, Kbuild:480]. The period is a plain millisecond count (the high bit means "send now" and is refused here: it is
+ * never wanted). Row "KA". Returns 1 with out filled, or 0 with a GAP (period 0 would STOP the keep-alive [guess, research 138 s.1], or has the high bit set). */
+#define SWJ_MKEEP_ID       0u
+#define SWJ_MKEEP_VERSION  1u
+#define SWJ_MKEEP_HDR_LEN  11u
+#define SWJ_MKEEP_PERIOD_MS 30000u
+static inline unsigned swj_mkeep_alive_cmd(struct swj_cmd *out, uint32_t period_ms)
+{
+	uint8_t d[SWJ_MKEEP_HDR_LEN];
+
+	if (period_ms == 0u || (period_ms & 0x80000000u) != 0u) {
+		SWJ_GAP("WIFI GAP: mkeep_alive refused: period 0 or with the immediate bit");
+		return 0;
+	}
+	memset(d, 0, sizeof d);
+	d[0] = (uint8_t)SWJ_MKEEP_VERSION;		/* u16 version, the high byte stays 0 */
+	d[2] = (uint8_t)SWJ_MKEEP_HDR_LEN;		/* u16 length, the high byte stays 0 */
+	swj_put_le32(d + 4, period_ms);			/* u32 period_msec; len_bytes (u16 at 8) = 0, keep_alive_id (u8 at 10) = SWJ_MKEEP_ID = 0 */
+	out->cmd = SWJ_WLC_SET_VAR; out->row = "KA";
+	out->len = swj_var_buf(out->buf, sizeof out->buf, "mkeep_alive", d, sizeof d);
+	return out->len ? 1u : 0u;
+}
+
+/* T-857c knob A (station address A/B): the boot-arg `sweetwlanmac=<12 hex>` makes the glue insert ONE SET_VAR "cur_etheraddr" (name 14 incl. NUL + 6 B) as command 1, right after sup_wpa and before the join
+ * [src the stock driver sets the same iovar with no WLC_DOWN around it: bcm4389-dhd_linux.c:10588-10608, docs/reviews/T-b8c6-proof.md item 4; the firmware's answer is a guess]. The value is a private run parameter (rule 4): it is never printed
+ * (the engine sends this command through the secret-quiet path) and never lands in git. Accepted: exactly 12 hex digits; unicast (bit 0 of octet 0 clear), globally administered (bit 1 clear: the baseline SPA has bit 1 SET [obs T-8d5f proof],
+ * so this knob tests the opposite), not all zero. Anything else is refused loudly and the glue then runs no join at all (an A/B with a silently dropped knob would be a false baseline, rule 8). */
+static inline int swj_parse_mac(const char *s, uint8_t mac[6])
+{
+	uint8_t m[6];
+	unsigned i;
+
+	if (s == NULL)
+		return -1;
+	for (i = 0; i < 12u; i++) {
+		char c = s[i];
+		unsigned v;
+
+		if (c >= '0' && c <= '9') v = (unsigned)(c - '0');
+		else if (c >= 'a' && c <= 'f') v = (unsigned)(c - 'a') + 10u;
+		else if (c >= 'A' && c <= 'F') v = (unsigned)(c - 'A') + 10u;
+		else return -1;
+		if (i & 1u) m[i / 2u] |= (uint8_t)v; else m[i / 2u] = (uint8_t)(v << 4);
+	}
+	if (s[12] != '\0')
+		return -1;
+	memcpy(mac, m, 6);
+	return 0;
+}
+static inline int swj_mac_ok(const uint8_t mac[6])
+{
+	return (mac[0] & 3u) == 0u && (mac[0] | mac[1] | mac[2] | mac[3] | mac[4] | mac[5]) != 0u;
+}
+/* Inserts the cur_etheraddr SET_VAR (row "H1m") as out[1] of the n == 6 commands swj_join_cmds built (out has room for 7). Returns 7, or 0 with a GAP (the caller drops all commands). */
+static inline unsigned swj_join_cmds_mac(struct swj_cmd out[7], unsigned n, const uint8_t mac[6])
+{
+	unsigned i;
+
+	if (n != 6u) {
+		SWJ_GAP("WIFI GAP: station MAC knob: needs the six base join commands");
+		return 0;
+	}
+	if (!swj_mac_ok(mac)) {
+		SWJ_GAP("WIFI GAP: station MAC knob refused: multicast, locally administered or zero");
+		return 0;
+	}
+	for (i = 6u; i > 1u; i--)
+		out[i] = out[i - 1u];
+	memset(&out[1], 0, sizeof out[1]);
+	out[1].cmd = SWJ_WLC_SET_VAR; out[1].row = "H1m";
+	out[1].len = swj_var_buf(out[1].buf, sizeof out[1].buf, "cur_etheraddr", mac, 6);
+	return out[1].len ? 7u : 0u;
+}
+
+#endif /* SWEET_WLAN_JOIN_FW_H */
diff --git a/bsd/dev/sweet_wlan_cred.h b/bsd/dev/sweet_wlan_cred.h
new file mode 100644
index 00000000..a1f12e2d
--- /dev/null
+++ b/bsd/dev/sweet_wlan_cred.h
@@ -0,0 +1,131 @@
+/* sweet_wlan_cred.h - the shim side of the WLANCRED credential blob (SPEC-WIFI Part E TRANSPORT block s.3 items 1 and 4; T-f5f7 step 2).
+ *
+ * PURPOSE: validate the 128-byte RAM-only blob that tools/mkwlancred.py builds (layout there, the host twin `parse`), copy the fields the join needs,
+ * derive the PMK (PBKDF2-HMAC-SHA1(psk, ssid, 4096, 32), swj_pmk_from_passphrase), then ZERO the DT-named region and the working copy of the
+ * passphrase with a compiler-barrier wipe, and print exactly one line: `SWEET WLAN: credentials loaded security=wpa2-psk` (no length, ssid, ip).
+ * Any failure prints `WIFI GAP: creds <missing|invalid>` (no value) and the region is still wiped (it may hold a passphrase); the caller stops before
+ * any ioctl. Pure functions on byte buffers: the includer owns the mapping of the region (the glue reads the /chosen/memory-map property WLANCRED).
+ * The includer defines SWC_LOG(str) and SWC_GAP(str) and includes sweet_wlan_join.h first (swj_pmk_from_passphrase). SECRETS (rule 4): nothing
+ * here prints a byte of the blob, the passphrase, the PMK, the ssid or an address. No hardware access, no allocation.
+ *
+ * Blob (little endian, 128 bytes) [src tools/mkwlancred.py docstring, read 2026-11-03]:
+ *   0x00 magic "WLANCRB1" | 0x08 u32 security (0 = wpa2-psk) | 0x0c u32 ssid_len 1..32 | 0x10 u32 psk_len 8..63 | 0x14 ssid[32] | 0x34 psk[64]
+ *   | 0x74 ip[4] | 0x78 gw[4] | 0x7c u32 crc32 (zlib, reflected 0xEDB88320) over 0x00..0x7b; ssid/psk padding must be zero.
+ */
+#ifndef SWEET_WLAN_CRED_H
+#define SWEET_WLAN_CRED_H
+
+#include <stdint.h>
+#include <string.h>
+
+#if !defined(SWC_LOG) || !defined(SWC_GAP)
+#error "sweet_wlan_cred.h: define SWC_LOG(str) and SWC_GAP(str) before including (rule 8)"
+#endif
+#ifndef SWEET_WLAN_JOIN_H
+#error "sweet_wlan_cred.h: include sweet_wlan_join.h first (swj_pmk_from_passphrase)"
+#endif
+
+#define SWC_SIZE      128u
+#define SWC_MAGIC     "WLANCRB1"
+#define SWC_L_LOADED  "SWEET WLAN: credentials loaded security=wpa2-psk"
+#define SWC_GAP_MISSING "WIFI GAP: creds missing"
+#define SWC_GAP_INVALID "WIFI GAP: creds invalid"
+
+/* what the join needs after the load: no passphrase (only the PMK) */
+struct swc_creds {
+	uint8_t ssid[32];
+	uint32_t ssid_len;
+	uint8_t pmk[32];
+	uint8_t ip[4], gw[4];
+};
+
+/* zero n bytes in a way the compiler cannot drop (volatile stores plus a memory clobber) */
+static inline void swc_wipe(void *p, uint32_t n)
+{
+	volatile uint8_t *v = (volatile uint8_t *)p;
+	uint32_t i;
+
+	for (i = 0; i < n; i++)
+		v[i] = 0u;
+	__asm__ volatile("" ::: "memory");
+}
+
+static inline uint32_t swc_crc32(const uint8_t *p, uint32_t n)
+{
+	uint32_t c = 0xFFFFFFFFu, i, k;
+
+	for (i = 0; i < n; i++) {
+		c ^= p[i];
+		for (k = 0; k < 8u; k++)
+			c = (c >> 1) ^ (0xEDB88320u & (0u - (c & 1u)));
+	}
+	return ~c;
+}
+
+static inline uint32_t swc_le32(const uint8_t *p)
+{
+	return (uint32_t)p[0] | ((uint32_t)p[1] << 8) | ((uint32_t)p[2] << 16) | ((uint32_t)p[3] << 24);
+}
+
+/* validate `w` (SWC_SIZE bytes): 0 = ok, -1 = invalid. Looks at no byte it has not bounds-checked; never prints. */
+static inline int swc_check(const uint8_t w[SWC_SIZE])
+{
+	uint32_t sl, pl, i;
+
+	if (memcmp(w, SWC_MAGIC, 8) != 0 || swc_crc32(w, SWC_SIZE - 4u) != swc_le32(w + 0x7c) || swc_le32(w + 0x08) != 0u)
+		return -1;
+	sl = swc_le32(w + 0x0c);
+	pl = swc_le32(w + 0x10);
+	if (sl < 1u || sl > 32u || pl < 8u || pl > 63u)
+		return -1;
+	for (i = sl; i < 32u; i++)
+		if (w[0x14 + i] != 0u)
+			return -1;
+	for (i = pl; i < 64u; i++)
+		if (w[0x34 + i] != 0u)
+			return -1;
+	return 0;
+}
+
+/* The L24 entry reads the blob ONCE. region = the DT-named region (`avail` bytes, may be NULL / short), work = the caller's SWC_SIZE-byte working copy
+ * (the stack copy of the passphrase lives there; wiped before return). On every path the region (all `avail` bytes) and `work` are zero afterwards.
+ * Returns 0 and fills *out (prints SWC_L_LOADED), or -1 after printing `WIFI GAP: creds missing|invalid` (*out is zero). */
+static inline int swc_load(volatile uint8_t *region, uint32_t avail, uint8_t work[SWC_SIZE], struct swc_creds *out)
+{
+	uint32_t i, sl, pl;
+	int bad;
+
+	memset(out, 0, sizeof *out);
+	if (region == NULL || avail < SWC_SIZE) {
+		if (region != NULL)
+			swc_wipe((void *)region, avail);
+		swc_wipe(work, SWC_SIZE);
+		SWC_GAP(SWC_GAP_MISSING);
+		return -1;
+	}
+	for (i = 0; i < SWC_SIZE; i++)
+		work[i] = region[i];
+	swc_wipe((void *)region, avail);
+	bad = swc_check(work);
+	if (bad == 0) {
+		sl = swc_le32(work + 0x0c);
+		pl = swc_le32(work + 0x10);
+		bad = swj_pmk_from_passphrase((const char *)(work + 0x34), pl, work + 0x14, sl, out->pmk);
+		if (bad == 0) {
+			memcpy(out->ssid, work + 0x14, sl);
+			out->ssid_len = sl;
+			memcpy(out->ip, work + 0x74, 4);
+			memcpy(out->gw, work + 0x78, 4);
+		}
+	}
+	swc_wipe(work, SWC_SIZE);
+	if (bad != 0) {
+		swc_wipe(out, (uint32_t)sizeof *out);
+		SWC_GAP(SWC_GAP_INVALID);
+		return -1;
+	}
+	SWC_LOG(SWC_L_LOADED);
+	return 0;
+}
+
+#endif /* SWEET_WLAN_CRED_H */
diff --git a/bsd/dev/sweet_wlan_l25.h b/bsd/dev/sweet_wlan_l25.h
new file mode 100644
index 00000000..eae652b2
--- /dev/null
+++ b/bsd/dev/sweet_wlan_l25.h
@@ -0,0 +1,289 @@
+/*
+ * L25 data-path steps of the W-D4e engine (T-38cc; SPEC-WIFI Part E TRANSPORT block s.1-s.2): the data block envelope (swl25_env), the flow-ring create and its
+ * CREATE_CMPLT (swl25_flow), the 16 rx buffer posts (swl25_rxposts). Every store goes through swg_dp_exec (DP15); nothing here writes the bus itself.
+ *
+ * Include order in the includer: sweet_wlan_data.h (with SWDP_LOG/SWDP_GAP), then sweet_wlan_g2.h, then this file. NOT in this slice (open, ticket T-38cc Log): the rx
+ * poll of rings 3/4 with swj_rx (M1..M4, H6/H7), the key installs H8-H10 and L26 (ARP/ping). The glue does not allocate the data block yet: struct swg_in.data stays 0 and
+ * swl25_env then prints `WIFI GAP: L25 not run: ...` (rule 8), so a boot at sweetwlan=25 stops loudly instead of pretending.
+ *
+ * Data block layout [decision, TRANSPORT s.1 item 1 "buffer ranges from the data block the glue allocated"; the offsets are this file's, the DP15 host test uses the same]:
+ *   +0x0000 flow ring (SWL25_FLOW_DEPTH items of the base tx item size 48 B), +0x4000 16 tx buffers of SWL25_BUF_SZ, +0xC000 the rx buffers of SWL25_BUF_SZ; total SWL25_DATA_MIN for 16 rx buffers.
+ *   Patch 0357: the glue may allocate more (up to SWL25_DATA_MAX = 255 rx buffers); the rx pool the engine posts is chosen by swdp_rx_pick in swl25_env (<= the buffers the block holds).
+ */
+#ifndef SWEET_WLAN_L25_H
+#define SWEET_WLAN_L25_H
+
+#ifndef SWEET_WLAN_DATA_H
+#error "sweet_wlan_l25.h needs sweet_wlan_data.h and sweet_wlan_g2.h first"
+#endif
+
+_Static_assert(SWDP_RXFW_UNREAD == 0 && SWDP_RXFW_OK == 1 && SWDP_RXFW_FAIL == 2, "sweet_wlan_g2.h swg_e writes the rx firmware state as 0/1/2");
+
+#define SWL25_FLOW_DEPTH 64u            /* flow ring items (DHD default for a station ring is larger; one ring, 16 posts per run: DP10) */
+#define SWL25_BUF_SZ     2048u          /* one rx or tx buffer (>= SWDP_ETH_MAXFRAME, swdp_env_ok) */
+#define SWL25_TX_OFF     0x4000u
+#define SWL25_RX_OFF     0xC000u
+#define SWL25_DATA_MIN   0x14000u
+#define SWL25_DATA_MAX   (SWL25_RX_OFF + SWDP_RX_MAX * SWL25_BUF_SZ)   /* patch 0357: the DATA block with the largest rx pool (255 buffers, Linux's default max_rxbufpost) */
+#define SWL25_SHADOW_ITEMS 16u          /* the shadow covers the first 16 items of ring 1 and of the flow ring (= the post count of L25/L26); a later slot has no shadow and stops the engine (SWG_E_ADDR) */
+#define SWL25_MAXSUB     43u            /* H2D index slots of the observed shared structure (max_submission_queues 0x2b, SWG_RI_QUEUES) */
+#define SWL25_FLOWID     SWDP_FLOWID_FIRST
+#define SWL25_RXPOSTS    16u
+#define SWL25_R1_SHADOW  256u           /* sprint 2026-11-08: ring-1 items with a shadow: the 16 first posts + 240 re-posts of the same 16 buffers (each rx completion re-posts its buffer); the 257th post is a loud refusal */
+#define SWL25_CREATE_MS  1000u          /* wait for CREATE_CMPLT [decision, no source] */
+
+/* What the glue (or the host test) hands the L25/L26 engine through struct swg_wx.l25c; it is NOT built by this slice's glue yet (the pointer stays NULL there: swl25_run then prints `WIFI GAP: L25 not run`).
+ * rsne_*: the RSNE of the target AP's beacon / probe response; rsne_assoc is the one M2 must carry. Source decision [guess, SPEC-WIFI U-g]: both come from the AP's scan record (bss_info IE 48); the firmware's
+ * association request RSNE is NOT read, so rsne_assoc == rsne_beacon until the first run compares them; swj_ctx_init prints SWJ_GAP_X_RSNE for it. All-zero mac, bssid, ip or gw are refused (never a default). */
+struct swl25_cfg {
+	uint8_t pmk[32], mac[6], bssid[6], ip[4], gw[4];
+	uint8_t rsne_assoc[64], rsne_beacon[64];
+	uint32_t rsne_assoc_len, rsne_beacon_len;
+};
+
+struct swl25 {
+	struct swdp_env env;
+	struct swdp_flow flow;          /* the flow ring books (rings: write cursor, epoch counter) */
+	struct swdp_ring r1;            /* ring 1 (rxpost) books */
+	struct swdp_book rxb;           /* rx buffers in flight */
+	uint32_t sh_r1[SWL25_R1_SHADOW * SWDP_ISZ_RXPOST / 4u];
+	uint32_t sh_fl[SWL25_SHADOW_ITEMS * SWDP_ISZ_TX_BASE / 4u];
+	uint32_t sh_tx[SWDP_NSLOT * SWL25_BUF_SZ / 4u];
+	uint8_t mac[6], gwmac[6];       /* station and AP MAC (the glue fills them from the join result) */
+};
+
+/* A refusal before the first store: WIFI GAP + the engine soft-stops. -SWG_E_ORDER */
+static int
+swl25_refuse(struct swg_wx *x, const char *why)
+{
+	char gb[64];     /* swl_gap keeps 63 chars of `what`: 13 + 50 fit, the full text is in the printf below (gcc -Wformat-truncation saw the 80 B buffer flow into the 64 B table field once the test TU changed) */
+
+	snprintf(gb, sizeof gb, "L25 not run: %.50s", why);
+	swl_gap("l25", gb, "high");
+	printf("WIFI GAP: L25 not run: %s\n", why);
+	x->d4dstop = 1u;
+	return -SWG_E_ORDER;
+}
+
+/* Build the envelope from what the glue handed in (struct swg_in: blk/idx/ring of the G1 block, data/data_len of the DATA block) and install the shadow regions.
+ * Refuses (GAP, nothing stored) a missing or too small data block, a data block that overlaps the G1 block, and an env swdp_env_ok rejects. 0 = ok */
+static int
+swl25_env(struct swg_wx *x, struct swl25 *l)
+{
+	struct swdp_env *e = &l->env;
+	const uint64_t d = x->in.data;
+	int r;
+
+	memset(e, 0, sizeof *e);
+	if (d == 0u || x->in.data_len == 0u) {
+		return swl25_refuse(x, "no DATA block was allocated by the glue");
+	}
+	if (x->in.data_len < SWL25_DATA_MIN || (d & 0xFFFu) != 0u) {
+		return swl25_refuse(x, "DATA block too small or not page aligned");
+	}
+	if (d + x->in.data_len < d || (d < x->in.blk + x->in.blk_len && d + x->in.data_len > x->in.blk)) {
+		return swl25_refuse(x, "DATA block overlaps the G1 block");
+	}
+	e->g1 = (struct swdp_range){ x->in.blk, x->in.blk_len };
+	e->data = (struct swdp_range){ d, x->in.data_len };
+	e->h2d_wr = (struct swdp_range){ x->in.idx[SWG_IDX(SWD_IDX_H2D_W)], (uint64_t)SWDP_IDX_SZ * SWL25_MAXSUB };
+	e->d2h_rd = (struct swdp_range){ x->in.idx[SWG_IDX(SWD_IDX_D2H_R)], 3u * SWDP_IDX_SZ };
+	e->ring0 = (struct swdp_range){ x->in.ring[0], (uint64_t)swd_rings[0].items * SWDP_ISZ_CTRL_SUB };
+	e->ring1 = (struct swdp_range){ x->in.ring[1], (uint64_t)swd_rings[1].items * SWDP_ISZ_RXPOST };
+	e->flow = (struct swdp_range){ d, (uint64_t)SWL25_FLOW_DEPTH * SWDP_ISZ_TX_BASE };
+	e->txbuf = (struct swdp_range){ d + SWL25_TX_OFF, (uint64_t)SWDP_NSLOT * SWL25_BUF_SZ };
+	e->depth0 = swd_rings[0].items;
+	e->depth1 = swd_rings[1].items;
+	{       /* patch 0357: the rx pool: firmware max_rxbufpost (read at the D4e entry, x->rxfw) or the boot-arg, cut to the ring and to what the DATA block holds */
+		struct swdp_rxsel sel;
+		const uint32_t cap = (x->in.data_len - SWL25_RX_OFF) / SWL25_BUF_SZ;
+		char lb[320];
+
+		swdp_rx_pick(&sel, x->rxfw_state, x->rxfw, x->in.rxarg_set, x->in.rxarg, e->depth1, cap);
+		snprintf(lb, sizeof lb, "SWEET WLAN: rx pool: firmware max_rxbufpost %s %u, boot-arg %s, ring-1 depth %u, block holds %u, ceiling %u, chosen %u from %s",
+		    x->rxfw_state == SWDP_RXFW_OK ? "read" : x->rxfw_state == SWDP_RXFW_FAIL ? "UNREADABLE" : "UNREAD", x->rxfw, x->in.rxarg_set ? "set" : "absent",
+		    (unsigned)e->depth1, (unsigned)cap, (unsigned)sel.ceil, (unsigned)sel.n, sel.src == SWDP_RXSRC_ARG ? "sweetwlanrxpost" : sel.src == SWDP_RXSRC_FW ? "the firmware value" : "the default 16");
+		SWDP_LOG(lb);
+		if (sel.notes != 0u) {
+			snprintf(lb, sizeof lb, "WIFI GAP: rx pool adjusted (notes %#x: 1 fw0->255, 2 fw>255, 4 fw<16 keeps 16, 8 firmware value unusable keeps 16, 0x10 boot-arg clamped 16..255, 0x20 ring, 0x40 block, 0x80 boot-arg above the firmware value): chosen %u",
+			    (unsigned)sel.notes, (unsigned)sel.n);
+			SWDP_GAP(lb);
+		}
+		e->rxbuf = (struct swdp_range){ d + SWL25_RX_OFF, (uint64_t)sel.n * SWL25_BUF_SZ };
+		e->rx_slots = sel.n;
+	}
+	e->depth_flow = SWL25_FLOW_DEPTH;
+	e->max_sub = SWL25_MAXSUB;
+	e->flowid = SWL25_FLOWID;
+	e->flow_isz = SWDP_ISZ_TX_BASE;
+	e->buf_sz = SWL25_BUF_SZ;
+	e->idx_sz = SWDP_IDX_SZ;
+	e->depth_d2h[0] = SWG_R2_DEPTH;
+	e->depth_d2h[1] = swd_rings[3].items;
+	e->depth_d2h[2] = swd_rings[4].items;
+	e->wr0 = x->d4wr;
+	e->rd_d2h[0] = x->d4rd % SWG_R2_DEPTH;
+	r = swdp_env_ok(e);
+	if (r != 0) {
+		char b[40];
+
+		snprintf(b, sizeof b, "env refused by the audit code=%s", swg_dp_aname[r]);
+		return swl25_refuse(x, b);
+	}
+	memset(l->sh_r1, 0, sizeof l->sh_r1);
+	memset(l->sh_fl, 0, sizeof l->sh_fl);
+	memset(l->sh_tx, 0, sizeof l->sh_tx);
+	x->dpsh[0] = (struct swg_dp_sh){ e->ring1.pa, sizeof l->sh_r1 / 4u, l->sh_r1 };
+	x->dpsh[1] = (struct swg_dp_sh){ e->flow.pa, sizeof l->sh_fl / 4u, l->sh_fl };
+	x->dpsh[2] = (struct swg_dp_sh){ e->txbuf.pa, sizeof l->sh_tx / 4u, l->sh_tx };
+	swdp_ring_init(&l->r1, e->depth1);
+	memset(&l->flow, 0, sizeof l->flow);
+	swdp_book_init(&l->rxb, SWDP_RX_RID);
+	return 0;
+}
+
+/* read one ring-2 item (absolute k) and run the DP15 consume of it (index store + doorbell). 0 = ok, negative = stopped */
+static int
+swl25_r2_item(struct swg_wx *x, struct swl25 *l, uint8_t it[SWDP_ISZ_CTRL_CMPLT])
+{
+	struct swdp_store s[SWDP_MAX_STORES];
+	uint32_t n;
+	int ex;
+
+	ex = swg_d4d_r2(x, x->d4rd, it);
+	if (ex != 0) {
+		return ex;
+	}
+	ex = swdp_d2h_check(it, SWDP_ISZ_CTRL_CMPLT, x->d4rd + SWDP_EPOCH_INIT);        /* ring-2 item k carries epoch (254 + k) % 253 (gd_put, swdp_ring seq) */
+	if (ex != 0) {
+		printf("WIFI GAP: L25 ring-2 item %u refused: check code %d (epoch/size/xor)\n", x->d4rd, ex);
+		swl_gap("l25", "ring-2 item check failed", "high");
+		x->d4dstop = 1u;
+		return -SWG_E_ORDER;
+	}
+	l->env.wr0 = x->d4wr;
+	n = swdp_plan_consume(&l->env, 2u, (x->d4rd + 1u) % SWG_R2_DEPTH, s);
+	return swg_dp_exec(x, &l->env, s, n, "consume ring 2", 0);
+}
+
+/* DP1: flow-ring create (ring-0 post through DP15), wait for CREATE_CMPLT on ring 2 (<= SWL25_CREATE_MS), swdp_flow_on_create_cmpl. 0 = ok or soft stop (flow.st says which) */
+static int
+swl25_flow(struct swg_wx *x, struct swl25 *l, const uint8_t da[6])
+{
+	struct swdp_store s[SWDP_MAX_STORES];
+	struct swdp_cmpl c;
+	uint8_t it[SWDP_ISZ_CTRL_SUB], cmp[SWDP_ISZ_CTRL_CMPLT];
+	uint32_t slot = x->d4wr, nwr = swg_r0_next(x), w = 0u, waited = 0u, n;
+	uint8_t ep = swg_ep0(x);       /* sprint 2026-11-08: the absolute ring-0 count, the slot wraps */
+	int ex;
+
+	if (swdp_flow_begin(&l->flow, l->env.flowid, l->env.max_sub, l->env.depth_flow, l->env.flow_isz) != 0) {
+		return swl25_refuse(x, "flow create refused by the books");
+	}
+	if (swdp_build_flow_create(it, ep, 0u, l->env.flowid, 0u, da, l->mac, l->env.flow.pa, l->env.depth_flow, l->env.flow_isz) != 0) {
+		return swl25_refuse(x, "flow create item not buildable");
+	}
+	l->env.wr0 = x->d4wr;
+	n = swdp_plan_flow_create(&l->env, slot, nwr, it, s);
+	ex = swg_dp_exec(x, &l->env, s, n, "flow create", 0);
+	if (ex != 0 || x->d4dstop) {
+		return ex;
+	}
+	ex = swg_d4d_waitn(x, 1u, SWL25_CREATE_MS / SWG_POLL_MS, &w, &waited);
+	if (ex != 0) {
+		return ex;
+	}
+	if (w <= x->d4rd) {
+		printf("WIFI GAP: L25 flow create: no CREATE_CMPLT in %u ms\n", waited);
+		swl_gap("l25", "flow create not answered", "high");
+		x->d4dstop = 1u;
+		return 0;
+	}
+	ex = swl25_r2_item(x, l, cmp);
+	if (ex != 0 || x->d4dstop) {
+		return ex;
+	}
+	if (swdp_parse_flow_cmpl(cmp, &c) != 0 || swdp_flow_on_create_cmpl(&l->flow, &c) != 0) {
+		printf("WIFI GAP: L25 flow create refused by the dongle (type %u status %d)\n", c.type, (int)(int16_t)c.status);
+		swl_gap("l25", "flow create refused", "high");
+		x->d4dstop = 1u;
+		return 0;
+	}
+	l->env.flow_open = 1u;
+	return 0;
+}
+
+/* DP3: SWL25_RXPOSTS rx buffer posts on ring 1 (one DP15 plan each; request id from the book). 0 = ok or soft stop */
+static int
+swl25_rxposts(struct swg_wx *x, struct swl25 *l)
+{
+	struct swdp_store s[SWDP_MAX_STORES];
+	uint8_t it[SWDP_ISZ_RXPOST], ep;
+	uint32_t i, slot, rid, n;
+	int ex;
+	char nm[24];
+
+	for (i = 0; i < SWL25_RXPOSTS; i++) {
+		if (l->r1.wr >= SWL25_R1_SHADOW) {
+			return swl25_refuse(x, "rx post: the ring-1 shadow (256 posts) is used up");
+		}
+		rid = swdp_book_take(&l->rxb, SWL25_BUF_SZ);
+		if (rid == 0u || swdp_ring_post(&l->r1, &slot, &ep) != 0) {
+			return swl25_refuse(x, "rx post: no free request id or ring 1 full");
+		}
+		if (swdp_build_rxpost(it, ep, rid, l->env.rxbuf.pa + (uint64_t)(rid - SWDP_RX_RID) * SWL25_BUF_SZ, SWL25_BUF_SZ) != 0) {
+			return swl25_refuse(x, "rx post item not buildable");
+		}
+		l->env.wr1 = slot;
+		n = swdp_plan_post(&l->env, SWDP_RING_RXPOST, l->env.ring1.pa, SWDP_ISZ_RXPOST, slot, l->r1.wr, it, s);
+		snprintf(nm, sizeof nm, "rxpost %u", i);
+		ex = swg_dp_exec(x, &l->env, s, n, nm, 0);
+		if (ex != 0 || x->d4dstop) {
+			return ex;
+		}
+		l->env.wr1 = l->r1.wr;
+	}
+	printf("SWEET WLAN: L25 rx posts done: %u buffers on ring 1\n", SWL25_RXPOSTS);
+	return 0;
+}
+
+/* a refused rx re-post: loud gap, soft stop (0 with x->d4dstop) */
+static int
+swl25_rxgap(struct swg_wx *x, const char *why)
+{
+	swl_gap("l25", "L25 rx buffers: re-post refused", "high");
+	printf("WIFI GAP: L25 rx buffers: re-post refused: %s\n", why);
+	x->d4dstop = 1u;
+	return 0;
+}
+
+/* sprint 2026-11-08: re-post ONE rx buffer (the one its completion just freed in the book) at the next ring-1 slot, the same DP15 plan as the first posts. 0 = ok or soft stop (a refusal is a loud gap) */
+static int
+swl25_rxrepost(struct swg_wx *x, struct swl25 *l)
+{
+	struct swdp_store s[SWDP_MAX_STORES];
+	uint8_t it[SWDP_ISZ_RXPOST], ep;
+	uint32_t slot, rid, n;
+	int ex;
+
+	if (l->r1.wr >= SWL25_R1_SHADOW) {
+		return swl25_rxgap(x, "the ring-1 shadow (256 posts) is used up");
+	}
+	rid = swdp_book_take(&l->rxb, SWL25_BUF_SZ);
+	if (rid == 0u || swdp_ring_post(&l->r1, &slot, &ep) != 0) {
+		return swl25_rxgap(x, "no free request id or ring 1 full");
+	}
+	if (swdp_build_rxpost(it, ep, rid, l->env.rxbuf.pa + (uint64_t)(rid - SWDP_RX_RID) * SWL25_BUF_SZ, SWL25_BUF_SZ) != 0) {
+		return swl25_rxgap(x, "item not buildable");
+	}
+	l->env.wr1 = slot;
+	n = swdp_plan_post(&l->env, SWDP_RING_RXPOST, l->env.ring1.pa, SWDP_ISZ_RXPOST, slot, l->r1.wr, it, s);
+	ex = swg_dp_exec(x, &l->env, s, n, "rx re-post", 0);
+	if (ex != 0 || x->d4dstop) {
+		return ex;
+	}
+	l->env.wr1 = l->r1.wr;
+	return 0;
+}
+
+#endif /* SWEET_WLAN_L25_H */
diff --git a/bsd/dev/sweet_wlan_l25_hs.h b/bsd/dev/sweet_wlan_l25_hs.h
new file mode 100644
index 00000000..113b3d49
--- /dev/null
+++ b/bsd/dev/sweet_wlan_l25_hs.h
@@ -0,0 +1,2362 @@
+/*
+ * L25 host 4-way and L26 ping of the W-D4e engine (T-38cc; SPEC-WIFI Part E TRANSPORT block s.2): the poll loop over rings 2/3/4, rx completions -> swdp_net_rx -> swj_rx (H6),
+ * M2/M4 as tx posts (H7), the key installs H8-H10 after M4 has left, then the static-IP ARP + ICMP echo run (DP13). Every bus store goes through swg_dp_exec (DP15) or swg_e_call(_secret).
+ *
+ * Include order in the includer: sweet_wlan_data.h, sweet_wlan_join.h, sweet_wlan_g2.h, sweet_wlan_l25.h, then this file (g2.h's swg_e calls swl25_run, declared there).
+ * Limits of this slice, each printed when hit (rule 8): (1) the ring-1 shadow and the flow-ring shadow cover SWL25_SHADOW_ITEMS = 16 items, so the 16 rx buffers posted at L25 are NOT re-posted
+ * (an rx frame count above 16 ends the run with `WIFI GAP: L25 rx buffers exhausted`) and the 16 tx buffers are each used ONCE (TRANSPORT s.1 item 5 / ticket watch item: an all-ones old word
+ * would be a false DEAD stop); (2) time is the poll step counter (1 ms per step plus the bus delays), so an RTT is as coarse as the loop; (3) a second M1 / group rekey after the keys are
+ * installed is not handled (SWJ_GAP_X_REKEY) and the key material is wiped when the install is done. The run state is the file-scope swl25_H (BSS in the kernel, ~36 KB, not the stack).
+ */
+#ifndef SWEET_WLAN_L25_HS_H
+#define SWEET_WLAN_L25_HS_H
+
+#ifndef SWEET_WLAN_L25_H
+#error "sweet_wlan_l25_hs.h needs sweet_wlan_l25.h first"
+#endif
+#ifndef SWEET_WLAN_JOIN_H
+#error "sweet_wlan_l25_hs.h needs sweet_wlan_join.h"
+#endif
+
+#define SWL25_POLL_MS     1u            /* one poll step [TRANSPORT s.2: 1 ms steps] */
+#define SWL25_TXWAIT_MS   200u          /* wait for the M4 tx status before the key installs [decision, no source] */
+#define SWL25_PINGS       10u           /* echo requests of L26: W-PING asks 10/10 (sprint 2026-11-08, was 4); tx buffers: M2 + M4 + up to 3 ARP + 10 = 15 <= 16 (each used once in L25) */
+#define SWL25_PING_GAP_MS 1000u         /* between two echo requests [decision] */
+#define SWL25_ARP_TRIES   3u            /* ARP requests before the gateway is declared silent [decision] */
+#define SWL25_ARP_MS      1000u         /* wait after each ARP request [decision] */
+#define SWL25_TAIL_MS     2000u         /* wait for the last echo reply [decision] */
+#define SWL25_RXD_PER_PASS 8u           /* D2H items handled per ring per poll pass */
+
+/* ---- T-924f witness (W-JOIN L25, score 2: M1 x6, M2 x6, no M3): the dongle's own tx counters around the first M2 tell "frame dropped in the dongle" from "frame sent, AP did not answer".
+ * Request: WLC_GET_VAR "counters" (read-only, no argument; the bytes after the name are zero). Reply: wl_cnt_info_t {u16 version, u16 datalen} then, for version 30 (WL_CNT_VERSION_XTLV), XTLV tuples
+ * {u16 id, u16 len, data padded to 4 B}; tuple id 0x100 (WL_CNT_XTLV_WLC) holds wl_cnt_wlc_t [src refs wlan-stage5 wlioctl.h.new:4833-4841 (header), 4496-4508 (ids), 4896-5138 (struct), 6415-6716 (wl_cnt_ver_11_t)].
+ * Field offsets are NOT typed by hand: they are the offsetof() values of those two structs compiled with NFIFO 6 and NREINITREASONCOUNT 8 (wlioctl.h.new:4381, 4468) [obs 2026-11-07 host compile, T-924f]:
+ *   wl_cnt_wlc_t   (sizeof 864):  txframe 0, txnobuf 28, txnoassoc 32, txfail 200, txretry 204, txnoack 224, rxframe 60, fourwayfail 272
+ *   wl_cnt_ver_11_t (sizeof 1004, own layout after txfunfl[6]; the data starts after the 4 B header): txframe 4, txnobuf 32, txnoassoc 36, txfail 432, txretry 436, txnoack 456, rxframe 64, fourwayfail 504
+ * The longest reply is WL_XTLV_CNTBUF_MAX_SIZE = 4 + (4+864) + (4+256) + (4+24) = 1160 B [src wlioctl.h.new:4825-4828, mcst 64 u32, mcxst 6 u32]; the request asks for SWL25_CNT_LEN = 1200 B (in = out), inside the 1420 B payload
+ * shadow and the 8192 B response buffer (SWD_RESPBUF_LEN). DHD asks for WLC_IOCTL_MEDLEN 1936 [src wl_cfg80211.c.new:13975] which the shadow cannot carry; a reply the firmware cuts or refuses is a loud GAP below. */
+#define SWL25_CNT_LEN       1200u
+#define SWL25_CNT_SETTLE_MS 100u      /* wait after the first M2's tx status before the second read: the 802.11 retries of one frame end within it [decision, no source] */
+#define SWL25_CNT_VER_XTLV  30u
+#define SWL25_CNT_VER_11    11u
+#define SWL25_CNT_XTLV_WLC  0x100u
+enum { SWL25_CNT_TXFRAME, SWL25_CNT_TXNOBUF, SWL25_CNT_TXNOASSOC, SWL25_CNT_TXFAIL, SWL25_CNT_TXRETRY, SWL25_CNT_TXNOACK, SWL25_CNT_RXFRAME, SWL25_CNT_FOURWAYFAIL, SWL25_CNT_TXBYTE, SWL25_CNT_RXBYTE, SWL25_CNT_N };
+#define SWL25_CNT_PR SWL25_CNT_TXBYTE   /* the first 8 counters keep their T-924f log lines; the byte counters (T-8d5f) get their own line */
+static const uint16_t swl25_cnt_off_wlc[SWL25_CNT_N] = { 0u, 28u, 32u, 200u, 204u, 224u, 60u, 272u, 4u, 64u };   /* txbyte 4, rxbyte 64 [src wlioctl.h.new wl_cnt_wlc_t: txframe 0 then txbyte; rxbyte follows rxframe 60] */
+static const uint16_t swl25_cnt_off_v11[SWL25_CNT_N] = { 4u, 32u, 36u, 432u, 436u, 456u, 64u, 504u, 8u, 68u };   /* v11: txbyte follows txframe 4, rxbyte follows rxframe 64 [src wlioctl.h.new:6415-6441] */
+static const char *const swl25_cnt_name[SWL25_CNT_N] = { "txframe", "txnobuf", "txnoassoc", "txfail", "txretry", "txnoack", "rxframe", "fourwayfail", "txbyte", "rxbyte" };
+
+struct swl25h {
+	struct swl25 l;
+	struct swj_ctx sup;
+	struct swdp_net net;
+	struct swdp_ring r3, r4;        /* the D2H cursors of ring 3 (tx status) and ring 4 (rx complete) */
+	struct swdp_book txb;           /* tx buffers: taken once each, never released (see the header) */
+	uint32_t ms;                    /* poll-step clock */
+	uint32_t m4_rid, txdone;        /* request id of the M4 tx post (0 = none yet) and the bit mask of tx slots whose status was seen */
+	uint8_t want_keys, hs_done, last_msg;
+	uint32_t rx_frames, tx_posts, tx_status_bad;
+	uint32_t wit_rx, wit_tx;        /* T-73fc: EAPOL hex witnesses printed so far (swl25_witness) */
+	uint32_t wit_eth_rx, wit_eth_tx;  /* T-8d5f: Ethernet-header witnesses printed so far (swl25_witness_eth) */
+	uint32_t m2_rid;                /* T-924f: request id of the FIRST M2 tx post (0 = none yet), and the poll-step time its tx status was seen (m2_stat set) */
+	uint32_t m2_stat_ms;
+	uint32_t cnt0[SWL25_CNT_N];     /* T-924f: firmware tx counters read before the first M2 (valid when cnt0_ok) */
+	uint8_t cnt0_ok, m2_stat, cnt1_done;
+	uint32_t n_eapol_rx, n_m2;      /* EAPOL frames received / M2 posted so far (the counters lines name them) */
+	uint8_t arsne[64];              /* T-9d71: the RSNE of the association request the FIRMWARE sent (assoc_req_ies); arsne_len 0 = not read, M2 then carries the beacon RSNE (a printed gap) */
+	uint32_t arsne_len;
+	/* W-UI (sprint 2026-11-08): the live link as the FIRMWARE reports it after L26, for the Apple80211 kept link (never the join's .env SSID or the boot scan record). live_ok bits: 1 ssid (SSID element of the
+	 * association request the firmware sent, assoc_req_ies), 2 bssid (WLC_GET_BSSID), 4 chanspec ("chanspec" GET_VAR), 8 rssi (WLC_GET_RSSI). A bit clear = not read, a GAP was printed */
+	uint8_t live_ssid[32];
+	uint32_t live_ssid_len;
+	uint8_t live_bssid[6];
+	uint32_t live_chanspec, live_chan, live_ok;
+	int32_t live_rssi;
+};
+
+static void
+swl25_wipe(void *p, uint32_t n)
+{
+	volatile uint8_t *v = (volatile uint8_t *)p;
+	uint32_t i;
+
+	for (i = 0; i < n; i++) {
+		v[i] = 0u;
+	}
+	__asm__ volatile("" ::: "memory");
+}
+
+static int
+swl25_zero(const uint8_t *p, uint32_t n)
+{
+	uint32_t i, o = 0u;
+
+	for (i = 0; i < n; i++) {
+		o |= p[i];
+	}
+	return o == 0u;
+}
+
+/* soft stop with one GAP line: engine flag + `WIFI GAP: <what>` (area l25). Returns 0 so a caller can `return swl25_gap(...)`. */
+static int
+swl25_gap(struct swg_wx *x, const char *what)
+{
+	char gb[64];
+
+	snprintf(gb, sizeof gb, "%.60s", what);
+	swl_gap("l25", gb, "high");
+	printf("WIFI GAP: %s\n", what);
+	x->d4dstop = 1u;
+	return 0;
+}
+
+/* T-baed step 1: the station MAC from the firmware, a read-only GET_VAR cur_etheraddr (6 B) [src docs/research/108 s.2, BW bwfm.c:261]; the cfg MAC, when the glue gives one, must equal it.
+ * Needs the same response-buffer budget as one L22 GET_VAR (swg_e_call repost = 1). 0 with x->d4dstop clear = ok, mac filled; a GAP is printed and x->d4dstop set (return 0), or the bus stop code is returned */
+static int
+swl25_getmac(struct swg_wx *x, const uint8_t want[6], uint8_t mac[6])
+{
+	uint8_t rsp[8];
+	struct swd4b_ioctl_d2h cm;
+	int ex;
+
+	memset(rsp, 0, sizeof rsp);
+	memset(&cm, 0, sizeof cm);
+	ex = swg_e_call(x, SWD4B_WLC_GET_VAR, "WLC_GET_VAR cur_etheraddr", "cur_etheraddr", NULL, 6u, 14u + 6u, 1, 6u, rsp, 1, &cm, NULL);
+	if (ex != 0 || x->d4dstop) {
+		return ex;
+	}
+	if (cm.status != 0 || cm.resp_len < 6u) {
+		return swl25_gap(x, "L25 not run: cur_etheraddr get refused or the answer is not 6 bytes");
+	}
+	memcpy(mac, rsp, 6);
+	if (swl25_zero(mac, 6u) || (mac[0] & 1u) != 0u) {
+		return swl25_gap(x, "L25 not run: cur_etheraddr answer is zero or a multicast address");
+	}
+	if (!swl25_zero(want, 6u) && memcmp(want, mac, 6) != 0) {
+		return swl25_gap(x, "L25 not run: the station MAC from the glue differs from cur_etheraddr");
+	}
+	printf("SWEET WLAN: L25 station MAC read (cur_etheraddr, 6 bytes)\n");
+	return 0;
+}
+
+/* parse a counters reply of n bytes: 0 = filled out[] and *ver; -1 shorter than the 4 B header, -2 version neither 30 nor 11, -3 datalen above the reply, -4 no complete WLC tuple (xtlv) or reply shorter than the last field (v11) */
+static int
+swl25_cnt_parse(const uint8_t *r, uint32_t n, uint32_t out[SWL25_CNT_N], uint32_t *ver)
+{
+	const uint32_t v = n >= 4u ? (uint32_t)r[0] | (uint32_t)r[1] << 8 : 0u;
+	uint32_t dl, off, i, base = 0u, len = 0u;
+	const uint16_t *tab = swl25_cnt_off_wlc;
+
+	if (n < 4u) {
+		return -1;
+	}
+	*ver = v;
+	if (v == SWL25_CNT_VER_11) {
+		tab = swl25_cnt_off_v11;
+		base = 0u;
+		len = n;
+	} else if (v == SWL25_CNT_VER_XTLV) {
+		dl = (uint32_t)r[2] | (uint32_t)r[3] << 8;
+		if (dl > n - 4u) {
+			return -3;
+		}
+		for (off = 4u; off + 4u <= 4u + dl; ) {
+			const uint32_t id = (uint32_t)r[off] | (uint32_t)r[off + 1u] << 8, tl = (uint32_t)r[off + 2u] | (uint32_t)r[off + 3u] << 8;
+
+			if (off + 4u + tl > 4u + dl) {
+				return -4;
+			}
+			if (id == SWL25_CNT_XTLV_WLC) {
+				base = off + 4u;
+				len = tl;
+				break;
+			}
+			off += 4u + ((tl + 3u) & ~3u);
+		}
+		if (len == 0u) {
+			return -4;
+		}
+	} else {
+		return -2;
+	}
+	for (i = 0; i < SWL25_CNT_N; i++) {
+		const uint32_t o = base + tab[i];
+
+		if (v == SWL25_CNT_VER_11 ? o + 4u > len : (uint32_t)tab[i] + 4u > len) {
+			return -4;
+		}
+		out[i] = (uint32_t)r[o] | (uint32_t)r[o + 1u] << 8 | (uint32_t)r[o + 2u] << 16 | (uint32_t)r[o + 3u] << 24;
+	}
+	return 0;
+}
+
+/* the reading of the first-M2 deltas (docs/research/T-86b6-m2-cause.md s.4), all [guess] until the boot: the dongle dropped the frame (txframe +0, or txnobuf / txnoassoc +1) = "dongle-drop";
+ * on air but not acked (txnoack or txfail > 0) = "air-no-ack"; sent and acked, still no M3 = "acked-ap-silent" (the AP got it and rejected or ignored it) */
+static const char *
+swl25_cnt_cause(const uint32_t d[SWL25_CNT_N])
+{
+	if (d[SWL25_CNT_TXNOBUF] != 0u || d[SWL25_CNT_TXNOASSOC] != 0u || d[SWL25_CNT_TXFRAME] == 0u) {
+		return "dongle-drop";
+	}
+	if (d[SWL25_CNT_TXNOACK] != 0u || d[SWL25_CNT_TXFAIL] != 0u) {
+		return "air-no-ack";
+	}
+	return "acked-ap-silent";
+}
+
+static uint8_t swl25_cnt_rsp[SWL25_CNT_LEN + 4u];        /* file scope: no stack growth (the T-73fc overflow); +4 for the word-wise copy of the last bytes */
+
+/* one counters GET. Returns like swg_e_call (0 = done or soft stop with x->d4dstop, negative = the bus stopped); *ok = 1 when out[] is filled, 0 after a refused or unparsable reply (a GAP line, the run goes on: this is a witness) */
+static int
+swl25_cnt_read(struct swg_wx *x, uint32_t out[SWL25_CNT_N], const char *tag, int *ok)
+{
+	struct swd4b_ioctl_d2h cm;
+	uint32_t ver = 0u;
+	int ex, pr;
+
+	*ok = 0;
+	memset(swl25_cnt_rsp, 0, sizeof swl25_cnt_rsp);
+	memset(&cm, 0, sizeof cm);
+	ex = swg_e_call(x, SWD4B_WLC_GET_VAR, "WLC_GET_VAR counters", "counters", NULL, 0u, SWL25_CNT_LEN, 1, SWL25_CNT_LEN, swl25_cnt_rsp, 1, &cm, NULL);
+	if (ex != 0 || x->d4dstop) {
+		return ex;
+	}
+	if (cm.status != 0) {
+		printf("WIFI GAP: L25 counters read (%s) refused status=%d resp_len %u\n", tag, (int)cm.status, cm.resp_len);
+		swl_gap("l25", "counters read refused", "medium");
+		return 0;
+	}
+	pr = swl25_cnt_parse(swl25_cnt_rsp, cm.resp_len < SWL25_CNT_LEN ? cm.resp_len : SWL25_CNT_LEN, out, &ver);
+	if (pr != 0) {
+		printf("WIFI GAP: L25 counters read (%s) not parsed: code %d version %u resp_len %u (30 = xtlv, 11 = legacy)\n", tag, pr, ver, cm.resp_len);
+		swl_gap("l25", "counters reply not parsed", "medium");
+		return 0;
+	}
+	*ok = 1;
+	return 0;
+}
+
+/* log the named deltas of cur against base: one line, the numbers are the evidence, cause= is the [guess] reading */
+static void
+swl25_cnt_report(const char *tag, const uint32_t base[SWL25_CNT_N], const uint32_t cur[SWL25_CNT_N], uint32_t rx, uint32_t m2)
+{
+	uint32_t d[SWL25_CNT_N], i;
+
+	for (i = 0; i < SWL25_CNT_N; i++) {
+		d[i] = cur[i] - base[i];
+	}
+	printf("SWEET WLAN: L25 witness counters %s", tag);
+	for (i = 0; i < SWL25_CNT_PR; i++) {
+		printf(" d_%s=%u", swl25_cnt_name[i], d[i]);
+	}
+	printf(" (eapol_rx=%u m2_tx=%u) cause=%s\n", rx, m2, swl25_cnt_cause(d));
+	/* T-8d5f: on-air size witness. rxbyte over the M1s and txbyte over the M2s use the same counting convention, so tx_per_m2 - rx_per_m1 should equal the EAPOL size difference (M2 121 B - M1 99 B = 22) if the dongle sent every M2 whole [guess]; the absolute numbers are not interpreted alone */
+	printf("SWEET WLAN: L25 witness bytes %s d_txbyte=%u d_rxbyte=%u (m2_tx=%u eapol_rx=%u)\n", tag, d[SWL25_CNT_TXBYTE], d[SWL25_CNT_RXBYTE], m2, rx);
+}
+
+/* n bytes at pa of the DATA block (word reads through the bus, space SWG_SP_DATA). 0 = read, negative = stopped */
+static int
+swl25_dread(struct swg_wx *x, const struct swl25 *l, uint64_t pa, uint32_t n, uint8_t *out)
+{
+	const uint64_t a = pa & ~3ull;
+	const uint32_t lead = (uint32_t)(pa - a), nw = (lead + n + 3u) / 4u;
+	uint32_t k, b, v;
+
+	if (n == 0u || !swdp_in(&l->env.data, a, 4ull * nw)) {
+		x->fail = "an L25 data-block read outside the block";
+		return swg_stop(x, SWG_E_ADDR);
+	}
+	for (k = 0; k < nw; k++) {
+		if (x->b->rd(x->b->ctx, SWG_SP_DATA, (uint32_t)(a - l->env.data.pa) + 4u * k, &v)) {
+			x->fail = "an L25 data-block read failed";
+			return swg_stop(x, SWG_E_ADDR);
+		}
+		for (b = 0; b < 4u; b++) {
+			const uint32_t i = 4u * k + b;
+
+			if (i >= lead && i - lead < n) {
+				out[i - lead] = (uint8_t)(v >> (8u * b));
+			}
+		}
+	}
+	return 0;
+}
+
+/* item k of common ring ri (3 or 4) from the G1 block as bytes. 0 = read, negative = stopped */
+static int
+swl25_item(struct swg_wx *x, uint32_t ri, uint32_t k, uint32_t isz, uint8_t *out)
+{
+	uint32_t i, v;
+
+	for (i = 0; i < isz / 4u; i++) {
+		x->fail = "an L25 D2H item read failed";
+		if (swg_hrd(x, x->in.ring[ri] + (uint64_t)k * isz + 4u * i, &v)) {
+			return swg_stop(x, SWG_E_ADDR);
+		}
+		out[4u * i] = (uint8_t)v;
+		out[4u * i + 1u] = (uint8_t)(v >> 8);
+		out[4u * i + 2u] = (uint8_t)(v >> 16);
+		out[4u * i + 3u] = (uint8_t)(v >> 24);
+	}
+	return 0;
+}
+
+/* DP4: one frame (14 B Ethernet header + payload) as a tx post on the flow ring: payload store, item, WR slot, doorbell (swg_dp_exec). *rid_out = the request id. 0 = ok or soft stop */
+static int
+swl25_send(struct swg_wx *x, struct swl25h *h, const uint8_t *fr, uint32_t len, const char *what, uint32_t *rid_out)
+{
+	struct swdp_store s[SWDP_MAX_STORES];
+	uint8_t it[SWDP_ISZ_TX_EXT], ep;
+	char nm[24];
+	uint32_t rid, slot, n;
+	uint64_t txa;
+	int ex;
+
+	if (!h->l.env.flow_open) {
+		return swl25_gap(x, "L25 tx refused: flow ring not open");
+	}
+	rid = swdp_book_take(&h->txb, len);
+	if (rid == 0u || h->l.flow.ring.wr >= SWL25_SHADOW_ITEMS) {
+		return swl25_gap(x, "L25 tx buffers used up (each is used once per run; no shadow beyond 16 flow items)");
+	}
+	if (swdp_ring_post(&h->l.flow.ring, &slot, &ep) != 0) {
+		return swl25_gap(x, "L25 flow ring full");
+	}
+	txa = h->l.env.txbuf.pa + (uint64_t)(rid - SWDP_TX_RID) * SWL25_BUF_SZ;
+	if (swdp_build_txpost(it, h->l.env.flow_isz, 0u, rid, fr, len, 0u, txa) != 0) {
+		return swl25_gap(x, "L25 tx item not buildable (frame length)");
+	}
+	h->l.env.wrf = slot;
+	swg_hr(x, SWG_HR_L25S, "l25_send");
+	n = swdp_plan_tx(&h->l.env, txa, fr + SWDP_ETH_HLEN, len - SWDP_ETH_HLEN, slot, h->l.flow.ring.wr, it, s);
+	snprintf(nm, sizeof nm, "tx %.16s", what);
+	ex = swg_dp_exec(x, &h->l.env, s, n, nm, 0);
+	if (ex != 0 || x->d4dstop) {
+		return ex;
+	}
+	h->l.env.wrf = h->l.flow.ring.wr;
+	h->tx_posts++;
+	if (rid_out != NULL) {
+		*rid_out = rid;
+	}
+	printf("SWEET WLAN: tx %s payload %u B\n", what, len - SWDP_ETH_HLEN);
+	return 0;
+}
+
+/* consume the front item of D2H ring `ring` (3 or 4): the DP15 plan (RD slot + doorbell), then the host cursor. 0 = ok or soft stop */
+static int
+swl25_consume(struct swg_wx *x, struct swl25h *h, uint32_t ring)
+{
+	struct swdp_store s[SWDP_MAX_STORES];
+	struct swdp_ring *r = ring == 3u ? &h->r3 : &h->r4;
+	uint32_t n;
+	int ex;
+
+	h->l.env.rd_d2h[ring - 2u] = r->rd;
+	n = swdp_plan_consume(&h->l.env, ring, (r->rd + 1u) % r->depth, s);
+	ex = swg_dp_exec(x, &h->l.env, s, n, ring == 3u ? "consume ring 3" : "consume ring 4", 0);
+	if (ex != 0 || x->d4dstop) {
+		return ex;
+	}
+	(void)swdp_d2h_consume(r);
+	return 0;
+}
+
+/* T-73fc witness (W-JOIN L25, the AP never answers M2 with M3): the first SWL25_WIT_MAX EAPOL frames each way are logged as hex from the EAPOL header on (no Ethernet header, so no MAC address). On the air
+ * these bytes are public (nonces, replay counter, MIC, RSNE); they hold no PSK, PMK, PTK or MAC [read from source: swj_rx/swj_ctx fields]. An offline recompute of the M2 MIC from the PSK on the host
+ * (never in the repo) tells a MIC bug from an RSNE or PSK mismatch. File-scope buffer: no stack growth on the eapol path (the T-73fc stack overflow). */
+#define SWL25_WIT_MAX 8u      /* T-924f: 3 -> 8 so the 2nd M1 batch (boot 20261107T213158Z: 3 + 3 after a 5 s gap) shows its replay counter and nonce; 8 x (header + 2 hex lines) per direction */
+#define SWL25_WIT_BYTES 160u
+#define SWL25_WIT_CHUNK 56u   /* bytes per log line: the USB log cuts a line near 250 chars (boot 20261107T201747Z: the 121 B tx frame was cut at 107 B) */
+static char swl25_wit_buf[2u * SWL25_WIT_CHUNK + 1u];
+
+/* hex of buf[0..len) in lines of SWL25_WIT_CHUNK bytes: "SWEET WLAN: L25 witness <what> part <k>: <hex>" */
+static void
+swl25_hexlines(const char *what, const uint8_t *buf, uint32_t len)
+{
+	uint32_t i, off, k = 0u, n;
+
+	for (off = 0u; off < len; off += n, k++) {
+		n = len - off < SWL25_WIT_CHUNK ? len - off : SWL25_WIT_CHUNK;
+		for (i = 0; i < n; i++) {
+			snprintf(swl25_wit_buf + 2u * i, 3u, "%02x", buf[off + i]);
+		}
+		printf("SWEET WLAN: L25 witness %s part %u: %s\n", what, k, swl25_wit_buf);
+	}
+}
+
+static void
+swl25_witness(const char *what, uint32_t *cnt, const uint8_t *eapol, uint32_t len)
+{
+	uint32_t n = len < SWL25_WIT_BYTES ? len : SWL25_WIT_BYTES;
+
+	if (*cnt >= SWL25_WIT_MAX) {
+		return;
+	}
+	(*cnt)++;
+	printf("SWEET WLAN: L25 witness %s %u B (frame %u)%s\n", what, len, *cnt, len > n ? " (cut)" : "");
+	swl25_hexlines(what, eapol, n);
+}
+
+/* once per boot: station MAC (SPA) and BSSID (AA) used for the PTK, the RSNE sent in M2 (assoc) and the beacon RSNE; all public on the air, no key material [read from source: swl25_cfg, swj_ctx_init] */
+static void
+swl25_witness_ctx(const struct swl25_cfg *c, const uint8_t mac[6])
+{
+	printf("SWEET WLAN: L25 witness addr spa=%02x:%02x:%02x:%02x:%02x:%02x aa=%02x:%02x:%02x:%02x:%02x:%02x\n",
+	    mac[0], mac[1], mac[2], mac[3], mac[4], mac[5], c->bssid[0], c->bssid[1], c->bssid[2], c->bssid[3], c->bssid[4], c->bssid[5]);
+	printf("SWEET WLAN: L25 witness rsne_assoc %u B\n", (unsigned)c->rsne_assoc_len);
+	swl25_hexlines("rsne_assoc", c->rsne_assoc, c->rsne_assoc_len);
+	printf("SWEET WLAN: L25 witness rsne_beacon %u B\n", (unsigned)c->rsne_beacon_len);
+	swl25_hexlines("rsne_beacon", c->rsne_beacon, c->rsne_beacon_len);
+}
+
+/* T-8d5f witness (W-JOIN H-sa, the AP acks every M2 and never answers): the 14 B Ethernet header of the first SWL25_WIT_MAX EAPOL frames each way, with the verdict against the addresses the
+ * PTK was derived from. An rx M1 must carry DA = our SPA (the address the AP used for us, = the cur_etheraddr the shim read) and SA = the BSSID (AA); a tx M2 the reverse. A DA that is not our SPA
+ * means the AP derived the PTK from another station address (H-sa) [read from source: swj_eth_wrap, swj_rx]. Log only, no key material; the addresses are on the air, the same as the `witness addr` line. */
+static void
+swl25_witness_eth(const char *what, uint32_t *cnt, const uint8_t *fr, uint32_t len, const uint8_t dst[6], const uint8_t src[6])
+{
+	if (*cnt >= SWL25_WIT_MAX || len < SWDP_ETH_HLEN) {
+		return;
+	}
+	(*cnt)++;
+	printf("SWEET WLAN: L25 witness eth %s da=%02x:%02x:%02x:%02x:%02x:%02x sa=%02x:%02x:%02x:%02x:%02x:%02x type=%02x%02x dst_ok=%u src_ok=%u (frame %u)\n", what,
+	    fr[0], fr[1], fr[2], fr[3], fr[4], fr[5], fr[6], fr[7], fr[8], fr[9], fr[10], fr[11], fr[12], fr[13],
+	    (unsigned)(memcmp(fr, dst, 6) == 0), (unsigned)(memcmp(fr + 6, src, 6) == 0), *cnt);
+}
+
+/* H6/H7/DP14 for one received Ethernet frame. 0 = ok or soft stop */
+static int
+swl25_frame(struct swg_wx *x, struct swl25h *h, const uint8_t *f, uint32_t len)
+{
+	uint8_t out[SWDP_OUT_MAX], eo[SWJ_TX_MAX];
+	uint32_t olen = 0u, seq = 0u, rtt = 0u, rid = 0u;
+	int r, ex;
+
+	switch (swdp_net_rx(&h->net, f, len, (uint64_t)h->ms * 1000u, out, sizeof out, &olen, &seq, &rtt)) {
+	case SWDP_RX_REPLY:
+		return swl25_send(x, h, out, olen, "reply", NULL);
+	case SWDP_RX_PING_REPLY:
+		printf("SWEET WLAN: ping reply seq=%u rtt_us=%u\n", seq, rtt);
+		return 0;
+	case SWDP_RX_EAPOL:
+		if (h->hs_done) {
+			printf("%s\n", SWJ_GAP_X_REKEY);
+			swl_gap("l25", "eapol after the keys were installed, ignored", "medium");
+			return 0;
+		}
+		r = swj_rx(&h->sup, f, len, eo, sizeof eo, &olen);
+		h->n_eapol_rx++;       /* T-924f: EAPOL frames received (M1 until M3 arrives; the end line names it) */
+		swl25_witness_eth("rx", &h->wit_eth_rx, f, len, h->sup.spa, h->sup.aa);
+		if (len > SWDP_ETH_HLEN) {
+			swl25_witness("eapol rx", &h->wit_rx, f + SWDP_ETH_HLEN, len - SWDP_ETH_HLEN);
+		}
+		if (r != SWJ_RX_REPLY) {
+			return 0;
+		}
+		swl25_witness_eth("tx", &h->wit_eth_tx, eo, olen, h->sup.aa, h->sup.spa);
+		if (olen > SWDP_ETH_HLEN) {
+			swl25_witness("eapol tx", &h->wit_tx, eo + SWDP_ETH_HLEN, olen - SWDP_ETH_HLEN);
+		}
+		h->last_msg = h->sup.install_ptk ? 4u : 2u;
+		ex = swl25_send(x, h, eo, olen, h->last_msg == 4u ? "eapol msg 4" : "eapol msg 2", &rid);
+		if (ex != 0 || x->d4dstop) {
+			return ex;
+		}
+		if (h->last_msg == 2u) {
+			h->n_m2++;
+			if (h->m2_rid == 0u) {
+				h->m2_rid = rid;       /* T-924f: the FIRST M2; its tx status starts the settle clock of the counters read */
+			}
+		}
+		if (h->sup.install_ptk && h->sup.install_gtk) {
+			h->m4_rid = rid;
+			h->want_keys = 1u;
+		}
+		return 0;
+	default:
+		return 0;
+	}
+}
+
+/* T-73fc (W-JOIN L25: stack overflow on the eapol tx path): the received-frame copy (2048 B) is file-scope BSS, not a stack array; one swl25_d2h runs at a time (single hook thread) */
+static uint8_t swl25_fr[SWL25_BUF_SZ];
+
+/* ring 3 (tx status) or 4 (rx complete): up to SWL25_RXD_PER_PASS items. 0 = ok or soft stop, negative = stopped */
+static int
+swl25_d2h(struct swg_wx *x, struct swl25h *h, uint32_t ring)
+{
+	const uint32_t isz = ring == 3u ? SWDP_ISZ_TX_CMPLT : SWDP_ISZ_RX_CMPLT;
+	struct swdp_ring *r = ring == 3u ? &h->r3 : &h->r4;
+	uint8_t it[SWDP_ISZ_RX_CMPLT], *fr = swl25_fr;
+	struct swdp_cmpl c;
+	uint32_t v = 0u, done = 0u, len, idx;
+	int pend, ex;
+
+	swg_hr(x, SWG_HR_L25D, "l25_d2h");
+	x->fail = "an L25 D2H write-index read failed";
+	if (swg_hrd(x, x->in.idx[SWG_IDX(SWD_IDX_D2H_W)] + 4ull * (ring - 2u), &v)) {
+		return swg_stop(x, SWG_E_ADDR);
+	}
+	if (v == 0xFFFFFFFFu) {
+		x->fail = "an L25 D2H write index reads all ones (dead link)";
+		return swg_stop(x, SWG_E_DEAD);
+	}
+	while (done < SWL25_RXD_PER_PASS) {
+		pend = swdp_d2h_pending(r, v);
+		if (pend < 0) {
+			printf("WIFI GAP: L25 ring %u write index %u outside the ring\n", ring, v & 0xFFFFu);
+			return swl25_gap(x, "L25 D2H write index corrupt");
+		}
+		if (pend == 0) {
+			return 0;
+		}
+		ex = swl25_item(x, ring, r->rd, isz, it);
+		if (ex != 0) {
+			return ex;
+		}
+		ex = swdp_d2h_check(it, isz, r->seq);
+		if (ex != 0) {
+			printf("WIFI GAP: L25 ring %u item %u refused: check code %d (epoch/size/xor)\n", ring, r->rd, ex);
+			return swl25_gap(x, "L25 D2H item check failed");
+		}
+		if (ring == 3u) {
+			ex = swdp_parse_txstatus(it, &c);
+			idx = c.rid - SWDP_TX_RID;
+			if (ex != 0 || c.rid < SWDP_TX_RID || idx >= SWDP_NSLOT || !h->txb.used[idx] || (h->txdone & (1u << idx)) != 0u) {
+				printf("WIFI GAP: L25 tx status for an unknown or repeated request id (code %d)\n", ex);
+				return swl25_gap(x, "L25 tx status id not in flight");
+			}
+			h->txdone |= 1u << idx;
+			if (c.rid == h->m2_rid && !h->m2_stat) {
+				h->m2_stat = 1u;
+				h->m2_stat_ms = h->ms;
+			}
+			if ((int16_t)c.status != 0 || c.tx_status != 0u) {
+				h->tx_status_bad++;
+				printf("WIFI GAP: L25 tx status error status=%d tx_status=%u\n", (int)(int16_t)c.status, c.tx_status);
+				swl_gap("l25", "tx status error", "medium");
+			}
+		} else {
+			ex = swdp_parse_rxcmpl(it, SWL25_BUF_SZ, x->rxoff, &c);
+			idx = c.rid - SWDP_RX_RID;
+			if (ex != 0 || c.rid < SWDP_RX_RID || idx >= SWDP_NSLOT || swdp_book_done(&h->l.rxb, c.rid, &len) != 0) {
+				printf("WIFI GAP: L25 rx completion refused: code %d\n", ex);
+				return swl25_gap(x, "L25 rx completion refused");
+			}
+			ex = swl25_dread(x, &h->l, h->l.env.rxbuf.pa + (uint64_t)idx * SWL25_BUF_SZ + c.data_offset, c.data_len, fr);
+			if (ex != 0) {
+				return ex;
+			}
+			h->rx_frames++;
+			ex = swl25_frame(x, h, fr, c.data_len);
+			if (ex != 0 || x->d4dstop) {
+				return ex;
+			}
+		}
+		ex = swl25_consume(x, h, ring);
+		if (ex != 0 || x->d4dstop) {
+			return ex;
+		}
+		if (ring == 4u) {
+			ex = swl25_rxrepost(x, &h->l);         /* sprint 2026-11-08: the buffer of this completion goes back on ring 1 (run join26c: 16 buffers, 5 LAN broadcasts, exhausted after echo 7) */
+			if (ex != 0 || x->d4dstop) {
+				return ex;
+			}
+		}
+		done++;
+		if (ring == 4u && h->l.rxb.inflight == 0u) {
+			return swl25_gap(x, "L25 rx buffers exhausted (no re-post in this slice)");
+		}
+	}
+	return 0;
+}
+
+/* one poll pass: ring 2 (events, DS), ring 4, ring 3, then one 1 ms step. 0 = ok or soft stop, negative = stopped */
+static int
+swl25_pass(struct swg_wx *x, struct swl25h *h)
+{
+	int ex = swg_e_idle(x);
+
+	if (ex != 0 || x->d4dstop) {
+		return ex;
+	}
+	ex = swl25_d2h(x, h, 4u);
+	if (ex != 0 || x->d4dstop) {
+		return ex;
+	}
+	ex = swl25_d2h(x, h, 3u);
+	if (ex != 0 || x->d4dstop) {
+		return ex;
+	}
+	if (h->cnt0_ok && h->m2_stat && !h->cnt1_done && h->ms - h->m2_stat_ms >= SWL25_CNT_SETTLE_MS) {
+		uint32_t cur[SWL25_CNT_N];
+		int ok;
+
+		h->cnt1_done = 1u;      /* once: T-924f, the counters SETTLE ms after the first M2's tx status (its retries are over), top level of the poll, not inside a D2H item */
+		ex = swl25_cnt_read(x, cur, "first-m2", &ok);
+		if (ex != 0 || x->d4dstop) {
+			return ex;
+		}
+		if (ok) {
+			swl25_cnt_report("first-m2", h->cnt0, cur, h->n_eapol_rx, h->n_m2);
+		}
+	}
+	x->b->delay_ms(x->b->ctx, SWL25_POLL_MS);
+	h->ms += SWL25_POLL_MS;
+	return 0;
+}
+
+/* poll for `ms` steps; stops early when *flag becomes non-zero (flag may be NULL). */
+static int
+swl25_poll(struct swg_wx *x, struct swl25h *h, uint32_t ms, const uint8_t *flag)
+{
+	const uint32_t t0 = h->ms;
+	int ex;
+
+	while (h->ms - t0 < ms && (flag == NULL || *flag == 0u)) {
+		ex = swl25_pass(x, h);
+		if (ex != 0 || x->d4dstop) {
+			return ex;
+		}
+	}
+	return 0;
+}
+
+/* one SET_VAR wsec_key of kb (secret): 0 = done or soft stop (a refused status stops the engine with the GAP, x->d4dstop), negative = stopped */
+static int
+swl25_setkey(struct swg_wx *x, uint8_t kb[SWJ_WSEC_KEY_SIZE], const char *row, const char *kind)
+{
+	struct swd4b_ioctl_d2h cm;
+	char what[48];
+	int ex;
+
+	ex = swg_e_call_secret(x, SWD4B_WLC_SET_VAR, "WLC_SET_VAR wsec_key", "wsec_key", kb, SWJ_WSEC_KEY_SIZE, 9u + SWJ_WSEC_KEY_SIZE, 1, 0u, NULL, 1, &cm);
+	swl25_wipe(kb, SWJ_WSEC_KEY_SIZE);
+	if (ex != 0 || x->d4dstop) {
+		return ex;
+	}
+	if (cm.status != 0) {
+		snprintf(what, sizeof what, "wsec_key %s refused status=%d", kind, (int)cm.status);
+		SWG_J_STOP(x, row, "%.60s", what);
+		return 0;
+	}
+	return 0;
+}
+
+/* H8 pairwise, H9 group, H10 wsec merge, after the M4 tx status (or the SWL25_TXWAIT_MS timeout, a GAP). 0 = done or soft stop, negative = stopped */
+static int
+swl25_keys(struct swg_wx *x, struct swl25h *h)
+{
+	uint8_t kb[SWJ_WSEC_KEY_SIZE], rsp[4], buf[16];
+	struct swd4b_ioctl_d2h cm;
+	uint32_t cur, nl, idx = h->m4_rid - SWDP_TX_RID;
+	int ex;
+
+	if (idx < SWDP_NSLOT && (h->txdone & (1u << idx)) == 0u) {
+		uint8_t seen = 0u;
+		uint32_t t0 = h->ms;
+
+		while (h->ms - t0 < SWL25_TXWAIT_MS && !seen) {
+			ex = swl25_pass(x, h);
+			if (ex != 0 || x->d4dstop) {
+				return ex;
+			}
+			seen = (h->txdone & (1u << idx)) != 0u;
+		}
+		if (!seen) {
+			printf("WIFI GAP: L25 M4 tx status not seen in %u ms, keys installed anyway\n", SWL25_TXWAIT_MS);
+			swl_gap("l25", "M4 tx status not seen", "medium");
+		}
+	}
+	if (swj_wsec_key_pairwise(&h->sup, kb) != 0) {
+		return swl25_gap(x, "H8 pairwise key not buildable");
+	}
+	ex = swl25_setkey(x, kb, "H8", "pairwise");
+	if (ex != 0 || x->d4dstop) {
+		return ex;
+	}
+	printf("SWEET WLAN: wsec_key pairwise set ok\n");
+	if (swj_wsec_key_group(&h->sup, kb) != 0) {
+		return swl25_gap(x, "H9 group key not buildable");
+	}
+	ex = swl25_setkey(x, kb, "H9", "group");
+	if (ex != 0 || x->d4dstop) {
+		return ex;
+	}
+	printf("SWEET WLAN: wsec_key group set ok idx=%u\n", (unsigned)h->sup.gtk_id);
+	ex = swg_e_call(x, SWD4B_WLC_GET_VAR, "WLC_GET_VAR wsec", "wsec", NULL, 4u, 5u + 4u, 1, 4u, rsp, 1, &cm, NULL);
+	if (ex != 0 || x->d4dstop) {
+		return ex;
+	}
+	if (cm.status != 0) {
+		SWG_J_STOP(x, "H10", "wsec get refused status=%d", (int)cm.status);
+		return 0;
+	}
+	cur = (uint32_t)rsp[0] | (uint32_t)rsp[1] << 8 | (uint32_t)rsp[2] << 16 | (uint32_t)rsp[3] << 24;
+	nl = swj_var_u32(buf, sizeof buf, "wsec", swj_wsec_merge(cur, SWJ_WSEC_AES));
+	if (nl == 0u) {
+		return swl25_gap(x, "H10 wsec payload not buildable");
+	}
+	ex = swg_e_call(x, SWD4B_WLC_SET_VAR, "WLC_SET_VAR wsec", "wsec", buf + 5, 4u, nl, 1, 0u, NULL, 1, &cm, NULL);
+	if (ex != 0 || x->d4dstop) {
+		return ex;
+	}
+	if (cm.status != 0) {
+		SWG_J_STOP(x, "H10", "wsec set refused status=%d", (int)cm.status);
+		return 0;
+	}
+	printf("SWEET WLAN: wsec merged ok\n");
+	printf("%s\n", SWJ_GAP_H11);
+	swl_gap("H11", "WLC_SCB_AUTHORIZE not issued", "medium");
+	swl25_wipe(h->sup.tptk, sizeof h->sup.tptk);       /* the keys are in the dongle now; rekeys are not handled (SWJ_GAP_X_REKEY) */
+	swl25_wipe(h->sup.gtk, sizeof h->sup.gtk);
+	swl25_wipe(h->sup.pmk, sizeof h->sup.pmk);
+	h->sup.install_ptk = h->sup.install_gtk = 0;
+	h->hs_done = 1u;
+	return 0;
+}
+
+/* L25 phase: poll until the keys are installed, at most SWG_J_BUDGET_MS. 0 = done or soft stop, negative = stopped */
+static int
+swl25_4way(struct swg_wx *x, struct swl25h *h)
+{
+	const uint32_t t0 = h->ms;
+	uint32_t cur[SWL25_CNT_N];
+	int ex, ok;
+
+	ex = swl25_cnt_read(x, h->cnt0, "base", &ok);     /* T-924f: before the first M1 can arrive, so the deltas below start at the M2 (no frame of ours went out since the flow create) */
+	if (ex != 0 || x->d4dstop) {
+		return ex;
+	}
+	h->cnt0_ok = (uint8_t)ok;
+	if (ok) {
+		printf("SWEET WLAN: L25 witness counters base %s=%u %s=%u %s=%u %s=%u %s=%u %s=%u %s=%u %s=%u\n", swl25_cnt_name[0], h->cnt0[0], swl25_cnt_name[1], h->cnt0[1], swl25_cnt_name[2], h->cnt0[2],
+		    swl25_cnt_name[3], h->cnt0[3], swl25_cnt_name[4], h->cnt0[4], swl25_cnt_name[5], h->cnt0[5], swl25_cnt_name[6], h->cnt0[6], swl25_cnt_name[7], h->cnt0[7]);
+		printf("SWEET WLAN: L25 witness bytes base txbyte=%u rxbyte=%u\n", h->cnt0[SWL25_CNT_TXBYTE], h->cnt0[SWL25_CNT_RXBYTE]);
+	}
+	while (h->ms - t0 < SWG_J_BUDGET_MS) {
+		ex = swl25_pass(x, h);
+		if (ex != 0 || x->d4dstop) {
+			return ex;
+		}
+		if (h->want_keys && !h->hs_done) {
+			ex = swl25_keys(x, h);
+			if (ex != 0 || x->d4dstop) {
+				return ex;
+			}
+		}
+		if (h->hs_done) {
+			return 0;
+		}
+	}
+	if (h->cnt0_ok) {      /* T-924f: the cumulative deltas over every M2 of the run, before the gap stops the engine */
+		ex = swl25_cnt_read(x, cur, "end", &ok);
+		if (ex != 0) {
+			return ex;
+		}
+		if (ok && !x->d4dstop) {
+			swl25_cnt_report("end", h->cnt0, cur, h->n_eapol_rx, h->n_m2);
+		}
+	}
+	printf("WIFI GAP: H12 4way not complete after %u ms (last message seen: %s)\n", h->ms - t0,
+	    h->sup.state == SWJ_IDLE ? "none, no M1" : (h->sup.state == SWJ_M2_SENT ? "M1, M2 sent, no M3" : "M3"));
+	swl_gap("H12", "4way not complete", "high");
+	x->d4dstop = 1u;
+	return 0;
+}
+
+/* L26 (DP13): ARP the gateway, SWL25_PINGS echo requests, the summary line. 0 = done or soft stop (the summary is printed in every case), negative = stopped */
+static int
+swl25_ping(struct swg_wx *x, struct swl25h *h)
+{
+	uint8_t f[SWDP_ETH_MAXFRAME];
+	uint32_t i, len, t0;
+	int ex = 0;
+
+	for (i = 0; i < SWL25_ARP_TRIES && !h->net.gw_known; i++) {
+		len = swdp_build_arp_req(&h->net, f);
+		ex = swl25_send(x, h, f, len, "arp request", NULL);
+		if (ex != 0 || x->d4dstop) {
+			break;
+		}
+		for (t0 = h->ms; h->ms - t0 < SWL25_ARP_MS && !h->net.gw_known && ex == 0 && !x->d4dstop;) {
+			ex = swl25_pass(x, h);
+		}
+		if (ex != 0 || x->d4dstop) {
+			break;
+		}
+	}
+	if (ex == 0 && !x->d4dstop && !h->net.gw_known) {
+		printf("WIFI GAP: DP13 gateway did not answer %u ARP requests\n", SWL25_ARP_TRIES);
+		swl_gap("DP13", "gateway ARP unanswered", "high");
+		x->d4dstop = 1u;
+	}
+	for (i = 0; ex == 0 && !x->d4dstop && i < SWL25_PINGS; i++) {
+		len = swdp_build_echo_req(&h->net, f, (uint64_t)h->ms * 1000u);
+		if (len == 0u) {
+			ex = swl25_gap(x, "L26 echo request not buildable");
+			break;
+		}
+		ex = swl25_send(x, h, f, len, "echo request", NULL);
+		if (ex != 0 || x->d4dstop) {
+			break;
+		}
+		ex = swl25_poll(x, h, SWL25_PING_GAP_MS, NULL);
+	}
+	if (ex == 0 && !x->d4dstop) {
+		for (t0 = h->ms; h->ms - t0 < SWL25_TAIL_MS && h->net.got < h->net.sent && ex == 0 && !x->d4dstop;) {
+			ex = swl25_pass(x, h);
+		}
+	}
+	swdp_ping_summary(&h->net);
+	return ex;
+}
+
+static void swl25_rsne_report(const struct swl25h *h);
+
+/* the run: called by swg_e after a finished L24 (link up). 0 = done or soft stop; negative = stopped */
+static int swl25_live(struct swg_wx *x, struct swl25h *h);   /* W-UI, below: the live link after L26 */
+static int swl25_probe_wifi(struct swg_wx *x, const char *at);   /* LOWCLK B3 (patch 0363), below */
+static uint32_t swl25_probe_arm;                                /* ditto: bit 0 P1 due, bit 1 P2 due */
+
+static int
+swl25_go(struct swg_wx *x, unsigned lv, struct swl25h *h)
+{
+	const struct swl25_cfg *c = x->l25c;
+	uint8_t mac[6];
+	int ex;
+
+	if (c == NULL) {
+		return swl25_gap(x, "L25 not run: no join context (the glue delivers no station MAC, BSSID, PMK, RSNE or addresses yet)");
+	}
+	/* patch 0281: ip == 0 AND gw == 0 is a DHCP credential blob (mkwlancred --net 2 without ip/gw, docs/research/W-D6-rejoin-dhcp.md s.5): the join and the 4-way run as before, only L26 (the static ARP/ping) is skipped.
+	 * Exactly one of the two zero stays refused: that is a half-filled blob, not DHCP. */
+	if ((c->mac[0] & 1u) != 0u || swl25_zero(c->bssid, 6u) || swl25_zero(c->ip, 4u) != swl25_zero(c->gw, 4u)) {
+		return swl25_gap(x, "L25 not run: station MAC, BSSID, IP or gateway missing or invalid");
+	}
+	ex = swl25_getmac(x, c->mac, mac);        /* T-baed step 1: cfg.mac all zero = take the firmware's; non-zero must match */
+	if (ex != 0 || x->d4dstop) {
+		return ex;
+	}
+	if ((swl25_probe_arm & 1u) != 0u) {       /* LOWCLK B3 P1 (patch 0363): sweetprobe=1 only, once */
+		swl25_probe_arm &= ~1u;
+		ex = swl25_probe_wifi(x, "l25start");
+		if (ex != 0 || x->d4dstop) {
+			return ex;
+		}
+	}
+	memcpy(h->l.mac, mac, 6);
+	memcpy(h->l.gwmac, c->bssid, 6);
+	if (swd_rings[3].isz != SWDP_ISZ_TX_CMPLT || swd_rings[4].isz != SWDP_ISZ_RX_CMPLT) {
+		return swl25_gap(x, "L25 not run: ring 3/4 item sizes differ from the tx status / rx complete sizes");
+	}
+	ex = swl25_env(x, &h->l);
+	if (ex != 0 || x->d4dstop) {
+		return ex;
+	}
+	swdp_ring_init(&h->r3, h->l.env.depth_d2h[1]);
+	swdp_ring_init(&h->r4, h->l.env.depth_d2h[2]);
+	swdp_book_init(&h->txb, SWDP_TX_RID);
+	/* T-9d71: the AP compares the RSNE in M2 with the one it stored from the association request (`RSN_IE Different in msg 2`); the association request was built by the firmware, so M2 carries what the firmware sent when it was read */
+	if (swj_ctx_init_ex(&h->sup, c->pmk, mac, c->bssid, h->arsne_len != 0u ? h->arsne : c->rsne_assoc, h->arsne_len != 0u ? h->arsne_len : c->rsne_assoc_len, c->rsne_beacon, c->rsne_beacon_len, h->arsne_len != 0u) != 0) {
+		return swl25_gap(x, "L25 not run: RSNE missing or too long");
+	}
+	swl25_rsne_report(h);
+	swdp_net_init(&h->net, mac, c->ip, c->gw);
+	swl25_witness_ctx(c, mac);
+	ex = swl25_flow(x, &h->l, c->bssid);
+	if (ex != 0 || x->d4dstop) {
+		return ex;
+	}
+	ex = swl25_rxposts(x, &h->l);
+	if (ex != 0 || x->d4dstop) {
+		return ex;
+	}
+	ex = swl25_4way(x, h);
+	if (ex != 0 || x->d4dstop) {
+		return ex;
+	}
+	printf("SWEET WLAN: L25 done: keys installed, rx frames %u, tx posts %u, ring-0 WR %u, ring-2 RD %u\n", h->rx_frames, h->tx_posts, x->d4wr, x->d4rd);
+	swg_d4d_done(x, 25u, lv, x->d4wr, x->d4rd);
+	if (lv < 26u) {
+		return 0;
+	}
+	x->elv = 26u;
+	if (swl25_zero(c->ip, 4u) && swl25_zero(c->gw, 4u)) {
+		/* patch 0281: DHCP credentials: no static address to ARP or ping. The evidence of the join is LINK + the 4-way + swl25_live; the level counts as finished so the engine is kept (en0 gets its address from iOS's DHCP) */
+		swl_gap("l25", "L26 not run: DHCP credentials (no static address)", "medium");
+		printf("SWEET WLAN: L26 not run: DHCP credentials (no static address)\n");
+		swg_d4d_done(x, 26u, lv, x->d4wr, x->d4rd);
+		return swl25_live(x, h);
+	}
+	ex = swl25_ping(x, h);
+	if (ex != 0 || x->d4dstop) {
+		return ex;
+	}
+	swg_d4d_done(x, 26u, lv, x->d4wr, x->d4rd);
+	return swl25_live(x, h);       /* W-UI: what the Apple80211 kept link reports comes from here */
+}
+
+/* T-9d71 (W-JOIN, cause named from the AP's own log: `RSN_IE Different in msg 2 of 4-way handshake!`, no `MIC Different`): the RSNE of the firmware's association request, read after link up the way the Linux/Broadcom driver does it
+ * [src wl_cfg80211.c.new:14253-14320 wl_get_assoc_ies]: GET_VAR `assoc_info` (wl_assoc_info_t: u32 req_len, u32 resp_len, u32 flags, then dot11_assoc_req 4 B ...), then GET_VAR `assoc_req_ies` whose reply starts with the request's
+ * IEs, req_len - 4 B (minus 6 B more for a reassociation, flags & 1). Both are read-only GETs of fixed length (rows of the L25 ioctl table, sweet_wlan_l25_wl.h). The first RSNE (IE 48) of the IEs goes to h->arsne. Every failure is a printed gap
+ * and M2 then carries the beacon RSNE as before. The reply copy is file scope (no stack growth, the T-73fc class). */
+#define SWL25_AINFO_LEN 64u
+#define SWL25_AIES_LEN  512u
+static uint8_t swl25_ai_rsp[SWL25_AIES_LEN + 4u];     /* +4 for the word-wise copy of the last bytes */
+
+static void
+swl25_ai_gap(const char *why)
+{
+	char gb[96];
+
+	snprintf(gb, sizeof gb, "L25 assoc RSNE not read, M2 keeps the beacon RSNE: %.32s", why);
+	swl_gap("l25", "L25 assoc RSNE not read, M2 keeps the beacon RSNE", "high");
+	printf("WIFI GAP: %s\n", gb);
+}
+
+/* FNV-1a 32: a short fingerprint so the log can show two RSNEs are equal or not without the bytes in a committed file (the witness lines carry the bytes in the gitignored run log) */
+static uint32_t
+swl25_fnv(const uint8_t *p, uint32_t n)
+{
+	uint32_t h = 2166136261u, i;
+
+	for (i = 0; i < n; i++) {
+		h = (h ^ p[i]) * 16777619u;
+	}
+	return h;
+}
+
+/* the first RSNE (IE 48) in ies[0..n): 0 = found (*off = offset of its id byte, *len = 2 + length), -1 = an element overruns the buffer, -2 = none */
+static int
+swl25_find_rsne(const uint8_t *ies, uint32_t n, uint32_t *off, uint32_t *len)
+{
+	uint32_t pos = 0u;
+
+	while (pos + 2u <= n) {
+		const uint32_t el = ies[pos + 1u];
+
+		if (pos + 2u + el > n) {
+			return -1;
+		}
+		if (ies[pos] == 48u) {
+			*off = pos;
+			*len = 2u + el;
+			return 0;
+		}
+		pos += 2u + el;
+	}
+	return -2;
+}
+
+/* ---- W-UI (sprint 2026-11-08): the live link from the firmware, for the Apple80211 kept link ---- */
+#define SWL25_WLC_GET_BSSID 23u      /* [src refs/wlan-stage5/wlioctl_defs.h.new:703] */
+#define SWL25_WLC_GET_RSSI  127u     /* [src wlioctl_defs.h.new:810] */
+static void
+swl25_live_gap(const char *what)
+{
+	swl_gap("l25", "live link value not read from the firmware", "high");
+	printf("WIFI GAP: L25 live link: %s\n", what);
+}
+
+/* the SSID element (IE 0) of ies[0..n) into h->live_ssid; a missing or overlong one is a GAP */
+static void
+swl25_live_ssid(struct swl25h *h, const uint8_t *ies, uint32_t n)
+{
+	uint32_t pos = 0u;
+
+	while (pos + 2u <= n) {
+		const uint32_t el = ies[pos + 1u];
+
+		if (pos + 2u + el > n) {
+			break;
+		}
+		if (ies[pos] == 0u) {
+			if (el == 0u || el > sizeof h->live_ssid) {
+				swl25_live_gap("SSID element of the association request is empty or longer than 32");
+				return;
+			}
+			memcpy(h->live_ssid, ies + pos + 2u, el);
+			h->live_ssid_len = el;
+			h->live_ok |= 1u;
+			return;
+		}
+		pos += 2u + el;
+	}
+	swl25_live_gap("no SSID element in the association request the firmware sent");
+}
+
+/* the 20 MHz primary channel of a chanspec [src refs/wlan-stage5/bcmwifi_channels.h.new:98-146 (CHAN_MASK 0xff, CTL_SB 0x0700 >> 8, BW 0x3800: 20 0x1000, 40 0x1800, 80 0x2000, 160 0x2800),
+ * :166-176 LOWER_20_SB = center - 2, LL_20_SB = center - 6: primary = center - (n20 - 1) * 2 + sb * 4]. 0 = a bandwidth this decoder does not know (a GAP) */
+static uint32_t
+swl25_chspec_ctl(uint32_t cs)
+{
+	const uint32_t c = cs & 0xFFu, sb = (cs & 0x0700u) >> 8, bw = cs & 0x3800u;
+	uint32_t n20;
+
+	switch (bw) {
+	case 0x1000u: return c;
+	case 0x1800u: n20 = 2u; break;
+	case 0x2000u: n20 = 4u; break;
+	case 0x2800u: n20 = 8u; break;
+	default: return 0u;
+	}
+	if (sb >= n20 || c < (n20 - 1u) * 2u) {
+		return 0u;
+	}
+	return c - (n20 - 1u) * 2u + sb * 4u;
+}
+
+/* ---- LOWCLK B3 (xnu patch 0363, docs/research/161 s.3): three read-only firmware GETs, logged once at two points of the boot ----
+ * WLC_GET_PM (85): 4-byte int, 0 = OFF/CAM, 1 = MAX/PS, 2 = FAST [src Linux v6.6 brcmfmac fwil.h:49, include/defs.h:76-78; OpenBSD bwfmreg.h:242-244, :284]. GET_VAR "country": brcmf_fil_country_le
+ * { char abbrev[4]; s32 rev; char ccode[4] } = 12 B [src brcmfmac fwil_types.h:764-768, cfg80211.c:8206]. GET_VAR "chanspecs": brcmf_chanspec_list { u32 count; u32 element[] }, each element's low 16 bits
+ * is the chanspec [src fwil_types.h:708-711, cfg80211.c:6957, :6981]; asked at 1200 B (299 entries); band bits 0xC000 (2G 0x0000, 6G 0x4000, 5G 0xC000) and width bits 0x3800 (20 0x1000, 40 0x1800, 80 0x2000,
+ * 160 0x2800) [src refs/wlan-stage5/bcmwifi_channels.h.new:137-154]. Gate: the glue arms it (swl25_probe_set) from boot-arg sweetprobe=1; default off = no call, no line. P1 ("l25start", not armed by default) runs once after the station MAC
+ * read of swl25_go (L25 start: the join of L24 is done, the 4-way is not), P2 ("joined") once at the first swl25_live (after L26). One ioctl at a time, no retry; a refused, short or odd reply is a
+ * `SWEET PROBE: GAP wifi ...` line and the value stays unread. The three rows are in the L25 whitelist (sweet_wlan_l25_wl.h). */
+#define SWL25_WLC_GET_PM    85u
+#define SWL25_CHSP_LEN      1200u
+#define SWL25_CHSP_MAX      ((SWL25_CHSP_LEN - 4u) / 4u)      /* 299 entries */
+static uint8_t swl25_chsp_rsp[SWL25_CHSP_LEN + 4u];           /* file scope: no stack growth (the T-73fc overflow); +4 for the word-wise copy of the last bytes */
+/* review 0363 finding 3 + Opus finding 1: only P2 (after L26) is armed; P1 runs before the 4-way and would also lose it. A probe GET without an answer at P2 still sets d4dstop (g2.h SWG_E_STOP) and the G2 undo drops the link (keep needs !d4dstop): Wi-Fi is off for that boot, `L25 STOP` is logged. Bit 0 (P1) stays compiled for the host tests. */
+#define SWL25_PROBE_ARM_ON  2u
+static inline void
+swl25_probe_set(uint32_t on)
+{
+	swl25_probe_arm = on != 0u ? SWL25_PROBE_ARM_ON : 0u;
+}
+
+static void
+swl25_probe_gap(const char *what, const struct swd4b_ioctl_d2h *cm)
+{
+	swl_gap("l25", "wifi probe value not read from the firmware", "medium");
+	printf("SWEET PROBE: GAP wifi %s status=%d resp_len=%u: value unread\n", what, (int)cm->status, (unsigned)cm->resp_len);
+}
+
+static const char *
+swl25_pm_name(int32_t v)
+{
+	return v == 0 ? "OFF/CAM" : v == 1 ? "MAX/PS" : v == 2 ? "FAST" : "?";
+}
+
+/* one NUL-terminated field of at most n bytes as printable text (anything else is '?'), into out[n + 1] */
+static void
+swl25_probe_str(const uint8_t *p, uint32_t n, char *out)
+{
+	uint32_t i;
+
+	for (i = 0; i < n && p[i] != 0u; i++) {
+		out[i] = (p[i] >= 0x20u && p[i] < 0x7Fu) ? (char)p[i] : '?';
+	}
+	out[i] = '\0';
+}
+
+static int
+swl25_probe_pm(struct swg_wx *x, const char *at)
+{
+	uint8_t rsp[8];
+	struct swd4b_ioctl_d2h cm;
+	int ex;
+
+	memset(rsp, 0, sizeof rsp);
+	memset(&cm, 0, sizeof cm);
+	ex = swg_e_call(x, SWL25_WLC_GET_PM, "WLC_GET_PM", "", NULL, 0u, 4u, 1, 4u, rsp, 1, &cm, NULL);
+	if (ex != 0 || x->d4dstop) {
+		return ex;
+	}
+	if (cm.status != 0 || cm.resp_len < 4u) {
+		swl25_probe_gap("pm", &cm);
+	} else if (swd4b_get32(rsp) > 2u) {
+		printf("SWEET PROBE: GAP wifi pm value %u is outside 0..2 (OFF/MAX/FAST): at=%s\n", (unsigned)swd4b_get32(rsp), at);
+	} else {
+		printf("SWEET PROBE: wifi pm=%d (%s) at=%s\n", (int)swd4b_get32(rsp), swl25_pm_name((int32_t)swd4b_get32(rsp)), at);
+	}
+	return 0;
+}
+
+static int
+swl25_probe_country(struct swg_wx *x, const char *at)
+{
+	uint8_t rsp[16];
+	struct swd4b_ioctl_d2h cm;
+	char ab[5], cc[5];
+	int ex;
+
+	memset(rsp, 0, sizeof rsp);
+	memset(&cm, 0, sizeof cm);
+	ex = swg_e_call(x, SWD4B_WLC_GET_VAR, "WLC_GET_VAR country", "country", NULL, 0u, 8u + 12u, 1, 12u, rsp, 1, &cm, NULL);
+	if (ex != 0 || x->d4dstop) {
+		return ex;
+	}
+	if (cm.status != 0 || cm.resp_len < 12u) {
+		swl25_probe_gap("country", &cm);
+		return 0;
+	}
+	swl25_probe_str(rsp, 4u, ab);
+	swl25_probe_str(rsp + 8u, 4u, cc);
+	printf("SWEET PROBE: wifi country abbrev=%s rev=%d ccode=%s at=%s\n", ab, (int)swd4b_get32(rsp + 4u), cc, at);
+	if (ab[0] == '\0' && cc[0] == '\0') {
+		printf("SWEET PROBE: GAP wifi country abbrev and ccode are both empty: no country set at=%s\n", at);
+	}
+	return 0;
+}
+
+/* a list of 20 MHz channel numbers as "a,b,c" into out[cap]; '+' marks a cut list */
+static void
+swl25_probe_list_add(char *out, uint32_t cap, uint32_t ch)
+{
+	uint32_t n = 0u;
+
+	while (out[n] != '\0') {
+		n++;
+	}
+	if (n + 6u >= cap) {
+		if (n + 2u < cap) {
+			out[n] = '+';
+			out[n + 1u] = '\0';
+		}
+		return;
+	}
+	snprintf(out + n, cap - n, "%s%u", n != 0u ? "," : "", (unsigned)ch);
+}
+
+static void
+swl25_probe_chsp_report(const uint8_t *r, uint32_t count, const char *at)
+{
+	char l2[200], l5[300], l6[300];
+	uint32_t i, n40 = 0u, n80 = 0u, n160 = 0u, other = 0u;
+
+	l2[0] = l5[0] = l6[0] = '\0';
+	for (i = 0; i < count; i++) {
+		const uint32_t cs = swd4b_get32(r + 4u + 4u * i) & 0xFFFFu, bw = cs & 0x3800u, band = cs & 0xC000u;
+
+		if (bw == 0x1000u && band == 0x0000u) {
+			swl25_probe_list_add(l2, sizeof l2, cs & 0xFFu);
+		} else if (bw == 0x1000u && band == 0xC000u) {
+			swl25_probe_list_add(l5, sizeof l5, cs & 0xFFu);
+		} else if (bw == 0x1000u && band == 0x4000u) {
+			swl25_probe_list_add(l6, sizeof l6, cs & 0xFFu);
+		} else if (bw == 0x1800u) {
+			n40++;
+		} else if (bw == 0x2000u) {
+			n80++;
+		} else if (bw == 0x2800u) {
+			n160++;
+		} else {
+			other++;
+		}
+	}
+	printf("SWEET PROBE: wifi chanspecs count=%u ch20_2g=%s ch20_5g=%s ch20_6g=%s n40=%u n80=%u n160=%u nother=%u at=%s\n", (unsigned)count, l2[0] != '\0' ? l2 : "-",
+	    l5[0] != '\0' ? l5 : "-", l6[0] != '\0' ? l6 : "-", (unsigned)n40, (unsigned)n80, (unsigned)n160, (unsigned)other, at);
+}
+
+static int
+swl25_probe_chanspecs(struct swg_wx *x, const char *at)
+{
+	struct swd4b_ioctl_d2h cm;
+	uint32_t count;
+	int ex;
+
+	memset(swl25_chsp_rsp, 0, sizeof swl25_chsp_rsp);
+	memset(&cm, 0, sizeof cm);
+	ex = swg_e_call(x, SWD4B_WLC_GET_VAR, "WLC_GET_VAR chanspecs", "chanspecs", NULL, 0u, SWL25_CHSP_LEN, 1, SWL25_CHSP_LEN, swl25_chsp_rsp, 1, &cm, NULL);
+	if (ex != 0 || x->d4dstop) {
+		return ex;
+	}
+	if (cm.status != 0 || cm.resp_len < 4u) {
+		swl25_probe_gap("chanspecs", &cm);
+		return 0;
+	}
+	count = swd4b_get32(swl25_chsp_rsp);
+	if (count > SWL25_CHSP_MAX || count > (cm.resp_len < SWL25_CHSP_LEN ? cm.resp_len : SWL25_CHSP_LEN) / 4u - 1u) {
+		printf("SWEET PROBE: GAP wifi chanspecs count=%u does not fit the %u B reply (resp_len %u, at most %u entries): list unread at=%s\n", (unsigned)count, (unsigned)SWL25_CHSP_LEN,
+		    (unsigned)cm.resp_len, (unsigned)SWL25_CHSP_MAX, at);
+		return 0;
+	}
+	swl25_probe_chsp_report(swl25_chsp_rsp, count, at);
+	return 0;
+}
+
+/* the three reads, in this order, one ioctl each. 0 = done (also after a GAP); negative = the bus stopped; x->d4dstop = a soft stop (the caller returns) */
+static int
+swl25_probe_wifi(struct swg_wx *x, const char *at)
+{
+	int ex;
+
+	ex = swl25_probe_pm(x, at);
+	if (ex != 0 || x->d4dstop) {
+		return ex;
+	}
+	ex = swl25_probe_country(x, at);
+	if (ex != 0 || x->d4dstop) {
+		return ex;
+	}
+	return swl25_probe_chanspecs(x, at);
+}
+
+/* After L26 (the link carried 10 pings): BSSID, chanspec and RSSI as the firmware reports them now. Read-only commands, one at a time, judged by the L25 whitelist (sweet_wlan_l25_wl.h rows 8-10):
+ * WLC_GET_BSSID 23 (6 B) [src refs/wlan-stage5/wl_cfg80211.c.new:2063], GET_VAR "chanspec" (int) [src :5726, :12314], WLC_GET_RSSI 127 (scb_val_t 12 B, val 0 = the associated AP) [src :7867-7875,
+ * wlioctl.h.new:2621-2625]. A refused or short answer is a GAP and the value stays unread (no stop: the link itself is fine). 0 = done; negative = the bus stopped */
+static int
+swl25_live(struct swg_wx *x, struct swl25h *h)
+{
+	uint8_t rsp[16];
+	struct swd4b_ioctl_d2h cm;
+	char gb[96];
+	int ex;
+
+	memset(rsp, 0, sizeof rsp);
+	memset(&cm, 0, sizeof cm);
+	ex = swg_e_call(x, SWL25_WLC_GET_BSSID, "WLC_GET_BSSID", "", NULL, 0u, 6u, 1, 6u, rsp, 1, &cm, NULL);
+	if (ex != 0 || x->d4dstop) {
+		return ex;
+	}
+	if (cm.status != 0 || cm.resp_len < 6u || swl25_zero(rsp, 6u)) {
+		snprintf(gb, sizeof gb, "WLC_GET_BSSID status=%d resp_len %u (or all zero)", (int)cm.status, cm.resp_len);
+		swl25_live_gap(gb);
+	} else {
+		memcpy(h->live_bssid, rsp, 6);
+		h->live_ok |= 2u;
+	}
+	memset(rsp, 0, sizeof rsp);
+	memset(&cm, 0, sizeof cm);
+	ex = swg_e_call(x, SWD4B_WLC_GET_VAR, "WLC_GET_VAR chanspec", "chanspec", NULL, 0u, 9u + 4u, 1, 4u, rsp, 1, &cm, NULL);
+	if (ex != 0 || x->d4dstop) {
+		return ex;
+	}
+	if (cm.status != 0 || cm.resp_len < 4u) {
+		snprintf(gb, sizeof gb, "chanspec status=%d resp_len %u", (int)cm.status, cm.resp_len);
+		swl25_live_gap(gb);
+	} else {
+		h->live_chanspec = swd4b_get32(rsp) & 0xFFFFu;
+		h->live_chan = swl25_chspec_ctl(h->live_chanspec);
+		if (h->live_chan == 0u) {
+			snprintf(gb, sizeof gb, "chanspec %#x: bandwidth/sideband not decoded", (unsigned)h->live_chanspec);
+			swl25_live_gap(gb);
+		} else {
+			h->live_ok |= 4u;
+		}
+	}
+	memset(rsp, 0, sizeof rsp);
+	memset(&cm, 0, sizeof cm);
+	ex = swg_e_call(x, SWL25_WLC_GET_RSSI, "WLC_GET_RSSI", "", NULL, 0u, 12u, 1, 12u, rsp, 1, &cm, NULL);
+	if (ex != 0 || x->d4dstop) {
+		return ex;
+	}
+	if (cm.status != 0 || cm.resp_len < 4u || (int32_t)swd4b_get32(rsp) >= 0 || (int32_t)swd4b_get32(rsp) < -127) {
+		snprintf(gb, sizeof gb, "WLC_GET_RSSI status=%d resp_len %u value %d (outside -127..-1)", (int)cm.status, cm.resp_len, (int)swd4b_get32(rsp));
+		swl25_live_gap(gb);
+	} else {
+		h->live_rssi = (int32_t)swd4b_get32(rsp);
+		h->live_ok |= 8u;
+	}
+	if ((swl25_probe_arm & 2u) != 0u) {       /* LOWCLK B3 P2 (patch 0363): sweetprobe=1 only, once, after the three live reads */
+		swl25_probe_arm &= ~2u;
+		ex = swl25_probe_wifi(x, "joined");
+		if (ex != 0 || x->d4dstop) {
+			return ex;
+		}
+	}
+	printf("SWEET WLAN: L25 live link (firmware): ok=%#x ssid_len=%u bssid=%s chanspec=%#x chan=%u rssi=%d\n", (unsigned)h->live_ok, (unsigned)h->live_ssid_len,
+	    (h->live_ok & 2u) ? "read" : "unread", (unsigned)h->live_chanspec, (unsigned)h->live_chan, (int)h->live_rssi);
+	return 0;
+}
+
+/* patch 0281 (checklist item 3): ring 2 carries events now (an AP loss makes several), so the idle check of swl25_live_rssi could skip every refresh. The keep thread calls this first: while D2H-W != the read count it runs one more keep pass
+ * (swg_keep_r2: decode, consume, re-post), at most 4 extra passes of SWG_E_BATCH items. 0 = ring 2 idle or the passes ran (the refresh makes its own idle check and says so when it still skips), 1 = a soft stop (x->d4dstop, the data path ends in the
+ * caller's loop), negative = the bus stopped */
+static inline int
+swl25_rssi_drain(struct swg_wx *x)
+{
+	return swg_rssi_drain(x);       /* the loop lives in sweet_wlan_g2.h next to swg_keep_r2 so the g2 host test runs it (review 0281 F1) */
+}
+
+/* Part A (sprint-wifi 2026-11-09): only the WLC_GET_RSSI step of swl25_live, for the keep thread's refresh (xnu patch 0273, every 5 s under its lock; the same judged read-only ioctl, L25 whitelist row 10).
+ * 0 = read (*rssi, h->live_rssi), 1 = refused or out of range (a GAP, nothing stopped), negative = the bus stopped */
+static inline int
+swl25_live_rssi(struct swg_wx *x, struct swl25h *h, int32_t *rssi)
+{
+	uint8_t rsp[16];
+	struct swd4b_ioctl_d2h cm;
+	char gb[96];
+	int ex;
+
+	uint32_t v = 0u;
+
+	/* review perf-c F1: only with ring 2 idle (D2H-W slot == the read count), so the call meets no item it did not ask for (patch 0281: the keep thread drains ring 2 first, swl25_rssi_drain) */
+	if (swg_hrd(x, x->in.idx[SWG_IDX(SWD_IDX_D2H_W)], &v) || v == 0xFFFFFFFFu || (v & 0xFFFFu) != x->d4rd % SWG_R2_DEPTH) {
+		swl25_live_gap("RSSI refresh skipped: ring 2 not idle (or its write index unreadable)");
+		return 1;
+	}
+	memset(rsp, 0, sizeof rsp);
+	memset(&cm, 0, sizeof cm);
+	x->krefresh = 1u;
+	ex = swg_e_call(x, SWL25_WLC_GET_RSSI, "WLC_GET_RSSI", "", NULL, 0u, 12u, 1, 12u, rsp, 1, &cm, NULL);
+	x->krefresh = 0u;
+	if (ex != 0 || x->d4dstop) {
+		return ex != 0 ? ex : -1;
+	}
+	if (cm.status == 0 && cm.resp_len >= 4u && swd4b_get32(rsp) == 0u) {
+		/* patch 0281: WLC_GET_RSSI = 0 is only a hint (observed after the AP loss, W-D6 aploss2; its meaning is [guess]): logged, never drives the link state (the events do). No GAP while the detector says DOWN, a GAP while UP (unexpected). */
+		printf("SWEET WLAN: keep RSSI refresh value 0 (hint only, the link state comes from the events; detector state %s)\n", x->klink != 0u ? "DOWN" : "UP");
+		if (x->klink == 0u) {
+			swl25_live_gap("RSSI refresh: WLC_GET_RSSI value 0 while the detector says UP");
+		}
+		return 1;
+	}
+	if (cm.status != 0 || cm.resp_len < 4u || (int32_t)swd4b_get32(rsp) >= 0 || (int32_t)swd4b_get32(rsp) < -127) {
+		snprintf(gb, sizeof gb, "RSSI refresh: WLC_GET_RSSI status=%d resp_len %u value %d (outside -127..-1)", (int)cm.status, cm.resp_len, (int)swd4b_get32(rsp));
+		swl25_live_gap(gb);
+		return 1;
+	}
+	h->live_rssi = *rssi = (int32_t)swd4b_get32(rsp);
+	return 0;
+}
+
+/* 0 = done or soft stop with x->d4dstop; negative = the bus stopped. A refused or unparsable reply is a gap and returns 0 (h->arsne_len stays 0). Patch 0282: no l25c gate here, the re-join (swl25_rj_*) reads the same two GETs in the keep phase */
+static int
+swl25_assoc_rsne_read(struct swg_wx *x, struct swl25h *h)
+{
+	struct swd4b_ioctl_d2h cm;
+	const uint8_t *r = swl25_ai_rsp;
+	uint32_t req_len, flags, hdr, iel, off = 0u, len = 0u, avail;
+	char gb[48];
+	int ex, fr;
+
+	h->arsne_len = 0u;
+	memset(swl25_ai_rsp, 0, sizeof swl25_ai_rsp);
+	memset(&cm, 0, sizeof cm);
+	ex = swg_e_call(x, SWD4B_WLC_GET_VAR, "WLC_GET_VAR assoc_info", "assoc_info", NULL, 0u, SWL25_AINFO_LEN, 1, SWL25_AINFO_LEN, swl25_ai_rsp, 1, &cm, NULL);
+	if (ex != 0 || x->d4dstop) {
+		return ex;
+	}
+	if (cm.status != 0) {
+		snprintf(gb, sizeof gb, "assoc_info refused status=%d", (int)cm.status);
+		swl25_ai_gap(gb);
+		return 0;
+	}
+	if (cm.resp_len < 12u) {
+		snprintf(gb, sizeof gb, "assoc_info answer %u B < 12", cm.resp_len);
+		swl25_ai_gap(gb);
+		return 0;
+	}
+	req_len = swd4b_get32(r);
+	flags = swd4b_get32(r + 8);
+	printf("SWEET WLAN: L25 assoc_info: req_len %u resp_len %u flags %#x (answer %u B)\n", req_len, swd4b_get32(r + 4), flags, cm.resp_len);
+	hdr = 4u + ((flags & 1u) != 0u ? 6u : 0u);
+	if (req_len <= hdr || req_len - hdr > SWL25_AIES_LEN) {
+		snprintf(gb, sizeof gb, "req_len %u outside %u..%u", req_len, hdr + 1u, hdr + SWL25_AIES_LEN);
+		swl25_ai_gap(gb);
+		return 0;
+	}
+	iel = req_len - hdr;
+	memset(swl25_ai_rsp, 0, sizeof swl25_ai_rsp);
+	memset(&cm, 0, sizeof cm);
+	ex = swg_e_call(x, SWD4B_WLC_GET_VAR, "WLC_GET_VAR assoc_req_ies", "assoc_req_ies", NULL, 0u, SWL25_AIES_LEN, 1, SWL25_AIES_LEN, swl25_ai_rsp, 1, &cm, NULL);
+	if (ex != 0 || x->d4dstop) {
+		return ex;
+	}
+	if (cm.status != 0) {
+		snprintf(gb, sizeof gb, "assoc_req_ies refused status=%d", (int)cm.status);
+		swl25_ai_gap(gb);
+		return 0;
+	}
+	avail = cm.resp_len < SWL25_AIES_LEN ? cm.resp_len : SWL25_AIES_LEN;
+	printf("SWEET WLAN: L25 assoc_req_ies: %u IE bytes expected, answer %u B\n", iel, cm.resp_len);
+	if (avail < iel) {
+		snprintf(gb, sizeof gb, "answer %u B < %u IE bytes", avail, iel);
+		swl25_ai_gap(gb);
+		return 0;
+	}
+	swl25_live_ssid(h, swl25_ai_rsp, iel);       /* W-UI: the SSID element of the firmware's own association request (before the RSNE checks, which may return) */
+	fr = swl25_find_rsne(swl25_ai_rsp, iel, &off, &len);
+	if (fr != 0) {
+		swl25_ai_gap(fr == -1 ? "an IE overruns the request" : "no RSNE (IE 48) in the request");
+		return 0;
+	}
+	if (len < 4u || len > sizeof h->arsne) {
+		snprintf(gb, sizeof gb, "RSNE length %u outside 4..%u", len, (unsigned)sizeof h->arsne);
+		swl25_ai_gap(gb);
+		return 0;
+	}
+	memcpy(h->arsne, swl25_ai_rsp + off, len);
+	h->arsne_len = len;
+	return 0;
+}
+
+static int
+swl25_assoc_rsne(struct swg_wx *x, struct swl25h *h)
+{
+	if (x->l25c == NULL) {
+		h->arsne_len = 0u;
+		return 0;       /* swl25_go prints its own refusal */
+	}
+	return swl25_assoc_rsne_read(x, h);
+}
+
+/* once M2's source is fixed (swj_ctx_init done): the RSNE of the firmware's association request (a), the RSNE the 4-way takes for M2 key data (m2) and the beacon one (b), as lengths, fingerprints and the first differing offset; no bytes */
+static void
+swl25_rsne_report(const struct swl25h *h)
+{
+	const struct swj_ctx *s = &h->sup;
+	uint32_t i, d = 0u, first = 0u, n;
+
+	if (h->arsne_len == 0u) {
+		printf("SWEET WLAN: L25 rsne assoc=unread m2=%u (beacon RSNE, the firmware's association-request RSNE was not read)\n", (unsigned)s->rsne_assoc_len);
+		return;
+	}
+	n = h->arsne_len < s->rsne_beacon_len ? h->arsne_len : s->rsne_beacon_len;
+	for (i = 0; i < n; i++) {
+		if (h->arsne[i] != s->rsne_beacon[i]) {
+			if (d++ == 0u) {
+				first = i;
+			}
+		}
+	}
+	printf("SWEET WLAN: L25 rsne assoc=%u m2=%u equal=%d hash_assoc=%08x hash_m2=%08x\n", h->arsne_len, (unsigned)s->rsne_assoc_len,
+	    (h->arsne_len == s->rsne_assoc_len && memcmp(h->arsne, s->rsne_assoc, h->arsne_len) == 0) ? 1 : 0, swl25_fnv(h->arsne, h->arsne_len), swl25_fnv(s->rsne_assoc, s->rsne_assoc_len));
+	printf("SWEET WLAN: L25 rsne assoc vs beacon: beacon=%u hash_beacon=%08x equal=%d bytes_differ=%u first_diff=%d\n", (unsigned)s->rsne_beacon_len, swl25_fnv(s->rsne_beacon, s->rsne_beacon_len),
+	    (h->arsne_len == s->rsne_beacon_len && d == 0u) ? 1 : 0, d + (h->arsne_len > s->rsne_beacon_len ? h->arsne_len - s->rsne_beacon_len : s->rsne_beacon_len - h->arsne_len), d != 0u ? (int)first : -1);
+}
+
+/* ---- patch 0282 (W-D6 boot B, docs/research/W-D6-rejoin-dhcp.md s.3, 6): the RE-JOIN after an AP loss, driven by the keep thread (the only user of the engine in the keep phase; the RSSI refresh is the precedent for an ioctl inside the thread's pass).
+ * States (x->rj_state, sweet_wlan_g2.h): UP -> DOWN (the 0281 detector) -> JOINING (the join SET_VAR sent, waiting for SET_SSID 0 + LINK up) -> KEYING (the host 4-way: EAPOL frames reach swl25_rj_eapol through the en0 receive path, wlan_en0.h en0_rx_deliver)
+ * -> UP (keys installed, link values read, iOS told by the thread). A failed attempt returns to DOWN and waits 2, 4, 8, 16, then 30 s (swg_rj_backoff_ms) for ever. Nothing here runs unless the detector went DOWN.
+ * Secrets: the PMK and the join payload are kept in struct swl25_rj for this purpose only (user decision 2026-11-10: kept in RAM, never printed or written elsewhere, wiped when the engine dies: swl25_rj_wipe). No log line carries a key, the PMK, the SSID or an address. */
+#define SWL25_RJ_TXWAIT_MS 200u          /* wait for the M4 tx completion before the key install, as the boot path (SWL25_TXWAIT_MS) [decision, no source] */
+/* review 0282 N1: the m4_busy argument of swl25_rj_step as the glue computes it: the tx buffer of the last EAPOL reply is still in flight. NOT gated on m4_seen: the step sets m4_seen itself in the pass that sees m4_pending,
+ * so a gate here would read 0 exactly when the wait must start. The host case and the glue use this one macro. */
+#define SWL25_RJ_BUSY_ARG(rj, buf_busy) ((void)(rj), (buf_busy))
+#define SWL25_RJ_DEFER_MS  100u          /* an attempt that finds ring 2 busy is retried this much later (not counted as an attempt) */
+
+struct swl25_rj {
+	uint8_t armed;                   /* the payload and the PMK below are present */
+	uint8_t pmk[32];
+	uint8_t join[SWJ_EXT_JOIN_V1_SIZE];       /* the boot join value (wl_extjoin_params_v1_t, wildcard BSSID), the bytes after "join\0" of sw_jc */
+	uint32_t v_wpa_auth, v_wsec, v_auth, v_mfp;       /* the values the boot join set (sw_jc); a re-join re-sends one only when the firmware reads back something else */
+	uint8_t rsne_beacon[SWJ_RSNE_MAX], rsne_assoc[SWJ_RSNE_MAX];     /* public: the RSNE the boot scan record gave (M3 must repeat the AP's RSNE) and the one M2 carried */
+	uint32_t rsne_beacon_len, rsne_assoc_len;
+	struct swl25h *h;                /* the supplicant (h->sup), the station MAC (h->l.mac) and the live values live in the engine's run state */
+	/* the machine */
+	uint64_t now;                    /* ms, set by swl25_rj_step each pass (the EAPOL reply stamps the M4 with it) */
+	uint64_t t_down, t_next, t_phase;
+	uint32_t n, n_up, n_fail;
+	uint8_t down_seen, eapol_on, m4_seen, up_new, noarm_gap, defer_gap;
+	uint8_t m4_pending;              /* review 0282 F6: swj_rx produced an M4 reply; m4_seen follows only when en0 posted it (swl25_rj_step tx_ok) */
+	const char *where;               /* review 0282 F1: the step a soft stop happened in (a literal) */
+	uint32_t eapol_m1_late;          /* review 0282 F4: M1 frames dropped after M3 was accepted */
+	uint64_t m4_ms;
+	uint8_t bssid[6];                /* the AP of the last join (WLC_GET_BSSID), may differ from the boot one */
+	uint32_t chan, ok;               /* the values for iOS after UP: swl25h.live_chan / live_ok */
+	int32_t rssi;
+	uint32_t eapol_rx, eapol_tx;
+};
+
+static inline void
+swl25_rj_wipe(struct swl25_rj *rj, const char *why)
+{
+	const uint8_t was = rj->armed;
+
+	if (rj->h != NULL) {
+		swl25_wipe(&rj->h->sup, sizeof rj->h->sup);       /* review 0282 F2: the supplicant's copy (PMK, PTK, GTK, nonces) goes with the kept one */
+	}
+	swl25_wipe(rj, sizeof *rj);
+	if (was) {
+		printf("SWEET WLAN: keep rejoin: kept join payload and PMK wiped (%s)\n", why);
+	}
+}
+
+/* copy what a re-join needs out of the boot run's tables, before the glue wipes them: the PMK, the join table jc[0..njc) (names wpa_auth, wsec, auth, mfp, join; "H1".."H5" rows of swj_join_cmds) and the boot RSNEs. 0 = armed, -1 = something missing (a GAP; the machine then
+ * cannot re-join and says so when the link is lost) */
+static inline int
+swl25_rj_arm(struct swl25_rj *rj, struct swl25h *h, const uint8_t pmk[32], const struct swg_jcmd *jc, uint32_t njc, const uint8_t *rsne_beacon, uint32_t rbl, const uint8_t *rsne_assoc, uint32_t ral)
+{
+	static const char *const nm[5] = { "wpa_auth", "wsec", "auth", "mfp", "join" };
+	uint32_t i, k, got = 0u, val[4] = { 0u, 0u, 0u, 0u };
+	int bad = 0;
+
+	swl25_wipe(rj, sizeof *rj);
+	if (pmk == NULL || swl25_zero(pmk, 32u) || jc == NULL || rsne_beacon == NULL || rbl == 0u || rbl > SWJ_RSNE_MAX) {
+		bad = 1;
+	}
+	for (i = 0; !bad && i < njc; i++) {
+		for (k = 0; k < 5u; k++) {
+			const uint32_t nl = (uint32_t)strlen(nm[k]) + 1u;
+
+			if (jc[i].cmd != SWJ_WLC_SET_VAR || jc[i].len <= nl || memcmp(jc[i].buf, nm[k], nl) != 0) {
+				continue;
+			}
+			if (k < 4u && jc[i].len == nl + 4u) {
+				val[k] = swd4b_get32(jc[i].buf + nl);
+				got |= 1u << k;
+			} else if (k == 4u && jc[i].len == nl + SWJ_EXT_JOIN_V1_SIZE) {
+				memcpy(rj->join, jc[i].buf + nl, SWJ_EXT_JOIN_V1_SIZE);
+				got |= 1u << k;
+			}
+		}
+	}
+	if (bad || got != 0x1Fu) {
+		swl_gap("keep", "re-join not armed: PMK, join payload or RSNE missing", "high");
+		printf("WIFI GAP: keep rejoin: not armed (inputs missing, got mask %#x): the link will stay DOWN after an AP loss\n", got);
+		swl25_wipe(rj, sizeof *rj);
+		return -1;
+	}
+	memcpy(rj->pmk, pmk, 32);
+	rj->v_wpa_auth = val[0]; rj->v_wsec = val[1]; rj->v_auth = val[2]; rj->v_mfp = val[3];
+	memcpy(rj->rsne_beacon, rsne_beacon, rbl);
+	rj->rsne_beacon_len = rbl;
+	if (rsne_assoc != NULL && ral > 0u && ral <= SWJ_RSNE_MAX) {
+		memcpy(rj->rsne_assoc, rsne_assoc, ral);
+		rj->rsne_assoc_len = ral;
+	}
+	rj->h = h;
+	rj->armed = 1u;
+	printf("SWEET WLAN: keep rejoin: join payload and PMK kept in RAM for re-joins (never printed, wiped when the engine dies)\n");
+	return 0;
+}
+
+/* one attempt failed (or the 4-way timed out): back to DOWN, keys of the half-done 4-way wiped, the next attempt after the backoff for the attempt just made */
+static inline int
+swl25_rj_fail(struct swg_wx *x, struct swl25_rj *rj, const char *why)
+{
+	char gb[64];
+	const uint32_t wait = swg_rj_backoff_ms(rj->n);
+
+	rj->eapol_on = 0u;
+	rj->m4_seen = 0u;
+	rj->m4_pending = 0u;
+	if (rj->h != NULL) {
+		swl25_wipe(&rj->h->sup, sizeof rj->h->sup);
+	}
+	x->rj_state = SWG_RJ_DOWN;
+	x->rj_ssid = x->rj_link = 0u;
+	x->rj_lost = 0u;
+	rj->t_next = rj->now + wait;
+	rj->n_fail++;
+	snprintf(gb, sizeof gb, "re-join attempt %u failed: %.30s", rj->n, why);
+	swl_gap("keep", gb, "medium");
+	printf("WIFI GAP: keep rejoin attempt %u failed (%s), next attempt in %u ms\n", rj->n, why, wait);
+	return 0;
+}
+
+/* the four security iovars: read back (GET_VAR, whitelist rows wpa_auth/auth/mfp read-only, wsec row 3) and re-sent (SET_VAR, rows with ONE allowed value each) only when the firmware answers something else than the boot join set. [guess, docs/research/W-D6 open unknown 2:
+ * whether they survive a firmware disassoc] 0 = all in order (possibly after a re-send), 1 = a call was refused (a GAP; the attempt fails), negative = the bus stopped */
+static inline int
+swl25_rj_vars(struct swg_wx *x, struct swl25_rj *rj)
+{
+	static const struct { const char *name, *gw, *sw; } t[4] = {
+		{ "wpa_auth", "WLC_GET_VAR wpa_auth", "WLC_SET_VAR wpa_auth" }, { "wsec", "WLC_GET_VAR wsec", "WLC_SET_VAR wsec" },
+		{ "auth", "WLC_GET_VAR auth", "WLC_SET_VAR auth" }, { "mfp", "WLC_GET_VAR mfp", "WLC_SET_VAR mfp" },
+	};
+	const uint32_t want[4] = { rj->v_wpa_auth, rj->v_wsec, rj->v_auth, rj->v_mfp };
+	uint32_t i, cur, nl;
+	uint8_t rsp[4], buf[16];
+	struct swd4b_ioctl_d2h cm;
+	int ex, same;
+
+	for (i = 0; i < 4u; i++) {
+		nl = (uint32_t)strlen(t[i].name) + 1u;
+		memset(rsp, 0, sizeof rsp);
+		memset(&cm, 0, sizeof cm);
+		ex = swg_e_call(x, SWD4B_WLC_GET_VAR, t[i].gw, t[i].name, NULL, 4u, nl + 4u, 1, 4u, rsp, 1, &cm, NULL);
+		if (ex != 0 || x->d4dstop) {
+			return ex != 0 ? ex : -1;
+		}
+		cur = swd4b_get32(rsp);
+		if (cm.status != 0 || cm.resp_len < 4u) {
+			printf("SWEET WLAN: keep rejoin: %s read back refused (status %d, %u B): re-sent\n", t[i].name, (int)cm.status, cm.resp_len);
+			same = 0;
+		} else if (i == 1u) {
+			same = swj_wsec_merge(cur, SWJ_WSEC_AES) == cur;       /* the cipher bits are what matter (the boot path merges AES in after the keys) */
+		} else {
+			same = cur == want[i];
+		}
+		if (same) {
+			printf("SWEET WLAN: keep rejoin: %s survived (read back %#x)\n", t[i].name, cur);
+			continue;
+		}
+		printf("SWEET WLAN: keep rejoin: %s read back %#x, the boot join set %#x: re-sent\n", t[i].name, cur, want[i]);
+		nl = swj_var_u32(buf, sizeof buf, t[i].name, want[i]);
+		if (nl == 0u) {
+			return 1;
+		}
+		memset(&cm, 0, sizeof cm);
+		ex = swg_e_call(x, SWD4B_WLC_SET_VAR, t[i].sw, t[i].name, buf + strlen(t[i].name) + 1u, 4u, nl, 1, 0u, NULL, 1, &cm, NULL);
+		if (ex != 0 || x->d4dstop) {
+			return ex != 0 ? ex : -1;
+		}
+		if (cm.status != 0) {
+			printf("WIFI GAP: keep rejoin: %s re-send refused status=%d\n", t[i].name, (int)cm.status);
+			return 1;
+		}
+	}
+	return 0;
+}
+
+/* a DOWN link: one attempt. Ring 2 is drained first (events of the loss are decoded and their buffers re-posted: swg_rssi_drain) and must be idle, as for the RSSI refresh; busy = try again in SWL25_RJ_DEFER_MS without counting. 0 = done (JOINING or back to DOWN),
+ * negative = the bus stopped */
+static inline int
+swl25_rj_attempt(struct swg_wx *x, struct swl25_rj *rj)
+{
+	struct swd4b_ioctl_d2h cm;
+	uint32_t v = 0u;
+	int ex;
+
+	rj->where = "drain";       /* review 0282 N2: a stop raised by the ring-2 drain (a firmware trap, a bad item) is the data path's stop, never cleared by swl25_rj_step */
+	ex = swg_rssi_drain(x);
+	if (!x->d4dstop) {
+		rj->where = "attempt";       /* a stop raised by the drain keeps "drain" */
+	}
+	if (ex != 0 || x->d4dstop) {
+		return ex < 0 ? ex : 0;
+	}
+	if (swg_hrd(x, x->in.idx[SWG_IDX(SWD_IDX_D2H_W)], &v) || v == 0xFFFFFFFFu || (v & 0xFFFFu) != x->d4rd % SWG_R2_DEPTH) {
+		rj->t_next = rj->now + SWL25_RJ_DEFER_MS;
+		if (!rj->defer_gap) {
+			rj->defer_gap = 1u;
+			printf("SWEET WLAN: keep rejoin: ring 2 not idle, the attempt waits %u ms (not counted)\n", SWL25_RJ_DEFER_MS);
+		}
+		return 0;
+	}
+	rj->defer_gap = 0u;
+	rj->n++;
+	printf("SWEET WLAN: keep rejoin attempt %u\n", rj->n);
+	x->rj_ssid = x->rj_link = 0u;
+	x->rj_lost = 0u;
+	x->krefresh = 1u;
+	ex = swl25_rj_vars(x, rj);
+	if (ex < 0 || x->d4dstop) {
+		x->krefresh = 0u;
+		return ex < 0 ? ex : 0;
+	}
+	if (ex == 1) {
+		x->krefresh = 0u;
+		return swl25_rj_fail(x, rj, "security iovars");
+	}
+	x->rj_state = SWG_RJ_JOINING;       /* before the call: the events that arrive inside the ioctl count */
+	memset(&cm, 0, sizeof cm);
+	ex = swg_e_call_secret(x, SWD4B_WLC_SET_VAR, "WLC_SET_VAR join", "join", rj->join, SWJ_EXT_JOIN_V1_SIZE, 5u + SWJ_EXT_JOIN_V1_SIZE, 1, 0u, NULL, 1, &cm);
+	x->krefresh = 0u;
+	if (ex != 0 || x->d4dstop) {
+		return ex < 0 ? ex : 0;
+	}
+	if (cm.status != 0) {
+		printf("WIFI GAP: keep rejoin: join refused status=%d\n", (int)cm.status);
+		return swl25_rj_fail(x, rj, "join refused");
+	}
+	rj->t_phase = rj->now;
+	return 0;
+}
+
+/* SET_SSID 0 and LINK up were seen: the AP of the join (WLC_GET_BSSID) and the RSNE of the association request the firmware sent are read, the supplicant is set up with the kept PMK and the EAPOL divert is switched on. 0 = done, negative = stopped */
+static inline int
+swl25_rj_to_keying(struct swg_wx *x, struct swl25_rj *rj)
+{
+	struct swl25h *h = rj->h;
+	struct swd4b_ioctl_d2h cm;
+	uint8_t rsp[8];
+	const uint8_t *ra;
+	uint32_t ral;
+	int ex;
+
+	rj->where = "to_keying";
+	x->krefresh = 1u;
+	memset(rsp, 0, sizeof rsp);
+	memset(&cm, 0, sizeof cm);
+	ex = swg_e_call(x, SWL25_WLC_GET_BSSID, "WLC_GET_BSSID", "", NULL, 0u, 6u, 1, 6u, rsp, 1, &cm, NULL);
+	if (ex != 0 || x->d4dstop) {
+		x->krefresh = 0u;
+		return ex < 0 ? ex : 0;
+	}
+	if (cm.status != 0 || cm.resp_len < 6u || swl25_zero(rsp, 6u)) {
+		x->krefresh = 0u;
+		printf("WIFI GAP: keep rejoin: WLC_GET_BSSID status=%d resp_len %u (or all zero)\n", (int)cm.status, cm.resp_len);
+		return swl25_rj_fail(x, rj, "BSSID not read");
+	}
+	memcpy(rj->bssid, rsp, 6);
+	ex = swl25_assoc_rsne_read(x, h);
+	x->krefresh = 0u;
+	if (ex != 0 || x->d4dstop) {
+		return ex < 0 ? ex : 0;
+	}
+	ra = h->arsne_len != 0u ? h->arsne : rj->rsne_assoc;
+	ral = h->arsne_len != 0u ? h->arsne_len : rj->rsne_assoc_len;
+	if (swj_ctx_init_ex(&h->sup, rj->pmk, h->l.mac, rj->bssid, ra, ral, rj->rsne_beacon, rj->rsne_beacon_len, h->arsne_len != 0u) != 0) {
+		return swl25_rj_fail(x, rj, "supplicant not set up (RSNE)");
+	}
+	h->hs_done = 0u;
+	h->want_keys = 0u;
+	rj->m4_seen = 0u;
+	rj->eapol_on = 1u;
+	x->rj_state = SWG_RJ_KEYING;
+	rj->t_phase = rj->now;
+	printf("SWEET WLAN: keep rejoin: joined (SET_SSID 0 + LINK up), host 4-way starts (assoc RSNE %s)\n", h->arsne_len != 0u ? "read from the firmware" : "from the boot run");
+	return 0;
+}
+
+/* wsec_key for the re-join: as swl25_setkey, but a refused status fails the ATTEMPT (*bad), it does not stop the engine: the data path of an up-again link is worth more than the optional re-join. 0 = done, negative = stopped */
+static inline int
+swl25_rj_setkey(struct swg_wx *x, uint8_t kb[SWJ_WSEC_KEY_SIZE], const char *kind, int *bad)
+{
+	struct swd4b_ioctl_d2h cm;
+	int ex;
+
+	memset(&cm, 0, sizeof cm);
+	ex = swg_e_call_secret(x, SWD4B_WLC_SET_VAR, "WLC_SET_VAR wsec_key", "wsec_key", kb, SWJ_WSEC_KEY_SIZE, 9u + SWJ_WSEC_KEY_SIZE, 1, 0u, NULL, 1, &cm);
+	swl25_wipe(kb, SWJ_WSEC_KEY_SIZE);
+	if (ex != 0 || x->d4dstop) {
+		return ex != 0 ? ex : -1;
+	}
+	if (cm.status != 0) {
+		printf("WIFI GAP: keep rejoin: wsec_key %s refused status=%d\n", kind, (int)cm.status);
+		*bad = 1;
+	}
+	return 0;
+}
+
+/* M4 has left (or its wait ran out): wsec_key pairwise and group, the wsec merge (the whitelisted calls of the boot path, new use after the hand-over), then the live link values, then UP. 0 = done (UP or back to DOWN), negative = stopped */
+static inline int
+swl25_rj_finish(struct swg_wx *x, struct swl25_rj *rj)
+{
+	struct swl25h *h = rj->h;
+	uint8_t kb[SWJ_WSEC_KEY_SIZE], rsp[4], buf[16];
+	struct swd4b_ioctl_d2h cm;
+	uint32_t cur, nl;
+	int ex, bad = 0;
+
+	rj->where = "finish";
+	rj->eapol_on = 0u;       /* a rekey or a late M3 is not answered from here on */
+	x->krefresh = 1u;
+	if (swj_wsec_key_pairwise(&h->sup, kb) != 0) {
+		x->krefresh = 0u;
+		swl25_wipe(kb, sizeof kb);
+		return swl25_rj_fail(x, rj, "pairwise key not buildable");
+	}
+	ex = swl25_rj_setkey(x, kb, "pairwise", &bad);
+	if (ex == 0 && !x->d4dstop && !bad) {
+		if (swj_wsec_key_group(&h->sup, kb) != 0) {
+			swl25_wipe(kb, sizeof kb);
+			bad = 1;
+			printf("WIFI GAP: keep rejoin: group key not buildable\n");
+		} else {
+			ex = swl25_rj_setkey(x, kb, "group", &bad);
+		}
+	}
+	if (ex != 0 || x->d4dstop) {
+		x->krefresh = 0u;
+		return ex < 0 ? ex : 0;
+	}
+	if (bad) {
+		x->krefresh = 0u;
+		return swl25_rj_fail(x, rj, "key install refused");
+	}
+	memset(&cm, 0, sizeof cm);
+	ex = swg_e_call(x, SWD4B_WLC_GET_VAR, "WLC_GET_VAR wsec", "wsec", NULL, 4u, 5u + 4u, 1, 4u, rsp, 1, &cm, NULL);
+	if (ex != 0 || x->d4dstop) {
+		x->krefresh = 0u;
+		return ex < 0 ? ex : 0;
+	}
+	if (cm.status != 0 || cm.resp_len < 4u) {
+		x->krefresh = 0u;
+		return swl25_rj_fail(x, rj, "wsec get refused");
+	}
+	cur = swd4b_get32(rsp);
+	nl = swj_var_u32(buf, sizeof buf, "wsec", swj_wsec_merge(cur, SWJ_WSEC_AES));
+	memset(&cm, 0, sizeof cm);
+	ex = nl != 0u ? swg_e_call(x, SWD4B_WLC_SET_VAR, "WLC_SET_VAR wsec", "wsec", buf + 5, 4u, nl, 1, 0u, NULL, 1, &cm, NULL) : 0;
+	if (ex != 0 || x->d4dstop) {
+		x->krefresh = 0u;
+		return ex < 0 ? ex : 0;
+	}
+	if (nl == 0u || cm.status != 0) {
+		x->krefresh = 0u;
+		return swl25_rj_fail(x, rj, "wsec merge refused");
+	}
+	swl25_wipe(h->sup.tptk, sizeof h->sup.tptk);       /* the keys are in the dongle now */
+	swl25_wipe(h->sup.gtk, sizeof h->sup.gtk);
+	swl25_wipe(h->sup.pmk, sizeof h->sup.pmk);
+	h->sup.install_ptk = h->sup.install_gtk = 0;
+	h->hs_done = 1u;
+	h->live_ok = 0u;
+	ex = swl25_live(x, h);       /* BSSID, chanspec, RSSI (read-only GETs, whitelist rows 8-10) */
+	x->krefresh = 0u;
+	if (ex != 0 || x->d4dstop) {
+		return ex < 0 ? ex : 0;
+	}
+	if (x->rj_lost) {       /* review 0282 F3: a loss event decoded inside one of the ioctls above: the keys are in a dead association, no UP */
+		return swl25_rj_fail(x, rj, "link lost while the keys went in");
+	}
+	if ((h->live_ok & 2u) != 0u) {
+		memcpy(rj->bssid, h->live_bssid, 6);
+	}
+	rj->chan = h->live_chan;
+	rj->rssi = h->live_rssi;
+	rj->ok = h->live_ok | 3u;       /* ssid: unchanged (the kept SSID), bssid: rj->bssid always holds the joined AP */
+	rj->up_new = 1u;
+	rj->n_up++;
+	x->klink = 0u;
+	x->kl_new = 0u;
+	x->rj_state = SWG_RJ_UP;
+	x->rj_ssid = x->rj_link = 0u;
+	printf("SWEET WLAN: keep rejoin UP after %u attempts, %llu ms\n", rj->n, (unsigned long long)(rj->now - rj->t_down));
+	rj->n = 0u;
+	rj->down_seen = 0u;
+	return 0;
+}
+
+/* the keep thread's call, once per pass under the en0 lock, after the ring-2 and en0 polls. `now` in ms; `m4_busy` = the tx buffer of the M4 reply is not yet completed (the thread asks en0). 0 = done, negative = the bus stopped */
+static inline int
+swl25_rj_step_core(struct swg_wx *x, struct swl25_rj *rj, uint64_t now, int m4_busy, int tx_ok)
+{
+	struct swl25h *h = rj->h;
+
+	rj->now = now;
+	if (x->klink == 0u || x->rj_state == SWG_RJ_UP) {
+		return 0;
+	}
+	if (!rj->armed || h == NULL) {
+		if (!rj->noarm_gap) {
+			rj->noarm_gap = 1u;
+			swl_gap("keep", "link lost, no kept join payload / PMK: no re-join", "high");
+			printf("WIFI GAP: keep rejoin: the link is DOWN but the join payload and PMK are not kept: no re-join\n");
+		}
+		return 0;
+	}
+	if (!rj->down_seen) {
+		rj->down_seen = 1u;
+		rj->t_down = now;
+		rj->t_next = now;
+		rj->n = 0u;
+	}
+	switch (x->rj_state) {
+	case SWG_RJ_DOWN:
+		return now >= rj->t_next ? swl25_rj_attempt(x, rj) : 0;
+	case SWG_RJ_JOINING:
+		if (x->rj_lost) {       /* review 0282 F3 */
+			return swl25_rj_fail(x, rj, "link lost while joining");
+		}
+		if (x->rj_ssid && x->rj_link) {
+			return swl25_rj_to_keying(x, rj);
+		}
+		if (now - rj->t_phase >= SWG_J_BUDGET_MS) {
+			return swl25_rj_fail(x, rj, "no SET_SSID 0 + LINK up in the join budget");
+		}
+		return 0;
+	case SWG_RJ_KEYING:
+		if (x->rj_lost) {       /* review 0282 F3: never finish on a dead link */
+			return swl25_rj_fail(x, rj, "link lost during the 4-way");
+		}
+		if (rj->m4_pending) {   /* review 0282 F6: the M4 counts as sent only when en0 posted it */
+			rj->m4_pending = 0u;
+			if (!tx_ok) {
+				printf("WIFI GAP: keep rejoin: the M4 reply could not be posted\n");
+				return swl25_rj_fail(x, rj, "M4 not posted");
+			}
+			rj->m4_seen = 1u;
+			rj->m4_ms = now;
+		}
+		if (h->sup.install_ptk && h->sup.install_gtk && rj->m4_seen) {
+			if (m4_busy && now - rj->m4_ms < SWL25_RJ_TXWAIT_MS) {
+				return 0;
+			}
+			if (m4_busy) {
+				printf("WIFI GAP: keep rejoin: M4 tx status not seen in %u ms, keys installed anyway\n", SWL25_RJ_TXWAIT_MS);
+				swl_gap("keep", "re-join: M4 tx status not seen", "medium");
+			}
+			return swl25_rj_finish(x, rj);
+		}
+		if (now - rj->t_phase >= SWG_J_BUDGET_MS) {
+			return swl25_rj_fail(x, rj, "4-way not complete in the budget");
+		}
+		return 0;
+	default:
+		return 0;
+	}
+}
+
+/* the keep thread's call (review 0282 F1). A soft stop (x->d4dstop with the bus alive) inside any ioctl of the re-join must not end the keep engine: it is cleared as the RSSI refresh does, the re-join is OFF for the rest of the boot
+ * (a late completion of the stopped ioctl must not meet a new request), the kept PMK / join payload AND the supplicant's copy are wiped, the payload buffer is scrubbed when its completion was consumed, one GAP names the step. The link stays
+ * DOWN for iOS. A hard stop (negative, x->stopped) is the data path's. `tx_ok` = en0 posted the last EAPOL reply. 0 = done, negative = the bus stopped */
+static inline int
+swl25_rj_step(struct swg_wx *x, struct swl25_rj *rj, uint64_t now, int m4_busy, int tx_ok)
+{
+	char gb[64];
+	const char *where;
+	int ex;
+
+	if (x->rj_off) {
+		return 0;
+	}
+	rj->where = "step";
+	ex = swl25_rj_step_core(x, rj, now, m4_busy, tx_ok);
+	if (x->d4dstop && !x->stopped && !(rj->where != NULL && strcmp(rj->where, "drain") == 0)) {       /* some inner paths return -1 for a soft stop: the engine flag decides, not the return value (ex is the scrub's result below) */
+		where = rj->where != NULL ? rj->where : "step";
+		x->d4dstop = 0u;
+		x->rj_off = 1u;
+		x->krefresh = 0u;
+		x->rj_state = SWG_RJ_DOWN;
+		x->rj_ssid = x->rj_link = 0u;
+		swg_e_wipe_b();
+		swl25_rj_wipe(rj, "soft stop in re-join");
+		snprintf(gb, sizeof gb, "re-join off: soft stop in %.30s", where);
+		swl_gap("keep", gb, "high");
+		printf("WIFI GAP: keep rejoin disabled: soft stop in %s\n", where);
+		if (x->esec_left && !x->esec_done) {       /* review 0282 F5: the stop came before the ioctl completion: nothing may be written to the buffer */
+			printf("WIFI GAP: keep rejoin: the stop came before the ioctl completion, the DMA ioctl buffer may hold secret bytes until the next ioctl\n");
+			swl_gap("keep", "re-join: ioctl buffer may hold secret bytes", "low");
+		}
+		ex = swg_e_scrub(x);       /* the payload buffer, when the completion was consumed (no ioctl in transit); a dead bus here is the data path's stop (negative) */
+	}
+	return ex;
+}
+
+/* the en0 receive hook for EAPOL (wlan_en0.h en0_eapol_fn): while KEYING the frame goes to the host supplicant (swj_rx: M1 -> M2, M3 -> M4, the same code as the boot loop) and the reply, if any, is left in out[0..*olen) for en0 to send. 0 = the frame is consumed;
+ * -1 = no 4-way in progress, the caller drops it with a GAP */
+static inline int
+swl25_rj_eapol(void *ctx, const uint8_t *f, uint32_t len, uint8_t *out, uint32_t outcap, uint32_t *olen)
+{
+	struct swl25_rj *rj = ctx;
+	struct swl25h *h = rj->h;
+	int r;
+
+	*olen = 0u;
+	if (!rj->eapol_on || h == NULL) {
+		return -1;
+	}
+	rj->eapol_rx++;
+	if (h->sup.install_ptk != 0 && h->sup.install_gtk != 0 && len >= SWJ_ETH_HLEN + SWJ_KEY_FIXED &&
+	    (swj_be16(f + SWJ_ETH_HLEN + SWJ_OFF_INFO) & SWJ_KI_FLAGS) == (SWJ_KI_PAIRWISE | SWJ_KI_ACK)) {
+		/* review 0282 F4: an M1 after an accepted M3 (the AP restarted, or a spoof: M1 has no MIC) would re-derive the PTK the AP never confirmed; dropped, loudly (the boot path drops all EAPOL after its keys, SWJ_GAP_X_REKEY) */
+		rj->eapol_m1_late++;
+		printf("WIFI GAP: keep rejoin: M1 after M3 dropped (the AP restarted its 4-way or the frame is forged)\n");
+		swl_gap("keep", "re-join: M1 after M3 dropped", "medium");
+		return 0;
+	}
+	r = swj_rx(&h->sup, f, len, out, outcap, olen);
+	if (r == SWJ_RX_REPLY && *olen > 0u) {
+		rj->eapol_tx++;
+		if (h->sup.state == SWJ_PTK_DONE && h->sup.install_ptk != 0 && h->sup.install_gtk != 0) {       /* the reply to M3 (M4): the keys are due once en0 has posted it (review 0282 F6) */
+			rj->m4_pending = 1u;
+		}
+	} else {
+		*olen = 0u;
+	}
+	return 0;
+}
+
+/* the thread takes the UP result once, outside the lock, to tell iOS: 1 = fresh (bssid, channel, rssi and the ok bits for sweet_wlan_a80211_kept_up) */
+static inline int
+swl25_rj_take_up(struct swl25_rj *rj, uint8_t bssid[6], uint32_t *chan, int32_t *rssi, uint32_t *ok)
+{
+	if (!rj->up_new) {
+		return 0;
+	}
+	rj->up_new = 0u;
+	memcpy(bssid, rj->bssid, 6);
+	*chan = rj->chan;
+	*rssi = rj->rssi;
+	*ok = rj->ok;
+	return 1;
+}
+
+/* ---- patch 0292 (WIFI-COVERAGE D3/D4: Settings > Wi-Fi lists the networks around): the keep-phase SCAN, driven by the keep thread like the re-join (swl25_rj_step), under the same en0 lock; the engine has no other user.
+ * Flow [src docs/research/110-apple80211-io80211-ios167.md s.8.1 row 10 and s.4/s.5; docs/research/W-D7-a80211-get-layouts.md S5, E6]: iOS Set 10 SCAN_REQ -> sweet_wlan_radio.h swr_scan_start -> swl25_sc_request (any thread, no engine access: one flag) ->
+ * the keep thread's swl25_sc_step sends ONE firmware command, WLC_SET_VAR "escan" (the passive START of swg_e_escan_arg with chans == 0: the 80 B form, channel_num 0 = every channel the firmware's regulatory list allows [src brcmfmac/bwfm: n_channels 0 = all channels], judged by the L25 whitelist row 19 / swl25w_chk_escan) and collects the ESCAN_RESULT events that follow
+ * (ring 2 -> swg_ke_event -> swg_ke_escan -> x->scansink: status 8 = PARTIAL carries one bss record, status 0 = SUCCESS ends the scan [src brcmfmac fweh.h WLC_E_STATUS_PARTIAL / SUCCESS, OpenBSD bwfmreg.h; SWG_E_ST_*]) -> when status 0 is seen, or the budget runs out, or the link is lost,
+ * the thread hands the result to iOS outside the en0 lock (sweet_wlan_a80211_scan_done -> SCAN_DONE kev 10, then wifid's Get 11 loop).
+ * Rules: ONE scan at a time (the radio's `scanning` flag and state/req here); a scan is started only while the link is UP (x->klink == 0 and x->rj_state == SWG_RJ_UP) and the re-join machine (swl25_rj_step) is not called while a scan runs: a link loss ENDS the scan first (kind LINKLOST,
+ * what was collected is delivered), the re-join starts in the same or the next pass; a scan is never started while a re-join runs. Budget SWL25_SC_BUDGET_MS, then SCAN_DONE with what was collected and a GAP. A soft stop inside the escan ioctl turns the scan off for the rest of the boot
+ * (GAP), the data path goes on. The scan is a passive scan of ALL channels the firmware allows (channel_num 0; the BOOT scan keeps its seven bring-up channels at lv >= 24) with the firmware's default home time. [guess, not observed: that it keeps the association; the boot scan ran BEFORE the join (L23 < L24), no scan has been seen with the association up; bcmdhd scans while connected and cancels a running scan only before a connect, wl_cfg80211.c wl_do_preassoc_ops]
+ * The 12 s budget is a decision of this patch (no source): a passive scan of ~38 channels with home-channel returns while associated may need ~6 s [guess: ~110 ms dwell + ~45 ms home per channel, bcmdhd defaults]; on timeout the scan delivers what it has anyway. Review 0292 F2: every keep scan has its own sync_id (SWG_E_SYNC + 1 + (n - 1) % 255, x->escan_sync; the boot scan keeps 0x1234), so the late events of an old scan are events of another sync id (counted, GAP on the first and every 64th, F1) and can not end a new scan.
+ * F4: a link loss that ends a running scan holds the first re-join attempt (swl25_sc_idle is 0 while sc->hold) until the firmware reports the scan's end status or SWL25_SC_HOLD_MS pass (GAP if the bound expired); no abort command is sent (it would be a second new firmware command, another rule-8 review).
+ * F5: a firmware end status of our scan other than SUCCESS / PARTIAL (FAIL 1, TIMEOUT 2, ABORT 4, NEWSCAN 9, NEWASSOC 10, SUPPRESS 12, NOCHANS 13 [src refs/wlan-stage5/bcmevent.h.new:412-424]) ends it at once with a GAP naming the status.
+ * No SSID, BSSID or address is ever printed here. */
+#define SWL25_SC_BUDGET_MS 12000u        /* the scan ends after this long without SUCCESS; 12 s because an all-channel passive scan (~38 channels, home-channel returns while associated) may need ~6 s [guess: ~110 ms dwell + ~45 ms home per channel, bcmdhd defaults] [decision; the boot scan allows 8000: SWG_E_BUDGET_MS] */
+#define SWL25_SC_HOLD_MS   SWL25_SC_BUDGET_MS      /* review 0292 F4 + review 0293 LOW 1: after a link loss that ended a running scan the re-join waits at most the scan budget (12 s: the all-channel scan may run ~6 s [guess]) for the firmware's end status of that scan [decision, no source] */
+#define SWL25_SC_DEFER_MS  100u          /* a start that finds ring 2 busy is retried this much later */
+#define SWL25_SC_EBUSY     16u           /* errno values returned by swl25_sc_request (the radio maps them to its own refusal text) */
+#define SWL25_SC_ENXIO     6u
+#define SWL25_SC_ENETDOWN  50u
+enum { SWL25_SC_IDLE = 0, SWL25_SC_RUN = 1 };
+enum { SWL25_SCR_NONE = 0, SWL25_SCR_COMPLETE = 1, SWL25_SCR_TIMEOUT = 2, SWL25_SCR_LINKLOST = 3, SWL25_SCR_FAILED = 4, SWL25_SCR_REFUSED = 5 };    /* the numbers sweet_wlan_radio.h SWR_SCAN_* use */
+
+struct swl25_sc {
+	volatile uint8_t req;            /* set by swl25_sc_request (iOS thread), cleared by the keep thread when it starts or refuses the scan */
+	volatile uint8_t state;          /* SWL25_SC_IDLE / SWL25_SC_RUN; written by the keep thread only */
+	volatile uint8_t off;            /* a soft stop in the scan ioctl, or the engine ended: no further scan this boot */
+	uint8_t res_new, res;            /* a finished scan waits for swl25_sc_take (kind SWL25_SCR_*) */
+	uint8_t defer_gap;
+	volatile uint8_t hold;           /* review 0292 F4: a link loss ended a running scan; the re-join waits (swl25_sc_idle is 0) until the firmware's end status or hold_until */
+	uint64_t hold_until;             /* ms */
+	uint64_t t0, t_next, t_defer;    /* ms: scan start, next start try, first deferral */
+	uint32_t ms, ev, part;           /* of the finished scan: duration, ESCAN_RESULT events of our sync id, of those PARTIAL */
+	uint32_t foreign;                /* of the finished scan: events of another sync id (review 0292 F1) */
+	uint32_t n_req, n_start, n_done, n_timeout, n_lost, n_failed, n_refused;
+};
+
+/* the radio asks for a scan (any thread, no engine access, no lock): 0 = accepted, SWL25_SC_ENXIO = the scan is off for this boot (the radio falls back to the boot-time listing, loudly), SWL25_SC_ENETDOWN = the link is not UP (the re-join owns the engine), SWL25_SC_EBUSY = one is pending or running */
+static inline int
+swl25_sc_request(struct swl25_sc *sc, const struct swg_wx *x)
+{
+	if (__atomic_load_n(&sc->off, __ATOMIC_ACQUIRE)) {
+		return (int)SWL25_SC_ENXIO;
+	}
+	if (x->klink != 0u || x->rj_state != SWG_RJ_UP) {
+		return (int)SWL25_SC_ENETDOWN;
+	}
+	if (__atomic_load_n(&sc->state, __ATOMIC_ACQUIRE) != SWL25_SC_IDLE || __atomic_load_n(&sc->req, __ATOMIC_ACQUIRE) != 0u || sc->res_new) {
+		return (int)SWL25_SC_EBUSY;
+	}
+	sc->n_req++;
+	__atomic_store_n(&sc->req, 1u, __ATOMIC_SEQ_CST);
+	if (__atomic_load_n(&sc->off, __ATOMIC_SEQ_CST)) {       /* review 0292 F3: store req, then load off (swl25_sc_abort stores off, then loads req): one of the two sees the other, so a request is never accepted after the end unseen. req stays set: if abort saw it, it answers it (the radio then has no scan to finish and prints its own GAP) */
+		return (int)SWL25_SC_ENXIO;
+	}
+	return 0;
+}
+
+static inline int
+swl25_sc_idle(const struct swl25_sc *sc)
+{
+	return __atomic_load_n(&sc->state, __ATOMIC_ACQUIRE) == SWL25_SC_IDLE && !__atomic_load_n(&sc->hold, __ATOMIC_ACQUIRE);       /* review 0292 F4: not idle while the re-join is held back after a link loss in a scan */
+}
+
+/* a scan ended (or was refused after the request): the result waits for swl25_sc_take. Counts and one GAP for everything but COMPLETE; no address, no name */
+static inline void
+swl25_sc_end(struct swg_wx *x, struct swl25_sc *sc, uint64_t now, uint8_t kind, const char *why)
+{
+	char gb[64];
+
+	x->sc_on = 0u;
+	sc->ms = sc->state == SWL25_SC_RUN && now >= sc->t0 ? (uint32_t)(now - sc->t0) : 0u;
+	sc->ev = x->sc_ev;
+	sc->part = x->sc_part;
+	sc->foreign = x->sc_foreign;
+	switch (kind) {
+	case SWL25_SCR_COMPLETE: sc->n_done++; break;
+	case SWL25_SCR_TIMEOUT: sc->n_timeout++; break;
+	case SWL25_SCR_LINKLOST: sc->n_lost++; break;
+	case SWL25_SCR_REFUSED: sc->n_refused++; break;
+	default: sc->n_failed++; break;
+	}
+	printf("SWEET WLAN: keep scan end: %s, %u events of ours (%u partial), %u of another sync id, %u ms\n",
+	    kind == SWL25_SCR_COMPLETE ? "complete" : kind == SWL25_SCR_TIMEOUT ? "timeout" : kind == SWL25_SCR_LINKLOST ? "link lost" : kind == SWL25_SCR_REFUSED ? "refused" : "failed", sc->ev, sc->part, sc->foreign, sc->ms);
+	if (kind != SWL25_SCR_COMPLETE) {
+		printf("WIFI GAP: keep scan not complete (%s): %s; %u events of ours (%u partial), %u ms; what was collected is delivered\n",
+		    kind == SWL25_SCR_TIMEOUT ? "timeout" : kind == SWL25_SCR_LINKLOST ? "link lost" : kind == SWL25_SCR_REFUSED ? "refused" : "failed", why, sc->ev, sc->part, sc->ms);
+		snprintf(gb, sizeof gb, "keep scan %s", kind == SWL25_SCR_TIMEOUT ? "timed out" : kind == SWL25_SCR_LINKLOST ? "ended: link lost" : kind == SWL25_SCR_REFUSED ? "refused" : "failed");
+		swl_gap("scan", gb, "medium");
+	}
+	if (kind == SWL25_SCR_LINKLOST) {       /* review 0292 F4: the escan may still run in the firmware: hold the re-join until its end status or the bound */
+		x->sc_await = 1u;
+		x->sc_await_done = (x->sc_termd || x->sc_complete) ? 1u : 0u;    /* review 0292 N1: an end status already seen in the same drain as the DEAUTH counts (no false 2 s wait) */
+		sc->hold_until = now + SWL25_SC_HOLD_MS;
+		__atomic_store_n(&sc->hold, 1u, __ATOMIC_RELEASE);
+	}
+	sc->res = kind;
+	sc->res_new = 1u;
+	sc->req = 0u;
+	__atomic_store_n(&sc->state, (uint8_t)SWL25_SC_IDLE, __ATOMIC_RELEASE);
+}
+
+/* one call per keep pass, under the en0 lock, BEFORE swl25_rj_step. 0 = done, negative = the bus stopped (a soft stop inside the escan ioctl is cleared here, the scan goes off). `now` = ms */
+static inline int
+swl25_sc_step(struct swg_wx *x, struct swl25_sc *sc, uint64_t now)
+{
+	uint8_t arg[96];
+	struct swd4b_ioctl_d2h cm;
+	uint32_t v = 0u;
+	int ex;
+	char why[128];
+
+	if (sc->hold) {         /* review 0292 F4 */
+		if (x->sc_await_done) {
+			printf("SWEET WLAN: keep scan: the firmware ended the scan cut short by the link loss (status %u) after %u ms, the re-join may start\n", x->sc_term, now >= sc->hold_until - SWL25_SC_HOLD_MS ? (uint32_t)(now - (sc->hold_until - SWL25_SC_HOLD_MS)) : 0u);
+			x->sc_await = 0u;
+			__atomic_store_n(&sc->hold, 0u, __ATOMIC_RELEASE);
+		} else if (now >= sc->hold_until) {
+			printf("WIFI GAP: keep scan: no end status of the scan cut short by the link loss within %u ms; the re-join starts with the escan possibly still running in the firmware\n", SWL25_SC_HOLD_MS);
+			swl_gap("scan", "re-join started without the end status of the cut-short scan", "low");
+			x->sc_await = 0u;
+			__atomic_store_n(&sc->hold, 0u, __ATOMIC_RELEASE);
+		}
+	}
+	if (sc->state == SWL25_SC_RUN) {
+		if (x->klink != 0u || x->rj_state != SWG_RJ_UP) {
+			swl25_sc_end(x, sc, now, SWL25_SCR_LINKLOST, "the link went down during the scan; the escan is not aborted (no abort command is sent), the re-join waits for its end status or a short bound");
+		} else if (x->sc_termd) {       /* review 0292 F5: the firmware ended our scan with a status other than SUCCESS */
+			snprintf(why, sizeof why, "the firmware ended the scan with status %u (abort 4, new scan 9, new assoc 10, ...), not SUCCESS", x->sc_term);
+			swl25_sc_end(x, sc, now, SWL25_SCR_FAILED, why);
+		} else if (x->sc_complete) {
+			swl25_sc_end(x, sc, now, SWL25_SCR_COMPLETE, "");
+		} else if (now - sc->t0 >= SWL25_SC_BUDGET_MS) {
+			swl25_sc_end(x, sc, now, SWL25_SCR_TIMEOUT, "no ESCAN_RESULT SUCCESS in the budget");
+		}
+		return 0;
+	}
+	if (sc->req == 0u) {
+		return 0;
+	}
+	if (sc->off) {
+		swl25_sc_end(x, sc, now, SWL25_SCR_REFUSED, "the scan is off for this boot");
+		return 0;
+	}
+	if (x->klink != 0u || x->rj_state != SWG_RJ_UP) {
+		swl25_sc_end(x, sc, now, SWL25_SCR_REFUSED, "requested while the link is not UP (the re-join owns the engine)");
+		return 0;
+	}
+	if (x->emajor != 2u && x->emajor != 3u) {
+		swl25_sc_end(x, sc, now, SWL25_SCR_REFUSED, "the scan version (scan_ver) was not read at boot");
+		return 0;
+	}
+	if (now < sc->t_next) {
+		return 0;
+	}
+	ex = swg_rssi_drain(x);       /* events of the keep phase are decoded and consumed first, as before the RSSI refresh and a re-join attempt */
+	if (ex < 0 || x->stopped) {
+		return -1;
+	}
+	if (x->d4dstop) {
+		return 0;       /* a stop raised by the drain is the data path's: the keep loop ends on it, the request stays unanswered (swl25_sc_abort answers it) */
+	}
+	if (swg_hrd(x, x->in.idx[SWG_IDX(SWD_IDX_D2H_W)], &v) || v == 0xFFFFFFFFu || (v & 0xFFFFu) != x->d4rd % SWG_R2_DEPTH) {
+		if (sc->t_defer == 0u) {
+			sc->t_defer = now;
+		}
+		if (now - sc->t_defer >= SWL25_SC_BUDGET_MS) {
+			swl25_sc_end(x, sc, now, SWL25_SCR_FAILED, "ring 2 never idle in the budget");
+			sc->t_defer = 0u;
+			return 0;
+		}
+		sc->t_next = now + SWL25_SC_DEFER_MS;
+		if (!sc->defer_gap) {
+			sc->defer_gap = 1u;
+			printf("SWEET WLAN: keep scan: ring 2 not idle, the start waits %u ms (not counted)\n", SWL25_SC_DEFER_MS);
+		}
+		return 0;
+	}
+	sc->t_defer = 0u;
+	sc->defer_gap = 0u;
+	sc->n_start++;
+	sc->t0 = now;
+	x->sc_complete = 0u;
+	x->sc_ev = x->sc_part = x->sc_other = x->sc_foreign = 0u;
+	x->sc_termd = 0u;
+	x->sc_term = 0u;
+	x->sc_await = 0u;
+	x->escan_sync = (uint16_t)(SWG_E_SYNC + 1u + (sc->n_start - 1u) % 255u);       /* review 0292 F2: one id per scan, 0x1235..0x1333; the judge accepts exactly this one */
+	x->sc_on = 1u;        /* before the call: the events that arrive inside the ioctl count */
+	__atomic_store_n(&sc->state, (uint8_t)SWL25_SC_RUN, __ATOMIC_RELEASE);
+	sc->req = 0u;
+	swg_e_escan_arg(arg, x->emajor, 0, x->escan_sync);       /* chans == 0: the 80 B form, channel_num 0 = the firmware's own channel list */
+	printf("SWEET WLAN: keep scan start %u: passive escan, all channels, version %u, sync %#x, budget %u ms\n", sc->n_start, (unsigned)x->emajor, (unsigned)x->escan_sync, SWL25_SC_BUDGET_MS);
+	memset(&cm, 0, sizeof cm);
+	x->krefresh = 1u;
+	ex = swg_e_call(x, SWD4B_WLC_SET_VAR, "WLC_SET_VAR escan", "escan", arg, 80u, 6u + 80u, 1, 0u, NULL, 1, &cm, NULL);
+	x->krefresh = 0u;
+	if (ex < 0 || x->stopped) {
+		return ex < 0 ? ex : -1;
+	}
+	if (x->d4dstop) {
+		x->d4dstop = 0u;       /* a SOFT stop inside the optional scan ioctl: the data path is kept, the scan is off for this boot (as the RSSI refresh and the re-join do) */
+		sc->off = 1u;
+		swl25_sc_end(x, sc, now, SWL25_SCR_FAILED, "soft stop inside the escan ioctl; the scan is off for this boot");
+		return 0;
+	}
+	if (cm.status != 0) {
+		printf("WIFI GAP: keep scan: WLC_SET_VAR escan refused, status=%d\n", (int)cm.status);
+		swl25_sc_end(x, sc, now, SWL25_SCR_FAILED, "escan start refused by the firmware");
+	}
+	return 0;
+}
+
+/* the engine is going away (the keep thread ends) or a hard stop came: answer a pending or running scan so iOS is not left waiting, and refuse new ones. Runs on the keep thread without the en0 lock (the request side takes none either); the thread then delivers with swl25_sc_take. Review 0292 F3: store off, then load req, both seq_cst (the pair of swl25_sc_request) */
+static inline void
+swl25_sc_abort(struct swg_wx *x, struct swl25_sc *sc, uint64_t now, const char *why)
+{
+	__atomic_store_n(&sc->off, 1u, __ATOMIC_SEQ_CST);
+	if (sc->state == SWL25_SC_RUN || __atomic_load_n(&sc->req, __ATOMIC_SEQ_CST) != 0u) {
+		swl25_sc_end(x, sc, now, SWL25_SCR_FAILED, why);
+	}
+}
+
+/* the thread takes a finished scan once, outside the lock, to tell iOS: 1 = fresh (kind SWL25_SCR_*, duration, events of ours, partial ones) */
+static inline int
+swl25_sc_take(struct swl25_sc *sc, uint32_t *kind, uint32_t *ms, uint32_t *ev, uint32_t *part)
+{
+	if (!sc->res_new) {
+		return 0;
+	}
+	sc->res_new = 0u;
+	*kind = sc->res;
+	*ms = sc->ms;
+	*ev = sc->ev;
+	*part = sc->part;
+	return 1;
+}
+
+/* ---- ALL-ON T-32 (docs/research/138-wlan-keepalive.md): the firmware NULL-frame keep-alive. The house AP aged the idle phone out after ~22 min [obs 2026-11-11]; PixOS never configured a keep-alive, bcmdhd does (mkeep_alive, 30 s, id 0, null frame).
+ * ONE firmware command, WLC_SET_VAR "mkeep_alive" (swj_mkeep_alive_cmd, 23 B, judged by L25 whitelist row 20 / chk 6), sent by the keep thread under the en0 lock: the first point where the engine can send a plain SET_VAR is the keep phase, after the join,
+ * the host 4-way and the key install are done (the same thread owns the engine alone there, as for the RSSI refresh, the re-join and the scan); it is armed at the start of the keep loop and again after every `keep rejoin UP` (swl25_ka_arm).
+ * A firmware STATUS error (a completion with a non-zero status) changes nothing: one GAP line and the link goes on; one attempt per arm. A firmware TIMEOUT (no completion) is different [read from source, review 0313 F3: sweet_wlan_g2.h SWG_E_STOP is a soft stop, cleared here; the L25 judge's
+ * ioct_busy (sweet_wlan_l25_wl.h) is cleared only when a completion of that transaction is consumed, so the next keep ioctl, the RSSI refresh within 5 s, is refused by the judge; whether that refusal is a hard stop is read only from a comment, sweet_wlan_g2d.h:412): the same class as the RSSI refresh and the scan, not new. The setting is not read back: the reply layout of a mkeep_alive GET is not cited in
+ * research 138 (only the request id byte), so no GET row is added. Boot-arg sweetwlanka: exactly the string "0" turns it off (a GAP line says so), exactly "1" or absent = on, any other string is ignored with a GAP naming it (on). */
+struct swl25_ka {
+	uint8_t due, off;                /* an attempt is due; the feature is off for this boot (sweetwlanka=0, or a soft stop in its ioctl) */
+	uint8_t defer_gap;
+	uint32_t n_set, n_fail, n_arm;   /* accepted by the firmware, refused by the firmware, armed */
+	uint64_t t_next;                 /* ms: do not try before */
+	uint64_t t_defer;                /* ms: when ring 2 was first found busy for this send (0 = not busy); the wait ends in a GAP after SWL25_SC_BUDGET_MS */
+};
+
+/* sweetwlanka: `str` = the boot-arg's string (PE_parse_boot_arg_str), NULL = absent. Absent or exactly "1" = on; exactly "0" = off with a GAP; any other string (empty, "on", "2", ...) = on with a GAP naming the raw string. Returns 1 when on */
+static inline int
+swl25_ka_init(struct swl25_ka *ka, const char *str)
+{
+	memset(ka, 0, sizeof *ka);
+	if (str != NULL && strcmp(str, "0") == 0) {
+		ka->off = 1u;
+		printf("SWEET WLAN: GAP keep-alive off (sweetwlanka=0)\n");
+		swl_gap("keepalive", "keep-alive off (sweetwlanka=0)", "medium");
+		return 0;
+	}
+	if (str != NULL && strcmp(str, "1") != 0) {
+		printf("SWEET WLAN: GAP keep-alive sweetwlanka=\"%.8s\" ignored (only \"0\" or \"1\" are valid), keep-alive stays on\n", str);
+		swl_gap("keepalive", "sweetwlanka value ignored, keep-alive on", "low");
+	}
+	ka->due = 1u;        /* armed for the start of the keep phase */
+	ka->n_arm = 1u;
+	return 1;
+}
+
+/* the link came (back) UP: send once more (the setting may not survive a new association [guess]; setting it twice is harmless in bcmdhd, research 138 s.0 step 2) */
+static inline void
+swl25_ka_arm(struct swl25_ka *ka)
+{
+	if (!ka->off) {
+		ka->due = 1u;
+		ka->n_arm++;
+		ka->t_next = 0u;
+		ka->t_defer = 0u;
+		ka->defer_gap = 0u;
+	}
+}
+
+/* one call per keep pass, under the en0 lock. `busy` = a scan runs or holds the engine. Sends only while the link is UP and the re-join machine idle (UP), after a ring-2 drain and with ring 2 idle (as swl25_live_rssi). 0 = done / nothing to do, negative = the bus stopped
+ * (a soft stop inside the ioctl is cleared here and turns the keep-alive off, like the scan) */
+static inline int
+swl25_ka_step(struct swg_wx *x, struct swl25_ka *ka, uint64_t now, int busy)
+{
+	struct swj_cmd c;
+	struct swd4b_ioctl_d2h cm;
+	uint32_t v = 0u, nl;
+	int ex;
+
+	if (!ka->due || ka->off || busy || x->klink != 0u || x->rj_state != SWG_RJ_UP || now < ka->t_next) {
+		return 0;
+	}
+	ex = swg_rssi_drain(x);
+	if (ex < 0 || x->stopped) {
+		return -1;
+	}
+	if (x->d4dstop) {
+		return 0;        /* a stop raised by the drain is the data path's */
+	}
+	if (swg_hrd(x, x->in.idx[SWG_IDX(SWD_IDX_D2H_W)], &v) || v == 0xFFFFFFFFu || (v & 0xFFFFu) != x->d4rd % SWG_R2_DEPTH) {
+		if (ka->t_defer == 0u) {
+			ka->t_defer = now;
+		}
+		if (now - ka->t_defer >= SWL25_SC_BUDGET_MS) {        /* the scan's cap (swl25_sc_step): a ring that never goes idle ends the wait loudly */
+			ka->due = 0u;
+			ka->n_fail++;
+			ka->t_defer = 0u;
+			ka->defer_gap = 0u;
+			printf("SWEET WLAN: GAP keep-alive not sent: ring 2 never idle in %u ms\n", SWL25_SC_BUDGET_MS);
+			swl_gap("keepalive", "mkeep_alive not sent, ring 2 never idle in the budget", "high");
+			return 0;
+		}
+		ka->t_next = now + SWL25_SC_DEFER_MS;
+		if (!ka->defer_gap) {
+			ka->defer_gap = 1u;
+			printf("SWEET WLAN: keep-alive: ring 2 not idle, the send waits %u ms (not counted)\n", SWL25_SC_DEFER_MS);
+		}
+		return 0;
+	}
+	ka->defer_gap = 0u;
+	ka->t_defer = 0u;
+	ka->due = 0u;        /* one attempt per arm, whatever follows */
+	if (swj_mkeep_alive_cmd(&c, SWJ_MKEEP_PERIOD_MS) != 1u) {
+		ka->n_fail++;
+		printf("SWEET WLAN: GAP keep-alive mkeep_alive command not built\n");
+		swl_gap("keepalive", "mkeep_alive command not built", "high");
+		return 0;
+	}
+	nl = (uint32_t)strlen("mkeep_alive");
+	memset(&cm, 0, sizeof cm);
+	x->krefresh = 1u;
+	ex = swg_e_call(x, SWD4B_WLC_SET_VAR, "WLC_SET_VAR mkeep_alive", "mkeep_alive", c.buf + nl + 1u, c.len - nl - 1u, c.len, 1, 0u, NULL, 1, &cm, NULL);
+	x->krefresh = 0u;
+	if (x->stopped || ex < 0) {
+		return ex < 0 ? ex : -1;
+	}
+	if (x->d4dstop) {
+		x->d4dstop = 0u;        /* a SOFT stop inside this optional ioctl: the data path is kept, the keep-alive is off for this boot */
+		ka->off = 1u;
+		ka->n_fail++;
+		printf("SWEET WLAN: GAP keep-alive off: soft stop inside the mkeep_alive ioctl (no completion: the ioctl stays in transit for the L25 judge, the next keep ioctl, e.g. the RSSI refresh, is refused)\n");
+		swl_gap("keepalive", "soft stop inside the mkeep_alive ioctl (no completion), keep-alive off, next keep ioctl refused by the judge", "high");
+		return 0;
+	}
+	if (cm.status != 0) {
+		ka->n_fail++;
+		printf("SWEET WLAN: GAP keep-alive mkeep_alive rejected status %d\n", (int)cm.status);
+		swl_gap("keepalive", "mkeep_alive rejected by the firmware, the link goes on without it", "medium");
+		return 0;
+	}
+	ka->n_set++;
+	printf("SWEET WLAN: keep-alive set period %u ms id %u (null frame)\n", (unsigned)SWJ_MKEEP_PERIOD_MS, (unsigned)SWJ_MKEEP_ID);
+	return 0;
+}
+
+/* review 0363 finding 4 (rule 7): sweetprobe=1 armed the Wi-Fi probes but swl25_run ended without reaching them: say so, once per arming */
+static int
+swl25_probe_unreached(int ex)
+{
+	if (swl25_probe_arm != 0u) {
+		printf("SWEET PROBE: GAP wifi probes armed but not reached in this L25 run (mask %u, ex %d)\n", (unsigned)swl25_probe_arm, ex);
+		swl25_probe_arm = 0u;
+	}
+	return ex;
+}
+
+static struct swl25h swl25_H;        /* file scope on purpose: ~36 KB of BSS, not stack; the host test inspects the wiped key fields */
+
+static int
+swl25_run_inner(struct swg_wx *x, unsigned lv)
+{
+	int ex;
+
+	memset(&swl25_H, 0, sizeof swl25_H);
+	ex = swl25_assoc_rsne(x, &swl25_H);
+	if (ex != 0 || x->d4dstop) {
+		return ex;
+	}
+	if (x->bssget != NULL && x->l25c != NULL) {       /* patch 0288: a join target the scan never saw gets its BSSID and RSNE from WLC_GET_BSS_INFO (one read-only GET) before swl25_go reads the cfg */
+		ex = x->bssget(x);
+		if (ex != 0 || x->d4dstop) {
+			return ex;
+		}
+	}
+	ex = swl25_go(x, lv, &swl25_H);
+	swl25_wipe(&swl25_H.sup, sizeof swl25_H.sup);       /* pmk, tptk, gtk: on every path */
+	return ex;
+}
+
+static int
+swl25_run(struct swg_wx *x, unsigned lv)
+{
+	return swl25_probe_unreached(swl25_run_inner(x, lv));       /* review 0363 finding 4: on every exit path of the run */
+}
+
+#endif /* SWEET_WLAN_L25_HS_H */
diff --git a/bsd/dev/sweet_wlan_l25_rsne.h b/bsd/dev/sweet_wlan_l25_rsne.h
new file mode 100644
index 00000000..276f8f65
--- /dev/null
+++ b/bsd/dev/sweet_wlan_l25_rsne.h
@@ -0,0 +1,377 @@
+/*
+ * L23 -> L25 hand-off of the target AP's RSNE (T-37d8 step 1 = steps 2-4 of T-baed; SPEC-WIFI Part E TRANSPORT s.1 item 1, s.2 L25, U-g).
+ *
+ * The L23 escan hands every parsed bss record to the hook x->bssn (sweet_wlan_g2.h swg_e_event). swl25r_note, installed there by the glue (or the host test) with
+ * x->bssc = &struct swl25_tgt, looks at the record whose BSSID equals the join target and copies the FIRST RSN element (id 48) out of the record's information elements
+ * into tgt->rsne (the whole element: id, length, body; at most SWL25R_RSNE_MAX = SWJ_RSNE_MAX bytes). The engine (swl25_go) reads it from there through the cfg the glue builds (T-37d8 step 3).
+ * Everything it reads is a read of the event buffer (host memory the dongle wrote, G1 block, through swg_e_rdb); it stores nothing on any bus.
+ *
+ * Record layout [src refs/wlan-stage5/wlioctl.h.new:355-397 wl_bss_info_v109_t, offsets computed by a host compile in wlan_rsne_host_test.c with MCSSET_LEN = 16]:
+ *   +4 length (u32: bytes of the record incl. IEs) | +116 ie_offset (u16) | +120 ie_length (u32) | the IEs start ie_offset bytes into the record.
+ * MCSSET_LEN is NOT defined in the ref set [guess: 16, the Broadcom value]. A wrong value moves ie_offset/ie_length, so they are never trusted alone: the record must satisfy
+ *   ie_offset >= 124, ie_offset + ROUNDUP4(ie_length) == length, length <= bytes the event carries
+ * [src wl_cfg80211.c.new:14374-14400 wl_validate_bss_length: length = sizeof(struct) + ROUNDUP(ie_length, 4)], and the IE chain must tile ie_length bytes up to the RSNE; any failure is a
+ * `WIFI GAP: RSNE ...` line (rule 8), tgt->state = SWL25R_BAD, no RSNE. The first run's log line `L23 rsne record` (length, ie_offset, ie_length) settles the guess [guess until observed].
+ * Open: the scan sees the target only if the escan delivers it (a PARTIAL event carries bss_count records, only the first is parsed, g2.h GAP "bss_count above 1"); a target never seen is a GAP in swl25r_status.
+ *
+ * Include order in the includer: sweet_wlan_data.h (SWDP_LOG/SWDP_GAP), sweet_wlan_join.h, sweet_wlan_g2.h, then this file.
+ */
+#ifndef SWEET_WLAN_L25_RSNE_H
+#define SWEET_WLAN_L25_RSNE_H
+
+#ifndef SWEET_WLAN_G2_H
+#error "sweet_wlan_l25_rsne.h needs sweet_wlan_g2.h first"
+#endif
+
+#define SWL25R_OFF_LEN   4u             /* wl_bss_info_v109 length */
+#define SWL25R_OFF_IEOFF 116u           /* ie_offset (u16) */
+#define SWL25R_OFF_IELEN 120u           /* ie_length (u32) */
+#define SWL25R_HEAD      124u           /* bytes up to and including ie_length: the least a record can have */
+#define SWL25R_IE_RSN    48u            /* WLAN_EID_RSN */
+#define SWL25R_RSNE_MAX  64u            /* = struct swl25_cfg.rsne_*[64] = SWJ_RSNE_MAX */
+#define SWL25R_MAXIE     128u           /* IEs walked per record at most */
+#define SWL25R_IE_KEEP   1024u          /* 2026-11-11 (Get 103 of the kept link): bytes of the target record's IE block kept whole (the iOS record's IE capacity); the radio cuts it to its own cap at an IE boundary and tells every loss */
+
+enum { SWL25R_NONE = 0, SWL25R_OK, SWL25R_BAD };
+
+struct swl25_tgt {
+	uint8_t bssid[6];               /* the join target (from the join payload); all zero = wildcard: nothing is looked for, swl25r_status prints the GAP */
+	uint8_t state;                  /* SWL25R_NONE = target record not seen yet, OK = rsne holds the element, BAD = a record was seen but unusable (GAP printed) */
+	uint8_t seen;                   /* records of the target looked at */
+	uint8_t ssid_len, other;        /* T-fc10 H2: wildcard join: the SSID (<= 32 B) the first scan record of which names the target (its BSSID is then filled into `bssid`), and how many records of the same SSID but another BSSID were skipped; ssid_len 0 = BSSID given by the caller */
+	uint8_t ssid[32];
+	uint8_t rsne[SWL25R_RSNE_MAX];
+	uint32_t rsne_len;
+	uint8_t via_bss_info;           /* patch 0288: the record came from WLC_GET_BSS_INFO (the scan never saw the AP), for the re-join's log line */
+	/* 2026-11-11 (W-D3-weak-security: Settings snapshots the Get 103 record of the joined network ONCE, so it must carry the real IEs from the first answer): what the target's record carried besides the RSNE, kept for the Apple80211 radio.
+	 * ie = the record's IE block as the firmware sent it (at most SWL25R_IE_KEEP bytes; ie_short = it was longer), rates = the 500 kbps rateset entries, the rest the plain fields; xf = the extras were read (state OK). */
+	uint8_t xf, ie_short, nrates;
+	uint8_t rates[16];
+	uint16_t beacon, chspec;
+	int16_t noise, snr;
+	uint32_t ie_len;
+	uint8_t ie[SWL25R_IE_KEEP];
+};
+
+static int
+swl25r_zero(const uint8_t *p, unsigned n)
+{
+	unsigned i;
+	uint8_t o = 0;
+
+	for (i = 0; i < n; i++) {
+		o |= p[i];
+	}
+	return o == 0u;
+}
+
+static int
+swl25r_bad(struct swl25_tgt *t, const char *why)
+{
+	char gb[64];
+
+	t->state = SWL25R_BAD;
+	snprintf(gb, sizeof gb, "RSNE not read: %.44s", why);
+	swl_gap("rsne", gb, "high");
+	printf("WIFI GAP: %s\n", gb);
+	return 0;
+}
+
+/* pure: the record head (the 8 bytes at +116..+123 as `h`, the u32 `length` as len) against the bytes the event carries. 0 = ok and ieo/iel set; else the reason */
+static const char *
+swl25r_head(uint32_t len, const uint8_t h[8], uint32_t avail, uint32_t *ieo, uint32_t *iel)
+{
+	*ieo = swg_e_le16(h);
+	*iel = (uint32_t)h[4] | (uint32_t)h[5] << 8 | (uint32_t)h[6] << 16 | (uint32_t)h[7] << 24;
+	if (avail < SWL25R_HEAD || len > avail) {
+		return "record length above the event data";
+	}
+	if (*ieo < SWL25R_HEAD || *iel > len || *ieo > len - *iel) {
+		return "ie_offset/ie_length outside the record";
+	}
+	if (*ieo + ((*iel + 3u) & ~3u) != len) {
+		return "ie_offset + ie_length does not match length";
+	}
+	return NULL;
+}
+
+/* where the record bytes come from: the escan event buffer in the G1 block (bp + roff, read through the engine bus) or, patch 0288 (WLC_GET_BSS_INFO), a host copy of the ioctl answer (mem, `avail` bytes) */
+struct swl25r_src {
+	uint64_t bp;
+	uint32_t roff;
+	const uint8_t *mem;             /* non-NULL: read from here, off is relative to mem */
+	uint32_t memlen;
+};
+
+static int
+swl25r_read(struct swg_wx *x, const struct swl25r_src *s, uint32_t off, uint32_t n, uint8_t *out)
+{
+	if (s->mem != NULL) {
+		if (off > s->memlen || n > s->memlen - off) {
+			return -1;      /* callers check their offsets against `avail` first: never reached with a valid record (a stop, not a silent short read) */
+		}
+		memcpy(out, s->mem + off, n);
+		return 0;
+	}
+	return swg_e_rdb(x, s->bp, s->roff + off, n, out);
+}
+
+/* 2026-11-11: copy the target record's IE block and the plain fields the Get 103 record needs (offsets of wl_bss_info_v109, [src refs/wlan-stage5/wlioctl.h.new:355-396, host compile in wlan_rsne_host_test.c]: beacon_period +14, rateset.count +52, rateset.rates +56 (u8, 500 kbps),
+ * chanspec +72, phy_noise +80 (s8), SNR +124 (s16, read only when ie_offset >= 126 so that the two bytes are not IE bytes)). Every read is of the event buffer (or the BSS_INFO answer copy). The head was checked by swl25r_head (ie_offset + ie_length inside len, len inside the bytes carried).
+ * At most SWL25R_IE_KEEP bytes of IEs; a longer block sets ie_short (the radio GAPs). A failed read is the stop code. 0 = done */
+static int
+swl25r_keep(struct swg_wx *x, const struct swl25r_src *src, struct swl25_tgt *t, uint32_t len, uint32_t ieo, uint32_t iel)
+{
+	uint8_t b2[2], rs[20], nz;
+	uint32_t n, k;
+	int ex;
+
+	t->xf = 0u;
+	t->ie_len = 0u;
+	t->ie_short = 0u;
+	t->snr = 0;
+	ex = swl25r_read(x, src, 14u, 2u, b2);
+	if (ex != 0) {
+		return ex;
+	}
+	t->beacon = (uint16_t)swg_e_le16(b2);
+	ex = swl25r_read(x, src, 52u, 20u, rs);
+	if (ex != 0) {
+		return ex;
+	}
+	n = (uint32_t)rs[0] | (uint32_t)rs[1] << 8 | (uint32_t)rs[2] << 16 | (uint32_t)rs[3] << 24;
+	t->nrates = (uint8_t)(n > 16u ? 16u : n);
+	for (k = 0; k < t->nrates; k++) {
+		t->rates[k] = rs[4u + k];
+	}
+	ex = swl25r_read(x, src, 72u, 2u, b2);
+	if (ex != 0) {
+		return ex;
+	}
+	t->chspec = (uint16_t)swg_e_le16(b2);
+	ex = swl25r_read(x, src, 80u, 1u, &nz);
+	if (ex != 0) {
+		return ex;
+	}
+	t->noise = (int16_t)(int8_t)nz;
+	if (ieo >= 126u && len >= 126u) {
+		ex = swl25r_read(x, src, 124u, 2u, b2);
+		if (ex != 0) {
+			return ex;
+		}
+		t->snr = (int16_t)swg_e_le16(b2);
+	}
+	n = iel > SWL25R_IE_KEEP ? SWL25R_IE_KEEP : iel;
+	if (n != 0u) {
+		ex = swl25r_read(x, src, ieo, n, t->ie);
+		if (ex != 0) {
+			return ex;
+		}
+	}
+	t->ie_len = n;
+	t->ie_short = iel > SWL25R_IE_KEEP ? 1u : 0u;
+	t->xf = 1u;
+	return 0;
+}
+
+/* the L23 hook: x->bssn = swl25r_note, x->bssc = &struct swl25_tgt. Returns 0 (also after a GAP: the scan goes on) or a negative stop from a failed buffer read */
+static int
+swl25r_note_src(struct swg_wx *x, const struct swg_ev *ev, const struct swl25r_src *src, uint32_t avail)
+{
+	struct swl25_tgt *t = (struct swl25_tgt *)x->bssc;
+	uint8_t h[8], lb[4], eh[2];
+	uint32_t len, ieo, iel, pos, k;
+	const char *why;
+	int ex;
+
+	if (t != NULL && t->ssid_len != 0u && t->ssid_len <= 32u && ev->sl == t->ssid_len && memcmp(ev->ssid, t->ssid, t->ssid_len) == 0) {
+		if (swl25r_zero(t->bssid, 6u)) {        /* T-fc10 H2 [read from source: the join is a wildcard, swl_cfg.bssid is zero]: the first record with the target SSID names the AP */
+			memcpy(t->bssid, ev->bssid, 6);
+			printf("SWEET WLAN: L23 join target BSSID taken from the first scan record of its SSID\n");
+		} else if (memcmp(ev->bssid, t->bssid, 6) != 0 && t->other < 255u) {
+			t->other++;
+			printf("WIFI GAP: L25 a second AP carries the join SSID; the first record wins (skipped %u)\n", (unsigned)t->other);
+		}
+	}
+	if (t == NULL || t->state == SWL25R_OK || swl25r_zero(t->bssid, 6u) || memcmp(ev->bssid, t->bssid, 6) != 0) {
+		return 0;
+	}
+	if (ev->bver != SWG_E_BSS_VER) {
+		return 0;       /* the version GAP is printed by the scan */
+	}
+	t->seen++;
+	if (avail < SWL25R_HEAD) {
+		return swl25r_bad(t, "record shorter than the 124 B head");
+	}
+	ex = swl25r_read(x, src, SWL25R_OFF_LEN, 4u, lb);
+	if (ex == 0) {
+		ex = swl25r_read(x, src, SWL25R_OFF_IEOFF, 8u, h);
+	}
+	if (ex != 0) {
+		return ex;
+	}
+	len = (uint32_t)lb[0] | (uint32_t)lb[1] << 8 | (uint32_t)lb[2] << 16 | (uint32_t)lb[3] << 24;
+	why = swl25r_head(len, h, avail, &ieo, &iel);
+	printf("SWEET WLAN: L23 rsne record length %u ie_offset %u ie_length %u event bytes %u\n", len, ieo, iel, avail);
+	if (why != NULL) {
+		return swl25r_bad(t, why);
+	}
+	ex = swl25r_keep(x, src, t, len, ieo, iel);
+	if (ex != 0) {
+		return ex;
+	}
+	for (pos = ieo, k = 0; k < SWL25R_MAXIE && pos + 2u <= ieo + iel; k++) {
+		ex = swl25r_read(x, src, pos, 2u, eh);
+		if (ex != 0) {
+			return ex;
+		}
+		if (pos + 2u + eh[1] > ieo + iel) {
+			return swl25r_bad(t, "an IE runs past ie_length");
+		}
+		if (eh[0] == SWL25R_IE_RSN) {
+			if (eh[1] < 2u || 2u + eh[1] > SWL25R_RSNE_MAX) {
+				return swl25r_bad(t, "RSNE shorter than 2 B or longer than 64 B");
+			}
+			ex = swl25r_read(x, src, pos, 2u + eh[1], t->rsne);
+			if (ex != 0) {
+				return ex;
+			}
+			t->rsne_len = 2u + eh[1];
+			t->state = SWL25R_OK;
+			printf("SWEET WLAN: L23 rsne of the join target: %u B (IE 48 at record offset %u)\n", t->rsne_len, pos);
+			return 0;
+		}
+		pos += 2u + eh[1];
+	}
+	return swl25r_bad(t, k >= SWL25R_MAXIE ? "no RSNE in the first 128 IEs" : "no RSNE (IE 48) in the target record");
+}
+
+static int
+swl25r_note(struct swg_wx *x, const struct swg_ev *ev, uint64_t bp, uint32_t roff, uint32_t avail)
+{
+	struct swl25r_src src;
+
+	src.bp = bp;
+	src.roff = roff;
+	src.mem = NULL;
+	src.memlen = 0u;
+	return swl25r_note_src(x, ev, &src, avail);
+}
+
+/* ---- patch 0288 (T-fca2 design "smallest design that gives the second AP"): the answer of WLC_GET_BSS_INFO (136) as the target record.
+ * Answer layout [src wl_cfg80211.c.new:14450-14480 + wlioctl_defs.h.new:819 as quoted in docs/research/T-fca2-hotspot-bssid-design.md fact 5]: buf+0 u32 (the length word the request carried, echoed), the record wl_bss_info_v109_t at buf+4.
+ * Record offsets (relative to the record; the same the escan parser uses, sweet_wlan_g2.h swg_e_event, [src WI:355-397, measured on hardware: wlan_rsne_host_test.c L1]): +0 version u32 (109), +4 length u32 (record bytes incl. IEs),
+ * +8 BSSID[6], +18 SSID_len u8, +19 SSID[32], +72 chanspec u16, +78 RSSI i16, +88 ctl_ch u8, +116 ie_offset u16, +120 ie_length u32 (the IEs start ie_offset bytes into the record).
+ * Every field is bounds-checked against the bytes the answer carries (n), as wl_validate_bss_length does [src wl_cfg80211.c.new:14374-14400]: length >= 124 and <= n - 4, ie_offset >= 124, ie_offset + ROUNDUP4(ie_length) == length.
+ * Pure. 0 = ok and *ev filled (has_bss, bver, bssid, sl, ssid, cs, rssi, ctl); else the reason (a GAP is printed by the caller). */
+#define SWL25R_BI_REC 4u                /* the record starts 4 bytes into the answer */
+#define SWL25R_OFF_BSSID 8u
+#define SWL25R_OFF_SSIDLEN 18u
+#define SWL25R_OFF_SSID 19u
+#define SWL25R_OFF_CHSPEC 72u
+#define SWL25R_OFF_RSSI 78u
+#define SWL25R_OFF_CTL 88u
+static inline const char *
+swl25r_bss_parse(const uint8_t *buf, uint32_t n, struct swg_ev *ev)
+{
+	const uint8_t *r;
+	uint32_t len, ieo, iel, ver;
+	const char *why;
+
+	memset(ev, 0, sizeof *ev);
+	if (buf == NULL || n < SWL25R_BI_REC + SWL25R_HEAD) {
+		return "answer shorter than the 4 B length word plus the 124 B record head";
+	}
+	r = buf + SWL25R_BI_REC;
+	ver = (uint32_t)r[0] | (uint32_t)r[1] << 8 | (uint32_t)r[2] << 16 | (uint32_t)r[3] << 24;
+	if (ver != SWG_E_BSS_VER) {
+		return "record version is not 109";
+	}
+	len = (uint32_t)r[4] | (uint32_t)r[5] << 8 | (uint32_t)r[6] << 16 | (uint32_t)r[7] << 24;
+	why = swl25r_head(len, r + SWL25R_OFF_IEOFF, n - SWL25R_BI_REC, &ieo, &iel);
+	if (why != NULL) {
+		return why;
+	}
+	if (r[SWL25R_OFF_SSIDLEN] == 0u || r[SWL25R_OFF_SSIDLEN] > 32u) {
+		return "SSID length is not 1..32";
+	}
+	if (swl25r_zero(r + SWL25R_OFF_BSSID, 6u) || (r[SWL25R_OFF_BSSID] & 1u) != 0u) {
+		return "BSSID is zero or a group address";
+	}
+	ev->has_bss = 1;
+	ev->bver = ver;
+	memcpy(ev->bssid, r + SWL25R_OFF_BSSID, 6);
+	ev->sl = r[SWL25R_OFF_SSIDLEN];
+	memcpy(ev->ssid, r + SWL25R_OFF_SSID, 32);
+	ev->cs = swg_e_le16(r + SWL25R_OFF_CHSPEC);
+	ev->rssi = (int)(int16_t)swg_e_le16(r + SWL25R_OFF_RSSI);
+	ev->ctl = r[SWL25R_OFF_CTL];
+	return NULL;
+}
+
+/* the answer of WLC_GET_BSS_INFO as the join target's record: only for a target never seen (state NONE, wildcard BSSID, a credentials' SSID); the record's SSID must be the credentials' SSID, else a GAP and the target stays unset.
+ * On success t->bssid and (via swl25r_note_src) t->rsne are set. 1 = the record was taken (state OK), 0 = refused or nothing to do (every refusal printed as a GAP); negative = a failed read */
+static inline int
+swl25r_note_bss_info(struct swg_wx *x, const uint8_t *buf, uint32_t n)
+{
+	struct swl25_tgt *t = (struct swl25_tgt *)x->bssc;
+	struct swg_ev ev;
+	struct swl25r_src src;
+	const char *why;
+	char gb[64];
+	int ex;
+
+	if (t == NULL || t->state != SWL25R_NONE || !swl25r_zero(t->bssid, 6u) || t->ssid_len == 0u || t->ssid_len > 32u) {
+		return 0;
+	}
+	why = swl25r_bss_parse(buf, n, &ev);
+	if (why != NULL) {
+		snprintf(gb, sizeof gb, "BSS_INFO record unusable: %.36s", why);
+		swl_gap("rsne", gb, "high");
+		printf("WIFI GAP: BSS_INFO record unusable: %s\n", why);
+		return 0;
+	}
+	if (ev.sl != t->ssid_len || memcmp(ev.ssid, t->ssid, t->ssid_len) != 0) {
+		swl_gap("rsne", "BSS_INFO record is another SSID, refused", "high");
+		printf("WIFI GAP: L25 WLC_GET_BSS_INFO names another SSID than the credentials': refused, no target\n");
+		return 0;
+	}
+	printf("SWEET WLAN: L24 target from WLC_GET_BSS_INFO (not in the scan): chan %u rssi %d\n", (unsigned)ev.ctl, ev.rssi);
+	src.bp = 0u;
+	src.roff = 0u;
+	src.mem = buf + SWL25R_BI_REC;
+	src.memlen = n - SWL25R_BI_REC;
+	ex = swl25r_note_src(x, &ev, &src, n - SWL25R_BI_REC);
+	if (ex != 0) {
+		return ex;
+	}
+	if (t->state == SWL25R_OK) {
+		t->via_bss_info = 1u;
+	}
+	return t->state == SWL25R_OK;
+}
+
+/* after the scan: 0 = the RSNE is there; otherwise prints the one GAP that says why (wildcard target, never seen, unusable) and returns -1. Never partial. */
+static int
+swl25r_status(const struct swl25_tgt *t)
+{
+	const char *why = NULL;
+	char gb[64];
+
+	if (swl25r_zero(t->bssid, 6u)) {
+		why = t->ssid_len != 0u ? "target SSID not in the scan" : "join target BSSID is zero (wildcard)";
+	} else if (t->state == SWL25R_NONE) {
+		why = "target BSSID not in the scan";
+	} else if (t->state != SWL25R_OK) {
+		why = "target record unusable (see above)";
+	}
+	if (why == NULL) {
+		return 0;
+	}
+	snprintf(gb, sizeof gb, "RSNE missing: %.46s", why);
+	swl_gap("rsne", gb, "high");
+	printf("WIFI GAP: %s\n", gb);
+	return -1;
+}
+
+#endif /* SWEET_WLAN_L25_RSNE_H */
diff --git a/bsd/dev/sweet_wlan_l25_glue.h b/bsd/dev/sweet_wlan_l25_glue.h
new file mode 100644
index 00000000..7252962e
--- /dev/null
+++ b/bsd/dev/sweet_wlan_l25_glue.h
@@ -0,0 +1,323 @@
+/*
+ * Glue-side inputs of the L25/L26 engine (T-37d8 steps 2-3, the part a host can check): where the DATA block may sit and the struct swl25_cfg built from what the glue really has.
+ * Pure functions on the structs of sweet_wlan_g2.h / sweet_wlan_l25.h; no allocation, no bus access, no kernel types. The kernel glue (patch 0174 sweet_wlan.c) is NOT wired to it yet
+ * (open, ticket T-37d8 Log): the block allocation (kmem_alloc_contig + swd_contig + swd_audit_all like the G1 block), its S2MPU/DMA-window question (SPEC-WIFI U1/U2, open), the swc_load call
+ * that fills struct swc_creds, and the sw_g2_list entries for every store class of L25 (DP15 plans, GET_VAR cur_etheraddr). Until that is reviewed (Opus, T-bb44) nothing calls swl25g_arm and the engine
+ * keeps printing `WIFI GAP: L25 not run`.
+ *
+ * Order in time: swl25g_arm runs BEFORE the L23 scan (it needs the credentials, the join target and the DATA block); the RSNE of the target arrives during the scan through the hook
+ * x->bssn = swl25g_note (sweet_wlan_l25_rsne.h swl25r_note, which then copies the element into cfg.rsne_assoc / rsne_beacon [guess: assoc == beacon, SPEC-WIFI U-g]). If the scan never delivers
+ * it, cfg.rsne_*_len stay 0 and swl25_go refuses with `WIFI GAP: L25 not run: RSNE missing or too long` (rule 8); swl25r_status says which of the causes it was.
+ * cfg.mac stays all zero: swl25_go then takes the firmware's cur_etheraddr (T-baed step 1). Secrets (rule 4): the PMK is copied once, never printed; swl25g_disarm wipes it.
+ *
+ * Include order in the includer: sweet_wlan_data.h, sweet_wlan_join.h, sweet_wlan_g2.h, sweet_wlan_l25.h, sweet_wlan_l25_rsne.h, sweet_wlan_cred.h, sweet_wlan_l25_wl.h, then this file.
+ * T-43af: the last section holds the pure parts of the L25 store-judge wiring (layout fill, BSSID, flow-open scan); the kernel glue (patch 0174 sw3_g2_ok / sw3_wr) only calls them.
+ */
+#ifndef SWEET_WLAN_L25_GLUE_H
+#define SWEET_WLAN_L25_GLUE_H
+
+#if !defined(SWEET_WLAN_L25_H) || !defined(SWEET_WLAN_L25_RSNE_H) || !defined(SWEET_WLAN_CRED_H) || !defined(SWEET_WLAN_L25_WL_H)
+#error "sweet_wlan_l25_glue.h needs sweet_wlan_l25.h, sweet_wlan_l25_rsne.h, sweet_wlan_cred.h and sweet_wlan_l25_wl.h first"
+#endif
+
+struct swl25g {
+	struct swl25_tgt tgt;           /* FIRST member: the hook finds this struct through x->bssc, which points at tgt */
+	struct swl25_cfg cfg;
+};
+
+static void
+swl25g_gap(const char *what)
+{
+	char gb[64];
+
+	snprintf(gb, sizeof gb, "L25 %.50s", what);
+	swl_gap("l25", gb, "high");
+	printf("WIFI GAP: %s\n", gb);
+}
+
+/* The DATA block [pa, pa + len) the glue allocated: accepted only when it is there, big enough, page aligned, does not wrap, is disjoint from the G1 block already in `in`, and (above 4 GiB)
+ * its low 32 bits lie inside [alias_lo, alias_hi) like sw_g2_alias_ok demands of the G1 block (the dongle's 32-bit view of host memory; SPEC-WIFI D-11). Sets in->data / in->data_len; a refusal prints one
+ * WIFI GAP line and leaves both 0. 0 = ok, -1 = refused. */
+static int
+swl25g_data(struct swg_in *in, uint64_t pa, uint32_t len, uint32_t alias_lo, uint32_t alias_hi)
+{
+	const uint64_t lo = pa & 0xFFFFFFFFull;
+	const char *why = NULL;
+
+	in->data = 0;
+	in->data_len = 0;
+	if (pa == 0u || len == 0u) {
+		why = "DATA block missing";
+	} else if (len < SWL25_DATA_MIN || (pa & 0xFFFu) != 0u) {
+		why = "DATA block too small or not page aligned";
+	} else if (pa + len < pa) {
+		why = "DATA block wraps";
+	} else if (pa < in->blk + in->blk_len && pa + len > in->blk) {
+		why = "DATA block overlaps the G1 block";
+	} else if ((pa >> 32) != 0u && !(lo >= alias_lo && len <= alias_hi - alias_lo && lo <= (uint64_t)(alias_hi - len))) {
+		why = "DATA block outside the DMA alias window";
+	}
+	if (why != NULL) {
+		swl25g_gap(why);
+		return -1;
+	}
+	in->data = pa;
+	in->data_len = len;
+	return 0;
+}
+
+static int
+swl25g_zero(const uint8_t *p, unsigned n)
+{
+	unsigned i;
+	uint8_t o = 0;
+
+	for (i = 0; i < n; i++) {
+		o |= p[i];
+	}
+	return o == 0u;
+}
+
+/* g->cfg from the credentials (PMK, station address, gateway) and the join target's BSSID; g->tgt prepared for the scan hook. Every missing input prints its own WIFI GAP (all of them, not
+ * only the first) and g is left all zero. 0 = ok, -1 = something missing. */
+static int
+swl25g_cfg(struct swl25g *g, const struct swc_creds *cr, const uint8_t bssid[6])
+{
+	int bad = 0;
+
+	memset(g, 0, sizeof *g);
+	if (cr == NULL || swl25g_zero(cr->pmk, 32u)) {
+		swl25g_gap("PMK missing");
+		bad = 1;
+	}
+	if (cr != NULL && swl25g_zero(cr->ip, 4u) && swl25g_zero(cr->gw, 4u)) {
+		/* patch 0281: ip == 0 AND gw == 0 is a DHCP credential blob: no static address (swl25_go skips L26 and says so). Exactly one of the two zero is still a missing value below. */
+		printf("SWEET WLAN: L25 glue: DHCP credentials (no static station IP or gateway): addresses stay zero, L26 will not run\n");
+	} else {
+		if (cr == NULL || swl25g_zero(cr->ip, 4u)) {
+			swl25g_gap("station IP missing");
+			bad = 1;
+		}
+		if (cr == NULL || swl25g_zero(cr->gw, 4u)) {
+			swl25g_gap("gateway missing");
+			bad = 1;
+		}
+	}
+	if ((bssid == NULL || swl25g_zero(bssid, 6u)) && (cr == NULL || cr->ssid_len == 0u || cr->ssid_len > 32u)) {
+		swl25g_gap("join target BSSID missing (wildcard)");
+		bad = 1;
+	}
+	if (bad) {
+		return -1;
+	}
+	memcpy(g->cfg.pmk, cr->pmk, 32);
+	memcpy(g->cfg.ip, cr->ip, 4);
+	memcpy(g->cfg.gw, cr->gw, 4);
+	if (bssid != NULL && !swl25g_zero(bssid, 6u)) {
+		memcpy(g->cfg.bssid, bssid, 6);
+		memcpy(g->tgt.bssid, bssid, 6);
+	} else {        /* T-fc10 H2: wildcard join: the target is the first scan record of the credentials' SSID; cfg.bssid is filled by swl25g_note once the record is read */
+		g->tgt.ssid_len = (uint8_t)cr->ssid_len;
+		memcpy(g->tgt.ssid, cr->ssid, cr->ssid_len);
+	}
+	return 0;
+}
+
+/* the L23 hook: swl25r_note, then the element it found goes to the cfg (assoc = beacon, the recorded guess) */
+static void
+swl25g_adopt(struct swl25g *g)
+{
+	if (g->tgt.state == SWL25R_OK && g->cfg.rsne_beacon_len != g->tgt.rsne_len) {
+		memcpy(g->cfg.bssid, g->tgt.bssid, 6);      /* T-fc10 H2: a no-op for a given BSSID, the scan record's for a wildcard join */
+		memcpy(g->cfg.rsne_assoc, g->tgt.rsne, g->tgt.rsne_len);
+		memcpy(g->cfg.rsne_beacon, g->tgt.rsne, g->tgt.rsne_len);
+		g->cfg.rsne_assoc_len = g->cfg.rsne_beacon_len = g->tgt.rsne_len;
+	}
+}
+
+static int
+swl25g_note(struct swg_wx *x, const struct swg_ev *ev, uint64_t bp, uint32_t roff, uint32_t avail)
+{
+	struct swl25g *g = (struct swl25g *)x->bssc;
+	int ex = swl25r_note(x, ev, bp, roff, avail);
+
+	if (ex == 0) {
+		swl25g_adopt(g);
+	}
+	return ex;
+}
+
+/* patch 0288 (T-fca2 design, run wd6-hotspot-b: `L24 join done`, then `L25 not run: station MAC, BSSID, IP or gateway missing`: the hotspot was in none of the 20 scan records, the firmware found it during the join itself).
+ * The L25 hook x->bssget: when the target record was never seen (state NONE, wildcard BSSID, the credentials' SSID known), ONE read-only WLC_GET_BSS_INFO (136) GET: payload 1024 B = the length word 1024 (LE, bytes 00 04 00 00) then zeros,
+ * answer buf+0 echo, record wl_bss_info_v109_t at buf+4 [src docs/research/T-fca2-hotspot-bssid-design.md fact 5; wl_cfg80211.c.new:14450-14480]. The record goes through swl25r_note_bss_info (parse + bounds + SSID must equal the credentials' SSID),
+ * then into the cfg. This is the ONLY new firmware command of patch 0288; the whitelist row is in sweet_wlan_l25_wl.h. A refused/short/other-SSID answer is a GAP and leaves the target unset (swl25_go then refuses as before).
+ * 0 = done (taken or refused with a GAP) or soft stop (x->d4dstop); negative = the bus stopped */
+#define SWL25G_BSSINFO_LEN 1024u
+#define SWL25G_WLC_GET_BSS_INFO 136u    /* [src wlioctl_defs.h.new:819] */
+static uint8_t swl25g_bi_rsp[SWL25G_BSSINFO_LEN + 4u];      /* +4: the whole-word copy of the last bytes */
+
+static int
+swl25g_bss_info(struct swg_wx *x)
+{
+	struct swl25g *g = (struct swl25g *)x->bssc;
+	struct swd4b_ioctl_d2h cm;
+	static const uint8_t lenw[3] = { 0x04u, 0x00u, 0x00u };      /* bytes 1..3 of the length word 1024 (byte 0 is the NUL of the empty name) */
+	char gb[64];
+	int ex;
+
+	if (g == NULL || g->tgt.state != SWL25R_NONE || !swl25g_zero(g->tgt.bssid, 6u) || g->tgt.ssid_len == 0u) {
+		return 0;
+	}
+	memset(swl25g_bi_rsp, 0, sizeof swl25g_bi_rsp);
+	memset(&cm, 0, sizeof cm);
+	ex = swg_e_call(x, SWL25G_WLC_GET_BSS_INFO, "WLC_GET_BSS_INFO", "", lenw, 3u, SWL25G_BSSINFO_LEN, 1, SWL25G_BSSINFO_LEN, swl25g_bi_rsp, 1, &cm, NULL);
+	if (ex != 0 || x->d4dstop) {
+		return ex;
+	}
+	if (cm.status != 0) {
+		snprintf(gb, sizeof gb, "BSS_INFO refused status=%d", (int)cm.status);
+		swl_gap("rsne", gb, "high");
+		printf("WIFI GAP: L25 WLC_GET_BSS_INFO refused status=%d: the join target stays unknown\n", (int)cm.status);
+		return 0;
+	}
+	ex = swl25r_note_bss_info(x, swl25g_bi_rsp, cm.resp_len < SWL25G_BSSINFO_LEN ? cm.resp_len : SWL25G_BSSINFO_LEN);
+	if (ex < 0) {
+		return ex;
+	}
+	swl25g_adopt(g);
+	return 0;
+}
+
+/* sweetwlan >= 25: place the DATA block, build the cfg, install the hook and x->l25c. Both checks always run (every gap shows); if either fails x->l25c stays NULL, no hook is installed,
+ * in->data is 0 and g is zero. 1 = armed, 0 = refused. */
+static int
+swl25g_arm(struct swg_wx *x, struct swl25g *g, const struct swc_creds *cr, const uint8_t bssid[6], uint64_t data_pa, uint32_t data_len, uint32_t alias_lo, uint32_t alias_hi)
+{
+	int bad;
+
+	x->l25c = NULL;
+	x->bssn = NULL;
+	x->bssget = NULL;
+	x->bssc = NULL;
+	bad = swl25g_data(&x->in, data_pa, data_len, alias_lo, alias_hi) != 0;
+	bad |= swl25g_cfg(g, cr, bssid) != 0;
+	if (bad) {
+		x->in.data = 0;
+		x->in.data_len = 0;
+		swc_wipe(g, (uint32_t)sizeof *g);
+		return 0;
+	}
+	x->l25c = &g->cfg;
+	x->bssn = swl25g_note;
+	x->bssc = g;
+	x->bssget = swl25g_bss_info;
+	return 1;
+}
+
+/* after the run (every path): the hook and the cfg pointer are gone, the PMK and the RSNE copy are wiped */
+static void
+swl25g_disarm(struct swg_wx *x, struct swl25g *g)
+{
+	x->l25c = NULL;
+	x->bssn = NULL;
+	x->bssget = NULL;
+	x->bssc = NULL;
+	swc_wipe(g, (uint32_t)sizeof *g);
+}
+
+/* ------------------------------------------------------------------ T-43af: the L25 store judge (sweet_wlan_l25_wl.h) wired into the glue; the pure parts, host-tested */
+
+/* Fill the judge's layout from the glue's own G1 plan and the DATA block (never from the engine's books). Returns swl25w_layout_bad(): 0 = ok, else the failing clause (the caller then does not arm L25). */
+static int
+swl25g_wl_layout(struct swl25w *w, const struct swd_plan *p, uint64_t g1_pa, uint64_t data_pa, uint32_t data_len, int (*rd)(void *ctx, int space, uint32_t off, uint32_t *v), void *ctx)
+{
+	unsigned i;
+
+	memset(w, 0, sizeof *w);
+	w->h2d_w = p->b[SWD_IDX_H2D_W].off;
+	w->d2h_w = p->b[SWD_IDX_D2H_W].off;
+	w->d2h_r = p->b[SWD_IDX_D2H_R].off;
+	w->h2d_r = p->b[SWD_IDX_H2D_R].off;     /* sprint 2026-11-08: ring-0 wrap */
+	for (i = 0; i < 5u; i++) {
+		w->ring[i] = p->b[SWD_H2D_CTRL + i].off;
+		w->depth[i] = swd_rings[SWD_H2D_CTRL + i].items;
+	}
+	w->ioctbuf = p->b[SWD_IOCTBUF].off;
+	w->respbuf = p->b[SWD_RESPBUF].off;
+	w->evbuf = p->b[SWD_EVBUF].off;
+	w->g1_pa = g1_pa;
+	w->g1_len = p->total;
+	w->data_pa = data_pa;
+	w->data_len = data_len;
+	w->rx_n = data_len >= SWL25_RX_OFF + SWDP_NSLOT * SWL25_BUF_SZ ? (data_len - SWL25_RX_OFF) / SWL25_BUF_SZ : 0u;    /* patch 0357: the rx buffers the glue's own block holds (the judge's cap, never the engine's pool size) */
+	if (w->rx_n > SWL25W_RX_MAX) {
+		w->rx_n = SWL25W_RX_MAX;
+	}
+	w->flowid = SWL25_FLOWID;
+	w->rd = rd;
+	w->ctx = ctx;
+	return swl25w_layout_bad(w);
+}
+
+/* T-3784 (review T-98d9 r1 F1): the arm decision of sw_g2_hook as one pure step. The judge layout is filled first (a missing DATA block = no layout call, -1), then swl25g_arm ALWAYS runs so every missing-input gap prints;
+ * armed (return 1) only when both accepted. A refused layout (clause > 0) adds its own gap and log line, and any refusal runs swl25g_disarm: no hook, no cfg pointer, the cfg (PMK) wiped, so the engine finds no l25c and prints
+ * `WIFI GAP: L25 not run` without an L25 store. The caller stores the result in hw->l25arm, which is the only thing that lets the store route judge at level 25. */
+static int
+swl25g_wl_arm(struct swg_wx *x, struct swl25g *g, struct swl25w *w, const struct swd_plan *p, uint64_t g1_pa, const struct swc_creds *cr, const uint8_t bssid[6], uint64_t data_pa, uint32_t data_len, uint32_t alias_lo, uint32_t alias_hi, int (*rd)(void *ctx, int space, uint32_t off, uint32_t *v), void *ctx)
+{
+	const int lb = data_pa == 0u ? -1 : swl25g_wl_layout(w, p, g1_pa, data_pa, data_len, rd, ctx);
+	const int armed = swl25g_arm(x, g, cr, bssid, data_pa, data_len, alias_lo, alias_hi) == 1 && lb == 0;
+
+	if (lb > 0) {
+		swl_gap("l25", "glue: L25 store judge layout invalid, L25 not armed", "high");
+		printf("SWEET WLAN: L25 glue: store judge layout clause %d invalid, L25 not armed\n", lb);
+	}
+	if (!armed) {
+		swl25g_disarm(x, g);
+	} else {
+		w->escan_sync = &x->escan_sync;       /* review 0292 F2: the judge reads the id of the escan START that is being sent (only an armed judge carries it) */
+	}
+	return armed;
+}
+
+/* The AP MAC of the flow-create item: the BSSID the scan hook put in the cfg (a wildcard join learns it from the scan record, T-fc10 H2). All zero = not known: the judge then leaves those 6 bytes free (bssid_set 0). The MAC stays free
+ * (cur_etheraddr arrives in the response buffer, after the first judged store). */
+static void
+swl25g_wl_bssid(struct swl25w *w, const struct swl25g *g)
+{
+	memcpy(w->bssid, g->cfg.bssid, 6);
+	w->bssid_set = swl25g_zero(g->cfg.bssid, 6u) ? 0u : 1u;
+}
+
+/* After an accepted ring-2 read-index store (class L8, slot 0) of old -> nw: the dongle answered the flow create when one of the items consumed, read back through the judge's own flushing accessor, is a
+ * FLOW_CREATE_CMPLT with status 0 for the flow id, and a flow create was committed (flow_created, set by swl25w_done). Reads at most the 16 items one batch can consume. */
+static void
+swl25g_wl_flow(struct swl25w *w, uint32_t old, uint32_t nw)
+{
+	uint32_t s, n, k, v;
+	uint8_t it[24];
+	struct swdp_cmpl c;
+
+	if (w->depth[2] == 0u || !w->flow_created || w->flow_open) {
+		return;
+	}
+	old &= 0xFFFFu;         /* the whole index words (upper half kept) may be passed */
+	nw &= 0xFFFFu;
+	for (s = old % w->depth[2], n = 0; s != nw % w->depth[2] && n < SWL25W_D2H_BATCH; s = (s + 1u) % w->depth[2], n++) {
+		for (k = 0; k < 6u; k++) {
+			if (swl25w_rdw(w, SWL25W_SP_HOST, w->ring[2] + s * 24u + 4u * k, &v)) {
+				return;
+			}
+			it[4u * k] = (uint8_t)v;
+			it[4u * k + 1u] = (uint8_t)(v >> 8);
+			it[4u * k + 2u] = (uint8_t)(v >> 16);
+			it[4u * k + 3u] = (uint8_t)(v >> 24);
+		}
+		if (swdp_parse_flow_cmpl(it, &c) == 0 && (int16_t)c.status == 0 && c.ring_id == w->flowid) {
+			w->flow_open = 1u;
+			return;
+		}
+	}
+}
+
+#endif /* SWEET_WLAN_L25_GLUE_H */
diff --git a/bsd/dev/sweet_wlan_l25_wl.h b/bsd/dev/sweet_wlan_l25_wl.h
new file mode 100644
index 00000000..6484f0a0
--- /dev/null
+++ b/bsd/dev/sweet_wlan_l25_wl.h
@@ -0,0 +1,899 @@
+/*
+ * sweet_wlan_l25_wl.h - the L25 store whitelist (T-5173, classes L1-L9 of docs/research/T-3e93-l25-wiring-design.md s.1; W-JOIN P-W2/W-D5).
+ *
+ * PURE: no bus access, no engine header. The glue (patch 0174 `sw3_g2_ok`, later ticket) calls ONE function before every host/doorbell store the L25 engine
+ * makes: swl25w_ok(w, space, off, v, old, &why) returns the class (SWL25W_L1..L9) or -1 and a reason. Everything the judgment needs about the ring state is
+ * READ through the accessor `w->rd` (the glue's cache-flushing G1/DATA word read), never taken from the engine's books, so a wrong engine cursor cannot widen
+ * the list. The classes are written down HERE from the cited layouts, independently of swdp_plan / swdp_audit (R107 #5: a copy of the engine's own audit would
+ * accept whatever the engine does). Tags: [src] read from source (the cited file), [guess] not verified; no hardware was involved.
+ *
+ * Space ids are this header's own (SWL25W_SP_*); the glue maps SWG_SP_PCIE / SWG_SP_HOST / SWG_SP_DATA onto them. Offsets are bytes from the start of the G1 block
+ * (SWL25W_SP_HOST) or of the DATA block (SWL25W_SP_DATA) or the PCIe core offset (SWL25W_SP_PCIE). Every word is 4 byte aligned.
+ *
+ * What is free (the only unknowable bytes, everything else is derived from the ring state): the 12 MAC bytes of the flow-create item (exact when w->mac_set /
+ * w->bssid_set), the 14 B Ethernet header and the length of a tx item, the frame bytes of a tx buffer, the 164 key bytes of `wsec_key` and the 4 value bytes of SET `wsec`,
+ * the transaction id of an ioctl request and the (non-zero) request id of a buffer post. Each is bounded to its place (buffer, field, count). The ioctl payload buffer is free to
+ * WRITE while no ioctl is in transit, but an ioctl only commits if its command, lengths and iovar name are one of the L25 calls (23 rows since patch 0363: 0282 added seven, 0288 the BSS_INFO GET, 0292 the keep-phase SET escan, ALL-ON T-32 the SET mkeep_alive, 0363 the three read-only LOWCLK B3 GETs WLC_GET_PM, country and chanspecs) (four until T-924f added the read-only counters GET, T-9d71 added the two read-only association-request GETs, W-UI 2026-11-08 the read-only chanspec, GET_BSSID and GET_RSSI) (T-5173 r1 F1: a free iovar can carry a host PA).
+ * Not covered here (own ticket): the L24 stores (join commands, escan), the S2MPU/granule guard of the DATA block, arm/disarm, and the deep-sleep round (swg_ds_round: ring-0 type 0x23
+ * items, their index and doorbell, the BAR0 window store). A DS request during L25 is REFUSED here, fail closed (T-5173 r1 F6); the glue wiring ticket names the list that covers it.
+ * The stop path is outside this judge too (T-5173 r2 N3): swg_undo (PCIe 0xC34 := 0, EP and RC Command) and W17 must reach the bus without swl25w_ok; the glue keeps its own exact entries for them, and they stay
+ * allowed after a refusal, because a refusal here is what starts that path.
+ * The struct's layout is validated on every call (swl25w_layout_ok); a wrong layout refuses everything.
+ */
+#ifndef SWEET_WLAN_L25_WL_H
+#define SWEET_WLAN_L25_WL_H
+
+#include <stdint.h>
+
+enum { SWL25W_SP_PCIE = 1, SWL25W_SP_HOST = 2, SWL25W_SP_DATA = 3 };
+enum { SWL25W_L1 = 1, SWL25W_L2, SWL25W_L3, SWL25W_L4, SWL25W_L5, SWL25W_L6, SWL25W_L7, SWL25W_L8, SWL25W_L9, SWL25W_NCLASS = 9 };
+
+/* constants, each with its source [src] */
+#define SWL25W_DB0_OFF      0x140u      /* PCIe core +0x140, H2D doorbell 0 (sweet_wlan_g2.h SWG_DB0_OFF) */
+#define SWL25W_RX_N         16u         /* rx posts of L25 = items of ring 1 with a shadow (sweet_wlan_l25.h SWL25_RXPOSTS, SWL25_SHADOW_ITEMS) */
+#define SWL25W_RX_MAX       255u        /* patch 0357: the most rx buffers the DATA block may hold and the pool may post (SWDP_RX_MAX = Linux BRCMF_DEF_MAX_RXBUFPOST, pcie.c:246); the glue's layout sets rx_n from the block it allocated, the judge never from the engine's books */
+#define SWL25W_RXB_MAX      32u         /* patch 0357: most ring-1 items one batched rx post writes before its ONE index store (SWDP_RXB_MAX = BRCMF_MSGBUF_RXBUFPOST_THRESHOLD, msgbuf.c:58) */
+#define SWL25W_TX_N         16u         /* flow-ring items with a shadow (SWL25_SHADOW_ITEMS) */
+#define SWL25W_R1_N         256u        /* sprint 2026-11-08: the ring-1 posts the ONE-SHOT L25 engine can make (its shadow, sweet_wlan_l25.h SWL25_R1_SHADOW); the judge itself accepts every ring-1 slot and laps (en0) */
+#define SWL25W_BUF_SZ       2048u       /* one rx or tx buffer (SWL25_BUF_SZ) */
+#define SWL25W_TX_OFF       0x4000u     /* DATA: 16 tx buffers (SWL25_TX_OFF) */
+#define SWL25W_RX_OFF       0xC000u     /* DATA: 16 rx buffers, dongle-written, never host-written (SWL25_RX_OFF) */
+#define SWL25W_FLOW_DEPTH   64u         /* flow ring items (SWL25_FLOW_DEPTH) */
+#define SWL25W_FLOW_ISZ     48u         /* base tx item (SWDP_ISZ_TX_BASE, bcmmsgbuf.h:42): the device flags2 0x40943041 lacks PCIE_SHARED2_TXPOST_EXT 0x400000 (bcmpcie.h:154) */
+#define SWL25W_RX_RID       0x52580000u /* 'RX' << 16 + buffer (SWDP_RX_RID, sweet_wlan_data.h:291) */
+#define SWL25W_TX_RID       0x54580000u /* 'TX' << 16 + buffer (SWDP_TX_RID) */
+#define SWL25W_MAXFRAME     1514u       /* SWDP_ETH_MAXFRAME */
+#define SWL25W_ETH_HLEN     14u
+#define SWL25W_IOCT_WORDS   355u        /* ioctl payload words: the 355-word buffer of docs/research/T-3e93 s.1 L6 (1420 B) */
+#define SWL25W_IOCTREQ_ID   0xFFFEu     /* SWD4B_IOCTL_REQID */
+#define SWL25W_RESP_LEN     8192u       /* SWD_RESPBUF_LEN = SWD_EVBUF_LEN */
+#define SWL25W_BUFS         8u          /* SWD_RESPBUF_N = SWD_EVBUF_N */
+#define SWL25W_MSG_FLOW_CREATE 0x03u
+#define SWL25W_MSG_IOCTL_REQ   0x09u
+#define SWL25W_MSG_RESPBUF     0x0Bu
+#define SWL25W_MSG_EVBUF       0x0Du
+#define SWL25W_MSG_RXPOST      0x11u
+#define SWL25W_MSG_TXPOST      0x0Fu
+#define SWL25W_WLC_GET_VAR     262u
+#define SWL25W_WLC_GET_BSSID   23u     /* W-UI sprint 2026-11-08: read-only GETs after L26 [src refs/wlan-stage5/wlioctl_defs.h.new:703, :810] */
+#define SWL25W_WLC_GET_RSSI    127u
+#define SWL25W_WLC_GET_BSS_INFO 136u   /* patch 0288 [src wlioctl_defs.h.new:819]: read-only, the BSS the firmware joined */
+#define SWL25W_WLC_GET_PM      85u     /* patch 0363 (LOWCLK B3, docs/research/161 s.3.2) [src Linux v6.6 brcmfmac fwil.h:49 BRCMF_C_GET_PM; OpenBSD bwfmreg.h:284 BWFM_C_GET_PM]: read-only, 4-byte int. SET_PM (86) stays refused */
+#define SWL25W_WLC_SET_VAR     263u
+#define SWL25W_D2H_BATCH    16u         /* most ring-2 items consumed at once (SWG_E_BATCH, sweet_wlan_g2.h:103, 2118) */
+#define SWL25W_MSG_IOCTL_CMPLT 0x0Cu    /* the ioctl's completion on ring 2 (SWD4B_MSG_IOCTL_CMPLT, bcmmsgbuf.h) */
+#define SWL25W_EP(n)        (((254u + (n)) % 253u) & 0xFFu)     /* epoch of the n-th item of a ring, n counted from the ring's start over every lap (SWDP_EPOCH_INIT, SWDP_EPOCH_MOD; DHD's seqnum never resets at a wrap) */
+
+struct swl25w {
+	/* layout, filled once by the glue from its own G1/DATA plan (byte offsets from the block start) */
+	uint32_t h2d_w, d2h_w, d2h_r;           /* index arrays, 4 B per slot: H2D write (ring 0, ring 1, flow slot = flowid), D2H write (dongle-written) and read (rings 2, 3, 4 = slots 0, 1, 2) */
+	uint32_t h2d_r;                         /* sprint 2026-11-08: the H2D read index array (dongle-written; slot 0 = ring 0): the ring-full check of a ring-0 slot after the first lap */
+	uint32_t ring[5];                       /* rings 0..4 */
+	uint32_t depth[5];                      /* items of rings 0..4 */
+	uint32_t ioctbuf, respbuf, evbuf;       /* the ioctl payload buffer, 8 response buffers, 8 event buffers */
+	uint64_t g1_pa, data_pa;                /* the PA the dongle sees for offset 0 of each block */
+	uint32_t g1_len, data_len;              /* block lengths; every region above must lie inside g1_len, the DATA regions inside data_len (swl25w_layout_ok) */
+	uint32_t rx_n;                          /* patch 0357: rx buffers in the DATA block (buffer b at SWL25W_RX_OFF + b * 2048, b < rx_n); the glue's layout sets it from its own block length; 0 = SWL25W_RX_N (16, the old layout) */
+	uint32_t flowid;                        /* SWL25_FLOWID (2); its H2D slot is flowid, its ring id flowid + 3 (swdp_ringid) */
+	uint8_t mac[6], bssid[6];               /* station MAC / AP MAC of the flow-create item, enforced when the _set flag is 1 */
+	uint8_t mac_set, bssid_set;
+	uint8_t flow_open;                      /* the dongle answered the flow create: tx posts and tx payload need it */
+	uint32_t pend_db;                       /* the doorbell word the last accepted index store (L7/L8) asks for, 0 = none; set and cleared ONLY by swl25w_done() */
+	uint8_t flow_created;                   /* a flow-create item was committed (one per L25); set ONLY by swl25w_done() */
+	uint8_t ioct_busy;                      /* an ioctl request is committed and its completion not yet consumed; set and cleared ONLY by swl25w_done() */
+	uint32_t ioct_trans;                    /* the transaction id of that request; ~0 = unknown (a read failed), which no completion matches. Set ONLY by swl25w_done() */
+	uint32_t wrap1;                         /* sprint 2026-11-08: ring-1 laps completed (an accepted ring-1 index store depth-1 -> 0); the rx-post epoch counts wrap1 * depth + slot. Set ONLY by swl25w_done() */
+	uint32_t wrap0;                         /* sprint 2026-11-08: ring-0 laps completed (an accepted ring-0 index store depth-1 -> 0); the ring-0 epoch counts wrap0 * depth + slot. Set ONLY by swl25w_done() */
+	int (*rd)(void *ctx, int space, uint32_t off, uint32_t *v);     /* 0 = ok; the glue's flushing read */
+	void *ctx;
+	const volatile uint16_t *escan_sync;    /* review 0292 F2: the sync_id of the escan START that is being sent (the engine's x->escan_sync, set by swl25g_wl_arm); NULL = only the boot scan's SWL25W_ESCAN_SYNC0 */
+};
+
+static inline uint32_t swl25w_rxn(const struct swl25w *w) { return w->rx_n != 0u ? w->rx_n : SWL25W_RX_N; }
+static inline uint32_t swl25w_lo(uint64_t a) { return (uint32_t)a; }
+static inline uint32_t swl25w_hi(uint64_t a) { return (uint32_t)(a >> 32); }
+static inline uint32_t swl25w_ring_id(const struct swl25w *w) { return w->flowid + 3u; }     /* swdp_ringid(2) = 5 */
+
+static inline int
+swl25w_rdw(const struct swl25w *w, int space, uint32_t off, uint32_t *v)
+{
+	return w->rd == 0 || w->rd(w->ctx, space, off, v) != 0;
+}
+
+/* tx needs both: the create was committed (the stream shows it) and the dongle answered it (the glue says so). T-5173 r2 N6 */
+static inline int swl25w_flow_up(const struct swl25w *w) { return w->flow_open && w->flow_created; }
+
+/* The layout the glue filled: nothing below trusts it unchecked. 0 = ok, else the number of the clause it fails (the host test names it). Every G1 region non-empty, aligned, inside g1_len and disjoint from the others
+ * (64-bit arithmetic, no wrap); the DATA block holds the flow items, tx and rx buffers; the flow slot is the one L25 uses; the two blocks exist, do not wrap and do not overlap. Item sizes of the rings: sweet_wlan_dma.h swd_rings (40, 32, 24, 24, 40). */
+static inline int
+swl25w_layout_bad(const struct swl25w *w)
+{
+	const uint64_t o[12] = { w->h2d_w, w->d2h_w, w->d2h_r, w->ring[0], w->ring[1], w->ring[2], w->ring[3], w->ring[4], w->ioctbuf, w->respbuf, w->evbuf, w->h2d_r };
+	const uint64_t n[12] = { 12u, 12u, 12u, (uint64_t)w->depth[0] * 40u, (uint64_t)w->depth[1] * 32u, (uint64_t)w->depth[2] * 24u, (uint64_t)w->depth[3] * 24u, (uint64_t)w->depth[4] * 40u,
+				 SWL25W_IOCT_WORDS * 4u, (uint64_t)SWL25W_BUFS * SWL25W_RESP_LEN, (uint64_t)SWL25W_BUFS * SWL25W_RESP_LEN, 4u };
+	unsigned a, b;
+
+	if (w->rd == 0) {
+		return 1;
+	}
+	if (w->flowid != 2u) {
+		return 2;
+	}
+	if (w->g1_pa == 0u || w->data_pa == 0u) {
+		return 3;
+	}
+	if ((w->g1_pa & 0xFFFu) != 0u || (w->data_pa & 0xFFFu) != 0u) {
+		return 4;
+	}
+	if (w->data_len < SWL25W_RX_OFF + SWL25W_RX_N * SWL25W_BUF_SZ) {
+		return 5;
+	}
+	if (w->rx_n != 0u && (w->rx_n < SWL25W_RX_N || w->rx_n > SWL25W_RX_MAX || w->data_len < SWL25W_RX_OFF + w->rx_n * SWL25W_BUF_SZ)) {
+		return 14;      /* patch 0357: the rx buffer count must fit the block (16..255) */
+	}
+	if (w->g1_pa + w->g1_len < w->g1_pa || w->data_pa + w->data_len < w->data_pa) {
+		return 6;
+	}
+	if (w->g1_pa < w->data_pa + w->data_len && w->data_pa < w->g1_pa + w->g1_len) {
+		return 7;
+	}
+	if (w->depth[0] < 2u || w->depth[1] < SWL25W_RX_N) {
+		return 8;
+	}
+	for (a = 0; a < 5u; a++) {
+		if (w->depth[a] == 0u || w->depth[a] > 0x10000u) {
+			return 9;
+		}
+	}
+	for (a = 0; a < 12u; a++) {
+		if ((o[a] & 3u) != 0u) {
+			return 10;
+		}
+		if (o[a] + n[a] > w->g1_len) {
+			return 11;
+		}
+		if (o[a] == 0u && a != 3u) {    /* only ring 0 may sit at G1+0 (the plan's first block) */
+			return 12;
+		}
+	}
+	for (a = 0; a < 12u; a++) {
+		for (b = a + 1u; b < 12u; b++) {
+			if (o[a] < o[b] + n[b] && o[b] < o[a] + n[a]) {
+				return 13;
+			}
+		}
+	}
+	return 0;
+}
+static inline int swl25w_layout_ok(const struct swl25w *w) { return swl25w_layout_bad(w) == 0; }
+
+/* ------------------------------------------------------------------ item words (the shape of one item, word by word) */
+
+/* one word of a ring-0 item at ring slot `slot`; NULL = ok, else the reason. Words after word 0 take their type from word 0 of the same item, read back. */
+static inline const char *
+swl25w_ring0_word(const struct swl25w *w, uint32_t slot, uint32_t k, uint32_t v, int *cls)
+{
+	uint32_t ty, t0;
+	const uint32_t ep = SWL25W_EP(w->wrap0 * w->depth[0] + slot);
+	uint64_t pa;
+
+	if (k >= 10u) {
+		return "ring-0 item word index";
+	}
+	if (k == 0u) {
+		ty = v & 0xFFu;
+	} else {
+		if (swl25w_rdw(w, SWL25W_SP_HOST, w->ring[0] + slot * 40u, &t0)) {
+			return "ring-0 item word 0 unreadable";
+		}
+		ty = t0 & 0xFFu;
+	}
+	if (ty == SWL25W_MSG_FLOW_CREATE) {     /* L1 [src bcmmsgbuf.h:524-540 via sweet_wlan_data.h:176-191] */
+		*cls = SWL25W_L1;
+		if (w->flow_created || w->flow_open) {
+			return "L1 flow create: one per L25, the flow ring was already created";
+		}
+		switch (k) {
+		case 0: return v == (SWL25W_MSG_FLOW_CREATE | ep << 24) ? 0 : "L1 flow create: word 0 (type 0x03, flags 0, epoch)";
+		case 1: return v == 0u ? 0 : "L1 flow create: request id is 0";
+		case 2: return !w->bssid_set || ((v & 0xFFu) == w->bssid[0] && (v >> 8 & 0xFFu) == w->bssid[1] && (v >> 16 & 0xFFu) == w->bssid[2] && (v >> 24) == w->bssid[3]) ? 0 : "L1 flow create: da[0..3] is not the BSSID";
+		case 3: return (!w->bssid_set || ((v & 0xFFu) == w->bssid[4] && (v >> 8 & 0xFFu) == w->bssid[5])) &&
+			    (!w->mac_set || ((v >> 16 & 0xFFu) == w->mac[0] && (v >> 24) == w->mac[1])) ? 0 : "L1 flow create: da[4..5] / sa[0..1]";
+		case 4: return !w->mac_set || ((v & 0xFFu) == w->mac[2] && (v >> 8 & 0xFFu) == w->mac[3] && (v >> 16 & 0xFFu) == w->mac[4] && (v >> 24) == w->mac[5]) ? 0 : "L1 flow create: sa[2..5] is not the station MAC";
+		case 5: return v == w->flowid << 16 ? 0 : "L1 flow create: tid/if_flags 0, flow ring id is ours";
+		case 6: return v == 0u ? 0 : "L1 flow create: tc/priority/int_vector 0";
+		case 7: return v == (SWL25W_FLOW_DEPTH | SWL25W_FLOW_ISZ << 16) ? 0 : "L1 flow create: max_items 64, item size 48";
+		case 8: return v == swl25w_lo(w->data_pa) ? 0 : "L1 flow create: flow ring pointer lo is not DATA+0";
+		default: return v == swl25w_hi(w->data_pa) ? 0 : "L1 flow create: flow ring pointer hi is not DATA";
+		}
+	}
+	*cls = SWL25W_L2;
+	if (ty == SWL25W_MSG_IOCTL_REQ) {       /* ioctl request, swd4b_item_ioctl [src sweet_wlan_d4b.h:91-110] */
+		switch (k) {
+		case 0: return v == (SWL25W_MSG_IOCTL_REQ | 0x80u << 16 | ep << 24) ? 0 : "L2 ioctl request: word 0 (type 9, phase 0x80, epoch)";
+		case 1: return v == SWL25W_IOCTREQ_ID ? 0 : "L2 ioctl request: request id 0xFFFE";
+		case 2: return v == SWL25W_WLC_GET_VAR || v == SWL25W_WLC_SET_VAR || v == SWL25W_WLC_GET_BSSID || v == SWL25W_WLC_GET_RSSI || v == SWL25W_WLC_GET_BSS_INFO || v == SWL25W_WLC_GET_PM ? 0 : "L2 ioctl request: cmd is not GET_VAR/SET_VAR/GET_BSSID/GET_RSSI/GET_BSS_INFO/GET_PM";
+		case 3: return (v >> 16) <= SWL25W_IOCT_WORDS * 4u ? 0 : "L2 ioctl request: input length above the payload buffer";
+		case 4: return (v >> 16) == 0u && (v & 0xFFFFu) <= SWL25W_IOCT_WORDS * 4u ? 0 : "L2 ioctl request: output length above the payload buffer / reserved";
+		case 5: return v == 0u ? 0 : "L2 ioctl request: reserved";
+		case 6: return v == swl25w_lo(w->g1_pa + w->ioctbuf) ? 0 : "L2 ioctl request: payload pointer lo is not IOCTBUF";
+		case 7: return v == swl25w_hi(w->g1_pa + w->ioctbuf) ? 0 : "L2 ioctl request: payload pointer hi is not IOCTBUF";
+		default: return v == 0u ? 0 : "L2 ioctl request: reserved1";
+		}
+	}
+	if (ty == SWL25W_MSG_RESPBUF || ty == SWL25W_MSG_EVBUF) {       /* buffer posts, swd4b_item_respbuf / _evbuf [src sweet_wlan_d4b.h:49-88] */
+		const uint64_t base = w->g1_pa + (ty == SWL25W_MSG_RESPBUF ? w->respbuf : w->evbuf);
+		uint32_t lo, b;
+
+		switch (k) {
+		case 0: return v == (ty | 0x80u << 16 | ep << 24) ? 0 : "L2 buffer post: word 0 (type, phase 0x80, epoch)";
+		case 1: return v != 0u ? 0 : "L2 buffer post: request id 0 is DHD_PKTID_INVALID";   /* our own request id of the buffer (free, not 0: sweet_wlan_g2.h:1534) */
+		case 2: return v == SWL25W_RESP_LEN ? 0 : "L2 buffer post: host_buf_len is not 8192";
+		case 3: case 6: case 7: case 8: case 9: return v == 0u ? 0 : "L2 buffer post: reserved words are 0";
+		case 4: b = (v - swl25w_lo(base)) / SWL25W_RESP_LEN; return (v - swl25w_lo(base)) % SWL25W_RESP_LEN == 0u && b < SWL25W_BUFS ? 0 : "L2 buffer post: pointer lo is not one of the 8 buffers";
+		default:
+			if (swl25w_rdw(w, SWL25W_SP_HOST, w->ring[0] + slot * 40u + 16u, &lo)) {
+				return "L2 buffer post: pointer lo unreadable";
+			}
+			b = (lo - swl25w_lo(base)) / SWL25W_RESP_LEN;
+			pa = base + (uint64_t)b * SWL25W_RESP_LEN;
+			return (lo - swl25w_lo(base)) % SWL25W_RESP_LEN == 0u && b < SWL25W_BUFS && v == swl25w_hi(pa) ? 0 : "L2 buffer post: pointer hi";
+		}
+	}
+	return "ring-0 item: type is not flow create / ioctl request / buffer post";
+}
+
+/* one word of an rx post, ring 1 slot `slot` [src sweet_wlan_data.h:192-203 swdp_build_rxpost]: request id RX_RID+b for one of the 16 rx buffers b, length 2048, no metadata, the data pointer is buffer b.
+ * Sprint 2026-11-08: buffers are re-posted after their rx completion, so slot n no longer equals buffer n; b is read from word 1 (the word itself when k == 1, else memory, as ring 0 reads its word 0) */
+/* Part A (batched stores): have_rid != 0 hands in word 1 of the SAME post (the batch stores it before words 6/7, as the per-word plan order does); 0 = read it from memory (the per-word path) */
+static inline const char *
+swl25w_rx_word2(const struct swl25w *w, uint32_t slot, uint32_t k, uint32_t v, int have_rid, uint32_t rid1)
+{
+	uint32_t rid = v, b;
+	uint64_t pa;
+
+	if (slot < SWL25W_RX_N && w->wrap1 == 0u) {
+		rid = SWL25W_RX_RID + slot;     /* the first 16 posts: slot n = buffer n exactly (the old rule) */
+		if (k == 1u && v != rid) {
+			return "L3 rx post: request id is not RX_RID + slot (first 16 posts)";
+		}
+	} else if (k != 1u && (k == 6u || k == 7u)) {     /* a re-post: the pointer words follow word 1 in the plan's order */
+		if (have_rid) {
+			rid = rid1;
+		} else if (swl25w_rdw(w, SWL25W_SP_HOST, w->ring[1] + slot * 32u + 4u, &rid)) {
+			return "L3 rx post: request id word unreadable";
+		}
+	}
+	b = rid - SWL25W_RX_RID;
+	if ((k == 1u || k == 6u || k == 7u) && (rid < SWL25W_RX_RID || b >= swl25w_rxn(w))) {
+		return "L3 rx post: request id is not RX_RID + one of the rx buffers of the block (< rx_n, 16 unless the glue allocated more)";     /* GAP: whether the re-posted buffer is free is the engine's book, not checked here */
+	}
+	pa = w->data_pa + SWL25W_RX_OFF + (uint64_t)b * SWL25W_BUF_SZ;
+	switch (k) {
+	case 0: return v == (SWL25W_MSG_RXPOST | SWL25W_EP(w->wrap1 * w->depth[1] + slot) << 24) ? 0 : "L3 rx post: word 0 (type 0x11, epoch)";
+	case 1: return 0;
+	case 2: return v == SWL25W_BUF_SZ << 16 ? 0 : "L3 rx post: lengths (no metadata, 2048 data)";
+	case 3: case 4: case 5: return v == 0u ? 0 : "L3 rx post: reserved / metadata address words are 0";
+	case 6: return v == swl25w_lo(pa) ? 0 : "L3 rx post: data pointer lo is not the rx buffer its request id names";
+	case 7: return v == swl25w_hi(pa) ? 0 : "L3 rx post: data pointer hi";
+	default: return "L3 rx post: word index";
+	}
+}
+
+static inline const char *
+swl25w_rx_word(const struct swl25w *w, uint32_t slot, uint32_t k, uint32_t v)
+{
+	return swl25w_rx_word2(w, slot, k, v, 0, 0u);
+}
+
+/* one word of a tx post on the flow ring [src sweet_wlan_data.h:208-225 swdp_build_txpost, isz 48 (v1)]: epoch 0, request id TX_RID+n, Ethernet header free, flags 0x01 (802.3, prio 0), seg_cnt 1, no metadata */
+static inline const char *
+swl25w_tx_word(const struct swl25w *w, uint32_t slot, uint32_t k, uint32_t v)
+{
+	const uint64_t pa = w->data_pa + SWL25W_TX_OFF + (uint64_t)(slot % SWL25W_TX_N) * SWL25W_BUF_SZ;     /* sprint 2026-11-08: the flow ring (64) wraps; flow slot n uses tx buffer n % 16 */
+	const uint32_t dl = v >> 16;
+
+	switch (k) {
+	case 0: return v == SWL25W_MSG_TXPOST ? 0 : "L4 tx post: word 0 (type 0x0F, ifid 0, flags 0, epoch 0)";
+	case 1: return v == SWL25W_TX_RID + slot % SWL25W_TX_N ? 0 : "L4 tx post: request id is not TX_RID + slot % 16";
+	case 2: case 3: case 4: return 0;       /* Ethernet header bytes 0..11 (free) */
+	case 5: return (v >> 16) == 0x0101u ? 0 : "L4 tx post: packet flags 0x01 / seg_cnt 1";
+	case 6: case 7: return v == 0u ? 0 : "L4 tx post: metadata address is 0";
+	case 8: return v == swl25w_lo(pa) ? 0 : "L4 tx post: data pointer lo is not the tx buffer of the slot";
+	case 9: return v == swl25w_hi(pa) ? 0 : "L4 tx post: data pointer hi";
+	case 10: return (v & 0xFFFFu) == 0u && dl >= 1u && dl <= SWL25W_MAXFRAME - SWL25W_ETH_HLEN ? 0 : "L4 tx post: metadata length 0, data length 1..1500";
+	case 11: return v == 0u ? 0 : "L4 tx post: ext_flags/marker word is 0";
+	default: return "L4 tx post: word index";
+	}
+}
