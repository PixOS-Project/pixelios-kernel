+/*
+ * Patch 0149 (G-10, research 52): drift-free vsync. Re-arming with setTimeoutUS() from inside the callback adds the callback's run time and
+ * the timer wake latency to every period (g63: 19 ms instead of 16.667 ms, 52-53 callbacks/s). Arm an ABSOLUTE deadline one period after the
+ * previous deadline instead; if the callback ran late (deadline already past) restart from now. Boot-arg sweetvsync_abs=0 restores the old
+ * relative re-arm. The static state and `abs_on` belong to the single AppleCLCD instance and are only touched from its (serialized)
+ * workloop callback; the boot-arg is read once.
+ */
+static uint64_t sweet_fb_next_vsync_abs;
+static void
+sweet_fb_rearm(IOTimerEventSource *sender, uint64_t now)
+{
+	static int abs_on = -1;
+	if (abs_on < 0) {
+		int v = 1;
+		(void)PE_parse_boot_argn("sweetvsync_abs", &v, sizeof(v));
+		abs_on = v != 0;
+	}
+	if (!abs_on) {
+		sender->setTimeoutUS(SWEET_FB_VSYNC_US);
+		return;
+	}
+	uint64_t period;
+	nanoseconds_to_absolutetime((uint64_t)SWEET_FB_VSYNC_US * 1000, &period);
+	if (period == 0) {   /* review 0149: unreachable today, never arm a zero-length period */
+		sender->setTimeoutUS(SWEET_FB_VSYNC_US);
+		return;
+	}
+	uint64_t next = sweet_fb_next_vsync_abs ? sweet_fb_next_vsync_abs + period : now + period;
+	if (next <= now) {
+		next = now + period;
+	}
+	sweet_fb_next_vsync_abs = next;
+	sender->wakeAtTime(next);
+}
+
