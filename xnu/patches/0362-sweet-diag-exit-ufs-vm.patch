diff --git a/bsd/dev/sweet_exitlog.c b/bsd/dev/sweet_exitlog.c
new file mode 100644
index 0000000..d66f668
--- /dev/null
+++ b/bsd/dev/sweet_exitlog.c
@@ -0,0 +1,128 @@
+/*
+ * sweet_exitlog.c - patch 0362 (lowclk 2026-11-14, group A item A6-1; research 160 s.2): log how a process that was exec'd many times ends.
+ * lskdd is launched about every 1.024 s with no exit, crash or jetsam row anywhere (research 160 s.2): the cause of its exit is not in the logs.
+ * Read-only: counts execs per process name (called from the SWEET exec site in kern_exec.c) and, for a name exec'd more than SEL_MIN_EXECS times, prints
+ *   SWEET EXIT: NAME[PID] ppid P life_ms L exec_n E exit_n N xstat 0xRV code C signal S reason ns A code 0xB jetsam_flags 0xF by KNAME[KPID]
+ * for the first SEL_FIRST exits of that name, then every SEL_EVERY-th (rv = the exit status word: signal in bits 0..6, exit code in bits 8..15, as in
+ * kern_exit.c; reason = the os_reason the exiting process was given: namespace OS_REASON_JETSAM = 1 for a jetsam kill (bsd/sys/reason.h:88), 0xB = its code,
+ * jetsam_flags = the P_JETSAM_* bits passed to exit_with_reason; by = the process whose thread ran the exit: the process itself for exit()/a crash, another one
+ * for a kill/jetsam). life_ms = mach time since the fork (p_stats->ps_start, set by microtime_with_abstime in kern_fork.c:1121), so for an xpcproxy launch it
+ * includes the xpcproxy part. No state change anywhere. A name that does not fit in the table is a SWEET GAP row.
+ */
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/proc.h>
+#include <sys/proc_internal.h>
+#include <sys/reason.h>
+#include <sys/resourcevar.h>
+#include <kern/locks.h>
+#include <kern/clock.h>
+
+#define SEL_NAMES       768     /* a boot execs ~317 distinct names (k15 boot resident-233035-b4); 48 filled at boot and lskdd never got a slot */
+#define SEL_MIN_EXECS   10      /* a name exec'd MORE than this many times is logged */
+#define SEL_FIRST       5       /* the first exits of such a name are all logged ... */
+#define SEL_EVERY       100     /* ... then every 100th */
+
+struct sel_ent {
+	char     name[2 * MAXCOMLEN + 1];
+	uint32_t execs, exits;
+};
+struct sel_tab {
+	struct sel_ent e[SEL_NAMES];
+	uint32_t       n, dropped;
+};
+
+enum { SEL_NO = 0, SEL_TRACK_NEW, SEL_FULL };      /* sel_exec results */
+
+/* pure: count one exec of name. SEL_TRACK_NEW = the count just passed SEL_MIN_EXECS (log once), SEL_FULL = no slot (GAP). */
+static int
+sel_exec(struct sel_tab *t, const char *name)
+{
+	struct sel_ent *e = NULL;
+
+	for (uint32_t i = 0; i < t->n; i++) {
+		if (strncmp(t->e[i].name, name, sizeof(t->e[i].name)) == 0) {
+			e = &t->e[i];
+			break;
+		}
+	}
+	if (e == NULL) {
+		if (t->n >= SEL_NAMES) {
+			t->dropped++;
+			return SEL_FULL;
+		}
+		e = &t->e[t->n++];
+		strlcpy(e->name, name, sizeof(e->name));
+	}
+	e->execs++;
+	return e->execs == SEL_MIN_EXECS + 1 ? SEL_TRACK_NEW : SEL_NO;
+}
+
+/* pure: the exit code of the status word rv = W_EXITCODE(ret, sig) = (ret << 8) | sig (bsd/sys/wait.h:158). Signed on purpose: the old (rv >> 8) & 0xff hid a negative main() return
+ * (xstat 0xff595c00 printed code 0 / 92 although main returned -42660, docs ALL-ON-TRACKER L-25). Arithmetic shift of a signed int (clang), as WEXITSTATUS does without _POSIX_C_SOURCE (wait.h:146). */
+static int
+sel_code(int rv)
+{
+	return rv >> 8;
+}
+
+/* pure: count one exit of name; true = print the row (name exec'd more than SEL_MIN_EXECS times and this is one of the first SEL_FIRST exits or a multiple of SEL_EVERY). */
+static bool
+sel_exit(struct sel_tab *t, const char *name, uint32_t *execs, uint32_t *exits)
+{
+	for (uint32_t i = 0; i < t->n; i++) {
+		if (strncmp(t->e[i].name, name, sizeof(t->e[i].name)) == 0) {
+			struct sel_ent *e = &t->e[i];
+			e->exits++;
+			*execs = e->execs;
+			*exits = e->exits;
+			return e->execs > SEL_MIN_EXECS && (e->exits <= SEL_FIRST || (e->exits % SEL_EVERY) == 0);
+		}
+	}
+	return false;
+}
+
+static LCK_GRP_DECLARE(sel_grp, "sweet_exitlog");
+static LCK_SPIN_DECLARE(sel_lock, &sel_grp);
+static struct sel_tab sel_t;
+
+void sweet_exitlog_exec(const char *name);
+void sweet_exitlog_exit(proc_t p, int rv, int jetsam_flags);
+
+void
+sweet_exitlog_exec(const char *name)
+{
+	lck_spin_lock(&sel_lock);
+	int r = sel_exec(&sel_t, name);
+	uint32_t dropped = sel_t.dropped;
+	lck_spin_unlock(&sel_lock);
+	if (r == SEL_TRACK_NEW) {
+		printf("SWEET EXIT: %s was exec'd more than %d times: its exits are logged (first %d, then every %dth)\n", name, SEL_MIN_EXECS, SEL_FIRST, SEL_EVERY);
+	} else if (r == SEL_FULL && (dropped <= 8 || (dropped & (dropped - 1)) == 0)) {
+		printf("SWEET GAP: exit log table full (%d names): exits of %s are not logged x%u\n", SEL_NAMES, name, dropped);
+	}
+}
+
+/* called once per process from exit_with_reason, after p_exit_reason and p_xstat are set, before the exit proceeds */
+void
+sweet_exitlog_exit(proc_t p, int rv, int jetsam_flags)
+{
+	uint32_t execs = 0, exits = 0;
+
+	lck_spin_lock(&sel_lock);
+	bool show = sel_exit(&sel_t, p->p_name, &execs, &exits);
+	lck_spin_unlock(&sel_lock);
+	if (!show) {
+		return;
+	}
+	uint64_t life_ns = 0;
+	if (p->p_stats != NULL && p->p_stats->ps_start != 0) {
+		absolutetime_to_nanoseconds(mach_absolute_time() - p->p_stats->ps_start, &life_ns);
+	}
+	proc_t cur = current_proc();
+	struct os_reason *r = p->p_exit_reason;
+	printf("SWEET EXIT: %s[%d] ppid %d life_ms %llu exec_n %u exit_n %u xstat 0x%x code %d signal %d reason ns %u code 0x%llx jetsam_flags 0x%x by %s[%d]\n",
+	    p->p_name, proc_getpid(p), p->p_ppid, life_ns / NSEC_PER_MSEC, execs, exits, (unsigned)rv, sel_code(rv), rv & 0x7f,
+	    r != OS_REASON_NULL ? r->osr_namespace : 0, r != OS_REASON_NULL ? r->osr_code : 0, (unsigned)jetsam_flags,
+	    cur != NULL ? cur->p_name : "?", cur != NULL ? proc_getpid(cur) : -1);
+}
