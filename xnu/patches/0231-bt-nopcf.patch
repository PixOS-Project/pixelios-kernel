+/* patch 0231: hand bluetoothd the queued fce9 answers, only at a chip event boundary (rx thread only). n = chip bytes of this pass. */
+static void
+sbu_pcf_deliver(size_t n)
+{
+	unsigned h = __atomic_load_n(&sbu_pcf_qh, __ATOMIC_RELAXED);
+	unsigned t = __atomic_load_n(&sbu_pcf_qt, __ATOMIC_ACQUIRE);
