+	if (h == t) {
+		return;
+	}
+	if (sbu_rw_lost) {      /* no framer: only a pass in which the chip sent nothing counts as a boundary */
+		if (n != 0) {
+			return;
+		}
+		SBU_GAP(SG_OTHER, "sweetbtnopcf: rx framer lost, a queued fce9 answer is delivered at a quiet rx pass (may split a chip event)");
+	} else if (sbu_rw_off != 0) {
+		return;         /* inside a chip event: wait for its end */
+	}
+	for (; h != t; h++) {
+		unsigned k = sbu_pcf_q[h % SBU_PCF_Q];
+
+		sbu_trace("rx-synth", sbu_pcf_ans[k].b, sbu_pcf_ans[k].len);
+		(void)sweet_bt_rx(sbu_pcf_ans[k].b, sbu_pcf_ans[k].len);
+	}
+	__atomic_store_n(&sbu_pcf_qh, h, __ATOMIC_RELEASE);
