+/*
+ * Patch 0318 (ALL-ON T-02/T-24): the S2MPG10 / S2MPG11 reset-source latches as the SHIM read them (shim/pmicsrc.c, --pmic-src, review 0316; the shim console never reaches the host in a
+ * --boot-xnu boot, so the shim appends the values to the command line like --mif-clk does and this only prints them: no hardware access, no ACPM client here).
+ *   sweetps10=0xAABBCCDD  S2MPG10 STATUS1 STATUS2 PWRONSRC OFFSRC (MSB first; present only when all four were read)
+ *   sweetps11=0xAABB      S2MPG11 STATUS1 OFFSRC (present only when both were read)
+ *   sweetpsrc=N           0 all six read; 1..6 the read of register index N-1 failed and every later one was skipped (0 S10 STATUS1, 1 STATUS2, 2 PWRONSRC, 3 OFFSRC, 4 S11 STATUS1, 5 OFFSRC);
+ *                         7 an ACPM gate refused (nothing sent). A register without a value prints ERR, never a made-up value. INT1..INT6 stay a GAP (clear-on-read, never read).
+ * No sweetps* boot-arg at all (shim built without --pmic-src): the old GAP lines. Bit meaning of PWRONSRC / OFFSRC is not public (research 139): printed raw.
+ */
+static void
+i2c_hex8(char *o, int ok, uint32_t v)
+{
+	static const char d[] = "0123456789abcdef";
+
+	if (!ok) {
+		o[0] = 'E';
+		o[1] = 'R';
+		o[2] = 'R';
+		o[3] = 0;
+		return;
+	}
+	o[0] = '0';
+	o[1] = 'x';
+	o[2] = d[(v >> 4) & 0xf];
+	o[3] = d[v & 0xf];
+	o[4] = 0;
+}
+
+static void
+i2c_pmic_src_log(void)
+{
+	uint32_t w10 = 0, w11 = 0, rc = 0;
+	int have10, have11, haverc;
+	char h[6][5];
+	unsigned int k;
+
+	have10 = PE_parse_boot_argn("sweetps10", &w10, sizeof(w10));
+	have11 = PE_parse_boot_argn("sweetps11", &w11, sizeof(w11));
+	haverc = PE_parse_boot_argn("sweetpsrc", &rc, sizeof(rc));
+	if (!have10 && !have11 && !haverc) {
+		i2c_log("SWEET PMIC GAP: s2mpg10 PWRONSRC[0xe] OFFSRC[0xf] STATUS1[0xc] STATUS2[0xd] INT1..INT6[0x0-0x5] no read path (needs an xnu ACPM client; INT1..6 clear on read)\n");
+		i2c_log("SWEET PMIC GAP: s2mpg11 OFFSRC[0xd] STATUS1[0xc] INT1..INT6[0x0-0x5] no read path (needs an xnu ACPM client; INT1..6 clear on read)\n");
+		return;
+	}
+	for (k = 0; k < 4; k++) {
+		i2c_hex8(h[k], have10, (w10 >> (24 - 8 * k)) & 0xffu);
+	}
+	for (k = 0; k < 2; k++) {
+		i2c_hex8(h[4 + k], have11, (w11 >> (8 - 8 * k)) & 0xffu);
+	}
+	i2c_log("SWEET PMIC SRC: s2mpg10 STATUS1=%s STATUS2=%s PWRONSRC=%s OFFSRC=%s s2mpg11 STATUS1=%s OFFSRC=%s rc=%u (read by the shim, not cleared)\n",
+	    h[0], h[1], h[2], h[3], h[4], h[5], haverc ? rc : 0xffffu);
+	if (!haverc) {
+		i2c_log("SWEET PMIC GAP: sweetpsrc missing (the shim always appends it with sweetps10/sweetps11): the read result code is unknown\n");
+	} else if (rc != 0) {
+		i2c_log("SWEET PMIC GAP: PMIC SRC rc=%u (1..6 the read of register index rc-1 failed and the later ones were skipped, 7 an ACPM gate refused): registers shown ERR have no value, see the shim console / pstore\n", rc);
+	}
+	i2c_log("SWEET PMIC GAP: s2mpg10 INT1..INT6[0x0-0x5] s2mpg11 INT1..INT6[0x0-0x5] not read (clear on read)\n");
+}
