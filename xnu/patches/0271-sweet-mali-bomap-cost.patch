+/* patch 0271 (sprint-gpu 2026-11-09, log only): BO map / unmap / surface-import cost per second, `SWEET PERF: bomap ...` from sm_perf_tick.
+ * kind 0 = sweet_mali_map, 1 = sweet_mali_unmap, 2 = a whole surface import in the user client (prepare + page walk + map). Lock-free counters (log only). */
+void sweet_mali_perf_bo(int kind, uint64_t us, uint64_t pages16k);
+void
+sweet_mali_perf_bo(int kind, uint64_t us, uint64_t pages16k)
+{
+	if (kind < 0 || kind > 2) {
+		return;
+	}
+	os_atomic_inc(&sm_bom_n[kind], relaxed);
+	os_atomic_add(&sm_bom_us[kind], us, relaxed);
+	os_atomic_add(&sm_bom_pg[kind], pages16k, relaxed);
+	if (us > sm_bom_max[kind]) {
+		sm_bom_max[kind] = us;
+	}
+}
+
+static uint64_t
+sm_bom_now_us(void)
+{
+	uint64_t ns;
+	absolutetime_to_nanoseconds(mach_absolute_time(), &ns);
+	return ns / 1000;
+}
