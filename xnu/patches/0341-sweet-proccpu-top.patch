+/*
+ * SWEET CPUTOP (patch 0341, bsd/dev/sweet_cputop.c, boot-arg sweetcputop=N / sweetperf=1): snapshot of every thread of `task` (the caller passes kernel_task) into
+ * `out`, 4 words per thread {tid, user + system us, THREAD_BASIC_INFO flags, unslid continuation or 0}, and its name into names[idx * namesz] (empty = unnamed),
+ * for the first `max` threads in task->threads queue order; *total = threads in the queue. Locking as sweet_thrcpu_task above (task_lock around the walk and
+ * thread_info_internal, fill_taskthreadinfo osfmk/kern/bsd_kern.c). The name is copied with thread_get_thread_name (osfmk/kern/thread.c; bsd_getthreadname copies
+ * MAXTHREADNAMESIZE bytes of uthread pth_name) under the task lock, as thread_info_internal THREAD_EXTENDED_INFO does (thread.c, `bsd_getthreadname(get_bsdthread_info(thread),
+ * extended_info->pth_name)`). continuation is read without the thread lock: advisory (a thread that blocks right now can show the old or the new one). Reads only, no printf.
+ * Returns KERN_SUCCESS or the first thread_info_internal error (the walk stops there; *total is then the index of the failing thread).
+ */
+int sweet_cputop_task(task_t task, uint64_t *out, char *names, int namesz, int max, int *total);
+
+int
+sweet_cputop_task(task_t task, uint64_t *out, char *names, int namesz, int max, int *total)
+{
+	thread_t thread;
+	int idx = 0;
+	int kr = KERN_SUCCESS;
+
+	task_lock(task);
+	queue_iterate(&task->threads, thread, thread_t, task_threads) {
+		if (idx < max) {
+			thread_basic_info_data_t bi;
+			mach_msg_type_number_t cnt = THREAD_BASIC_INFO_COUNT;
+			char nm[MAXTHREADNAMESIZE];
+			kr = thread_info_internal(thread, THREAD_BASIC_INFO, (thread_info_t)&bi, &cnt);
+			if (kr != KERN_SUCCESS) {
+				break;
+			}
+			out[idx * 4 + 0] = thread_tid(thread);
+			out[idx * 4 + 1] = ((uint64_t)bi.user_time.seconds + (uint64_t)bi.system_time.seconds) * 1000000ULL + (uint64_t)bi.user_time.microseconds +
+			    (uint64_t)bi.system_time.microseconds;
+			out[idx * 4 + 2] = (uint64_t)(uint32_t)bi.flags;
+			out[idx * 4 + 3] = thread->continuation ? (uint64_t)VM_KERNEL_UNSLIDE(thread->continuation) : 0;
+			thread_get_thread_name(thread, nm);
+			nm[MAXTHREADNAMESIZE - 1] = '\0';
+			strlcpy(names + (size_t)idx * (size_t)namesz, nm, (size_t)namesz);
+		}
+		idx++;
+	}
+	*total = idx;
+	task_unlock(task);
+	return kr;
+}
