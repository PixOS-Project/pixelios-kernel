 				sm_irq_jobs_seen += sm.seq_done - before;
 				if (sm_irq_jobs_seen >= 200 && sm_irq_job == 0) {
@@ -1062,6 +1249,9 @@ sm_thread(void *arg __unused, wait_result_t w __unused)
