diff --git a/osfmk/kern/exception.c b/osfmk/kern/exception.c
index 60f5cfe..828d55f 100644
--- a/osfmk/kern/exception.c
+++ b/osfmk/kern/exception.c
@@ -1255,6 +1255,104 @@ sweet_thrwait_slide(task_t task, uint64_t *slide)
 	return 0;
 }
 
+/*
+ * SWEET CPU PC sampler (patch 0263, sprint-gpu 2026-11-08, bsd/dev/sweet_pcsamp.c, boot-arg sweetpcsamp=N): one round = one cross-call to every other CPU
+ * (cpu_broadcast_xcall_simple, osfmk/arm/cpu_common.c, the call perfmon_arm64.c:177 uses). On each CPU the handler runs in the IPI interrupt and reads, for the
+ * thread it interrupted, only: its task's pid, its tid and the interrupted register state getCpuDatap()->cpu_int_state (set by BEGIN_INTERRUPT_HANDLER,
+ * osfmk/arm64/locore.s:644; the same read as osfmk/kern/backtrace.c:219-225). Interrupted in EL0: kind 1, pc / lr = the user registers at the interrupt.
+ * Interrupted in EL1: kind 2, pc / lr = the user registers of the thread's last kernel entry (thread->machine.upcb), kpc = the unslid kernel pc of the
+ * interrupt. Nothing is written but this round's own out[] slot of the CPU (6 words); no lock, no memory a register points to is read, no printf.
+ * Kind 2 also stores up to 6 frames of the interrupted kernel stack (backtrace with BTF_KERN_INTERRUPTED, the call kperf makes at interrupt time,
+ * osfmk/kperf/callstack.c:276), unslid. A sample taken where interrupts come back on stands for the interrupts-off section that ends there.
+ * Only threads of the npid pids are recorded (o[0] = 1 + index into pids); idle / other tasks leave o[0] = 0. Returns the number of CPUs the call reached.
+ */
+#include <arm/cpu_data.h>
+#include <arm/cpu_data_internal.h>
+#include <arm/machine_routines.h>
+#include <kern/backtrace.h>
+
+#define SWEET_PCS_W 12   /* w0 proc+1, tid, kind, pc, lr, kpc, kernel frames 1..6 (kind 2 only, unslid, 0 = none) */
+
+struct sweet_pcs_arg {
+	const int *pids;
+	int npid;
+	int maxcpu;
+	uint64_t *out;
+};
+
+static void
+sweet_pcsamp_cpu(void *p)
+{
+	struct sweet_pcs_arg *a = p;
+	int cpu = cpu_number();
+	thread_t th;
+	task_t task;
+	int pid, w = -1;
+	arm_saved_state_t *is, *us;
+	uint64_t *o;
+
+	if (cpu < 0 || cpu >= a->maxcpu) {
+		return;
+	}
+	o = &a->out[cpu * SWEET_PCS_W];
+	for (int i = 0; i < SWEET_PCS_W; i++) {
+		o[i] = 0;
+	}
+	th = current_thread();
+	task = get_threadtask(th);
+	if (task == TASK_NULL || task == kernel_task) {
+		return;
+	}
+	pid = task_pid(task);
+	for (int i = 0; i < a->npid; i++) {
+		if (pid > 0 && a->pids[i] == pid) {
+			w = i;
+			break;
+		}
+	}
+	if (w < 0) {
+		return;
+	}
+	is = getCpuDatap()->cpu_int_state;
+	us = th->machine.upcb;
+	o[1] = thread_tid(th);
+	if (is != NULL && is_saved_state64(is) && PSR64_IS_USER(get_saved_state_cpsr(is))) {
+		o[2] = 1;
+		o[3] = get_saved_state_pc(is);
+		o[4] = get_saved_state_lr(is);
+		o[5] = 0;
+	} else {
+		o[2] = 2;
+		o[3] = (us != NULL && is_saved_state64(us)) ? get_saved_state_pc(us) : 0;
+		o[4] = (us != NULL && is_saved_state64(us)) ? get_saved_state_lr(us) : 0;
+		o[5] = (is != NULL && is_saved_state64(is)) ? VM_KERNEL_UNSLIDE(ml_get_backtrace_pc(is)) : 0;
+		if (is != NULL) {
+			uintptr_t bt[8];
+			backtrace_info_t bti = BTI_NONE;
+			struct backtrace_control ctl = { .btc_flags = BTF_KERN_INTERRUPTED, };
+			unsigned nf = backtrace(bt, 8, &ctl, &bti);
+
+			for (unsigned i = 0; i < 6; i++) {
+				o[6 + i] = (i + 1 < nf) ? VM_KERNEL_UNSLIDE(bt[i + 1]) : 0;   /* bt[0] = the interrupted pc (= kpc) */
+			}
+		}
+	}
+	o[0] = (uint64_t)(w + 1);
+}
+
+int sweet_pcsamp_round(const int *pids, int npid, uint64_t *out, int maxcpu);
+
+int
+sweet_pcsamp_round(const int *pids, int npid, uint64_t *out, int maxcpu)
+{
+	struct sweet_pcs_arg a = { pids, npid, maxcpu, out };
+
+	for (int i = 0; i < maxcpu * SWEET_PCS_W; i++) {
+		out[i] = 0;
+	}
+	return (int)cpu_broadcast_xcall_simple(FALSE, sweet_pcsamp_cpu, &a);
+}
