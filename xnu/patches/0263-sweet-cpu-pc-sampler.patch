diff --git a/bsd/dev/sweet_pcsamp.c b/bsd/dev/sweet_pcsamp.c
new file mode 100644
index 0000000..0e6ed01
--- /dev/null
+++ b/bsd/dev/sweet_pcsamp.c
@@ -0,0 +1,365 @@
+/*
+ * SWEET CPU PC sampler (patch 0263, sprint-gpu 2026-11-08, boot-arg sweetpcsamp=N, default off: no thread, nothing printed). R0: log only, no register writes.
+ *
+ * Why: the THRWAIT witness (0249/0259) only sees WAITING threads (their pc is the syscall return). The nav20 hitches (100-250 ms with the GPU idle) sit in
+ * CPU time of a second backboardd GL thread (SWEETGL LAGPH cpu_us 247061 at the general-open hitch); which code burns it is not in any log. This samples what
+ * RUNS: every N ms (N = boot-arg, clamped to 1..50) one cross-call reaches every other CPU; the handler (sweet_pcsamp_cpu, osfmk/kern/exception.c) records the
+ * interrupted thread of backboardd, SpringBoard or Preferences: tid, kind (1 = user pc at the interrupt, 2 = in the kernel: user pc of the last kernel entry +
+ * unslid kernel pc). Samples are aggregated per second in a static table keyed (process, tid, kind, pc, kpc); once per second:
+ *   SWEET PCSAMP: t <abs_ns> rounds R reached C hits H bb B sb S pf P entries E dropped D
+ *   SWEET PCSAMP: tid <proc> 0x<tid> n N user U                                  (threads with samples, up to 12, highest n first)
+ *   SWEET PCSAMP: pc <proc> 0x<tid> k K pc 0x<pc> lr 0x<lr> kpc 0x<kpc> n N   (up to 40 rows, highest n first)
+ *   SWEET PCSAMP: kbt <proc> 0x<tid> kpc 0x<kpc> f 0x<f1> 0x<f2> .. 0x<f6> n N  (kind 2 kernel stacks, unslid, up to 24 rows, highest n first)
+ * Once per process: `SWEET PCSAMP: pid <proc> P slide 0x<slide>` (pc - slide = unslid shared-cache address; a pc outside the cache is a dylib such as
+ * libsweetgl, whose base the `SWEETGL: BASE` line gives). t = mach_absolute_time in ns, the clock of SWEET SWAPT / SWEET NAV `now`.
+ * Cost [guess, not measured]: one IPI per other CPU per round (4 at --cpus 5) plus one proc_iterate per second.
+ * Context: its own kernel thread, static buffers, single thread, printf only from this thread with no lock held.
+ */
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/proc.h>
+#include <sys/proc_internal.h>
+#include <kern/task.h>
+#include <kern/thread.h>
+#include <kern/clock.h>
+#include <mach/mach_time.h>
+#include <mach/kern_return.h>
+#include <pexpert/pexpert.h>
+
+extern task_t proc_task(proc_t);
+extern char *proc_name_address(void *p);      /* bsd/kern/kern_proc.c */
+extern int sweet_thrwait_slide(task_t task, uint64_t *slide);                       /* osfmk/kern/exception.c (patch 0249) */
+extern int sweet_pcsamp_round(const int *pids, int npid, uint64_t *out, int maxcpu);  /* osfmk/kern/exception.c (patch 0263), 12 words per CPU */
+extern int ml_get_max_cpu_number(void);
+extern void sweet_pcsamp_start(void);
+
+#define PCS_NP      3
+#define PCS_MAXCPU  16
+#define PCS_TAB     2048
+#define PCS_TOP     40
+#define PCS_KTAB    1024
+#define PCS_KTOP    24
+#define PCS_W       12
+#define PCS_TTOP    12
+#define PCS_CAP     80000
+#define PCS_MIN_MS  1
+#define PCS_MAX_MS  50
+
+static const char *const pcs_names[PCS_NP] = { "backboardd", "SpringBoard", "Preferences" };
+static const char *const pcs_short[PCS_NP] = { "bb", "sb", "pf" };
+
+struct pcs_ent {
+	uint64_t tid, pc, lr, kpc;
+	uint32_t w, kind, n;       /* n 0 = free slot */
+};
+
+static struct pcs_ent pcs_tab[PCS_TAB];
+static uint32_t pcs_used;
+static uint64_t pcs_dropped;
+static int pcs_pid[PCS_NP] = { -1, -1, -1 };
+static int pcs_slid_pid[PCS_NP] = { -1, -1, -1 };
+static uint64_t pcs_slide[PCS_NP];
+static int pcs_slide_kr[PCS_NP];
+static uint64_t pcs_out[PCS_MAXCPU * PCS_W];
+struct pcs_kent {
+	uint64_t tid, kpc, f[6];
+	uint32_t w, n;
+};
+static struct pcs_kent pcs_ktab[PCS_KTAB];
+static uint64_t pcs_kdropped;
+
+static void
+pcs_kadd(const struct pcs_kent *e)
+{
+	uint64_t h = 1469598103934665603ULL;
+
+	h ^= e->kpc; h *= 1099511628211ULL;
+	for (int i = 0; i < 6; i++) {
+		h ^= e->f[i];
+		h *= 1099511628211ULL;
+		h ^= h >> 29;
+	}
+	for (uint32_t i = 0; i < PCS_KTAB; i++) {
+		struct pcs_kent *t = &pcs_ktab[(uint32_t)((h + i) % PCS_KTAB)];
+
+		if (t->n == 0) {
+			*t = *e;
+			t->n = 1;
+			return;
+		}
+		if (t->w == e->w && t->tid == e->tid && t->kpc == e->kpc && t->f[0] == e->f[0] && t->f[1] == e->f[1] && t->f[2] == e->f[2] && t->f[3] == e->f[3] && t->f[4] == e->f[4] && t->f[5] == e->f[5]) {
+			t->n++;
+			return;
+		}
+	}
+	pcs_kdropped++;
+}
+static uint32_t pcs_period_ms;
+
+static void
+pcs_add(const struct pcs_ent *e)
+{
+	uint64_t h = 1469598103934665603ULL;
+	const uint64_t k[4] = { e->tid, e->pc, e->kpc, ((uint64_t)e->w << 8) | e->kind };
+
+	for (int i = 0; i < 4; i++) {
+		h ^= k[i];
+		h *= 1099511628211ULL;
+		h ^= h >> 29;
+	}
+	for (uint32_t i = 0; i < PCS_TAB; i++) {
+		struct pcs_ent *t = &pcs_tab[(uint32_t)((h + i) % PCS_TAB)];
+
+		if (t->n == 0) {
+			*t = *e;
+			t->n = 1;
+			pcs_used++;
+			return;
+		}
+		if (t->w == e->w && t->tid == e->tid && t->kind == e->kind && t->pc == e->pc && t->kpc == e->kpc) {
+			t->n++;
+			return;
+		}
+	}
+	pcs_dropped++;
+}
+
+static int
+pcs_callout(proc_t p, __unused void *arg)
+{
+	const char *nm = proc_name_address(p);
+
+	for (int w = 0; w < PCS_NP; w++) {
+		if (strncmp(nm, pcs_names[w], MAXCOMLEN) == 0) {
+			task_t task = proc_task(p);
+
+			pcs_pid[w] = proc_pid(p);
+			if (task != TASK_NULL && pcs_slid_pid[w] != pcs_pid[w]) {
+				pcs_slide_kr[w] = sweet_thrwait_slide(task, &pcs_slide[w]);
+				pcs_slid_pid[w] = -2 - pcs_pid[w];      /* print pending: the thread prints it (no printf under the proc ref) */
+			}
+		}
+	}
+	return PROC_RETURNED;
+}
+
+static uint64_t
+pcs_now_ns(void)
+{
+	uint64_t ns;
+	absolutetime_to_nanoseconds(mach_absolute_time(), &ns);
+	return ns;
+}
+
+static void
+sweet_pcsamp_thread(__unused void *arg, __unused wait_result_t wr)
+{
+	unsigned lines = 0;
+	int cap_said = 0, maxcpu = ml_get_max_cpu_number() + 1;
+	uint64_t last_print = 0, rounds = 0, reached = 0, hits = 0, perproc[PCS_NP] = { 0, 0, 0 };
+
+	if (maxcpu > PCS_MAXCPU) {
+		printf("SWEET PCSAMP: %d CPUs, only the first %d are sampled\n", maxcpu, PCS_MAXCPU);
+		maxcpu = PCS_MAXCPU;
+	}
+	for (;;) {
+		uint64_t now;
+
+		if (lines >= PCS_CAP) {
+			if (!cap_said) {
+				cap_said = 1;
+				printf("SWEET PCSAMP: cap reached %d\n", PCS_CAP);
+			}
+			delay_for_interval(1000, 1000 * 1000);
+			continue;
+		}
+		delay_for_interval(pcs_period_ms, 1000 * 1000);
+		now = pcs_now_ns();
+		if (last_print == 0 || now - last_print >= 1000000000ULL) {
+			/* once per second: print the second that ended, then refresh the pids */
+			if (last_print != 0) {
+				uint32_t top[PCS_TOP];
+				int cnt = 0;
+				struct { uint64_t tid; uint32_t w, n, user; } tt[PCS_TTOP * 4];
+				int ntt = 0;
+
+				printf("SWEET PCSAMP: t %llu rounds %llu reached %llu hits %llu bb %llu sb %llu pf %llu entries %u dropped %llu\n",
+				    now, rounds, reached, hits, perproc[0], perproc[1], perproc[2], pcs_used, pcs_dropped);
+				lines++;
+				/* per-thread totals */
+				for (uint32_t s = 0; s < PCS_TAB; s++) {
+					const struct pcs_ent *e = &pcs_tab[s];
+					int j;
+
+					if (e->n == 0) {
+						continue;
+					}
+					for (j = 0; j < ntt; j++) {
+						if (tt[j].tid == e->tid && tt[j].w == e->w) {
+							break;
+						}
+					}
+					if (j == ntt) {
+						if (ntt == PCS_TTOP * 4) {
+							continue;
+						}
+						tt[j].tid = e->tid;
+						tt[j].w = e->w;
+						tt[j].n = tt[j].user = 0;
+						ntt++;
+					}
+					tt[j].n += e->n;
+					if (e->kind == 1) {
+						tt[j].user += e->n;
+					}
+				}
+				for (int r = 0; r < PCS_TTOP && r < ntt; r++) {
+					int b = r;
+
+					for (int j = r + 1; j < ntt; j++) {
+						if (tt[j].n > tt[b].n) {
+							b = j;
+						}
+					}
+					if (b != r) {
+						__typeof__(tt[0]) x = tt[r];
+						tt[r] = tt[b];
+						tt[b] = x;
+					}
+					printf("SWEET PCSAMP: tid %s 0x%llx n %u user %u\n", pcs_short[tt[r].w], tt[r].tid, tt[r].n, tt[r].user);
+					lines++;
+				}
+				/* top rows */
+				for (uint32_t s = 0; s < PCS_TAB; s++) {
+					int pos = cnt;
+
+					if (pcs_tab[s].n == 0) {
+						continue;
+					}
+					if (cnt == PCS_TOP && pcs_tab[top[PCS_TOP - 1]].n >= pcs_tab[s].n) {
+						continue;
+					}
+					if (cnt < PCS_TOP) {
+						cnt++;
+					} else {
+						pos = PCS_TOP - 1;
+					}
+					while (pos > 0 && pcs_tab[top[pos - 1]].n < pcs_tab[s].n) {
+						top[pos] = top[pos - 1];
+						pos--;
+					}
+					top[pos] = s;
+				}
+				for (int i = 0; i < cnt; i++) {
+					const struct pcs_ent *e = &pcs_tab[top[i]];
+
+					printf("SWEET PCSAMP: pc %s 0x%llx k %u pc 0x%llx lr 0x%llx kpc 0x%llx n %u\n", pcs_short[e->w], e->tid, e->kind, e->pc, e->lr, e->kpc, e->n);
+					lines++;
+				}
+				/* kernel stacks: PCS_KTOP rows, highest n first (selection by repeated max: 24 x 1024 compares per second) */
+				for (int r = 0; r < PCS_KTOP; r++) {
+					uint32_t b = PCS_KTAB;
+
+					for (uint32_t s = 0; s < PCS_KTAB; s++) {
+						if (pcs_ktab[s].n != 0 && (b == PCS_KTAB || pcs_ktab[s].n > pcs_ktab[b].n)) {
+							b = s;
+						}
+					}
+					if (b == PCS_KTAB) {
+						break;
+					}
+					const struct pcs_kent *k = &pcs_ktab[b];
+					printf("SWEET PCSAMP: kbt %s 0x%llx kpc 0x%llx f 0x%llx 0x%llx 0x%llx 0x%llx 0x%llx 0x%llx n %u\n", pcs_short[k->w], k->tid, k->kpc,
+					    k->f[0], k->f[1], k->f[2], k->f[3], k->f[4], k->f[5], k->n);
+					lines++;
+					pcs_ktab[b].n = 0;   /* printed: consumed (the table is cleared below anyway) */
+				}
+				if (pcs_kdropped) {
+					printf("SWEET PCSAMP: kbt dropped %llu (table full)\n", pcs_kdropped);
+					lines++;
+				}
+			}
+			bzero(pcs_tab, sizeof(pcs_tab));
+			bzero(pcs_ktab, sizeof(pcs_ktab));
+			pcs_kdropped = 0;
+			pcs_used = 0;
+			pcs_dropped = 0;
+			rounds = reached = hits = 0;
+			perproc[0] = perproc[1] = perproc[2] = 0;
+			last_print = now;
+			pcs_pid[0] = pcs_pid[1] = pcs_pid[2] = -1;
+			proc_iterate(PROC_ALLPROCLIST | PROC_NOWAITTRANS, pcs_callout, NULL, NULL, NULL);
+			for (int w = 0; w < PCS_NP; w++) {
+				if (pcs_pid[w] >= 0 && pcs_slid_pid[w] == -2 - pcs_pid[w]) {
+					pcs_slid_pid[w] = pcs_pid[w];
+					if (pcs_slide_kr[w] == 0) {
+						printf("SWEET PCSAMP: pid %s %d slide 0x%llx\n", pcs_short[w], pcs_pid[w], pcs_slide[w]);
+					} else {
+						printf("SWEET PCSAMP: pid %s %d slide unavailable (no shared region)\n", pcs_short[w], pcs_pid[w]);
+					}
+					lines++;
+				}
+			}
+		}
+		if (pcs_pid[0] < 0 && pcs_pid[1] < 0 && pcs_pid[2] < 0) {
+			continue;
+		}
+		reached += (uint64_t)sweet_pcsamp_round(pcs_pid, PCS_NP, pcs_out, maxcpu);
+		rounds++;
+		for (int c = 0; c < maxcpu; c++) {
+			const uint64_t *o = &pcs_out[c * PCS_W];
+			struct pcs_ent e;
+
+			if (o[0] == 0 || o[0] > PCS_NP) {
+				continue;
+			}
+			e.w = (uint32_t)(o[0] - 1);
+			e.tid = o[1];
+			e.kind = (uint32_t)o[2];
+			e.pc = o[3];
+			e.lr = o[4];
+			e.kpc = o[5];
+			e.n = 0;
+			hits++;
+			perproc[e.w]++;
+			pcs_add(&e);
+			if (e.kind == 2) {
+				struct pcs_kent k;
+
+				k.w = e.w;
+				k.tid = e.tid;
+				k.kpc = e.kpc;
+				for (int i = 0; i < 6; i++) {
+					k.f[i] = o[6 + i];
+				}
+				k.n = 0;
+				pcs_kadd(&k);
+			}
+		}
+	}
+}
+
+void
+sweet_pcsamp_start(void)
+{
+	int v = 0;
+	thread_t thread;
+
+	if (!PE_parse_boot_argn("sweetpcsamp", &v, sizeof(v)) || v == 0) {
+		return;
+	}
+	if (v < 0) {
+		printf("SWEET PCSAMP: sweetpcsamp=%d ignored (a period in ms, %d..%d, is needed)\n", v, PCS_MIN_MS, PCS_MAX_MS);
+		return;
+	}
+	pcs_period_ms = (uint32_t)v < PCS_MIN_MS ? PCS_MIN_MS : ((uint32_t)v > PCS_MAX_MS ? PCS_MAX_MS : (uint32_t)v);
+	if (pcs_period_ms != (uint32_t)v) {
+		printf("SWEET PCSAMP: sweetpcsamp=%d clamped to %u ms (%d..%d)\n", v, pcs_period_ms, PCS_MIN_MS, PCS_MAX_MS);
+	}
+	printf("SWEET PCSAMP: period %u ms, processes backboardd SpringBoard Preferences\n", pcs_period_ms);
+	if (kernel_thread_start(sweet_pcsamp_thread, NULL, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	} else {
+		printf("SWEET PCSAMP: unavailable (kernel_thread_start failed)\n");
+	}
+}
