+#define SWEET_SWIPE_STEPS 20
+#define SWEET_SWIPE_MAX 400
+void
+SweetHIDTouch::swipeFired(OSObject *owner, IOTimerEventSource *sender)
+{
+	SweetHIDTouch *self = (SweetHIDTouch *)owner;
+	static const int gx0[4] = { 540, 900, 200, 900 }, gy0[4] = { 2350, 1200, 1200, 1200 };
+	static const int gx1[4] = { 540, 200, 900, 200 }, gy1[4] = { 900, 1200, 1200, 1200 };
+	unsigned g = self->fSwipeCount & 3, st = self->fSwipeStep;
+
+	if (self->fSwipeCount >= SWEET_SWIPE_MAX) {
+		return;
+	}
+	if (st <= SWEET_SWIPE_STEPS) {
+		int x = gx0[g] + (gx1[g] - gx0[g]) * (int)st / SWEET_SWIPE_STEPS;
+		int y = gy0[g] + (gy1[g] - gy0[g]) * (int)st / SWEET_SWIPE_STEPS;
+		self->touch(0, true, x, y);
+		self->fSwipeStep = st + 1;
+		sender->setTimeoutMS(8);
+	} else {
+		self->touch(0, false, gx1[g], gy1[g]);
+		self->fSwipeStep = 0;
+		self->fSwipeCount++;
+		sender->setTimeoutMS(self->fSwipeSecs * 1000);
+	}
+}
