@@ -24,6 +24,135 @@
 #include <stddef.h>
 #include "sweet_wlan_chip.h"
 
+/* USER ORDER 2026-10-27: no silent failure. Every stub / refused value / unsupported case / swallowed error in the Wi-Fi path calls swl_gap() (text WITHOUT run values, so the
+ * key is stable between runs); it prints "WIFI GAP: <area> <what> x<count> [<sev>]" at count 1, 2, 4, 8 ... and swl_gap_summary() prints every entry once more with its final
+ * count. tools/xrun_report.py collects the lines (GAPS: N distinct, M total; NEW = not in docs/KNOWN-GAPS-WIFI.md). The severity is a PROPOSAL (guess). */
+#define SWL_GAP_MAX 64u
+struct swl_gap_ent {
+	char area[12];
+	char what[64];
+	char sev[8];
+	uint32_t n;
+};
+static struct swl_gap_ent swl_gap_tab[SWL_GAP_MAX];
+static uint32_t swl_gap_nd, swl_gap_tot, swl_gap_over;
+
+static inline void
+swl_gap(const char *area, const char *what, const char *sev)
+{
+	uint32_t i;
+	struct swl_gap_ent *e;
+
+	swl_gap_tot++;
+	for (i = 0; i < swl_gap_nd; i++) {
+		if (strcmp(swl_gap_tab[i].area, area) == 0 && strcmp(swl_gap_tab[i].what, what) == 0) {
+			break;
+		}
+	}
+	if (i == swl_gap_nd) {
+		if (i == SWL_GAP_MAX) {
+			swl_gap_over++;
+			printf("WIFI GAP: gaps table full, not recorded: %s %s x%u [high]\n", area, what, swl_gap_over);
+			return;
+		}
+		swl_gap_nd++;
+		memset(&swl_gap_tab[i], 0, sizeof swl_gap_tab[i]);
+		snprintf(swl_gap_tab[i].area, sizeof swl_gap_tab[i].area, "%s", area);
+		snprintf(swl_gap_tab[i].what, sizeof swl_gap_tab[i].what, "%s", what);
+		snprintf(swl_gap_tab[i].sev, sizeof swl_gap_tab[i].sev, "%s", sev);
+	}
+	e = &swl_gap_tab[i];
+	e->n++;
+	if ((e->n & (e->n - 1u)) == 0) {
+		printf("WIFI GAP: %s %s x%u [%s]\n", e->area, e->what, e->n, e->sev);
+	}
+}
+
+/* W-D4b gaps (standing order: a gap prints only while its condition is true): a MISS is a gap whose word a later reader, G2 (sweet_wlan_g2.h), may still read. With swl_miss_defer set (sweetwlan >= 12)
+ * swl_miss() only records it; G2 calls swl_miss_resolve() for every word it read, and swl_gap_summary() turns each unresolved miss into the gap (swl_miss_flush), so the gap prints iff nobody read the word.
+ * With swl_miss_defer 0 it is a plain swl_gap(). A full table is a gap at once (never lost). The keys are the SWL_M_* texts (area + what, as in swl_gap_tab). */
+#define SWL_MISS_MAX 12u
+#define SWL_M_F1_CON  "console pointer outside the RAM window, console not read"
+#define SWL_M_F1_MB   "mailbox data pointers not readable (outside window 2), not read"
+#define SWL_M_F1_RI   "rings_info_ptr not a readable range, not read"
+#define SWL_M_F2_MB   "mailbox data pointers not readable in window 0, not read"
+#define SWL_M_F2_RI   "rings_info_ptr not readable in window 0, not read"
+#define SWL_M_W15     "cfg 0x88 OR 0x300 (DHD attach write) not implemented"
+#define SWL_M_G1      "rw_index_sz and the ring counts are pinned from run F3, not re-read from the dongle"
+#define SWL_M_G2HOST  "host block not read (D4b read did not run)"
+struct swl_miss_ent {
+	const char *area, *what, *sev;
+	uint32_t res;
+};
+static struct swl_miss_ent swl_miss_tab[SWL_MISS_MAX];
+static uint32_t swl_miss_n, swl_miss_defer;
+
+static inline void
+swl_miss(const char *area, const char *what, const char *sev)
+{
+	uint32_t i;
+
+	if (!swl_miss_defer || swl_miss_n == SWL_MISS_MAX) {
+		swl_gap(area, what, sev);
+		return;
+	}
+	for (i = 0; i < swl_miss_n; i++) {
+		if (strcmp(swl_miss_tab[i].area, area) == 0 && strcmp(swl_miss_tab[i].what, what) == 0) {
+			return;
+		}
+	}
+	swl_miss_tab[swl_miss_n].area = area;
+	swl_miss_tab[swl_miss_n].what = what;
+	swl_miss_tab[swl_miss_n].sev = sev;
+	swl_miss_tab[swl_miss_n].res = 0;
+	swl_miss_n++;
+	printf("SWEET WLAN: miss %s %s (deferred: a G2 read may resolve it)\n", area, what);
+}
+
+/* 1 = a recorded, still open miss (area, what) is now resolved (the reader read the word); 0 = none such */
+static inline int
+swl_miss_resolve(const char *area, const char *what)
+{
+	uint32_t i;
+
+	for (i = 0; i < swl_miss_n; i++) {
+		if (strcmp(swl_miss_tab[i].area, area) == 0 && strcmp(swl_miss_tab[i].what, what) == 0 && !swl_miss_tab[i].res) {
+			swl_miss_tab[i].res = 1;
+			printf("SWEET WLAN: F1/F2 miss %s %s resolved by G2 read\n", area, what);
+			return 1;
+		}
+	}
+	return 0;
+}
+
+static inline void
+swl_miss_flush(void)
+{
+	uint32_t i;
+
+	for (i = 0; i < swl_miss_n; i++) {
+		if (!swl_miss_tab[i].res) {
+			swl_gap(swl_miss_tab[i].area, swl_miss_tab[i].what, swl_miss_tab[i].sev);
+		}
+	}
+	swl_miss_n = 0;
+}
+
+static inline void
+swl_gap_summary(void)
+{
+	uint32_t i;
+
+	swl_miss_flush();
+	if (swl_gap_tot == 0 && swl_gap_over == 0) {
+		return;
+	}
+	printf("WIFI GAPS: %u distinct, %u total\n", swl_gap_nd + (swl_gap_over ? 1u : 0u), swl_gap_tot + swl_gap_over);
+	for (i = 0; i < swl_gap_nd; i++) {
+		printf("WIFI GAP: %s %s x%u [%s]\n", swl_gap_tab[i].area, swl_gap_tab[i].what, swl_gap_tab[i].n, swl_gap_tab[i].sev);
+	}
+}
