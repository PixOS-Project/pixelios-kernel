+			kdown = 0u;
+			rc = sweet_wlan_a80211_kept_link(0);
+			if (rc != 0) swl_gap("keep", "link DOWN not delivered to Apple80211 (see the GAP line above)", "high");
+			en0_link_only(e, 0u);
+			printf("SWEET WLAN: keep link DOWN told to iOS: radio rc %d, en0 link off (flow ring kept open, no firmware command)\n", rc);
+		}
 		if (rr == 0) {          /* outside the en0 lock: the Apple80211 radio takes its own lock (the ioctl path holds it), so no lock order is formed */
 			nrssi++;
