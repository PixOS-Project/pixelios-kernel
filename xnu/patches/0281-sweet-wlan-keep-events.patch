@@ -2509,6 +2523,7 @@ sw_keep_thread(void *arg __unused, wait_result_t wr __unused)
 			l_pass = t_pass; l_link = swp_t_link; l_judge = swp_t_judge; l_cache = swp_t_cache; l_nlink = swp_n_link;
 			printf("SWEET WLAN: en0 poll alive polls=%u rx=%u tx=%u nquiet=%u gaps=%u r2=%u ev=%u ds=%u items=%u rx_drop=%u tx_drop=%u tx_blocked=%u tx_waits=%u kicks=%u dgaps=%u blk=%u blkw=%u plans=%u\n", polls, e->rx_frames,
 			       e->tx_frames, x->nquiet, swl_gap_tot + swl_gap_over, x->kr2n, x->kr2ev, x->kr2ds, items, e->rx_drop, e->tx_drop, e->tx_blocked, e->tx_waits, sw_keep.kicks, swl_dpg_tot, sw_g2_blk_n, sw_g2_blk_words, sw_plan_n);
+			printf("SWEET WLAN: keep events decoded=%u undecoded=%u reposted=%u link=%s up_events_while_down=%u\n", x->kev_n, x->kev_gap, x->kev_rp, x->klink ? "DOWN" : "UP", x->kl_up_n);
