 		if (t_end_busy != 0u && t_p0 - t_end_busy > gap_max) gap_max = t_p0 - t_end_busy;     /* read-only: the time from the end of a busy pass to the start of the next pass */
 		t_end_busy = busy ? mach_absolute_time() : 0u;
