+		if (x->kl_new) {        /* patch 0281: the link-loss detector (swg_ke_note, ring-2 events) went UP -> DOWN in this pass: tell iOS below, outside the lock, once */
+			x->kl_new = 0u;
+			kdown = 1u;
+		}
 		d_ = mach_absolute_time() - t_p0;
 		t_pass += d_;
