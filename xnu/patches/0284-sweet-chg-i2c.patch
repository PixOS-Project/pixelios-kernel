+/*
+ * Patch 0284 (phase 2): is the phase-1 gate state still exactly the open pattern? Re-reads the nine CMU words and SW_CONF (reads only) and requires
+ * them equal to the stage A snapshot, chg_gate_open() true and SW_CONF mode I2C (4). Phase 2 calls it before every group of transfers; any difference
+ * = it does nothing (GAP printed here).
+ */
+int
+sweet_chg_gate_still_open(void)
+{
+	struct chg_snap n;
+	const char *why = "";
+	int r;
+
+	if (!chg_gate || chg_stage < 2) {
+		chg_log("SWEET CHG GAP: P2 phase 1 did not establish an open gate (gate=%d stage=%d), no transfer\n", chg_gate, chg_stage);
+		return 0;
+	}
+	for (r = 0; r < CHG_R_N; r++) {
+		n.w[r] = 0;
+		n.ok[r] = 0;
+	}
+	chg_snap_read(&n, CHG_R_MUX, CHG_R_TGATE);
+	chg_snap_read(&n, CHG_R_SW, CHG_R_SW);
+	chg_snap_read(&n, CHG_R_PCON, CHG_R_PPUD);     /* review chg-0284 F1: the gpp23 pads too (DAT: only pins 4/5 = SCL/SDA, pins 0-3 belong to SPI11 and may move) */
+	for (r = CHG_R_MUX; r <= CHG_R_PPUD; r++) {
+		uint32_t m = r == CHG_R_PDAT ? 0x30u : 0xffffffffu;
+
+		if (!n.ok[r] || (n.w[r] & m) != (chg_s.w[r] & m)) {
+			chg_log("SWEET CHG GAP: P2 gate recheck: %s[0x%x] now 0x%x (read=%d), phase 1 saw 0x%x (mask 0x%x)\n", chg_words[r].name, chg_off[r], n.w[r], n.ok[r], chg_s.w[r], m);
+			return 0;
+		}
+	}
+	if (!chg_gate_open(&n, &why) || (n.w[CHG_R_SW] & 7u) != 4u) {
+		chg_log("SWEET CHG GAP: P2 gate recheck: not open any more (%s, SW_CONF mode %u)\n", why, n.w[CHG_R_SW] & 7u);
+		return 0;
+	}
+	return 1;
+}
