+/* PixOS patch 0277 (sprint-bt 2026-11-09): read-only export of the BCM4389 ROM bytes that sweet_bt_uart.c read with Read_RAM 0xfc4d at boot
+ * (boot-arg sweetbtromread=2). The live USB log dropped ~97 % of the hex rows of mode 1 (bt-rom1 20261109T221218Z: 104 of ~4096 rows) [obs],
+ * so mode 2 keeps the bytes in one kernel buffer and serves them whole through the read-only sysctl debug.sweetbtrom (CTLTYPE_OPAQUE,
+ * SYSCTL_OUT of the filled length; bsd/sys/sysctl.h). A userland helper copies it to a file the host pulls. Firmware bytes never enter git. */
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/errno.h>
+#include <sys/sysctl.h>
+#include <kern/kalloc.h>
+
+static uint8_t *sbr_buf;
+static uint32_t sbr_cap, sbr_len;
+
+uint8_t *sweet_bt_rom_buffer(uint32_t n);
+void sweet_bt_rom_publish(uint32_t n);
+
+uint8_t *
+sweet_bt_rom_buffer(uint32_t n)
+{
+	if (sbr_buf == NULL) {
+		sbr_buf = kalloc_data(n, Z_WAITOK | Z_ZERO);
+		sbr_cap = sbr_buf != NULL ? n : 0;
+	}
+	return n <= sbr_cap ? sbr_buf : NULL;
+}
+
+void
+sweet_bt_rom_publish(uint32_t n)
+{
+	sbr_len = n <= sbr_cap ? n : sbr_cap;
+}
+
+static int
+sbr_sysctl SYSCTL_HANDLER_ARGS
+{
+#pragma unused(oidp, arg1, arg2)
+	if (req->newptr != USER_ADDR_NULL) {
+		return EPERM;
+	}
+	if (sbr_buf == NULL || sbr_len == 0) {
+		return ENOENT;
+	}
+	return SYSCTL_OUT(req, sbr_buf, sbr_len);
+}
+
+SYSCTL_PROC(_debug, OID_AUTO, sweetbtrom, CTLTYPE_OPAQUE | CTLFLAG_RD | CTLFLAG_LOCKED, 0, 0, sbr_sysctl, "S", "BCM4389 ROM bytes read at boot by patch 0277 (sweetbtromread=2)");
