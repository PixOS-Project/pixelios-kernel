+/*
+ * patch 0277 (sprint-bt 2026-11-09), boot-arg sweetbtromread=1 (default off), READ-ONLY witness for the controller-side 0xfd48 work
+ * (docs/research/sprint-bt-fd48-firmware.md s.6): the vendor-command dispatch of the BCM4389 lives in its ROM, not in BCM.hcd.
+ * Read_RAM = OCF 0x04D (opcode 0xfc4d): parameters Address uint32 little endian + Length uint8, returns Status + up to 251 data bytes
+ * [src: Cypress AN215184 "Cypress Vendor-Specific Bluetooth Commands" Rev *A s.3.10 p.16]. Nothing is written to the controller:
+ * pass R (ROM state, before the patchram download): 32-byte probes at a few addresses, then a dump from address 0 in 128-byte reads,
+ * stopping at the first missing answer or status != 0, at SBU_ROM_MAX, or at the patch base. Rows `BT ROM: <addr> <hex>` (firmware bytes
+ * stay in the gitignored run log, never in git). The controller is then power-cycled and re-probed before the patchram download, so
+ * bluetoothd meets the usual state. Pass P (after the download): 0xfd54 with sub-opcode 0xee (no handler takes it: 0x01 = no 0xfd54
+ * handler at all, any other status = a handler exists and refused the sub-op) and a 32-byte read of the patch head 0x1a0400 (compared on
+ * the host with BCM.hcd: proves Read_RAM returns real memory). Every refusal is a BT GAP row; nothing here stops the bring-up.
+ */
+#define SBU_ROM_CHUNK 128u
+#define SBU_ROM_MAX   0x1a0400u      /* the first patchram record address in BCM.hcd [obs, research note s.4]: ROM is below it [guess] */
+#define SBU_ROM_WIN   0x80000u       /* review sprint-bt-0277 M2/M3: one 512 KiB window per boot (~4k reads, ~1 min, ~1.1 MB of log rows); boot-arg sweetbtromoff=<start> picks it */
+
+static int
+sbu_rom_read(uint32_t addr, uint8_t len, uint8_t *out, size_t *n, uint8_t *st)
+{
+	uint8_t par[5] = { (uint8_t)addr, (uint8_t)(addr >> 8), (uint8_t)(addr >> 16), (uint8_t)(addr >> 24), len };
+	uint8_t rp[280];
+	size_t rpn = 0;
+	int e;
+
+	*st = 0xff;
+	*n = 0;     /* review L1 */
+	e = sbu_cmd(0xfc4d, par, sizeof(par), st, rp, sizeof(rp), &rpn);
+	if (e == 0) {
+		*n = rpn < len ? rpn : len;
+		memcpy(out, rp, *n);
+	}
+	return e;
+}
+
+static void
+sbu_rom_row(const char *tag, uint32_t addr, const uint8_t *b, size_t n)
+{
+	char hex[SBU_ROM_CHUNK * 2 + 1];
+	size_t i;
+
+	for (i = 0; i < n && i < SBU_ROM_CHUNK; i++) {
+		static const char d[] = "0123456789abcdef";
+
+		hex[2 * i] = d[b[i] >> 4];
+		hex[2 * i + 1] = d[b[i] & 15];
+	}
+	hex[2 * i] = 0;
+	printf("BT ROM: %s %08x %s\n", tag, addr, hex);
+}
+
+static void
+sbu_romread_rom(void)
+{
+	static const uint32_t probes[] = { 0x0, 0x100, 0x1000, 0x10000, 0x80000, 0x100000, 0x180000, 0x1a0400 };
+	uint8_t b[SBU_ROM_CHUNK], st;
+	size_t n;
+	uint32_t a;
+	unsigned rows = 0;
+	int e;
+
+	sbu_trace_quiet = true;
+	printf("BT ROM: start (sweetbtromread=1, patch 0277): Read_RAM 0xfc4d probes + one %u KiB window in %u-byte reads, cap 0x%x\n", SBU_ROM_WIN / 1024, SBU_ROM_CHUNK, SBU_ROM_MAX);
+	for (unsigned i = 0; i < sizeof(probes) / sizeof(probes[0]); i++) {
+		e = sbu_rom_read(probes[i], 32, b, &n, &st);
+		if (e != 0 || st != 0) {
+			SBU_GAP(SG_OTHER, "sweetbtromread: probe %08x refused: error %d status 0x%02x", probes[i], e, st);
+			continue;
+		}
+		sbu_rom_row("probe", probes[i], b, n);
+	}
+	uint32_t start = 0, end;
+
+	if (PE_parse_boot_argn("sweetbtromoff", &start, sizeof(start)))
+		start &= ~(SBU_ROM_CHUNK - 1);
+	end = start < SBU_ROM_MAX - SBU_ROM_WIN ? start + SBU_ROM_WIN : SBU_ROM_MAX;
+	printf("BT ROM: window %08x..%08x (sweetbtromoff)\n", start, end);
+	for (a = start; a < end; a += SBU_ROM_CHUNK) {
+		e = sbu_rom_read(a, SBU_ROM_CHUNK, b, &n, &st);
+		if (e != 0 || st != 0 || n != SBU_ROM_CHUNK) {
+			SBU_GAP(SG_OTHER, "sweetbtromread: dump stopped at %08x: error %d status 0x%02x bytes %zu", a, e, st, n);
+			break;
+		}
+		sbu_rom_row("d", a, b, n);
+		rows++;
+	}
+	sbu_trace_quiet = false;
+	printf("BT ROM: dump done rows=%u bytes=%u end=%08x quiet_transfers=%u\n", rows, rows * SBU_ROM_CHUNK, a, sbu_trace_quiet_n);
+}
+
+uint8_t *sweet_bt_rom_buffer(uint32_t n);      /* sweet_bt_rom.c (patch 0277 mode 2) */
+void sweet_bt_rom_publish(uint32_t n);
+
+/* mode 2 (sweetbtromread=2): the whole range 0..SBU_ROM_MAX into the kernel buffer, no hex rows; served by sysctl debug.sweetbtrom */
+static void
+sbu_romread_buf(void)
+{
+	uint8_t *buf = sweet_bt_rom_buffer(SBU_ROM_MAX), st;
+	size_t n;
+	uint32_t a, fnv = 2166136261u;
+	int e = 0;
+
+	if (buf == NULL) {
+		SBU_GAP(SG_OTHER, "sweetbtromread=2: no %u-byte buffer; nothing read", SBU_ROM_MAX);
+		return;
+	}
+	sbu_trace_quiet = true;
+	printf("BT ROM: start mode 2 (buffer, sysctl debug.sweetbtrom): 0..0x%x in %u-byte reads\n", SBU_ROM_MAX, SBU_ROM_CHUNK);
+	for (a = 0; a < SBU_ROM_MAX; a += SBU_ROM_CHUNK) {
+		e = sbu_rom_read(a, SBU_ROM_CHUNK, buf + a, &n, &st);
+		if (e != 0 || st != 0 || n != SBU_ROM_CHUNK) {
+			SBU_GAP(SG_OTHER, "sweetbtromread=2: read stopped at %08x: error %d status 0x%02x bytes %zu", a, e, st, n);
+			break;
+		}
+		if ((a & 0x3ffffu) == 0)
+			printf("BT ROM: progress %08x\n", a);
+	}
+	sbu_trace_quiet = false;
+	for (uint32_t i = 0; i < a; i++)
+		fnv = (fnv ^ buf[i]) * 16777619u;
+	sweet_bt_rom_publish(a);
+	printf("BT ROM: buffer done bytes=%u fnv1a=0x%08x quiet_transfers=%u (sysctl debug.sweetbtrom)\n", a, fnv, sbu_trace_quiet_n);
+}
+
+static void
+sbu_romread_patched(void)
+{
+	static const uint8_t bad_sub = 0xee;
+	uint8_t rp[64], b[32], st = 0xff;
+	size_t rpn = 0, n = 0;
+	int e = sbu_cmd(0xfd54, &bad_sub, 1, &st, rp, sizeof(rp), &rpn);
+
+	if (e != 0) {      /* review M1: no answer = the controller may be wedged; check it with a Reset before anything else talks to it */
+		SBU_GAP(SG_OTHER, "sweetbtromread: 0xfd54 probe got no answer (error %d)", e);
+		e = sbu_cmd(0x0c03, &bad_sub, 0, &st, rp, sizeof(rp), &rpn);
+		if (e != 0 || st != 0)
+			SBU_GAP(SG_OTHER, "sweetbtromread: HCI Reset after the 0xfd54 probe failed (error %d status 0x%02x): the controller may be wedged; bluetoothd will show it", e, st);
+		return;
+	}
+	printf("BT ROM: fd54 probe sub=0x%02x: error %d status 0x%02x (%s) return bytes %zu\n", bad_sub, e, st,
+	    st == 0x01 ? "Unknown HCI Command: no 0xfd54 handler" : "a 0xfd54 handler exists", rpn);
+	e = sbu_rom_read(0x1a0400, 32, b, &n, &st);
+	if (e != 0 || st != 0)
+		SBU_GAP(SG_OTHER, "sweetbtromread: patch-head read refused: error %d status 0x%02x", e, st);
+	else
+		sbu_rom_row("patchhead", 0x1a0400, b, n);
+}
+
