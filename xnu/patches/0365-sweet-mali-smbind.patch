+ *   bit 1 (2): create sm_thread at priority 93 = BASEPRI_PREEMPT_HIGH (osfmk/kern/sched.h: BASEPRI_KERNEL 81, BASEPRI_PREEMPT 92, BASEPRI_PREEMPT_HIGH 93, MAXPRI_KERNEL 95,
+ *              BASEPRI_REALTIME 96). The default kernel_thread_start passes -1 = the kernel task priority 81 (osfmk/kern/thread.c:1960). 93 is the lowest value that preempts the
+ *              92 panel-copy thread call (thread_call.c group KERNEL_HIGH, tcg_thread_pri BASEPRI_PREEMPT, also the sweet_wdt pet) and is not above the thread_call HIGH group (93) nor the
+ *              thread_call daemon (94); the USB log drain thread (sweet_usb.c ud_log_thread, kernel_thread_start = 81) and the stall timer_call (interrupt context, not a thread)
+ *              are not starved because sm_thread runs ~3.5 % of one core [obs K17 CPUTOP] and blocks in lck_mtx_sleep_deadline between jobs.
+ *   other bits: GAP line, ignored.
+ * Log only (needs sweetcomplat=1, the ISR stamp): once per second `SWEET PERF: complat_wake wake_same N wake_other M ...`: per consumed JOB-interrupt stamp, whether the cpu
+ * that ran sm_isr (smb_isr_cpu) equals the cpu sm_thread woke on (cpu_number() after lck_mtx_sleep_deadline returned).
+ */
+/* SMBIND-PURE-BEGIN (host test tools/test_sweet_smbind365.py compiles this block) */
+#define SMB_BIND 1u
+#define SMB_PRIO 2u
+#define SMB_PRI_RAISED 93
+#define SMB_PRI_DEFAULT 81
+static uint32_t
+smb_known(uint32_t v)
+{
+	return v & (SMB_BIND | SMB_PRIO);
+}
+static uint32_t
+smb_unknown(uint32_t v)
+{
+	return v & ~(SMB_BIND | SMB_PRIO);
+}
+/* the priority sm_thread is created with: 0 = use kernel_thread_start (default priority, byte-identical to patch 0364) */
+static int
+smb_priority(uint32_t v)
+{
+	return (v & SMB_PRIO) ? SMB_PRI_RAISED : 0;
+}
+/* the cpu to bind to, or -1 = do not bind; boot_cpu = master_cpu */
+static int
+smb_bind_cpu(uint32_t v, int boot_cpu)
+{
+	return (v & SMB_BIND) ? boot_cpu : -1;
+}
+struct smb_wake {
+	uint64_t same, other;
+};
+static void
+smb_wake_account(struct smb_wake *w, int isr_cpu, int thread_cpu)
+{
+	if (isr_cpu == thread_cpu) {
+		w->same++;
+	} else {
+		w->other++;
+	}
+}
+/* SMBIND-PURE-END */
+
+static uint32_t smb_mask;      /* sweetsmbind after the unknown bits were cut; set once in sm_bringup before sm_thread exists */
+static int smb_bound_cpu = -1; /* set by sm_thread after the bind took effect (log only) */
+static uint32_t smb_isr_cpu;   /* cpu of the sm_isr that left the pending stamp: written by the ISR before the stamp, read by sm_thread after it took the stamp */
+static struct smb_wake smb_w;  /* under sm_lock */
+static uint64_t smb_last_us;
+extern kern_return_t kernel_thread_start_priority(thread_continue_t, void *, integer_t, thread_t *);   /* osfmk/kern/thread.h:1073; bsd/ does not see it */
+
 static uint64_t
 cl_ns(uint64_t abs)
 {
@@ -454,6 +517,27 @@ cl_tick(void)
 	}
 }
 
+/* sm_thread, lock NOT held: once per second print and reset the wake counters (patch 0365, log only) */
+static void
+smb_tick(void)
+{
+	if (!cl_on) {
+		return;
+	}
+	uint64_t now = now_us();
+	if (now - smb_last_us < 1000000) {
+		return;
+	}
+	smb_last_us = now;
+	lck_mtx_lock(&sm_lock);
+	struct smb_wake w = smb_w;
+	smb_w.same = smb_w.other = 0;
+	lck_mtx_unlock(&sm_lock);
+	if (w.same || w.other) {
+		printf("SWEET PERF: complat_wake wake_same %llu wake_other %llu isr_cpu %u bound_cpu %d sweetsmbind %u\n", w.same, w.other, os_atomic_load(&smb_isr_cpu, relaxed), smb_bound_cpu, smb_mask);
+	}
+}
