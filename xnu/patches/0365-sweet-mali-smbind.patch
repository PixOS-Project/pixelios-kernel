 		printf("SWEET MALI GAP: sweetcomplat=1 needs the JOB interrupt (sweetmaliirq=1 and attach accepted): no ISR stamps, every completion will count as noirq\n");
@@ -1226,6 +1330,10 @@ sm_thread(void *arg __unused, wait_result_t w __unused)
