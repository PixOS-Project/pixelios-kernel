+/* ==================================================================================================================================================
+ * phase 3 (patch 0287): raise CHGIN_ILIM 500 mA -> 875 mA (boot-arg sweetchgicl=900) and put it back (sweetchgicl=500). Default OFF. THE ONLY CHIP WRITES OF THE SERIES.
+ *
+ * Why: chg-p2 showed the input limit (CNFG_09 ILIM code 19 = 500 mA, SDP) is below the iOS load: net discharge [obs chg-p2: charging fast-CC, FG current -98 mA].
+ * Android allows up to 900 mA when a USB 3 link is configured AND the configuration declared 896 mA (GS composite.c:493-511, 952-967 -> usb_psy.c:31-38, 254-259
+ * SDP_SS_CONFIG_UA 900000; note 4). So the gadget's SuperSpeed configuration descriptor is raised to bMaxPower 112 = 896 mA with this boot-arg only (sweet_usb.c, same
+ * patch; review chg-0287 F1) and the code written is 0x22 = 875 mA, inside the declared 896 mA.
+ *
+ * What is written: ONE I2C write of two bytes to the charger (slave 0x69): [0xC2 = CHG_CNFG_09, (old & 0x80) | 0x22]. 0x22 = setter 0x04 + (875000 - 125000) / 25000,
+ * getter 100 + (0x22 - 3) x 25 = 875 mA [note 3, CNFG_09; BMS max77759_charger.c:1445-1473, 1475-1499]. NO_AUTOIBUS (bit 7) is kept and REQUIRED to be 1, as Android always
+ * writes it with the limit (BMS :1463-1468; review F4). The driver writes CNFG_09 without a CNFG_06 CHGPROT unlock (BMS :319-368 unlocks only around CNFG_12); on this phone
+ * CNFG_06 reads 0x0C (unlocked by ABL) [obs chg-p2 raw dump], so the claim is not exercised here and no unlock/relock write exists (review F5).
+ * Writes that can follow: the restore of the old value (once; after a read-back mismatch, or when the SuperSpeed link or CHGTYP is lost later in the boot, review F2), or with
+ * sweetchgicl=500 the step 0x22 -> 0x13 (500 mA, setter 0x04 + 15; review F3). Never written: CNFG_00/02/04/06/12/18, any OTG/boost mode (bit 3), any other chip. The writer
+ * (i2c_cnfg09_write) checks all of this itself and the host test proves it byte by byte.
+ *
+ * Preconditions of the raise, each a GAP line when it fails (nothing is written): phase 2 finished with 0 errors and passed identity (i2c_p2_ok); the phase-1 gate and
+ * the controller idle checks (i2c_gate); sweet_usb_ss_configured() (SuperSpeed + a configuration descriptor that declared >= 896 mA actually sent); TCPC CHGTYP SDP (1) or CDP (2)
+ * [note 4]; CNFG_00 MODE 4 or 5 [note 3]; CNFG_09 NO_AUTOIBUS = 1 and ILIM code 4..0x21. Then every 30 s: FG Current and VCell (+ CNFG_09, INT_OK), 10 times, and a watcher for
+ * the rest of the boot restores the old value if the SuperSpeed link or CHGTYP goes away. Host suspend is not detected (DEVTEN has no suspend event): the limit stays (GAP at start).
+ * ================================================================================================================================================== */
+#define ICL_ARG_UP      900u            /* sweetchgicl=900: raise */
+#define ICL_ARG_DOWN    500u            /* sweetchgicl=500: put it back */
+#define ICL_CODE        0x22u           /* 875 mA */
+#define ICL500_CODE     0x13u           /* 500 mA: 0x04 + (500000 - 125000) / 25000 [note 3 setter] */
+#define ICL_REG         0xc2u
+#define P3_SAMPLE_MS    30000u
+#define P3_SAMPLES      10u
+
+extern uint32_t sweet_usb_ss_configured(void);          /* bsd/dev/sweet_usb.c (patch 0287): DSTS.CONNECTSPD when the gadget is configured at SuperSpeed, else 0 */
+
+static int i2c_p2_ok, p3_stage, p3_nwrites, p3_orig_valid, p3_mode;
+static uint8_t p3_orig, p3_intended;
+static uint32_t p3_samples;
+static uint64_t p3_t0_ms, p3_next_ms, p3_w0_ms;
+
+/*
+ * The only chip write. cur = the CNFG_09 value just read (or, for the restore, the value we wrote); val = what to write. Allowed, nothing else:
+ *  (a) mode 900, the first write: val == (cur & 0x80) | 0x22, cur has NO_AUTOIBUS and an ILIM code in 4..0x21;
+ *  (b) after (a), the restore of the original value, once;
+ *  (c) mode 500, the first write: cur's ILIM code is exactly 0x22 and val == (cur & 0x80) | 0x13.
+ */
+static int
+i2c_cnfg09_write(uint8_t cur, uint8_t val)
+{
+	uint8_t b[2];
+	uint32_t code = cur & 0x7fu;
+	int first = p3_mode == ICL_ARG_UP && p3_nwrites == 0 && (cur & 0x80u) != 0 && val == (uint8_t)((cur & 0x80u) | ICL_CODE) && code >= 4u && code < ICL_CODE;
+	int restore = p3_mode == ICL_ARG_UP && p3_nwrites == 1 && p3_orig_valid && val == p3_orig && cur == p3_intended;
+	int down = p3_mode == ICL_ARG_DOWN && p3_nwrites == 0 && code == ICL_CODE && val == (uint8_t)((cur & 0x80u) | ICL500_CODE);
+
+	if (i2c_dead) {
+		return -1;
+	}
+	if (!first && !restore && !down) {
+		i2c_log("SWEET CHG GAP: P3 chip write 0x%x <- 0x%x refused (cur 0x%x, writes so far %d, mode %d): only the 875 mA step, one restore, or (mode 500) the step to 500 mA\n", ICL_REG,
+		    val, cur, p3_nwrites, p3_mode);
+		return -1;
+	}
+	if (first) {
+		p3_orig = cur;
+		p3_intended = val;
+		p3_orig_valid = 1;
+	}
+	b[0] = (uint8_t)ICL_REG;
+	b[1] = val;
+	p3_nwrites++;
+	i2c_xfers++;
+	if (i2c_msg(0x69, ICL_REG, 0, 1, 2, b, NULL) != 0) {
+		i2c_errors++;
+		i2c_dead = 1;
+		return -1;
+	}
+	return 0;
+}
+
+static void
+p3_done(const char *why)
+{
+	if (i2c_nwr != 0) {
+		(void)i2c_wr(I_INTEN, 0);
+	}
+	i2c_log("SWEET CHG P3: done (%s) chip_writes=%d samples=%u xfers=%u errors=%u\n", why, p3_nwrites, p3_samples, i2c_xfers, i2c_errors);
+	p3_stage = 9;
+}
+
+static int
+p3_refuse(const char *why)
+{
+	i2c_log("SWEET CHG GAP: P3 refused, CNFG_09 not written: %s\n", why);
+	p3_done("refused");
+	return 0;
+}
+
+/* Write val to CNFG_09 (via the guarded writer), read it back, log before/after. Returns 1 when the read-back equals val. */
+static int
+p3_write_verify(uint8_t cur, uint8_t val, uint8_t *readback)
+{
+	if (i2c_cnfg09_write(cur, val) != 0) {
+		return -1;
+	}
+	if (chg_i2c_read(0x69, 0xc2, 1, readback) != 0) {
+		return -2;
+	}
+	return *readback == val;
+}
+
+/* Reads, then (if everything holds) the one write + read-back + restore. Returns 1 when the 875 mA step is in place and the sampling may start. */
+static int
+p3_step(void)
+{
+	uint8_t bc = 0, c0 = 0, c6 = 0, c9 = 0, r9 = 0, r9b = 0;
+	uint32_t spd = sweet_usb_ss_configured();
+	int v;
+
+	if (spd == 0) {
+		return p3_refuse("the USB gadget is not a configured SuperSpeed link that declared 896 mA (speed unknown, high speed, or the 62 descriptor): 875 mA is the USB 3 value");
+	}
+	if (!i2c_gate(0)) {
+		return p3_refuse("phase-1 gate / controller idle check failed (see the GAP above)");
+	}
+	if (chg_i2c_read(0x25, 0x87, 1, &bc) != 0 || chg_i2c_read(0x69, 0xb9, 1, &c0) != 0 || chg_i2c_read(0x69, 0xbf, 1, &c6) != 0 || chg_i2c_read(0x69, 0xc2, 1, &c9) != 0) {
+		return p3_refuse("pre-read of BC_STATUS1 / CNFG_00 / CNFG_06 / CNFG_09 failed");
+	}
+	i2c_log("SWEET CHG P3: preflight usb_speed=%u BC_STATUS1=0x%x CHGTYP=%u CNFG_00=0x%x MODE=0x%x CNFG_06=0x%x CHGPROT=%u CNFG_09=0x%x ILIM=%u mA\n", spd, bc, bc & 3u, c0, c0 & 0xfu, c6,
+	    (c6 >> 2) & 3u, c9, chg_icl_ma(c9 & 0x7fu));
+	if ((bc & 3u) != 1u && (bc & 3u) != 2u) {
+		return p3_refuse("TCPC CHGTYP is not SDP (1) or CDP (2)");
+	}
+	if ((c0 & 0xfu) != 4u && (c0 & 0xfu) != 5u) {
+		return p3_refuse("CNFG_00 MODE is not 4 or 5");
+	}
+	if ((c9 & 0x80u) == 0) {
+		return p3_refuse("CNFG_09 NO_AUTOIBUS is 0: Android always programs it as 1 with a limit, that combination is not written");
+	}
+	if ((c9 & 0x7fu) < 4u) {
+		return p3_refuse("CNFG_09 ILIM code below 4 (input suspended or 100 mA): not touched");
+	}
+	if ((c9 & 0x7fu) >= ICL_CODE) {
+		return p3_refuse("CNFG_09 ILIM is already 875 mA or more");
+	}
+	v = p3_write_verify(c9, (uint8_t)((c9 & 0x80u) | ICL_CODE), &r9);
+	if (v == -1) {
+		i2c_log("SWEET CHG GAP: P3 CNFG_09 write failed (CNFG_09 state unknown, bus stopped, no restore possible)\n");
+		p3_done("write failed");
+		return 0;
+	}
+	if (v == -2) {
+		i2c_log("SWEET CHG GAP: P3 read-back of CNFG_09 failed (CNFG_09 state unknown, bus stopped, no restore possible)\n");
+		p3_done("read-back failed");
+		return 0;
+	}
+	i2c_log("SWEET CHG P3: CNFG_09 before=0x%x (%u mA) wrote=0x%x read back=0x%x (%u mA)\n", c9, chg_icl_ma(c9 & 0x7fu), p3_intended, r9, chg_icl_ma(r9 & 0x7fu));
+	if (v == 0) {
+		int w = i2c_cnfg09_write(p3_intended, p3_orig);      /* cur = the value we intended to write; the chip's actual value (r9) is what the mismatch is about */
+
+		if (w == 0) {
+			(void)chg_i2c_read(0x69, 0xc2, 1, &r9b);
+		}
+		i2c_log("SWEET CHG GAP: P3 CNFG_09 read-back 0x%x != written 0x%x: restore of 0x%x %s, read back after restore 0x%x; all further transfers stopped\n", r9, p3_intended,
+		    p3_orig, w == 0 ? "sent once" : "FAILED", r9b);
+		i2c_dead = 1;
+		p3_done("mismatch");
+		return 0;
+	}
+	i2c_log("SWEET CHG GAP: P3 host suspend is not detected (the gadget enables no suspend event): the input limit stays at 875 mA while a host sleeps\n");
+	return 1;
+}
