+		p3_done("nothing to restore");
+		return;
+	}
+	v = p3_write_verify(c9, (uint8_t)((c9 & 0x80u) | ICL500_CODE), &r9);
+	if (v < 0) {
+		i2c_log("SWEET CHG GAP: P3 CNFG_09 %s failed (state unknown, bus stopped)\n", v == -1 ? "write" : "read-back");
+		p3_done("500 mA step failed");
+		return;
+	}
+	i2c_log("SWEET CHG P3: CNFG_09 before=0x%x (%u mA) wrote=0x%x read back=0x%x (%u mA)\n", c9, chg_icl_ma(c9 & 0x7fu), (c9 & 0x80u) | ICL500_CODE, r9, chg_icl_ma(r9 & 0x7fu));
+	if (v == 0) {
+		i2c_log("SWEET CHG GAP: P3 CNFG_09 read-back 0x%x != written 0x%x, nothing more is written; all further transfers stopped\n", r9, (c9 & 0x80u) | ICL500_CODE);
+		i2c_dead = 1;
+		p3_done("500 mA mismatch");
+		return;
+	}
+	(void)i2c_wr(I_INTEN, 0);
+	p3_done("put back to 500 mA");
+}
+
+/* The link or the charger source we relied on is gone: put the original value back, once, if CNFG_09 is still what we wrote (review F2). */
+static void
+p3_lost(const char *what)
+{
+	uint8_t c9 = 0, r9 = 0;
+
+	i2c_log("SWEET CHG GAP: P3 %s lost: putting CNFG_09 back to the original value 0x%x\n", what, p3_orig);
+	if (i2c_dead) {
+		i2c_log("SWEET CHG GAP: P3 bus stopped earlier, CNFG_09 stays at the 875 mA step\n");
+		p3_done("link lost, no restore");
+		return;
+	}
+	if (!i2c_gate(0)) {
+		i2c_log("SWEET CHG GAP: P3 gate lost too, CNFG_09 stays at the 875 mA step\n");
+		p3_done("link lost, no restore");
+		return;
+	}
+	if (chg_i2c_read(0x69, 0xc2, 1, &c9) != 0) {
+		i2c_log("SWEET CHG GAP: P3 read of CNFG_09 failed, CNFG_09 state unknown\n");
+		p3_done("link lost, no restore");
+		return;
+	}
+	if (c9 != p3_intended) {
+		i2c_log("SWEET CHG GAP: P3 CNFG_09 is 0x%x, not the 0x%x we wrote: not touched\n", c9, p3_intended);
+		p3_done("link lost, changed by someone else");
+		return;
+	}
+	if (i2c_cnfg09_write(p3_intended, p3_orig) == 0 && chg_i2c_read(0x69, 0xc2, 1, &r9) == 0) {
+		i2c_log("SWEET CHG P3: CNFG_09 before=0x%x wrote=0x%x (the original) read back=0x%x%s\n", c9, p3_orig, r9, r9 == p3_orig ? "" : " MISMATCH, no further write");
+	} else {
+		i2c_log("SWEET CHG GAP: P3 restore of CNFG_09 failed, state unknown\n");
+	}
+	(void)i2c_wr(I_INTEN, 0);
+	p3_done("link lost, restored");
+}
+
+/* CHGTYP still SDP/CDP? (one read) */
+static int
+p3_chgtyp_ok(void)
+{
+	uint8_t bc = 0;
+
+	if (chg_i2c_read(0x25, 0x87, 1, &bc) != 0) {
+		return -1;
+	}
+	return (bc & 3u) == 1u || (bc & 3u) == 2u;
+}
+
+static void
+p3_sample(uint32_t t_s)
+{
+	uint8_t cu[2], vc[2], c9 = 0, io = 0;
+	int32_t cs;
+	uint32_t v;
+	int ct;
+
+	if (!i2c_gate(0)) {
+		p3_done("gate");
+		return;
+	}
+	if (chg_i2c_read(0x36, 0x0a, 2, cu) != 0 || chg_i2c_read(0x36, 0x09, 2, vc) != 0 || chg_i2c_read(0x69, 0xc2, 1, &c9) != 0 || chg_i2c_read(0x69, 0xb4, 1, &io) != 0) {
+		p3_done("sample read failed");
+		return;
+	}
+	cs = (int16_t)(cu[0] | ((uint32_t)cu[1] << 8));
+	v = vc[0] | ((uint32_t)vc[1] << 8);
+	/* same conversions as the P2 row: Current 312.5 uA/LSB (sign as read, the Android driver negates it), VCell 78.125 uV/LSB [note 2] */
+	i2c_log("SWEET CHG P3: t=%us current=%d uA vcell=%u mV cnfg09=0x%x ilim=%u mA int_ok=0x%x aicl_ok=%u\n", t_s, (int)((cs * 3125) / 10), (uint32_t)(((uint64_t)v * 78125u) / 1000000u), c9,
+	    chg_icl_ma(c9 & 0x7fu), io, io >> 7);
+	p3_samples++;
+	ct = p3_chgtyp_ok();
+	(void)i2c_wr(I_INTEN, 0);
+	if (ct == 0) {
+		p3_lost("TCPC CHGTYP (source no longer SDP/CDP)");
+	} else if (ct < 0) {
+		p3_done("chgtyp read failed");
+	}
+}
+
+static void
+i2c_p3_tick(int log_pending)
+{
+	uint32_t arg = 0;
+
+	if (p3_stage >= 9) {
+		return;
+	}
+	if (p3_stage == 0) {
+		p3_stage = 8;
+		if (!i2c_icl_arg(&arg)) {
+			i2c_log("SWEET CHG P3: off (default; sweetchgicl=900 raises CNFG_09 CHGIN_ILIM to 875 mA, sweetchgicl=500 puts it back: the only chip writes; need sweetchgi2c=1)\n");
+			p3_stage = 9;
+			return;
+		}
+		if (arg != ICL_ARG_UP && arg != ICL_ARG_DOWN) {
+			i2c_log("SWEET CHG GAP: P3 sweetchgicl=%u is not supported (only 900 or 500), nothing done\n", arg);
+			p3_stage = 9;
+			return;
+		}
+		if (!i2c_p2_ok) {
+			i2c_log("SWEET CHG GAP: P3 refused: phase 2 did not finish with 0 errors and passed identity checks (sweetchgi2c=1 needed), CNFG_09 not written\n");
+			p3_stage = 9;
+			return;
+		}
+		p3_mode = (int)arg;
+		i2c_log("SWEET CHG P3: start (patch 0287, sweetchgicl=%u)\n", arg);
+		p3_stage = 1;
+		p3_w0_ms = i2c_now_ms();
+		return;
+	}
+	if (p3_stage == 1) {
+		uint8_t cu[2], vc[2];
+
+		if (log_pending && i2c_now_ms() - p3_w0_ms < I2C_FORCE_MS) {
+			return;                 /* the start/preflight rows leave the log first, at most I2C_FORCE_MS */
+		}
+		p3_stage = 7;
+		if (p3_mode == (int)ICL_ARG_DOWN) {
+			p3_step500();
+			return;
+		}
+		if (chg_i2c_read(0x36, 0x0a, 2, cu) == 0 && chg_i2c_read(0x36, 0x09, 2, vc) == 0) {
+			int32_t cs = (int16_t)(cu[0] | ((uint32_t)cu[1] << 8));
+			uint32_t v = vc[0] | ((uint32_t)vc[1] << 8);
+
+			i2c_log("SWEET CHG P3: t=-0s current=%d uA vcell=%u mV (before the write)\n", (int)((cs * 3125) / 10), (uint32_t)(((uint64_t)v * 78125u) / 1000000u));
+		}
+		if (!p3_step()) {
+			return;
+		}
+		(void)i2c_wr(I_INTEN, 0);
+		p3_t0_ms = i2c_now_ms();
+		p3_next_ms = p3_t0_ms + P3_SAMPLE_MS;
+		p3_stage = 2;
+		return;
+	}
+	/* stages 2 (10 samples) and 3 (watcher for the rest of the boot): the SuperSpeed flag is checked every tick (no bus traffic), the I2C checks every 30 s */
+	if (!sweet_usb_ss_configured()) {
+		p3_lost("USB SuperSpeed link / 896 mA configuration");
+		return;
+	}
+	if (i2c_now_ms() >= p3_next_ms) {
+		if (p3_stage == 2) {
+			p3_sample((uint32_t)((p3_next_ms - p3_t0_ms) / 1000u));
+			if (p3_stage == 9) {
+				return;
+			}
+			if (p3_samples >= P3_SAMPLES) {
+				i2c_log("SWEET CHG P3: samples done (chip_writes=%d samples=%u xfers=%u errors=%u); the watcher keeps checking the link and CHGTYP every 30 s\n", p3_nwrites, p3_samples,
+				    i2c_xfers, i2c_errors);
+				p3_stage = 3;
+			}
+		} else if (p3_stage == 3) {
+			int ct = i2c_gate(0) ? p3_chgtyp_ok() : -2;
+
+			(void)i2c_wr(I_INTEN, 0);
+			if (ct == 0) {
+				p3_lost("TCPC CHGTYP (source no longer SDP/CDP)");
+				return;
+			}
+			if (ct < 0) {
+				i2c_log("SWEET CHG GAP: P3 watcher cannot check CHGTYP (%s): CNFG_09 stays at the 875 mA step\n", ct == -2 ? "gate lost" : "read failed");
+				p3_done("watcher stopped");
+				return;
+			}
+		}
+		p3_next_ms += P3_SAMPLE_MS;
+	}
+}
