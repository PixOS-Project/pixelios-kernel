+/* One window: params, scan on, listen, scan off; prints the window row (zeros when go is false). The scan-off always runs once the scan-on was SENT, whatever it returned.
+ * Returns NULL, or the name of the off step when it did not return 0 (the scan may still be on). */
+static const char *
+sbu_rfw_window(const struct sbu_rfw_win *c, bool go, struct sbu_rfw *w)
+{
+	uint8_t rp[SBU_PM_SUPP];
+	size_t rpn = 0;
+	const char *bad = NULL;
+
+	if (go && sbu_rfw_cmd(c->s_par, 0x200b, c->par, sizeof(c->par), rp, sizeof(rp), &rpn) == 0) {
+		if (sbu_rfw_cmd(c->s_on, 0x200c, c->on, sizeof(c->on), rp, sizeof(rp), &rpn) == 0) {
+			sbu_rfw_listen(c->what, SBU_RFW_LE_MS, false, w);
+		}
+		if (sbu_rfw_cmd(c->s_off, 0x200c, c->off, sizeof(c->off), rp, sizeof(rp), &rpn) != 0) {
+			bad = c->s_off;
+		}
+	}
+	printf("BT RFWIT: %s %u ms: events=%u adv_report_events=%u adv_reports=%u le_other=%u other=%u stray=%u rxerr=%u rssi_max=%d%s\n", c->title, SBU_RFW_LE_MS,
+	    w->ev, w->adv_ev, w->adv_reports, w->le_other, w->other, w->stray, w->rxerr, w->rssi_max == SBU_RFW_NORSSI ? 0 : w->rssi_max, w->rssi_max == SBU_RFW_NORSSI ? " (none)" : "");
+	return bad;
+}
