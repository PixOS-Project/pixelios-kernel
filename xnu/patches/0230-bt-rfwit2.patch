+/*
+ * patch 0230 (T-4ee1), only with sweetbtrfwit=1: the rx thread prints a heartbeat row every SBU_HB_EVERY passes (max SBU_HB_MAX rows, then one cap row). bt-up13 [obs 20261107T112603Z-bt-up13]:
+ * bluetoothd's scan got no byte for 253 s; the log cannot tell a silent line from a dead rx thread or a stuck flow-control line. Only registers that do not change state are read
+ * (UMCON, UMSTAT, UFSTAT, UTRSTAT); NEVER UERSTAT (the read clears the error flags) or URXH (consumes data). No store; no address or payload byte is printed.
+ */
+#define SBU_HB_EVERY 3000u
+#define SBU_HB_MAX   40u
+static unsigned sbu_hb_polls, sbu_hb_rows;
+
+static void
+sbu_rx_heartbeat(void)
+{
+	if (!sbu_hb_on || !sbu.uart_ok) {
+		return;
+	}
+	if (++sbu_hb_polls % SBU_HB_EVERY != 0 || sbu_hb_rows > SBU_HB_MAX) {
+		return;
+	}
+	if (sbu_hb_rows++ == SBU_HB_MAX) {
+		printf("BT RX: heartbeat cap reached (%u rows)\n", SBU_HB_MAX);
+		return;
+	}
+	printf("BT RX: heartbeat polls=%u rx_bytes=%u rx_err=%u umcon=%#x umstat=%#x ufstat=%#x utrstat=%#x\n", sbu_hb_polls, sbu.rx_bytes, sbu.rx_err,
+	    sbu_rd(SBU_UART + U_UMCON), sbu_rd(SBU_UART + U_UMSTAT), sbu_rd(SBU_UART + U_UFSTAT), sbu_rd(SBU_UART + U_UTRSTAT));
+}
