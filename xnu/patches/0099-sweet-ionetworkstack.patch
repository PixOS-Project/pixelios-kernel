--- a/iokit/Kernel/arm/SweetFramebuffer.cpp
+++ b/iokit/Kernel/arm/SweetFramebuffer.cpp
@@ -134,6 +134,47 @@
 
 OSDefineMetaClassAndStructors(AppleCLCD, IOMobileFramebuffer);
 
+/*
+ * configd's InterfaceNamer (the "network stack" part of SCNetworkInterfaceCopyAll, which Settings -> About calls on the main
+ * thread) matches IOServiceMatching("IONetworkStack"), IOServiceOpen()s it and keeps the connection in a flag (configd
+ * disassembly: first-match callback 0x100018894, flag 0x100071b38). When IOKit goes quiet and the flag is 0 it only logs
+ * "No network stack object" and publishes nothing (callback 0x100018468 -> 0x100018634), so the waiters in Preferences run
+ * into InterfaceNamer's 300 s timer. The class lives in the IONetworkingFamily kext, which this kernel does not have. This
+ * stand-in only has to match and open; its user client refuses every call (no interface needs naming: there is no network
+ * hardware behind it yet).
+ */
+class IONetworkStack : public IOService {
+	OSDeclareDefaultStructors(IONetworkStack);
+};
+
+OSDefineMetaClassAndStructors(IONetworkStack, IOService);
+
+class IONetworkStackUserClient : public IOUserClient {
+	OSDeclareDefaultStructors(IONetworkStackUserClient);
+
+public:
+	IOReturn clientClose(void) APPLE_KEXT_OVERRIDE;
+	IOReturn externalMethod(uint32_t selector, IOExternalMethodArguments *args,
+	    IOExternalMethodDispatch *dispatch, OSObject *target,
+	    void *reference) APPLE_KEXT_OVERRIDE;
+};
+
+OSDefineMetaClassAndStructors(IONetworkStackUserClient, IOUserClient);
+
+IOReturn
+IONetworkStackUserClient::clientClose(void)
+{
+	terminate();
+	return kIOReturnSuccess;
+}
+
+IOReturn
+IONetworkStackUserClient::externalMethod(uint32_t selector __unused, IOExternalMethodArguments *args __unused,
+    IOExternalMethodDispatch *dispatch __unused, OSObject *target __unused, void *reference __unused)
+{
+	return kIOReturnUnsupported;
+}
+
 class IOMobileFramebufferUserClient : public IOUserClient {
 	OSDeclareDefaultStructors(IOMobileFramebufferUserClient);
 
