+/*
+ * patch 0354 (lowclk 2026-11-14): UFS command completion by interrupt, boot-arg sweetufsirq (docs/research/154). Absent or 0: nothing below runs, no register is touched, no line is
+ * printed (an invalid value logs a GAP and counts as 0). 2 = stage 0, reads only (IS/IE/UTRIACR/UTRLCNR/VER once, IS bit counts per polled command). 1 = stage 1: a kernel thread started
+ * after su.ready arms it (GIC INTID 564 = SPI 532 attached DISABLED, stale IS cleared, IE := 0x1 and read back, SPI enabled, armed last); the wait of ufs_scsi then sleeps on the
+ * interrupt with a 1 ms fallback wake. The logic (judge table, ISR, wait, counters, storm and no-interrupt auto-off) is bsd/dev/sweet_ufs_irq.h, host tested by
+ * tools/test_ufs_irq_core.py; this block is the kernel side of its ops. The write path (the block writer with its bounds check, the doorbell write, the timeout's UTRLCLR write) is not touched.
+ */
+#include "sweet_ufs_irq.h"
+#define SU_INTID 564u       /* gs101 UFS: GIC SPI 532 + 32 (research 154 s.2) */
+#define SU_ROW_NS (5ull * NSEC_PER_SEC)
+extern int sweet_spi_attach_off(uint32_t intid, int (*fn)(void *, uint32_t), void *arg, uint32_t rb[4]);   /* pexpert/arm/pe_fiq.c (patch 0346) */
+extern int sweet_spi_enable(uint32_t intid, uint32_t *en);
+extern int sweet_spi_detach(uint32_t intid);
+extern void sweet_spi_counts(uint32_t intid, uint64_t *handled, uint64_t *unhandled, uint32_t *unhandled_last);
+static struct sui sui;
+static struct sui_ops sui_kops;                 /* filled by sui_start() before anything can use it */
+static int sui_thr_evt, sui_idle_evt;           /* addresses only: the summary thread's wake event and its never-woken parking event */
+
+static int
+sui_k_rd(void *cx __unused, uint32_t off, uint32_t *v)
+{
+	*v = ufs_rd(off);
+	return 0;
+}
+
+static int
+sui_k_wr(void *cx __unused, uint32_t off, uint32_t v)
+{
+	ufs_wr(off, v);
+	__builtin_arm_dsb(0xf);
+	return 0;
+}
+
+static uint64_t
+sui_k_now(void *cx __unused)
+{
+	uint64_t ns;
+
+	absolutetime_to_nanoseconds(mach_absolute_time(), &ns);
+	return ns;
+}
+
+static int
+sui_k_isr(void *arg __unused, uint32_t intid __unused)
+{
+	return sui_isr(&sui, &sui_kops, sui_k_now(NULL));
+}
+
+static int
+sui_k_attach(void *cx __unused, uint32_t rb[4])
+{
+	return sweet_spi_attach_off(SU_INTID, sui_k_isr, &su, rb);
+}
+
+static int
+sui_k_enable(void *cx __unused, uint32_t *en)
+{
+	return sweet_spi_enable(SU_INTID, en);
+}
+
+static int
+sui_k_detach(void *cx __unused)
+{
+	return sweet_spi_detach(SU_INTID);
+}
+
+static void
+sui_k_pause(void *cx __unused)
+{
+	delay(1);
+}
+
+static int
+sui_k_wait_begin(void *cx __unused, uint64_t wake_ns)
+{
+	uint64_t wake;
+
+	nanoseconds_to_absolutetime(wake_ns, &wake);
+	/* Keep the mutex: the slot and the bounce buffer are still owned (same as the ufswait sleep). */
+	return assert_wait_deadline_with_leeway((event_t)&su.wait, THREAD_UNINT, TIMEOUT_URGENCY_SYS_CRITICAL, wake, 0) == THREAD_WAITING;
+}
+
+static void
+sui_k_wait_cancel(void *cx __unused)
+{
+	clear_wait(current_thread(), THREAD_AWAKENED);
+}
+
+static int
+sui_k_block(void *cx __unused)
+{
+	return thread_block(THREAD_CONTINUE_NULL) == THREAD_TIMED_OUT;
+}
+
+static void
+sui_k_wake(void *cx __unused)
+{
+	thread_wakeup((event_t)&su.wait);              /* ISR safe: the Wi-Fi and Mali ISRs wake their threads the same way */
+}
+
+static void
+sui_k_kick(void *cx __unused)
+{
+	thread_wakeup((event_t)&sui_thr_evt);
+}
+
+static uint32_t
+sui_k_ocs(void *cx __unused)
+{
+	const unsigned slot = su.gs101 ? 1 : 0;
+	struct utrd *utrd = (struct utrd *)(su.dma + DMA_UTRL) + slot;
+
+	dma_sync(DMA_UTRL + slot * sizeof(*utrd), sizeof(*utrd));
+	return utrd->dw2 & 0xff;
+}
+
+static void
+sui_k_note(void *cx __unused, int code, uint32_t a, uint32_t b)
+{
+	switch (code) {
+	case SUI_N_ATTACH1:
+		printf("SWEET UFS IRQ: attach INTID %u (SPI left disabled) group %u enabled %u\n", SU_INTID, a, b);
+		break;
+	case SUI_N_ATTACH2:
+		printf("SWEET UFS IRQ: attach icfgr %#x irouter %#x\n", a, b);
+		break;
+	case SUI_N_UTRIACR:
+		printf("SWEET UFS IRQ: UTRIACR %#x (read only, never written)\n", a);
+		break;
+	case SUI_N_RO1:
+		printf("SWEET UFS IRQ: ro UTRIACR %#x UTRLCNR %#x\n", a, b);
+		break;
+	case SUI_N_RO2:
+		printf("SWEET UFS IRQ: ro IE %#x IS %#x\n", a, b);
+		break;
+	case SUI_N_RO3:
+		printf("SWEET UFS IRQ: ro VER %#x UTRLDBR %#x\n", a, b);
+		break;
+	case SUI_N_ARMED:
+		printf("SWEET UFS IRQ: ARMED INTID %u, IE %#x (UTRCS only), 1 ms fallback wake, off after >%u spurious entries/s or %u commands with no interrupt, polling kept as fallback\n",
+		    SU_INTID, a, SUI_STORM_MAX, SUI_NOIRQ_MAX);
+		break;
+	case SUI_N_QUIESCE:
+		printf("SWEET UFS IRQ: off (restart): IE 0, INTID %u detached, irqs %u\n", SU_INTID, a);
+		break;
+	case SUI_G_ARM_BUSY:
+		printf("SWEET UFS IRQ GAP: UTRLDBR %#x: a command is in flight, not armed (stage 0 reads on)\n", a);
+		break;
+	case SUI_G_ATTACH:
+		printf("SWEET UFS IRQ GAP: GIC attach of INTID %u failed rc %u (19 no GICD, 22 bad or duplicate INTID, 28 no slot): not armed, polling\n", SU_INTID, a);
+		break;
+	case SUI_G_AGGR:
+		printf("SWEET UFS IRQ GAP: UTRIACR %#x has bit 31 (interrupt aggregation) set: not written; completions may be coalesced, the 1 ms fallback wake covers it\n", a);
+		break;
+	case SUI_G_IE_RB:
+		printf("SWEET UFS IRQ GAP: IE reads back %#x after the write of 0x1: disarming, polling\n", a);
+		break;
+	case SUI_G_ENABLE:
+		printf("SWEET UFS IRQ GAP: SPI enable of INTID %u failed rc %u (ISENABLER bit %u): disarming, polling\n", SU_INTID, a, b);
+		break;
+	case SUI_G_REFUSED:
+		printf("SWEET UFS IRQ GAP: register access refused by the judge (offset %#x): disarming, polling\n", a);
+		break;
+	case SUI_G_BUS:
+		printf("SWEET UFS IRQ GAP: register access failed (offset %#x): disarming, polling\n", a);
+		break;
+	case SUI_G_ARM_ACC:
+		printf("SWEET UFS IRQ GAP: register read of offset %#x %s before anything was attached or written: not armed, polling\n", a, b ? "refused by the judge" : "failed");
+		break;
+	case SUI_G_ACCESS:
+		printf("SWEET UFS IRQ GAP: %s of offset %#x %s (place %u: 1 ack, 2 read-only per command, 3 read-only init); interrupt mode unchanged, polling carries on as before (rate limited)\n",
+		    "read", a, (b & 1u) ? "refused by the judge" : "failed", b >> 8);
+		break;
+	case SUI_G_OFF:
+		printf("SWEET UFS IRQ GAP: interrupt mode OFF (%s): IE 0, INTID %u detached, irqs %u; polling carries every command\n", sui_mode_str(&sui), SU_INTID, b);
+		break;
+	case SUI_G_OTHER_IS:
+		printf("SWEET UFS IRQ GAP: IS bits other than UTRCS seen: %#x (count %u); stage 1 enables UTRCS only, the ISR clears what it reads\n", a, b);
+		break;
+	default:
+		printf("SWEET UFS IRQ GAP: teardown step %u failed (%u): 1 IE := 0, 2 IS read/clear, 3 GIC detach\n", a, b);
+		break;
+	}
+}
+
+static void
+sui_row(void)
+{
+	static uint32_t last_is0;
+	if (sui.mode == SUI_MODE_RO) {
+		printf("SWEET UFS IRQ: ro cmds %u is0 %u (%u/5s) isx %u ocs0f %u\n", sui.ro_cmds, sui.ro_is0, sui.ro_is0 - last_is0, sui.ro_isx, sui.ro_ocs0f);
+		last_is0 = sui.ro_is0;
+		return;
+	}
+	uint64_t h, u;
+	uint32_t ul;
+	sweet_spi_counts(SU_INTID, &h, &u, &ul);
+	printf("SWEET UFS IRQ: irqs %u spurious %u poll_found %u cmds %u mode %s fast %u tmo_wakes %u isr %u refused %u noirq_run %u isr_again %u gic_handled %llu gic_unhandled %llu\n",
+	    sui.irqs, sui.spurious, sui.poll_found, sui.cmds, sui_mode_str(&sui), sui.fast, sui.tmo_wakes, sui.isr_total, sui.refused, sui.noirq_run, sui.isr_again, h, u);
+}
+
+/* Summary thread (thread context): arms (stage 1) or reads (stage 0) once under the driver lock, then one row per 5 s while there is something to report; the ISR's storm disable
+ * wakes it to finish the teardown. After the mode went off it prints the final row and parks. Started after su.ready, so the root mount stays polled. */
+static void
+sui_thread(void *arg __unused, wait_result_t wr __unused)
+{
+	lck_mtx_lock(&sweet_ufs_lock);
+	if (sui.mode == SUI_MODE_ON) {
+		(void)sui_arm(&sui, &sui_kops);
+	} else {
+		(void)sui_ro_init(&sui, &sui_kops);
+	}
+	lck_mtx_unlock(&sweet_ufs_lock);
+	for (;;) {
+		uint64_t dl;
+		bool live = sui.mode == SUI_MODE_RO || sui.armed;
+
+		nanoseconds_to_absolutetime(SU_ROW_NS, &dl);
+		dl += mach_absolute_time();
+		if (live && assert_wait_deadline((event_t)&sui_thr_evt, THREAD_UNINT, dl) == THREAD_WAITING) {
+			thread_block(THREAD_CONTINUE_NULL);
+		}
+		if (sui.off_pending) {
+			lck_mtx_lock(&sweet_ufs_lock);
+			sui_finish(&sui, &sui_kops);
+			lck_mtx_unlock(&sweet_ufs_lock);
+		}
+		sui_row();
+		if (sui.mode == SUI_MODE_ON && !sui.armed) {
+			break;
+		}
+	}
+	for (;;) {
+		if (assert_wait((event_t)&sui_idle_evt, THREAD_UNINT) == THREAD_WAITING) {
+			thread_block(THREAD_CONTINUE_NULL);
+		}
+	}
+}
+
+static void
+sui_start(void)
+{
+	thread_t thread;
+
+	if (sui.mode == SUI_MODE_0) {
+		return;
+	}
+	if (sui.mode == SUI_MODE_ON && !su.gs101) {
+		printf("SWEET UFS IRQ GAP: sweetufsirq=1 needs the gs101 host (INTID %u is its UFS SPI): ignored, polling\n", SU_INTID);
+		sui.mode = SUI_MODE_0;
+		return;
+	}
+	sui_kops = (struct sui_ops){
+		.ctx = NULL, .rd = sui_k_rd, .wr = sui_k_wr, .spi_attach_off = sui_k_attach, .spi_enable = sui_k_enable, .spi_detach = sui_k_detach,
+		.now = sui_k_now, .pause = sui_k_pause, .wait_begin = sui_k_wait_begin, .wait_cancel = sui_k_wait_cancel, .block = sui_k_block,
+		.wake = sui_k_wake, .kick = sui_k_kick, .ocs = sui_k_ocs, .note = sui_k_note,
+	};
+	if (kernel_thread_start(sui_thread, NULL, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	} else {
+		printf("SWEET UFS IRQ GAP: sweetufsirq=%u: could not start the thread, polling\n", sui.mode);
+		sui.mode = SUI_MODE_0;
+	}
+}
+
+/* Called by sweet_clean_stop (patch 0083 sweet_restart.c) after the filesystem sync and before the reset: IE back to 0 so a reset never starts with our enable set (research 154 risk 7).
+ * Waits up to 100 ms for the driver lock; after that it disarms WITHOUT it (the sync may have TIMED OUT with a sync-thread command still holding the lock, and a restart must not hang on
+ * it). That is safe here: the disarm only writes IE := 0 and IS (the same value rules as under the lock) and detaches the handler, nothing the command in flight depends on; a line says so. */
+void sweet_ufs_irq_quiesce(void);
+void
+sweet_ufs_irq_quiesce(void)
+{
+	bool locked = false;
+
+	if (sui.mode != SUI_MODE_ON || (!sui.armed && !sui.ie_on && !sui.spi_att)) {
+		return;
+	}
+	for (int i = 0; i < 100 && !(locked = lck_mtx_try_lock(&sweet_ufs_lock)); i++) {
+		delay(1000);
+	}
+	if (!locked) {
+		printf("SWEET UFS IRQ GAP: quiesce without the driver lock (still held after 100 ms: a command is in flight, the sync may have timed out): IE := 0 and the detach are done anyway\n");
+	}
+	sui_disarm(&sui, &sui_kops, SUI_Y_RESTART);
+	if (locked) {
+		lck_mtx_unlock(&sweet_ufs_lock);
+	}
+}
+
+/* Called first thing in sweet_machine_reset_x (patch 0083 sweet_restart.c, after the pets stop), on EVERY software reset path (reboot(2), panic, sweetrestart, sweetremote): lock-free IE := 0 when
+ * our enable is set (review 0354 finding 2). Reset or panic context: no lock, no wait, no print (a print could fault there, nothing is logged), no detach; one MMIO write through the same
+ * judge row as the disarm (register 0x24, value 0). Not called with the sync done: sweet_clean_stop's quiesce above already did the full teardown on the clean paths. */
+void sweet_ufs_irq_ie_off(void);
+void
+sweet_ufs_irq_ie_off(void)
+{
+	sui_ie_off(&sui, &sui_kops);
+}
+
 /*
