+static struct sti1 tg_sti1;
+static bool tg_sti1_mux_ok;     /* set after tg_report_and_check_mux() passed in tg_run: the AP owns the touch bus */
+static int
+tg_sti1_rd(void *ctx, uint32_t off, uint32_t *v)
+{
+	(void)ctx;
+	if (!tg.alive) {
+		return -1;
+	}
+	*v = *(volatile uint32_t *)(tg.alive + off);
+	__asm__ volatile ("dmb oshld" ::: "memory");
+	return 0;
+}
+static int
+tg_sti1_wr(void *ctx, uint32_t off, uint32_t v)
+{
+	(void)ctx;
+	if (!tg.alive) {
+		return -1;
+	}
+	if (off != 0x0C0u && off != 0x718u && off != 0x918u && off != 0xA18u) {   /* CON, ECON, EMASK, EPEND of gpa9: nothing else */
+		return -2;
+	}
+	if (off == 0xA18u && v != 1u) {                                           /* EPEND is write-one-to-clear of pin 0 only */
+		return -2;
+	}
+	*(volatile uint32_t *)(tg.alive + off) = v;
+	__asm__ volatile ("dsb sy" ::: "memory");
+	return 0;
+}
+static int tg_sti1_isr_k(void *arg, uint32_t intid);
+static int
+tg_sti1_attach(void *ctx, uint32_t rb[4])
+{
+	(void)ctx;
+	return sweet_spi_attach_off(STI1_INTID, tg_sti1_isr_k, NULL, rb);
+}
+static int
+tg_sti1_enable(void *ctx, uint32_t *en)
+{
+	(void)ctx;
+	return sweet_spi_enable(STI1_INTID, en);
+}
+static int
+tg_sti1_detach(void *ctx)
+{
+	(void)ctx;
