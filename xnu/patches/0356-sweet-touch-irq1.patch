+/* the armed thread's wait: assert_wait, then the no-lost-wakeup re-check, then block; the ISR's thread_wakeup on the same event ends it early */
+static void
+tg_sti1_sleep(void)
+{
+	uint64_t deadline;
+	clock_interval_to_deadline(sti1_wait_ms(&tg_sti1, 0), NSEC_PER_MSEC, &deadline);   /* armed: STI1_SAFETY_MS */
+	(void)assert_wait_deadline(&tg.sleep_chan, THREAD_UNINT, deadline);
+	if (sti1_wake_pending(&tg_sti1)) {
