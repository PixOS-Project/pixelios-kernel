diff --git a/bsd/dev/sweet_touch_irq1.h b/bsd/dev/sweet_touch_irq1.h
new file mode 100644
index 0000000..960f9d7
--- /dev/null
+++ b/bsd/dev/sweet_touch_irq1.h
@@ -0,0 +1,651 @@
+/*
+ * sweet_touch_irq1.h - FTM5 touch interrupt, STAGE 1 (patch 0356, boot-arg sweettouchirq=1): the touch thread sleeps on the gpa9[0] level-low EINT instead of the 8 ms poll.
+ *
+ * Spec: docs/research/155-touch-ftm5-interrupt.md sections 3, 5, 6. Stage 0 (patch 0355, sweettouchirq=2) measured the pad: ECON 0, EFLTCON 0, EMASK 0xff, EPEND 0, CON func 0, DAT idle 1, the line low while the FIFO holds events.
+ * Linux reference (the register recipe, read from source): drivers/pinctrl/samsung/pinctrl-exynos.c v6.17 exynos_irq_mask :58-87 (EMASK |= 1<<hwirq), exynos_irq_ack :89-110 (EPEND := 1<<hwirq, plain store),
+ *   exynos_irq_unmask :112-152 (level types: ack first, then EMASK &= ~(1<<hwirq)), exynos_irq_set_type :154-210 (ECON: con &= ~(EXYNOS_EINT_CON_MASK << shift); con |= trig << shift, shift = 4 * hwirq);
+ *   drivers/pinctrl/samsung/pinctrl-exynos.h (refs copy ~/pixelios-artifacts/refs/wlan-stage1/linux-pinctrl-exynos.h :44-50): EXYNOS_EINT_LEVEL_LOW = 0, EXYNOS_EINT_CON_MASK = 0xF, EXYNOS_EINT_CON_LEN = 4,
+ *   :20 EXYNOS_PIN_CON_FUNC_EINT = 0xf. Register addresses: research 155 s.3 (pinctrl-gs.c:79 gpa9 bank: pad base 0xC0, eint_offset 0x18; exynos7 chip ECON 0x700, EMASK 0x900, EPEND 0xA00).
+ *   The vendor driver requests the line level-low, oneshot, threaded (fts_touch ftm5/fts.c:5303-5304). ECON field width: the source masks 4 bits per pin (0xF), not 3: this file writes the 4-bit nibble.
+ *
+ * The pure core (between STI1_CORE_BEGIN and STI1_CORE_END) is compiled and run by tools/test_touch_irq1_core.py with a fake gpa9 bank, a fake FTM5 and a fake GIC.
+ *
+ * EVERY hardware access of this feature goes through sti1_rd / sti1_rmw (one allowlist, sti1_rows[], plus the value rules of sti1_wr_ok, independent of the driver's own tg_rd/tg_wr):
+ *   write rows (pin 0 of gpa9 ONLY, each a read-modify-write that keeps the other seven pins' bits exactly, except EPEND which is a plain write-one-to-clear store of exactly 0x1):
+ *     CON    0x0C0 bits [3:0]: 0xF (EINT function) while arming, back to the value read at arm (0) while disarming
+ *     ECON   0x718 bits [3:0]: 0 (level low) while arming, back to the value read at arm while disarming
+ *     EMASK  0x918 bit 0:      1 = masked (always allowed once the feature has touched anything), 0 = unmasked (only after attach, CON, ECON, EPEND clear, never during a shutdown)
+ *     EPEND  0xA18 write 0x1 (W1C)
+ *   read rows: CON, DAT 0x0C4, ECON, EFLTCON 0x828, EMASK, EPEND. EFLTCON has NO write row (it is never written). PUD 0x0C8, DRV and every other word: no row.
+ *   GIC: INTID 67 (SPI 35) through the patch 0346 helpers: attach DISABLED, enable after the line is unmasked, detach at disarm (not on the reset path).
+ * Concurrency of the EMASK word (no lock is possible in the ISR): the ISR only ever SETS bit 0 and only while the line is unmasked; the thread only ever CLEARS bit 0 and only while the ISR has run since its last clear
+ * (the line is then masked, so the ISR cannot run); the ISR publishes its sequence number AFTER its stores. Nobody else in XNU writes this bank (research 155 s.5 item 4).
+ * The ISR makes NO SPI access and NO log call (the host test traps both). Not run on hardware.
+ */
+#ifndef SWEET_TOUCH_IRQ1_H
+#define SWEET_TOUCH_IRQ1_H
+#include <stddef.h>
+#include <stdint.h>
+#ifndef STI1_LOG
+#error "define STI1_LOG(...) before including sweet_touch_irq1.h"
+#endif
+/* STI1_CORE_BEGIN */
+#define STI1_PAD_PA        0x174D00C0ull   /* gpa9 bank CON register: board.json touch_pin_irq = gpa9[0], soc.json gpa9_bank [research 155 s.1] */
+#define STI1_INTID         67u             /* SPI 35 + 32 [research 155 s.1; gs101-pinctrl.dtsi:92-105 IRQ_ALIVE_EINT35] */
+#define STI1_OFF_CON       0x0C0u
+#define STI1_OFF_DAT       0x0C4u
+#define STI1_OFF_ECON      0x718u          /* 0x700 + eint_offset 0x18 */
+#define STI1_OFF_EFLTCON   0x828u          /* 0x800 + fltcon_offset 0x28: READ ONLY */
+#define STI1_OFF_EMASK     0x918u          /* 0x900 + 0x18 */
+#define STI1_OFF_EPEND     0xA18u          /* 0xA00 + 0x18 */
+#define STI1_FUNC_EINT     0xFu            /* EXYNOS_PIN_CON_FUNC_EINT */
+#define STI1_ECON_LEVEL_LOW 0u             /* EXYNOS_EINT_LEVEL_LOW */
+#define STI1_SAFETY_MS     100u            /* the armed thread's wait: a missed interrupt is found by the timeout drain at the latest after this (brief) */
+#define STI1_SUMMARY_NS    10000000000ull  /* one summary row every 10 s */
+#define STI1_WIN_NS        1000000000ull   /* the storm windows: one second */
+#define STI1_STORM_EMPTY   200u            /* interrupt wakes with an empty FIFO per second above which the mode turns itself off (brief) */
+#define STI1_STUCK_K       3u              /* GUESS: drains in a row that find the FIFO empty with the line still low */
+#define STI1_NOIRQ_N       10u             /* GUESS: safety-timeout drains that found events although no interrupt came, within ONE window of STI1_TMO_WIN_NS */
+#define STI1_ISR_STORM     1000u           /* GUESS: ISR entries per second (a hard cap on top of the thread's rule; a real touch burst is far below) */
+#define STI1_TMO_WIN_NS    10000000000ull  /* the missed-interrupt count is per 10 s window */
+#define STI1_ERR_N         10u             /* GUESS: drain errors in a row, then back to polling */
+#define STI1_TMO_LOG       5u              /* GAP lines for timeout drains that found events: the first 5 */
+
+enum { STI1_S_OFF = 0, STI1_S_ARMING, STI1_S_ARMED, STI1_S_DISARMING };
+enum { STI1_Y_NONE = 0, STI1_Y_STORM, STI1_Y_STUCK, STI1_Y_NOIRQ, STI1_Y_BUS, STI1_Y_REFUSED, STI1_Y_RB, STI1_Y_ATTACH, STI1_Y_ENABLE, STI1_Y_ISR, STI1_Y_QUIESCE, STI1_Y_PRE };
+enum { STI1_R = 1, STI1_W = 2 };
+
+struct sti1_ops {
+	void *ctx;
+	int (*rd)(void *ctx, uint32_t off, uint32_t *v);           /* 0 = ok */
+	int (*wr)(void *ctx, uint32_t off, uint32_t v);            /* 0 = ok; store done and ordered (dsb) */
+	int (*spi_attach_off)(void *ctx, uint32_t rb[4]);          /* patch 0346 sweet_spi_attach_off(67): SPI left DISABLED; 0 = ok else the helper's rc */
+	int (*spi_enable)(void *ctx, uint32_t *en);                /* patch 0346 sweet_spi_enable(67); *en = the enable bit read back */
+	int (*spi_detach)(void *ctx);                              /* patch 0346 sweet_spi_detach(67) */
+	uint64_t (*now)(void *ctx);                                /* ns; ISR safe */
+	void (*wake)(void *ctx);                                   /* thread_wakeup of the touch thread; ISR safe */
+};
+
+struct sti1 {
+	int mode;                       /* 0 = off (behaviour unchanged), 1 = stage 1 requested; set once by sti1_arg */
+	volatile int state;             /* STI1_S_* */
+	volatile int why;               /* STI1_Y_*: first reason the mode is off (0 = none yet) */
+	volatile int off_req;           /* the ISR asks the thread to disarm (the thread owns every other state change) */
+	volatile int quiesce;           /* clean stop / reset: no arm, disarm at the next pass */
+	volatile int unmasked;          /* the line has been unmasked and not masked again since (the reset path then writes the mask) */
+	int mask_done, con_set, econ_set, pend_done, att;   /* steps of the arm that have been done (the disarm undoes exactly these) */
+	uint32_t con_orig, econ_orig;   /* pin 0 fields read at arm */
+	volatile uint32_t isr_total, isr_seq, isr_err;
+	uint64_t win_start;             /* ISR window */
+	uint32_t win_n;
+	uint32_t last_seq, unm_seq, wakes, empty, tmo_drains, tmo_found, storm_n, low_run, refused, err_run, tmo_win_n, rechk_low;
+	uint64_t tmo_win_start;         /* the missed-interrupt window */
+	volatile int redo;              /* the DAT re-check after an unmask found the line low and no interrupt: drain again at once */
+	uint64_t twin_start;            /* thread storm window */
+	uint32_t twin_n;
+	uint64_t sum_ns;
+	int sum_init, settle;
+};
+
+/* boot-arg value as PE_parse_boot_argn gave it: 0 / absent = off, 1 = stage 1, 2 = patch 0355's stage 0 (not handled here), anything else = GAP, off */
+static void
+sti1_arg(struct sti1 *st, int present, int val)
+{
+	st->mode = 0;
+	if (!present || val == 0 || val == 2) {
+		return;
+	}
+	if (val == 1) {
+		st->mode = 1;
+		return;
+	}
+	STI1_LOG("TOUCH GAP: sweettouchirq=%d: unknown value (0 = polled, 1 = interrupt, 2 = read-only measurement), treated as 0\n", val);
+}
+
+static const char *
+sti1_why_str(int y)
+{
+	switch (y) {
+	case STI1_Y_STORM:   return "storm";
+	case STI1_Y_STUCK:   return "line-stuck-low";
+	case STI1_Y_NOIRQ:   return "no-interrupt";
+	case STI1_Y_BUS:     return "register-access-failed";
+	case STI1_Y_REFUSED: return "write-refused";
+	case STI1_Y_RB:      return "readback-mismatch";
+	case STI1_Y_ATTACH:  return "gic-attach";
+	case STI1_Y_ENABLE:  return "gic-enable";
+	case STI1_Y_ISR:     return "isr-error";
+	case STI1_Y_QUIESCE: return "restart";
+	case STI1_Y_PRE:     return "not-armed";
+	default:             return "none";
+	}
+}
+
+/* first reason wins (the ISR and the thread may both set one) */
+static void
+sti1_why(struct sti1 *st, int y)
+{
+	int zero = 0;
+	(void)__atomic_compare_exchange_n(&st->why, &zero, y, 0, __ATOMIC_ACQ_REL, __ATOMIC_ACQUIRE);
+}
+
+/* The allowlist: nothing outside these rows is ever accessed. mask = the bits of the word that belong to pin 0 (the only bits a write may change). */
+struct sti1_row { uint32_t off; uint32_t acc; uint32_t mask; };
+static const struct sti1_row sti1_rows[] = {
+	{ STI1_OFF_CON,     STI1_R | STI1_W, 0xFu },
+	{ STI1_OFF_DAT,     STI1_R,          0u },
+	{ STI1_OFF_ECON,    STI1_R | STI1_W, 0xFu },
+	{ STI1_OFF_EFLTCON, STI1_R,          0u },
+	{ STI1_OFF_EMASK,   STI1_R | STI1_W, 0x1u },
+	{ STI1_OFF_EPEND,   STI1_R | STI1_W, 0x1u },
+};
+
+static const struct sti1_row *
+sti1_row(uint32_t off)
+{
+	for (size_t i = 0; i < sizeof sti1_rows / sizeof sti1_rows[0]; i++) {
+		if (sti1_rows[i].off == off) {
+			return &sti1_rows[i];
+		}
+	}
+	return NULL;
+}
+
+/* The value rules of the write rows (a write that fails here never reaches the bus). oldw = the word as read (unused for EPEND, a plain store), neww = the word to store. */
+static int
+sti1_wr_ok(const struct sti1 *st, uint32_t off, uint32_t oldw, uint32_t neww)
+{
+	const struct sti1_row *r = sti1_row(off);
+	int s = st->state;
+	uint32_t f;
+
+	if (r == NULL || !(r->acc & STI1_W)) {
+		return 0;
+	}
+	if (off == STI1_OFF_EPEND) {
+		return neww == 1u && s != STI1_S_OFF && (s != STI1_S_ARMING || st->econ_set);
+	}
+	if (((oldw ^ neww) & ~r->mask) != 0u) {   /* the other pins' bits are preserved exactly */
+		return 0;
+	}
+	f = neww & r->mask;
+	switch (off) {
+	case STI1_OFF_CON:
+		return (f == STI1_FUNC_EINT && s == STI1_S_ARMING && st->mask_done && !st->con_set && st->con_orig == 0u) ||
+		       (f == st->con_orig && st->con_set && s == STI1_S_DISARMING);
+	case STI1_OFF_ECON:
+		return (f == STI1_ECON_LEVEL_LOW && s == STI1_S_ARMING && st->con_set && !st->econ_set) ||
+		       (f == st->econ_orig && st->econ_set && s == STI1_S_DISARMING);
+	case STI1_OFF_EMASK:
+		if (f == 1u) {
+			return s != STI1_S_OFF || st->unmasked;
+		}
+		return (s == STI1_S_ARMING || s == STI1_S_ARMED) && st->att && st->con_set && st->econ_set && st->pend_done && !st->off_req && !st->quiesce;
+	default:
+		return 0;
+	}
+}
+
+/* read through the allowlist: 0 ok, -1 bus failure, -2 refused. isr = interrupt or reset context: never logs. */
+static int
+sti1_rd(struct sti1 *st, const struct sti1_ops *o, uint32_t off, uint32_t *v, int isr)
+{
+	const struct sti1_row *r = sti1_row(off);
+
+	*v = 0;
+	if (r == NULL || !(r->acc & STI1_R) || (off & 3u) != 0u) {
+		st->refused++;
+		if (!isr) {
+			STI1_LOG("TOUCH GAP: sweettouchirq=1: read of alive offset %#x refused (not on the read allowlist)\n", off);
+		}
+		return -2;
+	}
+	if (o->rd == NULL || o->rd(o->ctx, off, v) != 0) {
+		if (!isr) {
+			STI1_LOG("TOUCH GAP: sweettouchirq=1: read of alive offset %#x failed\n", off);
+		}
+		return -1;
+	}
+	return 0;
+}
+
+/* One write: read-modify-write of pin 0's field (EPEND: the plain store of 1). field = the new value of the pin 0 field, already in bit position 0. verify = read the word back and compare the field.
+ * 0 ok, -1 bus failure, -2 refused by the judge, -3 read-back mismatch. isr = interrupt or reset context: never logs. */
+static int
+sti1_rmw(struct sti1 *st, const struct sti1_ops *o, uint32_t off, uint32_t field, int verify, int isr)
+{
+	const struct sti1_row *r = sti1_row(off);
+	uint32_t oldw = 0, neww, rb;
+
+	if (r == NULL || !(r->acc & STI1_W) || (field & ~r->mask) != 0u) {
+		st->refused++;
+		if (!isr) {
+			STI1_LOG("TOUCH GAP: sweettouchirq=1: write of alive offset %#x value %#x refused (no write row or value outside pin 0's field)\n", off, field);
+		}
+		return -2;
+	}
+	if (off == STI1_OFF_EPEND) {
+		neww = field;
+	} else {
+		int rc = sti1_rd(st, o, off, &oldw, isr);
+		if (rc != 0) {
+			return rc;
+		}
+		neww = (oldw & ~r->mask) | field;
+	}
+	if (!sti1_wr_ok(st, off, oldw, neww)) {
+		st->refused++;
+		if (!isr && !st->quiesce) {   /* during a restart request the refusal is expected: the caller reports the restart */
+			STI1_LOG("TOUCH GAP: sweettouchirq=1: write of alive offset %#x word %#x -> %#x refused by the value rules (state %d)\n", off, oldw, neww, st->state);
+		}
+		return -2;
+	}
+	if (o->wr == NULL || o->wr(o->ctx, off, neww) != 0) {
+		if (!isr) {
+			STI1_LOG("TOUCH GAP: sweettouchirq=1: write of alive offset %#x failed\n", off);
+		}
+		return -1;
+	}
+	if (verify && off != STI1_OFF_EPEND) {
+		int rc = sti1_rd(st, o, off, &rb, isr);
+		if (rc != 0) {
+			return rc;
+		}
+		if (((rb ^ neww) & r->mask) != 0u) {
+			if (!isr) {
+				STI1_LOG("TOUCH GAP: sweettouchirq=1: read-back of alive offset %#x is %#x, wrote %#x\n", off, rb, neww);
+			}
+			return -3;
+		}
+	}
+	return 0;
+}
+
+static int
+sti1_rc_why(const struct sti1 *st, int rc)
+{
+	if (st->quiesce) {
+		return STI1_Y_QUIESCE;   /* a restart request made the judge refuse the step: the reason is the restart, not a bad write */
+	}
+	return rc == -2 ? STI1_Y_REFUSED : rc == -3 ? STI1_Y_RB : STI1_Y_BUS;
+}
+
+/* Teardown, every step tried whatever failed before (idempotent): mask, GIC detach, ECON and CON back to the values read at arm, EPEND clear. Thread context only. */
+static void
+sti1_teardown(struct sti1 *st, const struct sti1_ops *o)
+{
+	int rc;
+
+	st->state = STI1_S_DISARMING;
+	if (st->mask_done) {
+		rc = sti1_rmw(st, o, STI1_OFF_EMASK, 1u, 1, 0);
+		if (rc == 0) {
+			st->unmasked = 0;
+		} else {
+			STI1_LOG("TOUCH GAP: sweettouchirq=1: teardown: EMASK bit 0 := 1 failed (%d), the line may stay unmasked until the reset path masks it\n", rc);
+		}
+	}
+	if (st->att) {
+		rc = o->spi_detach != NULL ? o->spi_detach(o->ctx) : -1;
+		if (rc != 0) {
+			STI1_LOG("TOUCH GAP: sweettouchirq=1: teardown: GIC detach of INTID %u returned %d\n", STI1_INTID, rc);
+		}
+		st->att = 0;
+	}
+	if (st->econ_set) {
+		rc = sti1_rmw(st, o, STI1_OFF_ECON, st->econ_orig, 1, 0);
+		if (rc != 0) {
+			STI1_LOG("TOUCH GAP: sweettouchirq=1: teardown: ECON back to %#x failed (%d)\n", st->econ_orig, rc);
+		}
+		st->econ_set = 0;
+	}
+	if (st->con_set) {
+		rc = sti1_rmw(st, o, STI1_OFF_CON, st->con_orig, 1, 0);
+		if (rc != 0) {
+			STI1_LOG("TOUCH GAP: sweettouchirq=1: teardown: CON back to %#x failed (%d)\n", st->con_orig, rc);
+		}
+		st->con_set = 0;
+	}
+	if (st->pend_done) {
+		rc = sti1_rmw(st, o, STI1_OFF_EPEND, 1u, 0, 0);
+		if (rc != 0) {
+			STI1_LOG("TOUCH GAP: sweettouchirq=1: teardown: EPEND clear failed (%d)\n", rc);
+		}
+		st->pend_done = 0;
+	}
+	st->mask_done = 0;
+	st->state = STI1_S_OFF;
+}
+
+/* Back to polling with a loud line (thread context). reason = the first reason wins for the summary row. A restart (QUIESCE) is a note, not a GAP. */
+static void
+sti1_fail(struct sti1 *st, const struct sti1_ops *o, int y)
+{
+	sti1_why(st, y);
+	if (y == STI1_Y_QUIESCE) {
+		STI1_LOG("SWEET TOUCH IRQ: restart: interrupt mode off before the reset (irqs %u wakes %u tmo_found %u)\n", st->isr_total, st->wakes, st->tmo_found);
+	} else {
+		STI1_LOG("TOUCH GAP: sweettouchirq=1: interrupt mode OFF (%s): irqs %u empty %u wakes %u tmo_drains %u tmo_found %u storm %u: back to polling (1 ms with events, 8 ms idle)\n",
+		    sti1_why_str(st->why), st->isr_total, st->empty, st->wakes, st->tmo_drains, st->tmo_found, st->storm_n);
+	}
+	sti1_teardown(st, o);
+}
+
+/* Arm, once, from the touch thread. Preconditions: the controller-ready event was seen (ready), the AP owns the bus (mux_ok), the irq pad is gpa9[0] (bank_pa, pin).
+ * Order: mask -> CON := 0xF -> ECON := level low -> EPEND clear -> GIC attach (disabled) -> unmask -> GIC enable. 0 = armed. Any failure tears down what was done and logs the GAP. */
+static int
+sti1_arm(struct sti1 *st, const struct sti1_ops *o, int ready, int mux_ok, uint64_t bank_pa, uint32_t pin)
+{
+	uint32_t con, dat, econ, eflt, emask, epend, rb[4] = { 0, 0, 0, 0 }, en = 0;
+	int rc;
+
+	if (st->mode != 1 || st->state != STI1_S_OFF) {
+		return -1;
+	}
+	if (st->quiesce) {
+		sti1_why(st, STI1_Y_QUIESCE);
+		STI1_LOG("SWEET TOUCH IRQ: restart already requested, not armed\n");
+		return -1;
+	}
+	if (!ready || !mux_ok || bank_pa != STI1_PAD_PA || pin != 0u) {
+		sti1_why(st, STI1_Y_PRE);
+		STI1_LOG("TOUCH GAP: sweettouchirq=1: not armed, polling: controller-ready %s, AP owns the bus %s, irq pad bank %#llx pin %u (need gpa9[0] = %#llx pin 0)\n", ready ? "seen" : "NOT seen",
+		    mux_ok ? "yes" : "NO", (unsigned long long)bank_pa, pin, (unsigned long long)STI1_PAD_PA);
+		return -1;
+	}
+	if (sti1_rd(st, o, STI1_OFF_CON, &con, 0) || sti1_rd(st, o, STI1_OFF_DAT, &dat, 0) || sti1_rd(st, o, STI1_OFF_ECON, &econ, 0) ||
+	    sti1_rd(st, o, STI1_OFF_EFLTCON, &eflt, 0) || sti1_rd(st, o, STI1_OFF_EMASK, &emask, 0) || sti1_rd(st, o, STI1_OFF_EPEND, &epend, 0)) {
+		sti1_why(st, STI1_Y_BUS);
+		STI1_LOG("TOUCH GAP: sweettouchirq=1: not armed, polling: an initial read failed (nothing was written)\n");
+		return -1;
+	}
+	if (econ == 0xFFFFFFFFu && eflt == 0xFFFFFFFFu && emask == 0xFFFFFFFFu && epend == 0xFFFFFFFFu) {
+		sti1_why(st, STI1_Y_BUS);
+		STI1_LOG("TOUCH GAP: sweettouchirq=1: not armed, polling: all four EINT words read 0xffffffff (window not answering, nothing was written)\n");
+		return -1;
+	}
+	if ((con & 0xFu) != 0u) {
+		sti1_why(st, STI1_Y_PRE);
+		STI1_LOG("TOUCH GAP: sweettouchirq=1: not armed, polling: pad CON func is %#x, not 0 (input); the restore value is only ever 0 (nothing was written)\n", con & 0xFu);
+		return -1;
+	}
+	st->con_orig = con & 0xFu;
+	st->econ_orig = econ & 0xFu;
+	STI1_LOG("SWEET TOUCH IRQ: arming: econ %#x [pin0 %u] efltcon %#x emask %#x [bit0 %u] epend %#x [bit0 %u] con %#x [func %#x] dat %u\n", econ, econ & 0xFu, eflt, emask, emask & 1u, epend, epend & 1u, con, con & 0xFu, dat & 1u);
+	st->state = STI1_S_ARMING;
+	/* a. mask */
+	rc = sti1_rmw(st, o, STI1_OFF_EMASK, 1u, 1, 0);
+	if (rc) {
+		sti1_fail(st, o, sti1_rc_why(st, rc));
+		return -1;
+	}
+	st->mask_done = 1;
+	/* b. pad function EINT */
+	rc = sti1_rmw(st, o, STI1_OFF_CON, STI1_FUNC_EINT, 1, 0);
+	if (rc) {
+		sti1_fail(st, o, sti1_rc_why(st, rc));
+		return -1;
+	}
+	st->con_set = 1;
+	/* c. trigger level low */
+	rc = sti1_rmw(st, o, STI1_OFF_ECON, STI1_ECON_LEVEL_LOW, 1, 0);
+	if (rc) {
+		sti1_fail(st, o, sti1_rc_why(st, rc));
+		return -1;
+	}
+	st->econ_set = 1;
+	/* d. clear a stale pending bit */
+	rc = sti1_rmw(st, o, STI1_OFF_EPEND, 1u, 0, 0);
+	if (rc) {
+		sti1_fail(st, o, sti1_rc_why(st, rc));
+		return -1;
+	}
+	st->pend_done = 1;
+	if (sti1_rd(st, o, STI1_OFF_DAT, &dat, 0) == 0) {
+		STI1_LOG("SWEET TOUCH IRQ: after CON := 0xF, ECON := level low, EPEND clear: dat %u (research 155 U6: DAT must still show the pad)\n", dat & 1u);
+	}
+	/* e. GIC attach, the SPI stays disabled */
+	rc = o->spi_attach_off != NULL ? o->spi_attach_off(o->ctx, rb) : -1;
+	STI1_LOG("SWEET TOUCH IRQ: attach INTID %u rc %d igroupr %#x isenabler %#x icfgr %#x irouter %#x\n", STI1_INTID, rc, rb[0], rb[1], rb[2], rb[3]);
+	if (rc != 0) {
+		sti1_fail(st, o, STI1_Y_ATTACH);
+		return -1;
+	}
+	st->att = 1;
+	/* f. unmask (EPEND was cleared in d; the GIC is still disabled, nothing can fire yet) */
+	st->unmasked = 1;
+	rc = sti1_rmw(st, o, STI1_OFF_EMASK, 0u, 1, 0);
+	if (rc) {
+		sti1_fail(st, o, sti1_rc_why(st, rc));
+		return -1;
+	}
+	/* g. enable the SPI: the first interrupt can come from here on, so the state is ARMED before it */
+	st->last_seq = __atomic_load_n(&st->isr_seq, __ATOMIC_ACQUIRE);
+	st->unm_seq = st->last_seq;
+	st->settle = 1;
+	st->state = STI1_S_ARMED;
+	rc = o->spi_enable != NULL ? o->spi_enable(o->ctx, &en) : -1;
+	if (rc != 0 || en != 1u) {
+		STI1_LOG("TOUCH GAP: sweettouchirq=1: GIC enable of INTID %u: rc %d, enable bit read back %u\n", STI1_INTID, rc, en);
+		sti1_fail(st, o, STI1_Y_ENABLE);
+		return -1;
+	}
+	STI1_LOG("SWEET TOUCH IRQ: ARMED INTID %u level-low gpa9[0]: safety wait %u ms, thread drains, ISR masks and clears EPEND only\n", STI1_INTID, STI1_SAFETY_MS);
+	return 0;
+}
+
+/* The interrupt handler (interrupt context): no lock, no log, no SPI, no GIC call. Linux order for a level oneshot interrupt: mask, ack (EPEND W1C), wake the thread. The sequence number is published
+ * AFTER both stores so the thread never sees it before the line is masked. Returns 0 = handled (the source is gone), 1 = error, storm or a late entry outside ARMED (the dispatcher masks the INTID; the thread disarms). */
+static int
+sti1_isr(struct sti1 *st, const struct sti1_ops *o)
+{
+	uint64_t now;
+
+	__atomic_fetch_add(&st->isr_total, 1u, __ATOMIC_RELAXED);
+	if (st->state != STI1_S_ARMED) {
+		/* a late entry (the line went low before the teardown's mask store, review 0356 F1): remove the source here, with the same allowlisted store as below, and return 1 so the dispatcher
+		 * masks INTID 67 at the distributor too; returning 0 with the level still asserted would re-enter forever */
+		(void)sti1_rmw(st, o, STI1_OFF_EMASK, 1u, 0, 1);
+		return 1;
+	}
+	if (sti1_rmw(st, o, STI1_OFF_EMASK, 1u, 0, 1) != 0 || sti1_rmw(st, o, STI1_OFF_EPEND, 1u, 0, 1) != 0) {
+		st->isr_err++;
+		sti1_why(st, STI1_Y_ISR);
+		st->off_req = 1;
+		__atomic_fetch_add(&st->isr_seq, 1u, __ATOMIC_RELEASE);
+		o->wake(o->ctx);
+		return 1;
+	}
+	now = o->now(o->ctx);
+	if (now - st->win_start >= STI1_WIN_NS) {
+		st->win_start = now;
+		st->win_n = 0;
+	}
+	if (++st->win_n > STI1_ISR_STORM) {
+		st->storm_n++;
+		sti1_why(st, STI1_Y_STORM);
+		st->off_req = 1;
+		__atomic_fetch_add(&st->isr_seq, 1u, __ATOMIC_RELEASE);
+		o->wake(o->ctx);
+		return 1;
+	}
+	__atomic_fetch_add(&st->isr_seq, 1u, __ATOMIC_RELEASE);
+	o->wake(o->ctx);
+	return 0;
+}
+
+static int
+sti1_armed(const struct sti1 *st)
+{
+	return st->mode == 1 && st->state == STI1_S_ARMED;
+}
+
+/* the thread's wait: while armed the safety timeout, else today's 1 ms with events / 8 ms idle */
+static unsigned
+sti1_wait_ms(const struct sti1 *st, int n)
+{
+	if (sti1_armed(st)) {
+		return STI1_SAFETY_MS;
+	}
+	return n > 0 ? 1u : 8u;
+}
+
+/* called by the thread between assert_wait and thread_block: an interrupt that ran since the last accounted pass must not be slept through (no lost wakeup) */
+static int
+sti1_wake_pending(const struct sti1 *st)
+{
+	return sti1_armed(st) && (__atomic_load_n(&st->isr_seq, __ATOMIC_ACQUIRE) != st->last_seq || st->off_req || st->quiesce || st->redo);
+}
+
+/* thread, top of a pass: a shutdown request (ISR error/storm, clean stop) is carried out here, by the one thread that owns the state */
+static void
+sti1_pass_begin(struct sti1 *st, const struct sti1_ops *o)
+{
+	if (st->mode != 1) {
+		return;
+	}
+	if (st->state == STI1_S_ARMED && (st->off_req || st->quiesce)) {
+		sti1_fail(st, o, st->off_req ? STI1_Y_ISR : STI1_Y_QUIESCE);
+	}
+}
+
+static void
+sti1_summary(struct sti1 *st)
+{
+	if (st->state == STI1_S_ARMED) {
+		STI1_LOG("SWEET TOUCH IRQ: irqs %u empty %u wakes %u tmo_drains %u tmo_found %u storm %u mode irq\n", st->isr_total, st->empty, st->wakes, st->tmo_drains, st->tmo_found, st->storm_n);
+	} else {
+		STI1_LOG("SWEET TOUCH IRQ: irqs %u empty %u wakes %u tmo_drains %u tmo_found %u storm %u mode off:%s\n", st->isr_total, st->empty, st->wakes, st->tmo_drains, st->tmo_found, st->storm_n, sti1_why_str(st->why));
+	}
+}
+
+/* thread, after the drain of a pass: n = events handled (0 = empty, < 0 = bus error of the drain); now_ns = the clock. Classifies the pass, applies the auto-off rules, then (still armed) acknowledges and unmasks. */
+static void
+sti1_pass_end(struct sti1 *st, const struct sti1_ops *o, int n, uint64_t now_ns)
+{
+	if (st->mode != 1) {
+		return;
+	}
+	if (st->state == STI1_S_ARMED) {
+		uint32_t cur = __atomic_load_n(&st->isr_seq, __ATOMIC_ACQUIRE);   /* ONE load for the classification and the unmask below; an ISR after it is seen by sti1_wake_pending */
+		int irq = cur != st->last_seq;    /* an interrupt ran since the last accounted pass (also one that ran DURING this drain: it is not a missed edge) */
+		int first = st->settle;
+
+		st->settle = 0;
+		st->redo = 0;
+		st->last_seq = cur;
+		if (n < 0) {
+			if (++st->err_run >= STI1_ERR_N) {                  /* review 0356 F2: a failing drain is never followed by an unmask; 10 in a row = back to polling */
+				sti1_fail(st, o, STI1_Y_BUS);
+			}
+		} else {
+			st->err_run = 0;
+		}
+		if (n >= 0) {
+			if (irq) {
+				st->wakes++;
+				if (n == 0) {
+					st->empty++;
+					if (now_ns - st->twin_start >= STI1_WIN_NS) {
+						st->twin_start = now_ns;
+						st->twin_n = 0;
+					}
+					if (++st->twin_n > STI1_STORM_EMPTY) {
+						st->storm_n++;
+						sti1_fail(st, o, STI1_Y_STORM);
+					}
+				}
+			} else if (!first) {
+				st->tmo_drains++;
+				if (n > 0) {
+					st->tmo_found++;
+					if (st->tmo_found <= STI1_TMO_LOG) {
+						STI1_LOG("TOUCH GAP: sweettouchirq=1: safety-timeout drain found %d event(s) with no interrupt (missed edge %u of %u allowed)\n", n, st->tmo_found, STI1_NOIRQ_N);
+					}
+					if (now_ns - st->tmo_win_start >= STI1_TMO_WIN_NS) {
+						st->tmo_win_start = now_ns;
+						st->tmo_win_n = 0;
+					}
+					if (++st->tmo_win_n >= STI1_NOIRQ_N) {
+						sti1_fail(st, o, STI1_Y_NOIRQ);
+					}
+				}
+			}
+		}
+		if (st->state == STI1_S_ARMED && n == 0) {      /* the FIFO is empty: the line must be high; low K passes in a row = stuck or inverted */
+			uint32_t d;
+			int rc = sti1_rd(st, o, STI1_OFF_DAT, &d, 0);
+			if (rc) {
+				sti1_fail(st, o, sti1_rc_why(st, rc));
+			} else if ((d & 1u) == 0u) {
+				if (++st->low_run >= STI1_STUCK_K) {
+					sti1_fail(st, o, STI1_Y_STUCK);
+				}
+			} else {
+				st->low_run = 0;
+			}
+		} else if (n > 0) {
+			st->low_run = 0;
+		}
+		if (st->state == STI1_S_ARMED && n >= 0 && !st->off_req && !st->quiesce) {
+			if (cur != st->unm_seq) {                   /* the ISR ran since the last unmask: the line is masked. Linux order: EPEND W1C, then unmask */
+				int rc = sti1_rmw(st, o, STI1_OFF_EPEND, 1u, 0, 0);
+				if (rc == 0) {
+					rc = sti1_rmw(st, o, STI1_OFF_EMASK, 0u, 0, 0);   /* no read-back: the line may fire (and the ISR set the bit again) the moment it is unmasked */
+				}
+				if (rc) {
+					sti1_fail(st, o, sti1_rc_why(st, rc));
+				} else {
+					uint32_t d;
+
+					st->unm_seq = cur;
+					/* research 155 s.6 step 3 / review F3: one DAT read after the unmask. Low with no interrupt entered since the unmask = the line did not fire (U4): count it and drain once more at once */
+					rc = sti1_rd(st, o, STI1_OFF_DAT, &d, 0);
+					if (rc) {
+						sti1_fail(st, o, sti1_rc_why(st, rc));
+					} else if ((d & 1u) == 0u && __atomic_load_n(&st->isr_seq, __ATOMIC_ACQUIRE) == cur) {
+						st->rechk_low++;
+						st->redo = 1;
+					}
+				}
+			}
+		}
+	}
+	if (!st->sum_init) {
+		st->sum_init = 1;
+		st->sum_ns = now_ns;
+	} else if (now_ns - st->sum_ns >= STI1_SUMMARY_NS) {
+		st->sum_ns = now_ns;
+		sti1_summary(st);
+	}
+}
+
+/* clean stop (thread context of the stopper): no more arming, the touch thread disarms at its next pass. 1 = the caller should wait for sti1_off(). */
+static int
+sti1_quiesce_begin(struct sti1 *st)
+{
+	if (st->mode != 1) {
+		return 0;
+	}
+	st->quiesce = 1;
+	return st->state != STI1_S_OFF;
+}
+
+static int
+sti1_off(const struct sti1 *st)
+{
+	return st->state == STI1_S_OFF;
+}
+
+/* EVERY other software reset (reboot(2), panic, sweetrestart, watchdog handler): lock-free, no log, no GIC call; the one write that makes the reset start with the line masked: EMASK bit 0 := 1,
+ * only if this feature ever unmasked it. Through the same judge row as the teardown. */
+static void
+sti1_reset_mask(struct sti1 *st, const struct sti1_ops *o)
+{
+	if (st->mode != 1 || !st->unmasked) {
+		return;
+	}
+	(void)sti1_rmw(st, o, STI1_OFF_EMASK, 1u, 0, 1);
+}
+/* STI1_CORE_END */
+#endif /* SWEET_TOUCH_IRQ1_H */
