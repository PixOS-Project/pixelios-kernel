+		return;
+	}
+	thread_block(THREAD_CONTINUE_NULL);
+}
+
+/* sweet_clean_stop (sweet_restart.c): no arming from now on, the touch thread disarms at its next pass (it is woken); waits up to 500 ms. A no-op unless sweettouchirq=1 armed it. */
