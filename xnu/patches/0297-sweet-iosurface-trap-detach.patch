+/* Lock held. Patch 0297: a ref waiting for trap 5 (detached > 0), oldest first. */
+SweetSurfaceRef *
+IOSurfaceRootUserClient::findDetached(uint32_t id, unsigned int *index)
+{
+	for (unsigned int i = 0; i < fRefs->getCount(); i++) {
+		SweetSurfaceRef *ref = (SweetSurfaceRef *)fRefs->getObject(i);
+		if (ref->surface->id == id && ref->detached > 0) {
+			if (index != NULL) {
+				*index = i;
+			}
+			return ref;
+		}
+	}
+	return NULL;
+}
+
+/* Lock held. One create/lookup of ref is undone; the last one unmaps it and drops its user count (patch 0297: by pointer). */
+void
+IOSurfaceRootUserClient::dropRefLocked(SweetSurfaceRef *ref)
+{
+	unsigned int index = fRefs->getNextIndexOfObject(ref, 0);
+	if (index == (unsigned int)-1) {
+		sweet_note_ignored("surface ref drop", "ref not in the client table", 0);
+		return;
+	}
+	if (ref->detached > ref->count - 1) {
+		ref->detached = ref->count - 1;
+	}
+	if (--ref->count == 0) {
+		fRefs->removeObject(index);     /* unmaps and drops the user count */
+	}
+}
+
+/*
+ * Patch 0297. IOSurface.framework's _IOSurfaceClientRelease (iOS 16.7, research 136) sends, once per IOSurfaceClient whose local
+ * count reached 0 and after taking it out of its own id table: trap 4 (id), unmaps its view, then trap 5 (id). Trap 5 alone undoes a
+ * create/lookup whose client could not be built (Lookup, LookupFromMachPort, CreateChild, WrapClientImage/Memory). Before 0297 both
+ * traps ran trapRelease: one release dropped the ref at trap 4, and a lookup of the same id between trap 4 and trap 5 (another thread)
+ * got a fresh ref that trap 5 then destroyed under the new client (unmapped view, user count gone, the id could leave the surface
+ * table: SweetMali import NotFound). Now trap 4 only marks one client of the ref detached; trap 5 releases a detached client first.
+ */
+IOReturn
+IOSurfaceRootUserClient::trapDetach(void *id, void *, void *, void *, void *, void *)
+{
+	SweetSurfCpuScope cpuScope(1, 4);   /* patch 0194: traps 4 and 5 */
+	IOLockLock(fLock);
+	SweetSurfaceRef *ref = findRef((uint32_t)(uintptr_t)id, NULL);
+	if (ref != NULL) {
+		ref->detached++;
+	}
+	IOLockUnlock(fLock);
+	if (ref == NULL) {
+		sweet_note_ignored("surface trap 4 (detach)", "no live ref for the id", (uint32_t)(uintptr_t)id);
+		return kIOReturnNotFound;
+	}
+	return kIOReturnSuccess;
+}
