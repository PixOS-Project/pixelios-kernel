+/* patch 0306: xorshift32 draw in [lo, hi] and a symmetric jitter in [-r, r] (stress nav; the calm table keeps its own LCG fNavRng) */
+static UInt32
+sweetNavSR(UInt32 *st, UInt32 lo, UInt32 hi)
+{
+	UInt32 x = *st ? *st : 0x9e3779b9u;
+	x ^= x << 13;
+	x ^= x >> 17;
+	x ^= x << 5;
+	*st = x;
+	return hi > lo ? lo + x % (hi - lo + 1) : lo;
+}
+static SInt32
+sweetNavSJ(UInt32 *st, SInt32 r)
+{
+	return (SInt32)sweetNavSR(st, 0, (UInt32)(2 * r)) - r;
+}
+static short
+sweetNavClamp(int v, int lo, int hi)
+{
+	return (short)(v < lo ? lo : v > hi ? hi : v);
+}
