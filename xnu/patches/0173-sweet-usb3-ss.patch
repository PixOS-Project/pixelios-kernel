+/* Read-only report of the controller state (SuperSpeed mode only, the default; not with sweetusb3=0): what = "handover" (ABL's state, before the soft reset) or "after reset". */
+static void
+ud_ss_report(const char *what)
+{
+	uint32_t hw0 = dwc_rd(GHWPARAMS0), hw7 = dwc_rd(GHWPARAMS7), dcfg = dwc_rd(DCFG), dsts = dwc_rd(DSTS);
+	uint32_t mdwidth = (hw0 >> 8) & 0xff;           /* bits; DWC_usb31: no GHWPARAMS6 part (core.h:1591-1599) */
+	uint32_t ram2 = (hw7 >> 16) & 0xffff;
+	int64_t nump = ((int64_t)ram2 * mdwidth / 8 - 24 - 16) / 1024;       /* gadget.c:2815-2826 */
+	uint32_t txf = dwc_rd(GTXFIFOSIZ(1)) & 0xffff;  /* FIFO 1 = EP_TX (DEPCFG FIFO_NUMBER, gadget.c:628) */
+	uint32_t txmin = mdwidth >= 8 ? (UD_SS_BULK_MPS + mdwidth / 8) / (mdwidth / 8) + 1 : 0; /* gadget.c:672-687 */
+
+	printf("SWEET USB3: %s GUSB2PHYCFG 0x%08x GUSB3PIPECTL 0x%08x DCFG 0x%08x (DEVSPD %u NUMP %u) DSTS 0x%08x (speed %u link state %u)\n",
+	    what, dwc_rd(GUSB2PHYCFG0), dwc_rd(GUSB3PIPECTL0), dcfg, dcfg & DCFG_SPEED_MASK, DCFG_NUMP(dcfg),
+	    dsts, dsts & 7, DSTS_USBLNKST(dsts));
+	printf("SWEET USB3: GHWPARAMS0 0x%08x GHWPARAMS7 0x%08x: MDWIDTH %u RAM2 depth %u -> Linux NUMP %lld (cap 16); GTXFIFOSIZ(1) depth %u (Linux minimum for 1024 B: %u)\n",
+	    hw0, hw7, mdwidth, ram2, nump < 0 ? 0 : (nump > 16 ? 16 : nump), txf, txmin);
+	if (txmin == 0 || txf < txmin) {
+		printf("USB3 GAP: TX FIFO 1 depth %u below the Linux minimum %u for one 1024-byte packet (MDWIDTH %u); bulk IN may fail at SuperSpeed\n",
+		    txf, txmin, mdwidth);
+	}
+}
