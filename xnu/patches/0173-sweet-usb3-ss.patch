+/* RUN_STOP and wait for the controller to leave the halted state. */
+static void
+ud_run(void)
+{
+	int i;
+	uint32_t dctl = dwc_rd(DCTL);
+	if (ud.gs101) {
+		dctl &= ~DCTL_ULSTCHNGREQ;      /* shim/usbgadget.c: never write back a link state change request */
+	}
+	dwc_wr(DCTL, dctl | DCTL_RUN_STOP);
+	for (i = 0; i < 500 && (dwc_rd(DSTS) & DSTS_DEVCTRLHLT); i++) {
+		delay(1000);
+	}
+	printf("SWEET USB: running (DSTS 0x%08x after %d ms), DMA at 0x%llx\n", dwc_rd(DSTS), i, ud.dma_pa);
+	if (ud.ss_mode && !ud.ss_fell_back) {
+		clock_interval_to_deadline(UD_SS_WAIT_MS, NSEC_PER_MSEC, &ud.ss_deadline);
+		printf("SWEET USB3: running with DEVSPD SuperSpeed; high-speed restart if not configured in %u ms\n",
+		    UD_SS_WAIT_MS);
+	}
+}
