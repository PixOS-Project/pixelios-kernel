+/*
+ * Stop (DCTL.RUN_STOP = 0, wait for DSTS.DEVCTRLHLT up to 1000 ms, the sequence of ABL's stop at
+ * abl_code.bin 0x24124-0x2414c and Linux dwc3_gadget_run_stop), then the same soft reset + start the
+ * HS-only gadget does, with DCFG.DEVSPD = devspd. Clears the per-session state. Only these writes, all
+ * through ud_hw_init / ud_run / the DCTL allowlist. Returns false (loudly) if the gadget could not be restarted.
+ */
+static bool
+ud_restart(uint32_t devspd)
+{
+	int i;
+	uint32_t dropped = 0;
+
+	if (ud_rx_hurry) {
+		printf("USB3 GAP: restart while a usbroot request is waiting (it times out and retries)\n");
+	}
+	/* review usb3-ss-r2 F1: stop every TX kick (ud_if_output, sweet_usb_raw_tx, ud_log_thread) before the stop */
+	lck_mtx_lock(ud.lock);
+	ud.configured = false;
+	ud.data_alt = 0;
+	if (ud.tx_busy) {
+		printf("USB3 GAP: restart drops the TX transfer in flight\n");
+	}
+	ud.tx_busy = false;             /* the in-flight IN TRB dies with the soft reset: no XferComplete will clear it */
+	lck_mtx_unlock(ud.lock);
+	ud_link_event(false);
+	/* r2 F2b: no EndTransfer for the armed RX/TX TRBs (Linux dwc3_stop_active_transfer does one); not added (new command) */
+	printf("USB3 GAP: no EndTransfer before RUN_STOP=0 (armed transfers are dropped by the soft reset)\n");
+	if (!ud_ss_wr(DCTL, dwc_rd(DCTL) & ~(DCTL_RUN_STOP | DCTL_ULSTCHNGREQ))) {
+		return false;
+	}
+	for (i = 0; i < 1000 && !(dwc_rd(DSTS) & DSTS_DEVCTRLHLT); i++) {
+		/* r2 F2a: events pending in GEVNTCOUNT keep the core from halting (linux gadget.c:2686-2691): ack, not dispatched */
+		uint32_t c = dwc_rd(GEVNTCOUNT) & 0xffff;
+		if (c) {
+			dwc_wr(GEVNTCOUNT, c);
+			ud.evt_pos = (ud.evt_pos + c) % UD_EVT_SIZE;
+			dropped += c / 4;
+		}
+		delay(1000);
+	}
+	if (dropped) {
+		printf("USB3 GAP: %u events dropped while stopping\n", dropped);
+	}
+	if (!(dwc_rd(DSTS) & DSTS_DEVCTRLHLT)) {
+		printf("USB3 GAP: controller not halted 1000 ms after RUN_STOP = 0 (DSTS 0x%08x); soft reset anyway\n",
+		    dwc_rd(DSTS));
+	}
+	ud.speed = 0;
+	if (!ud_hw_init(devspd)) {
+		printf("USB3 GAP: high-speed restart failed: USB gadget stopped (no USB log)\n");
+		return false;
+	}
+	ud_run();
+	return true;
+}
+
+/*
+ * Not configured within UD_SS_WAIT_MS of RUN at SuperSpeed (no ConnectDone, or a SuperSpeed ConnectDone
+ * and a failed enumeration): restart at high speed, once (ud.ss_fell_back), from ud_thread.
+ */
+static void
+ud_ss_fallback(void)
+{
+	uint32_t dsts = dwc_rd(DSTS);
+
+	ud.ss_fell_back = true;
+	printf("USB3 GAP: not configured %u ms after RUN at SuperSpeed (ConnectDone %s, speed %u, ep0 max packet %u, DSTS 0x%08x link state %u): restarting at high speed\n",
+	    UD_SS_WAIT_MS, ud.ep0_mps ? "seen" : "not seen", ud.speed, ud.ep0_mps, dsts, DSTS_USBLNKST(dsts));
+	ud_restart(DCFG_SPEED_HS);
+}
