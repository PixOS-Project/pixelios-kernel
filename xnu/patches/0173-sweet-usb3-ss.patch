+/*
+ * USB 3 (patch 0173): the SuperSpeed path writes new values to DCFG.DEVSPD, DCTL.RUN_STOP (fallback) and the
+ * max-packet fields of DEPCMDPAR0 for ep0/bulk (via ud_epcmd, same registers as the HS-only gadget). The first
+ * two go through this independent allowlist: anything else is refused loudly.
+ */
+static const uint32_t ud_ss_wr_allow[] = { DCFG, DCTL };
+
+static bool
+ud_ss_wr(uint32_t off, uint32_t v)
+{
+	for (unsigned k = 0; k < sizeof(ud_ss_wr_allow) / sizeof(ud_ss_wr_allow[0]); k++) {
+		if (ud_ss_wr_allow[k] == off) {
+			dwc_wr(off, v);
+			return true;
+		}
+	}
+	printf("USB3 GAP: refused write 0x%08x to DWC3 +0x%x (not in the USB 3 allowlist)\n", v, off);
+	return false;
+}
