+/*
+ * patch 0218 (T-86c9, W-BTUP), boot-arg sweetbtpatchram=1 (default off): download the stock BCM4389 firmware patch (BCM.hcd, the file the Android HAL sends on every Bluetooth
+ * start) into the controller RAM before bluetoothd starts, in the HAL's own order, then read the version back. docs/research/BT-rom-vs-patched.md s.6-7: the 3039 records are
+ * byte-identical to the golden vendor snoop (3038 x 0xfc4c Write RAM, no Command Complete, then 0xfc4e Launch RAM `ff ff ff ff` with one). The image is NOT in git: it is
+ * built into sweet_bt_hcd.c from a gitignored file by tools/bcm-hcd-stack (empty = this knob refuses, rule 8). Controller writes: 0xfc4c/0xfc4e only (the scan below refuses
+ * every other opcode), 0xfc18 baud (sub-knob sweetbtpatchrambaud=1 only), 0xfc2e download mode, 0xfc01 Write BD_ADDR (synthetic D-3 address); all volatile controller RAM
+ * state that REG_ON low clears [guess: no BCM4389 source says the patch does not persist; every stock enable relies on it]. No 0xfc27 (LPM): the host-wake irq is not wired.
+ */
+extern const uint8_t sweet_bt_hcd_data[];
+extern const size_t sweet_bt_hcd_len;
+extern const char sweet_bt_hcd_sha256[];
+
+#define SBU_HCD_OP_WRITE        0xfc4c
+#define SBU_HCD_OP_LAUNCH       0xfc4e
+#define SBU_PR_REFUSED          (-1)    /* nothing was sent to the controller */
+#define SBU_HCD_STOCK_BUILD     203u    /* the stock BP31 BCM.hcd [obs golden vendor snoop: 0xfc79 build 203, 0x1001 rev word 0x20cb] */
+#define SBU_HCD_STOCK_REV       0x20cbu
+#define SBU_HCD_STOCK_SHA256    "450f8c66f76b96da65c83f5d380922f55e1e4a4e661cd61b0109c53249e0d8d1"
+
+/* The record stream is [op lo, op hi, plen, plen bytes]*: only 0xfc4c writes, one 0xfc4e launch (4 bytes) as the last record, and the lengths add up to the file size. */
+static int
+sbu_hcd_scan(unsigned *nwrite, unsigned *nlaunch, size_t *wbytes)
+{
+	size_t off = 0;
+
+	*nwrite = *nlaunch = 0;
+	*wbytes = 0;
+	while (off < sweet_bt_hcd_len) {
+		uint16_t op;
+		size_t pl;
+
+		if (sweet_bt_hcd_len - off < 3) {
+			SBU_GAP(SG_OTHER, "patchram image malformed: %zu trailing bytes at offset %zu are not a record header", sweet_bt_hcd_len - off, off);
+			return EINVAL;
+		}
+		op = (uint16_t)(sweet_bt_hcd_data[off] | (sweet_bt_hcd_data[off + 1] << 8));
+		pl = sweet_bt_hcd_data[off + 2];
+		if (sweet_bt_hcd_len - off < 3 + pl) {
+			SBU_GAP(SG_OTHER, "patchram image malformed: record at offset %zu claims %zu payload bytes, %zu left", off, pl, sweet_bt_hcd_len - off - 3);
+			return EINVAL;
+		}
+		if (op == SBU_HCD_OP_WRITE && *nlaunch == 0) {
+			(*nwrite)++;
+			*wbytes += pl;
+		} else if (op == SBU_HCD_OP_LAUNCH && *nlaunch == 0 && pl == 4 && off + 3 + pl == sweet_bt_hcd_len) {
+			(*nlaunch)++;
+		} else {
+			SBU_GAP(SG_OTHER, "patchram image refused: record at offset %zu has opcode 0x%04x plen %zu (only 0xfc4c writes and one final 0xfc4e launch of 4 bytes are allowed)", off, op, pl);
+			return EINVAL;
+		}
+		off += 3 + pl;
+	}
+	if (*nwrite == 0 || *nlaunch != 1) {
+		SBU_GAP(SG_OTHER, "patchram image refused: %u write records and %u launch records (need >= 1 and exactly 1)", *nwrite, *nlaunch);
+		return EINVAL;
+	}
+	return 0;
+}
+
+/* one command of the sequence: a missing Command Complete or a status != 0 is a BT GAP and stops the sequence (rule 8) */
+static int
+sbu_pr_cmd(const char *step, uint16_t op, const uint8_t *par, uint8_t plen, uint8_t *rp, size_t rpmax, size_t *rpn)
+{
+	static const uint8_t none[1] = { 0 };
+	uint8_t st = 0xff;
+	int e = sbu_cmd(op, par != NULL ? par : none, plen, &st, rp, rpmax, rpn);
+
+	if (e != 0) {
+		SBU_GAP(SG_OTHER, "patchram step %s op=0x%04x: no Command Complete (error %d); sequence stopped", step, op, e);
+		return e;
+	}
+	if (st != 0) {
+		SBU_GAP(SG_OTHER, "patchram step %s op=0x%04x: status %#04x (%s); sequence stopped", step, op, st, sbu_pstatus(st));
+		return EIO;
+	}
+	printf("BT PROBE: patchram step %s op=0x%04x status=0x00 ok\n", step, op);
+	return 0;
+}
+
+/* steps 1-4 of docs/research/BT-rom-vs-patched.md s.7: Reset, chip id + build (expect 0xaa and build 0), [4 Mbaud], download mode. fast = 0xfc18 4 000 000 first, the host follows. */
+static int
+sbu_pr_prepare(bool fast)
+{
+	static const uint8_t par_baud[6] = { 0x00, 0x00, 0x00, 0x09, 0x3d, 0x00 };     /* 0xfc18 as the HAL sends it (golden vnd rec 4): 4 000 000 baud = 0x003d0900 */
+	uint8_t rp[SBU_PM_SUPP];
+	size_t rpn;
+	int e;
+
+	if ((e = sbu_pr_cmd("reset-1", 0x0c03, NULL, 0, rp, sizeof(rp), &rpn)) != 0 || (e = sbu_pr_cmd("read-chip-id", 0xfc79, NULL, 0, rp, sizeof(rp), &rpn)) != 0) {
+		return e;
+	}
+	if (rpn < 6) {
+		SBU_GAP(SG_OTHER, "patchram: 0xfc79 reply has %zu return bytes (need 6); sequence stopped", rpn);
+		return EPROTO;
+	}
+	printf("BT PROBE: patchram before: chip id=0x%02x build=%u (rev word %02x %02x)\n", rp[0], rp[4] | (rp[5] << 8), rp[4], rp[5]);
+	if (rp[0] != 0xaa) {
+		SBU_GAP(SG_OTHER, "patchram: chip id 0x%02x is not 0xaa, BCM.hcd is selected for 0xaa only; refused, nothing downloaded", rp[0]);
+		return EINVAL;
+	}
+	if ((rp[4] | (rp[5] << 8)) != 0) {
+		SBU_GAP(SG_OTHER, "patchram: the controller reports build %u before the download (expected 0 on a power-cycled ROM); continuing", rp[4] | (rp[5] << 8));
+	}
+	if (fast) {
+		if ((e = sbu_pr_cmd("baud-4M", 0xfc18, par_baud, sizeof(par_baud), rp, sizeof(rp), &rpn)) != 0 || (e = sbu_set_baud(4000000)) != 0) {
+			return e;
+		}
+	}
+	if ((e = sbu_pr_cmd("download-mode", 0xfc2e, NULL, 0, rp, sizeof(rp), &rpn)) != 0) {      /* at 4 M this is also the proof that the baud change worked */
+		return e;
+	}
+	sbu.hw.msleep(50);      /* the HAL's first 0xfc4c follows 53 ms after the Command Complete (golden vnd rec 7-8); btbcm.c:173-184 waits 50 ms too */
+	return 0;
+}
+
+/* the 3038 Write RAM records, no Command Complete waited (chip 0xaa fast download, golden vnd rec 8-3045), RTS/CTS paced; the chip sends nothing, so any rx byte is reported */
+static int
+sbu_pr_stream(unsigned nwrite)
+{
+	uint8_t pkt[1 + 3 + 255];
+	size_t off = 0, sent = 0;
+	unsigned n = 0, unexpected = 0, rxerrs = 0;
+	int e;
+
+	while (n < nwrite) {
+		size_t pl = sweet_bt_hcd_data[off + 2];
+		uint32_t err = sbu_rd(SBU_UART + U_UERSTAT);
+		uint8_t first[4];
+		unsigned got = 0;
+
+		pkt[0] = 0x01;
+		memcpy(pkt + 1, sweet_bt_hcd_data + off, 3 + pl);
+		if (n == 0 || n + 1 == nwrite) {      /* header only, never the payload: the log goes into proofs and the firmware must not (rule 4, review T-60ed F4); the trace cap stays for bluetoothd */
+			printf("BT HCI: tx %zu bytes: patchram record %u/%u op=0x%04x plen=%zu (payload not logged)\n", 4 + pl, n + 1, nwrite, SBU_HCD_OP_WRITE, pl);
+		}
+		if ((e = sbu_tx_raw(pkt, 4 + pl)) != 0) {
+			SBU_GAP(SG_OTHER, "patchram stream stopped at record %u of %u (%zu payload bytes sent, error %d)", n + 1, nwrite, sent, e);
+			return e;
+		}
+		off += 3 + pl;
+		sent += pl;
+		n++;
+		if (err != 0) {
+			rxerrs++;
+			sbu.rx_err++;
+			SBU_GAP(SG_RXERR, "uart16 rx error flags %#x during the patchram stream (before record %u)", err, n);
+		}
+		while (got < 64 && ((sbu_rd(SBU_UART + U_UFSTAT) & SBU_UFSTAT_RXMASK) != 0 || (sbu_rd(SBU_UART + U_UTRSTAT) & SBU_UTRSTAT_RXDR) != 0)) {
+			uint8_t b = (uint8_t)sbu_rd(SBU_UART + U_URXH);
+
+			if (got < sizeof(first)) {
+				first[got] = b;
+			}
+			got++;
+			sbu.rx_bytes++;
+		}
+		if (got != 0) {
+			unexpected += got;
+			SBU_GAP(SG_OTHER, "patchram: %u unexpected rx bytes from the controller during the stream after record %u (first %02x): the stock capture shows no event for 0xfc4c", got, n, first[0]);
+		}
+		if (n % 500 == 0) {
+			printf("BT PROBE: patchram stream record %u/%u, %zu payload bytes sent\n", n, nwrite, sent);
+		}
+	}
+	printf("BT PROBE: patchram stream done: records=%u payload=%zu bytes unexpected-rx=%u rx-errors=%u\n", n, sent, unexpected, rxerrs);
+	if (unexpected != 0 || rxerrs != 0) {      /* the stock capture shows no event and no line error for 0xfc4c: the controller state is unknown, do not hand it to bluetoothd as patched (review T-60ed F5) */
+		SBU_GAP(SG_OTHER, "patchram stream had %u unexpected rx bytes and %u rx error flags: the controller state is unknown; sequence stopped", unexpected, rxerrs);
+		return EIO;
+	}
+	return 0;
+}
+
+/* returns 0 = patched and verified (the controller is powered, open at 115200, running the patch), SBU_PR_REFUSED = nothing sent, else an errno after the first controller write */
+static int
+sbu_patchram(const struct sbu_cand *cand)
+{
+	static const uint8_t par_bd[6] = { 0x01, 0x00, 0x00, 0x00, 0x00, 0x02 };       /* 02:00:00:00:00:01, the synthetic locally administered D-3 style address of the 0216 probe, LSB first */
+	uint8_t rp[SBU_PM_SUPP], bd[6];
+	size_t rpn, wbytes, launch_off;
+	unsigned nwrite, nlaunch, build, rev;
+	int fast = 0, v = 0, e;
+
+	if (sweet_bt_hcd_len == 0) {
+		SBU_GAP(SG_OTHER, "sweetbtpatchram=1 refused: this kernel was built without BCM_HCD (no firmware image embedded, tools/bcm-hcd-stack); nothing sent to the controller");
+		return SBU_PR_REFUSED;
+	}
+	if (sbu_hcd_scan(&nwrite, &nlaunch, &wbytes) != 0) {
+		return SBU_PR_REFUSED;
+	}
+	launch_off = sweet_bt_hcd_len - 7;
+	if (PE_parse_boot_argn("sweetbtpatchrambaud", &v, sizeof(v)) && v == 1) {
+		fast = 1;
+	}
+	printf("BT PROBE: patchram start (sweetbtpatchram=1, patch 0218): image %zu bytes, %u write records (%zu payload bytes) + %u launch, sha256=%s stock=%s, download baud %s\n",
+	    sweet_bt_hcd_len, nwrite, wbytes, nlaunch, sweet_bt_hcd_sha256, strcmp(sweet_bt_hcd_sha256, SBU_HCD_STOCK_SHA256) == 0 ? "yes" : "no", fast ? "4000000 (sweetbtpatchrambaud=1)" : "115200 (default; the HAL's 4 Mbaud step is off)");
+	if (strcmp(sweet_bt_hcd_sha256, SBU_HCD_STOCK_SHA256) != 0) {      /* review T-60ed F3: tools/bcm-hcd-stack enforces the stock hash by default; a build that overrode it is loud here and still has to reach build 203 / rev 0x20cb below */
+		SBU_GAP(SG_OTHER, "patchram: the embedded image sha256 %s is not the stock BCM.hcd (%s); continuing, the launch is only accepted at build %u rev 0x%04x", sweet_bt_hcd_sha256, SBU_HCD_STOCK_SHA256, SBU_HCD_STOCK_BUILD, SBU_HCD_STOCK_REV);
+	}
+	e = sbu_pr_prepare(fast != 0);
+	if (e != 0 && fast != 0 && e != EINVAL) {
+		SBU_GAP(SG_OTHER, "patchram: the 4 Mbaud download start failed (error %d): power-cycling the controller and starting over at 115200", e);
+		(void)sbu_power_off();
+		if ((e = sbu_probe_one(cand)) != 0) {
+			return e;
+		}
+		fast = 0;
+		e = sbu_pr_prepare(false);
+	}
+	if (e != 0 || (e = sbu_pr_stream(nwrite)) != 0) {
+		return e;
+	}
+	if ((e = sbu_pr_cmd("launch-ram", SBU_HCD_OP_LAUNCH, sweet_bt_hcd_data + launch_off + 3, 4, rp, sizeof(rp), &rpn)) != 0) {      /* the file's own 4 bytes (ff ff ff ff in the stock image) */
+		return e;
+	}
+	if (fast != 0 && (e = sbu_set_baud(115200)) != 0) {      /* the HAL goes back to 115200 right after the launch (golden gap 251 ms); the firmware starts there */
+		return e;
+	}
+	sbu.hw.msleep(250);
+	if ((e = sbu_pr_cmd("reset-2", 0x0c03, NULL, 0, rp, sizeof(rp), &rpn)) != 0 || (e = sbu_pr_cmd("read-chip-id-2", 0xfc79, NULL, 0, rp, sizeof(rp), &rpn)) != 0) {
+		return e;
+	}
+	if (rpn < 6) {
+		SBU_GAP(SG_OTHER, "patchram: 0xfc79 reply after the launch has %zu return bytes (need 6)", rpn);
+		return EPROTO;
+	}
+	build = (unsigned)(rp[4] | (rp[5] << 8));
+	printf("BT PROBE: patchram after launch: chip id=0x%02x build=%u (rev word %02x %02x)\n", rp[0], build, rp[4], rp[5]);
+	if ((e = sbu_pr_cmd("read-local-version", 0x1001, NULL, 0, rp, sizeof(rp), &rpn)) != 0) {
+		return e;
+	}
+	if (rpn < 8) {
+		SBU_GAP(SG_OTHER, "patchram: 0x1001 reply has %zu return bytes (need 8)", rpn);
+		return EPROTO;
+	}
+	rev = (unsigned)(rp[1] | (rp[2] << 8));
+	printf("BT PROBE: patchram build=%u hci_rev=0x%04x records=%u sha256=%s hci_ver=0x%02x lmp_ver=0x%02x\n", build, rev, nwrite + nlaunch, sweet_bt_hcd_sha256, rp[0], rp[3]);
+	if (build == 0 || rev == 0x2000) {
+		SBU_GAP(SG_OTHER, "patchram: the controller still reports build %u rev 0x%04x after the launch: the download did not take effect", build, rev);
+		return EIO;
+	}
+	if (build != SBU_HCD_STOCK_BUILD || rev != SBU_HCD_STOCK_REV) {      /* review T-60ed F5: anything but the stock image's own answer is not "patched" (this also covers 0xfc79 build and 0x1001 rev disagreeing) */
+		SBU_GAP(SG_OTHER, "patchram: the controller reports build %u rev 0x%04x after the launch, the stock image gives build %u rev 0x%04x; not accepted as patched", build, rev, SBU_HCD_STOCK_BUILD, SBU_HCD_STOCK_REV);
+		return EIO;
+	}
+	if ((e = sbu_pr_cmd("write-bd-addr", 0xfc01, par_bd, sizeof(par_bd), rp, sizeof(rp), &rpn)) != 0 || (e = sbu_pr_cmd("read-bd-addr", 0x1009, NULL, 0, rp, sizeof(rp), &rpn)) != 0) {
+		return e;
+	}
+	memcpy(bd, rp, rpn < sizeof(bd) ? rpn : sizeof(bd));
+	if (rpn < 6 || memcmp(bd, par_bd, sizeof(bd)) != 0) {
+		printf("BT PROBE: patchram bd-addr readback DIFFERS from the synthetic address written (%zu bytes)\n", rpn);
+		SBU_GAP(SG_OTHER, "patchram: the 0x1009 read-back (%zu bytes) is not the 0xfc01 address just written; sequence stopped", rpn);
+		return EIO;
+	}
+	printf("BT PROBE: patchram bd-addr readback matches the synthetic address written (%zu bytes)\n", rpn);
+	SBU_GAP(SG_OTHER, "patchram: 0xfc27 LPM not sent (host-wake irq A25 not wired, dev-wake held high) and the HAL's second 4 Mbaud step skipped: deliberate deviations from the stock sequence");
+	return 0;
+}
+
+/* attach side of the knob (review T-60ed F7: a function the host test can call). 0 = go on to bluetoothd (patched, refused or ROM restored), else the backend must not start. */
+static int
+sbu_patchram_attach(const struct sbu_cand *cand)
+{
+	int e = sbu_patchram(cand);
+
+	if (e == 0) {
+		printf("BT UART: patchram download verified; bluetoothd will meet the patched controller\n");
+		return 0;
+	}
+	if (e == SBU_PR_REFUSED) {
+		printf("BT GAP: sweetbtpatchram=1 had no effect (refused, nothing sent); bluetoothd meets the unpatched ROM\n");
+		return 0;
+	}
+	printf("BT GAP: sweetbtpatchram=1 FAILED (error %d): power-cycling the controller back to the unpatched ROM for bluetoothd\n", e);
+	(void)sbu_power_off();
+	e = sbu_probe_one(cand);
+	if (e != 0) {
+		printf("BT GAP: backend not started after the failed patchram power-cycle (error %d); controller powered off\n", e);
+		return e;
+	}
+	return 0;
+}
