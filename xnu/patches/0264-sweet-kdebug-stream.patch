diff --git a/bsd/kern/kdebug.c b/bsd/kern/kdebug.c
index 7417bf0..d3de940 100644
--- a/bsd/kern/kdebug.c
+++ b/bsd/kern/kdebug.c
@@ -259,6 +259,9 @@ extern void IOSleep(int);
 
 unsigned int kdebug_enable = 0;
 
+/* SWEET patch 0264 (bsd/dev/sweet_kdbg.c): set only inside sweet_kdbg_drain, makes the read path copy to a kernel address instead of copyout */
+static int sweet_kdbg_kernel_sink;
+
 // A static buffer to record events prior to the start of regular logging.
 
 #define KD_EARLY_BUFFER_SIZE (16 * 1024)
@@ -934,10 +937,16 @@ kernel_debug_early_end(void)
 	kernel_debug_string_early("early trace done");
 }
 
+/* SWEET patch 0264: who switched tracing off last (pid of the current process at kernel_debug_disable), read by sweet_kdbg_drain */
+static volatile int sweet_kdbg_dis_pid = -1;
+static volatile uint32_t sweet_kdbg_dis_n;
+
 void
 kernel_debug_disable(void)
 {
 	if (kdebug_enable) {
+		sweet_kdbg_dis_pid = proc_selfpid();
+		sweet_kdbg_dis_n++;
 		kdbg_set_tracing_enabled(false, 0);
 		kdbg_wakeup();
 	}
@@ -2327,6 +2336,9 @@ kernel_debug_trace_write_to_file(user_addr_t *buffer, size_t *number,
 
 			RAW_file_written = 0;
 		}
+	} else if (sweet_kdbg_kernel_sink) {
+		memcpy((void *)*buffer, kd_buffer_trace.kdcopybuf, tempbuf_number * sizeof(kd_buf));
+		*buffer += (tempbuf_number * sizeof(kd_buf));
 	} else {
 		error = copyout(kd_buffer_trace.kdcopybuf, *buffer, tempbuf_number * sizeof(kd_buf));
 		*buffer += (tempbuf_number * sizeof(kd_buf));
@@ -2335,6 +2347,56 @@ kernel_debug_trace_write_to_file(user_addr_t *buffer, size_t *number,
 	return error;
 }
 
+/*
+ * SWEET patch 0264: in-kernel drain of the trace buffers (same merge and storage-unit release as the sysctl read, KERN_KDREADTR path).
+ * out = kernel buffer, *number in = bytes of room, out = number of kd_buf records written. Returns 0 or an errno; *enabled = kdebug_enable.
+ */
+int sweet_kdbg_drain(void *out, size_t *number, unsigned int *enabled);
+int sweet_kdbg_rearm(int *dis_pid, uint32_t *dis_n, uint32_t *live_flags);
+
+int
+sweet_kdbg_drain(void *out, size_t *number, unsigned int *enabled)
+{
+	int error;
+
+	ktrace_lock();
+	*enabled = kdebug_enable;
+	if (!(kd_control_trace.kdc_flags & KDBG_BUFINIT)) {
+		*number = 0;
+		ktrace_unlock();
+		return ENXIO;
+	}
+	sweet_kdbg_kernel_sink = 1;
+	error = _read_merged_trace_events((user_addr_t)out, number, NULL, NULL, false);
+	sweet_kdbg_kernel_sink = 0;
+	ktrace_unlock();
+	return error;
+}
+
+/*
+ * SWEET patch 0264 (nav27: tracing stopped ~10 s after boot, 'records 0' for the rest of the run): when the buffers exist but tracing is off,
+ * report why (live flags: KDBG_WRAPPED|KDBG_NOWRAP = the storage-full stop of kdebug_common.c:293-299; otherwise kernel_debug_disable(), whose
+ * last caller's pid is kept) and switch it back on with wrapping (the same kdbg_set_tracing_enabled call as KERN_KDENABLE, kdebug.c sysctl path).
+ * Returns 1 when it re-armed, 0 when tracing was on or the buffers are gone. The caller prints the GAP line.
+ */
+int
+sweet_kdbg_rearm(int *dis_pid, uint32_t *dis_n, uint32_t *live_flags)
+{
+	int r = 0;
+
+	ktrace_lock();
+	if ((kd_control_trace.kdc_flags & KDBG_BUFINIT) && !kdebug_enable) {
+		*dis_pid = sweet_kdbg_dis_pid;
+		*dis_n = sweet_kdbg_dis_n;
+		*live_flags = kd_control_trace.kdc_live_flags;
+		kd_control_trace.kdc_live_flags &= ~(KDBG_NOWRAP | KDBG_WRAPPED);
+		kdbg_set_tracing_enabled(true, KDEBUG_ENABLE_TRACE);
+		r = 1;
+	}
+	ktrace_unlock();
+	return r;
+}
+
 #pragma mark - User space interface
 
 static int
