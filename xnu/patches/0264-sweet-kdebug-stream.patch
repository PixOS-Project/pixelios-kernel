diff --git a/bsd/dev/sweet_kdbg.c b/bsd/dev/sweet_kdbg.c
new file mode 100644
index 0000000..4710953
--- /dev/null
+++ b/bsd/dev/sweet_kdbg.c
@@ -0,0 +1,182 @@
+/*
+ * SWEET kdebug stream (patch 0264, sprint-gpu 2026-11-08, boot-arg sweetkdbg=N, default off: no thread, nothing printed). R0: log only, no register writes.
+ *
+ * XNU's own kdebug trace (the Instruments / ktrace event system; started at boot by boot-arg trace=<events> [trace_wrap=1] [trace_typefilter=<desc>],
+ * bsd/kern/kdebug_common.c:46,65) is drained every N ms (N = boot-arg, clamped 10..2000) from this kernel thread through sweet_kdbg_drain
+ * (bsd/kern/kdebug.c, the same merge + storage-unit release as the KERN_KDREADTR read) and printed as text so it rides the USB UDP log (patch 0075):
+ *   SWEET KDBG: <base64 of 1..2 raw 64-byte kd_buf records>                    (bsd/sys/kdebug_private.h, arm64 layout; <= 184 chars per line)
+ *   SWEET KDBG: on records R lost L abs A ns T drained D lines N errs E        (once per second; R = records in the last second, L = TRACE_LOST_EVENTS markers
+ *                                                                               in the last second, A / T = mach_absolute_time ticks / ns to map kd timestamps)
+ *   SWEET KDBG GAP: ...                                                        (every failure; kdebug not enabled once; drain errors at most once per second)
+ * Host: tools/kdbg2perfetto. Single thread, static buffers, printf only from this thread.
+ */
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/kdebug.h>
+#include <sys/kdebug_private.h>
+#include <kern/thread.h>
+#include <kern/clock.h>
+#include <mach/mach_time.h>
+#include <mach/kern_return.h>
+#include <pexpert/pexpert.h>
+
+extern int sweet_kdbg_drain(void *out, size_t *number, unsigned int *enabled);   /* bsd/kern/kdebug.c (patch 0264) */
+extern int sweet_kdbg_rearm(int *dis_pid, uint32_t *dis_n, uint32_t *live_flags);  /* bsd/kern/kdebug.c (patch 0264) */
+extern void sweet_kdbg_start(void);
+
+#define KDS_MIN_MS     10
+#define KDS_MAX_MS     2000
+#define KDS_READ_RECS  128                 /* records per drain call (8 KiB) */
+#define KDS_LINE_RECS  2                   /* records per printed line (the USB log cuts lines at ~260 chars: observed nav24) */
+#define KDS_MAX_CALLS  32                  /* drain calls per period, then the next period continues */
+
+_Static_assert(sizeof(kd_buf) == 64, "kd_buf is 64 bytes on arm64");
+
+static kd_buf kds_recs[KDS_READ_RECS];
+static char kds_line[((KDS_LINE_RECS * 64 + 2) / 3) * 4 + 1];
+static uint32_t kds_period_ms;
+
+static const char kds_b64[] = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";
+
+static void
+kds_encode(const uint8_t *in, size_t n, char *out)
+{
+	size_t o = 0;
+
+	for (size_t i = 0; i < n; i += 3) {
+		uint32_t v = (uint32_t)in[i] << 16;
+		size_t rem = n - i;
+
+		if (rem > 1) {
+			v |= (uint32_t)in[i + 1] << 8;
+		}
+		if (rem > 2) {
+			v |= in[i + 2];
+		}
+		out[o++] = kds_b64[(v >> 18) & 63];
+		out[o++] = kds_b64[(v >> 12) & 63];
+		out[o++] = rem > 1 ? kds_b64[(v >> 6) & 63] : '=';
+		out[o++] = rem > 2 ? kds_b64[v & 63] : '=';
+	}
+	out[o] = '\0';
+}
+
+static void
+sweet_kdbg_thread(__unused void *arg, __unused wait_result_t wr)
+{
+	uint64_t last_sum = 0, last_err = 0, recs = 0, lost = 0, lines = 0, errs = 0, drained = 0, filt = 0, rearms = 0;
+	int gap_said = 0;
+
+	for (;;) {
+		uint64_t now_abs, now_ns;
+		unsigned int enabled = 0;
+
+		delay_for_interval(kds_period_ms, 1000 * 1000);
+		for (int call = 0; call < KDS_MAX_CALLS; call++) {
+			size_t n = sizeof(kds_recs);
+			int err = sweet_kdbg_drain(kds_recs, &n, &enabled);
+
+			if (err != 0) {
+				errs++;
+				now_abs = mach_absolute_time();
+				absolutetime_to_nanoseconds(now_abs, &now_ns);
+				if (!enabled && !gap_said) {
+					gap_said = 1;
+					printf("SWEET KDBG GAP: kdebug not enabled (boot-arg trace=), drain error %d\n", err);
+				} else if (now_ns - last_err >= 1000000000ULL) {
+					last_err = now_ns;
+					printf("SWEET KDBG GAP: drain error %d (kdebug_enable %u, errs %llu)\n", err, enabled, errs);
+				}
+				break;
+			}
+			if (!enabled) {
+				int dpid = -1;
+				uint32_t dn = 0, lf = 0;
+
+				if (sweet_kdbg_rearm(&dpid, &dn, &lf)) {
+					rearms++;
+					if (rearms <= 50) {
+						printf("SWEET KDBG GAP: tracing was off (%s; last kernel_debug_disable by pid %d, %u calls; live flags 0x%x), re-armed with wrapping (re-arm %llu)\n",
+						    (lf & 0x8u) ? "storage full with KDBG_WRAPPED (no-wrap stop)" : "switched off", dpid, dn, lf, rearms);
+					}
+				} else if (!gap_said) {
+					gap_said = 1;
+					printf("SWEET KDBG GAP: kdebug not enabled (boot-arg trace=)\n");
+				}
+			}
+			if (n == 0) {
+				break;
+			}
+			/* n = records (kernel_debug_read counts records) */
+			size_t n_read = n;
+			/* sprint-gpu: in the scheduler subclass (class 1 / DBG_MACH_SCHED 0x40) keep only MACH_SCHED (0x0, context switch) and
+			 * MACH_MAKE_RUNNABLE (0x6, wakeup) (bsd/sys/kdebug.h:200,206); THREAD_SELECT / DISPATCH / CHOOSE_PROCESSOR were half of nav25's
+			 * records and the USB log delivered only 21% of the lines. Filtered records are counted (filt), never silent. */
+			{
+				size_t k = 0;
+
+				for (size_t i = 0; i < n; i++) {
+					uint32_t d = kds_recs[i].debugid;
+
+					if ((d >> 24) == 1 && ((d >> 16) & 0xff) == 0x40 && ((d >> 2) & 0x3fff) != 0x0 && ((d >> 2) & 0x3fff) != 0x6) {
+						filt++;
+						continue;
+					}
+					kds_recs[k++] = kds_recs[i];
+				}
+				drained += n;
+				n = k;
+			}
+			for (size_t i = 0; i < n; i += KDS_LINE_RECS) {
+				size_t m = n - i < KDS_LINE_RECS ? n - i : KDS_LINE_RECS;
+
+				kds_encode((const uint8_t *)&kds_recs[i], m * sizeof(kd_buf), kds_line);
+				printf("SWEET KDBG: %s\n", kds_line);
+				lines++;
+			}
+			for (size_t i = 0; i < n; i++) {
+				if (kds_recs[i].debugid == TRACE_LOST_EVENTS) {
+					lost++;
+				}
+			}
+			recs += n;
+			if (n_read < KDS_READ_RECS) {
+				break;
+			}
+		}
+		now_abs = mach_absolute_time();
+		absolutetime_to_nanoseconds(now_abs, &now_ns);
+		if (now_ns - last_sum >= 1000000000ULL) {
+			last_sum = now_ns;
+			printf("SWEET KDBG: on records %llu lost %llu abs %llu ns %llu drained %llu lines %llu errs %llu filt %llu rearms %llu\n",
+			    recs, lost, now_abs, now_ns, drained, lines, errs, filt, rearms);
+			recs = 0;
+			lost = 0;
+		}
+	}
+}
+
+void
+sweet_kdbg_start(void)
+{
+	int v = 0;
+	thread_t thread;
+
+	if (!PE_parse_boot_argn("sweetkdbg", &v, sizeof(v)) || v == 0) {
+		return;
+	}
+	if (v < 0) {
+		printf("SWEET KDBG GAP: sweetkdbg=%d ignored (a period in ms, %d..%d, is needed)\n", v, KDS_MIN_MS, KDS_MAX_MS);
+		return;
+	}
+	kds_period_ms = (uint32_t)v < KDS_MIN_MS ? KDS_MIN_MS : ((uint32_t)v > KDS_MAX_MS ? KDS_MAX_MS : (uint32_t)v);
+	if (kds_period_ms != (uint32_t)v) {
+		printf("SWEET KDBG: sweetkdbg=%d clamped to %u ms (%d..%d)\n", v, kds_period_ms, KDS_MIN_MS, KDS_MAX_MS);
+	}
+	printf("SWEET KDBG: period %u ms, %d records per line, kd_buf %d bytes\n", kds_period_ms, KDS_LINE_RECS, (int)sizeof(kd_buf));
+	if (kernel_thread_start(sweet_kdbg_thread, NULL, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	} else {
+		printf("SWEET KDBG GAP: unavailable (kernel_thread_start failed)\n");
+	}
+}
