+
+/* sweetmali bit 0x40: READ-ONLY dump of the GIC distributor state for the three GPU SPIs (INTID 451/452/453 = SPI 419/420/421 + 32; research 35: SPI numbers are second-hand from doc 17,
+ * so the whole ISENABLER row 14 and every non-zero ISENABLER word are printed too). Nothing is written. GICD at 0x10400000 [src soc/google/gs101/soc.json gicd_base]. Offsets are the
+ * GICv3 architected ones: CTLR 0x0, TYPER 0x4, IGROUPR 0x080, ISENABLER 0x100, ISPENDR 0x200, ISACTIVER 0x300, IPRIORITYR 0x400, ICFGR 0xC00, IGRPMODR 0xD00, IROUTER 0x6000 [src GICv3 spec;
+ * review gpu-gic-probe-and-m5-review-1 A1-A4]. */
+#define SM_GICD_PA 0x10400000ull
+extern vm_offset_t ml_io_map(vm_offset_t phys_addr, vm_size_t size);
+
+static void
+sm_gic_probe(void)
+{
+	vm_offset_t va = ml_io_map((vm_offset_t)SM_GICD_PA, 0x10000);
+	if (va == 0) {
+		printf("SWEET MALI: gic probe: ml_io_map failed\n");
+		return;
+	}
+	volatile uint32_t *d = (volatile uint32_t *)va;
+	printf("SWEET MALI: gic CTLR=%#x TYPER=%#x\n", d[0x0 / 4], d[0x4 / 4]);
+	printf("SWEET MALI: gic row14 IGROUPR=%#x IGRPMODR=%#x ISENABLER=%#x ISPENDR=%#x ISACTIVER=%#x\n", d[(0x080 + 4 * 14) / 4], d[(0xD00 + 4 * 14) / 4],
+	    d[(0x100 + 4 * 14) / 4], d[(0x200 + 4 * 14) / 4], d[(0x300 + 4 * 14) / 4]);
+	for (uint32_t id = 451; id <= 453; id++) {
+		volatile uint8_t *prio = (volatile uint8_t *)va + 0x400 + id;
+		printf("SWEET MALI: gic INTID %u: prio=%#x ICFGR=%#x IROUTER=%08x%08x\n", id, *prio, d[(0xC00 + 4 * (id / 16)) / 4], d[(0x6000 + 8 * id + 4) / 4], d[(0x6000 + 8 * id) / 4]);
+	}
+	for (uint32_t w = 0; w < 31; w++) {
+		uint32_t en = d[(0x100 + 4 * w) / 4];
+		if (en) {
+			printf("SWEET MALI: gic ISENABLER[%u]=%#x ISPENDR=%#x ISACTIVER=%#x (INTID %u..%u)\n", w, en, d[(0x200 + 4 * w) / 4], d[(0x300 + 4 * w) / 4], w * 32, w * 32 + 31);
+		}
+	}
+	printf("SWEET MALI: gic probe done\n");
+}
+
 void
 sweet_mali_init(volatile uint32_t *g, int s2mpu_open)
 {
-	static int started;
+	static int started, gic_done;
 	uint32_t mode = 0;
 
-	if (started || !PE_parse_boot_argn("sweetmali", &mode, sizeof(mode)) || (mode & 3u) == 0 || (mode & 3u) == 3) {
+	if (!PE_parse_boot_argn("sweetmali", &mode, sizeof(mode))) {
+		return;
+	}
+	if ((mode & 0x40u) && !gic_done) {
+		gic_done = 1;
+		sm_gic_probe();       /* read-only; 0x40 alone is a pure read run, before any Mali interrupt mask is touched */
+	}
+	if (started || (mode & 3u) == 0 || (mode & 3u) == 3) {
 		return;       /* sweetmali = 1 (service) or 2 (service + selftest), | 0x10 skips the kbase config writes */
 	}
 	started = 1;
