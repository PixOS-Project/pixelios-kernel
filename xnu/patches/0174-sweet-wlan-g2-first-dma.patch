+		swl_gap("g2", "glue: store not in the G2 list, refused", "high");
+		printf("SWEET WLAN: G2 glue: store space %d win %#x off %#x (ioctl payload, value withheld) not in the list, refused\n", space, win, off);
+	} else if (have) {
+		swl_gap("g2", "glue: store not in the G2 list, refused", "high");
