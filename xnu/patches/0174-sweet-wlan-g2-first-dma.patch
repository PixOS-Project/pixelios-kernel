+		if (e->kind == SW_G2K_E_WR) {   /* T-4a7f: an event re-post commit: one item up, below the ring-0 depth, upper half kept, the cap, and the whole item at the old slot is the expected event post (silent here: a DS commit tries R_WR next) */
+			if (h->g2ev < SW_G2_E_CAP(h) && (vv & 0xFFFFu) == (old & 0xFFFFu) + 1u && (vv & 0xFFFFu) < SW_G2_R0_ITEMS && (vv & 0xFFFF0000u) == (old & 0xFFFF0000u) && sw_g2_evitem_ok(h, old & 0xFFFFu)) {
