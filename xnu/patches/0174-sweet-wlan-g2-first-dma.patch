+/* the list (R94 s.2 values, bcmpcie.h:290-339 offsets): every word G2 may store, once each except the window moves. 0 = built; -1 = refused (a read failed or an address is not RAM) */
+/* review r2 F1: 1 when the low 32 bits of the block [pa, pa + total) lie inside [SW_G2_ALIAS_LO, SW_G2_ALIAS_HI) (or the block is below 4 GiB: no alias) */
+static int
+sw_g2_alias_ok(uint64_t pa, uint32_t total)
+{
+	uint64_t lo = pa & 0xFFFFFFFFull;
+
+	return (pa >> 32) == 0u || (lo >= SW_G2_ALIAS_LO && total <= SW_G2_ALIAS_HI - SW_G2_ALIAS_LO && lo <= (uint64_t)(SW_G2_ALIAS_HI - total));
+}
+
+/* cfg 0x84 (the BAR2 window) to `win`, only on a change; the list's 0x84 entries allow exactly 0 and SWW_WIN_TAIL (DHD re-windows per access, dhd_pcie.c:6154-6155, 6232-6241) */
+static int
+sw_g2_win2(struct sw_hw *h, uint32_t win)
+{
+	if (h->cfg[SWW_CFG_WIN2 / 4] == win) {
+		return 0;
+	}
+	return sw3_wr(h, SWW_CFG, 0, SWW_CFG_WIN2, win) != 0 || h->cfg[SWW_CFG_WIN2 / 4] != win;
+}
+
+/* one RAM word at backplane address bp, read through the window that maps THAT word (W-D3c: a block may straddle SWW_WIN_TAIL). 0 = read; -1 = bp not an aligned RAM word or the read failed; -2 = window move failed */
+static int
+sw_g2_rdw(struct sw_hw *h, uint32_t end, uint32_t bp, uint32_t *v)
+{
+	uint32_t win = bp >= SWW_WIN_TAIL ? SWW_WIN_TAIL : 0u;
+
+	if ((bp & 3u) != 0 || bp < SWW_RAM_BASE || bp > end - 4u) {
+		return -1;
+	}
+	if (sw_g2_win2(h, win) != 0) {
+		return -2;
+	}
+	return sw3_rd(h, SWW_BAR2, win, bp - win, v) != 0 ? -1 : 0;
+}
+
+static int
+sw_g2_list(struct sw_hw *h, uint32_t sh, uint32_t end, uint32_t w80)
+{
+	uint32_t ri = 0, rm = 0, ra[4] = { 0 }, rcold = 0xFFFFFFFFu;
+	uint64_t pa;
+	unsigned i, k;
+	int bad = 0, ep, rc, r, ready;
+	const char *why = NULL;
+
+	h->g2n = 0;
+	h->g2ev = 0;
+	h->g2ev0 = 0;
+	h->g2rd = 0;
+	h->g2esc = -1;
+	/* the window entries FIRST: h->g2 is set by the hook, sw3_wr takes only list entries, and the reads below move cfg 0x84 */
+	bad |= sw_g2_add(h, SWW_CFG, 0, SWW_CFG_WIN, SWW_WIN_PCIE, 0xFFFFFFFFu, 0, 0, 0, -1) < 0 || sw_g2_add(h, SWW_CFG, 0, SWW_CFG_WIN, w80, 0xFFFFFFFFu, 0, 0, 0, -1) < 0;
+	bad |= sw_g2_add(h, SWW_CFG, 0, SWW_CFG_WIN2, 0u, 0xFFFFFFFFu, 0, 0, 0, -1) < 0 || sw_g2_add(h, SWW_CFG, 0, SWW_CFG_WIN2, SWW_WIN_TAIL, 0xFFFFFFFFu, 0, 0, 0, -1) < 0;
+	if (bad) {
+		why = "list full";
+	}
+	/* any 4-aligned RAM address of [SWW_RAM_BASE, end) is valid: DHD checks only that (dhd_pcie.c:13684-13713, 13872); u32 compares, wrap-free because end >= SWW_RAM_BASE + 0x9C */
+	if (why == NULL && ((sh & 3u) != 0 || sh < SWW_RAM_BASE || end < SWW_RAM_BASE + 0x9Cu || sh > end - 0x60u)) {
+		why = "shared range";
+	}
+	if (why == NULL && (r = sw_g2_rdw(h, end, sh + 0x30u, &ri)) != 0) {
+		why = r == -2 ? "window move" : "ring_info read";
+	}
+	if (why == NULL && ((ri & 3u) != 0 || ri < SWW_RAM_BASE || ri > end - 0x9Cu)) {
+		why = "ring_info range";
+	}
+	if (why == NULL && (r = sw_g2_rdw(h, end, ri, &rm)) != 0) {
+		why = r == -2 ? "window move" : "ring_info read";
+	}
+	if (why == NULL && rm != ri + 0x4Cu) {
+		why = "ring_mem ptr";   /* ring_mem right after ring_info: a logged layout assumption (R89 s.7 S3), not a DHD rule (dhd_pcie.c:14141) */
+	}
+	if (why == NULL && !(ri + 0x9Cu <= sh || sh + 0x60u <= ri)) {
+		why = "ring_info/shared overlap";       /* [ri, ri + 0x4C + 0x50) vs [sh, sh + 0x60): no list word of one lands on the other */
+	}
+	for (k = 0; k < 4u && why == NULL; k++) {
+		ra[k] = 0;
+		if ((r = sw_g2_rdw(h, end, ri + 0x04u + 4u * k, &ra[k])) != 0) {
+			why = r == -2 ? "window move" : "index array range";
+		} else if ((ra[k] & 3u) != 0 || ra[k] < SWW_RAM_BASE || ra[k] > end - 16u) {     /* review r4 LOW 1: an unaligned array is named here, not as "list full" */
+			why = "index array range";
+		}
+	}
+	for (k = 0; k < 4u && why == NULL; k++) {     /* review r1 F2: an index array (16 B) shares no byte with shared [sh, +0x60), ring_info [ri, +0x4C), ring_mem [rm, +0x50) or another array */
+		if (!(ra[k] + 16u <= sh || sh + 0x60u <= ra[k]) || !(ra[k] + 16u <= ri || ri + 0x4Cu <= ra[k]) || !(ra[k] + 16u <= rm || rm + 0x50u <= ra[k])) {
+			why = "index array overlap";
+		}
+		for (i = 0; i < k; i++) {
+			if (!(ra[k] + 16u <= ra[i] || ra[i] + 16u <= ra[k])) {
+				why = "index array overlap";
+			}
+		}
+	}
+	if (why == NULL && (sw3_rd(h, SW3_DBI, 0, 0x04u, &rcold) != 0 || rcold == 0xFFFFFFFFu)) {
+		why = "rc command";
+	}
+	if (sw_g2_win2(h, 0u) != 0) {      /* the reads are done (built or refused): cfg 0x84 back to 0 BEFORE any g2n reset, the move needs its list entry */
+		swl_gap("g2", "glue: cfg 0x84 not put back to 0", "high");
+		why = why != NULL ? why : "window restore";
+	}
+	if (why == NULL) {
+		bad |= sw_g2_tcm(h, end, sh + 0x50u, SW_G2_FLAGS2, 0xFFFFFFFFu, SW_G2_FLAGS2_OLD, 0xFFFFFFFFu) < 0 || sw_g2_tcm(h, end, sh + 0x54u, SW_G2_HOSTCAP, 0xFFFFFFFFu, 0, 0xFFFFFFFFu) < 0;
+		pa = h->g2pa + h->g2plan.b[SWD_TRAP].off;
+		bad |= sw_g2_tcm(h, end, sh + 0x58u, (uint32_t)pa, 0xFFFFFFFFu, 0, 0xFFFFFFFFu) < 0 || sw_g2_tcm(h, end, sh + 0x5Cu, (uint32_t)(pa >> 32), 0xFFFFFFFFu, 0, 0xFFFFFFFFu) < 0;
+		for (k = 0; k < 4u; k++) {      /* ring_info +0x14: h2d_w, h2d_r, d2h_w, d2h_r host addresses (8 B each), the SWD_IDX_* order */
+			pa = h->g2pa + h->g2plan.b[SWD_IDX_H2D_W + k].off;
+			bad |= sw_g2_tcm(h, end, ri + 0x14u + 8u * k, (uint32_t)pa, 0xFFFFFFFFu, 0, 0xFFFFFFFFu) < 0 || sw_g2_tcm(h, end, ri + 0x18u + 8u * k, (uint32_t)(pa >> 32), 0xFFFFFFFFu, 0, 0xFFFFFFFFu) < 0;
+		}
+		for (i = 0; i < 5u; i++) {      /* ring_mem: +0x04 max_item | len_items << 16, +0x08 base (lo, hi) */
+			pa = h->g2pa + h->g2plan.b[SWD_H2D_CTRL + i].off;
+			bad |= sw_g2_tcm(h, end, rm + 16u * i + 0x08u, (uint32_t)pa, 0xFFFFFFFFu, 0, 0xFFFFFFFFu) < 0 || sw_g2_tcm(h, end, rm + 16u * i + 0x0Cu, (uint32_t)(pa >> 32), 0xFFFFFFFFu, 0, 0xFFFFFFFFu) < 0;
+			bad |= sw_g2_tcm(h, end, rm + 16u * i + 0x04u, (swd_rings[SWD_H2D_CTRL + i].items & 0xFFFFu) | swd_rings[SWD_H2D_CTRL + i].isz << 16, 0xFFFFFFFFu, 0, 0xFFFFFFFFu) < 0;
+		}
+		for (k = 0; k < 4u; k++) {      /* the index slots (R94 s.2 step 9): h2d arrays slots 0, 1; d2h arrays slots 0..2; the low half := 0, the upper half kept (rw_index_sz 4) */
+			for (i = 0; i < (k < 2u ? 2u : 3u); i++) {
+				bad |= (h->d4b >= 2 ? sw_g2_tcm16(h, end, ra[k] + 4u * i, 0u) : sw_g2_tcm(h, end, ra[k] + 4u * i, 0u, 0x0000FFFFu, 0, 0)) < 0;
+			}
+		}
+		pa = h->g2pa + h->g2plan.b[SWD_SCRATCH].off;
+		bad |= sw_g2_tcm(h, end, sh + 0x38u, (uint32_t)pa, 0xFFFFFFFFu, 0, 0xFFFFFFFFu) < 0 || sw_g2_tcm(h, end, sh + 0x3Cu, (uint32_t)(pa >> 32), 0xFFFFFFFFu, 0, 0xFFFFFFFFu) < 0;
+		bad |= sw_g2_tcm(h, end, sh + 0x34u, SW_G2_SCRLEN, 0xFFFFFFFFu, 0, 0xFFFFFFFFu) < 0;
+		rc = sw_g2_add(h, SW3_DBI, 0, 0x04u, SW_G2_RC, 0xFFFFFFFFu, 0, 0xFFFFu, 1, -1);
+		bad |= rc < 0 || sw_g2_add(h, SW3_DBI, 0, 0x04u, rcold & 0xFFFFu, 0xFFFFFFFFu, 0, 0, 1, rc) < 0;
+		ep = sw_g2_add(h, SWW_CFG, 0, 0x04u, SW_G2_EP_DMA, 0xFFFFFFFFu, SW_G2_EP_MEM, 0xFFFFu, 1, -1);
+		bad |= ep < 0 || sw_g2_add(h, SWW_CFG, 0, 0x04u, SW_G2_EP_MEM, 0xFFFFFFFFu, 0, 0, 1, ep) < 0;
+		ready = sw_g2_add(h, SWW_BAR0, SWW_WIN_PCIE, 0x144u, SW_G2_READY, 0xFFFFFFFFu, 0, 0, 1, -1);
+		bad |= ready < 0;
+		if (h->d4b >= 2) {      /* W-D4b: only at sweetwlan>=14 (stores), chained after hostready (review r1 F7); at 13 and below the list is the 45-store list of G2; sweetwlan=16 adds the 40 W-D4c entries inside sw_g2_d4 */
+			bad |= sw_g2_d4(h, ready) < 0;
+		}
+		if (bad) {
+			why = "list full";
+		}
+	}
+	if (why != NULL) {
+		swl_gap("g2", "glue: G2 list not built (see the refusal line)", "high");
+		printf("SWEET WLAN: G2 glue list refused (%s): shared %#x ring_info %#x ring_mem %#x index arrays %#x %#x %#x %#x rc command %#x (%u entries)\n", why, sh, ri, rm, ra[0], ra[1], ra[2], ra[3], rcold, h->g2n);
+		h->g2n = 0;
+		return -1;
+	}
+	printf("SWEET WLAN: G2 glue list %u entries: shared %#x ring_info %#x ring_mem %#x rc command %#x\n", h->g2n, sh, ri, rm, rcold);
+	return 0;
+}
+
+/* the BAR0 window of the PCIe core page for G2's SRPWR read and hostready store (cfg 0x80 := SWW_WIN_PCIE, a list entry) */
+static int
+sw_g2_bar0(struct sw_hw *h)
+{
+	if (h->cfg[SWW_CFG_WIN / 4] == SWW_WIN_PCIE) {
+		return 0;
+	}
+	return sw3_wr(h, SWW_CFG, 0, SWW_CFG_WIN, SWW_WIN_PCIE) != 0 || h->cfg[SWW_CFG_WIN / 4] != SWW_WIN_PCIE;
+}
+
+/* struct swg_bus for sweet_wlan_g2.h: the spaces map onto sw3_rd/sw3_wr (its G2 branch), nothing else touches the bus */
+static int
+sw_g2_rd(void *ctx, int sp, uint32_t a, uint32_t *v)
+{
+	struct sw_hw *h = ctx;
+	uint32_t win = a >= SWW_WIN_TAIL ? SWW_WIN_TAIL : 0u;
+
+	switch (sp) {
+	case SWG_SP_TCM:
+		return sw3_rd(h, SWW_BAR2, win, a - win, v);
+	case SWG_SP_EP:
+		return sw3_rd(h, SWW_CFG, 0, a, v);
+	case SWG_SP_RC:
+		return sw3_rd(h, SW3_DBI, 0, a, v);
+	case SWG_SP_PCIE:
+		return sw_g2_bar0(h) ? -1 : sw3_rd(h, SWW_BAR0, SWW_WIN_PCIE, a, v);
+	case SWG_SP_HOST:       /* W-D4b: host memory the dongle writes by DMA: flush_dcache64 -> flush_dcache (xnu osfmk/arm/caches.c:61-91) -> FlushPoC_DcacheRegion = dc civac per line + dsb sy (osfmk/arm64/caches_asm.s:403-420; no
+	                         * APPLE_ARM64_ARCH_FAMILY in this build, patch 0004:226). civac of a line with no CPU-dirty byte is an invalidate; Linux v6.6 dcache_inval_poc (arch/arm64/mm/cache.S:136-163) also uses civac on partial lines.
+	                         * Every G2 host read is 4 B; the G1 buffers are 128 B padded and aligned (patch 0167:4, 271) and each CPU host store is civac'd at once (sw_g2_wr), so no line mixes CPU and device writes.
+	                         * The D-cache line size is read at the arm (CTR_EL0.DminLine, refused above SWD_PAD). */
+		if (sw3_ptr(h, SW3_HOST, a) == NULL) {  /* review r1 F5: no cache op on an address the glue did not check */
+			swl_gap("g2", "glue: host block read outside the block refused", "high");
+			return -1;
+		}
+		flush_dcache64((addr64_t)(h->g2pa + a), 4, TRUE);
+		return sw3_rd(h, SW3_HOST, 0, a, v);
+	case SWG_SP_DATA:       /* T-d84f (L25): the DATA block, the same cache rule as SWG_SP_HOST (the rx buffers are written by the dongle's DMA, the tx buffers and the flow ring by the CPU and civac'd at once) */
+		if (sw3_ptr(h, SW3_DATA, a) == NULL) {
+			swl_gap("g2", "glue: DATA block read outside the block refused", "high");
+			return -1;
+		}
+		flush_dcache64((addr64_t)(h->dpa + a), 4, TRUE);
+		return sw3_rd(h, SW3_DATA, 0, a, v);
+	}
+	swl_gap("g2", "glue: read of an unknown space refused", "high");
+	return -1;
+}
+
+static int
+sw_g2_wr(void *ctx, int sp, uint32_t a, uint32_t v)
+{
+	struct sw_hw *h = ctx;
+	uint32_t win = a >= SWW_WIN_TAIL ? SWW_WIN_TAIL : 0u;
+	int rc = -1;
+
+	switch (sp) {
+	case SWG_SP_TCM:
+		return sw3_wr(h, SWW_BAR2, win, a - win, v);
+	case SWG_SP_EP:
+		rc = sw3_wr(h, SWW_CFG, 0, a, v);
+		h->g2ep = h->cfg[0x04 / 4] & 0xFFFFu;   /* the live low half: what the next window move must see */
+		return rc;
+	case SWG_SP_RC:
+		return sw3_wr(h, SW3_DBI, 0, a, v);
+	case SWG_SP_PCIE:
+		return sw_g2_bar0(h) ? -1 : sw3_wr(h, SWW_BAR0, SWW_WIN_PCIE, a, v);
+	case SWG_SP_HOST:       /* W-D4b: a store to host memory, then clean+invalidate its line so the dongle's DMA sees it */
+		if (sw3_ptr(h, SW3_HOST, a) == NULL) {  /* review r1 F5: no cache op on an address the glue did not check */
+			swl_gap("g2", "glue: host block store outside the block refused", "high");
+			return -1;
+		}
+		rc = sw3_wr(h, SW3_HOST, 0, a, v);
+		flush_dcache64((addr64_t)(h->g2pa + a), 4, TRUE);
+		return rc;
+	case SWG_SP_DATA:       /* T-d84f (L25): a store to the DATA block (only through the L25 whitelist entry, sw3_g2_ok), then clean+invalidate its line */
+		if (sw3_ptr(h, SW3_DATA, a) == NULL) {
+			swl_gap("g2", "glue: DATA block store outside the block refused", "high");
+			return -1;
+		}
+		rc = sw3_wr(h, SW3_DATA, 0, a, v);
+		flush_dcache64((addr64_t)(h->dpa + a), 4, TRUE);
+		return rc;
+	case SWG_SP_WIN2:
+		return a == SWW_CFG_WIN2 ? sw3_wr(h, SWW_CFG, 0, SWW_CFG_WIN2, v) : -1;
+	}
+	swl_gap("g2", "glue: store to an unknown space refused", "high");
+	return rc;
+}
+
+/* the 16-bit store of struct swg_bus (sweetwlan=14 index slots): BAR2 only */
+static int
+sw_g2_wr16(void *ctx, int sp, uint32_t a, uint16_t v)
+{
+	struct sw_hw *h = ctx;
+	uint32_t win = a >= SWW_WIN_TAIL ? SWW_WIN_TAIL : 0u;
+
+	if (sp != SWG_SP_TCM) {
+		swl_gap("g2", "glue: 16-bit store to an unknown space refused", "high");
+		return -1;
+	}
+	return sw3_wr16(h, SWW_BAR2, win, a - win, v);
+}
+
+static void
+sw_g2_delay(void *ctx, unsigned ms)
+{
+	(void)ctx;
+	delay((int)ms * 1000);
+}
+
+/* T-eabd (W-JOIN L24, docs/reviews/T-ed1c-proof.md): stack headroom for swg_hr(), READ-ONLY (no store, no MMIO). The bottom of the current thread's kernel stack is thread_get_kernel_stack() (osfmk/kern/thread.c:4120; sleh_invalid_stack
+ * derives the same bottom as round_page(kstackptr) - KERNEL_STACK_SIZE, sleh.c:2081, where kstackptr = stack + size - sizeof(thread_kernel_state), pcb.c:467). The result is sp minus that bottom; ~0ull when there is no thread or no
+ * stack, or when sp is not within 64 KiB above the bottom (the thread runs on another stack): swg_hr then says `unknown` and counts a gap, nothing is skipped silently. */
+extern vm_offset_t thread_get_kernel_stack(thread_t);   /* osfmk/kern/thread.h:1522, XNU-private, not declared by the headers this file includes */
+
+static uint64_t
+sw_g2_stack_room(void *ctx)
+{
+	vm_offset_t bottom = thread_get_kernel_stack(current_thread());
+	vm_offset_t sp = (vm_offset_t)__builtin_frame_address(0);       /* this small leaf's frame pointer: within one frame (< 64 B) of the caller's sp, no inline asm (the store-path audit bans it) */
+
+	(void)ctx;
+	if (bottom == 0 || sp < bottom || sp - bottom > 0x10000u) {
+		return ~0ull;
+	}
+	return (uint64_t)(sp - bottom);
+}
+
+/* the W17 hook (struct swl_wx g2): runs G2 while the CA7 runs, puts the BAR0 window back, and reports; W17 re-halts the CA7 and restores cfg 0x84 next whatever this returns */
+static int
+sw_g2_hook(struct swl_wx *x, uint32_t sh)
+{
+	struct sw_hw *h = x->b->ctx;
+	struct swg_bus gb;
+	static struct swg_wx g;       /* T-eabd: static, not on the kernel stack (4480 B frame of the L24 overflow, docs/reviews/T-ed1c-proof.md); G2 is single-threaded and runs once per boot, zeroed below on every call */
+	uint32_t w80 = h->cfg[SWW_CFG_WIN / 4];
+	unsigned i;
+	int rc, refused = 0;
+
+	gb.rd = sw_g2_rd;
+	gb.wr = sw_g2_wr;
+	gb.wr16 = sw_g2_wr16;
+	gb.delay_ms = sw_g2_delay;
+	gb.ctx = h;
+	gb.stack_room = sw_g2_stack_room;
+	memset(&g, 0, sizeof g);
+	if (!h->g2ok) {
+		swl_gap("g2", "not run: glue list refused or G2 not armed", "high");
+		printf("SWEET WLAN: G2 RESULT not run (G2 not armed)\n");
+		return 1;
+	}
+	h->g2ep = SW_G2_EP_MEM;
+	h->g2 = 1;      /* before the list: its reads move cfg 0x84, and sw3_wr takes only list entries while h->g2 is set (W-D3c) */
+	if (sw_g2_list(h, sh, SWW_RAM_BASE + x->ram_bytes, w80) != 0) {
+		swl_gap("g2", "not run: glue list refused or G2 not armed", "high");
+		printf("SWEET WLAN: G2 RESULT not run (glue list refused)\n");
+		rc = 1;
+		refused = 1;
+	} else {
+		g.b = &gb;
+		swg_hr(&g, SWG_HR_HOOK, "g2_hook");
+		g.in.sh = sh;
+		g.in.end = SWW_RAM_BASE + x->ram_bytes;
+		for (i = 0; i < SWG_IDX_N; i++) {
+			g.in.idx[i] = h->g2pa + h->g2plan.b[SWD_IDX_H2D_W + i].off;
+		}
+		for (i = 0; i < SWG_RM_N; i++) {
+			g.in.ring[i] = h->g2pa + h->g2plan.b[SWD_H2D_CTRL + i].off;
+		}
+		g.in.trap = h->g2pa + h->g2plan.b[SWD_TRAP].off;
+		g.in.scratch = h->g2pa + h->g2plan.b[SWD_SCRATCH].off;
+		g.in.blk = h->g2pa;
+		g.in.blk_len = h->g2plan.total;
+		g.in.evbuf = h->g2pa + h->g2plan.b[SWD_EVBUF].off;
+		g.in.respbuf = h->g2pa + h->g2plan.b[SWD_RESPBUF].off;
+		g.in.ioctbuf = h->g2pa + h->g2plan.b[SWD_IOCTBUF].off;
+		g.in.clm = h->g2clm;       /* L22c: set by sw_g2_clm_set only after the CRC32 check, NULL otherwise (the shim STOPs loudly at sweetwlan=24) */
+		g.in.clmlen = h->g2clmlen;
+		g.d4b = h->d4b;
+		g.jc = h->jc;           /* T-4a7f: the same table the list's L24 entries were built from (NULL until the credentials reader sets it) */
+		g.njc = h->njc;
+		h->l25arm = 0;
+		h->l25on = 0;
+		if (h->d4b >= 12) {     /* T-d84f (L25/L26): the DATA block, the cfg from the credentials, the RSNE hook and the store judge's layout BEFORE the L23 scan, one pure step (swl25g_wl_arm prints every missing input and takes the hook down again on any refusal; T-3784); disarmed below on the only exit of swg_go */
+			h->l25arm = swl25g_wl_arm(&g, &sw_l25g, &h->l25w, &h->g2plan, h->g2pa, &sw_cred, NULL, h->dpa, h->dlen, SW_G2_ALIAS_LO, SW_G2_ALIAS_HI, sw_l25w_rd, h) == 1;
+		}
+		h->g2x = &g;
+		rc = swg_go(&g);
+		h->g2x = NULL;
+		if (h->d4b >= 12) {
+			swl25g_disarm(&g, &sw_l25g);
+		}
+		h->l25arm = 0;
+		h->l25on = 0;
+		memset(&h->l25w, 0, sizeof h->l25w);
+		printf("SWEET WLAN: stack headroom min %u (samples %u)\n", g.hr_min, g.hr_n);
+		g.b = NULL;       /* gb dies with this frame */
+	}
+	if (h->cfg[SWW_CFG_WIN / 4] != w80 && (sw3_wr(h, SWW_CFG, 0, SWW_CFG_WIN, w80) != 0 || h->cfg[SWW_CFG_WIN / 4] != w80)) {
+		swl_gap("g2", "glue: BAR0 window not put back", "high");
+		printf("SWEET WLAN: G2 glue: BAR0 window %#x not put back to %#x\n", h->cfg[SWW_CFG_WIN / 4], w80);
+		rc = rc ? rc : -1;
+	}
+	h->g2 = 0;
+	if (refused) {
+		return rc;
+	}
+	if (g.d4dstop || g.d4dlv < 17u) { printf("SWEET WLAN: G2 RESULT %s rc=%d stores=%u mask %#x undo=%s d4d=%s\n", rc ? "STOPPED" : "done", rc, g.nstore, g.mask, g.restore ? "ok" : "FAILED", g.d4dstop ? "stopped" : "-"); } else { printf("SWEET WLAN: G2 RESULT %s rc=%d stores=%u mask %#x undo=%s d4d=%u\n", rc ? "STOPPED" : "done", rc, g.nstore, g.mask, g.restore ? "ok" : "FAILED", (unsigned)g.d4dlv); }     /* sprint 2026-11-08: the level as a number; the old 8-entry name table "17".."24" was read past its end at d4dlv 26 (kernel data abort, run join26a) */
+	return rc;
+}
