+/*
+ * W-D4b (xnu patch 0174, SPEC-WIFI W-D4b rows Q3/Q7, docs/research/W-D4b-first-post.md = R-D4b): two PURE helpers for the first ring-0 post. No device access, no cache op, no store;
+ * Called by swg_d4b (sweet_wlan_g2.h) at sweetwlan>=13 (the check) and 14 (the item); reviews 0174-w-d4b-hwwrite-r1 + r2 (conditions fixed). Host tested by tools/test_wlan_wr_mutants.py (--g2, list D4B_MUTANTS).
+ * Abbreviations as in R-D4b: M = dhd_msgbuf.c, MB = bcmmsgbuf.h (D5 = refs/wlan-stage5). W-D4d (sweetwlan 17..20, docs/research/W-D4d-ioctl-get-version.md = R-D4d): WD = wlioctl_defs.h.new (D5), the item builders swd4b_item_respbuf / swd4b_item_ioctl and the ring-2 parser swd4b_ioctl_d2h.
+ */
+#ifndef SWEET_WLAN_D4B_H
+#define SWEET_WLAN_D4B_H
+
+#include <stdint.h>
+#include <stddef.h>
+
+#define SWD4B_ITEM_LEN      40u     /* ioctl_resp_evt_buf_post_msg_t = H2DRING_CTRL_SUB_ITEMSIZE [src R-D4b s.1, MB:60, 410-420] */
+#define SWD4B_MSG_EVBUF     0x0Du   /* MSG_TYPE_EVENT_BUF_POST [src R-D4b s.1, MB:237; M:6319] */
+#define SWD4B_PHASE_FIRST   0x80u   /* flags of the first item of a fresh ring (BCMPCIE_CMNHDR_PHASE_BIT_INIT) [src R-D4b s.1 epoch/phase rule, MB:385; M:10778-10785, 11464] */
+#define SWD4B_D2H_LEN       24u     /* D2H ring-2 item size [src R-D4b s.3, MB:70] */
+#define SWD4B_MSG_H2D_MBDATA 0x23u  /* MSG_TYPE_H2D_MAILBOX_DATA [src bcmmsgbuf.h:259; W-D4c K1] */
+#define SWD4B_MSG_D2H_MBDATA 0x24u  /* MSG_TYPE_D2H_MAILBOX_DATA, ring-2 item 0 pre-written by the dongle [obs wlan-runG2-d4b13; layout bcmmsgbuf.h:900-907: u32 d2h_mailbox_data at byte 12] */
+#define SWD4B_D2H_DS_ENTER_REQ 0x2u /* D2H_DEV_DS_ENTER_REQ [src bcmpcie.h:511] */
+#define SWD4B_D2H_DS_EXIT_NOTE 0x4u /* D2H_DEV_DS_EXIT_NOTE [src bcmpcie.h:512 (D5 refs/wlan-stage5)] */
+#define SWD4B_H2D_DS_ACK    0x2u    /* H2D_HOST_DS_ACK [src bcmpcie.h:485; DHD acks DS_ENTER_REQ with it on the INB_DW path, dhd_pcie.c:12953-12968 (host_active_cnt 0 -> ack at once), as a ring-0 item dhd_pcie.c:12788-12803] */
+#define SWD4B_H2D_DS_DEAS   0x20u   /* H2DMB_DS_ACTIVE = H2DMB_DS_DEVICE_WAKE_DEASSERT [src bcmpcie.h:489, 505; sent on the EXIT_NOTE, dhd_pcie.c:12340-12345, 13036-13086] */
+#define SWD4B_H2D_DS_WAKE   0x40u   /* H2DMB_DS_DEVICE_WAKE = H2DMB_DS_DEVICE_WAKE_ASSERT [src bcmpcie.h:490, 504; dhd_pcie.c:12255-12313] */
+#define SWD4B_MSG_IOCTL_REQ 0x09u   /* MSG_TYPE_IOCTLPTR_REQ [src MB:233; M:10879 (D5)] */
+#define SWD4B_MSG_IOCTL_ACK 0x0Au   /* MSG_TYPE_IOCTLPTR_REQ_ACK [src MB:234] */
+#define SWD4B_MSG_RESPBUF   0x0Bu   /* MSG_TYPE_IOCTLRESP_BUF_POST [src MB:235; M:6319] */
+#define SWD4B_MSG_IOCTL_CMPLT 0x0Cu /* MSG_TYPE_IOCTL_CMPLT [src MB:236] */
+#define SWD4B_IOCTL_REQID   0xFFFEu /* request_id of every ioctl request: DHD_IOCTL_REQ_PKTID [src M:2279, 10882; the ack handler skips its pktid audit for it, M:7790-7794] */
+#define SWD4B_WLC_GET_VERSION 1u    /* [src WD:681] */
+#define SWD4B_WLC_UP        2u      /* [src WD:682] */
+#define SWD4B_WLC_SET_VAR   263u    /* [src WD:947] */
+#define SWD4B_MSG_WL_EVENT  0x0Eu   /* MSG_TYPE_WL_EVENT, ring-2 item 24 B wlevent_req_msg_t [src MB:238, 796-809] */
+#define SWD4B_WLC_GET_VAR   262u    /* [src WD:946] */
+#define SWD4B_E_EPOCH       1       /* swd4b_d2h_check: epoch byte != the expected one [src R-D4b s.3: M:1782, 1491-1535 via R108 s.1.3] */
+#define SWD4B_E_XOR         2       /* swd4b_d2h_check: XOR of the six u32 words != 0 [src R-D4b s.3, R108 s.1.3] */
+
+static void
+swd4b_put32(uint8_t *p, uint32_t v)
+{
+	p[0] = (uint8_t)v;
+	p[1] = (uint8_t)(v >> 8);
+	p[2] = (uint8_t)(v >> 16);
+	p[3] = (uint8_t)(v >> 24);
+}
+
+/* The 40 B event-buffer post, little endian, every byte not named below 0 (R-D4b s.1 table, M:6319-6388):
+ * +0 msg_type, +1 if_id 0 (M:6356), +2 flags (phase), +3 epoch (M:6357), +4 request_id (M:6355), +8 host_buf_len u16 (M:6383), +10..15 reserved 0 (MB:415),
+ * +16 buffer PA lo, +20 hi (M:6387-6388), +24..39 rsvd 0 (MB:419). The first item of a fresh ring has epoch 1 (254 % 253, MB:38-39; M:6357-6358) and phase 0x80: the caller passes the epoch. */
+static void
+swd4b_item_evbuf(uint8_t out[40], uint32_t request_id, uint16_t buf_len, uint64_t buf_pa, uint8_t epoch)
+{
+	unsigned i;
+
+	for (i = 0; i < SWD4B_ITEM_LEN; i++) {
+		out[i] = 0;
+	}
+	out[0] = SWD4B_MSG_EVBUF;
+	out[2] = SWD4B_PHASE_FIRST;
+	out[3] = epoch;
+	swd4b_put32(out + 4, request_id);
+	out[8] = (uint8_t)buf_len;
+	out[9] = (uint8_t)(buf_len >> 8);
+	swd4b_put32(out + 16, (uint32_t)buf_pa);
+	swd4b_put32(out + 20, (uint32_t)(buf_pa >> 32));
+}
+
+/* W-D4d: the 40 B ioctl-response buffer post (type 0xB), the same ioctl_resp_evt_buf_post_msg_t as the event post (MB:410-420, 423, R-D4d s.2.1), every byte not named 0:
+ * +0 msg_type 0x0B (M:6319), +1 if_id 0 (M:6356), +2 flags 0x80 (the ring's current_phase: init 0, it flips to 0x80 at the first allocation, which returns the ring base, and back only on a wrap: M:1822, 10776-10787), +3 epoch (the caller passes it: (254 + ring index) % 253, M:6357, MB:38-39),
+ * +4 request_id (M:6355, our own id of this buffer), +8 host_buf_len u16 (M:6383-6385), +10..15 reserved 0 (MB:416), +16 buffer PA lo, +20 hi (M:6387-6388), +24..39 rsvd 0 (MB:419). */
+static void
+swd4b_item_respbuf(uint8_t out[40], uint32_t request_id, uint16_t buf_len, uint64_t buf_pa, uint8_t epoch)
+{
+	unsigned i;
+
+	for (i = 0; i < SWD4B_ITEM_LEN; i++) {
+		out[i] = 0;
+	}
+	out[0] = SWD4B_MSG_RESPBUF;
+	out[2] = SWD4B_PHASE_FIRST;
+	out[3] = epoch;
+	swd4b_put32(out + 4, request_id);
+	out[8] = (uint8_t)buf_len;
+	out[9] = (uint8_t)(buf_len >> 8);
+	swd4b_put32(out + 16, (uint32_t)buf_pa);
+	swd4b_put32(out + 20, (uint32_t)(buf_pa >> 32));
+}
+
+/* W-D4d: the 40 B ioctl request (type 0x09, ioctl_req_msg_t MB:390-407, R-D4d s.2.2; M:10879-10895), every byte not named 0:
+ * +0 msg_type 0x09, +1 if_id 0 (M:10880), +2 flags 0x80 (current_phase, as above, M:10881), +3 epoch (the caller passes it, M:10883-10884), +4 request_id 0xFFFE (M:10882), +8 cmd u32 (M:10886), +12 trans_id u16 (M:10889-10890),
+ * +14 input_buf_len u16 (M:10893), +16 output_buf_len u16 (M:10888), +18..23 rsvd 0 (MB:401), +24 payload buffer PA lo, +28 hi (M:10894-10895), +32..39 rsvd1 0 (MB:406). */
+static void
+swd4b_item_ioctl(uint8_t out[40], uint32_t cmd, uint16_t trans_id, uint16_t in_len, uint16_t out_len, uint64_t pa, uint8_t epoch)
+{
+	unsigned i;
+
+	for (i = 0; i < SWD4B_ITEM_LEN; i++) {
+		out[i] = 0;
+	}
+	out[0] = SWD4B_MSG_IOCTL_REQ;
+	out[2] = SWD4B_PHASE_FIRST;
+	out[3] = epoch;
+	swd4b_put32(out + 4, SWD4B_IOCTL_REQID);
+	swd4b_put32(out + 8, cmd);
+	out[12] = (uint8_t)trans_id;
+	out[13] = (uint8_t)(trans_id >> 8);
+	out[14] = (uint8_t)in_len;
+	out[15] = (uint8_t)(in_len >> 8);
+	out[16] = (uint8_t)out_len;
+	out[17] = (uint8_t)(out_len >> 8);
+	swd4b_put32(out + 24, (uint32_t)pa);
+	swd4b_put32(out + 28, (uint32_t)(pa >> 32));
+}
+
+static uint32_t
+swd4b_get32(const uint8_t *p)
+{
+	return (uint32_t)p[0] | ((uint32_t)p[1] << 8) | ((uint32_t)p[2] << 16) | ((uint32_t)p[3] << 24);
+}
+
+/* W-D4d: the fields of a D2H ioctl ack (type 0x0A, ioctl_req_ack_msg_t MB:785-793) or completion (type 0x0C, ioctl_comp_resp_msg_t MB:767-780), R-D4d s.2.3/2.4. cmn_msg_hdr +0 type, +3 epoch, +4 request_id (MB:181-192);
+ * compl_msg_hdr +8 status int16, +10 ring_id u16 (MB:676-686, 738-741). Ack: +12 cmd u32, +16 rsvd, +20 marker. Completion: +12 resp_len u16, +14 trans_id u16, +16 cmd u32, +20 marker. Fields the type does not have stay 0.
+ * Returns 0 for type 0x0A or 0x0C, -1 for any other type (only type, epoch and request_id are filled). The epoch/XOR sync check is swd4b_d2h_check(), the caller's. */
+struct swd4b_ioctl_d2h {
+	uint8_t type, epoch;
+	int16_t status;
+	uint16_t ring_id, resp_len, trans_id;
+	uint32_t request_id, cmd;
+};
+
+static int
+swd4b_ioctl_d2h(const uint8_t in[24], struct swd4b_ioctl_d2h *o)
+{
+	o->type = in[0];
+	o->epoch = in[3];
+	o->request_id = swd4b_get32(in + 4);
+	o->status = 0;
+	o->ring_id = 0;
+	o->resp_len = 0;
+	o->trans_id = 0;
+	o->cmd = 0;
+	if (in[0] != SWD4B_MSG_IOCTL_ACK && in[0] != SWD4B_MSG_IOCTL_CMPLT) {
+		return -1;
+	}
+	o->status = (int16_t)((uint16_t)in[8] | ((uint16_t)in[9] << 8));
+	o->ring_id = (uint16_t)((uint16_t)in[10] | ((uint16_t)in[11] << 8));
+	if (in[0] == SWD4B_MSG_IOCTL_ACK) {
+		o->cmd = swd4b_get32(in + 12);
+	} else {
+		o->resp_len = (uint16_t)((uint16_t)in[12] | ((uint16_t)in[13] << 8));
+		o->trans_id = (uint16_t)((uint16_t)in[14] | ((uint16_t)in[15] << 8));
+		o->cmd = swd4b_get32(in + 16);
+	}
+	return 0;
+}
+
+/* W-D4c: the 40 B h2d_mailbox_data_t (bcmmsgbuf.h:626-630) DHD posts on ring 0 to answer a D2H mailbox request, little endian, every byte not named 0 (dhd_msgbuf.c:12395-12415):
+ * +0 msg_type 0x23 (bcmmsgbuf.h:259), +1 if_id 0, +2 flags 0x80 (phase: it flips only at the ring base, dhd_msgbuf.c:10776-10787), +3 epoch (the caller passes it), +4 request_id 0, +8 mb_data (u32). */
+static void
+swd4b_item_mbdata(uint8_t out[40], uint32_t mb_data, uint8_t epoch)
+{
+	unsigned i;
+
+	for (i = 0; i < SWD4B_ITEM_LEN; i++) {
+		out[i] = 0;
+	}
+	out[0] = SWD4B_MSG_H2D_MBDATA;
+	out[2] = SWD4B_PHASE_FIRST;
+	out[3] = epoch;
+	swd4b_put32(out + 8, mb_data);
+}
+
+/* A D2H item is accepted only if its epoch matches (first expected 1, then +1 mod 253) and the XOR of all its u32 words is 0 (XORCSUM sync, flags 0x40000) [src R-D4b s.3, R108 s.1.3].
+ * The epoch byte sits at +3 of cmn_msg_hdr (the 8 B header common to H2D and D2H, R-D4b s.1 table, M:6357) [src; D2H use read from R-D4b s.3 text, not from a D2H struct decompile: guess]. *type_out = msg_type (+0)
+ * whatever the result (it is logged, never dropped: R-D4b s.3). Returns 0 ok, SWD4B_E_EPOCH, SWD4B_E_XOR. */
+static int
+swd4b_d2h_check(const uint8_t in[24], uint8_t want_epoch, uint8_t *type_out)
+{
+	uint32_t x = 0;
+	unsigned i;
+
+	for (i = 0; i < SWD4B_D2H_LEN; i += 4) {
+		x ^= (uint32_t)in[i] | ((uint32_t)in[i + 1] << 8) | ((uint32_t)in[i + 2] << 16) | ((uint32_t)in[i + 3] << 24);
+	}
+	if (type_out != NULL) {
+		*type_out = in[0];
+	}
+	if (in[3] != want_epoch) {
+		return SWD4B_E_EPOCH;
+	}
+	if (x != 0u) {
+		return SWD4B_E_XOR;
+	}
+	return 0;
+}
+
+#endif /* SWEET_WLAN_D4B_H */
diff --git a/bsd/dev/sweet_wlan_g2e.h b/bsd/dev/sweet_wlan_g2e.h
new file mode 100644
index 00000000..01540483
--- /dev/null
+++ b/bsd/dev/sweet_wlan_g2e.h
@@ -0,0 +1,306 @@
+/* L21: the 7 further response buffers (ids 5..11, slots 1..7) and 7 further event buffers (ids 0x21..0x27, slots 1..7), then ONE read-only watch of ring 2: events are consumed (their re-post waits), anything else is a soft stop */
+static int
+swg_e_l21(struct swg_wx *x)
+{
+	struct swg_eio io;
+	uint32_t j, w = 0, waited = 0, e = 0, r0 = x->d4rd;
+	int ex;
+
+	memset(&io, 0, sizeof io);
+	swl_gap("scan", "8 event buffers posted (DHD posts 32)", "low");
+	for (j = 1; j < SWG_E_RID_BUFS; j++) {
+		ex = swg_e_post_resp(x, SWG_D4D_RID0 + 2u + j, j);
+		if (ex != 0) {
+			return ex;
+		}
+	}
+	for (j = 1; j < SWG_E_EV_BUFS; j++) {
+		ex = swg_e_post_ev(x, j, j);
+		if (ex != 0) {
+			return ex;
+		}
+	}
+	x->evp = SWG_E_EV_BUFS;
+	ex = swg_d4d_wait(x, 0u, &w, &waited);
+	if (ex != 0) {
+		return ex;
+	}
+	if (w < x->d4rd) {
+		SWG_E_STOP(x, "d2h write index %u went below the read count %u", w, x->d4rd);
+		return 0;
+	}
+	if (w > x->d4rd) {
+		ex = swg_e_items(x, w, &io, NULL, &e);
+		if (ex != 0 || x->d4dstop) {
+			return ex;
+		}
+		if (e > x->d4rd) {
+			ex = swg_d4d_consume(x, x->d4rd, e);
+			if (ex != 0) {
+				return ex;
+			}
+		}
+	}
+	printf("SWEET WLAN: L21 posted 7 respbuf + 7 evbuf, ring-0 WR %u, ring-2 new items %u\n", x->d4wr, x->d4rd - r0);
+	return 0;
+}
+
+/* the answer bytes of the L22 GET_VAR: 6 B scan_ver, 4 B sup_wpa, 30 B event_msgs_ext */
+#define SWG_E_RSPMAX 48u
+
+static int swg_e_l22c(struct swg_wx *x);
+
+static int
+swg_e_l22(struct swg_wx *x, int clm)
+{
+	static const char *const nm[3] = { "scan_ver", "sup_wpa", "event_msgs_ext" };
+	uint8_t rsp[SWG_E_RSPMAX], arg[30];
+	struct swd4b_ioctl_d2h cm;
+	int ex;
+	uint32_t mj;
+	uint32_t i;
+
+	memset(rsp, 0, sizeof rsp);
+	/* scan_ver: GET_VAR, in = out = name + 1 + 6 (wl_scan_version_t: u16 version, u16 length, u16 scan_ver_major) [src WI:18425-18431; length rule BW bwfm.c:1815-1828] */
+	ex = swg_e_call(x, SWD4B_WLC_GET_VAR, "WLC_GET_VAR scan_ver", nm[0], NULL, 6u, 9u + 6u, 0, 6u, rsp, 1, &cm, NULL);
+	if (ex != 0 || x->d4dstop) {
+		return ex;
+	}
+	if (cm.resp_len < 6u) {
+		SWG_E_STOP(x, "scan_ver answer is %u B, not 6", cm.resp_len);
+		return 0;
+	}
+	mj = swg_e_le16(rsp + 4);       /* review 0174-w-d4e-scan24-l21-hwwrite-r1 finding 3: the whole 16 bits are checked, not narrowed to a byte first (0x0102 is not 2) */
+	printf("SWEET WLAN: L22 scan_ver version %u length %u major %u\n", swg_e_le16(rsp), swg_e_le16(rsp + 2), mj);
+	if (mj != 2u && mj != 3u) {
+		SWG_E_STOP(x, "scan_ver major %u is not 2 or 3, no escan", mj);
+		return 0;
+	}
+	x->emajor = (uint8_t)mj;
+	/* sup_wpa: a read-only probe (W-D5 s.4): a non-zero status is recorded */
+	memset(rsp, 0, sizeof rsp);
+	ex = swg_e_call(x, SWD4B_WLC_GET_VAR, "WLC_GET_VAR sup_wpa", nm[1], NULL, 4u, 8u + 4u, 1, 4u, rsp, 1, &cm, NULL);
+	if (ex != 0 || x->d4dstop) {
+		return ex;
+	}
+	printf("SWEET WLAN: L22 sup_wpa get: status %d value %d\n", (int)cm.status, cm.resp_len >= 4u ? (int)swd4b_get32(rsp) : 0);
+	if (cm.status != 0 || cm.resp_len < 4u) {
+		swl_gap("scan", "sup_wpa get status non-zero or answer short", "medium");
+	}
+	/* event_msgs_ext GET: ver 1, len 26 [src LX:12708-12722 (msglen, bzero, eventmask_msg->ver / ->len = ROUNDUP(WLC_E_LAST 207, 8) / 8 = 26, the dhd_iovar GET); BE:319]: in = out = name 15 + 4 + 26 */
+	memset(arg, 0, sizeof arg);
+	arg[0] = 1u;
+	arg[2] = 26u;
+	memset(rsp, 0, sizeof rsp);
+	ex = swg_e_call(x, SWD4B_WLC_GET_VAR, "WLC_GET_VAR event_msgs_ext", nm[2], arg, 30u, 15u + 30u, 0, 30u, rsp, 1, &cm, NULL);
+	if (ex != 0 || x->d4dstop) {
+		return ex;
+	}
+	if (cm.resp_len < 30u || rsp[2] != 26u) {
+		SWG_E_STOP(x, "event_msgs_ext answer %u B len %u, expected 30 B len 26", cm.resp_len, rsp[2]);
+		return 0;
+	}
+	printf("SWEET WLAN: L22 event_msgs_ext get: len %u status %d\n", rsp[2], (int)cm.status);
+	{
+		char line[2u * 26u + 1u];
+
+		for (i = 0; i < 26u; i++) {
+			snprintf(line + 2u * i, 3u, "%02x", rsp[4u + i]);
+		}
+		printf("SWEET WLAN: L22 event_msgs_ext mask (default, ver %u command %u) %s\n", rsp[0], rsp[1], line);
+	}
+	/* event_msgs_ext SET: command 3 (EVENTMSGS_SET_MASK) with ONLY bit 69 (WLC_E_ESCAN_RESULT) set [src WI:9665-9670 (command enum, SET_MASK 3 at 9669), 9672 (EVENTMSGS_VER 1), 9679-9686 (struct: ver, command, len, maxgetsize, mask at +4), BE:180; setbit: byte 69 / 8 = 8, bit 69 % 8 = 5] */
+	memset(arg, 0, sizeof arg);
+	arg[0] = 1u;
+	arg[1] = 3u;
+	arg[2] = 26u;
+	arg[4u + SWG_E_EV_ESCAN / 8u] = (uint8_t)(1u << (SWG_E_EV_ESCAN % 8u));
+	ex = swg_e_call(x, SWD4B_WLC_SET_VAR, "WLC_SET_VAR event_msgs_ext", nm[2], arg, 30u, 15u + 30u, 0, 0u, NULL, 1, &cm, NULL);
+	if (ex != 0 || x->d4dstop) {
+		return ex;
+	}
+	printf("SWEET WLAN: L22 event_msgs_ext set: bit 69 on, status %d\n", (int)cm.status);
+	if (clm) {      /* L22c (sweetwlan=24): the CLM and the country while the radio is still down, then WLC_UP [src 108 s.9.4: stock preinit order clmload -> country, no UP before them] */
+		ex = swg_e_l22c(x);
+		if (ex != 0 || x->d4dstop) {
+			return ex;
+		}
+	}
+	/* WLC_UP: cmd 2, no payload, length 0 [src LX:10622 dhd_wl_ioctl_cmd(dhd, WLC_UP, NULL, 0, TRUE, 0); BW bwfm.c:554 sends an int, the Android driver is the closer reference] */
+	ex = swg_e_call(x, SWD4B_WLC_UP, "WLC_UP", NULL, NULL, 0u, 0u, 0, 0u, NULL, 1, &cm, NULL);
+	if (ex != 0 || x->d4dstop) {
+		return ex;
+	}
+	printf("SWEET WLAN: L22 WLC_UP status %d\n", (int)cm.status);
+	return 0;
+}
+
+/* L22c (sweetwlan=24, T-0f36; layout and order 108 s.9): the packed CLM blob as clmload chunks, then clmload_status, then country XZ, all inside L22 before its WLC_UP. Each request is SET_VAR/GET_VAR through swg_e_call (soft: a non-zero completion status is judged here).
+ * clmload chunk = name "clmload" NUL (8 B) + wl_dload_data { u16 flag = 0x1000 | DL_BEGIN 2 (first) | DL_END 4 (last), u16 dload_type 2 (CLM), u32 len, u32 crc 0, data[len] } with len 1400 for all but the last [src 108 s.9.1: WI:719-750, LC common.c:108-129, BW bwfm.c:3161-3175].
+ * Every refusal is a WIFI GAP and a soft stop (SWG_E_STOP): a missing blob, more than SWG_E_CLMMAX chunks, a chunk whose completion status is non-zero (its status comes from its own completion; clmload_status is read only after the last chunk, the glue list has no request after a refused one), clmload_status non-zero or short, country refused. 0 = done or soft stop; negative = stopped */
+static int
+swg_e_l22c(struct swg_wx *x)
+{
+	static const uint8_t xz[12] = { 'X', 'Z', 0, 0, 0, 0, 0, 0, 'X', 'Z', 0, 0 };    /* wl_country_t: country_abbrev "XZ", rev 0, ccode "XZ" [src 108 s.9.3: WI:1817-1830, S1 bcm4389-dhd_linux.c:12278-12290; rev 0 is U-CL2] */
+	static uint8_t ch[12u + SWG_E_CLMCHUNK];  /* static, not on the kernel stack (review T-4adb-hwwrite-r1 C2): G2 is single-threaded and runs once per boot (sw_hw is static for the same reason) */
+	uint8_t rsp[4];
+	struct swd4b_ioctl_d2h cm;
+	uint32_t n, nch, len, flag, st;
+	int ex;
+
+	if (x->in.clm == NULL || x->in.clmlen == 0u) {
+		SWG_E_STOP(x, "no CLM blob (absent or failed the glue CRC)");
+		return 0;
+	}
+	if (x->in.clmlen > SWG_E_CLMMAX * SWG_E_CLMCHUNK) {       /* before the division: a length near 2^32 must not wrap nch to 0 */
+		SWG_E_STOP(x, "CLM blob %u B is more than %u chunks", x->in.clmlen, SWG_E_CLMMAX);
+		return 0;
+	}
+	nch = (x->in.clmlen + SWG_E_CLMCHUNK - 1u) / SWG_E_CLMCHUNK;
+	for (n = 0; n < nch; n++) {
+		len = x->in.clmlen - n * SWG_E_CLMCHUNK < SWG_E_CLMCHUNK ? x->in.clmlen - n * SWG_E_CLMCHUNK : SWG_E_CLMCHUNK;
+		flag = 0x1000u | (n == 0u ? 0x2u : 0u) | (n == nch - 1u ? 0x4u : 0u);
+		memset(ch, 0, sizeof ch);
+		ch[0] = (uint8_t)flag;
+		ch[1] = (uint8_t)(flag >> 8);
+		ch[2] = 2u;                             /* DL_TYPE_CLM */
+		swd4b_put32(ch + 4, len);
+		memcpy(ch + 12, x->in.clm + n * SWG_E_CLMCHUNK, len);     /* crc (ch + 8) stays 0: DL_CRC_NOT_INUSE is not set by LC or BW */
+		ex = swg_e_call(x, SWD4B_WLC_SET_VAR, "WLC_SET_VAR clmload", "clmload", ch, 12u + len, 8u + 12u + len, 1, 0u, NULL, 1, &cm, NULL);
+		if (ex != 0 || x->d4dstop) {
+			return ex;
+		}
+		printf("SWEET WLAN: L22c clmload chunk %u of %u: flag %#x len %u, status %d\n", n + 1u, nch, flag, len, (int)cm.status);
+		if (cm.status != 0) {
