+	unsigned k;
+
+	for (k = 0; k < 10u; k++) {
+		last = sw_g2_add(h, SW3_HOST, 0, h->g2plan.b[SWD_H2D_CTRL].off + itm * SW_G2_D4C_ISZ + 4u * k, k == 0u ? w0 : k == 2u ? mb : 0u, 0xFFFFFFFFu, 0, 0xFFFFFFFFu, 1, last);
+		if (last < 0) {
+			return -1;
+		}
+	}
+	last = sw_g2_add(h, SW3_HOST, 0, h->g2plan.b[SWD_IDX_H2D_W].off, idx, 0x0000FFFFu, idx - 1u, 0xFFFFFFFFu, 1, last);
+	if (last < 0) {
+		return -1;
+	}
+	return sw_g2_add(h, SWW_BAR0, SWW_WIN_PCIE, 0x140u, db, 0xFFFFFFFFu, 0, 0, 1, last);
+}
+
+/* W-D4c: the D2H-RD slot of ring 2 low half := idx (old idx - 1, upper kept) and doorbell 0 := db, chained after `last` */
+static int
+sw_g2_d4c_rd(struct sw_hw *h, uint32_t idx, uint32_t db, int last)
+{
+	last = sw_g2_add(h, SW3_HOST, 0, h->g2plan.b[SWD_IDX_D2H_R].off, idx, 0x0000FFFFu, idx - 1u, 0xFFFFFFFFu, 1, last);
+	if (last < 0) {
+		return -1;
+	}
+	return sw_g2_add(h, SWW_BAR0, SWW_WIN_PCIE, 0x140u, db, 0xFFFFFFFFu, 0, 0, 1, last);
+}
+
+/* W-D4d (sweetwlan=17..20, docs/research/W-D4d-ioctl-get-version.md = R-D4d), the glue's own copy of the constants (R107 #5); M = dhd_msgbuf.c, MB = bcmmsgbuf.h of refs/wlan-stage5. Every item word is restated here from the layout tables (R-D4d s.2.1, 2.2), not taken from the header's builders. */
+#define SW_G2_D4D_ISZ     40u           /* ring-0 item size (MB:60) */
+#define SW_G2_D4D_DB_WR   0xFF000000u   /* doorbell 0 after a ring-0 write-index update: | wr (M:116) */
+#define SW_G2_D4D_DB_RD   0xDD020000u   /* doorbell 0 after a ring-2 read-index update: | rd (M:114, 7524-7532) */
+#define SW_G2_D4D_W0_RESP 0x0080000Bu   /* word 0 without the epoch: msg_type 0x0B | if_id 0 | flags 0x80 << 16 (M:6319, 6356, 6359; the phase flips to 0x80 at the first allocation, M:10776-10787) */
+#define SW_G2_D4D_W0_REQ  0x00800009u   /* msg_type 0x09 (MB:233, M:10879) | flags 0x80 */
+#define SW_G2_D4D_BUFLEN  0x2000u       /* host_buf_len 8192 (M:149, 6383-6385) */
+#define SW_G2_D4D_REQID   0xFFFEu       /* DHD_IOCTL_REQ_PKTID (M:2279) */
+#define SW_G2_D4D_CAP_W0  0x00706163u   /* "cap\0" little endian (LX:10861) */
+
+/* the ten words of a response-buffer post: id, the buffer PA, ring-0 index idx */
+static void
+sw_g2_d4d_resp(uint32_t w[10], uint32_t id, uint64_t pa, uint32_t idx)
+{
+	unsigned k;
+
+	for (k = 0; k < 10u; k++) {
+		w[k] = 0;
+	}
+	w[0] = SW_G2_D4D_W0_RESP | SW_G2_D4D_EP(idx);
+	w[1] = id;
+	w[2] = SW_G2_D4D_BUFLEN;
+	w[4] = (uint32_t)pa;
+	w[5] = (uint32_t)(pa >> 32);
+}
+
+/* the ten words of an ioctl request: cmd, trans_id, the in = out length, the payload PA, ring-0 index idx (MB:390-407, M:10879-10895) */
+static void
+sw_g2_d4d_req(uint32_t w[10], uint32_t cmd, uint32_t trans, uint32_t len, uint64_t pa, uint32_t idx)
+{
+	unsigned k;
+
+	for (k = 0; k < 10u; k++) {
+		w[k] = 0;
+	}
+	w[0] = SW_G2_D4D_W0_REQ | SW_G2_D4D_EP(idx);
+	w[1] = SW_G2_D4D_REQID;
+	w[2] = cmd;
+	w[3] = trans | len << 16;
+	w[4] = len;
+	w[6] = (uint32_t)pa;
+	w[7] = (uint32_t)(pa >> 32);
+}
+
+/* the entries of one ring-0 post at index idx: the ten words (each old 0), the H2D-WR slot low half idx -> idx + 1 (upper half kept), doorbell 0 := 0xFF000000 | (idx + 1); chained after `last`; the doorbell's index, -1 if refused */
+static int
+sw_g2_d4d_post(struct sw_hw *h, uint32_t idx, const uint32_t w[10], int last)
+{
+	unsigned k;
+
+	for (k = 0; k < 10u; k++) {
+		last = sw_g2_add(h, SW3_HOST, 0, h->g2plan.b[SWD_H2D_CTRL].off + idx * SW_G2_D4D_ISZ + 4u * k, w[k], 0xFFFFFFFFu, 0, 0xFFFFFFFFu, 1, last);
+		if (last < 0) {
+			return -1;
+		}
+		h->g2l[last].kind = k == 0u ? SW_G2K_SH_ITEM0 : SW_G2K_SH_ITEM;      /* 22b: moves with the DS-round items posted before it */
+	}
+	last = sw_g2_add(h, SW3_HOST, 0, h->g2plan.b[SWD_IDX_H2D_W].off, idx + 1u, 0x0000FFFFu, idx, 0xFFFFFFFFu, 1, last);
+	if (last < 0) {
+		return -1;
+	}
+	h->g2l[last].kind = SW_G2K_SH_WR;
+	last = sw_g2_add(h, SWW_BAR0, SWW_WIN_PCIE, 0x140u, SW_G2_D4D_DB_WR | (idx + 1u), 0xFFFFFFFFu, 0, 0, 1, last);
+	if (last >= 0) {
+		h->g2l[last].kind = SW_G2K_SH_DB;
+	}
+	return last;
+}
+
+/* 22b: the masked, repeatable entries of the DS rounds after the L16 one (sweetwlan >= 17), bound to the ring bases, built LAST so an exact entry matches first: every ring-0 item word of a round (word 0 = 0x23 | flags 0x80 with the epoch of its own index,
+ * word 2 = mb data 0x2 / 0x40 / 0x20 [bcmpcie.h:485, 489, 490], the other words 0; each old 0) at off + i * 40 for i < 127, the H2D-WR slot (old -> old + 1 below 128; the glue counts it in g2sh), doorbell 0 = 0xFF000000 | the slot, the D2H-RD slot (below 64) and
+ * doorbell 0 = 0xDD020000 | the slot. Ring-2 reads are host-only. Every entry is chained after `need` (the L16 C2 doorbell entry, review F2). 0 = built, -1 = list full */
+static int
+sw_g2_ds(struct sw_hw *h, int need)
+{
+	static const uint32_t mb[3] = { 0x2u, 0x40u, 0x20u };
+	unsigned k;
+	int r;
+
+	for (k = 0; k < 10u; k++) {
+		if (k == 2u) {
+			for (r = 0; r < 3; r++) {
+				if (sw_g2_add(h, SW3_HOST, 0, h->g2plan.b[SWD_H2D_CTRL].off + 4u * k, mb[r], 0xFFFFFFFFu, 0, 0xFFFFFFFFu, 0, need) < 0) {
+					return -1;
+				}
+				h->g2l[h->g2n - 1u].kind = SW_G2K_R_ITEM;
+				h->g2l[h->g2n - 1u].rep = SW_G2_R0_ITEMS - 1u;
+				h->g2l[h->g2n - 1u].stride = SW_G2_D4D_ISZ;
+			}
+			continue;
+		}
+		if (sw_g2_add(h, SW3_HOST, 0, h->g2plan.b[SWD_H2D_CTRL].off + 4u * k, k == 0u ? 0x00800023u : 0u, 0xFFFFFFFFu, 0, 0xFFFFFFFFu, 0, need) < 0) {
+			return -1;
+		}
+		h->g2l[h->g2n - 1u].kind = k == 0u ? SW_G2K_R_ITEM0 : SW_G2K_R_ITEM;
+		h->g2l[h->g2n - 1u].rep = SW_G2_R0_ITEMS - 1u;
+		h->g2l[h->g2n - 1u].stride = SW_G2_D4D_ISZ;
+	}
+	if (sw_g2_add(h, SW3_HOST, 0, h->g2plan.b[SWD_IDX_H2D_W].off, 0u, 0x0000FFFFu, 0u, 0u, 0, need) < 0) {
+		return -1;
+	}
+	h->g2l[h->g2n - 1u].kind = SW_G2K_R_WR;
+	if (sw_g2_add(h, SWW_BAR0, SWW_WIN_PCIE, 0x140u, SW_G2_D4D_DB_WR, 0xFFFFFFFFu, 0, 0, 0, need) < 0) {
+		return -1;
+	}
+	h->g2l[h->g2n - 1u].kind = SW_G2K_R_WDB;
+	if (sw_g2_add(h, SW3_HOST, 0, h->g2plan.b[SWD_IDX_D2H_R].off, 0u, 0x0000FFFFu, 0u, 0u, 0, need) < 0) {
+		return -1;
+	}
+	h->g2l[h->g2n - 1u].kind = SW_G2K_R_RD;
+	h->g2l[h->g2n - 1u].vrng = SW_G2_R2_ITEMS - 1u;
+	if (sw_g2_add(h, SWW_BAR0, SWW_WIN_PCIE, 0x140u, SW_G2_D4D_DB_RD, 0xFFFFFFFFu, 0, 0, 0, need) < 0) {
+		return -1;
+	}
+	h->g2l[h->g2n - 1u].kind = SW_G2K_R_RDB;
+	return 0;
+}
+
+/* W-D4d: the 12 + 12 + 14 + 27 entries of the levels 17..20 in the header's store order, chained after `last` (the W-D4c C2 doorbell). 17: response buffer id 2 at ring-0 index 4. 18: WLC_GET_VERSION (cmd 1, trans_id 0x101, length 4) at index 5.
+ * 19: ring-2 read index 2 -> 4, response buffer id 3 at index 6. 20: payload "cap\0", GET_VAR (cmd 262, trans_id 0x102, length 1023) at index 7, read index 4 -> 6, response buffer id 4 at index 8. The last entry's index (W-D4e chains after it), -1 = a row refused */
+static int
+sw_g2_d4d(struct sw_hw *h, int last)
+{
+	uint64_t rpa = h->g2pa + h->g2plan.b[SWD_RESPBUF].off, ipa = h->g2pa + h->g2plan.b[SWD_IOCTBUF].off;
+	uint32_t w[10];
+
+	sw_g2_d4d_resp(w, 2u, rpa, 4u);
+	last = sw_g2_d4d_post(h, 4u, w, last);
+	if (h->d4b >= 5 && last >= 0) {
+		sw_g2_d4d_req(w, 1u, 0x101u, 4u, ipa, 5u);
+		last = sw_g2_d4d_post(h, 5u, w, last);
+	}
+	if (h->d4b >= 6 && last >= 0) {
+		sw_g2_d4d_resp(w, 3u, rpa, 6u);      /* 22b: the ring-2 read index updates are the masked entries of sw_g2_ds (the index moves with the DS rounds) */
+		last = sw_g2_d4d_post(h, 6u, w, last);
+	}
+	if (h->d4b >= 7 && last >= 0) {
+		last = sw_g2_add(h, SW3_HOST, 0, h->g2plan.b[SWD_IOCTBUF].off, SW_G2_D4D_CAP_W0, 0xFFFFFFFFu, 0, 0xFFFFFFFFu, 1, last);
+		sw_g2_d4d_req(w, 262u, 0x102u, 1023u, ipa, 7u);
+		last = last < 0 ? -1 : sw_g2_d4d_post(h, 7u, w, last);
+		sw_g2_d4d_resp(w, 4u, rpa, 8u);
+		last = last < 0 ? -1 : sw_g2_d4d_post(h, 8u, w, last);
+	}
+	return last < 0 ? -1 : last;
+}
+
+/* W-D4e (sweetwlan=21..23), docs/research/W-D4e-scan24-design.md: the glue's own restatement of the L21..L23 stores (R107 #5), from its own constants. Ring-0 index ix counts the items of the fixed sequence (L20 ended at 9); every
+ * item word is an exact entry of kind SH_* (it moves with the DS-round items posted before it, g2sh); a payload word is an exact entry in the payload buffer (old = the word the host stored before, `sh` is the glue's own shadow). Only the
+ * escan version words (2 or 3 per scan_ver, known only at run time) are kind SW_G2K_VER. The ring-2 read index entries are the masked ones of sw_g2_ds. */
+#define SW_G2_E_W0_EV     0x0080000Du   /* event buffer post: msg_type 0x0D (MB:237) | flags 0x80 */
+#define SW_G2_E_EVID      0x20u         /* request_id of event post n >= 1 = 0x20 + n (post 0 is L14's id 1) */
+#define SW_G2_E_RE0       12u           /* request_id of the first L22 response re-post */
+#define SW_G2_E_TRANS     0x103u        /* transaction id of the first L22 request */
+_Static_assert(4u * SW_G2_E_PAYW >= 8u + 12u + SW_G2_CLMCHUNK, "the payload shadow holds the longest payload, a 1420 B clmload chunk");
+#define SW_G2_E_GET       262u          /* WLC_GET_VAR (WD:946) */
+#define SW_G2_E_SET       263u          /* WLC_SET_VAR (WD:947) */
+#define SW_G2_E_UP        2u            /* WLC_UP (WD:682) */
+_Static_assert(SW_G2_E_RE0 + 4u + 2u + SW_G2_CLMMAX < SW_G2_E_EVID, "the response re-post ids of up to 12 + 6 requests stay below the event buffer ids");
+
+/* an event buffer post (type 0x0D, the layout of the response post, MB:410-420) */
+static void
+sw_g2_d4e_ev(uint32_t w[10], uint32_t id, uint64_t pa, uint32_t idx)
+{
+	sw_g2_d4d_resp(w, id, pa, idx);
+	w[0] = SW_G2_E_W0_EV | SW_G2_D4D_EP(idx);
+}
+
+/* T-4a7f: the event re-post n = g2ev after the escan request at ring-0 index i: id 0x28 + n (header swg_e_post_ev with evp = 8 + n), word 4 = the slot-0 buffer address (the match allows any of the 8 buffers, sw_g2_evw_ok / entry stride + vrng) */
+static void
+sw_g2_e_evexp(const struct sw_hw *h, uint32_t w[10], uint32_t i)
+{
+	sw_g2_d4e_ev(w, SW_G2_E_EVID + 8u + h->g2ev, h->g2pa + h->g2plan.b[SWD_EVBUF].off + 0u, i);
+}
+
+/* the payload entries of one request: `name` NUL, then n - strlen - 1 bytes of arg (zeros if arg is NULL), zero filled to n bytes, as words; an entry for each word that differs from the shadow; the words in verw (bit i = word i) are kind VER. Chained after `last` */
+/* review l21 finding 8 (INFO): the glue shadow sh[] keeps escan version word 1 as 0x0002006E while the header may store 0x0003006E after a v3 scan_ver; harmless (layouts identical, the two VER entries are independent and escan is the last payload), but a later level that stores word 1 or 3 again must rebuild sh[] from the version actually stored (read it back from host memory) */
+static int
+sw_g2_e_pay(struct sw_hw *h, uint32_t sh[SW_G2_E_PAYW], const char *name, const uint8_t *arg, uint32_t n, uint32_t verw, int last)
+{
+	uint8_t b[4u * SW_G2_E_PAYW];
+	uint32_t i, nl = 0, v;
+
+	for (i = 0; i < sizeof b; i++) {
+		b[i] = 0;
+	}
+	while (name[nl] != '\0') {
+		b[nl] = (uint8_t)name[nl];
+		nl++;
+	}
+	for (i = 0; arg != NULL && nl + 1u + i < n; i++) {
+		b[nl + 1u + i] = arg[i];
+	}
+	for (i = 0; i < (n + 3u) / 4u; i++) {
+		v = (uint32_t)b[4u * i] | ((uint32_t)b[4u * i + 1u] << 8) | ((uint32_t)b[4u * i + 2u] << 16) | ((uint32_t)b[4u * i + 3u] << 24);
+		if (v == sh[i]) {
+			continue;
+		}
+		last = sw_g2_add(h, SW3_HOST, 0, h->g2plan.b[SWD_IOCTBUF].off + 4u * i, v, 0xFFFFFFFFu, sh[i], 0xFFFFFFFFu, 1, last);
+		if (last < 0) {
+			return -1;
+		}
+		if ((verw >> i) & 1u) {
+			h->g2l[last].kind = SW_G2K_VER;
+		}
+		sh[i] = v;
+	}
+	return last;
+}
+
+/* L22c: the CRC of the container's CLM entry is checked again here, by the glue's own swf_crc32, before any chunk entry exists; 1 = h->g2clm / g2clmlen are set. A blob that is absent, empty, more than SW_G2_CLMMAX chunks or fails the CRC leaves
+ * them NULL / 0: the list then has no clmload requests, every chunk store is refused, and the shim STOPs at its L22c entry (g.in.clm NULL) */
+static int
+sw_g2_clm_set(struct sw_hw *h)
+{
+	h->g2clm = NULL;
+	h->g2clmlen = 0;
+	if (sw_clm.p == NULL || sw_clm.len == 0u || sw_clm.len > SW_G2_CLMMAX * SW_G2_CLMCHUNK) {
+		swl_gap("g2", "L22c: no usable CLM entry in the container", "high");
+		return 0;
+	}
+	if (swf_crc32(sw_clm.p, sw_clm.len) != sw_clm.crc) {
+		swl_gap("g2", "L22c: CLM entry fails its CRC32", "high");
+		return 0;
+	}
+	h->g2clm = sw_clm.p;
+	h->g2clmlen = sw_clm.len;
+	return 1;
+}
+
+/* request number *kq: its request item (transaction id SW_G2_E_TRANS + *kq, `n` payload bytes) and the response re-post (id SW_G2_E_RE0 + *kq), chained after `last`; the re-post's buffer is the dongle's choice (kind SH_RBUF) */
+static int
+sw_g2_e_rq(struct sw_hw *h, uint32_t *ix, uint32_t *kq, uint32_t cmd, uint32_t n, int last)
+{
+	const uint64_t rpa = h->g2pa + h->g2plan.b[SWD_RESPBUF].off, ipa = h->g2pa + h->g2plan.b[SWD_IOCTBUF].off;
+	uint32_t w[10];
+
+	sw_g2_d4d_req(w, cmd, SW_G2_E_TRANS + *kq, n, ipa, *ix);
+	last = sw_g2_d4d_post(h, (*ix)++, w, last);
+	if (last < 0) {
+		return -1;
+	}
+	sw_g2_d4d_resp(w, SW_G2_E_RE0 + *kq, rpa, *ix);
+	last = sw_g2_d4d_post(h, (*ix)++, w, last);
+	if (last >= 0) {
+		h->g2l[last - 7].v = (uint32_t)rpa;
+		h->g2l[last - 7].stride = SW_G2_E_BUFSZ;
+		h->g2l[last - 7].vrng = 7u * SW_G2_E_BUFSZ;
+		h->g2l[last - 7].kind = SW_G2K_SH_RBUF;
+	}
+	(*kq)++;
+	return last;
+}
+
+/* L22c (sweetwlan=24), chained after the event_msgs_ext SET re-post: per chunk c < nch the payload (ONE BLOB entry: word 0 of the buffer, rep = the chunk's words) and the request + re-post; then clmload_status (GET, 4 B answer) and country
+ * (SET, "XZ" abbrev, rev 0, ccode "XZ" [src 108 s.9.3]), each payload + request + re-post. The shadow sh is the payload buffer as the host has it after every step (the old value of the next payload) */
+static int
+sw_g2_e_clm(struct sw_hw *h, uint32_t sh[SW_G2_E_PAYW], uint32_t *ix, uint32_t *kq, int last)
+{
+	static const uint8_t xz[12] = { 'X', 'Z', 0, 0, 0, 0, 0, 0, 'X', 'Z', 0, 0 };
+	const uint32_t nch = (h->g2clmlen + SW_G2_CLMCHUNK - 1u) / SW_G2_CLMCHUNK;
+	uint32_t c, i;
+
+	for (i = 0; i < SW_G2_E_PAYW; i++) { h->g2clmpre[i] = sh[i]; }      /* word copy: the glue store audit allows no memory-copy call */
+	for (c = 0; c < nch && last >= 0; c++) {
+		last = sw_g2_add(h, SW3_HOST, 0, h->g2plan.b[SWD_IOCTBUF].off, 0, 0xFFFFFFFFu, 0, 0xFFFFFFFFu, 0, last);
+		if (last < 0) {
+			return -1;
+		}
+		h->g2l[last].kind = SW_G2K_BLOB;
+		h->g2l[last].arg = c;
+		h->g2l[last].rep = sw_g2_clm_words(h, c);
+		last = sw_g2_e_rq(h, ix, kq, SW_G2_E_SET, 8u + 12u + sw_g2_clm_len(h, c), last);
+		if (last < 0) {
+			return -1;
+		}
+	}
+	for (i = 0; i < SW_G2_E_PAYW; i++) {
+		sh[i] = sw_g2_clm_old(h, nch, i);
+	}
+	last = sw_g2_e_pay(h, sh, "clmload_status", NULL, 15u + 4u, 0u, last);
+	last = last < 0 ? -1 : sw_g2_e_rq(h, ix, kq, SW_G2_E_GET, 15u + 4u, last);
+	last = last < 0 ? -1 : sw_g2_e_pay(h, sh, "country", xz, 8u + 12u, 0u, last);
+	return last < 0 ? -1 : sw_g2_e_rq(h, ix, kq, SW_G2_E_SET, 8u + 12u, last);
+}
+
+/* T-4a7f: the event re-post entries after the escan request: the ten words (kind E_ITEM, the index from the H2D-WR slot, the value from the glue's own counter g2ev) and the commit (kind E_WR); the doorbell is the DS rounds' R_WDB. Repeatable, each chained after `need` (the escan request doorbell). 0 = built, -1 = list full */
+static int
+sw_g2_e_rx(struct sw_hw *h, int need)
+{
+	unsigned k;
+
+	for (k = 0; k < 10u; k++) {
+		if (sw_g2_add(h, SW3_HOST, 0, h->g2plan.b[SWD_H2D_CTRL].off + 4u * k, 0u, 0xFFFFFFFFu, 0, 0xFFFFFFFFu, 0, need) < 0) {
+			return -1;
+		}
+		h->g2l[h->g2n - 1u].kind = SW_G2K_E_ITEM;
+		if (k == 4u) {      /* the buffer address: ANY of the 8 event buffers (T-f1e2, the dongle chooses): slot 0 + a whole number of strides, the old word exact 0 */
+			h->g2l[h->g2n - 1u].stride = SW_G2_E_BUFSZ;
+			h->g2l[h->g2n - 1u].vrng = 7u * SW_G2_E_BUFSZ;
+		}
+	}
+	if (sw_g2_add(h, SW3_HOST, 0, h->g2plan.b[SWD_IDX_H2D_W].off, 0u, 0x0000FFFFu, 0u, 0u, 0, need) < 0) {
+		return -1;
+	}
+	h->g2l[h->g2n - 1u].kind = SW_G2K_E_WR;
+	return 0;
+}
+
+/* T-4a7f: the payload words of one L24 call, b[0..n) (zero filled to the shadow), against the shadow sh: a word equal to the shadow is not stored (the header's swg_e_pay rule); a word still holding an escan version word (bit i of *shv) is
+ * matched once with its old value under ~SW_G2_VERBIT (the header may have stored version 2 or 3, review l21 finding 8) and refused at build time when the new word could equal either form (the header would skip a store the glue expects, or the reverse). Chained after `last` */
+static int
+sw_g2_j_pay(struct sw_hw *h, uint32_t sh[SW_G2_E_PAYW], uint32_t *shv, const uint8_t *b, uint32_t n, int last, int key)
+{
+	uint32_t i, v, vb;
+
+	for (i = 0; i < (n + 3u) / 4u && last >= 0; i++) {
+		v = (uint32_t)b[4u * i] | ((uint32_t)b[4u * i + 1u] << 8) | ((uint32_t)b[4u * i + 2u] << 16) | ((uint32_t)b[4u * i + 3u] << 24);
+		vb = (*shv >> i) & 1u;
+		if (vb && (v & ~SW_G2_VERBIT) == (sh[i] & ~SW_G2_VERBIT)) {
+			if (key) {      /* T-23da (review T-4a7f r1 F4, R18): a wsec_key payload word is key material: the line names the word, not its value (the header's x->esec rule) */
+				swl_gap("g2", "glue: L24 payload word equals an escan version word", "high");
+				printf("SWEET WLAN: G2 glue: L24 payload word %u (value withheld) equals an escan version word up to bit 16, refused\n", i);
+			} else {
+				swl_gap("g2", "glue: L24 payload word equals an escan version word", "high");
+				printf("SWEET WLAN: G2 glue: L24 payload word %u %#x equals escan version word %#x up to bit 16, refused\n", i, v, sh[i]);
+			}
+			return -1;
+		}
+		if (!vb && v == sh[i]) {
+			continue;
+		}
+		last = sw_g2_add(h, SW3_HOST, 0, h->g2plan.b[SWD_IOCTBUF].off + 4u * i, v, 0xFFFFFFFFu, vb ? sh[i] & ~SW_G2_VERBIT : sh[i], vb ? ~SW_G2_VERBIT : 0xFFFFFFFFu, 1, last);
+		sh[i] = v;
+		*shv &= ~(1u << i);
+	}
+	return last;
+}
+
+/* 1 when the NUL terminated name at the start of b (n bytes) is exactly s (the glue's own copy of the header's swg_j_isname) */
+static int
+sw_g2_j_is(const uint8_t *b, uint32_t n, const char *s)
+{
+	uint32_t i = 0;
+
+	while (s[i] != '\0' && i < n && b[i] == (uint8_t)s[i]) {
+		i++;
+	}
+	return s[i] == '\0' && i < n && b[i] == 0u;
+}
+
+_Static_assert(SWG_J_NCMAX == 8u, "SW_G2_MAX counts 8 join calls");
+
+/* T-4a7f: the L24 entries (sweetwlan=24, d4b 11), chained after `last` (the escan request doorbell), only with the glue's join commands h->jc (SWG_J_NCMD..SWG_J_NCMAX, the last one "join"): call 0 = event_msgs_ext SET_MASK with
+ * bits 69, 0, 16 (+ 5, 6, 11, 12, 46 at d4b >= 12 = sweetwlan >= 25, T-924f) (glue constants: ver 1, command 3, len 26), call k >= 1 = jc[k - 1] (SET_VAR); each call = its payload words, the request at ring-0 index ix (SET_VAR 263, trans TRANS + kq + 1 + k, in = out length), the response re-post at ix + 1
+ * (id RE0 + kq + 1 + k, the buffer is the dongle's choice, kind SH_RBUF: T-f1e2/T-af77 LIFO, not FIFO), and after a "wsec_key" call the zeroing of the 44 payload words (the header's swg_e_call_secret). Every word exact
+ * (shifted by g2sh + g2ev at run time). Without join commands: no entry (the header prints WIFI GAP: H5 join not run). The last entry's index, -1 if refused.
+ * T-23da (review T-4a7f r1 F1, option b): every L24 entry also needs the interim witness g2rd && g2ev > g2ev0 (field l24; T-48a0 after review T-4a7f r2 F1: at the first R_RD commit after the escan doorbell g2ev0 = g2ev, and an event re-post must follow it), because `last` is the escan request doorbell and the escan has no response re-post that could witness its completion. The header starts
+ * L24 only with d4dlv == 23, which swg_e_l23 sets only after sc.done == 1, i.e. after it consumed the ESCAN_RESULT SUCCESS event item, and each consumed batch is followed by swg_e_evflush, which re-posts that event through E_WR
+ * (g2ev++) [read from source: swg_e_l23 loop, swg_e_call with sc != NULL]. Review T-4a7f r2 F1: g2ev >= 1 alone does not order L24 after the escan (events consumed by the L22 calls are re-posted by the escan call's first
+ * swg_e_evflush, right after its doorbell). T-48a0 therefore uses the interim witness that review proposed: the first R_RD commit after the escan doorbell records g2ev0 = g2ev (h->g2rd = 1), and every L24 entry needs
+ * g2rd && g2ev > g2ev0, i.e. an event re-post made AFTER the first ring-2 consume that followed the escan. This is NOT a completion witness (a partial scan-result event re-posted earlier than the SUCCESS event satisfies it;
+ * [guess] the dongle has read the escan payload by then): r1 F1 option (a), the ioctl completion with trans SW_G2_E_TRANS + 5, stays the open improvement; the header itself starts L24 only after SUCCESS */
+static int
+sw_g2_d4j(struct sw_hw *h, uint32_t sh[SW_G2_E_PAYW], uint32_t shv, uint32_t ix, uint32_t kq, int last)
+{
+	static const uint32_t bits[8] = { 69u, 0u, 16u, 5u, 6u, 11u, 12u, 46u };     /* T-924f: the first 3 at d4b 11 (sweetwlan=24); all 8 at d4b >= 12 (sweetwlan >= 25), the same list as the header's swg_j_mask */
+	uint8_t b[4u * SW_G2_E_PAYW];
+	uint32_t jq = kq + 1u, k, i, n, n0 = h->g2n;       /* jq: the request number of L24 call k = kq + 1 + k (kq requests made by L22, then the escan) */
+	int key;
+
+	if (h->jc == NULL || h->njc < SWG_J_NCMD || h->njc > SWG_J_NCMAX || !sw_g2_j_is(h->jc[h->njc - 1u].buf, h->jc[h->njc - 1u].len, "join")) {
+		printf("SWEET WLAN: G2 glue: no L24 entries (join commands %u)\n", h->jc == NULL ? 0u : h->njc);
+		return last;
+	}
+	for (k = 0; k <= h->njc && last >= 0; k++) {
+		memset(b, 0, sizeof b);
+		key = 0;
+		if (k == 0u) {
+			memcpy(b, "event_msgs_ext", 15);
+			b[15] = 1u;
+			b[16] = 3u;
+			b[17] = 26u;
+			for (i = 0; i < (h->d4b >= 12 ? 8u : 3u); i++) {
+				b[19u + bits[i] / 8u] |= (uint8_t)(1u << (bits[i] % 8u));
+			}
+			n = 15u + 30u;
+		} else {
+			n = h->jc[k - 1u].len;
+			if (h->jc[k - 1u].cmd != SW_G2_E_SET || n > sizeof b || n > sizeof h->jc[k - 1u].buf) {
+				swl_gap("g2", "glue: L24 join command not a SET_VAR that fits", "high");
+				return -1;
+			}
+			memcpy(b, h->jc[k - 1u].buf, n);
+			key = sw_g2_j_is(b, n, "wsec_key") || sw_g2_j_is(b, n, "cur_etheraddr");      /* T-857c: the station MAC knob is withheld like a key */
+		}
+		last = sw_g2_j_pay(h, sh, &shv, b, n, last, key);
+		if (last < 0) {
+			return -1;
+		}
+		last = sw_g2_e_rq(h, &ix, &jq, SW_G2_E_SET, n, last);       /* the request (trans SW_G2_E_TRANS + jq) and the response re-post (id SW_G2_E_RE0 + jq, buffer = the dongle's choice, kind SH_RBUF) */
+		if (key && last >= 0) {
+			memset(b, 0, sizeof b);
+			last = sw_g2_j_pay(h, sh, &shv, b, sizeof b, last, 0);
+		}
+	}
+	for (i = n0; last >= 0 && i < h->g2n; i++) {    /* T-23da (review T-4a7f r1 F1): every L24 entry waits for g2ev >= 1, see above */
+		h->g2l[i].l24 = 1;
+	}
+	return last;
+}
+
+/* the L21..L23 entries chained after `last` (the L20 re-post doorbell): L21 = 7 response posts (ids 5..11, buffers 1..7) + 7 event posts (ids 0x21..0x27, buffers 1..7); L22 (d4b >= 9) = per request: payload, request, response re-post;
+ * L23 (d4b >= 10) = payload, the escan request; L24 (d4b >= 11) = sw_g2_d4j; then the repeatable event re-post entries (sw_g2_e_rx, T-4a7f: up to SW_G2_E_NREP, ids 0x28.., buffers 0..7 round robin, at the slot's index). Returns the last entry's index, -1 if refused */
+static int
+sw_g2_d4e(struct sw_hw *h, int last)
+{
+	uint64_t rpa = h->g2pa + h->g2plan.b[SWD_RESPBUF].off, epa = h->g2pa + h->g2plan.b[SWD_EVBUF].off, ipa = h->g2pa + h->g2plan.b[SWD_IOCTBUF].off;
+	uint32_t w[10], sh[SW_G2_E_PAYW] = { SW_G2_D4D_CAP_W0 }, ix = 9u, j, kq = 0, escn = 80u;
+	uint8_t arg[96];
+	int esc;
+	const int clm = h->d4b >= 11 && sw_g2_clm_set(h);      /* L22c (sweetwlan=24): without a checked blob the list is the level-23 one (the escan entries are still the level-24 7-channel ones; unreachable, the shim STOPs before UP) */
+	static const struct { const char *name; uint32_t cmd, nl, argn; } rq[5] = {
+		{ "scan_ver", SW_G2_E_GET, 9u, 6u }, { "sup_wpa", SW_G2_E_GET, 8u, 4u }, { "event_msgs_ext", SW_G2_E_GET, 15u, 30u }, { "event_msgs_ext", SW_G2_E_SET, 15u, 30u }, { NULL, SW_G2_E_UP, 0u, 0u },
+	};
+
+	if (h->g2plan.b[SWD_RESPBUF].len < 8u * SW_G2_E_BUFSZ || h->g2plan.b[SWD_EVBUF].len < 8u * SW_G2_E_BUFSZ) {      /* review l21 finding 5: the glue stride (a glue constant, R107 #5) must fit the G1 plan it posts into */
+		swl_gap("g2", "glue: scan24 buffers smaller than the table", "high");
+		return -1;
+	}
+	for (j = 1; j < 8u && last >= 0; j++) {
+		sw_g2_d4d_resp(w, 4u + j, rpa + (uint64_t)j * SW_G2_E_BUFSZ, ix);
+		last = sw_g2_d4d_post(h, ix++, w, last);
+	}
+	for (j = 1; j < 8u && last >= 0; j++) {
+		sw_g2_d4e_ev(w, SW_G2_E_EVID + j, epa + (uint64_t)j * SW_G2_E_BUFSZ, ix);
+		last = sw_g2_d4d_post(h, ix++, w, last);
+	}
+	for (j = 0; h->d4b >= 9 && j < 5u && last >= 0; j++) {
+		if (j == 4u && clm) {        /* L22c: between event_msgs_ext SET and WLC_UP, as the shim's swg_e_l22c */
+			last = sw_g2_e_clm(h, sh, &ix, &kq, last);
+			if (last < 0) {
+				return -1;
+			}
+		}
+		memset(arg, 0, sizeof arg);
+		if (j == 2u || j == 3u) {
+			arg[0] = 1u;            /* eventmsgs_ext: ver 1 (WI:9665), len 26 = ROUNDUP(207, 8) / 8 (LX:12715-12722, BE:319) */
+			arg[2] = 26u;
+		}
+		if (j == 3u) {
+			arg[1] = 3u;            /* command EVENTMSGS_SET_MASK (WI:9669) */
+			arg[4u + 69u / 8u] = (uint8_t)(1u << (69u % 8u));      /* ONLY bit 69 (WLC_E_ESCAN_RESULT, BE:180) */
+		}
+		if (rq[j].name != NULL) {
+			last = sw_g2_e_pay(h, sh, rq[j].name, j >= 2u ? arg : NULL, rq[j].nl + rq[j].argn, 0u, last);
+		}
+		if (last < 0) {
+			return -1;
+		}
+		sw_g2_d4d_req(w, rq[j].cmd, SW_G2_E_TRANS + kq, rq[j].nl + rq[j].argn, ipa, ix);
+		last = sw_g2_d4d_post(h, ix++, w, last);
+		if (last < 0) {
+			return -1;
+		}
+		sw_g2_d4d_resp(w, SW_G2_E_RE0 + kq, rpa + (uint64_t)j * SW_G2_E_BUFSZ, ix);      /* completion c = 2 + j: the id is ours, the buffer is the one the dongle used (any of the 8, kind SH_RBUF) */
+		last = sw_g2_d4d_post(h, ix++, w, last);
+		if (last >= 0) {
+			h->g2l[last - 7].v = (uint32_t)rpa;          /* the table value of kind SH_RBUF is the slot-0 address; the match allows slot 0 + k * stride, k < 8 */
+			h->g2l[last - 7].stride = SW_G2_E_BUFSZ;      /* 8 buffers: slot 0 + k * stride, k <= 7 */
+			h->g2l[last - 7].vrng = 7u * SW_G2_E_BUFSZ;
+			h->g2l[last - 7].kind = SW_G2K_SH_RBUF;      /* word 4 of the item whose doorbell entry is `last` (10 words, slot, doorbell): the buffer is the dongle's choice */
+		}
+		kq++;
+	}
+	if (h->d4b >= 10 && last >= 0) {
+		memset(arg, 0, sizeof arg);
+		arg[0] = 2u;                    /* escan version (2 here; kind VER lets 3 through), WI:1089-1095 */
+		arg[4] = 1u;                    /* action START (WL_ESCAN_ACTION_START = 1, BW bwfmreg.h:563; WD:356 is WL_SCAN_ACTION_START, same value) */
+		arg[6] = 0x34u;                 /* sync_id 0x1234 */
+		arg[7] = 0x12u;
+		arg[8] = 2u;                    /* params version */
+		arg[10] = 72u;                  /* params length = 72 (without the channel list) [obs: stock wl_do_escan stores 0x48, golden-wifi-trace-h1b.md s.3; the 80 got status -26 = BCME_EPERM, T-af77 boot 5] */
+		memset(arg + 48, 0xFF, 6);      /* bssid ff x6 */
+		arg[54] = 2u;                   /* bss_type DOT11_BSSTYPE_ANY */
+		arg[56] = 1u;                   /* scan_type PASSIVE (WD:239) */
+		memset(arg + 60, 0xFF, 16);     /* nprobes, active, passive, home = -1 */
+		if (h->d4b >= 11) {             /* T-0fdd (sweetwlan=24): 7 channels, channel_num 7 at params +68 (arg + 76), the chanspecs at params +72 (arg + 80), 14 B zero padded to 16 B, params length stays 72 [obs golden-wifi-trace-h1b.md s.3] */
+			static const uint16_t cs[7] = { 0x1001u, 0x1006u, 0x100Bu, 0xD024u, 0xD028u, 0xD02Cu, 0xD030u };      /* channels 1 6 11 36 40 44 48: channel | 0x1000 | band (2.4 GHz 0, 5 GHz 0xC000) */
+
+			arg[76] = 7u;
+			for (j = 0; j < 7u; j++) {
+				arg[80u + 2u * j] = (uint8_t)(cs[j] & 0xFFu);
+				arg[81u + 2u * j] = (uint8_t)(cs[j] >> 8);
+			}
+			escn = 96u;
+		}
+		last = sw_g2_e_pay(h, sh, "escan", arg, 6u + escn, (1u << 1) | (1u << 3), last);
+		if (last < 0) {
+			return -1;
+		}
+		sw_g2_d4d_req(w, SW_G2_E_SET, SW_G2_E_TRANS + kq, 6u + escn, ipa, ix);
+		last = sw_g2_d4d_post(h, ix++, w, last);
+		esc = last;
+		h->g2esc = esc;
+		if (h->d4b >= 11 && last >= 0) {        /* T-4a7f: L24, chained after the escan request doorbell */
+			last = sw_g2_d4j(h, sh, (1u << 1) | (1u << 3), ix, kq, last);
+		}
+		if (last >= 0) {        /* T-4a7f: the event re-posts (L23 and L24) LAST, after every exact entry (an exact word matches first), each after the escan request doorbell; word 4 of each = any of the 8 event buffers (T-f1e2) */
+			last = sw_g2_e_rx(h, esc) < 0 ? -1 : last;
+		}
+	}
+	return last;
+}
+/* W-D4b (SPEC-WIFI Q2-Q5, Q8): the extra entries of sweetwlan=14, built from the glue's OWN constants and its own copy of the G1 plan (the header computes the same words from swd4b_item_evbuf, R107 #5):
+ * Q2 mask := 0xFFFF (old 0, after the hostready entry `ready`: review r1 F7), Q3 the ten item words at ring 0's base (old 0, after the mask), Q4 H2D-WR slot 0 low half := 1 (old 0, upper half kept, after the last item word), Q5 doorbell 0
+ * (after the slot), Q8 0xC34 := 0 (any old, after the mask). Each once. 0 = built, -1 = list full. */
+static int
+sw_g2_d4(struct sw_hw *h, int ready)
+{
+	uint64_t pa = h->g2pa + h->g2plan.b[SWD_EVBUF].off;
+	unsigned k;
+	int m, last, bad;
+
+	if (ready < 0) {        /* review r1 F7: the mask entry needs the hostready entry (chained below); none, none of these */
+		return -1;
+	}
+	m = sw_g2_add(h, SWW_BAR0, SWW_WIN_PCIE, 0xC34u, SW_G2_D4_MASK, 0xFFFFFFFFu, 0, 0xFFFFFFFFu, 1, ready);
+	bad = m < 0;
+	last = m;
+	for (k = 0; k < 10u; k++) {
+		last = sw_g2_add(h, SW3_HOST, 0, h->g2plan.b[SWD_H2D_CTRL].off + 4u * k, k == 0u ? SW_G2_D4_W0 : k == 1u ? 1u : k == 2u ? SW_G2_D4_LEN : k == 4u ? (uint32_t)pa : k == 5u ? (uint32_t)(pa >> 32) : 0u, 0xFFFFFFFFu, 0, 0xFFFFFFFFu, 1, k == 0u ? m : last);
+		bad |= last < 0;
+	}
+	last = sw_g2_add(h, SW3_HOST, 0, h->g2plan.b[SWD_IDX_H2D_W].off, 1u, 0x0000FFFFu, 0, 0xFFFFFFFFu, 1, last);
+	bad |= last < 0;
+	last = sw_g2_add(h, SWW_BAR0, SWW_WIN_PCIE, 0x140u, SW_G2_D4_DB0, 0xFFFFFFFFu, 0, 0, 1, last);
+	bad |= last < 0 || sw_g2_add(h, SWW_BAR0, SWW_WIN_PCIE, 0xC34u, 0, 0xFFFFFFFFu, 0, 0, 1, m) < 0;
+	if (h->d4b >= 3) {      /* W-D4c (sweetwlan=16), chained after the L14 doorbell entry (`last` is still its index), exactly the header's store order: A1 = ring-0 item 1 (DS_ACK, slot := 2 old 1, FF000002), C1 = D2H-RD slot := 1 + DD020001,
+		 * W = item 2 (DEVICE_WAKE_ASSERT, slot := 3 old 2, FF000003), D = item 3 (DEVICE_WAKE_DEASSERT, slot := 4 old 3, FF000004), C2 = D2H-RD slot := 2 (old 1) + DD020002; each row once */
+		last = sw_g2_d4c_post(h, 1u, SW_G2_D4C_W0_ACK, SW_G2_D4C_MB_ACK, 2u, SW_G2_D4C_DB0_ACK, last);
+		last = last < 0 ? -1 : sw_g2_d4c_rd(h, 1u, SW_G2_D4C_DB0_RD1, last);
+		last = last < 0 ? -1 : sw_g2_d4c_post(h, 2u, SW_G2_D4C_W0_WAKE, SW_G2_D4C_MB_WAKE, 3u, SW_G2_D4C_DB0_WAKE, last);
+		last = last < 0 ? -1 : sw_g2_d4c_post(h, 3u, SW_G2_D4C_W0_DEAS, SW_G2_D4C_MB_DEAS, 4u, SW_G2_D4C_DB0_DEAS, last);
+		last = last < 0 ? -1 : sw_g2_d4c_rd(h, 2u, SW_G2_D4C_DB0_RD2, last);
+		bad |= last < 0;
+		if (h->d4b >= 4 && !bad) {      /* W-D4d (sweetwlan=17..20), chained after the C2 doorbell entry (`last`) */
+			int dl = sw_g2_d4d(h, last);       /* chain index after the D4d entries */
+			bad |= dl < 0;
+			if (h->d4b >= 8 && !bad) {      /* W-D4e (sweetwlan=21..23), chained after the L20 re-post doorbell */
+				dl = sw_g2_d4e(h, dl);
+				bad |= dl < 0;
+			}
+			bad |= sw_g2_ds(h, last) < 0;     /* 22b: the masked DS-round entries and the ring-2 read-index entries, LAST (an exact entry matches first), chained after the L16 C2 doorbell entry (review F2) */
+		}
+	}
+	return bad ? -1 : 0;
+}
