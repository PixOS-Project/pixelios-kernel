+	}
+	/* review 0174-w-d4b-hwwrite-r1 F6: the entry is matched on space/window/offset/width/once/need first; the old value is read (once) only for an entry that needs it (a condition on the old value, a partial value mask, or a 16-bit store that keeps the upper half), so a doorbell (omask 0, whole word) is never read here */
+	for (i = 0; i < h->g2n; i++) {
+		e = &h->g2l[i];
+		if (e->space != space || e->win != win || e->w16 != (w16 ? 1 : 0) || (e->once && e->done) || (e->need >= 0 && !h->g2l[e->need].done) || (e->l24 && (!h->g2rd || h->g2ev <= h->g2ev0)) || !sw_g2_exp(h, e, off, &ev, &eold)) {
+			continue;
+		}
