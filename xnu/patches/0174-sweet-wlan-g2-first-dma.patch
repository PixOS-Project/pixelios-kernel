+			b = h->g2clm[c * SW_G2_CLMCHUNK + (q - 20u)];
+		}
+		v |= b << (8u * k);
+	}
+	return v;
+}
+
+/* the word the payload buffer holds at i when chunk c starts: the newest earlier chunk that wrote word i, else the shadow before the first chunk */
+static uint32_t
+sw_g2_clm_old(const struct sw_hw *h, uint32_t c, uint32_t i)
+{
+	while (c-- > 0u) {
+		if (i < sw_g2_clm_words(h, c)) {
+			return sw_g2_clm_word(h, c, i);
+		}
+	}
+	return h->g2clmpre[i];
+}
+
+/* 22b: the offset the entry names for a store to `off` (1 = it names it) and the value / old value it expects there. Kinds SH_*: the exact D4d/scan24 entry moved by the DS-round items posted before it (g2sh); R_*: ranges bound to the ring bases */
+static void sw_g2_e_evexp(const struct sw_hw *h, uint32_t w[10], uint32_t i);
+
+/* T-f1e2 + T-4a7f: word k of an event post is the expected one, except word 4 (the buffer address, low half), which is ANY of the 8 event buffers: w[4] is the slot-0 address, v - w[4] a whole number of SW_G2_E_BUFSZ up to 7 (the dongle chooses the buffer, the shim re-posts the consumed slot) */
+static int
+sw_g2_evw_ok(const uint32_t w[10], uint32_t k, uint32_t v)
+{
+	if (k == 4u) {
+		return v - w[4] <= 7u * SW_G2_E_BUFSZ && (v - w[4]) % SW_G2_E_BUFSZ == 0u;
+	}
+	return v == w[k];
+}
+
+static int
+sw_g2_exp(struct sw_hw *h, const struct sw_g2w *e, uint32_t off, uint32_t *ev, uint32_t *eold)
+{
+	uint32_t eo = e->off, i, k, sh = h->g2sh + h->g2ev, w[10];     /* T-4a7f: the exact entries move by the DS-round items AND the event re-posts posted before them */
+	volatile uint32_t *sl;
+
+	*ev = e->v;
+	*eold = e->old;
+	switch (e->kind) {
+	case SW_G2K_SH_ITEM:
+	case SW_G2K_SH_ITEM0:
+	case SW_G2K_SH_RBUF:
+		eo += 40u * sh;
+		if (e->kind == SW_G2K_SH_ITEM0) {
+			*ev = (e->v & 0x00FFFFFFu) | ((((e->v >> 24) + sh) % 253u) << 24);
+		}
+		break;
+	case SW_G2K_SH_WR:
+		*ev = e->v + sh;
+		*eold = e->old + sh;
+		if ((*ev & 0xFFFFu) >= SW_G2_R0_ITEMS) {       /* F3c: the moved slot value stays inside ring 0 (refused, loud: the caller's "not in the list" line) */
+			return 0;
+		}
+		break;
+	case SW_G2K_SH_DB:
+		*ev = e->v + sh;
+		break;
+	case SW_G2K_E_ITEM:     /* T-4a7f: word k of the event post the slot names, k from the entry's own offset (entry off = ring-0 base + 4k); T-23da (review T-4a7f r1 F2): slot + 1 < 128, the header's own bound (swg post: idx + 1 >= 128 stops), so item 127 is never written */
+		sl = sw3_ptr(h, SW3_HOST, h->g2plan.b[SWD_IDX_H2D_W].off);
+		if (sl == NULL || (*sl & 0xFFFFu) + 1u >= SW_G2_R0_ITEMS || h->g2ev >= SW_G2_E_CAP(h) || e->off < h->g2plan.b[SWD_H2D_CTRL].off || e->off - h->g2plan.b[SWD_H2D_CTRL].off >= 40u) {
+			return 0;
+		}
+		i = *sl & 0xFFFFu;
+		eo += 40u * i;
+		sw_g2_e_evexp(h, w, i);
+		for (k = 0; k < 10u; k++) {    /* the item at the slot is a prefix of this event post: every word 0 or already the expected one (no mixing with a request or a DS-round item, whose words are exact entries with old 0) */
+			volatile uint32_t *q = sw3_ptr(h, SW3_HOST, h->g2plan.b[SWD_H2D_CTRL].off + 40u * i + 4u * k);
+
+			if (q == NULL || (*q != 0u && !sw_g2_evw_ok(w, k, *q))) {
+				return 0;
+			}
+		}
+		*ev = w[(e->off - h->g2plan.b[SWD_H2D_CTRL].off) / 4u];
+		break;
+	case SW_G2K_R_ITEM:
+	case SW_G2K_R_ITEM0:
+		if (e->stride == 0u || off < eo || (off - eo) % e->stride != 0u || (off - eo) / e->stride >= e->rep) {
+			return 0;
+		}
+		i = (off - eo) / e->stride;
+		sl = sw3_ptr(h, SW3_HOST, h->g2plan.b[SWD_IDX_H2D_W].off);
+		if (sl == NULL || i != (*sl & 0xFFFFu)) {       /* F3b: only the item being built, the one the next H2D-WR commit names (refused, loud: the caller's "not in the list" line) */
+			return 0;
+		}
+		eo = off;
+		if (e->kind == SW_G2K_R_ITEM0) {
+			*ev = (e->v & 0x00FFFFFFu) | SW_G2_D4D_EP(i);
+		}
+		break;
+	case SW_G2K_BLOB:
+		if (h->g2clm == NULL || off < eo || ((off - eo) & 3u) != 0u || (off - eo) / 4u >= e->rep || e->rep > SW_G2_E_PAYW) {
+			return 0;
+		}
+		i = (e - h->g2l) + 12u;         /* the doorbell entry of this chunk's request (this entry, 10 item words, slot, doorbell): the payload buffer is the next request's once that doorbell is stored */
+		if (i >= h->g2n || h->g2l[i].done) {
+			return 0;
+		}
+		i = (off - eo) / 4u;
+		*ev = sw_g2_clm_word(h, e->arg, i);
+		*eold = sw_g2_clm_old(h, e->arg, i);
+		if (*ev == *eold) {     /* the shim stores only the words that differ from the old one: a store of an equal word is not one of its stores */
+			return 0;
+		}
+		eo = off;
+		break;
+	default:
+		break;
+	}
+	return off == eo;
+}
+
+/* 22b review F1: 1 when ring-0 item j holds a complete DS-round item: word 0 = 0x23 | flags 0x80 | the epoch of index j, word 2 = mb data 0x2 / 0x40 / 0x20, the other eight words 0 (h2d_mailbox_data_t = cmn_msg_hdr_t 8 B [word 0 type/if/flags/epoch, word 1 request_id]
+ * + mail_box_data + rsvd[7] = 40 B, bcmmsgbuf.h:626-630, 181-192). Item size 40 B restated (the sweep text starts here). Words are read through the same sw3_ptr as the stores. */
+static int
+sw_g2_item_ok(struct sw_hw *h, uint32_t j)
+{
+	volatile uint32_t *q;
+	uint32_t k, w[10];
+
+	for (k = 0; k < 10u; k++) {
+		q = sw3_ptr(h, SW3_HOST, h->g2plan.b[SWD_H2D_CTRL].off + 40u * j + 4u * k);
+		if (q == NULL) {
+			return 0;
+		}
+		w[k] = *q;
+	}
+	if (w[0] != (0x00800023u | SW_G2_D4D_EP(j)) || (w[2] != 0x2u && w[2] != 0x40u && w[2] != 0x20u)) {
+		return 0;
+	}
+	for (k = 1; k < 10u; k++) {
+		if (k != 2u && w[k] != 0u) {
+			return 0;
+		}
+	}
+	return 1;
+}
+
+/* T-4a7f: 1 when ring-0 item j holds, word for word, the glue's own event post for counter g2ev at index j (sw_g2_e_evexp); read through the same sw3_ptr as the stores */
+static int
+sw_g2_evitem_ok(struct sw_hw *h, uint32_t j)
+{
+	volatile uint32_t *q;
+	uint32_t k, w[10];
+
+	if (j >= SW_G2_R0_ITEMS) {
+		return 0;
+	}
+	sw_g2_e_evexp(h, w, j);
+	for (k = 0; k < 10u; k++) {
+		q = sw3_ptr(h, SW3_HOST, h->g2plan.b[SWD_H2D_CTRL].off + 40u * j + 4u * k);
+		if (q == NULL || !sw_g2_evw_ok(w, k, *q)) {
+			return 0;
+		}
+	}
+	return 1;
+}
+
+/* T-43af (W-JOIN L25, docs/research/T-3e93-l25-wiring-design.md s.1-2, review T-5173 r1-r2): while the engine runs L25 (level 25: swl25_run), every HOST, DATA and PCIe doorbell-0 store is judged by sweet_wlan_l25_wl.h and by nothing else.
+ * The entries of g2l[] for those spaces (the wide deep-sleep-round and L24 entries: ring-2 index/doorbell stores by a value-below-depth rule) are NOT consulted then, so they cannot widen the judge, and the judge's completion bookkeeping
+ * (swl25w_done: doorbell due, flow created, ioctl in transit) sees every store. Everything else (window moves cfg 0x80/0x84, PCIe 0xC34 := 0, EP and RC Command: the stop path swg_undo, W17) still goes through g2l[] as before and stays
+ * allowed after a refusal. A deep-sleep round during L25 is refused by the judge (fail closed, review T-5173 r1 F6): a loud stop through swg_undo. Nothing here writes anything. */
+static struct swc_creds sw_cred;      /* T-48a0 credentials (moved up by T-d84f: the W17 hook hands them to swl25g_arm) */
+static struct swl25g sw_l25g;      /* T-d84f: the L25 cfg (PMK, RSNE copy) and the scan hook's target; zeroed by swl25g_disarm after the run and by the init scrub */
+static int sw_g2_rd(void *ctx, int sp, uint32_t a, uint32_t *v);
+
+/* the judge's flushing word read (host and DATA blocks only): the glue's own G2 read, so the DMA-written words are seen */
+static int
+sw_l25w_rd(void *ctx, int space, uint32_t off, uint32_t *v)
+{
+	if (space != SWL25W_SP_HOST && space != SWL25W_SP_DATA) {
+		return -1;
+	}
+	return sw_g2_rd(ctx, space == SWL25W_SP_HOST ? SWG_SP_HOST : SWG_SP_DATA, off, v);
+}
+
+/* 1 once the engine is at level 25 or above in the swg_go this hook runs (latched: a later engine state cannot send an L25 store back to g2l[]); needs the layout and the armed cfg (h->l25arm) */
+static int
+sw_l25w_live(struct sw_hw *h)
+{
+	if (!h->l25on && h->l25arm && h->g2x != NULL && h->g2x->elv >= 25u) {
+		h->l25on = 1;
+		swl25g_wl_bssid(&h->l25w, &sw_l25g);
+		printf("SWEET WLAN: L25 store judge live (engine level %u, bssid %s)\n", (unsigned)h->g2x->elv, h->l25w.bssid_set ? "known" : "not known yet");
+	}
+	return h->l25on;
+}
+
+/* the judge for one store of L25: SW_G2_L25 + class when accepted (h->l25sp/old/cls kept for sw3_wr), -1 when refused (loud; the value is never printed: an ioctl payload word may be key material) */
+static int
+sw_l25w_judge(struct sw_hw *h, int space, uint32_t off, uint32_t v)
+{
+	const char *why = "";
+	uint32_t old = 0;
+	const int sp = space == SW3_HOST ? SWL25W_SP_HOST : space == SW3_DATA ? SWL25W_SP_DATA : SWL25W_SP_PCIE;
+	int cls;
+
+	if (sp != SWL25W_SP_PCIE && sw_l25w_rd(h, sp, off, &old) != 0) {
+		swl_gap("l25", "glue: L25 store refused, the old word is unreadable", "high");
+		printf("SWEET WLAN: L25 glue: store space %d off %#x refused: old word unreadable\n", sp, off);
+		return -1;
+	}
+	cls = swl25w_ok(&h->l25w, sp, off, v, old, &why);
+	if (cls < 0) {
+		swl_gap("l25", "glue: L25 store refused by the whitelist", "high");
+		printf("SWEET WLAN: L25 glue: store space %d off %#x refused (value withheld): %s\n", sp, off, why);
+		return -1;
+	}
+	h->l25sp = sp;
+	h->l25old = old;
+	h->l25cls = cls;
+	return SW_G2_L25 + cls;
+}
+
+/* patch 0174, run G2: the entry of g2l[] that allows (space, win, off, v) now, or -1. Window moves (cfg 0x80/0x84) only with the endpoint precondition for the EP Command G2 has set (h->g2ep);
