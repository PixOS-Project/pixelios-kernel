+#if defined(SWEET_WLAN_DATA_H) && defined(SWEET_WLAN_JOIN_H)
+static int swl25_run(struct swg_wx *x, unsigned lv);        /* sweet_wlan_l25_hs.h: the includer of data.h + join.h includes l25.h and l25_hs.h after this file */
+#endif
