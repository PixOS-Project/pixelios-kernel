+		}
+	}
+	memset(rsp, 0, sizeof rsp);
+	ex = swg_e_call(x, SWD4B_WLC_GET_VAR, "WLC_GET_VAR clmload_status", "clmload_status", NULL, 4u, 15u + 4u, 1, 4u, rsp, 1, &cm, NULL);
+	if (ex != 0 || x->d4dstop) {
+		return ex;
+	}
+	st = cm.resp_len >= 4u ? swd4b_get32(rsp) : 0xFFFFFFFFu;
