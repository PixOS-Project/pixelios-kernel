 	    (unsigned)sw_keep_join.chan, (int)sw_keep_join.rssi, (unsigned)sw_keep_join.live);
+	/* patch 0293 (W-D3-weak-security): Settings snapshots the Get 103 record ONCE, so it must carry the join target's IEs from the first answer. The L25 target record (the L23 scan's, or WLC_GET_BSS_INFO's) is still valid here (the disarm below wipes it); only for the BSSID the firmware reports */
