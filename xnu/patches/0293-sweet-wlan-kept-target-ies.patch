 extern int sweet_wlan_a80211_scan_done(uint32_t kind, uint32_t ms, uint32_t ev);                                               /* bsd/dev/sweet_wlan_a80211.c (patch 0201, 0292): the live scan ended, swap the list in and post SCAN_DONE */
+extern void sweet_wlan_a80211_kept_target(const uint8_t *bssid, const uint8_t *ie, uint32_t ie_len, uint32_t ie_short, uint32_t chspec, uint32_t beacon, int32_t noise, int32_t snr, const uint8_t *rates, uint32_t nrates);     /* bsd/dev/sweet_wlan_a80211.c (patch 0201, 0293): the join target's record (IEs, rates, ...) for Get 103 */
 int sweet_wlan_keep_scan_request(void);
 
 /* patch 0292 (WIFI-COVERAGE D3/D4, Settings > Wi-Fi lists networks): the keep-phase scan state (sweet_wlan_l25_hs.h swl25_sc_*). Set 10 reaches sweet_wlan_keep_scan_request from the iOS ioctl thread (through sweet_wlan_a80211.c); that sets ONE flag and touches no engine state, no lock.
