+/* why the adapter is not running although the knob does not turn it off: a default-on feature never goes silent (rule 7) */
+static void
+sbu_vsc_unused(const char *why)
+{
+	int v = 1;
+
+	if (PE_parse_boot_argn("sweetbtvsc", &v, sizeof(v)) && v == 0) {
+		printf("BT VSC: sweetbtvsc=0: adapter off by boot-arg (%s)\n", why);
+		return;
+	}
+	printf("BT GAP: sweetbtvsc adapter not started: %s; bluetoothd's Apple multi-adv commands 0xfd48..0xfd4e go to the chip unchanged\n", why);
+}
+
+/*
+ * Bring-up (R1), after the verified patchram download, same place and style as sbu_lefeat (the rx thread is not running yet, sbu_cmd owns the FIFO): LE Get Vendor Capabilities 0xfd53
+ * (read-only): Command Complete status 00, the byte after the status is max_adv_inst [src AOSP btm_ble_gap.cc:542; docs/research/sprint-bt-fd48-firmware.md s.2a, the stock Android capture
+ * reports 16 [obs]]. The adapter turns on only when max_adv_inst >= SBU_VSC_MINCAP.
+ */
+static void
+sbu_vsc_attach(void)
+{
+	static const struct { const char *name; int maxv; } knobs[] = {     /* the diagnostic rewrites that parse the same streams; on at 1 (pubscan 1 or 2) */
+		{ "sweetbtrw200b", 1 }, { "sweetbtrw200c", 1 }, { "sweetbtnopadv", 1 }, { "sweetbtnopcf", 1 }, { "sweetbtpubscan", 2 },
+	};
+	static const uint8_t none[1] = { 0 };
+	uint8_t rp[SBU_PM_SUPP], st = 0xff;
+	size_t rpn = 0;
+	int v = 1, e;
+
+	memset(sbu_vsc_in, 0, sizeof(sbu_vsc_in));
+	if (PE_parse_boot_argn("sweetbtvsc", &v, sizeof(v)) && v != 1) {
+		if (v == 0) {
+			printf("BT VSC: sweetbtvsc=0: adapter off by boot-arg; bluetoothd's 0xfd48..0xfd4e go to the chip unchanged (the controller answers 0xfd48 with 0x01 [obs bt-bw2])\n");
+			return;
+		}
+		printf("BT GAP: sweetbtvsc=%d ignored: only 0 (off) and 1 (on, the default) exist; the adapter stays on\n", v);
+	}
+	for (unsigned k = 0; k < sizeof(knobs) / sizeof(knobs[0]); k++) {
+		int kv = 0;
+
+		if (PE_parse_boot_argn(knobs[k].name, &kv, sizeof(kv)) && kv >= 1 && kv <= knobs[k].maxv) {
+			printf("BT GAP: sweetbtvsc adapter refuses to start: diagnostic knob %s=%d rewrites the same HCI streams; unset it or set sweetbtvsc=0\n", knobs[k].name, kv);
+			return;
+		}
+	}
+	if ((e = sbu_cmd(0xfd53, none, 0, &st, rp, sizeof(rp), &rpn)) != 0) {
+		printf("BT GAP: sweetbtvsc: 0xfd53 (LE Get Vendor Capabilities) got no Command Complete (error %d): adapter OFF; 0xfd48 goes to the chip unchanged\n", e);
+		return;
+	}
+	if (st != 0) {
+		printf("BT GAP: sweetbtvsc: 0xfd53 status 0x%02x (%s): adapter OFF; 0xfd48 goes to the chip unchanged\n", st, sbu_pstatus(st));
+		return;
+	}
+	if (rpn < 1) {
+		printf("BT GAP: sweetbtvsc: 0xfd53 reply has %zu return bytes after the status (need max_adv_inst): adapter OFF; 0xfd48 goes to the chip unchanged\n", rpn);
+		return;
+	}
+	printf("BT VSC: caps max_adv_inst=%u\n", rp[0]);
+	if (rp[0] < SBU_VSC_MINCAP) {
+		printf("BT GAP: sweetbtvsc: max_adv_inst=%u < %u (bluetoothd creates 4 instances, ids 1..max-1): adapter OFF; 0xfd48 goes to the chip unchanged\n", rp[0], SBU_VSC_MINCAP);
+		return;
+	}
+	sbu_vsc_max = rp[0] < SBU_VSC_NID ? rp[0] : SBU_VSC_NID;
+	if (sbu_vsc_max != rp[0]) {
+		printf("BT VSC: max_adv_inst=%u clamped to %u instance ids (0..%u)\n", rp[0], sbu_vsc_max, sbu_vsc_max - 1);
+	}
+	sbu_vsc_ph = sbu_vsc_pn = sbu_vsc_ah = sbu_vsc_an = 0;
+	sbu_vsc_on = sbu_vsc_ok = true;
+	printf("BT VSC: adapter ON: Apple multi-adv 0xfd48..0xfd4e are answered/translated to 0xfd54 (instance ids 1..%u), everything else passes unchanged; sweetbtvsc=0 turns it off\n", sbu_vsc_max - 1);
+}
