+/*
+ * tx: bluetoothd -> chip. Used by sbu_tx_kctl while the adapter is on or a command is held. Whole packets, split across writes in any way. Bytes of a command are held until the packet is
+ * complete (sbu_vsc_txb); every other packet is forwarded as it arrives (consecutive forwarded bytes go out in one sbu_tx), in order.
+ */
+#define SBU_VSC_TXHELD  (sbu_vsc_ttype == 0x01 && sbu_vsc_toff != 0)
+
+static int
+sbu_vsc_tx(const void *data, size_t len)
+{
+	const uint8_t *p = data;
+	size_t s = 0, e = 0;            /* the run p[s..e) is forwarded unchanged and not yet sent */
+	int rc = 0;
+
+	if (!sbu_vsc_on) {              /* stopped: held command bytes first (they were never sent), then the rest raw */
+		if (SBU_VSC_TXHELD) {
+			unsigned m = sbu_vsc_toff;
+
+			sbu_vsc_toff = 0;
+			SBU_GAP(SG_OTHER, "sweetbtvsc: adapter off: %u held command bytes are sent unchanged", m);
+			rc = sbu_tx(sbu_vsc_txb, m);
+		}
+		sbu_vsc_toff = 0;
+		return rc != 0 ? rc : sbu_tx(data, len);
+	}
+	for (size_t i = 0; i < len; i++) {
+		uint8_t b = p[i];
+		bool hold;
+
+		if (sbu_vsc_toff == 0) {
+			unsigned hl = b == 0x01 ? 4u : b == 0x02 ? 5u : b == 0x03 ? 4u : b == 0x05 ? 5u : 0u;     /* type + cmd opcode2 plen1 | ACL handle2 len2 | SCO handle2 len1 | ISO handle2 len2 */
+
+			if (hl == 0) {
+				char why[48];
+
+				if (e > s) {
+					rc = sbu_tx(p + s, e - s);
+				}
+				snprintf(why, sizeof(why), "tx framing lost at offset %u", (unsigned)i);
+				sbu_vsc_stop(why);
+				return rc != 0 ? rc : sbu_tx(p + i, len - i);
+			}
+			sbu_vsc_ttype = b;
+			sbu_vsc_thlen = hl;
+			sbu_vsc_tneed = 0;
+		}
+		hold = sbu_vsc_ttype == 0x01;
+		if (hold || sbu_vsc_toff < sbu_vsc_thlen) {
+			sbu_vsc_txb[sbu_vsc_toff] = b;
+		}
+		sbu_vsc_toff++;
+		if (sbu_vsc_toff == sbu_vsc_thlen) {
+			unsigned pl = sbu_vsc_ttype == 0x01 || sbu_vsc_ttype == 0x03 ? sbu_vsc_txb[3] :
+			    sbu_vsc_ttype == 0x02 ? (unsigned)(sbu_vsc_txb[3] | (sbu_vsc_txb[4] << 8)) : (unsigned)((sbu_vsc_txb[3] | (sbu_vsc_txb[4] << 8)) & 0x3fff);
+
+			sbu_vsc_tneed = sbu_vsc_thlen + pl;
+		}
+		if (hold) {
+			if (e > s) {            /* what was forwarded before this command goes first */
+				rc = sbu_tx(p + s, e - s);
+			}
+			s = e = i + 1;
+		} else {
+			if (e == s) {
+				s = i;
+			}
+			e = i + 1;
+		}
+		if (rc == 0 && sbu_vsc_tneed != 0 && sbu_vsc_toff == sbu_vsc_tneed) {
+			unsigned need = sbu_vsc_tneed;
+
+			sbu_vsc_toff = 0;
+			sbu_vsc_tneed = 0;
+			if (hold) {
+				uint8_t sub[44];
+				unsigned sn = 0;
+				int a = sbu_vsc_cmd(sbu_vsc_txb, sub, &sn);
+
+				if (a == SBU_VSC_PASS) {
+					rc = sbu_tx(sbu_vsc_txb, need);
+				} else if (a == SBU_VSC_SEND) {
+					rc = sbu_tx(sub, sn);
+					if (rc != 0) {
+						sbu_vsc_unpush();
+					}
+				}
+			}
+		}
+		if (rc != 0) {
+			char why[48];
+
+			snprintf(why, sizeof(why), "tx error %d", rc);
+			sbu_vsc_toff = 0;
+			sbu_vsc_stop(why);
+			return rc;
+		}
+	}
+	if (e > s) {
+		rc = sbu_tx(p + s, e - s);
+		if (rc != 0) {
+			char why[48];
+
+			snprintf(why, sizeof(why), "tx error %d", rc);
+			sbu_vsc_toff = 0;
+			sbu_vsc_stop(why);
+		}
+	}
+	return rc;
+}
+
+/* one complete packet from the chip to bluetoothd (rx thread): replies to the translated 0xfd54 commands are rewritten to the Apple opcode, everything else is delivered unchanged */
+static void
+sbu_vsc_pkt(uint8_t *p, size_t n)
+{
+	bool cc = n >= 7 && p[0] == 0x04 && p[1] == 0x0e && p[2] >= 4 && (p[4] | (p[5] << 8)) == 0xfd54;
+	bool cs = n == 7 && p[0] == 0x04 && p[1] == 0x0f && p[2] == 4 && (p[5] | (p[6] << 8)) == 0xfd54;
+	struct sbu_vsc_pend pe;
+	uint8_t st, o[7];
+
+	if (!cc && !cs) {
+		(void)sweet_bt_rx(p, n);
+		return;
+	}
+	st = cc ? p[6] : p[3];
+	sbu_vsc_lock();
+	if (sbu_vsc_pn == 0) {
+		sbu_vsc_nstray++;
+		sbu_vsc_unlock();
+		SBU_GAP(SG_OTHER, "sweetbtvsc: 0xfd54 reply (status 0x%02x) with no pending translation (bluetoothd never sends 0xfd54 itself [bin s.5]): delivered unchanged", st);
+		(void)sweet_bt_rx(p, n);
+		return;
+	}
+	pe = sbu_vsc_pq[sbu_vsc_ph];
+	if (cc || st != 0) {            /* a Command Status with status 0 only acknowledges; the Command Complete that ends the command is expected after it [guess: the Core-spec pattern, no vendor capture of 0xfd54] */
+		sbu_vsc_ph = (sbu_vsc_ph + 1) % SBU_VSC_PEND;
+		sbu_vsc_pn--;
+		if (st == 0) {
+			struct sbu_vsc_inst *in = &sbu_vsc_in[pe.id % SBU_VSC_NID];
+
+			sbu_vsc_nok++;
+			if (pe.aop == 0xfd49) {
+				memset(in, 0, sizeof(*in));
+			} else if (pe.aop == 0xfd4a) {
+				memcpy(in->prm, pe.prm, 7);
+				in->params_set = true;
+			} else if (pe.aop == 0xfd4d) {
+				in->enabled = pe.en != 0;
+			}
+		} else {
+			sbu_vsc_nfail++;
+		}
+	}
+	if (pe.orphan) {
+		sbu_vsc_norphan++;
+	}
+	sbu_vsc_unlock();
+	if (cc && (p[2] < 5 || p[7] != pe.sub)) {
+		SBU_GAP(SG_OTHER, "sweetbtvsc: 0xfd54 reply plen %u does not echo sub-op 0x%02x (AOSP ble_advertiser_hci_interface.cc:60-68: status, sub-op); rewritten anyway", p[2], pe.sub);
+	}
+	SBU_VSC_LOG("0x%04x id %u <- 0xfd54 sub 0x%02x chip status 0x%02x%s", pe.aop, pe.id, pe.sub, st, pe.orphan ? " (client gone: not delivered)" : "");
+	if (pe.orphan) {
+		return;
+	}
+	o[0] = 0x04;
+	if (cc) {                       /* 04 0e 04 <ncmd from the chip> <Apple opcode> <chip status> */
+		o[1] = 0x0e;
+		o[2] = 4;
+		o[3] = p[3];
+		o[4] = (uint8_t)(pe.aop & 0xff);
+		o[5] = (uint8_t)(pe.aop >> 8);
+		o[6] = st;
+	} else {                        /* 04 0f 04 <status> <ncmd> <Apple opcode> */
+		o[1] = 0x0f;
+		o[2] = 4;
+		o[3] = st;
+		o[4] = p[4];
+		o[5] = (uint8_t)(pe.aop & 0xff);
+		o[6] = (uint8_t)(pe.aop >> 8);
+	}
+	sbu_trace("rx-vsc", o, sizeof(o));
+	(void)sweet_bt_rx(o, sizeof(o));
+}
+
+/* rx: chip -> bluetoothd. b[0..n) are bytes of the chip's stream; whole packets are delivered one by one, a partial one waits in sbu_vsc_rxb. */
+static void
+sbu_vsc_rx(const uint8_t *b, size_t n)
+{
+	if (!sbu_vsc_on) {              /* stopped: the partial packet first, then the rest raw */
+		if (sbu_vsc_rxn != 0) {
+			(void)sweet_bt_rx(sbu_vsc_rxb, sbu_vsc_rxn);
+			sbu_vsc_rxn = 0;
+		}
+		(void)sweet_bt_rx(b, n);
+		return;
+	}
+	for (size_t i = 0; i < n; i++) {
+		unsigned hl;
+
+		sbu_vsc_rxb[sbu_vsc_rxn++] = b[i];
+		if (sbu_vsc_rxn == 1) {
+			uint8_t t = sbu_vsc_rxb[0];
+
+			hl = t == 0x04 ? 3u : t == 0x02 ? 5u : t == 0x03 ? 4u : t == 0x05 ? 5u : 0u;
+			sbu_vsc_rneed = 0;
+			if (hl == 0) {
+				char why[48];
+
+				snprintf(why, sizeof(why), "rx framing lost at offset %u", (unsigned)i);
+				sbu_vsc_stop(why);
+				sbu_vsc_rxn = 0;
+				(void)sweet_bt_rx(b + i, n - i);
+				return;
+			}
+		}
+		hl = sbu_vsc_rxb[0] == 0x04 ? 3u : sbu_vsc_rxb[0] == 0x03 ? 4u : 5u;
+		if (sbu_vsc_rxn == hl) {
+			uint8_t t = sbu_vsc_rxb[0];
+			unsigned pl = t == 0x04 ? sbu_vsc_rxb[2] : t == 0x03 ? sbu_vsc_rxb[3] : t == 0x02 ? (unsigned)(sbu_vsc_rxb[3] | (sbu_vsc_rxb[4] << 8)) :
+			    (unsigned)((sbu_vsc_rxb[3] | (sbu_vsc_rxb[4] << 8)) & 0x3fff);
+
+			sbu_vsc_rneed = hl + pl;
+			if (sbu_vsc_rneed > SBU_VSC_RXMAX) {
+				char why[64];
+				unsigned have = sbu_vsc_rxn;
+
+				snprintf(why, sizeof(why), "rx packet type %#x length %u exceeds %u: framing lost", t, sbu_vsc_rneed, SBU_VSC_RXMAX);
+				sbu_vsc_stop(why);
+				sbu_vsc_rxn = 0;
+				(void)sweet_bt_rx(sbu_vsc_rxb, have);
+				(void)sweet_bt_rx(b + i + 1, n - i - 1);
+				return;
+			}
+		}
+		if (sbu_vsc_rneed != 0 && sbu_vsc_rxn == sbu_vsc_rneed) {
+			unsigned m = sbu_vsc_rxn;
+
+			sbu_vsc_rxn = 0;
+			sbu_vsc_rneed = 0;
+			sbu_vsc_pkt(sbu_vsc_rxb, m);
+		}
+	}
+}
+
+/* local answers (rx thread, once per poll): only at a packet boundary, never inside a chip packet */
+static void
+sbu_vsc_flush_ans(void)
+{
+	for (;;) {
+		uint8_t b[8], k;
+
+		if (sbu_vsc_rxn != 0 || __atomic_load_n(&sbu_vsc_an, __ATOMIC_RELAXED) == 0) {
+			return;
+		}
+		sbu_vsc_lock();
+		if (sbu_vsc_an == 0) {
+			sbu_vsc_unlock();
+			return;
+		}
+		k = sbu_vsc_aq[sbu_vsc_ah].n;
+		memcpy(b, sbu_vsc_aq[sbu_vsc_ah].b, sizeof(b));
+		sbu_vsc_ah = (sbu_vsc_ah + 1) % SBU_VSC_ANS;
+		sbu_vsc_an--;
+		sbu_vsc_unlock();
+		sbu_trace("rx-vsc", b, k);
+		(void)sweet_bt_rx(b, k);
+	}
+}
+
+/* rx error while the framer has a partial packet: the framing is no longer known */
+static void
+sbu_vsc_rxerr(void)
+{
+	if (sbu_vsc_on && sbu_vsc_rxn != 0) {
+		sbu_vsc_stop("uart rx error inside a packet: bytes may be lost");
+		(void)sweet_bt_rx(sbu_vsc_rxb, sbu_vsc_rxn);
+		sbu_vsc_rxn = 0;
+	}
+}
+
+/* the client (bluetoothd) disconnected (sweet_bt.c sbt_disconnect): drop what only it could use, keep the chip's instance state (the next HCI Reset frees it), print the counters */
+void sweet_bt_uart_disc(void);
+
+void
+sweet_bt_uart_disc(void)
+{
+	unsigned held = 0, ans, pend;
+
+	if (!sbu_vsc_ok) {
+		return;
+	}
+	if (SBU_VSC_TXHELD) {
+		held = sbu_vsc_toff;
+	}
+	sbu_vsc_toff = 0;
+	sbu_vsc_lock();
+	ans = sbu_vsc_an;
+	sbu_vsc_an = 0;
+	pend = sbu_vsc_pn;
+	for (unsigned k = 0; k < sbu_vsc_pn; k++) {
+		sbu_vsc_pq[(sbu_vsc_ph + k) % SBU_VSC_PEND].orphan = true;
+	}
+	sbu_vsc_unlock();
+	if (held != 0 || ans != 0 || pend != 0) {
+		SBU_GAP(SG_OTHER, "sweetbtvsc: bluetoothd disconnected with %u held command bytes dropped, %u undelivered local answers dropped, %u translated commands unanswered (their replies are consumed)", held, ans, pend);
+	}
+	sbu_vsc_summary("bluetoothd disconnected");
+}
