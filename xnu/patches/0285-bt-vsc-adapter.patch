+++ b/bsd/dev/sweet_bt.c
@@ -138,6 +138,7 @@ sbt_disconnect(kern_ctl_ref ref, u_int32_t unit, void *unitinfo)
 
 	SBT_TRACE("disconnect control %d", i);
 	if (i >= 0 && __atomic_exchange_n(&sbt.busy[i], 0, __ATOMIC_ACQ_REL)) {
+		sweet_bt_uart_disc();       /* patch 0285: the VSC adapter drops what only this client could use and prints its counters; before the UART is freed so a new client cannot be hit (review F3) */
 		__atomic_store_n(&sbt.uart_busy, 0, __ATOMIC_RELEASE);      /* only the holder frees the UART */
 	}
 	return 0;
