diff --git a/bsd/dev/sweet_mmio_log.c b/bsd/dev/sweet_mmio_log.c
new file mode 100644
index 0000000..486db40
--- /dev/null
+++ b/bsd/dev/sweet_mmio_log.c
@@ -0,0 +1,86 @@
+/* SWEET MMIO run-side log: see sweet_mmio_log.h. Counters are per block; printing stops at SML_CAP lines per block, loudly (rule 8). */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <libkern/OSAtomic.h>
+#include <pexpert/pexpert.h>
+#include <stdint.h>
+#include "sweet_mmio_log.h"
+
+#define SML_CAP         20000u
+#define SML_BLKS        2u
+#define SML_B_READS     0x8u
+#define SML_B_KNOWN     (0x1u | 0x2u | 0x8u)
+
+static const char *const sml_name[SML_BLKS] = { "gpu", "wifi" };
+
+/* Separate counters and caps for writes (index 0) and reads (index 1): reads can never use up the write cap (review mmio-log-r1 F1). */
+static int sml_state;                       /* 0 = not parsed, 1 = off, 2 = on; parsed once. Published with release AFTER sml_mask, read with acquire (F5) */
+static uint32_t sml_mask;
+static volatile SInt32 sml_total[SML_BLKS][2], sml_lines[SML_BLKS][2];
+static volatile UInt32 sml_capped[SML_BLKS][2];      /* OSCompareAndSwap: volatile UInt32 * (libkern/OSAtomic.h:246-251) */
+
+/* A racing double parse can at most print a GAP line twice: both threads read the same boot-arg and store the same mask and state. */
+static void
+sml_parse(void)
+{
+	uint32_t m = 0;
+
+	if (!PE_parse_boot_argn("sweetmmio", &m, sizeof(m))) {
+		m = 0;
+	}
+	sml_mask = m;
+	if (m & 0x2u) {
+		printf("SWEET MMLOG: GAP wifi not hooked yet (M-1 step 2)\n");
+	}
+	if (m & ~SML_B_KNOWN) {
+		printf("SWEET MMLOG: GAP unknown sweetmmio bits %#x\n", m & ~SML_B_KNOWN);
+	}
+	if (m && !(m & 0x3u)) {
+		printf("SWEET MMLOG: GAP sweetmmio=%#x enables no block\n", m);
+	}
+	if (m & SML_B_READS) {
+		printf("SWEET MMLOG: reads on: WAIT() poll loops print per read, timeouts stretch (diagnostic only)\n");
+	}
+	__atomic_store_n(&sml_state, m ? 2 : 1, __ATOMIC_RELEASE);
+}
+
+void
+sweet_mmio_log(unsigned blk, char op, uint64_t pa, uint32_t width, uint32_t val)
+{
+	int st = __atomic_load_n(&sml_state, __ATOMIC_ACQUIRE);
+
+	if (st == 1) {
+		return;
+	}
+	if (st == 0) {
+		sml_parse();
+		if (__atomic_load_n(&sml_state, __ATOMIC_ACQUIRE) == 1) {
+			return;
+		}
+	}
+	if (blk >= SML_BLKS || !(sml_mask & (1u << blk)) || (op == 'R' && !(sml_mask & SML_B_READS))) {
+		return;
+	}
+	unsigned k = op == 'R';
+	(void)OSIncrementAtomic(&sml_total[blk][k]);
+	if ((uint32_t)OSIncrementAtomic(&sml_lines[blk][k]) < SML_CAP) {
+		printf("SWEET MMIO %c %s mmio - 0x%llx %u 0x%x\n", op, sml_name[blk], pa, width, val);
+	} else if (OSCompareAndSwap(0, 1, &sml_capped[blk][k])) {
+		printf("SWEET MMLOG: cap hit blk=%s op=%c printed=%u, further accesses counted not printed\n", sml_name[blk], op, SML_CAP);
+	}
+}
+
+void
+sweet_mmio_log_summary(unsigned blk, const char *where)
+{
+	if (__atomic_load_n(&sml_state, __ATOMIC_ACQUIRE) != 2 || blk >= SML_BLKS || !(sml_mask & (1u << blk))) {
+		return;
+	}
+	uint32_t lw = (uint32_t)sml_lines[blk][0], lr = (uint32_t)sml_lines[blk][1];
+	printf("SWEET MMLOG: blk=%s where=%s W total=%u printed=%u capped=%d R total=%u printed=%u capped=%d\n", sml_name[blk], where,
+	    (uint32_t)sml_total[blk][0], lw < SML_CAP ? lw : SML_CAP, (int)sml_capped[blk][0],
+	    (uint32_t)sml_total[blk][1], lr < SML_CAP ? lr : SML_CAP, (int)sml_capped[blk][1]);
+}
+
+#endif /* ARM64_BOARD_CONFIG_SWEET */
diff --git a/bsd/dev/sweet_mmio_log.h b/bsd/dev/sweet_mmio_log.h
new file mode 100644
index 0000000..8a96ce5
--- /dev/null
+++ b/bsd/dev/sweet_mmio_log.h
@@ -0,0 +1,19 @@
+/*
+ * SWEET MMIO run-side log (goal M-1, docs/research/96): one console line per MMIO access of the XNU driver, in the format tools/trace-diff diff reads
+ * (RE_RUN, tools/trace-diff:67), to compare against a golden CSV. Boot-arg sweetmmio=<mask>: bit0 gpu writes, bit1 wifi (NOT hooked yet: GAP line),
+ * bit3 also reads. Absent or 0 = off. Meta lines use "SWEET MMLOG:" and never the text of the register prefix (AP-138).
+ * Callers must run in thread context (printf may take the console lock): no spinlock held, interrupts enabled.
+ */
+#ifndef SWEET_MMIO_LOG_H
+#define SWEET_MMIO_LOG_H
+#include <stdint.h>
+
+/* SG_MALI_BASE, xnu/patches/0102-sweet-gpu-probe-xnu.patch:40 (file-local there); callers pass base + offset */
+#define SWEET_MMIO_GPU_BASE 0x1C500000ull
+#define SWEET_MMIO_GPU  0u
+#define SWEET_MMIO_WIFI 1u
+
+void sweet_mmio_log(unsigned blk, char op, uint64_t pa, uint32_t width, uint32_t val);
+void sweet_mmio_log_summary(unsigned blk, const char *where);
+
+#endif
