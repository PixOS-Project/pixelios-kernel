+/*
+ * SWEET Mach IPC witness for Preferences (patch 0262, T-e392, G-10b-nav). R0: log only, no register or memory write outside this block's own statics.
+ * Armed by the sampler (bsd/dev/sweet_thrwait.c, boot-arg sweetthrwait != 0); it hands over the Preferences task each round. Three line kinds:
+ *   SWEET IPCW: snd   a message sent BY a Preferences thread (at ipc_kmsg_send entry): destination port, its kobject type, receiver name in its space and receiver pid
+ *   SWEET IPCW: to    a message sent TO Preferences by another task (same hook, destination receiver task == Preferences): sender pid, msgh_id
+ *   SWEET IPCW: rcv   a message received by a Preferences thread (mach_msg_receive_results_kevent): the name of the receive right (ith_receiver_name) and msgh_id;
+ *                     rcv-err = a receive that returned without a message (mr)
+ * `main 1` = the sending / receiving thread is the first thread of the task queue (the run-loop thread). Pointers are raw kernel addresses (as THRWAIT ev).
+ * Lines are capped (SWEET_IPCW_CAP per boot, then one `cap` line). The destination port is read under ip_mq_lock taken and dropped here before the real
+ * ipc_kmsg_send takes it (no printf under a port lock). The sender's own header words are read from the kmsg it owns.
+ */
+#define SWEET_IPCW_CAP 40000
+volatile int sweet_ipcw_on;
+static task_t volatile sweet_ipcw_task;   /* compared with current_task() / a receiver's task; dereferenced only when equal to current_task() */
+static volatile int sweet_ipcw_pid = -1;
+static volatile uint32_t sweet_ipcw_lines;
+
+void sweet_ipcw_arm(task_t task, int pid);
+void sweet_ipcw_send(ipc_kmsg_t kmsg);
+void sweet_ipcw_rcv(ipc_object_t object, mach_port_name_t rname, ipc_kmsg_t kmsg, mach_msg_return_t mr);
+int sweet_thrwait_rcv(task_t task, uint64_t *out, int max, int *total);
+
+void
+sweet_ipcw_arm(task_t task, int pid)
+{
+	sweet_ipcw_task = task;
+	sweet_ipcw_pid = pid;
+}
+
+static int
+sweet_ipcw_cap(void)
+{
+	uint32_t n = sweet_ipcw_lines;
+
+	if (n >= SWEET_IPCW_CAP) {
+		if (n == SWEET_IPCW_CAP) {
+			sweet_ipcw_lines = n + 1;
+			printf("SWEET IPCW: cap reached %d\n", SWEET_IPCW_CAP);
+		}
+		return 1;
+	}
+	sweet_ipcw_lines = n + 1;
+	return 0;
+}
+
+static uint64_t
+sweet_ipcw_now(void)
+{
+	uint64_t ns;
+	absolutetime_to_nanoseconds(mach_absolute_time(), &ns);
+	return ns;
+}
+
+void
+sweet_ipcw_send(ipc_kmsg_t kmsg)
+{
+	task_t pt = sweet_ipcw_task;
+	task_t ct;
+	thread_t th;
+	mach_msg_header_t *h;
+	ipc_port_t dp, lp;
+	uint32_t dbits, kot, act, rname;
+	task_t rtask = TASK_NULL;
+	int is_snd, is_to, main_thr, rpid = -1, spid;
+	uint64_t now;
+
+	if (!sweet_ipcw_on || pt == TASK_NULL || sweet_ipcw_lines > SWEET_IPCW_CAP) {
+		return;
+	}
+	ct = current_task();
+	th = current_thread();
+	h = ikm_header(kmsg);
+	dp = h->msgh_remote_port;
+	if (!IP_VALID(dp)) {
+		return;
+	}
+	ip_mq_lock(dp);
+	dbits = io_bits(ip_to_object(dp));
+	kot = (uint32_t)ip_kotype(dp);
+	act = ip_active(dp) ? 1 : 0;
+	rname = ip_get_receiver_name(dp);
+	if (ip_in_a_space(dp)) {
+		ipc_space_t sp = ip_get_receiver(dp);
+
+		if (sp != IS_NULL && sp != ipc_space_kernel && sp != ipc_space_reply) {
+			rtask = sp->is_task;
+		}
+	}
+	ip_mq_unlock(dp);
+	is_snd = (ct == pt);
+	is_to = (!is_snd && rtask == pt);
+	if (!is_snd && !is_to) {
+		return;
+	}
+	if (sweet_ipcw_cap()) {
+		return;
+	}
+	now = sweet_ipcw_now();
+	lp = h->msgh_local_port;
+	main_thr = (queue_first(&ct->threads) == (queue_entry_t)&th->task_threads);
+	if (is_snd) {
+		rpid = (rtask != TASK_NULL) ? task_pid(rtask) : -1;
+		printf("SWEET IPCW: snd now %llu pid %d tid 0x%llx main %d id %d sz %u bits 0x%x dest 0x%llx dbits 0x%x kot %u act %u rname 0x%x rpid %d local 0x%llx lspec %d\n",
+		    now, sweet_ipcw_pid, thread_tid(th), main_thr, h->msgh_id, h->msgh_size, h->msgh_bits, (uint64_t)(uintptr_t)dp, dbits, kot, act, rname, rpid,
+		    (uint64_t)(uintptr_t)lp, IP_VALID(lp) ? (int)lp->ip_specialreply : -1);
+	} else {
+		spid = task_pid(ct);
+		printf("SWEET IPCW: to now %llu spid %d stid 0x%llx id %d sz %u bits 0x%x dest 0x%llx dbits 0x%x kot %u act %u rname 0x%x rpid %d local 0x%llx lspec %d\n",
+		    now, spid, thread_tid(th), h->msgh_id, h->msgh_size, h->msgh_bits, (uint64_t)(uintptr_t)dp, dbits, kot, act, rname, sweet_ipcw_pid,
+		    (uint64_t)(uintptr_t)lp, IP_VALID(lp) ? (int)lp->ip_specialreply : -1);
+	}
+}
+
+void
+sweet_ipcw_rcv(ipc_object_t object, mach_port_name_t rname, ipc_kmsg_t kmsg, mach_msg_return_t mr)
+{
+	task_t pt = sweet_ipcw_task;
+	thread_t th;
+	task_t ct;
+	int main_thr;
+
+	if (!sweet_ipcw_on || pt == TASK_NULL || sweet_ipcw_lines > SWEET_IPCW_CAP) {
+		return;
+	}
+	ct = current_task();
+	if (ct != pt) {
+		return;
+	}
+	th = current_thread();
+	if (sweet_ipcw_cap()) {
+		return;
+	}
+	main_thr = (queue_first(&ct->threads) == (queue_entry_t)&th->task_threads);
+	if (mr != MACH_MSG_SUCCESS || kmsg == IKM_NULL) {
+		printf("SWEET IPCW: rcv-err now %llu pid %d tid 0x%llx main %d mr 0x%x obj 0x%llx rname 0x%x\n", sweet_ipcw_now(), sweet_ipcw_pid, thread_tid(th), main_thr, (unsigned)mr,
+		    (uint64_t)(uintptr_t)object, rname);
+	} else {
+		mach_msg_header_t *h = ikm_header(kmsg);
+
+		printf("SWEET IPCW: rcv now %llu pid %d tid 0x%llx main %d id %d sz %u bits 0x%x obj 0x%llx rname 0x%x\n", sweet_ipcw_now(), sweet_ipcw_pid, thread_tid(th), main_thr, h->msgh_id,
+		    h->msgh_size, h->msgh_bits, (uint64_t)(uintptr_t)object, rname);
+	}
+}
+
+/*
+ * One sample of the receive state of every thread of `task` (Preferences) for the once-per-second `SWEET THRWAIT: prefrcv` rows: 12 words per thread
+ * {tid, hint, ev, continuation (unslid), waitq word, ith_state, ith_object, io_bits, receiver_name, msgcount|specialreply<<16|sync_link_state<<20, option, kind}. kind 0 =
+ * not in TH_WAIT, 1 = TH_WAIT without a receive object read, 2 = TH_WAIT with the receive object read. The object is dereferenced ONLY when block_hint is
+ * PortReceive/PortSetReceive and ith_state is MACH_RCV_IN_PROGRESS / _TIMED (saved.receive is a union: any other wait would alias other fields): the thread then holds a
+ * reference on the object until it runs again, and thread_lock (held here) keeps it from running. Only plain field loads, no lock taken, no pointer followed further.
+ */
+int
+sweet_thrwait_rcv(task_t task, uint64_t *out, int max, int *total)
+{
+	thread_t thread;
+	int idx = 0;
+
+	task_lock(task);
+	queue_iterate(&task->threads, thread, thread_t, task_threads) {
+		if (idx < max) {
+			uint64_t *o = &out[idx * 12];
+			spl_t s = splsched();
+
+			bzero(o, 12 * sizeof(uint64_t));
+			thread_lock(thread);
+			o[0] = thread_tid(thread);
+			if (thread->state & TH_WAIT) {
+				o[1] = (uint64_t)thread->block_hint;
+				o[2] = (uint64_t)thread->wait_event;
+				o[3] = thread->continuation ? (uint64_t)VM_KERNEL_UNSLIDE(thread->continuation) : 0;
+				o[4] = (uint64_t)thread->waitq.wq_q;
+				o[11] = 1;
+				if ((thread->block_hint == kThreadWaitPortReceive || thread->block_hint == kThreadWaitPortSetReceive) &&
+				    (thread->ith_state == MACH_RCV_IN_PROGRESS || thread->ith_state == MACH_RCV_IN_PROGRESS_TIMED) && thread->ith_object != IO_NULL) {
+					ipc_object_t obj = thread->ith_object;
+
+					o[5] = (uint64_t)thread->ith_state;
+					o[6] = (uint64_t)(uintptr_t)obj;
+					o[7] = (uint64_t)io_bits(obj);
+					o[10] = (uint64_t)thread->ith_option;
+					o[11] = 2;
+					if (io_otype(obj) == IOT_PORT) {
+						ipc_port_t port = ip_object_to_port(obj);
+
+						o[8] = (uint64_t)port->ip_receiver_name;
+						o[9] = (uint64_t)port->ip_messages.imq_msgcount | ((uint64_t)port->ip_specialreply << 16) | ((uint64_t)port->ip_sync_link_state << 20);
+					}
+				}
+			}
+			thread_unlock(thread);
+			splx(s);
+		}
+		idx++;
+	}
+	*total = idx;
+	task_unlock(task);
+	return 0;
+}
