+/* Patch 0275: the capture repetition. Same gestures as the measured table (the calibrated ones and the General probe of patch 0269), settle doubled
+ * (libsweetgl snapshots every frame while it records, so frames are slow; CA animations end on wall-clock time), then a capture request and a
+ * 5 s hold for the writer. App Library: two home swipes (out of the app switcher, to page 1), three left swipes (page 2, App Library, stays), back with two right swipes. */
+struct SweetCapAct { const char *name; unsigned char kind; short x0, y0, x1, y1; unsigned short ms, settle; unsigned char cap; };
+static const SweetCapAct sweetCapActs[] = {
+	{ "home-page-next",    1, 900, 1200, 200, 1200, 250,  700, 1 },
+	{ "home-page-prev",    1, 200, 1200, 900, 1200, 250,  700, 1 },
+	{ "settings-open",     0, 676, 1720,   0,    0, 100, 3000, 1 },
+	{ "general-open",      0, 500, 1900,   0,    0, 100, 1500, 1 },
+	{ "about-open",        0, 500,  370,   0,    0, 100, 1800, 1 },
+	{ "about-scroll-up",   1, 540, 1800, 540,  700, 350,  900, 1 },
+	{ "about-scroll-down", 1, 540,  700, 540, 1800, 350,  900, 1 },
+	{ "about-back",        1,   5, 1200, 700, 1200, 250, 1200, 1 },
+	{ "general-back",      1,   5, 1200, 700, 1200, 250, 1200, 1 },
+	{ "settings-scroll-up", 1, 540, 1800, 540, 700, 350,  900, 1 },
+	{ "settings-scroll-down", 1, 540, 700, 540, 1800, 350, 900, 1 },
+	{ "app-home",          1, 540, 2398, 540, 1200, 200, 1500, 1 },
+	{ "app-launch",        0, 665, 1158,   0,    0, 100, 3000, 1 },
+	{ "app-close",         1, 540, 2398, 540, 1200, 200, 1500, 1 },
+	{ "spotlight-open",    1, 540,  500, 540, 1500, 300, 1500, 1 },
+	{ "spotlight-close",   1, 540, 2398, 540, 1200, 250, 1500, 1 },
+	{ "applib-home1",      1, 540, 2398, 540, 1200, 200, 1500, 0 },   /* gputest-fcap7: after spotlight-close the app switcher was up and the swipes below never reached the App Library: home first */
+	{ "applib-home2",      1, 540, 2398, 540, 1200, 200, 1500, 0 },   /* on the home screen a home swipe goes to page 1 */
+	{ "applib-swipe1",     1, 900, 1200, 200, 1200, 250,  900, 0 },
+	{ "applib-swipe2",     1, 900, 1200, 200, 1200, 250,  900, 0 },
+	{ "applib-open",       1, 900, 1200, 200, 1200, 250, 1500, 1 },
+	{ "applib-back1",      1, 200, 1200, 900, 1200, 250,  900, 0 },
+	{ "applib-back2",      1, 200, 1200, 900, 1200, 250, 1500, 1 },
+	/* cap 2 = real-timing pass: recording OFF, scanout tap ON (kern.sweetnavcap bit 1) for the action; App Library once more without the
+	 * capture's snapshot flushes (they split render passes), so a tile-reload class bug cannot hide behind the recorder */
+	/* no home swipe here: in gputest-cache2 a home swipe from page 1 opened the app switcher; applib-back2 leaves the phone on a home page */
+	{ "rt-applib-swipe1",  1, 900, 1200, 200, 1200, 250,  900, 2 },
+	{ "rt-applib-swipe2",  1, 900, 1200, 200, 1200, 250,  900, 2 },
+	{ "rt-applib-swipe3",  1, 900, 1200, 200, 1200, 250, 1500, 3 },   /* cap 3 = tap on + a kernel panel snapshot (patch 0276) at the end */
+	{ "rt-applib-back1",   1, 200, 1200, 900, 1200, 250,  900, 0 },
+	{ "rt-applib-back2",   1, 200, 1200, 900, 1200, 250, 1500, 0 },
+};
+#define SWEET_CAP_N ((unsigned)(sizeof(sweetCapActs) / sizeof(sweetCapActs[0])))
+/* kern.sweetnavrun flag 0x400 (hot-reload loop, sprint GPU 2026-11-10): ONLY the real-timing App Library pass, recorder off (two right swipes first so
+ * a previous iteration's App Library is left; three left swipes reach it from page 1 or from the Today view), tap on, kernel panel snapshot at the end */
+static const SweetCapAct sweetApplibActs[] = {
+	{ "al-unlock",         1, 540, 2350, 540,  900, 200, 2500, 0 },   /* gputest-alhot: after a backboardd restart iOS is on the lock screen (the calibrated unlock swipe) */
+	{ "al-back1",          1, 200, 1200, 900, 1200, 250,  900, 0 },
+	{ "al-back2",          1, 200, 1200, 900, 1200, 250,  900, 0 },
+	{ "al-swipe1",         1, 900, 1200, 200, 1200, 250,  900, 2 },
+	{ "al-swipe2",         1, 900, 1200, 200, 1200, 250,  900, 2 },
+	{ "al-swipe3",         1, 900, 1200, 200, 1200, 250, 1500, 3 },
+};
+#define SWEET_AL_N ((unsigned)(sizeof(sweetApplibActs) / sizeof(sweetApplibActs[0])))
+
+void
+SweetHIDTouch::navCapFired(SweetHIDTouch *self, IOTimerEventSource *sender)
+{
+	const SweetCapAct *tbl = self->fNavApplibOnly ? sweetApplibActs : sweetCapActs;
+	unsigned tbln = self->fNavApplibOnly ? SWEET_AL_N : SWEET_CAP_N;
+	if (self->fNavCap == 1) {
+		self->fNavCap = 2;
+		self->fNavCapIdx = 0;
+		self->fNavStep = 0;
+		gSweetNavCap = (self->fNavCapSeq << 16) | (self->fNavApplibOnly ? 0 : 1);   /* applib-only: recorder stays off */
+		IOLog("SWEET NAV: CAPREP start %u actions now %llu\n", SWEET_CAP_N, sweetNavNs());
+		sender->setTimeoutMS(3000);   /* libsweetgl polls every 50 ms and needs a full frame cycle recorded */
+		return;
+	}
+	if (self->fNavCapIdx >= tbln) {
+		gSweetNavCap = self->fNavCapSeq << 16;   /* recording and tap off */
+		self->fNavCap = 3;
+		IOLog("SWEET NAV: CAPREP done %u requests now %llu\n", self->fNavCapSeq, sweetNavNs());
+		sender->setTimeoutMS(self->fNavApplibOnly ? 3000 : 420000);   /* the host pulls the capture files (devd) before the done line ends the run */
+		return;
+	}
+	SweetCapAct act = tbl[self->fNavCapIdx];
+	unsigned st = self->fNavStep;
+	unsigned ticks = act.ms >= 10 ? act.ms / 10 : 1;
+	if (st == 0) {
+		if (act.cap == 2 || act.cap == 3) {
+			gSweetNavCap = (self->fNavCapSeq << 16) | 2;   /* recording off, tap on */
+			IOLog("SWEET NAV: TAP on (real-timing pass) now %llu\n", sweetNavNs());
+		} else if (gSweetNavCap & 2) {
+			gSweetNavCap = (self->fNavCapSeq << 16);   /* tap off, recording stays off for the rest */
+			IOLog("SWEET NAV: TAP off (real-timing pass) now %llu\n", sweetNavNs());
+		}
+		if (strcmp(act.name, "general-open") == 0) {   /* the patch 0269 probe, as in the measured repetitions */
+			int gy = 0, gruns = 0, gpur = -1;
+			int grc = sweet_fb_probe_general(&gy, &gruns, &gpur);
+			self->fNavGenY = (grc == 0 && gy >= 700 && gy <= 2340) ? gy : 1900;
+			IOLog("SWEET NAV: CAPACT general probe rc %d y %d -> tap 500,%d\n", grc, gy, self->fNavGenY);
+		}
+		IOLog("SWEET NAV: CAPACT %s begin cap %u now %llu\n", act.name, self->fNavCapIdx, sweetNavNs());
+	}
+	if (strcmp(act.name, "general-open") == 0 && self->fNavGenY > 0) {
+		act.y0 = self->fNavGenY;
+	}
+	if (act.kind == 0) {   /* a tap holds the finger (patch 0249) */
+		act.x1 = act.x0;
+		act.y1 = act.y0;
+	}
+	if (st <= ticks) {
+		int x = act.x0 + (act.x1 - act.x0) * (int)st / (int)ticks;
+		int y = act.y0 + (act.y1 - act.y0) * (int)st / (int)ticks;
+		self->touch(0, true, x, y);
+		self->fNavStep = st + 1;
+		sender->setTimeoutMS(10);
+		return;
+	}
+	if (st == ticks + 1) {
+		self->touch(0, false, act.x1, act.y1);
+		self->fNavStep = ticks + 2;
+		sender->setTimeoutMS(act.settle * 2);
+		return;
+	}
+	if (st == ticks + 2 && (act.cap == 1 || act.cap == 3)) {
+		/* gputest-count1: in capture mode frames are slow, the scroll was still settling at the request, and the 30 Hz panel copy showed an older
+		 * frame than the capture (c09/c10). Wait until no swap for 500 ms (polled every 50 ms, at most 6 s) so capture, panel snapshot and camera
+		 * see the same settled frame. */
+		uint64_t now = sweetNavNs(), sw = sweet_fb_swap_count;
+		if (self->fNavQuietT0 == 0) {
+			self->fNavQuietT0 = now; self->fNavQuietSw = sw; self->fNavQuietFlat = now;
+		} else if (sw != self->fNavQuietSw) {
+			self->fNavQuietSw = sw; self->fNavQuietFlat = now;
+		}
+		uint64_t flat = (now - self->fNavQuietFlat) / 1000000, waited = (now - self->fNavQuietT0) / 1000000;
+		if (flat < 500 && waited < 6000) {
+			sender->setTimeoutMS(50);
+			return;
+		}
+		IOLog("SWEET NAV: CAPQUIET %s flat %llu ms waited %llu ms%s\n", act.name, flat, waited, flat < 500 ? " (CAP: display never quiet)" : "");
+		self->fNavQuietT0 = 0;
+	}
+	if (st == ticks + 2) {
+		if (act.cap == 3) {
+			sweet_panel_snapshot("rt-applib");   /* patch 0276: what the panel shows at real timing, recorder off */
+		}
+		if (act.cap == 1) {
+			self->fNavCapSeq++;
+			snprintf(gSweetNavCapLbl, sizeof(gSweetNavCapLbl), "c%02u-%s", self->fNavCapIdx, act.name);
+			gSweetNavCap = (self->fNavCapSeq << 16) | 1;
+			IOLog("SWEET NAV: CAPREQ seq %u label %s now %llu\n", self->fNavCapSeq, gSweetNavCapLbl, sweetNavNs());
+			sweet_panel_snapshot(gSweetNavCapLbl);   /* patch 0276: the panel at the same moment as the capture request */
+		}
+		self->fNavStep = ticks + 3;
+		sender->setTimeoutMS(act.cap == 1 ? 5000 : 10);
+		return;
+	}
+	IOLog("SWEET NAV: CAPACT %s end cap %u now %llu\n", act.name, self->fNavCapIdx, sweetNavNs());
+	self->fNavStep = 0;
+	self->fNavCapIdx++;
+	sender->setTimeoutMS(400);
+}
+
+/* Patch 0275: kern.sweetnavrun = R | 0x100 (capture repetition) | 0x200 (tap) starts a new nav session on the running system (hot-reload loop,
+ * user 2026-11-09: no reboot per experiment). Same tables and markers as the boot-arg session; no unlock (the phone is unlocked), first action
+ * 1 s after the write; refused (EBUSY) while a session runs. Write as root: `fcapctl nav N` through devd. Input injection only. */
+int
+SweetHIDTouch::navRestart(unsigned v)
+{
+	unsigned reps = v & 0xff;
+	if (reps == 0 || reps > 5) {
+		return EINVAL;
+	}
+	if (fNav && (fNavRep < fNavReps || fNavCap == 1 || fNavCap == 2 || fNavStep != 0)) {
+		IOLog("SWEET NAV: RESTART refused (busy): rep %u of %u capture %u step %u idx %u\n", fNavRep, fNavReps, fNavCap, fNavStep, fNavIdx);
+		return EBUSY;
+	}
+	if (!fNav) {
+		fNav = IOTimerEventSource::timerEventSource(this, &SweetHIDTouch::navFired);
+		if (!fNav || !_hidWorkLoop || _hidWorkLoop->addEventSource(fNav) != kIOReturnSuccess) {
+			IOLog("SWEET GAP: HID sweetnavrun: timer or work loop unavailable\n");
+			if (fNav) {
+				fNav->release();
+				fNav = NULL;
+			}
+			return ENODEV;
+		}
+	}
+	fNavReps = reps;
+	fNavRep = 0;
+	fNavIdx = 1;   /* no unlock */
+	fNavStep = 0;
+	fNavRng = 0x5eed1234;
+	fNavCap = (v & 0x100) ? 1 : 0;
+	fNavCapIdx = 0;
+	fNavTap = (v & 0x200) ? 1 : 0;
+	fNavApplibOnly = (v & 0x400) ? 1 : 0;
+	if (fNavApplibOnly) {   /* no measured repetition: straight to the App Library pass */
+		fNavCap = 1;
+		fNavRep = fNavReps;
+	}
+	fNavAboutTaps = 0;
+	fNavGateT0 = 0;
+	gSweetNavCap = fNavCapSeq << 16;
+	IOLog("SWEET NAV: RESTART reps %u capture %u tap %u applib-only %u (kern.sweetnavrun 0x%x) now %llu\n", reps, fNavCap, fNavTap, fNavApplibOnly, v,
+	    sweetNavNs());
+	fNav->setTimeoutMS(1000);
+	return 0;
+}
+
+static int
+sweet_navrun_sysctl SYSCTL_HANDLER_ARGS
+{
+#pragma unused(arg1, arg2)
+	int v = 0;
+	int err = sysctl_handle_int(oidp, &v, 0, req);
+	if (err || !req->newptr) {
+		return err;
+	}
+	if (!gSweetTouch) {
+		return ENODEV;
+	}
+	return gSweetTouch->navRestart((unsigned)v);
+}
+SYSCTL_PROC(_kern, OID_AUTO, sweetnavrun, CTLTYPE_INT | CTLFLAG_RW | CTLFLAG_LOCKED, NULL, 0, sweet_navrun_sysctl, "I",
+    "sweet nav: write R|0x100|0x200 to start a session on the running system");
+
 #define SWEET_SCRIPT_STEPS 20
