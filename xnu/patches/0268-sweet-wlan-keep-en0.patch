+/* latch the bus dead with one GAP; later calls only count */
+static inline void en0l_dead(struct en0_live *b, const char *why, uint32_t a)
+{
+	b->bad_reads++;
+	if (!b->dead) {
+		b->dead = 1u;
+		en0l_gap(why, a);
+	}
