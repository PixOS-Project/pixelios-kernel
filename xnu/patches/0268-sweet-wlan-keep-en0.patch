+/* 1 when any word the plan overwrites has an all-ones SHADOW (= old) word: swg_d4d_st would stop the engine on it */
+static inline int en0l_ff_old(struct en0_live *b, const struct swdp_store *s, uint32_t n)
+{
+	uint32_t i, k, nw;
+	const uint32_t *sh;
