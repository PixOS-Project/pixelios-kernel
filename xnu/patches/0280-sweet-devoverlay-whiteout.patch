+/* patch 0280: remove an overlay-added regular file (SD_WHITEOUT entry); counts like a write (removed), a skip (absent) or a refusal. */
+static void
+sd_whiteout(const struct sd_ent *e, char *path, const char *shown, uint8_t *buf, uint64_t t0)
+{
+	char *tmp = sd_w.tmp, *orig = sd_w.orig;
+	size_t n = strlen(path);
+	bool ok = false;
+	for (size_t a = 0; a < sizeof(sd_wh_allow) / sizeof(sd_wh_allow[0]); a++) {
+		size_t pl = strlen(sd_wh_allow[a].pfx);
+		if (sd_wh_allow[a].kind == K_EXACT ? (n == pl && memcmp(path, sd_wh_allow[a].pfx, pl) == 0)
+		    : (n > pl && memcmp(path, sd_wh_allow[a].pfx, pl) == 0)) {
+			ok = true;
+		}
+	}
+	const char *why = !ok ? "whiteout outside /usr/local/, /private/var/dev/, /usr/lib/libsweetgl.dylib"
+	    : (e->usize != 0 ? "whiteout entry is not empty" : (!sd_verify(e, buf) ? "crc mismatch" : NULL));
+	if (!why && sd_names(path, tmp, sizeof(sd_w.tmp), orig, sizeof(sd_w.orig))) {
+		why = "name too long";
+	}
+	enum vtype vt = VNON, ot = VNON;
+	uint64_t sz = 0, osz = 0;
+	int serr = why ? 0 : sd_stat(path, &vt, &sz);
+	int oerr = why ? 0 : sd_stat(orig, &ot, &osz);
+	if (!why && oerr == 0) {
+		why = "has a .sweetorig (an overlay replaced a root-image file here: ship its standard copy instead)";
+	} else if (!why && oerr != ENOENT) {
+		why = "cannot check .sweetorig";
+	}
+	if (!why && serr == ENOENT) {
+		printf("SWEET DEV: absent %s (nothing to remove) %llu ms\n", shown, now_ms() - t0);
+		sd_ns++;
+		return;
+	}
+	if (!why && serr) {
+		printf("SWEET DEV: failed %s stat error %d\n", shown, serr);
+		sd_nr++;
+		return;
+	}
+	if (!why && vt != VREG) {
+		why = "target is not a regular file";
+	}
+	if (!why) {
+		why = sd_parents(path, ((size_t)-1));     /* every parent a real directory (NOFOLLOW), none created */
+	}
+	if (why) {
+		printf("SWEET DEV: refused %s (%s)\n", shown, why);
+		sd_nr++;
+		return;
+	}
+	int err = sd_rm(path);
+	if (err) {
+		printf("SWEET DEV: failed %s remove error %d\n", shown, err);
+		sd_nr++;
+		return;
+	}
+	printf("SWEET DEV: removed %s %llu ms\n", shown, now_ms() - t0);
+	sd_nw++;
+}
