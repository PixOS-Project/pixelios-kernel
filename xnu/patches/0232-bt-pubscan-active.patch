+/*
+ * patch 0232 (T-0936, W-BTSCAN): boot-arg sweetbtpubscan=2 = everything =1 does, plus the same 0x01 -> 0x00 rewrite in an ACTIVE 0x200b (LE_Scan_Type 0x01).
+ * Why [obs bt-up17 20261107T155645Z, docs/reviews/T-9947-proof.md]: a client scan made bluetoothd send `01 0b 20 07 01 40 00 30 00 01 00`; =1 passed it
+ * ("not passive"), the chip answered Scan Enable 0x12 (Core v5.4 Vol 4 Part E s.7.8.11: Own_Address_Type 0x01 or 0x03 with no HCI_LE_Set_Random_Address
+ * "shall return ... Invalid HCI Command Parameters (0x12)"), and bluetoothd's scan-stopped handler sub_1005798d4 takes `cbnz w1` at 0x100579910 to
+ * "Scan stopped improperly ... -- restart" and _exit(1) [bin]. Cost (review T-4b11-0226 #3, accepted for this diagnostic knob, opt-in value 2 only): s.7.8.10
+ * says an active scan may send scanning PDUs, so SCAN_REQ carries the controller's public address on air (never in a log row). One BT GAP row per active rewrite.
+ */
+static bool sbu_pubscan_active;
+static unsigned sbu_pubscan_nact, sbu_txrw_nact;          /* active rewrites: whole boot / in the last sbu_txrw call */
 static unsigned sbu_tx_off, sbu_tx_hlen, sbu_tx_need;     /* offset in the current H4 packet, its header length (type byte included), its total length */
 static uint8_t sbu_tx_type, sbu_tx_hdr[5], sbu_tx_scantype;
 
@@ -2203,6 +2213,7 @@ sbu_txrw(const uint8_t *p, size_t n, uint8_t *out, unsigned *nrw)
 	size_t o = 0;
 
