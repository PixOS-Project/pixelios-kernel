+				} else if (sbu_tx_scantype != 0x00 && !(sbu_pubscan_active && sbu_tx_scantype == 0x01)) {    /* review T-4b11-0226 #3: an active scan would put the public address in SCAN_REQ; only =2 accepts that */
 					SBU_GAP(SG_OTHER, "sweetbtpubscan: 0x200b LE_Scan_Type %#x is not passive: nothing rewritten", sbu_tx_scantype);
 				} else if (b == 0x01) {
 					b = 0x00;
 					(*nrw)++;
+					if (sbu_tx_scantype == 0x01) {
+						sbu_txrw_nact++;
+					}
 				} else {
 					SBU_GAP(SG_OTHER, "sweetbtpubscan: 0x200b Own_Address_Type %#x is not 0x01: nothing rewritten", b);
 				}
@@ -2300,9 +2314,13 @@ sbu_tx_kctl(const void *data, size_t len)
 
