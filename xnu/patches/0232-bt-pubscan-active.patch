@@ -2244,11 +2255,14 @@ sbu_txrw(const uint8_t *p, size_t n, uint8_t *out, unsigned *nrw)
 			if (sbu_pubscan_on && sbu_tx_type == 0x01 && sbu_tx_hdr[1] == 0x0b && sbu_tx_hdr[2] == 0x20 && sbu_tx_off == 4u + 5u) {    /* 0x200b parameter 5 = Own_Address_Type */
 				if (sbu_tx_hdr[3] != 7) {
