+				sbu_pubscan_nact++;
+				printf("BT GAP: sweetbtpubscan=2 rewrote Own_Address_Type of bluetoothd's ACTIVE 0x200b from 0x01 (random, no 0x2005 sent) to 0x00 (public) on the way to the chip (x%u, active x%u); SCAN_REQ carries the public address\n", sbu_pubscan_n, sbu_pubscan_nact);
+			} else if (e == 0) {
+				sbu_pubscan_n++;
+				printf("BT GAP: sweetbtpubscan=%d rewrote Own_Address_Type of bluetoothd's 0x200b from 0x01 (random, no 0x2005 sent) to 0x00 (public) on the way to the chip (x%u); diagnostic knob, bluetoothd still believes random\n", sbu_pubscan_active ? 2 : 1, sbu_pubscan_n);
 			} else {
 				SBU_GAP(SG_OTHER, "sweetbtpubscan: a 0x200b rewrite was not sent: tx error %d", e);
 			}
@@ -2391,6 +2409,24 @@ sbu_rx_thread(void *arg, wait_result_t w)
 	}
 }
 
+/* patch 0226 (T-4b11) boot-arg sweetbtpubscan=1, 0232 (T-0936) =2; a function so the host test drives the parse; any other non-zero value is a BT GAP row */
+static void
+sbu_pubscan_parse(void)
+{
+	int v = 0;
+
+	if (PE_parse_boot_argn("sweetbtpubscan", &v, sizeof(v))) {
+		if (v == 1 || v == 2) {
+			sbu_pubscan_on = true;
+			sbu_pubscan_active = v == 2;
+			printf("BT GAP: sweetbtpubscan=%d active: Own_Address_Type 0x01 (random) in bluetoothd's %s0x200b is rewritten to 0x00 (public) on the way to the chip (diagnostic knob, not a fix; bluetoothd sends no 0x2005 because the chip refuses VSC 0xfd48; one BT GAP row per rewrite)\n",
+			    v, v == 2 ? "passive AND active " : "passive ");
+		} else if (v != 0) {
+			SBU_GAP(SG_OTHER, "sweetbtpubscan=%d ignored: only 1 (passive scans) and 2 (passive + active scans) exist", v);
+		}
+	}
+}
