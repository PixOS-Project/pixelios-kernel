diff --git a/bsd/dev/sweet_mali.c b/bsd/dev/sweet_mali.c
new file mode 100644
index 0000000..14a51de
--- /dev/null
+++ b/bsd/dev/sweet_mali.c
@@ -0,0 +1,692 @@
+/*
+ * Mali-G78 (gs101, tBEx r0p1) job-manager driver core for XNU: GPU bring-up (kbase config registers, power), ONE address space (AS0) with a 4 GiB GPU VA window,
+ * in-order job submission to the job slots, a polling completion thread and a seqno fence. The IOKit user client (iokit/Kernel/arm/SweetMali.cpp, patch 0105)
+ * is a thin wrapper around the sweet_mali_* functions at the end of this file; memory (BOs) is owned by the wrapper, this file only maps/unmaps physical 16 KB pages.
+ * Every register, value and sequence is from docs/research/31-kbase-port-checklist.md (kbase 696fc02, file:line there) or observed in runs job1/gpujob1
+ * (docs/research/28 s.11, 30 s.8); deviations are marked "ponytail:". Boot-arg sweetmali=1 brings it up (service for the user client), sweetmali=2 additionally
+ * runs a self-test through the public API (one WRITE_VALUE job in a BO). Not implemented (documented ceilings): interrupts (the thread polls JOB_IRQ_RAWSTAT every
+ * 200 us while a job runs), more than one job in flight, power-off, DVFS. A hung job or an MMU fault ends in a soft reset (sm_reset), the device is dead only if that fails.
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/errno.h>
+#include <kern/kalloc.h>
+#include <kern/clock.h>
+#include <kern/thread.h>
+#include <kern/sched_prim.h>
+#include <kern/locks.h>
+#include <vm/vm_kern.h>
+#include <mach/vm_param.h>
+#include <pexpert/pexpert.h>
+#include <stdint.h>
+#include "sweet_mali_pt.h"
+#include "sweet_mali.h"
+
+extern void flush_dcache64(addr64_t, unsigned, int);
+extern vm_offset_t kvtophys(vm_offset_t);
+extern int sweet_gpu_precheck(volatile uint32_t *g, int s2mpu_open, const char **why);   /* bsd/dev/sweet_gpu_job.c */
+extern int sweet_gpu_power_on(volatile uint32_t *g);
+
+#define R_GPU_ID          0x000u
+#define R_L2_FEATURES     0x004u
+#define R_TILER_FEATURES  0x00Cu
+#define R_MEM_FEATURES    0x010u
+#define R_MMU_FEATURES    0x014u
+#define R_AS_PRESENT      0x018u
+#define R_JS_PRESENT      0x01Cu
+#define R_GPU_IRQ_RAW     0x020u
+#define R_GPU_COMMAND     0x030u
+#define GPU_CMD_SOFT_RESET 1u
+#define GPU_CMD_HARD_RESET 2u
+#define GPU_IRQ_RESET_COMPLETED (1u << 8)
+#define R_GPU_IRQ_CLEAR   0x024u
+#define R_GPU_IRQ_MASK    0x028u
+#define R_THREAD_MAX_T    0x0A0u
+#define R_THREAD_MAX_WG   0x0A4u
+#define R_THREAD_MAX_BAR  0x0A8u
+#define R_THREAD_FEAT     0x0ACu
+#define R_TEX_FEAT0       0x0B0u
+#define R_AFBC_FEAT       0x04Cu
+#define R_SHADER_PRESENT  0x100u
+#define R_SHADER_READY    0x140u
+#define R_TILER_READY     0x150u
+#define R_L2_READY        0x160u
+#define R_COHERENCY_EN    0x304u
+#define R_JM_CONFIG       0xF00u
+#define R_SHADER_CONFIG   0xF04u
+#define R_L2_MMU_CONFIG   0xF0Cu
+#define R_JOB_RAW         0x1000u
+#define R_JOB_CLEAR       0x1004u
+#define R_JOB_MASK        0x1008u
+#define R_JS_BASE(n)      (0x1800u + 0x80u * (n))
+#define JS_HEAD           0x00u
+#define JS_COMMAND        0x20u
+#define JS_STATUS         0x24u
+#define JS_HEAD_NEXT      0x40u
+#define JS_AFFINITY_NEXT  0x50u
+#define JS_CONFIG_NEXT    0x58u
+#define JS_COMMAND_NEXT   0x60u
+#define R_MMU_RAW         0x2000u
+#define R_MMU_CLEAR       0x2004u
+#define R_MMU_MASK        0x2008u
+#define R_AS0             0x2400u
+#define AS_TRANSTAB       0x00u
+#define AS_MEMATTR        0x08u
+#define AS_LOCKADDR       0x10u
+#define AS_COMMAND        0x18u
+#define AS_FAULTSTATUS    0x1Cu
+#define AS_FAULTADDR      0x20u
+#define AS_STATUS         0x28u
+#define AS_TRANSCFG       0x30u
+#define AS_CMD_UPDATE     1u
+#define AS_CMD_LOCK       2u
+#define AS_CMD_FLUSH_MEM  5u
+#define JS_CMD_START      1u
+#define JS_CMD_HARD_STOP1 7u
+#define JS_ST_ACTIVE      0x08u
+/* values: docs/research/31 s.3.1, s.5.2; observed-working ones are marked */
+#define SHADERS           0x779FFFu
+#define TRANSCFG_ON       0x42000006u        /* observed */
+#define MEMATTR_LO        0x888D8F88u        /* observed */
+#define MEMATTR_HI        0x00004C8Du        /* observed */
+#define JS_CONFIG_VAL     0x00083B00u        /* observed; ponytail: kbase would use 0x85300 (flush reduction), research 31 s.2 advises keeping the proven value */
+#define IDVS_GROUP        (0xFu << 16)       /* JM_CONFIG, kbase pm_driver.c:3995-4047 */
+#define SC_VAR_ALGORITHM  (1u << 29)         /* SHADER_CONFIG, erratum TTRX_2968_TTRX_3162, pm_driver.c:4058 */
+#define COHERENCY_NONE    31u                /* kbase default for a DT without system-coherency, core_linux.c:5320 */
+#define JOB_TIMEOUT_US    3000000u           /* ponytail: kbase hard-stops at ~5 s of soft-stop ticks (research 31 s.2); 3 s is our choice */
+#define STOP_GRACE_US     500000u
+
+static int sm_reset(void);
+static LCK_GRP_DECLARE(sm_grp, "sweet_mali");
+static LCK_MTX_DECLARE(sm_lock, &sm_grp);
+
+static struct {
+	volatile uint32_t *g;
+	int up, dead;
+	struct mali_va va;
+	struct mali_pt pt;
+	uint8_t *pool[64];                      /* 64 KB chunks of page tables */
+	unsigned pool_n, pool_used;             /* chunks, 4 KB tables used in the last chunk */
+	int busy;                               /* a job is in flight */
+	unsigned busy_slot;
+	uint64_t busy_seq, seq_next, seq_done, busy_start_us;
+	int stopped, faulted;
+	uint64_t fail_seq[32];                  /* ring of failed seqnos (exception in the job status) */
+	thread_t thread;
+} sm;
+
+static uint32_t rr(uint32_t off) { return sm.g[off / 4]; }
+static void wr(uint32_t off, uint32_t v) { sm.g[off / 4] = v; }
+
+static uint64_t
+now_us(void)
+{
+	uint64_t t;
+	clock_get_uptime(&t);
+	absolutetime_to_nanoseconds(t, &t);
+	return t / 1000;
+}
+
+#define WAITC(cond, us) ({ int ok_ = 0; uint64_t t0_ = now_us(); while (now_us() - t0_ < (us)) { if (cond) { ok_ = 1; break; } delay(10); } ok_ || (cond); })
+
+static uint64_t *
+sm_table_alloc(void *ctx, uint64_t *pa)
+{
+	(void)ctx;
+	if (sm.pool_n == 0 || sm.pool_used == 16) {
+		vm_offset_t va = 0;
+		if (sm.pool_n == 64 || kmem_alloc_contig(kernel_map, &va, 0x10000, PAGE_MASK, 0, 0, KMA_DATA | KMA_ZERO | KMA_PERMANENT, VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
+			return NULL;
+		}
+		sm.pool[sm.pool_n++] = (uint8_t *)va;
+		sm.pool_used = 0;
+	}
+	uint8_t *t = sm.pool[sm.pool_n - 1] + 0x1000u * sm.pool_used++;
+	*pa = (uint64_t)kvtophys((vm_offset_t)t);
+	return (uint64_t *)t;
+}
+
+/* clean+invalidate the page-table pages the GPU walker will read: L0, L1, every L2 and the L3 tables covering [va, va + len) */
+static void
+sm_pt_clean(uint64_t va, uint64_t len)
+{
+	flush_dcache64((addr64_t)sm.pt.l0_pa, 0x1000, TRUE);
+	flush_dcache64((addr64_t)sm.pt.l1_pa, 0x1000, TRUE);
+	for (unsigned i = 0; i < 4; i++) {
+		if (sm.pt.l2[i]) {
+			flush_dcache64((addr64_t)sm.pt.l2_pa[i], 0x1000, TRUE);
+		}
+	}
+	for (uint64_t a = va & ~0x1FFFFFull; a < va + len; a += 0x200000ull) {
+		if (sm.pt.l3[(uint32_t)(a >> 21)]) {
+			flush_dcache64((addr64_t)sm.pt.l3_pa[(uint32_t)(a >> 21)], 0x1000, TRUE);
+		}
+	}
+}
+
+static int
+as_idle(void)
+{
+	return WAITC(!(rr(R_AS0 + AS_STATUS) & 1u), 100000);
+}
+
+static unsigned
+fls64_(uint64_t x)
+{
+	return x ? 64u - (unsigned)__builtin_clzll(x) : 0;
+}
+
+/* lock + flush the region after a live page-table change (research 31 s.3.2: LOCKADDR, LOCK, FLUSH_MEM, wait); min lock region 32 KiB on arch 9 */
+static int
+as_flush(uint64_t va, uint64_t len)
+{
+	uint64_t start = va, end = va + len - 1;
+	unsigned l = fls64_(start ^ end);
+	if (l < 15) {
+		l = 15;
+	}
+	uint64_t la = (start & ~((1ull << l) - 1)) | (l - 1);
+	if (!as_idle()) {
+		return 1;
+	}
+	wr(R_AS0 + AS_LOCKADDR, (uint32_t)la);
+	wr(R_AS0 + AS_LOCKADDR + 4, (uint32_t)(la >> 32));
+	wr(R_AS0 + AS_COMMAND, AS_CMD_LOCK);
+	if (!as_idle()) {
+		return 1;
+	}
+	wr(R_AS0 + AS_COMMAND, AS_CMD_FLUSH_MEM);
+	return !as_idle();
+}
+
+static int
+as0_enable(void)
+{
+	uint64_t t = sm.pt.l0_pa;
+	wr(R_AS0 + AS_TRANSCFG, TRANSCFG_ON);
+	wr(R_AS0 + AS_TRANSCFG + 4, 0);
+	wr(R_AS0 + AS_TRANSTAB, (uint32_t)t);
+	wr(R_AS0 + AS_TRANSTAB + 4, (uint32_t)(t >> 32));
+	wr(R_AS0 + AS_MEMATTR, MEMATTR_LO);
+	wr(R_AS0 + AS_MEMATTR + 4, MEMATTR_HI);
+	if (!as_idle()) {
+		return 1;
+	}
+	wr(R_AS0 + AS_COMMAND, AS_CMD_UPDATE);
+	return !as_idle();
+}
+
+static void
+finish(int failed)
+{
+	/* lock held */
+	if (failed) {
+		sm.fail_seq[sm.busy_seq % 32] = sm.busy_seq;
+	}
+	if (sm.faulted) {
+		/* the AS needs recovery after a fault (kbase kills it, mmu_jm.c:177-191): soft reset + AS0 re-enable; dead only if that fails */
+		printf("SWEET MALI: MMU fault seq=%llu, resetting the GPU\n", sm.busy_seq);
+		sm.fail_seq[sm.busy_seq % 32] = sm.busy_seq;
+		if (sm_reset()) {
+			sm.dead = 1;
+		}
+	}
+	sm.seq_done = sm.busy_seq;
+	sm.busy = 0;
+	thread_wakeup((event_t)&sm.seq_done);
+}
+
+static void
+check_job(void)
+{
+	/* lock held, a job is in flight */
+	uint32_t raw = rr(R_JOB_RAW), mmu = rr(R_MMU_RAW), bit = 1u << sm.busy_slot, fbit = 0x10000u << sm.busy_slot;
+	uint64_t el = now_us() - sm.busy_start_us;
+
+	if (mmu) {
+		printf("SWEET MALI: MMU fault seq=%llu MMU_RAW=%#x AS0_FAULTSTATUS=%#x FAULTADDR=%#x%08x\n", sm.busy_seq, mmu, rr(R_AS0 + AS_FAULTSTATUS),
+		    rr(R_AS0 + AS_FAULTADDR + 4), rr(R_AS0 + AS_FAULTADDR));
+		wr(R_MMU_CLEAR, mmu);
+		sm.faulted = 1;
+		if (!sm.stopped) {
+			wr(R_JS_BASE(sm.busy_slot) + JS_COMMAND, JS_CMD_HARD_STOP1);
+			sm.stopped = 1;
+			sm.busy_start_us = now_us();      /* the stop grace period starts now (review M4) */
+		}
+	}
+	if (raw & (bit | fbit)) {
+		uint32_t st = rr(R_JS_BASE(sm.busy_slot) + JS_STATUS);
+		wr(R_JOB_CLEAR, raw & (bit | fbit));
+		if (raw & fbit) {
+			printf("SWEET MALI: job seq=%llu slot=%u failed JS_STATUS=%#x\n", sm.busy_seq, sm.busy_slot, st);
+		}
+		finish((raw & fbit) != 0);
+		return;
+	}
+	if (!sm.stopped && el > JOB_TIMEOUT_US) {
+		printf("SWEET MALI: job seq=%llu slot=%u timed out after %llu us, hard stop\n", sm.busy_seq, sm.busy_slot, el);
+		wr(R_JS_BASE(sm.busy_slot) + JS_COMMAND, JS_CMD_HARD_STOP1);
+		sm.stopped = 1;
+		sm.busy_start_us = now_us();
+	} else if (sm.stopped && el > STOP_GRACE_US) {
+		printf("SWEET MALI: job seq=%llu did not stop, resetting the GPU\n", sm.busy_seq);
+		sm.faulted = 1;                     /* finish() resets */
+		finish(1);
+	}
+}
+
+static void
+sm_thread(void *arg __unused, wait_result_t w __unused)
+{
+	for (;;) {
+		uint64_t dl;
+		lck_mtx_lock(&sm_lock);
+		if (sm.busy) {
+			check_job();
+		}
+		if (sm.busy) {
+			clock_interval_to_deadline(200, NSEC_PER_USEC, &dl);
+		} else {
+			clock_interval_to_deadline(1000000, NSEC_PER_USEC, &dl);   /* idle: woken by submit */
+		}
+		(void)lck_mtx_sleep_deadline(&sm_lock, LCK_SLEEP_DEFAULT, (event_t)&sm.thread, THREAD_UNINT, dl);
+		lck_mtx_unlock(&sm_lock);
+	}
+}
+
+/* ---------------- public API (patch 0105 wrapper, self-test) ---------------- */
+
+int
+sweet_mali_ready(void)
+{
+	return sm.up && !sm.dead;
+}
+
+int
+sweet_mali_query(struct sweet_mali_info *o)
+{
+	if (!sweet_mali_ready()) {
+		return ENXIO;
+	}
+	o->gpu_id = rr(R_GPU_ID);
+	o->l2_features = rr(R_L2_FEATURES);
+	o->tiler_features = rr(R_TILER_FEATURES);
+	o->mem_features = rr(R_MEM_FEATURES);
+	o->mmu_features = rr(R_MMU_FEATURES);
+	o->as_present = rr(R_AS_PRESENT);
+	o->js_present = rr(R_JS_PRESENT);
+	o->thread_max_threads = rr(R_THREAD_MAX_T);
+	o->thread_max_workgroup = rr(R_THREAD_MAX_WG);
+	o->thread_max_barrier = rr(R_THREAD_MAX_BAR);
+	o->thread_features = rr(R_THREAD_FEAT);
+	for (unsigned i = 0; i < 4; i++) {
+		o->texture_features[i] = rr(R_TEX_FEAT0 + 4 * i);
+	}
+	o->afbc_features = rr(R_AFBC_FEAT);
+	o->shader_present = rr(R_SHADER_PRESENT);
+	o->va_start = MALI_VA_START;
+	o->va_end = MALI_VA_END;
+	return 0;
+}
+
+/* Map n 16 KB physical pages (given by PA) into the GPU VA window; flags: SWEET_MALI_EXEC. Returns 0 and *va. The caller keeps the pages wired.
+ * Contract (review H2): ENOMEM/EINVAL = nothing is mapped. EIO/ENXIO = the mapping may still exist in the GPU, the caller must NOT free the pages (leak them). */
+int
+sweet_mali_map(const uint64_t *pa16k, uint32_t n, uint32_t flags, uint64_t *va_out)
+{
+	int e = 0;
+	uint64_t va;
+
+	if (!sweet_mali_ready()) {
+		return ENXIO;
+	}
+	if (n == 0 || n > 0x10000) {
+		return EINVAL;
+	}
+	for (uint32_t i = 0; i < n; i++) {
+		if ((pa16k[i] & (PAGE_SIZE - 1)) || pa16k[i] >= (1ull << 40)) {
+			return EINVAL;
+		}
+	}
+	lck_mtx_lock(&sm_lock);
+	va = mali_va_alloc(&sm.va, n * 4u, 4u);
+	if (va == 0) {
+		lck_mtx_unlock(&sm_lock);
+		return ENOMEM;
+	}
+	for (uint32_t i = 0; i < n && !e; i++) {
+		flush_dcache64((addr64_t)pa16k[i], PAGE_SIZE, TRUE);          /* CPU-dirty lines of the new BO must not be written back over GPU data later */
+		for (uint32_t k = 0; k < 4 && !e; k++) {
+			e = mali_pt_map(&sm.pt, va + (uint64_t)(i * 4u + k) * MALI_PG, pa16k[i] + 0x1000ull * k, flags & SWEET_MALI_EXEC ? MALI_F_EXEC : 0);
+		}
+	}
+	if (e) {
+		for (uint32_t j = 0; j < n * 4u; j++) {
+			(void)mali_pt_unmap(&sm.pt, va + (uint64_t)j * MALI_PG);
+		}
+		(void)mali_va_free(&sm.va, va, n * 4u);
+		sm_pt_clean(va, (uint64_t)n * PAGE_SIZE);
+		lck_mtx_unlock(&sm_lock);
+		return ENOMEM;
+	}
+	sm_pt_clean(va, (uint64_t)n * PAGE_SIZE);
+	if (as_flush(va, (uint64_t)n * PAGE_SIZE)) {
+		sm.dead = 1;
+		printf("SWEET MALI: AS0 flush after map did not complete, device marked dead\n");
+		lck_mtx_unlock(&sm_lock);
+		return EIO;
+	}
+	lck_mtx_unlock(&sm_lock);
+	*va_out = va;
+	return 0;
+}
+
+/* Contract (review H1/H2): the caller may only unmap a range it mapped (0105 tracks that per client). 0 = unmapped and flushed. Any other return (EINVAL: nothing changed;
+ * EIO/ENXIO: the GPU may STILL reach the pages) means the caller must NOT free or reuse the memory. */
+int
+sweet_mali_unmap(uint64_t va, uint32_t n)
+{
+	int e;
+
+	if (!sweet_mali_ready()) {
+		return ENXIO;
+	}
+	if (n == 0 || n > 0x10000 || (va & (PAGE_SIZE - 1)) || va < MALI_VA_START || va > MALI_VA_END || (uint64_t)n * PAGE_SIZE > MALI_VA_END - va) {
+		return EINVAL;
+	}
+	lck_mtx_lock(&sm_lock);
+	if (mali_va_free(&sm.va, va, n * 4u)) {        /* not (fully) allocated: touch nothing */
+		lck_mtx_unlock(&sm_lock);
+		return EINVAL;
+	}
+	for (uint32_t j = 0; j < n * 4u; j++) {
+		(void)mali_pt_unmap(&sm.pt, va + (uint64_t)j * MALI_PG);
+	}
+	e = 0;
+	sm_pt_clean(va, (uint64_t)n * PAGE_SIZE);
+	if (as_flush(va, (uint64_t)n * PAGE_SIZE)) {
+		sm.dead = 1;
+		printf("SWEET MALI: AS0 flush after unmap did not complete, device marked dead\n");
+		e = EIO;
+	}
+	lck_mtx_unlock(&sm_lock);
+	return e;
+}
+
+/* Submit one job chain (jc = GPU VA of the first job descriptor). req: SWEET_MALI_REQ_FS runs it on JS0, otherwise JS1 (research 31 s.2: fragment on JS0, the rest
+ * on JS1). ponytail: strictly one job in flight; this call waits (bounded) for the previous one, which also gives the fragment-after-tiler order Mesa needs.
+ * Returns 0 and the seqno to wait on. */
+int
+sweet_mali_submit(uint64_t jc, uint32_t req, uint64_t *seq)
+{
+	unsigned slot = (req & SWEET_MALI_REQ_FS) ? 0u : 1u;
+	uint64_t t0 = now_us();
+
+	if (!sweet_mali_ready()) {
+		return ENXIO;
+	}
+	if (jc < MALI_VA_START || jc >= MALI_VA_END || (jc & 7ull)) {
+		return EINVAL;
+	}
+	lck_mtx_lock(&sm_lock);
+	while (sm.busy && !sm.dead) {
+		uint64_t dl;
+		if (now_us() - t0 > 2 * JOB_TIMEOUT_US) {
+			lck_mtx_unlock(&sm_lock);
+			return ETIMEDOUT;
+		}
+		clock_interval_to_deadline(2000, NSEC_PER_USEC, &dl);
+		(void)lck_mtx_sleep_deadline(&sm_lock, LCK_SLEEP_DEFAULT, (event_t)&sm.seq_done, THREAD_UNINT, dl);
+	}
+	if (sm.dead) {
+		lck_mtx_unlock(&sm_lock);
+		return ENXIO;
+	}
+	if (rr(R_JS_BASE(slot) + JS_COMMAND_NEXT) != 0 || rr(R_JOB_RAW) != 0 || rr(R_MMU_RAW) != 0) {
+		printf("SWEET MALI: submit refused, slot %u not clean (CMD_NEXT=%#x JOB_RAW=%#x MMU_RAW=%#x)\n", slot, rr(R_JS_BASE(slot) + JS_COMMAND_NEXT), rr(R_JOB_RAW), rr(R_MMU_RAW));
+		lck_mtx_unlock(&sm_lock);
+		return EBUSY;
+	}
+	sm.busy_seq = ++sm.seq_next;
+	sm.busy_slot = slot;
+	sm.stopped = 0;
+	sm.faulted = 0;
+	sm.busy_start_us = now_us();
+	wr(R_JS_BASE(slot) + JS_HEAD_NEXT, (uint32_t)jc);
+	wr(R_JS_BASE(slot) + JS_HEAD_NEXT + 4, (uint32_t)(jc >> 32));
+	wr(R_JS_BASE(slot) + JS_AFFINITY_NEXT, SHADERS);
+	wr(R_JS_BASE(slot) + JS_AFFINITY_NEXT + 4, 0);
+	wr(R_JS_BASE(slot) + JS_CONFIG_NEXT, JS_CONFIG_VAL);
+	sm.busy = 1;
+	wr(R_JS_BASE(slot) + JS_COMMAND_NEXT, JS_CMD_START);
+	*seq = sm.busy_seq;
+	thread_wakeup((event_t)&sm.thread);
+	lck_mtx_unlock(&sm_lock);
+	return 0;
+}
+
+/* wait until seq has completed; 0 ok, EIO the job failed, ETIMEDOUT, ENXIO dead. timeout_us is relative. */
+int
+sweet_mali_wait(uint64_t seq, uint64_t timeout_us)
+{
+	uint64_t t0 = now_us();
+	int e = 0;
+
+	lck_mtx_lock(&sm_lock);
+	while (sm.seq_done < seq) {
+		uint64_t dl, el = now_us() - t0;
+		if (sm.dead) {
+			e = ENXIO;
+			break;
+		}
+		if (el >= timeout_us) {
+			e = ETIMEDOUT;
+			break;
+		}
+		clock_interval_to_deadline(timeout_us - el > 1000 ? 1000 : timeout_us - el, NSEC_PER_USEC, &dl);
+		(void)lck_mtx_sleep_deadline(&sm_lock, LCK_SLEEP_DEFAULT, (event_t)&sm.seq_done, THREAD_UNINT, dl);
+	}
+	if (!e && sm.fail_seq[seq % 32] == seq) {
+		e = EIO;
+	}
+	lck_mtx_unlock(&sm_lock);
+	return e;
+}
+
+/* ---------------- bring-up ---------------- */
+
+/* kbase order after (re)set (research 31 s.5.2): config registers, coherency, IRQ masks (we poll), power. The cores must be off. */
+static int
+sm_hw_config_and_power(volatile uint32_t *g, int skip_config)
+{
+	sm.g = g;
+	printf("SWEET MALI: config before JM=%#x SHADER=%#x L2_MMU=%#x COHERENCY=%#x%s\n", rr(R_JM_CONFIG), rr(R_SHADER_CONFIG), rr(R_L2_MMU_CONFIG), rr(R_COHERENCY_EN),
+	    skip_config ? " (config writes skipped: sweetmali bit 4, bisect aid)" : "");
+	if (!skip_config) {
+		wr(R_JM_CONFIG, rr(R_JM_CONFIG) | IDVS_GROUP);
+		wr(R_SHADER_CONFIG, rr(R_SHADER_CONFIG) | SC_VAR_ALGORITHM);
+		wr(R_L2_MMU_CONFIG, rr(R_L2_MMU_CONFIG) & ~((0x3Fu << 5) | (0x1Fu << 12)));   /* kbase clears b10:5 and b16:12 */
+		wr(R_COHERENCY_EN, COHERENCY_NONE);
+	}
+	wr(R_GPU_IRQ_MASK, 0);
+	wr(R_JOB_MASK, 0);
+	wr(R_MMU_MASK, 0);
+	wr(R_GPU_IRQ_CLEAR, rr(R_GPU_IRQ_RAW));
+	printf("SWEET MALI: config JM=%#x SHADER=%#x L2_MMU=%#x COHERENCY=%#x\n", rr(R_JM_CONFIG), rr(R_SHADER_CONFIG), rr(R_L2_MMU_CONFIG), rr(R_COHERENCY_EN));
+	return sweet_gpu_power_on(g);
+}
+
+static int sm_skip_config;
+
+/* Soft reset (kbase_pm_do_reset, pm_driver.c:4286-4425): unmask RESET_COMPLETED first (Pixel b/290409680), GPU_COMMAND = SOFT_RESET, wait up to 500 ms for the raw bit, else
+ * HARD_RESET and 500 ms more; then redo config + power + AS0 (the page tables are in memory and unchanged). Lock held, no job in flight. 0 = recovered. */
+static int
+sm_reset_do(void)
+{
+	int ok;
+
+	wr(R_JOB_MASK, 0);
+	wr(R_MMU_MASK, 0);
+	wr(R_JOB_CLEAR, 0xFFFFFFFFu);
+	wr(R_MMU_CLEAR, 0xFFFFFFFFu);
+	wr(R_GPU_IRQ_CLEAR, 0xFFFFFFFFu);
+	/* review M2: kbase unmasks RESET_COMPLETED here (b/290409680), but nothing in XNU masks or handles SPI 419 and one stuck level interrupt would hang the only CPU; the raw bit is polled, so the mask stays 0 until run malireset1 shows whether the raw bit still sets */
+	wr(R_GPU_IRQ_MASK, 0);
+	wr(R_GPU_COMMAND, GPU_CMD_SOFT_RESET);
+	ok = WAITC(rr(R_GPU_IRQ_RAW) & GPU_IRQ_RESET_COMPLETED, 500000);
+	if (!ok) {
+		printf("SWEET MALI: soft reset did not complete in 500 ms, hard reset\n");
+		wr(R_GPU_COMMAND, GPU_CMD_HARD_RESET);
+		ok = WAITC(rr(R_GPU_IRQ_RAW) & GPU_IRQ_RESET_COMPLETED, 500000);
+	}
+	if (!ok) {
+		printf("SWEET MALI: GPU reset failed\n");
+		return 1;
+	}
+	wr(R_GPU_IRQ_CLEAR, 0xFFFFFFFFu);
+	if (rr(R_SHADER_READY) || rr(R_TILER_READY) || rr(R_L2_READY)) {
+		printf("SWEET MALI: cores still ready after reset (SHADER=%#x TILER=%#x L2=%#x), refusing to continue\n", rr(R_SHADER_READY), rr(R_TILER_READY), rr(R_L2_READY));
+		return 1;
+	}
+	if (sm_hw_config_and_power(sm.g, sm_skip_config) || as0_enable()) {
+		printf("SWEET MALI: re-initialisation after reset failed\n");
+		return 1;
+	}
+	printf("SWEET MALI: GPU reset done, cores back, AS0 re-enabled\n");
+	return 0;
+}
+
+/* review M1: any failed reset leaves the hardware in an unknown state, so the device is dead */
+static int
+sm_reset(void)
+{
+	int r = sm_reset_do();
+
+	if (r) {
+		sm.dead = 1;
+	}
+	return r;
+}
+
+static int
+sm_bringup(volatile uint32_t *g, int s2mpu_open, int skip_config)
+{
+	const char *why = NULL;
+
+	sm.g = g;
+	if (sweet_gpu_precheck(g, s2mpu_open, &why)) {
+		printf("SWEET MALI: refused, zero writes: %s\n", why);
+		return 1;
+	}
+	/* kbase writes the config registers only with the cores off (review M2), and JS1 must be as clean as JS0 (review M1) */
+	if (rr(R_SHADER_READY) || rr(R_TILER_READY) || rr(R_L2_READY) || rr(R_JS_BASE(1) + JS_COMMAND_NEXT) || rr(R_JS_BASE(1) + JS_STATUS)) {
+		printf("SWEET MALI: refused, zero writes: cores already on or JS1 busy (do not combine with sweetgpujob=1)\n");
+		return 1;
+	}
+	sm_skip_config = skip_config;
+	if (mali_pt_init(&sm.pt, (struct mali_pt_ops){ sm_table_alloc, NULL })) {
+		printf("SWEET MALI: no memory for the page tables\n");
+		return 1;
+	}
+	sm_pt_clean(MALI_VA_START, MALI_PG);
+	if (sm_hw_config_and_power(g, skip_config)) {
+		return 1;
+	}
+	if (as0_enable()) {
+		printf("SWEET MALI: AS0 UPDATE failed\n");
+		return 1;
+	}
+	if (kernel_thread_start(sm_thread, NULL, &sm.thread) != KERN_SUCCESS) {
+		printf("SWEET MALI: no completion thread\n");
+		return 1;
+	}
+	sm.up = 1;
+	printf("SWEET MALI: up, GPU VA window %#llx-%#llx, AS0 enabled\n", MALI_VA_START, MALI_VA_END);
+	return 0;
+}
+
+/* sweetmali=2: WRITE_VALUE jobs through the public API: first on JS0 (the slot of the proven gpujob1 run), then on JS1 (the slot Mesa uses for vertex/tiler/compute;
+ * JS1_FEATURES bit 2 was 1 in the review's read of the source). Same descriptor as gpujob1 (header word 4 = 0x10004, payload +0x20 address, +0x28 type 7, +0x30 value). */
+#define ST_MAGIC0 0x504958454C494F53ull
+#define ST_MAGIC1 0x4D414C4931534C31ull
+
+static int
+sm_selftest_job(vm_offset_t buf, uint64_t va, uint64_t pa, uint32_t off, uint32_t tgt, uint64_t magic, uint32_t req, uint64_t *got)
+{
+	uint64_t seq = 0;
+	volatile uint32_t *d = (volatile uint32_t *)(buf + off);
+
+	d[0x10 / 4] = 0x10004u;
+	*(volatile uint64_t *)(buf + off + 0x20) = va + tgt;
+	d[0x28 / 4] = 0x7u;
+	*(volatile uint64_t *)(buf + off + 0x30) = magic;
+	*(volatile uint64_t *)(buf + tgt) = 0xa5a5a5a5a5a5a5a5ull;
+	flush_dcache64((addr64_t)pa, PAGE_SIZE, TRUE);
+	int e = sweet_mali_submit(va + off, req, &seq);
+	if (!e) {
+		e = sweet_mali_wait(seq, 4000000);          /* the hard stop comes at 3 s (JOB_TIMEOUT_US) */
+	}
+	flush_dcache64((addr64_t)pa, PAGE_SIZE, TRUE);
+	*got = *(volatile uint64_t *)(buf + tgt);
+	printf("SWEET MALI: selftest slot=%s submit/wait=%d seq=%llu target=%#llx (%s) header_exc=%#x\n", (req & SWEET_MALI_REQ_FS) ? "JS0" : "JS1", e, seq, *got,
+	    *got == magic ? "MAGIC" : "wrong", d[0]);
+	return e;
+}
+
+static int sm_selftest_reset;
+
+static void
+sm_selftest(void)
+{
+	vm_offset_t buf = 0;
+	uint64_t pa[1], va = 0, got0 = 0, got1 = 0;
+
+	if (kmem_alloc_contig(kernel_map, &buf, PAGE_SIZE, PAGE_MASK, 0, 0, KMA_DATA | KMA_ZERO | KMA_PERMANENT, VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
+		printf("SWEET MALI: selftest: no memory\n");
+		return;
+	}
+	pa[0] = (uint64_t)kvtophys(buf);
+	int e = sweet_mali_map(pa, 1, SWEET_MALI_EXEC, &va);
+	if (e) {
+		printf("SWEET MALI: selftest: map failed %d\n", e);
+		return;
+	}
+	int e0 = sm_selftest_job(buf, va, pa[0], 0x000, 0x100, ST_MAGIC0, SWEET_MALI_REQ_FS, &got0);
+	int e1 = (e0 == 0 && got0 == ST_MAGIC0) ? sm_selftest_job(buf, va, pa[0], 0x200, 0x300, ST_MAGIC1, 0, &got1) : -1;
+	if (sm_selftest_reset && e1 == 0 && got1 == ST_MAGIC1) {
+		lck_mtx_lock(&sm_lock);
+		int re = sm_reset();
+		lck_mtx_unlock(&sm_lock);
+		uint64_t got2 = 0;
+		int e2 = re ? -1 : sm_selftest_job(buf, va, pa[0], 0x400, 0x500, ST_MAGIC0 ^ 0xFFull, SWEET_MALI_REQ_FS, &got2);
+		printf("SWEET MALI: selftest reset=%s job-after-reset=%s\n", re ? "FAIL" : "PASS", (e2 == 0 && got2 == (ST_MAGIC0 ^ 0xFFull)) ? "PASS" : "FAIL");
+	}
+	printf("SWEET MALI: selftest RESULT js0=%s js1=%s\n", (e0 == 0 && got0 == ST_MAGIC0) ? "PASS" : "FAIL", e1 == -1 ? "skipped" : (e1 == 0 && got1 == ST_MAGIC1) ? "PASS" : "FAIL");
+	if (!sm.dead && (e0 == 0 || e0 == EIO) && (e1 == 0 || e1 == EIO || e1 == -1)) {
+		(void)sweet_mali_unmap(va, 1);
+	} else {
+		printf("SWEET MALI: selftest: a job did not finish cleanly, the buffer stays mapped (leaked on purpose)\n");
+	}
+}
+
+void
+sweet_mali_init(volatile uint32_t *g, int s2mpu_open)
+{
+	static int started;
+	uint32_t mode = 0;
+
+	if (started || !PE_parse_boot_argn("sweetmali", &mode, sizeof(mode)) || (mode & 3u) == 0 || (mode & 3u) == 3) {
+		return;       /* sweetmali = 1 (service) or 2 (service + selftest), | 0x10 skips the kbase config writes */
+	}
+	started = 1;
+	sm_selftest_reset = (mode & 0x20u) != 0;      /* sweetmali=0x22: selftest + an explicit GPU reset and one more job */
+	if (sm_bringup(g, s2mpu_open, (mode & 0x10u) != 0)) {
+		return;
+	}
+	if ((mode & 3u) == 2) {
+		sm_selftest();
+	}
+}
+
+#endif /* ARM64_BOARD_CONFIG_SWEET */
diff --git a/bsd/dev/sweet_mali.h b/bsd/dev/sweet_mali.h
new file mode 100644
index 0000000..8a210f8
--- /dev/null
+++ b/bsd/dev/sweet_mali.h
@@ -0,0 +1,30 @@
+/* Public interface of the Mali-G78 driver core (bsd/dev/sweet_mali.c) for the IOKit wrapper. */
+#ifndef SWEET_MALI_H
+#define SWEET_MALI_H
+#include <stdint.h>
+
+#define SWEET_MALI_EXEC    1u            /* map: the GPU may execute (shader code) */
+#define SWEET_MALI_REQ_FS  1u            /* submit: fragment job chain, runs on JS0 */
+
+struct sweet_mali_info {
+	uint32_t gpu_id, l2_features, tiler_features, mem_features, mmu_features, as_present, js_present;
+	uint32_t thread_max_threads, thread_max_workgroup, thread_max_barrier, thread_features, texture_features[4], afbc_features, shader_present;
+	uint64_t va_start, va_end;
+};
+
+/* Ownership/failure contract (review gpu-mali-core-review-1 H1/H2): sweet_mali_unmap takes only ranges the caller mapped. For sweet_mali_map and sweet_mali_unmap, EIO or ENXIO means the
+ * GPU may still reach the pages: the caller must leak them, never free or reuse them. EINVAL/ENOMEM mean nothing changed. */
+#ifdef __cplusplus
+extern "C" {
+#endif
+void sweet_mali_init(volatile uint32_t *g, int s2mpu_open);
+int sweet_mali_ready(void);
+int sweet_mali_query(struct sweet_mali_info *o);
+int sweet_mali_map(const uint64_t *pa16k, uint32_t n16k, uint32_t flags, uint64_t *va_out);
+int sweet_mali_unmap(uint64_t va, uint32_t n16k);
+int sweet_mali_submit(uint64_t jc, uint32_t req, uint64_t *seq);
+int sweet_mali_wait(uint64_t seq, uint64_t timeout_us);
+#ifdef __cplusplus
+}
+#endif
+#endif
diff --git a/bsd/dev/sweet_mali_pt.h b/bsd/dev/sweet_mali_pt.h
new file mode 100644
index 0000000..dfe7d1a
--- /dev/null
+++ b/bsd/dev/sweet_mali_pt.h
@@ -0,0 +1,180 @@
+/*
+ * Mali-G78 (gs101) GPU virtual address space: first-fit VA allocator below 4 GiB and a 4-level, 4 KB-granule page-table builder (AArch64 format, kbase
+ * mmu_mode_aarch64.c). Pure code, no kernel headers: shim/mali_pt_host_test.c builds this file with plain cc (shim/build.sh extracts it from xnu patch 0104).
+ * Formats [read from source]: table entry = next-level PA | ACCESS(1<<10) | type 3 (mmu_mode_aarch64.c:180-183 -> 0x403 for a PA with zero low bits);
+ * leaf (L3) = PA | ACCESS(1<<10) | type 3 | RW(1<<6) | memattr index << 2 | NX(1<<54 when not executable) (:108-149; :38-41). With memattr index 5
+ * (non-cacheable, AS MEMATTR byte 5 = 0x4C) and RW that is 0x457, the value observed to work in run job1/gpujob1 (docs/research/28 s.11, 30 s.8).
+ * The VA window follows Mesa's panfrost kmod: lowest 32 MiB reserved, everything below 4 GiB (panfrost_kmod.c:509-517, docs/research/32 s.2.6).
+ */
+#ifndef SWEET_MALI_PT_H
+#define SWEET_MALI_PT_H
+#include <stdint.h>
+#include <stddef.h>
+
+#define MALI_PG          0x1000ull
+#define MALI_VA_START    0x02000000ull
+#define MALI_VA_END      0x100000000ull
+#define MALI_VA_PAGES    ((MALI_VA_END - MALI_VA_START) / MALI_PG)       /* 0xFE000 */
+#define MALI_PTE_ACCESS  (1ull << 10)
+#define MALI_PTE_RW      (1ull << 6)
+#define MALI_PTE_NX      (1ull << 54)
+#define MALI_PTE_TABLE   (MALI_PTE_ACCESS | 3ull)
+#define MALI_MEMATTR_NC  5u                                              /* AS0 MEMATTR byte 5 = 0x4C, non-cacheable */
+#define MALI_F_EXEC      1u
+
+/* ---- VA allocator: one bit per 4 KB page, first fit from a rolling hint ---- */
+struct mali_va {
+	uint32_t bits[(MALI_VA_PAGES + 31) / 32];
+	uint32_t hint;
+};
+
+static inline int
+mali_va_test(const struct mali_va *v, uint32_t i)
+{
+	return (v->bits[i >> 5] >> (i & 31)) & 1u;
+}
+
+/* npages 4 KB pages, aligned to 'align_pages' (power of two, >= 1); returns the VA or 0 */
+static inline uint64_t
+mali_va_alloc(struct mali_va *v, uint32_t npages, uint32_t align_pages)
+{
+	uint32_t total = (uint32_t)MALI_VA_PAGES;
+
+	if (npages == 0 || npages > total || align_pages == 0 || (align_pages & (align_pages - 1))) {
+		return 0;
+	}
+	for (int pass = 0; pass < 2; pass++) {
+		uint32_t i = pass ? 0 : v->hint, end = pass ? v->hint + npages : total;
+		i = (i + align_pages - 1) & ~(align_pages - 1);
+		while (i + npages <= total && i < end) {
+			uint32_t k = 0;
+			while (k < npages && !mali_va_test(v, i + k)) {
+				k++;
+			}
+			if (k == npages) {
+				for (uint32_t j = 0; j < npages; j++) {
+					v->bits[(i + j) >> 5] |= 1u << ((i + j) & 31);
+				}
+				v->hint = i + npages;
+				return MALI_VA_START + (uint64_t)i * MALI_PG;
+			}
+			i = (i + k + 1 + align_pages - 1) & ~(align_pages - 1);
+		}
+	}
+	return 0;
+}
+
+/* 0 = freed, -1 = the range was not fully allocated or is outside the window (nothing changed) */
+static inline int
+mali_va_free(struct mali_va *v, uint64_t va, uint32_t npages)
+{
+	if (va < MALI_VA_START || va + (uint64_t)npages * MALI_PG > MALI_VA_END || (va & (MALI_PG - 1)) || npages == 0) {
+		return -1;
+	}
+	uint32_t i = (uint32_t)((va - MALI_VA_START) / MALI_PG);
+	for (uint32_t j = 0; j < npages; j++) {
+		if (!mali_va_test(v, i + j)) {
+			return -1;
+		}
+	}
+	for (uint32_t j = 0; j < npages; j++) {
+		v->bits[(i + j) >> 5] &= ~(1u << ((i + j) & 31));
+	}
+	if (i < v->hint) {
+		v->hint = i;
+	}
+	return 0;
+}
+
+/* ---- page tables: L0[0] -> L1 -> L2[va >> 30] -> L3[(va >> 21) & 511] (all VAs < 4 GiB so one L0 and one L1 entry range) ---- */
+struct mali_pt_ops {
+	/* returns a zeroed 4 KB table (host pointer), its PA in *pa; NULL on failure. The caller does the cache maintenance (clean to memory) before the GPU walks it. */
+	uint64_t *(*table_alloc)(void *ctx, uint64_t *pa);
+	void *ctx;
+};
+
+struct mali_pt {
+	struct mali_pt_ops ops;
+	uint64_t *l0, *l1, *l2[4], *l3[4 * 512];
+	uint64_t l0_pa, l1_pa, l2_pa[4], l3_pa[4 * 512];
+};
+
+static inline int
+mali_pt_init(struct mali_pt *p, struct mali_pt_ops ops)
+{
+	*p = (struct mali_pt){ .ops = ops };
+	p->l0 = ops.table_alloc(ops.ctx, &p->l0_pa);
+	p->l1 = ops.table_alloc(ops.ctx, &p->l1_pa);
+	if (!p->l0 || !p->l1) {
+		return -1;
+	}
+	p->l0[0] = p->l1_pa | MALI_PTE_TABLE;
+	return 0;
+}
+
+static inline uint64_t
+mali_pte_leaf(uint64_t pa, uint32_t flags)
+{
+	return pa | MALI_PTE_ACCESS | 3ull | MALI_PTE_RW | ((uint64_t)MALI_MEMATTR_NC << 2) | ((flags & MALI_F_EXEC) ? 0 : MALI_PTE_NX);
+}
+
+/* maps one 4 KB page; 0 ok, -1 bad VA or PA, -2 out of tables, -3 already mapped */
+static inline int
+mali_pt_map(struct mali_pt *p, uint64_t va, uint64_t pa, uint32_t flags)
+{
+	if (va < MALI_VA_START || va >= MALI_VA_END || (va & (MALI_PG - 1)) || (pa & (MALI_PG - 1)) || pa >= (1ull << 40)) {
+		return -1;
+	}
+	uint32_t i2 = (uint32_t)(va >> 30), i3 = (uint32_t)(va >> 21);   /* i3 < 2048 */
+	if (!p->l2[i2]) {
+		p->l2[i2] = p->ops.table_alloc(p->ops.ctx, &p->l2_pa[i2]);
+		if (!p->l2[i2]) {
+			return -2;
+		}
+		p->l1[i2] = p->l2_pa[i2] | MALI_PTE_TABLE;
+	}
+	if (!p->l3[i3]) {
+		p->l3[i3] = p->ops.table_alloc(p->ops.ctx, &p->l3_pa[i3]);
+		if (!p->l3[i3]) {
+			return -2;
+		}
+		p->l2[i2][(va >> 21) & 511] = p->l3_pa[i3] | MALI_PTE_TABLE;
+	}
+	uint64_t *e = &p->l3[i3][(va >> 12) & 511];
+	if (*e & 3ull) {
+		return -3;
+	}
+	*e = mali_pte_leaf(pa, flags);
+	return 0;
+}
+
+/* clears one leaf; returns the PA it pointed to, or 0 if it was not mapped */
+static inline uint64_t
+mali_pt_unmap(struct mali_pt *p, uint64_t va)
+{
+	if (va < MALI_VA_START || va >= MALI_VA_END || (va & (MALI_PG - 1))) {
+		return 0;
+	}
+	uint64_t *t = p->l3[(uint32_t)(va >> 21)];
+	if (!t) {
+		return 0;
+	}
+	uint64_t *e = &t[(va >> 12) & 511], old = *e;
+	if (!(old & 3ull)) {
+		return 0;
+	}
+	*e = 0;
+	return old & 0x000000FFFFFFF000ull;
+}
+
+static inline uint64_t
+mali_pt_lookup(const struct mali_pt *p, uint64_t va)
+{
+	if (va < MALI_VA_START || va >= MALI_VA_END) {
+		return 0;
+	}
+	const uint64_t *t = p->l3[(uint32_t)(va >> 21)];
+	uint64_t e = t ? t[(va >> 12) & 511] : 0;
+	return (e & 3ull) ? (e & 0x000000FFFFFFF000ull) | (va & (MALI_PG - 1)) : 0;
+}
+#endif
