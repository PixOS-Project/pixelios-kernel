+
+/*
+ * Early CNTVCT checkpoints (patch 0125, research 45 s3 item 3). Raw ticks go into a static array (no printf, no boot-arg
+ * read, so it is safe before the console exists); sweet_cntvct_dump prints them only with boot-arg sweetcntvct=1.
+ */
+#define SWEET_CNTVCT_N 16
+static uint64_t sweet_cntvct_ck[SWEET_CNTVCT_N];
+
+void
+sweet_cntvct_stamp(unsigned int idx)
+{
+	if (idx < SWEET_CNTVCT_N) {
+		sweet_cntvct_ck[idx] = ml_get_hwclock();
+	}
+}
+
+/* serial != 0: kprintf (safe right after "kprintf initialized"); else printf (kernel_bootstrap, console ring). */
+void
+sweet_cntvct_dump(unsigned int from, unsigned int to, int serial)
+{
+	int on = 0;
+	if (PE_state.bootArgs == NULL || !PE_parse_boot_argn("sweetcntvct", &on, sizeof(on)) || on == 0) {
+		return;
+	}
+	for (unsigned int i = from; i < to && i < SWEET_CNTVCT_N; i++) {
+		if (sweet_cntvct_ck[i] == 0) {
+			continue;
+		}
+		if (serial) {
+			kprintf("SWEET CNTVCT ck%u=%llu hz=%lu\n", i, sweet_cntvct_ck[i], gPEClockFrequencyInfo.timebase_frequency_hz);
+		} else {
+			printf("SWEET CNTVCT ck%u=%llu hz=%lu\n", i, sweet_cntvct_ck[i], gPEClockFrequencyInfo.timebase_frequency_hz);
+		}
+	}
+}
 #endif /* SWEET */
