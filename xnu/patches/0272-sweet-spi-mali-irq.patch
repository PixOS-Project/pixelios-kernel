+/*
+ * Patch 0272 (sprint-gpu 2026-11-09, user order "start the proper interrupt build"; design docs/research/35-gpu-irq-path.md s.8 in the kernel repo):
+ * SPI (shared peripheral interrupt) support for SWEET. Until now sleh_irq handed every INTID >= 16 except the timer to cdp->interrupt_handler, which is NULL on
+ * this port, so a level SPI that was enabled and asserted would re-enter at once and hang the CPU (review M2). Now:
+ *  - sweet_spi_dispatch (called by sleh_irq for 32 <= INTID < 1020) runs the handler attached for that INTID; an INTID with no handler, or a handler that
+ *    returns non-zero, is MASKED at the distributor (GICD_ICENABLER) and counted: the safety net that removes the M2 hazard for every SPI.
+ *  - sweet_spi_attach / sweet_spi_detach (thread context) configure one SPI: disable, clear pending/active, Group 1 non-secure, priority 0xA0, level,
+ *    routed to the boot CPU (IROUTER affinity 0.0.0.0 = MPIDR 0x0 [obs SWEET CPU: cpu=0 mpidr=0x0]), enable, and read back group/enable/config/route.
+ * Offsets: GICv3 architected distributor layout (research 35 s.6). Writes touch only the attached INTID's bits (set/clear-enable/pending/active registers
+ * are write-1-to-act; IGROUPR/IGRPMODR/ICFGR are read-modify-write of one bit). No other GIC state is changed.
+ */
+#define SWEET_GICD_IGROUPR    0x0080u
+#define SWEET_GICD_ISENABLER  0x0100u
+#define SWEET_GICD_ICENABLER  0x0180u
+#define SWEET_GICD_ICPENDR    0x0280u
+#define SWEET_GICD_ICACTIVER  0x0380u
+#define SWEET_GICD_IPRIORITYR 0x0400u
+#define SWEET_GICD_ICFGR      0x0C00u
+#define SWEET_GICD_IGRPMODR   0x0D00u
+#define SWEET_GICD_IROUTER    0x6000u
+#define SWEET_SPI_SLOTS       4
+
+typedef int (*sweet_spi_fn_t)(void *arg, uint32_t intid);
+static struct {
+	uint32_t intid;
+	sweet_spi_fn_t fn;
+	void *arg;
+	uint64_t count;
+} sweet_spi_tab[SWEET_SPI_SLOTS];
+uint64_t sweet_spi_unhandled;          /* SPIs masked by the safety net */
+uint32_t sweet_spi_unhandled_last;     /* INTID of the last one */
+
+static void
+sweet_gicd_rwp_wait(void)
+{
+	for (int i = 0; i < 1000000; i++) {
+		if ((gicd_read32(GICD_CTLR) & GICD_CTLR_RWP) == 0) {
+			return;
+		}
+	}
+}
+
+void sweet_spi_dispatch(uint32_t intid);
+void
+sweet_spi_dispatch(uint32_t intid)
+{
+	for (int i = 0; i < SWEET_SPI_SLOTS; i++) {
+		sweet_spi_fn_t fn = os_atomic_load(&sweet_spi_tab[i].fn, acquire);
+		if (fn != NULL && sweet_spi_tab[i].intid == intid) {
+			sweet_spi_tab[i].count++;
+			if (fn(sweet_spi_tab[i].arg, intid) == 0) {
+				return;
+			}
+			break;   /* the handler asked for the line to be masked */
+		}
+	}
+	if (gicd_base != 0 && intid >= 32 && intid < 1020) {
+		gicd_write32(SWEET_GICD_ICENABLER + 4 * (intid / 32), 1u << (intid % 32));
+	}
+	sweet_spi_unhandled++;
+	sweet_spi_unhandled_last = intid;
+}
+
+/* rb[0] IGROUPR bit, rb[1] ISENABLER bit, rb[2] ICFGR word, rb[3] IROUTER low word. Returns 0 ok, 22 EINVAL, 28 ENOSPC (no free slot), 19 ENODEV (no GICD). */
+int sweet_spi_attach(uint32_t intid, sweet_spi_fn_t fn, void *arg, uint32_t rb[4]);
+int
+sweet_spi_attach(uint32_t intid, sweet_spi_fn_t fn, void *arg, uint32_t rb[4])
+{
+	if (gicd_base == 0) {
+		return 19;
+	}
+	if (intid < 32 || intid >= 1020 || fn == NULL) {
+		return 22;
+	}
+	int slot = -1;
+	for (int i = 0; i < SWEET_SPI_SLOTS; i++) {
+		if (sweet_spi_tab[i].fn == NULL && slot < 0) {
+			slot = i;
+		}
+		if (sweet_spi_tab[i].fn != NULL && sweet_spi_tab[i].intid == intid) {
+			return 22;
+		}
+	}
+	if (slot < 0) {
+		return 28;
+	}
+	uint32_t w = 4 * (intid / 32), b = 1u << (intid % 32);
+	gicd_write32(SWEET_GICD_ICENABLER + w, b);
+	sweet_gicd_rwp_wait();
+	gicd_write32(SWEET_GICD_ICPENDR + w, b);
+	gicd_write32(SWEET_GICD_ICACTIVER + w, b);
+	gicd_write32(SWEET_GICD_IGROUPR + w, gicd_read32(SWEET_GICD_IGROUPR + w) | b);
+	gicd_write32(SWEET_GICD_IGRPMODR + w, gicd_read32(SWEET_GICD_IGRPMODR + w) & ~b);
+	*((volatile uint8_t *)(gicd_base + SWEET_GICD_IPRIORITYR + intid)) = 0xA0;
+	uint32_t cw = SWEET_GICD_ICFGR + 4 * (intid / 16), cb = 2u << (2 * (intid % 16));
+	gicd_write32(cw, gicd_read32(cw) & ~cb);          /* level-sensitive */
+	*((volatile uint64_t *)(gicd_base + SWEET_GICD_IROUTER + 8 * (uint64_t)intid)) = 0;   /* affinity 0.0.0.0 (boot CPU), bit 31 clear */
+	sweet_spi_tab[slot].intid = intid;
+	sweet_spi_tab[slot].arg = arg;
+	sweet_spi_tab[slot].count = 0;
+	os_atomic_store(&sweet_spi_tab[slot].fn, fn, release);
+	gicd_write32(SWEET_GICD_ISENABLER + w, b);
+	sweet_gicd_rwp_wait();
+	rb[0] = (gicd_read32(SWEET_GICD_IGROUPR + w) & b) != 0;
+	rb[1] = (gicd_read32(SWEET_GICD_ISENABLER + w) & b) != 0;
+	rb[2] = gicd_read32(cw);
+	rb[3] = gicd_read32(SWEET_GICD_IROUTER + 8 * intid);
+	return 0;
+}
+
+int sweet_spi_detach(uint32_t intid);
+int
+sweet_spi_detach(uint32_t intid)
+{
+	if (gicd_base == 0 || intid < 32 || intid >= 1020) {
+		return 22;
+	}
+	gicd_write32(SWEET_GICD_ICENABLER + 4 * (intid / 32), 1u << (intid % 32));
+	sweet_gicd_rwp_wait();
+	for (int i = 0; i < SWEET_SPI_SLOTS; i++) {
+		if (sweet_spi_tab[i].fn != NULL && sweet_spi_tab[i].intid == intid) {
+			os_atomic_store(&sweet_spi_tab[i].fn, (sweet_spi_fn_t)NULL, release);
+		}
+	}
+	return 0;
+}
+
+/* per-INTID handled counts and the safety-net count for log lines (thread context) */
+void sweet_spi_counts(uint32_t intid, uint64_t *handled, uint64_t *unhandled, uint32_t *unhandled_last);
+void
+sweet_spi_counts(uint32_t intid, uint64_t *handled, uint64_t *unhandled, uint32_t *unhandled_last)
+{
+	*handled = 0;
+	for (int i = 0; i < SWEET_SPI_SLOTS; i++) {
+		if (sweet_spi_tab[i].intid == intid) {
+			*handled = sweet_spi_tab[i].count;
+		}
+	}
+	*unhandled = sweet_spi_unhandled;
+	*unhandled_last = sweet_spi_unhandled_last;
+}
