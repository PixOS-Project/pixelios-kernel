+/* interrupt context: no lock, no printf, no MMIO log; non-zero return = let the dispatcher mask the SPI */
+static int
+sm_isr(void *arg, uint32_t intid __unused)
+{
+	uintptr_t which = (uintptr_t)arg;
+	if (!sm.up || sm.dead || sm.g == NULL) {
+		return 1;
+	}
+	if (which == 1) {
+		if (sm.g[R_JOB_STATUS / 4] == 0) {
+			sm_irq_spur++;
+			return 0;
+		}
+		sm.g[R_JOB_MASK / 4] = 0;
+		sm_irq_job++;
+	} else {
+		if (sm.g[R_MMU_STATUS / 4] == 0) {
+			sm_irq_spur++;
+			return 0;
+		}
+		sm.g[R_MMU_MASK / 4] = 0;
+		sm_irq_mmu++;
+	}
+	os_atomic_or(&sm_irq_pend, (uint32_t)which, relaxed);
+	thread_wakeup((event_t)&sm.thread);
+	return 0;
