+/*
+ * Fast receive (patch 0172), boot-arg sweetusbrootfast=1, default off. Off: the reader polls ur.state every 1 ms
+ * (ur_sleep_ms) as before and nothing below prints. On: sweet_usbroot_rx wakes the reader with thread_wakeup the
+ * moment the exchange is complete, the reader sleeps once on ur_done_chan with the UR_WAIT_MS deadline, and the
+ * USB event thread polls fast while the reply is due (sweet_usb_rx_hurry, bsd/dev/sweet_usb.c). Wire protocol v1,
+ * retries, timeouts and the fail-fast rule are unchanged. Every UR_FAST_STATS_N answered requests one
+ * "SWEET USBROOT: fast stats" line gives the request -> answer time in microseconds.
+ */
+#define UR_FAST_STATS_N 256             /* answered requests per stats line (log volume), not a hardware value */
+#define UR_FAST_SLOW_US 8000            /* "slow" bucket of the stats line: still more than a quarter of the old 32 ms */
+static bool ur_fast;                    /* set once in ur_rootdev before the USB device starts */
+static int ur_done_chan;                /* the reader's event: exchange done */
+static struct {
+	uint32_t n, slow;               /* answered requests in this window; of them over UR_FAST_SLOW_US */
+	uint64_t sum_us, min_us, max_us;
+	uint64_t polls0;                /* sweet_usb_rx_short_polls() at the window start */
+	uint64_t total;                 /* answered requests since boot */
+} ur_fs;                                /* under ur_lock (ur_xfer callers hold it) */
+
+static uint64_t
+ur_uptime_us(void)
+{
+	uint64_t t = 0, ns = 0;
+	clock_get_uptime(&t);
+	absolutetime_to_nanoseconds(t, &ns);
+	return ns / NSEC_PER_USEC;
+}
+
+/* One answered request of us microseconds into the window; prints and restarts it every UR_FAST_STATS_N. */
+static void
+ur_fast_account(uint64_t us)
+{
+	if (ur_fs.n == 0) {
+		ur_fs.min_us = ~0ULL;
+		ur_fs.max_us = ur_fs.sum_us = 0;
+		ur_fs.slow = 0;
+	}
+	ur_fs.n++;
+	ur_fs.total++;
+	ur_fs.sum_us += us;
+	ur_fs.min_us = MIN(ur_fs.min_us, us);
+	ur_fs.max_us = MAX(ur_fs.max_us, us);
+	if (us > UR_FAST_SLOW_US) {
+		ur_fs.slow++;
+	}
+	if (ur_fs.n == UR_FAST_STATS_N) {
+		uint64_t polls = sweet_usb_rx_short_polls();
+		printf("SWEET USBROOT: fast stats: %u answers (total %llu), request->answer us mean %llu min %llu max %llu, "
+		    "over %u us %u, event-thread short polls %llu, bad frames %u\n", ur_fs.n, ur_fs.total,
+		    ur_fs.sum_us / ur_fs.n, ur_fs.min_us, ur_fs.max_us, UR_FAST_SLOW_US, ur_fs.slow, polls - ur_fs.polls0,
+		    ur.bad_frames);
+		ur_fs.polls0 = polls;
+		ur_fs.n = 0;
+	}
+}
