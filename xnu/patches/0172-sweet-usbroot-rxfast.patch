+/*
+ * USB root fast receive (patch 0172; boot-arg sweetusbrootfast=1, switched on by bsd/dev/sweet_usbroot.c only
+ * with rd=usbroot0, before sweet_usb_probe()). Off (the default) nothing below runs and ud_thread sleeps 1 ms per
+ * loop on ud.sleep_chan exactly as before. On: ud_thread sleeps on its own event ud_rx_chan (ud_log_thread keeps
+ * ud.sleep_chan), still 1 ms when idle, but while a usbroot request waits for its reply (ud_rx_hurry) it polls
+ * every UD_RX_HURRY_US with no timer leeway, so a received fragment is handled and the single RX TRB re-armed
+ * sooner. No register, field or command is added: the loop body (GEVNTCOUNT read, events, GEVNTCOUNT ack only
+ * when count != 0) is unchanged; only the sleep between two loops is shorter, and only while a request waits
+ * (at most UR_TRIES x (UR_WAIT_MS send retries + UR_WAIT_MS wait), ~17 s per request; ~60% duty with the host gone).
+ */
+#define UD_RX_HURRY_US  100             /* our poll interval while a usbroot reply is due; a software choice, not a hardware value */
+static volatile bool ud_rx_fast;        /* set once, before the USB device starts */
+static volatile bool ud_rx_hurry;       /* a usbroot request is waiting for its reply */
+static int ud_rx_chan;                  /* ud_thread's sleep event in fast mode */
+static volatile uint64_t ud_rx_short_polls;     /* short polls taken (written by ud_thread only) */
+
+void sweet_usb_rx_fast_enable(void);
+void sweet_usb_rx_hurry(bool on);
+uint64_t sweet_usb_rx_short_polls(void);
+
+void
+sweet_usb_rx_fast_enable(void)
+{
+	ud_rx_fast = true;
+	printf("SWEET USB: usbroot fast receive on: event thread polls every %u us while a reply is due (patch 0172)\n",
+	    UD_RX_HURRY_US);
+}
+
+/* Called by the usbroot reader around one request; on = wake ud_thread now so it starts polling fast. */
+void
+sweet_usb_rx_hurry(bool on)
+{
+	ud_rx_hurry = on;
+	if (on && ud_rx_fast) {
+		thread_wakeup(&ud_rx_chan);     /* never blocks (osfmk/kern/sched_prim.c thread_wakeup_prim) */
+	}
+}
+
+uint64_t
+sweet_usb_rx_short_polls(void)
+{
+	return ud_rx_short_polls;
+}
+
+/* ud_thread, fast mode: sleep until the deadline or a sweet_usb_rx_hurry(true) wake-up. */
+static void
+ud_rx_fast_wait(void)
+{
+	uint64_t deadline;
+
+	if (ud_rx_hurry) {
+		clock_interval_to_deadline(UD_RX_HURRY_US, NSEC_PER_USEC, &deadline);
+		/* SYS_CRITICAL: timer_call_slop() adds no coalescing leeway (osfmk/kern/timer_call.c timer_call_slop) */
+		(void)assert_wait_deadline_with_leeway(&ud_rx_chan, THREAD_UNINT, TIMEOUT_URGENCY_SYS_CRITICAL, deadline, 0);
+		thread_block(THREAD_CONTINUE_NULL);
+		ud_rx_short_polls++;
+		return;
+	}
+	clock_interval_to_deadline(1, NSEC_PER_MSEC, &deadline);
+	if (assert_wait_deadline(&ud_rx_chan, THREAD_UNINT, deadline) == THREAD_WAITING) {
+		/* a request that started between the check above and the assert must not wait out the 1 ms */
+		if (ud_rx_hurry) {
+			clear_wait(current_thread(), THREAD_AWAKENED);
+		} else {
+			thread_block(THREAD_CONTINUE_NULL);
+		}
+	}
+}
