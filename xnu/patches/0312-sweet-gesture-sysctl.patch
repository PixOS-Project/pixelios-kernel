 	static void navFired(OSObject *owner, IOTimerEventSource *sender);
 	IOTimerEventSource *fNav;
+	/* patch 0312: one injected gesture from userland (kern.sweetgesture), the closed-loop ALL-ON nav driver decides what and when */
+	static void gestFired(OSObject *owner, IOTimerEventSource *sender);
+	IOTimerEventSource *fGest;
+	UInt32 fGestOn, fGestStep, fGestSteps, fGestId, fGestMs;
+	int fGestX0, fGestY0, fGestX1, fGestY1;
+	int gestureStart(int x0, int y0, int x1, int y1, unsigned ms, unsigned id);
 	UInt32 fNavReps, fNavRep, fNavIdx, fNavStep, fNavRng;
 	UInt32 fNavWakeTaps, fNavWakeSt;   /* patch 0254: unlock retries (wake taps sent), 1 = the wake tap finger is down */
 	uint64_t fNavSw0;   /* patch 0254: swap count at the start of the unlock attempt */
@@ -702,6 +708,9 @@
 	fNavGateT0 = fNavGateCnt = fNavGateFlatT = 0;
 	fNavRng = 0x5eed1234;
 	fNavStress = fNavSRng = fNavSMs = fNavSSettle = fNavSBurst = fNavSFlip = fNavSRepeat = fNavSZig = 0;   /* patch 0306 */
+	fGest = NULL;   /* patch 0312 */
