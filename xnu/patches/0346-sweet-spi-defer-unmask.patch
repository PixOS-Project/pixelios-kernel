+/* patch 0346: ISENABLER write for an ATTACHED SPI (only the INTID's own bit; the register is write-1-to-set), then RWP wait and a read-back of the enable bit into *en.
+ * sweet_spi_enable = the first enable after sweet_spi_attach_off; sweet_spi_unmask = re-enable an SPI that the dispatcher masked (handler returned SWEET_SPI_DEFER or the safety net).
+ * Both refuse an INTID with no attached handler (22), so a detached or never attached SPI is never enabled here. 0 ok, 22 EINVAL, 19 ENODEV. */
+static int
+sweet_spi_set_enable(uint32_t intid, uint32_t *en)
+{
+	if (gicd_base == 0) {
+		return 19;
+	}
+	if (intid < 32 || intid >= 1020) {
+		return 22;
+	}
+	int found = 0;
+	for (int i = 0; i < SWEET_SPI_SLOTS; i++) {
+		if (os_atomic_load(&sweet_spi_tab[i].fn, acquire) != NULL && sweet_spi_tab[i].intid == intid) {
+			found = 1;
+		}
+	}
+	if (!found) {
+		return 22;
+	}
+	uint32_t w = 4 * (intid / 32), b = 1u << (intid % 32);
+	gicd_write32(SWEET_GICD_ISENABLER + w, b);
+	sweet_gicd_rwp_wait();
+	if (en != NULL) {
+		*en = (gicd_read32(SWEET_GICD_ISENABLER + w) & b) != 0;
+	}
+	return 0;
+}
+
+int sweet_spi_enable(uint32_t intid, uint32_t *en);
+int
+sweet_spi_enable(uint32_t intid, uint32_t *en)
+{
+	return sweet_spi_set_enable(intid, en);
+}
+
+int sweet_spi_unmask(uint32_t intid);
+int
+sweet_spi_unmask(uint32_t intid)
+{
+	int rc = sweet_spi_set_enable(intid, NULL);
+	if (rc == 0) {
+		sweet_spi_unmasked++;
+	}
+	return rc;
+}
