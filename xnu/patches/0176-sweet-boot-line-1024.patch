  * There are no iBoot headers so have to duplicate it here for now.
  */
-#define BOOT_LINE_LENGTH        608
+/*
+ * PixOS (patch 0176): 1024 instead of 608, the value the i386 header of this same tree uses
+ * (pexpert/pexpert/i386/boot.h:76). There is no iBoot in this port: the sweet shim (shim/loader.c)
+ * is the only producer of boot_args and is built with the same BOOT_LINE_LENGTH, so the IBOOT
+ * limit above does not bind us. Readers use the macro or the struct fields (start.s reads bootFlags
+ * through genassym BA_BOOT_FLAGS = offsetof), so they move with it; sizeof(struct boot_args) 736 -> 1152.
+ */
+#define BOOT_LINE_LENGTH        1024
 
