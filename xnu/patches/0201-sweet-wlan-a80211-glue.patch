+/* ---- the 16.7 codec (T-853c): byte layouts from the two reverser notes, own code, no Apple bytes ---- */
+static inline void swsta_p16(uint8_t *b, uint32_t off, uint32_t v) { b[off] = (uint8_t)v; b[off + 1] = (uint8_t)(v >> 8); }
+static inline void swsta_p32(uint8_t *b, uint32_t off, uint32_t v) { swsta_p16(b, off, v); swsta_p16(b, off + 2, v >> 16); }
+static inline uint32_t swsta_g32(const uint8_t *b, uint32_t off)
+{
+	return (uint32_t)b[off] | ((uint32_t)b[off + 1] << 8) | ((uint32_t)b[off + 2] << 16) | ((uint32_t)b[off + 3] << 24);
+}
+
+/* Get 21 value [RE-B s.3]: 0 = no result yet (sync poller), 0xffff = still joining (async poller), 1 = success,
+ * 2..35 = _errorForAssociateResult table index, 36+ = generic failure 0xfffff0c2. Which Apple code means "wrong key"
+ * is not readable from the table [open 3a]; a radio failure code 2..35 is passed through [guess], else 36.
+ * *why = static gap text (<= 40 chars) or 0. */
+static inline uint32_t swsta_assoc_code(const struct swsta_view *v, const char **why)
+{
+	*why = 0;
+	if (v->assoc_state == SWSTA_AS_NONE) { *why = "get 21 asked with no join, answered 0"; return 0; }
+	if (v->assoc_state == SWSTA_AS_PENDING) { *why = "get 21 pending: 0xffff (async guess)"; return 0xffffu; }
+	if (v->assoc_result == 0) return 1;
+	if (v->assoc_result >= 2 && v->assoc_result <= 35) { *why = "get 21 fail code passed through [guess]"; return v->assoc_result; }
+	*why = "get 21 radio code unmapped -> 36"; return 36;
+}
+
+/* One 1164-byte scan-result record, shared by Get 11 and Get 103 [RE-B s.4, RE-A S1/S4; W-D3-scan-record-layout.md s.1]. Offsets from the record start:
+ * +0x08 channel s32, +0x0c channel flags s32, +0x10 u16 noise/snr gate (0 = both skipped; 1 only when noise or snr is known), +0x12 noise s16, +0x14 snr s16,
+ * +0x16 rssi s16, +0x18 beacon interval s16 (TU), +0x1a capabilities u16 (ESS bit 0; privacy bit 4 is the 802.11 standard bit), +0x1c bssid[6], +0x22 rate count u8 (<= 15), +0x24 rates u32 each (Mbps),
+ * +0x60 ssid_len u8, +0x61 ssid, +0x84 age s32 (0), +0x88 flag byte (0), +0x8a IE length u16 (ALWAYS written: the caller pre-set the 0x400 capacity, 0 = no IE), +0x8c IEs (<= 0x400; ours <= SWSTA_IE_CAP).
+ * x = the radio's entry for extra fields (NULL = none known: the extras stay 0 and the IE length is written 0). */
+static inline void swsta_rec(uint8_t *b, const uint8_t *ssid, uint32_t ssid_len, const uint8_t *bssid, uint32_t channel,
+			     int32_t rssi, uint32_t sec, const struct swsta_bss *x)
+{
+	uint32_t i, n;
+	if (ssid_len > 32) ssid_len = 32;
+	swsta_p32(b, 0x08, channel);
+	swsta_p16(b, 0x16, (uint32_t)rssi);
+	swsta_p16(b, 0x1a, 0x0001u | (sec == SWSTA_SEC_OPEN ? 0u : 0x0010u));
+	SWSTA_MEMCPY(b + 0x1c, bssid, 6);
+	b[0x60] = (uint8_t)ssid_len;
+	SWSTA_MEMCPY(b + 0x61, ssid, ssid_len);
+	if (x) {
+		swsta_p32(b, 0x0c, x->chflags);
+		if (x->noise != 0 || x->snr != 0) {
+			swsta_p16(b, 0x10, 1u);
+			swsta_p16(b, 0x12, (uint32_t)(uint16_t)x->noise);
+			swsta_p16(b, 0x14, (uint32_t)(uint16_t)x->snr);
+		}
+		swsta_p16(b, 0x18, x->beacon);
+		n = x->nrates > SWSTA_RATE_MAX ? SWSTA_RATE_MAX : x->nrates;
+		b[0x22] = (uint8_t)n;
+		for (i = 0; i < n; i++) swsta_p32(b, 0x24 + 4 * i, x->rates[i]);
+		n = x->ie_len > SWSTA_IE_CAP ? SWSTA_IE_CAP : x->ie_len;
+		SWSTA_MEMCPY(b + 0x8c, x->ie, n);
+		swsta_p16(b, 0x8a, n);
+	} else {
+		swsta_p16(b, 0x8a, 0);
+	}
+}
+
+/* Gap text per codec answer that is only partly decoded (<= 40 chars; emitted by swsta_a80211 for this codec only) */
+static inline const char *swsta_cd_gap(uint32_t type, const struct swsta_view *v)
+{
+	switch (type) {
+	case SWSTA_T_CARD_CAPS: return "get 12 caps bits open, zero-filled";
+	case SWSTA_T_RSSI_BOUNDS: return "get 106 bounds values open, zeros";
+	case SWSTA_T_AUTH_TYPE: return v && v->st.joined && v->st.sec == SWSTA_SEC_WPA2_PSK ? 0 : "get 2 auth values open, zeros";	/* WPA2-PSK is answered (lower 1, upper 8); any other security stays zeros */
+	case SWSTA_T_PROTMODE: return "get 6 protmode values open, zeros";
+	case SWSTA_T_CHANNEL: return "get 4 channel flags open, zero";
+	case SWSTA_T_RSSI: return "get 16 unit block open, zeros";
+	case SWSTA_T_NOISE: return "get 17 noise value open, zero";
+	case SWSTA_T_SCAN_RESULT: return v && v->bss && v->bss->ie_len ? 0 : "record IEs empty (no IEs known)";
+	case SWSTA_T_CURRENT_NETWORK: return v && v->bss && v->bss->ie_len ? 0 : v && v->st.sec != SWSTA_SEC_OPEN ? "no IEs: Settings shows Weak Security" : "record IEs empty (no IEs known)";	/* privacy set + no IEs = IO80211 marks WEP [W-D3-weak-security s.1] */
+	case SWSTA_T_HW_SUPP_CHANNELS: return "get 254: 7 scan channels, flags cloned";
+	case SWSTA_T_SUPP_CHANNELS: return "get 27: 7 scan channels, flags cloned";
+	case SWSTA_T_COUNTRY_CODE: return "get 51: the CLM country this boot set";
+	default: return 0;
+	}
+}
+
+static inline int swsta_cd_get(void *cx, uint32_t type, const struct swsta_view *v, void *buf, uint32_t len)
+{
+	uint8_t *b = (uint8_t *)buf;
+	(void)cx;
+	SWSTA_MEMSET(b, 0, len);	/* every byte the notes do not give is zero */
+	switch (type) {
+	case SWSTA_T_CARD_CAPS: return 0;				/* 13 B bitmap, bits 0..102 [RE-A L6]; no bit set (open) */
+	case SWSTA_T_POWER:						/* 24 B {version 1, N radios 1, state} [RE-A L8] */
+		swsta_p32(b, 0, 1); swsta_p32(b, 4, 1); swsta_p32(b, 8, v->power_on ? 1u : 0u); return 0;
+	case SWSTA_T_RSSI_BOUNDS: return 0;				/* 16 B, words +4/+8/+0xc published [RE-A L12]; values open */
+	case SWSTA_T_CHANNEL:						/* 16 B, library reads +8 and +0xc, word0 pre-set to 1 [RE-A L3] */
+		swsta_p32(b, 0, 1); swsta_p32(b, 8, v->st.channel); return 0;
+	case SWSTA_T_AUTH_TYPE:						/* 16 B (+4 always, +8/+0xc if non-zero) [RE-A L2]. Joined with WPA2-PSK: lower 1, upper 8, the values IO80211 stores itself at the join [W-D3-weak-security s.6, obs-RE]; else zeros (gap) */
+		if (v->st.joined && v->st.sec == SWSTA_SEC_WPA2_PSK) { swsta_p32(b, 0, 1); swsta_p32(b, 4, 1); swsta_p32(b, 8, 8); }
+		return 0;
+	case SWSTA_T_PROTMODE: return 0;				/* 12 B (+4,+8) [RE-A L4]; values open */
+	case SWSTA_T_RSSI: case SWSTA_T_NOISE:				/* 52 B, success needs word +4 == 1, value at +8 [RE-A L7] */
+		swsta_p32(b, 0, 1); swsta_p32(b, 4, 1);			/* word0 = 1: version [guess] */
+		swsta_p32(b, 8, type == SWSTA_T_RSSI ? (uint32_t)v->st.rssi : 0u); return 0;
+	case SWSTA_T_SCAN_RESULT:
+		if (!v->bss) return SWSTA_EINVAL;
+		swsta_rec(b, v->bss->ssid, v->bss->ssid_len, v->bss->bssid, v->bss->channel, v->bss->rssi, v->bss->sec, v->bss); return 0;
+	case SWSTA_T_CURRENT_NETWORK:					/* same record as Get 11 [RE-B s.4] */
+		swsta_rec(b, v->st.ssid, v->st.ssid_len, v->st.bssid, v->st.channel, v->st.rssi, v->st.sec, v->bss); return 0;	/* v->bss = the latest scan list's entry for this BSSID (swsta_a80211 looks it up), else NULL */
+	case SWSTA_T_ASSOC_RESULT: { const char *why; swsta_p32(b, 0, swsta_assoc_code(v, &why)); return 0; }
+	case SWSTA_T_SUPP_CHANNELS:				/* 2026-11-11: 27 has the same IO80211 case body and layout as 254 [W-UI-a80211-refused-types.md s.2 "254 (also 27, same case body 0x1d3ec45e4)"]; wifid read it 27x per boot and got EOPNOTSUPP (wd6-dhcp) */
+	case SWSTA_T_HW_SUPP_CHANNELS: {			/* sprint 2026-11-08 [docs/research/W-UI-a80211-refused-types.md s.2 254, IO80211 0x1d3ec45e8-0x1d3ec46ec]: u32 count @+4, records from +8,
+								 * stride 12, channel @rec+4, flags @rec+8. wifid's auto-join refuses an error or an empty list. The list is the channel set this driver
+								 * really scans (the seven bring-up chanspecs of the L23 escan, sweet_wlan_g2e.h:201), not the radio's full set (no chanspecs iovar yet: GAP);
+								 * flags 20 MHz 0x2 | 2 GHz 0x8 / 5 GHz 0x10 are the X-W2 s.1 clone values [guess, GAP] */
+		static const uint8_t ch[7] = { 1, 6, 11, 36, 40, 44, 48 };
+		uint32_t i;
+		if (len < 8u + 12u * 7u) return SWSTA_EINVAL;
+		swsta_p32(b, 4, 7u);
+		for (i = 0; i < 7u; i++) {
+			swsta_p32(b, 8u + 12u * i + 4u, ch[i]);
+			swsta_p32(b, 8u + 12u * i + 8u, ch[i] <= 14u ? 0x2u | 0x8u : 0x2u | 0x10u);
+		}
+		return 0;
+	}
+	case SWSTA_T_COUNTRY_CODE:				/* 3 B NUL-terminated [row 51]: the country the L22c step of this boot set in the firmware (sweet_wlan_g2e.h:144 wl_country_t "XZ", printed `L22c country XZ set: status 0`), not a locale guess */
+		if (len < 3u) return SWSTA_EINVAL;
+		b[0] = 'X'; b[1] = 'Z'; b[2] = 0; return 0;
+	default: return SWSTA_EOPNOTSUPP;	/* 207 and the rest: record layouts open or not needed [RE-A L9, L13; W-UI-a80211-refused-types.md] */
+	}
+}
+
+/* Set 19 [RE-A / RE-B 4b]: {version, count N <= 4, N x s32 from +8}; state word 1 = on. Set 20: the 592-byte structure
+ * of RE-B s.2: +0 version 1, +0xc ssid_len 1..32, +0x10 ssid, +0x30 bssid when byte +0x1cf bit 0x20, key block
+ * +0x3c length, +0x40 cipher (10 passphrase / 6 PMK), +0x48 key bytes, +0x1d4/+0x1d8 library-derived PMK (unused). */
+static inline int swsta_cd_set(void *cx, uint32_t type, const void *buf, uint32_t len, struct swsta_setreq *o)
+{
+	const uint8_t *b = (const uint8_t *)buf;
+	uint32_t n, kl, kc;
+	(void)cx;
+	if (type == SWSTA_T_POWER) {
+		if (len != 24) return SWSTA_EINVAL;
+		n = swsta_g32(b, 4);
+		if (n < 1 || n > 4) return SWSTA_EINVAL;
+		o->power_on = swsta_g32(b, 8) == 1;
+		return 0;
+	}
+	if (type != SWSTA_T_ASSOCIATE) return SWSTA_EOPNOTSUPP;
+	if (len != 592 || swsta_g32(b, 0) != 1) return SWSTA_EINVAL;
+	n = swsta_g32(b, 0x0c);
+	if (n < 1 || n > 32) return SWSTA_EINVAL;
+	o->join.ssid_len = (uint8_t)n; SWSTA_MEMCPY(o->join.ssid, b + 0x10, n);
+	if (b[0x1cf] & 0x20) { SWSTA_MEMCPY(o->join.bssid, b + 0x30, 6); o->join.has_bssid = 1; }
+	kl = swsta_g32(b, 0x3c); kc = swsta_g32(b, 0x40);
+	if (kl == 0 && kc == 0) {
+		o->join.key_kind = SWSTA_KEY_NONE;
+	} else if ((uint32_t)(b[8] | (b[9] << 8)) != 0x8u) {
+		return SWSTA_EOPNOTSUPP;	/* only WPA2-PSK (S+8 == 0x8) is modelled; FT/SHA256/SAE/802.1X refused loudly */
+	} else if (kc == 10 && kl >= 8 && kl <= 64) {
+		o->join.key_kind = SWSTA_KEY_PASSPHRASE; o->join.key_len = kl; SWSTA_MEMCPY(o->join.key, b + 0x48, kl);
+	} else if (kc == 6 && kl == 32) {
+		o->join.key_kind = SWSTA_KEY_PMK; o->join.key_len = kl; SWSTA_MEMCPY(o->join.key, b + 0x48, kl);
+	} else return SWSTA_EINVAL;
+	if (b[0x1d0] || b[0x202] || swsta_g32(b, 0x24c) || swsta_g32(b, 0x248)) o->gap = "set 20 flags/blacklist/band ignored";
+	return 0;
+}
+
+static const struct swsta_codec swsta_codec_167 = { swsta_cd_get, swsta_cd_set, 0 };
+
+static inline void swsta_log(struct swsta *s, const char *line) { if (s->cb.log) s->cb.log(s->cb.cx, line); }
+
+static inline void swsta_gap(struct swsta *s, uint32_t type, int set, uint32_t len, const char *why)
+{
+	char t[64];
+	s->gaps++;
+	if (why) SWSTA_SNPRINTF(t, sizeof t, "a80211 type %u %s", (unsigned)type, why);
+	else SWSTA_SNPRINTF(t, sizeof t, "a80211 type %u %s len %u not handled", (unsigned)type, set ? "set" : "get", (unsigned)len);
+	if (s->cb.gap) s->cb.gap(s->cb.cx, t);
+	else swsta_log(s, t);	/* no gap callback: still loud (rule 8) */
+}
+
+static inline void swsta_post(struct swsta *s, uint32_t code) { if (s->cb.post) s->cb.post(s->cb.cx, code); }
+
+/* W-UI: LINK_CHANGED (4) with its 0x20-byte payload: u8 isLinkDown @+0, s32 RSSI @+4, u16 SNR @+8 and NOISE @+0xa (0 = key omitted), debounce bytes @+0x1c/+0x1d (0);
+ * IO80211 __dispatchLinkChangedEvent drops a payload shorter than 0x20 and wifid needs isLinkDown + RSSI [obs-RE docs/research/W-UI-wifid-current-network.md row 3, 0x1d3eda824, 0x10005bc80/0x10005bc94].
+ * Link state and RSSI come from the radio's status (the kept link: the firmware's values). SNR/NOISE are not known: 0, with a GAP. */
+static inline void swsta_post_link(struct swsta *s)
+{
+	struct swsta_status st;
+	uint8_t p[0x20];
+	SWSTA_MEMSET(&st, 0, sizeof st);
+	SWSTA_MEMSET(p, 0, sizeof p);
+	if (s->radio && s->radio->status) s->radio->status(s->radio->ctx, &st);
+	p[0] = st.joined ? 0u : 1u;
+	swsta_p32(p, 4, (uint32_t)st.rssi);
+	if (s->cb.post_data) {
+		s->cb.post_data(s->cb.cx, SWSTA_EV_LINK_CHANGED, p, sizeof p);
+		if (st.joined && !s->snr_gapped) { s->snr_gapped = 1u; swsta_gap(s, SWSTA_EV_LINK_CHANGED, 0, 0, "link event SNR/NOISE unknown, sent as 0"); }	/* once per station */
+	} else {
+		swsta_gap(s, SWSTA_EV_LINK_CHANGED, 0, 0, "link event without payload");
+		swsta_post(s, SWSTA_EV_LINK_CHANGED);
+	}
+	SWSTA_MEMSET(&st, 0, sizeof st);
+}
+
+/* radio -> station events (installed as radio->up) */
+static inline void swsta_radio_up(void *cx, const struct swsta_rev *ev)
+{
+	struct swsta *s = (struct swsta *)cx;
+	switch (ev->kind) {
+	case SWSTA_REV_SCAN_DONE: swsta_post(s, SWSTA_EV_SCAN_DONE); break;
+	case SWSTA_REV_ASSOC_DONE:
+		s->assoc_result = (uint32_t)ev->result; s->assoc_state = SWSTA_AS_DONE;
+		swsta_post(s, SWSTA_EV_ASSOC_DONE);
+		if (ev->result == 0) {	/* 9, then 2/3/4 [src 110:198] */
+			swsta_post(s, SWSTA_EV_SSID_CHANGED); swsta_post(s, SWSTA_EV_BSSID_CHANGED); swsta_post_link(s);
+		}
+		break;
+	case SWSTA_REV_LINK_UP: case SWSTA_REV_LINK_DOWN: swsta_post_link(s); break;
+	default: {
+		char t[64];
+		SWSTA_SNPRINTF(t, sizeof t, "a80211 radio event %d unknown", ev->kind);
+		s->gaps++;
+		if (s->cb.gap) s->cb.gap(s->cb.cx, t);
+	}
+	}
+}
+
+static inline void swsta_init(struct swsta *s, struct swsta_radio *r, const struct swsta_codec *codec, const struct swsta_cb *cb)
+{
+	SWSTA_MEMSET(s, 0, sizeof *s);
+	s->radio = r; s->codec = codec ? codec : &swsta_codec_167; s->cb = *cb;	/* no codec given: the 16.7 one */
+	r->up = swsta_radio_up; r->up_ctx = s;
+	{ int st = 0; if (r->power && r->power(r->ctx, SWSTA_PWR_GET, &st) == 0) s->power_on = st; }
+}
+
+/* Set 383 observer (LOWCLK B3, patch 0363). b / len = the request body iOS handed us (b NULL or len < 12 = an unexpected shape). Reads only inside [b, b + len); the first `<key>` ... `</key>` of the L bytes
+ * the length word names is the key (at most 64 bytes between the tags, 47 kept, non-printable bytes shown as '?'). Prints the first sight of a key and the counts 10, 100, 1000, 10000; an unexpected shape is
+ * ONE GAP line (the first 16 bytes as four hex words) and then only counted; a full table counts the new key in p383_over with one GAP line. Never a value, never a return value: observation only. */
+static inline uint32_t swsta_p383_find(const uint8_t *t, uint32_t n, const char *tag, uint32_t tl, uint32_t from, uint32_t span)
+{
+	uint32_t i, k;
+	for (i = from; i + tl <= n && i - from <= span; i++) {
+		for (k = 0; k < tl && t[i + k] == (uint8_t)tag[k]; k++) { }
+		if (k == tl) return i;
+	}
+	return 0xFFFFFFFFu;
+}
+
+static inline void swsta_p383_bad(struct swsta *s, const uint8_t *b, uint32_t len)
+{
+	char line[96]; uint32_t w[4], i, k;
+	if (s->p383_shape++) return;	/* one GAP per boot, the rest is counted (summary) */
+	for (i = 0; i < 4; i++) { w[i] = 0; for (k = 0; k < 4; k++) if (b && 4 * i + k < len) w[i] |= (uint32_t)b[4 * i + k] << (8 * k); }
+	SWSTA_SNPRINTF(line, sizeof line, "GAP set383 shape unexpected: len %u first bytes %08x %08x %08x %08x", (unsigned)len, (unsigned)w[0], (unsigned)w[1], (unsigned)w[2], (unsigned)w[3]);
+	SWSTA_PROBE_LOG(line);
+}
+
+static inline void swsta_p383(struct swsta *s, const uint8_t *b, uint32_t len)
+{
+	char line[128], name[SWSTA_P383_KEY]; uint32_t l1, n, ks, ke, i, k;
+	struct swsta_p383 *e = 0;
+	if (!b || len < 12 || swsta_g32(b, 0) != 1u) { swsta_p383_bad(s, b, len); return; }
+	l1 = swsta_g32(b, 4);
+	if (l1 < 1u || l1 > 0x1000u || l1 > len - 8u) { swsta_p383_bad(s, b, len); return; }
+	n = l1 - 1u;	/* the plist text bytes; the NUL is the last counted byte */
+	ks = swsta_p383_find(b + 8, n, "<key>", 5, 0, n);
+	if (ks == 0xFFFFFFFFu) { swsta_p383_bad(s, b, len); return; }
+	ks += 5u;
+	ke = swsta_p383_find(b + 8, n, "</key>", 6, ks, 64u);
+	if (ke == 0xFFFFFFFFu || ke == ks) { swsta_p383_bad(s, b, len); return; }
+	for (i = 0; ks + i < ke && i + 1u < SWSTA_P383_KEY; i++) { uint8_t c = b[8 + ks + i]; name[i] = (c >= 0x20 && c < 0x7f) ? (char)c : '?'; }
+	name[i] = 0;
+	for (k = 0; k < s->p383_used; k++) if (!SWSTA_MEMCMP(s->p383[k].key, name, i + 1)) { e = &s->p383[k]; break; }
+	if (!e) {
+		if (s->p383_used >= SWSTA_P383_MAX) {
+			if (!s->p383_over++) { SWSTA_SNPRINTF(line, sizeof line, "GAP set383 key table full (%u distinct keys): new keys are only counted", (unsigned)SWSTA_P383_MAX); SWSTA_PROBE_LOG(line); }
+			return;
+		}
+		e = &s->p383[s->p383_used++];
+		SWSTA_MEMCPY(e->key, name, i + 1); e->len = n; e->n = 0;
+	}
+	e->n++;
+	if (e->n == 1u || e->n == 10u || e->n == 100u || e->n == 1000u || e->n == 10000u) {
+		SWSTA_SNPRINTF(line, sizeof line, "set383 key=%s len=%u count=%u%s", e->key, (unsigned)n, (unsigned)e->n, e->n == 1u ? " (first seen)" : "");
+		SWSTA_PROBE_LOG(line);
+	}
+}
+
+/* Answer one SIOCGA80211 (set=0) / SIOCSA80211 (set=1). *val is req_val (unused so far: its convention is open).
+ * Returns 0 or a positive errno. Never logs contents. */
+static inline int swsta_a80211(struct swsta *s, int set, uint32_t type, uint32_t *val, void *buf, uint32_t len)
+{
+	struct swsta_cnt *c = (type >= 1 && type <= SWSTA_MAXTYPE) ? &s->cnt[type] : &s->oob;
+	uint32_t want = swsta_len(set, type);
+	struct swsta_status st; struct swsta_view v; struct swsta_setreq rq; struct swsta_bss bss;
+	int rc = 0, handled = 1;
+	char line[96];
+	s->requests++;
+	if (set) c->set++; else c->get++;
+	if (s->probe && set && type == SWSTA_T_SET_PROPERTY) swsta_p383(s, (const uint8_t *)buf, len);	/* LOWCLK B3: observation only, the request is answered as before */
+	SWSTA_MEMSET(&st, 0, sizeof st);
+	SWSTA_MEMSET(&v, 0, sizeof v);
+
+	if (set && type == SWSTA_T_DISASSOCIATE && (len == 0 || (len == 8 && buf))) {
+		rc = s->radio->leave(s->radio->ctx);
+		if (len) swsta_gap(s, type, 1, len, "set 22 disassoc reason ignored");	/* s32 reason at +4 [RE-B 4b] */
+	} else if (!set && type == SWSTA_T_ASSOC_RESULT) {
+		/* 4-byte class: req_len 0, req_data NULL, the answer is req_val [RE-A R1, RE-B s.3] */
+		uint8_t w[4]; const char *why = 0;
+		if (len != 0 || !val || !s->codec || !s->codec->get) { handled = 0; rc = SWSTA_EOPNOTSUPP; }
+		else {
+			v.power_on = s->power_on; v.assoc_result = s->assoc_result; v.assoc_state = s->assoc_state;
+			rc = s->codec->get(s->codec->cx, type, &v, w, 4);
+			if (rc == 0) {
+				*val = swsta_g32(w, 0);
+				if (s->codec == &swsta_codec_167) { (void)swsta_assoc_code(&v, &why); if (why) swsta_gap(s, type, 0, len, why); }
+			}
+		}
+	} else if (want == 0 || len != want || (len && !buf)) {
+		handled = 0; rc = SWSTA_EOPNOTSUPP;
+	} else if (set) {
+		if (type == SWSTA_T_SCAN_REQ) {
+			swsta_gap(s, type, 1, len, "set scan req body ignored (layout open)");
+			rc = s->radio->scan_start(s->radio->ctx);
+		} else if (!s->codec || !s->codec->set) {
+			handled = 0; rc = SWSTA_EOPNOTSUPP;
+		} else {
+			SWSTA_MEMSET(&rq, 0, sizeof rq);
+			rc = s->codec->set(s->codec->cx, type, buf, len, &rq);
+			if (rc == 0 && rq.gap) swsta_gap(s, type, 1, len, rq.gap);
+			if (rc == 0 && type == SWSTA_T_POWER) {
+				int now = 0;
+				rc = s->radio->power(s->radio->ctx, rq.power_on ? SWSTA_PWR_ON : SWSTA_PWR_OFF, &now);
+				if (rc == 0) {
+					int changed = (now != s->power_on);
+					s->power_on = now;
+					if (changed) swsta_post(s, SWSTA_EV_POWER_CHANGED);
+				}
+			} else if (rc == 0 && type == SWSTA_T_ASSOCIATE) {
+				s->assoc_state = SWSTA_AS_PENDING;	/* before join(): the radio may complete inside the verb */
+				rc = s->radio->join(s->radio->ctx, &rq.join);
+				if (rc != 0) s->assoc_state = SWSTA_AS_NONE;
+			}
+			SWSTA_MEMSET(&rq, 0, sizeof rq);	/* wipe the copy of the key */
+		}
+	} else {
+		/* Get */
+		int joined_needed = (type == SWSTA_T_SSID || type == SWSTA_T_BSSID || type == SWSTA_T_CHANNEL ||
+				     type == SWSTA_T_RSSI || type == SWSTA_T_NOISE || type == SWSTA_T_AUTH_TYPE ||
+				     type == SWSTA_T_PROTMODE || type == SWSTA_T_CURRENT_NETWORK);
+		s->radio->status(s->radio->ctx, &st);
+		v.power_on = s->power_on; v.st = st; v.assoc_result = s->assoc_result; v.assoc_state = s->assoc_state;
+		if (joined_needed && !st.joined) {
+			rc = SWSTA_ENXIO;	/* soft path of the library [RE-A R2, R5] */
+		} else if (type == SWSTA_T_SSID) {
+			SWSTA_MEMSET(buf, 0, len);	/* 32 plain bytes [src 110:152] */
+			SWSTA_MEMCPY(buf, st.ssid, st.ssid_len > 32 ? 32 : st.ssid_len);
+		} else if (type == SWSTA_T_BSSID) {
+			SWSTA_MEMCPY(buf, st.bssid, 6);	/* 6 bytes [src 110:153] */
+		} else if (type == SWSTA_T_SCAN_RESULT) {
+			if (s->radio->bss_next(s->radio->ctx, &bss) == 1) {
+				v.bss = &bss;
+				if (!s->codec || !s->codec->get) { handled = 0; rc = SWSTA_EOPNOTSUPP; }
+				else rc = s->codec->get(s->codec->cx, type, &v, buf, len);
+				if (rc == 0 && s->codec == &swsta_codec_167 && swsta_cd_gap(type, &v)) swsta_gap(s, type, 0, len, swsta_cd_gap(type, &v));
+			} else rc = SWSTA_E_SCAN_END;	/* end of list: EIO ends the loop normally [RE-A S3] */
+		} else if (!s->codec || !s->codec->get) {
+			if (type == SWSTA_T_CARD_CAPS) {	/* bind probe must succeed [src 110:61] */
+				SWSTA_MEMSET(buf, 0, len);
+				swsta_gap(s, type, 0, len, "get 12 caps bits open, zero-filled");
+			} else { handled = 0; rc = SWSTA_EOPNOTSUPP; }
+		} else {
+			if (type == SWSTA_T_CURRENT_NETWORK && s->radio->bss_find && s->radio->bss_find(s->radio->ctx, st.bssid, &bss) == 1) v.bss = &bss;	/* the scan list's entry of the joined AP: its IEs / rates / beacon / flags fill the record (ssid, channel, rssi stay the link's) */
+			rc = s->codec->get(s->codec->cx, type, &v, buf, len);
+			if (rc == 0 && s->codec == &swsta_codec_167 && swsta_cd_gap(type, &v)) swsta_gap(s, type, 0, len, swsta_cd_gap(type, &v));
+		}
+	}
+
+	if (rc == (int)SWSTA_EOPNOTSUPP) handled = 0;	/* a codec refusing a type is a gap too (rule 8) */
+	/* W-UI: wifid starts its event monitors in WiFiDeviceScheduleWithQueue, AFTER WiFiDeviceOpen (whose last request is Get 207) and right before its own Get 103
+	 * (0x10004c13c-0x10004c524 monitors, 0x10004c864 CopyCurrentNetwork) [obs-RE W-UI-wifid-current-network.md]: a link event posted before that is never read.
+	 * So the first successful Get 103 after a Get 207 re-posts the current link state once (the link is up: a state report, not a new association). */
+	if (!set && type == SWSTA_T_CHANNELS_INFO) s->relink_armed = 1u;
+	if (!set && type == SWSTA_T_CURRENT_NETWORK && rc == 0 && s->relink_armed) {
+		s->relink_armed = 0u; s->relinks++;
+		SWSTA_SNPRINTF(line, sizeof line, "a80211 link state re-posted after the device open (LINK_CHANGED, %u)", (unsigned)s->relinks);
+		swsta_log(s, line);
+		swsta_post_link(s);
+	}
+	if (!handled) { c->gap++; swsta_gap(s, type, set, len, 0); }
+	if (rc == 0) c->ok++; else if (rc == SWSTA_ENXIO || rc == SWSTA_EOPNOTSUPP || rc == SWSTA_E_SCAN_END) c->soft++;
+	SWSTA_SNPRINTF(line, sizeof line, "a80211 req type=%u %s len=%u -> %d", (unsigned)type, set ? "set" : "get", (unsigned)len, rc);
+	swsta_log(s, line);
+	SWSTA_MEMSET(&bss, 0, sizeof bss); SWSTA_MEMSET(&v, 0, sizeof v);
+	return rc;
+}
+
+static inline void swsta_summary(struct swsta *s)
+{
+	char line[96]; uint32_t t;
+	for (t = 0; t <= SWSTA_MAXTYPE + 1; t++) {
+		const struct swsta_cnt *c = t <= SWSTA_MAXTYPE ? &s->cnt[t] : &s->oob;
+		if (!c->get && !c->set) continue;
+		SWSTA_SNPRINTF(line, sizeof line, "a80211 sum type=%s%u get=%u set=%u ok=%u soft=%u gap=%u", t > SWSTA_MAXTYPE ? "oob" : "",
+			       (unsigned)(t > SWSTA_MAXTYPE ? 0 : t), (unsigned)c->get, (unsigned)c->set, (unsigned)c->ok, (unsigned)c->soft, (unsigned)c->gap);
+		swsta_log(s, line);
+	}
+	SWSTA_SNPRINTF(line, sizeof line, "a80211 summary requests=%u gaps=%u", (unsigned)s->requests, (unsigned)s->gaps);
+	swsta_log(s, line);
+	if (s->probe) {	/* LOWCLK B3 (patch 0363): the Set 383 keys seen, one line each, then the overflow and shape counts */
+		for (t = 0; t < s->p383_used; t++) {
+			SWSTA_SNPRINTF(line, sizeof line, "set383 summary key=%s n=%u len=%u", s->p383[t].key, (unsigned)s->p383[t].n, (unsigned)s->p383[t].len);
+			SWSTA_PROBE_LOG(line);
+		}
+		SWSTA_SNPRINTF(line, sizeof line, "set383 summary keys=%u table_full_new=%u shape_unexpected=%u", (unsigned)s->p383_used, (unsigned)s->p383_over, (unsigned)s->p383_shape);
+		SWSTA_PROBE_LOG(line);
+	}
+}
+
+#endif /* SWEET_WLAN_STA_H */
diff --git a/bsd/dev/sweet_wlan_a80211.h b/bsd/dev/sweet_wlan_a80211.h
new file mode 100644
index 0000000..a5d85c9
--- /dev/null
+++ b/bsd/dev/sweet_wlan_a80211.h
@@ -0,0 +1,234 @@
+/* sweet_wlan_a80211.h - kernel glue between the en0 ifnet and the Apple80211 station handler (P-W4, T-7241; goal W-D7).
+ *
+ * What it does (all KPI-free, host-tested by wlan_a80211_glue_host_test.c; the kernel file wlan_a80211_glue.c.in only supplies copyin/copyout, the lock and
+ * kev_post_msg_nowait):
+ *  - A80211 ioctls: SIOCSA80211 (_IOW('i',200,40 B)) / SIOCGA80211 (_IOWR('i',201,40 B)) carry a 40-byte `apple80211req` [src 110:65-77]. The handler copies
+ *    req_len bytes in (Set) or out (Get) through req_data (a USER address: the ifioctl `data` is only the 40-byte kernel copy) and calls swsta_a80211().
+ *    Any other command is NOT MINE and goes to the previous if_ioctl of the ifnet (en0_ioctl: SIOCGIFMEDIA IEEE80211|AUTO, link status, rule-8 GAP lines).
+ *  - events: swsta's post callback becomes a kern_event_msg with vendor 1 (KEV_VENDOR_APPLE), class 6 (KEV_IEEE80211_CLASS), subclass 1, event_code = the
+ *    APPLE80211_M_* number, event_data = ifname[16] (NUL padded) + payload [src 110:118-124]. Payload is empty today (layouts open, 110:128).
+ * Reachability of the ioctl, read from the built XNU 22.6.0 tree (the 110 open item 9 [guess] is closed): bsd/net/if.c ifioctl() (:3184) has no case for
+ * 'i' 200/201, so the first switch's `default:` (:3441-3449) copies `ifr_name` (= req_if_name, offset 0) and does ifunit_ref(); the second switch's `default:`
+ * (:3535-3553) calls pru_control (in_control(), bsd/netinet/in.c, default -> EOPNOTSUPP) and, on EOPNOTSUPP, ifnet_ioctl(ifp, ..., cmd, data)
+ * (bsd/net/dlil.c:7503) which calls ifp->if_ioctl. The 0x28 size is never compared with sizeof(ifreq) on that path [read from source; not run on hardware].
+ * SIOCGIFMEDIA: ifioctl_get_media() (if.c:3148) forwards SIOCGIFMEDIA64 to the driver; both structs are pack(4) so SIOCGIFMEDIA64 == SIOCGIFMEDIA == 0xc02c6938
+ * (struct ifmediareq64 compiled with clang on the host: 44 bytes) [measured on the host compiler, not the kernel build].
+ * Rules: 4 (no ssid/key/MAC in a log line: lines carry type, length, errno, counters), 8 (every refusal and every ignored value prints WIFI GAP:), 7.
+ */
+#ifndef WLAN_A80211_GLUE_H
+#define WLAN_A80211_GLUE_H
+
+#include <stdint.h>
+#include "sweet_wlan_sta.h"      /* the includer defines SWSTA_MEMCPY/MEMSET/SNPRINTF first (the kernel has no <string.h>/<stdio.h>), else the host libc */
+
+#define A80211_EINVAL 22u        /* same value on XNU and the host */
+#define A80211_EFAULT 14u
+#define A80211_EOPNOTSUPP SWSTA_EOPNOTSUPP   /* XNU 102, not the host's 95 */
+
+#define A80211_SIOCS 0x802869c8ul   /* _IOW('i', 200, 40 bytes) [src 110:68] */
+#define A80211_SIOCG 0xc02869c9ul   /* _IOWR('i', 201, 40 bytes) [src 110:69] */
+#define A80211_ENOTMINE (-1)        /* not an A80211 command: the caller chains to the previous if_ioctl */
+#define A80211_BUF 10016u           /* the longest cited request (CHANNELS_INFO, 110:142); swsta_len() never wants more */
+#define A80211_KEV_VENDOR 1u        /* KEV_VENDOR_APPLE */
+#define A80211_KEV_CLASS 6u         /* KEV_IEEE80211_CLASS [src bsd/sys/kern_event.h:100] */
+#define A80211_KEV_SUBCLASS 1u      /* [src 110:121] */
+#define A80211_IFNAMSIZ 16u
+#define A80211_GAP_EV "WIFI GAP: A80211 events carry an empty payload (per-event layouts open, 110:128)"
+
+struct a80211_req {                 /* apple80211req [obs-RE 110:75] */
+	char ifname[A80211_IFNAMSIZ];   /* @0x00 */
+	uint32_t type;                  /* @0x10 */
+	uint32_t val;                   /* @0x14 */
+	uint32_t len;                   /* @0x18 */
+	uint32_t pad;                   /* @0x1c */
+	uint64_t data;                  /* @0x20 user address of the buffer (64-bit process) */
+};
+_Static_assert(sizeof(struct a80211_req) == 40, "apple80211req is 40 bytes (110:68)");
+_Static_assert(__builtin_offsetof(struct a80211_req, type) == 0x10 && __builtin_offsetof(struct a80211_req, len) == 0x18 && __builtin_offsetof(struct a80211_req, data) == 0x20, "apple80211req layout (110:75)");
+
+/* what kev_post_msg_nowait gets: struct kev_msg with up to 2 vectors; the kernel glue copies it field by field */
+struct a80211_kev {
+	uint32_t vendor, kclass, subclass, code;
+	uint32_t n;
+	struct { uint32_t len; const void *ptr; } dv[2];
+};
+
+struct a80211_io {                  /* supplied by the includer; no member is named copyin/copyout: XNU defines those as function-like macros (offload gate build error, T-7241) */
+	void *ctx;
+	int (*uin)(void *ctx, uint64_t uaddr, void *dst, uint32_t n);          /* 0 or a positive errno (EFAULT) */
+	int (*uout)(void *ctx, const void *src, uint64_t uaddr, uint32_t n);
+	void (*lock)(void *ctx);
+	void (*unlock)(void *ctx);
+	int (*kev)(void *ctx, const struct a80211_kev *ev);                         /* 0 = posted */
+	void (*log)(void *ctx, const char *line);
+	void (*gap)(void *ctx, const char *text);                                   /* printed as "WIFI GAP: <text>" by the includer */
+};
+
+typedef int (*a80211_chain_fn)(void *ifp, unsigned long cmd, void *data);
+
+struct a80211 {
+	struct swsta sta;
+	struct a80211_io io;
+	a80211_chain_fn chain;          /* the ifnet's previous if_ioctl */
+	char ifname[A80211_IFNAMSIZ];
+	uint32_t reqs, faults, big, bad, chained, ev_posted, ev_failed;
+	uint8_t buf[A80211_BUF];        /* one request at a time (io.lock held) */
+};
+
+static inline void a80211_wipe(void *p, size_t n)
+{
+	volatile uint8_t *q = (volatile uint8_t *)p;
+	while (n-- > 0)
+		*q++ = 0;
+}
+
+static inline void a80211_gap(struct a80211 *g, const char *text)
+{
+	if (g->io.gap != NULL)
+		g->io.gap(g->io.ctx, text);
+}
+
+static inline void a80211_log_cb(void *cx, const char *line)
+{
+	struct a80211 *g = (struct a80211 *)cx;
+	if (g->io.log != NULL)
+		g->io.log(g->io.ctx, line);
+}
+
+static inline void a80211_gap_cb(void *cx, const char *text)
+{
+	a80211_gap((struct a80211 *)cx, text);
+}
+
+/* swsta post callback -> kern_event_msg(vendor 1, class 6, subclass 1, code, ifname[16] + payload) */
+static inline void a80211_post_cb(void *cx, uint32_t code)
+{
+	struct a80211 *g = (struct a80211 *)cx;
+	struct a80211_kev ev;
+	char name[A80211_IFNAMSIZ];
+	char t[64];
+	SWSTA_MEMSET(name, 0, sizeof name);
+	SWSTA_MEMCPY(name, g->ifname, sizeof name - 1u);
+	SWSTA_MEMSET(&ev, 0, sizeof ev);
+	ev.vendor = A80211_KEV_VENDOR; ev.kclass = A80211_KEV_CLASS; ev.subclass = A80211_KEV_SUBCLASS; ev.code = code;
+	ev.n = 1u; ev.dv[0].len = A80211_IFNAMSIZ; ev.dv[0].ptr = name;
+	if (g->io.kev == NULL || g->io.kev(g->io.ctx, &ev) != 0) {
+		g->ev_failed++;
+		SWSTA_SNPRINTF(t, sizeof t, "A80211 event %u not posted (kev failed)", (unsigned)code);
+		a80211_gap(g, t);
+		return;
+	}
+	g->ev_posted++;
+}
+
+/* W-UI: the same with a payload behind ifname[16] (kern_event_msg event_data = ifname + payload [src 110:118-124]; IO80211 reads the payload at kev +0x28 [obs-RE W-UI-wifid-current-network.md]) */
+static inline void a80211_post_data_cb(void *cx, uint32_t code, const void *d, uint32_t n)
+{
+	struct a80211 *g = (struct a80211 *)cx;
+	struct a80211_kev ev;
+	char name[A80211_IFNAMSIZ];
+	char t[64];
+	SWSTA_MEMSET(name, 0, sizeof name);
+	SWSTA_MEMCPY(name, g->ifname, sizeof name - 1u);
+	SWSTA_MEMSET(&ev, 0, sizeof ev);
+	ev.vendor = A80211_KEV_VENDOR; ev.kclass = A80211_KEV_CLASS; ev.subclass = A80211_KEV_SUBCLASS; ev.code = code;
+	ev.n = 2u; ev.dv[0].len = A80211_IFNAMSIZ; ev.dv[0].ptr = name; ev.dv[1].len = n; ev.dv[1].ptr = d;
+	if (g->io.kev == NULL || g->io.kev(g->io.ctx, &ev) != 0) {
+		g->ev_failed++;
+		SWSTA_SNPRINTF(t, sizeof t, "A80211 event %u (+%u B) not posted (kev failed)", (unsigned)code, (unsigned)n);
+		a80211_gap(g, t);
+		return;
+	}
+	g->ev_posted++;
+}
+
+/* The ifname is copied (NUL padded) at init; the glue never reads it back from the user's request. */
+static inline void a80211_init(struct a80211 *g, struct swsta_radio *r, const struct swsta_codec *codec, const struct a80211_io *io,
+			       const char *ifname, a80211_chain_fn chain)
+{
+	struct swsta_cb cb;
+	SWSTA_MEMSET(g, 0, sizeof *g);
+	g->io = *io; g->chain = chain;
+	{ uint32_t i; for (i = 0; i + 1u < sizeof g->ifname && ifname[i] != 0; i++) g->ifname[i] = ifname[i]; }
+	cb.log = a80211_log_cb; cb.gap = a80211_gap_cb; cb.post = a80211_post_cb; cb.post_data = a80211_post_data_cb; cb.cx = g;
+	swsta_init(&g->sta, r, codec, &cb);
+	a80211_gap(g, A80211_GAP_EV);
+}
+
+/* Returns 0 or a positive errno for SIOCSA80211 / SIOCGA80211, A80211_ENOTMINE for every other command.
+ * `data` is the 40-byte kernel copy of the request (ifioctl). Never logs the bytes. */
+static inline int a80211_ioctl(struct a80211 *g, unsigned long cmd, void *data)
+{
+	struct a80211_req rq;
+	int set, rc;
+	uint32_t len;
+	char t[96];
+	if (cmd != A80211_SIOCS && cmd != A80211_SIOCG)
+		return A80211_ENOTMINE;
+	if (data == NULL) {
+		g->bad++;
+		a80211_gap(g, "A80211 ioctl with no request body");
+		return A80211_EINVAL;
+	}
+	set = (cmd == A80211_SIOCS);
+	SWSTA_MEMCPY(&rq, data, sizeof rq);
+	len = rq.len;
+	if (g->io.lock != NULL) g->io.lock(g->io.ctx);
+	g->reqs++;
+	if (len > A80211_BUF) {
+		/* too long to buffer: the handler refuses it (swsta_len never wants more) and counts the GAP */
+		g->big++;
+		rc = swsta_a80211(&g->sta, set, rq.type, &rq.val, NULL, len);
+	} else if (len != 0 && rq.data == 0) {
+		g->bad++;
+		SWSTA_SNPRINTF(t, sizeof t, "A80211 type %u %s len %u has no req_data", (unsigned)rq.type, set ? "set" : "get", (unsigned)len);
+		a80211_gap(g, t);
+		rc = A80211_EINVAL;
+	} else {
+		void *buf = len != 0 ? (void *)g->buf : NULL;
+		rc = 0;
+		if (set && len != 0) {
+			rc = g->io.uin(g->io.ctx, rq.data, g->buf, len);
+			if (rc != 0) {
+				g->faults++;
+				SWSTA_SNPRINTF(t, sizeof t, "A80211 type %u set copyin failed errno %d", (unsigned)rq.type, rc);
+				a80211_gap(g, t);
+			}
+		} else if (len != 0) {
+			SWSTA_MEMSET(g->buf, 0, len);          /* a Get never leaks the previous request's bytes */
+		}
+		if (rc == 0) {
+			rc = swsta_a80211(&g->sta, set, rq.type, &rq.val, buf, len);
+			if (rc == 0 && !set && len != 0) {
+				rc = g->io.uout(g->io.ctx, g->buf, rq.data, len);
+				if (rc != 0) {
+					g->faults++;
+					SWSTA_SNPRINTF(t, sizeof t, "A80211 type %u get copyout failed errno %d", (unsigned)rq.type, rc);
+					a80211_gap(g, t);
+				}
+			}
+		}
+	}
+	if (!set && rc == 0)
+		((struct a80211_req *)data)->val = rq.val;      /* the 4-byte class answers in req_val (Get 21 [src 110:W-D7 R1]); the generic ioctl path copies `data` out for IOC_OUT [guess: BSD convention, sys_generic.c not in this clone] */
+	a80211_wipe(g->buf, len <= A80211_BUF ? len : A80211_BUF);      /* the ASSOCIATE body carries the key */
+	a80211_wipe(&rq, sizeof rq);
+	if (g->io.unlock != NULL) g->io.unlock(g->io.ctx);
+	return rc;
+}
+
+/* The if_ioctl the kernel glue installs: A80211 here, everything else to the previous handler (rule 8: no chain = EOPNOTSUPP + GAP). */
+static inline int a80211_if_ioctl(struct a80211 *g, void *ifp, unsigned long cmd, void *data)
+{
+	int rc = a80211_ioctl(g, cmd, data);
+	if (rc != A80211_ENOTMINE)
+		return rc;
+	g->chained++;
+	if (g->chain == NULL) {
+		a80211_gap(g, "A80211 glue has no previous if_ioctl: command refused");
+		return A80211_EOPNOTSUPP;
+	}
+	return g->chain(ifp, cmd, data);
+}
+
+#endif /* WLAN_A80211_GLUE_H */
diff --git a/bsd/dev/sweet_wlan_radio.h b/bsd/dev/sweet_wlan_radio.h
new file mode 100644
index 0000000..c0f4f7a
--- /dev/null
+++ b/bsd/dev/sweet_wlan_radio.h
@@ -0,0 +1,647 @@
+/* sweet_wlan_radio.h - the swsta_radio backend over the escan result events of the Wi-Fi chip (P-W4, T-431f; goal W-D7).
+ *
+ * PURPOSE: fills struct swsta_radio (sweet_wlan_sta.h) so the Apple80211 handler can answer Set 10 (scan) and Get 11 (scan result) from a real
+ * escan: power / scan_start / bss_next / join / leave / status. Header-only C99, no malloc, no libc beyond what sweet_wlan_sta.h includes
+ * (SWSTA_MEMCPY / SWSTA_MEMSET / SWSTA_SNPRINTF are reused). Include sweet_wlan_sta.h first.
+ *
+ * LAYERS: this file owns NO bus access and makes NO store. The chip side is a struct swr_link: its escan() posts the escan request and the event
+ * buffers over the msgbuf rings (the HW-WRITE part: every store goes through the deny-by-default list of the G2 glue, review 0174-*) and hands
+ * every ESCAN_RESULT event it reads to the sink given to it as (status, wl_escan_result bytes). The radio parses those bytes into swsta_bss,
+ * keeps the list for bss_next, and posts SWSTA_REV_SCAN_DONE.
+ *
+ * Tags: [src G2] = shim/sweet_wlan_g2.h swg_e_event / swg_e_items (the layout the boot-9 run parsed: obs docs/reviews/T-135a-proof.md, 8 BSS from
+ * event 69 status 8 items). Record offsets are the ones G2 reads: version +0, length +4, bssid +8, capability +16 (standard 802.11 position after
+ * beacon_period; not read by G2, NOT measured here), ssid_len +18, ssid +19, chanspec +72, rssi +78 (int16), ctl_ch +88.
+ *
+ * Rule 8 (no silent failure): every refusal, every dropped record, an unfinished scan (no status-0 event) and every unsupported verb (join,
+ * leave) calls the gap callback ("WIFI GAP:" is added by the includer's gap function) and is counted; swr_summary() prints gaps=N.
+ */
+#ifndef SWEET_WLAN_RADIO_H
+#define SWEET_WLAN_RADIO_H
+
+#include <stdint.h>
+
+#define SWR_EBUSY 16u			/* scan already running */
+#define SWR_MAX_BSS 64u			/* list capacity; more distinct BSSIDs are dropped with a gap [decision] */
+#define SWR_ST_OK 0u			/* ESCAN_RESULT status SUCCESS: the scan is complete [src G2 SWG_E_ST_OK] */
+#define SWR_ST_PARTIAL 8u		/* ESCAN_RESULT status PARTIAL: carries bss records [src G2 SWG_E_ST_PARTIAL] */
+#define SWR_BSS_VER 109u		/* wl_bss_info version we parse [src G2 SWG_E_BSS_VER] */
+#define SWR_RES_HDR 12u			/* wl_escan_result header: buflen +0, version +4, sync_id +8 (u16), bss_count +10 (u16) [src G2] */
+#define SWR_BSS_NEED 89u		/* record bytes read, through ctl_ch (+88) [src G2 SWG_E_BSS_NEED] */
+#define SWR_IE_CAP SWSTA_IE_CAP		/* bytes of IEs kept per BSS: 512 [decision] */
+/* 2026-11-11 scan records: offsets of wl_bss_info_v109 (host compile of the struct of refs/wlan-stage5/wlioctl.h.new:355-396 with offsetof, MCSSET_LEN 16: length 4, BSSID 8, beacon_period 14, capability 16, SSID_len 18, SSID 19,
+ * rateset.count 52, rateset.rates 56, chanspec 72, RSSI 78, phy_noise 80, ctl_ch 88, ie_offset 116, ie_length 120, SNR 124, sizeof 132; the 16 rates are u8 in 500 kbps units, bit 7 = basic) */
+#define SWR_BSS_SNR_END 126u		/* record bytes needed through SNR (+124, s16): the IE fields (ie_offset +116, ie_length +120) and SNR are read only from a record at least this long */
+#define SWR_SG_CHW 1u			/* once-per-scan GAP bits (struct swr.sgap) */
+#define SWR_SG_BAND 2u
+#define SWR_SG_RATES 4u
+#define SWR_SG_IEBAD 8u
+#define SWR_SG_IEPOS 16u
+#define SWR_SG_IECUT 32u
+#define SWR_SG_IESEC 64u
+#define SWR_SG_CHW2 128u
+#define SWR_SG_FULL 256u
+#define SWR_SYNC 0x1234u		/* the sync_id of our boot escan request [src G2 SWG_E_SYNC] */
+#define SWR_SYNC_N 0xFFu		/* review 0292 F2: the keep scans use SWR_SYNC + 1 .. + 0xFF (one per scan; the collector swg_ke_escan already passes only the id of the running scan): events with an id outside SWR_SYNC .. SWR_SYNC + SWR_SYNC_N are ignored */
+#define SWR_CAP_PRIVACY 0x0010u		/* 802.11 capability bit 4: some security is on (WEP/WPA/RSN: which one is open, so SWSTA_SEC_OTHER) */
+
+typedef void (*swr_sink_fn)(void *sink_cx, uint32_t status, const uint8_t *res, uint32_t len);
+
+/* patch 0292 (WIFI-COVERAGE D3/D4, Settings > Wi-Fi lists networks): the LIVE scan of the kept link. In keep mode the engine can scan again (WLC_SET_VAR escan through the keep thread, sweet_wlan_l25_hs.h swl25_sc_*), so Set 10 does not replay the boot-time listing but ASKS the keep
+ * thread (ascan.request, no engine access here, no wait) and returns at once; the keep thread collects the ESCAN_RESULT events into a scratch `struct swr` (swr_event is its sink: the same parser, dedupe by BSSID with the stronger RSSI, SWR_MAX_BSS bound) and, when the scan
+ * ended, calls swr_scan_finish under the radio lock, which swaps the list in and posts SCAN_DONE. The kinds below are the numbers of SWL25_SCR_* in sweet_wlan_l25_hs.h. errnos are the Darwin ones (ENXIO 6, ENETDOWN 50) as sweet_wlan_sta.h uses. */
+#define SWR_SCAN_COMPLETE 1u		/* ESCAN_RESULT status 0 seen */
+#define SWR_SCAN_TIMEOUT 2u		/* the keep thread's budget ran out */
+#define SWR_SCAN_LINKLOST 3u		/* the AP link went down during the scan */
+#define SWR_SCAN_FAILED 4u		/* the firmware refused the escan, a soft stop, or the engine ended */
+#define SWR_SCAN_REFUSED 5u		/* the keep thread refused a request that raced with a link loss */
+#define SWR_E_NXIO 6u			/* ascan.request: the live scan is off for this boot */
+#define SWR_E_NETDOWN 50u		/* ascan.request: the link is not UP (a re-join is in progress) */
+
+struct swr_ascan {
+	int (*request)(void *cx);	/* 0 = the keep thread will scan and call swr_scan_finish; SWR_E_NXIO = no live scan (fall back to the replay, loud); else a positive errno = refused */
+	void *cx;
+};
+
+struct swr_link {
+	/* Post the escan request, then read the ESCAN_RESULT events and call sink(sink_cx, status, wl_escan_result bytes, len) for each, until the
+	 * status-0 event or the link's own timeout. 0 = the sequence ran (a missing status-0 event is the radio's gap), else a positive errno.
+	 * BOUNDED: the caller (the A80211 handler) holds its mutex for the whole call, so a wired link MUST return within its own budget (the boot-9
+	 * escan used SWG_E_BUDGET_MS = 8000 ms) and never block unbounded; do not wire a link without that bound (review T-431f MEDIUM 4). */
+	int (*escan)(void *cx, swr_sink_fn sink, void *sink_cx);
+	void *cx;
+};
+
+/* T-08fd (goal W-D7 / P-W4, Settings > Wi-Fi): the escan link over the BOOT-TIME scan. The chip scan runs only inside the boot run (G2 L23, patch 0174; afterwards the bus master is
+ * undone and the CA7 re-halted, so no later scan is possible), which copies every ESCAN_RESULT event of our sync id (status + the 12 B header + first 89 B record) into a fixed
+ * record. This link replays them in order to the sink: no bus access, no store, no wait, so it is bounded by SWR_REPLAY_MAX events (<< the 8000 ms the contract above allows).
+ * The listing is STALE (as of the boot scan) and says so in a gap line on every replay (with the count of events the record lost, if any); an empty record is a refused scan with a gap line, never a silent empty list. */
+#define SWR_REPLAY_MAX 64u			/* events replayed at most = SWG_E_MAX, the capacity of the record [src sweet_wlan_g2.h SWG_E_MAX] */
+#define SWR_REPLAY_BUF (SWR_RES_HDR + SWR_BSS_NEED)	/* bytes of one event [src sweet_wlan_g2.h SWG_REC_RES] */
+
+/* get(i, &status, out, cap): the length (> 0) of event i, 0 = no more events, < 0 = error [src sweet_wlan_g2.h sweet_wlan_g2_escan_rec] */
+typedef int (*swr_rec_fn)(uint32_t i, uint32_t *status, uint8_t *out, uint32_t cap);
+
+struct swr_replay {
+	swr_rec_fn get;
+	uint32_t (*lost)(void);				/* events the record could not keep (NULL = none counted) [src sweet_wlan_g2.h sweet_wlan_g2_escan_lost] */
+	void (*gap)(void *cx, const char *text);	/* text <= 79 chars */
+	void *gap_cx;
+};
+/* the link the kernel glue and the host test both use: the exact wiring, so a test cannot pass over a different one */
+#define SWR_REPLAY_LINK(rp) { swr_replay_escan, (void *)(uintptr_t)(rp) }
+
+static inline int swr_replay_escan(void *cx, swr_sink_fn sink, void *sink_cx)
+{
+	const struct swr_replay *rp = cx;
+	uint8_t buf[SWR_REPLAY_BUF];
+	char g[80];
+	uint32_t i, st, lost;
+	int len;
+
+	if (!rp || !rp->get || !sink) return SWSTA_EIO;
+	for (i = 0; i < SWR_REPLAY_MAX; i++) {
+		st = 0;
+		len = rp->get(i, &st, buf, sizeof buf);
+		if (len < 0) {
+			SWSTA_SNPRINTF(g, sizeof g, "boot-time scan record unreadable at event %u (rc %d), replay stopped", (unsigned)i, len);
+			if (rp->gap) rp->gap(rp->gap_cx, g);
+			return SWSTA_EIO;
+		}
+		if (len == 0) break;
+		sink(sink_cx, st, buf, (uint32_t)len);
+	}
+	if (i == 0) {
+		if (rp->gap) rp->gap(rp->gap_cx, "no boot-time scan recorded (L23 did not run or gave no result): scan refused");
+		return SWSTA_EIO;
+	}
+	lost = rp->lost ? rp->lost() : 0;
+	if (lost) SWSTA_SNPRINTF(g, sizeof g, "boot-time scan list replayed (stale, %u events, %u LOST: record full)", (unsigned)i, (unsigned)lost);
+	else SWSTA_SNPRINTF(g, sizeof g, "scan list replayed from the boot-time scan (stale, %u events)", (unsigned)i);
+	if (rp->gap) rp->gap(rp->gap_cx, g);
+	return 0;
+}
+
+struct swr_cb {
+	void (*log)(void *cx, const char *line);
+	void (*gap)(void *cx, const char *text);	/* text <= 79 chars */
+	void *cx;
+};
+
+struct swr {
+	struct swsta_radio radio;	/* hand &r.radio to swsta_init / a80211_init; radio.ctx points back here */
+	struct swr_link link; struct swr_cb cb;
+	int on, scanning, complete;
+	struct swsta_bss bss[SWR_MAX_BSS]; uint32_t n, cur;
+	uint32_t scans, events, parsed, dup, dropped, ignored, partial, gaps, replaced;	/* replaced = records that took the place of the weakest entry of a full table (review 0293 LOW 2) */
+	uint16_t sgap;			/* SWR_SG_* bits: the record GAPs already told in this scan (reset with the table) */
+	/* W-UI (sprint 2026-11-08, xnu patch 0268 keep mode): the boot run's link is still up. kept.joined = 1 makes status report it, join of the same SSID succeed with a note, any other join
+	 * and leave refuse with a GAP, power off refuse; set by swr_kept_set only. */
+	struct swsta_status kept; uint32_t kept_joins, kept_refused, kept_rssi_n;
+	/* patch 0281 (W-D6): the keep thread saw the AP link go down (link-loss event): kept.joined is cleared by swr_kept_clear and stays so (UP again is patch 0282); a join while this is set is refused */
+	uint8_t kept_down; uint32_t kept_down_n, kept_up_n;
+	/* 2026-11-11 (W-D3-weak-security): the join target's own beacon/probe record (IEs, rates, beacon, noise, SNR, channel flags) as the boot scan read it (swr_kept_target); Get 103 answers it from the first request on, before any keep scan */
+	struct swsta_bss kept_bss; uint8_t kept_bss_ok;
+	/* patch 0292: the live scan (see swr_ascan). live = 1 while a scan requested from the keep thread is outstanding (scanning is then 1 too) */
+	struct swr_ascan ascan; uint8_t live; uint32_t live_req, live_done, live_bad, live_refused, live_fallback;
+};
+
+static inline void swr_gap(struct swr *s, const char *text)
+{
+	s->gaps++;
+	if (s->cb.gap) s->cb.gap(s->cb.cx, text);
+}
+
+static inline uint32_t swr_le16(const uint8_t *p) { return (uint32_t)p[0] | (uint32_t)p[1] << 8; }
+static inline uint32_t swr_le32(const uint8_t *p) { return swr_le16(p) | swr_le16(p + 2) << 16; }
+
+static inline int swr_same6(const uint8_t *a, const uint8_t *b)
+{
+	uint32_t i;
+	for (i = 0; i < 6; i++) if (a[i] != b[i]) return 0;
+	return 1;
+}
+
+static inline int swr_eqn(const uint8_t *a, const uint8_t *b, uint32_t n)
+{
+	uint32_t i;
+	for (i = 0; i < n; i++) if (a[i] != b[i]) return 0;
+	return 1;
+}
+
+/* once per scan: a GAP for a record field the shim could not use (rule 7); the bit keeps one busy scan from flooding the log */
+static inline void swr_gap1(struct swr *s, uint32_t bit, const char *text)
+{
+	if (s->sgap & bit) return;
+	s->sgap |= (uint16_t)bit;
+	swr_gap(s, text);
+}
+
+/* the record's channel flags from the chanspec [src refs/wlan-stage5/bcmwifi_channels.h.new: band mask 0xc000 at :149, 2G 0x0000 :151, 5G 0xc000 :154, bandwidth mask 0x3800 :137, BW_20 0x1000 :141, BW_40 0x1800 :142, BW_80 0x2000 :143]
+ * to W-D3 s.3 [obs-RE] 0x2 = 20 MHz, 0x4 = 40 MHz, 0x8 = 2.4 GHz, 0x10 = 5 GHz. 80 / 160 MHz (and anything else): the band bit only, the width bit for them is open (GAP once per scan). */
+static inline uint32_t swr_chflags(struct swr *s, uint32_t cs)
+{
+	uint32_t f = 0, band = cs & 0xC000u, bw = cs & 0x3800u;
+
+	if (band == 0x0000u) f = 0x8u;
+	else if (band == 0xC000u) f = 0x10u;
+	else swr_gap1(s, SWR_SG_BAND, "channel band is not 2.4/5 GHz, channel flags 0");
+	if (bw == 0x1000u) f |= 0x2u;
+	else if (bw == 0x1800u) f |= 0x4u;
+	else if (band == 0x0000u || band == 0xC000u) {
+		if (bw == 0x2000u) swr_gap1(s, SWR_SG_CHW, "80 MHz channel flag bit open, band bit only");
+		else swr_gap1(s, SWR_SG_CHW2, "channel width flag bit open (not 20/40 MHz), band bit only");
+	}
+	return f;
+}
+
+/* The IE block ie[0..n) of one record into b: whole IEs (id, len, len bytes) from the start while they fit SWR_IE_CAP; a walk whose length runs past the end stops at the last whole IE (GAP once per scan); a
+ * block cut at the cap is a GAP once per scan, and a security IE that is NOT kept (RSN id 48, or the WPA vendor IE id 221 with 00:50:f2 type 1 [W-D3 s.4 (f)]; iOS reads security only from these) is a GAP of its own. */
+static inline void swr_ie(struct swr *s, struct swsta_bss *b, const uint8_t *ie, uint32_t n)
+{
+	uint32_t o = 0, l, stored = 0, cut = 0, lost = 0, bad = 0, sec;
+
+	while (o < n) {
+		if (n - o < 2u || (uint32_t)ie[o + 1] > n - o - 2u) { bad = 1; break; }
+		l = ie[o + 1];
+		sec = ie[o] == 48u || (ie[o] == 221u && l >= 4u && ie[o + 2] == 0x00u && ie[o + 3] == 0x50u && ie[o + 4] == 0xF2u && ie[o + 5] == 0x01u);
+		if (stored == o && o + 2u + l <= SWR_IE_CAP) {
+			SWSTA_MEMCPY(b->ie + o, ie + o, 2u + l);
+			stored = o + 2u + l;
+		} else {
+			cut = 1;
+			if (sec) lost = 1;
+		}
+		o += 2u + l;
+	}
+	b->ie_len = (uint16_t)stored;
+	if (bad) swr_gap1(s, SWR_SG_IEBAD, "bss_info IE walk runs past the block, cut at the last whole IE");
+	if (cut) swr_gap1(s, SWR_SG_IECUT, "bss_info IEs above 512 B, cut at an IE boundary");
+	if (lost) swr_gap1(s, SWR_SG_IESEC, "security IE beyond IE cap, network shows as WEP");
+}
+
+/* One ESCAN_RESULT event (a sink call). Never trusts len: every read is bounded by it. */
+static inline void swr_event(void *cx, uint32_t status, const uint8_t *res, uint32_t len)
+{
+	struct swr *s = cx;
+	struct swsta_bss b;
+	const uint8_t *r;
+	uint32_t i, ch, cs, cap, sl, avail, rlen, nr, ioff, ilen;
+	char g[80];
+
+	s->events++;
+	if (!res || len < SWR_RES_HDR) { s->ignored++; swr_gap(s, "scan result event shorter than the 12-byte header, ignored"); return; }
+	if (swr_le16(res + 8) < SWR_SYNC || swr_le16(res + 8) > SWR_SYNC + SWR_SYNC_N) { s->ignored++; swr_gap(s, "scan result sync_id differs from ours, ignored"); return; }
+	if (status == SWR_ST_OK) { s->complete = 1; return; }
+	if (status != SWR_ST_PARTIAL) {
+		s->ignored++;
+		SWSTA_SNPRINTF(g, sizeof g, "scan result status %u not handled, scan treated as unfinished", (unsigned)status);
+		swr_gap(s, g);
+		return;
+	}
+	s->partial++;
+	if (swr_le16(res + 10) == 0 || len < SWR_RES_HDR + SWR_BSS_NEED) { s->ignored++; swr_gap(s, "partial scan result without a full bss record, ignored"); return; }
+	if (swr_le16(res + 10) > 1) swr_gap(s, "scan result bss_count above 1, only the first record parsed");
+	r = res + SWR_RES_HDR;
+	if (swr_le32(r) != SWR_BSS_VER) { s->ignored++; swr_gap(s, "bss_info version is not 109, record not parsed"); return; }
+	if (swr_le32(r + 4) < SWR_BSS_NEED) { s->ignored++; swr_gap(s, "bss_info length shorter than the fields read, record not parsed"); return; }
+	sl = r[18];
+	if (sl > 32u) { s->ignored++; swr_gap(s, "bss_info ssid_len above 32, record not parsed"); return; }
+	SWSTA_MEMSET(&b, 0, sizeof b);
+	SWSTA_MEMCPY(b.bssid, r + 8, 6);
+	b.ssid_len = (uint8_t)sl;
+	SWSTA_MEMCPY(b.ssid, r + 19, sl);
+	cs = swr_le16(r + 72);
+	ch = r[88] != 0 ? r[88] : (cs & 0xFFu);		/* the control channel, else the chanspec channel byte [src G2] */
+	b.channel = ch;
+	b.rssi = (int32_t)(int16_t)swr_le16(r + 78);
+	cap = swr_le16(r + 16);
+	b.sec = (cap & SWR_CAP_PRIVACY) ? SWSTA_SEC_OTHER : SWSTA_SEC_OPEN;
+	/* 2026-11-11 scan records. The fields through ctl_ch (+88) are inside the SWR_BSS_NEED bytes every record has (the boot-time replay too); SNR and the IEs need a longer record. */
+	rlen = swr_le32(r + 4);
+	avail = len - SWR_RES_HDR;
+	if (avail > rlen) avail = rlen;		/* the record's own length bounds what is read */
+	b.beacon = (uint16_t)swr_le16(r + 14);
+	b.noise = (int16_t)(int8_t)r[80];
+	b.chflags = swr_chflags(s, cs);
+	nr = swr_le32(r + 52);
+	if (nr > SWSTA_RATE_MAX) { swr_gap1(s, SWR_SG_RATES, "bss_info rate count above 15, clamped"); nr = SWSTA_RATE_MAX; }
+	b.nrates = (uint8_t)nr;
+	for (i = 0; i < nr; i++) b.rates[i] = (uint8_t)((r[56 + i] & 0x7Fu) / 2u);
+	if (avail >= SWR_BSS_SNR_END) {
+		b.snr = (int16_t)swr_le16(r + 124);
+		ioff = swr_le16(r + 116); ilen = swr_le32(r + 120);
+		if (ilen != 0) {
+			if (ioff < SWR_BSS_SNR_END || ioff > rlen || ilen > rlen - ioff) swr_gap1(s, SWR_SG_IEPOS, "bss_info ie_offset/ie_length outside the record, IEs dropped");
+			else {
+				if (ioff > avail || ilen > avail - ioff) { swr_gap1(s, SWR_SG_IEPOS, "bss_info IEs beyond the bytes read, partial IE block"); ilen = ioff > avail ? 0 : avail - ioff; }
+				swr_ie(s, &b, r + ioff, ilen);
+			}
+		}
+	}
+	for (i = 0; i < s->n; i++) {
+		if (!swr_same6(s->bss[i].bssid, b.bssid)) continue;
+		s->dup++;
+		if (b.rssi > s->bss[i].rssi) s->bss[i] = b;	/* the same BSSID again (another channel or a repeat): keep the stronger */
+		return;
+	}
+	if (s->n >= SWR_MAX_BSS) {	/* review 0293 LOW 2: a full table keeps the strongest 64: a stronger record takes the place of the weakest entry (the first of equals), a weaker or equal one is dropped; one GAP per scan, the counts go into the scan-end line */
+		uint32_t w = 0;
+		for (i = 1; i < s->n; i++) if (s->bss[i].rssi < s->bss[w].rssi) w = i;
+		swr_gap1(s, SWR_SG_FULL, "scan list full (64 BSSID): weakest replaced by a stronger record, else dropped");
+		if (b.rssi > s->bss[w].rssi) { s->bss[w] = b; s->replaced++; } else s->dropped++;
+		return;
+	}
+	s->bss[s->n++] = b;
+	s->parsed++;
+}
+
+static inline int swr_power(void *c, int op, int *state)
+{
+	struct swr *s = c;
+	if (op == SWSTA_PWR_OFF && s->kept.joined) {	/* W-UI: the chip cannot be taken down while the boot-run link is kept (no engine undo path in the running system) */
+		s->kept_refused++;
+		swr_gap(s, "power off refused: the boot-run link is kept and cannot be torn down");
+		return SWSTA_EOPNOTSUPP;
+	}
+	if (op == SWSTA_PWR_ON || op == SWSTA_PWR_OFF) {
+		if (op == SWSTA_PWR_ON && !s->link.escan) { swr_gap(s, "power on refused: no escan link attached"); return SWSTA_EIO; }
+		s->on = op == SWSTA_PWR_ON;
+		swr_gap(s, "power is a flag only: the chip is brought up by the boot sequence");
+	} else if (op != SWSTA_PWR_GET) {
+		swr_gap(s, "power op unknown, refused");
+		return SWSTA_EINVAL;
+	}
+	*state = s->on;
+	return 0;
+}
+
+static inline int swr_scan_start(void *c)
+{
+	struct swr *s = c;
+	struct swsta_rev ev;
+	int rc;
+
+	if (!s->on) { swr_gap(s, "scan refused: radio is off"); return SWSTA_EIO; }
+	if (s->scanning) { swr_gap(s, "scan refused: one is already running"); return SWR_EBUSY; }
+	if (s->ascan.request != NULL) {	/* patch 0292: keep mode, the live scan */
+		int rq;
+
+		if (s->kept_down) {	/* the re-join machine (patch 0282) owns the engine until it is UP again: never scan, never start a second thing behind its back */
+			s->live_refused++;
+			if (s->cb.log) s->cb.log(s->cb.cx, "scan refused: the kept link is DOWN (AP lost), the driver is re-joining");
+			swr_gap(s, "scan refused while the kept link is DOWN (AP lost): the re-join (patch 0282) runs first");
+			return SWR_E_NETDOWN;
+		}
+		rq = s->ascan.request(s->ascan.cx);
+		if (rq == 0) {
+			s->scanning = 1; s->live = 1; s->scans++; s->live_req++;
+			if (s->cb.log) s->cb.log(s->cb.cx, "scan requested: the keep thread runs a live passive escan (all channels), SCAN_DONE follows");
+			return 0;
+		}
+		if (rq != (int)SWR_E_NXIO) {
+			char g[80];
+
+			s->live_refused++;
+			SWSTA_SNPRINTF(g, sizeof g, "live scan refused by the keep thread (errno %d: %s)", rq, rq == (int)SWR_E_NETDOWN ? "link not UP" : rq == (int)SWR_EBUSY ? "one is already pending" : "see the log");
+			swr_gap(s, g);
+			return (uint32_t)rq == SWR_E_NETDOWN || (uint32_t)rq == SWR_EBUSY ? rq : (int)SWSTA_EIO;
+		}
+		s->live_fallback++;
+		swr_gap(s, "live scan not available (off for this boot): the boot-time listing is replayed instead, STALE");
+	}
+	if (!s->link.escan) { swr_gap(s, "scan refused: no escan link attached"); return SWSTA_EIO; }
+	s->scanning = 1; s->complete = 0; s->n = 0; s->cur = 0; s->sgap = 0; s->scans++;
+	rc = s->link.escan(s->link.cx, swr_event, s);
+	s->scanning = 0;
+	if (rc != 0) {
+		char g[80];
+		SWSTA_SNPRINTF(g, sizeof g, "escan link failed rc %d, %u BSS kept as a partial list", rc, (unsigned)s->n);
+		swr_gap(s, g);
+		return SWSTA_EIO;
+	}
+	if (!s->complete) {
+		char g[80];
+		SWSTA_SNPRINTF(g, sizeof g, "scan-done status 0 not seen: listing %u BSS as a partial result", (unsigned)s->n);
+		swr_gap(s, g);
+	}
+	s->cur = 0;
+	if (s->radio.up) { ev.kind = SWSTA_REV_SCAN_DONE; ev.result = 0; ev.reason = 0; s->radio.up(s->radio.up_ctx, &ev); }
+	else swr_gap(s, "scan done not posted: no event callback set (swsta_init not run)");
+	return 0;
+}
+
+/* The scratch table the keep thread fills (its sink is swr_event on it): start empty. The per-scan counters restart, the gap counter stays. Called when the scan is requested, before the keep thread sees the request. */
+static inline void swr_tab_reset(struct swr *t)
+{
+	t->n = 0; t->cur = 0; t->complete = 0; t->sgap = 0;
+	t->events = t->parsed = t->dup = t->dropped = t->ignored = t->partial = t->replaced = 0;
+}
+
+static inline void swr_ascan_set(struct swr *s, int (*request)(void *cx), void *cx)
+{
+	s->ascan.request = request; s->ascan.cx = cx;
+}
+
+/* The keep thread's live scan ended (kind SWR_SCAN_*; `tab` = its scratch table, `ms` = how long, `ev` = ESCAN_RESULT events of our sync id it counted). The caller holds the radio mutex. Swaps the list in (whatever was collected, also after a timeout / link loss / failure: the
+ * old listing would be stale, so it is replaced, and the kind says so in a GAP), rewinds Get 11 and posts SCAN_DONE so that wifid's pending Set 10 resolves. One log line, counts only (never an SSID or BSSID). 1 = delivered, 0 = no scan was outstanding (a GAP). */
+static inline int swr_scan_finish(struct swr *s, const struct swr *tab, uint32_t kind, uint32_t ms, uint32_t ev)
+{
+	struct swsta_rev e;
+	char l[160], g[80];
+	uint32_t n;
+
+	if (!s->scanning || !s->live) {
+		s->live_bad++;
+		swr_gap(s, "live scan result delivered but none was requested, dropped");
+		return 0;
+	}
+	n = tab->n > SWR_MAX_BSS ? SWR_MAX_BSS : tab->n;
+	SWSTA_MEMCPY(s->bss, tab->bss, n * sizeof s->bss[0]);
+	s->n = n; s->cur = 0; s->complete = kind == SWR_SCAN_COMPLETE; s->scanning = 0; s->live = 0; s->live_done++;
+	s->events += tab->events; s->parsed += tab->parsed; s->dup += tab->dup; s->dropped += tab->dropped; s->ignored += tab->ignored; s->partial += tab->partial; s->replaced += tab->replaced;
+	SWSTA_SNPRINTF(l, sizeof l, "radio scan done: %s, records=%u events=%u partial=%u dup=%u dropped=%u ignored=%u ms=%u replaced=%u", kind == SWR_SCAN_COMPLETE ? "complete" : kind == SWR_SCAN_TIMEOUT ? "timeout" : kind == SWR_SCAN_LINKLOST ? "link lost" :
+	    kind == SWR_SCAN_REFUSED ? "refused" : "failed", (unsigned)n, (unsigned)ev, (unsigned)tab->partial, (unsigned)tab->dup, (unsigned)tab->dropped, (unsigned)tab->ignored, (unsigned)ms, (unsigned)tab->replaced);
+	if (s->cb.log) s->cb.log(s->cb.cx, l);
+	if (kind != SWR_SCAN_COMPLETE) {
+		SWSTA_SNPRINTF(g, sizeof g, "live scan ended unfinished (kind %u), %u BSS listed as a partial result", (unsigned)kind, (unsigned)n);
+		swr_gap(s, g);
+	}
+	if (s->radio.up) { e.kind = SWSTA_REV_SCAN_DONE; e.result = 0; e.reason = 0; s->radio.up(s->radio.up_ctx, &e); }
+	else swr_gap(s, "scan done not posted: no event callback set (swsta_init not run)");
+	return 1;
+}
+
+/* optional radio verb: the record to answer Get 103 of the kept link with, for this BSSID. Order: the entry of the latest scan list if it has IEs (newer), else the join target's own record kept at the hand-over (swr_kept_target), else a scan-list entry without IEs.
+ * 1 = found (the caller still sees ie_len 0 if no source had IEs) */
+static inline int swr_bss_find(void *c, const uint8_t bssid[6], struct swsta_bss *out)
+{
+	struct swr *s = c;
+	uint32_t i, hit = s->n;
+	for (i = 0; i < s->n; i++) {
+		if (swr_same6(s->bss[i].bssid, bssid)) { hit = i; break; }
+	}
+	if (hit < s->n && s->bss[hit].ie_len != 0) { *out = s->bss[hit]; return 1; }
+	if (s->kept_bss_ok && swr_same6(s->kept_bss.bssid, bssid)) { *out = s->kept_bss; return 1; }
+	if (hit < s->n) { *out = s->bss[hit]; return 1; }
+	return 0;
+}
+
+static inline int swr_bss_next(void *c, struct swsta_bss *out)
+{
+	struct swr *s = c;
+	if (s->cur >= s->n) return 0;
+	*out = s->bss[s->cur++];
+	return 1;
+}
+
+/* The kept link (W-UI; sprint 2026-11-08, xnu patch 0268): the boot run joined and the dongle was left running, so the truth is "joined" with the values the run knew. NO bus access and NO store:
+ * the values are copied once by the glue from the firmware's own report after L26 (swr_kept_set), never refreshed (said so once at set time).
+ * Join of the SAME SSID (and the same BSSID when the request names one) succeeds with a printed note and the ASSOC_DONE event (Set 20 -> Get 21 answers success); any other join, and leave,
+ * are refused with a GAP (a leave would need the engine to disassociate: not built, W-JOIN). */
+static inline int swr_join(void *c, const struct swsta_join *j)
+{
+	struct swr *s = c;
+
+	if (s->kept_down) {	/* patch 0281: the AP link was lost; no join is answered success until the keep thread's own re-join (patch 0282, swr_kept_up) has a new 4-way done: wifid's join request must not start a second join behind the machine's back */
+		s->kept_refused++;
+		if (s->cb.log) s->cb.log(s->cb.cx, "join refused: the kept link is DOWN (AP lost), the driver re-joins by itself");
+		swr_gap(s, "join refused while the kept link is DOWN (AP lost): the keep thread re-joins by itself (patch 0282)");
+		return SWSTA_EOPNOTSUPP;
+	}
+	if (s->kept.joined) {
+		if (j != NULL && j->ssid_len == s->kept.ssid_len && swr_eqn(j->ssid, s->kept.ssid, j->ssid_len) && (!j->has_bssid || swr_same6(j->bssid, s->kept.bssid))) {
+			struct swsta_rev ev;
+
+			s->kept_joins++;
+			if (s->cb.log) s->cb.log(s->cb.cx, "join of the kept network: already joined by the boot run, answered success, no radio action");
+			if (s->radio.up) { ev.kind = SWSTA_REV_ASSOC_DONE; ev.result = 0; ev.reason = 0; s->radio.up(s->radio.up_ctx, &ev); }
+			else swr_gap(s, "kept join: ASSOC_DONE not posted, no event callback set (swsta_init not run)");
+			return 0;
+		}
+		s->kept_refused++;
+		swr_gap(s, "join of another network refused: only the boot-run link is kept");
+		return SWSTA_EOPNOTSUPP;
+	}
+	swr_gap(s, "join not supported by the radio backend (W-JOIN)");
+	return SWSTA_EOPNOTSUPP;
+}
+
+static inline int swr_leave(void *c)
+{
+	struct swr *s = c;
+
+	if (s->kept.joined) s->kept_refused++;
+	swr_gap(c, "leave not supported by the radio backend (W-JOIN)");
+	return SWSTA_EOPNOTSUPP;
+}
+
+static inline int swr_status(void *c, struct swsta_status *out)
+{
+	struct swr *s = c;
+
+	if (s->kept.joined) { *out = s->kept; return 0; }
+	SWSTA_MEMSET(out, 0, sizeof *out);	/* never joined: the backend has no join, so "not joined" is the truth, not a stub */
+	return 0;
+}
+
+/* Marks the radio as holding the boot-run link, with the values the FIRMWARE reported after L26 (sweet_wlan_l25_hs.h swl25_live: the SSID element of its association request, WLC_GET_BSSID,
+ * "chanspec", WLC_GET_RSSI), never the join's credentials or the boot scan record. `ok` = swl25h.live_ok (1 ssid, 2 bssid, 4 channel, 8 rssi). SSID and BSSID are required (else not joined, a GAP);
+ * a missing channel or RSSI answers 0 with a GAP. The values are read once at the hand-over and not refreshed (a GAP says so). Returns 1 = joined. Call before swsta_init so the power flag is read as ON.
+ * One log line without the SSID or BSSID bytes. */
+static inline int swr_kept_set(struct swr *s, const uint8_t *ssid, uint32_t ssid_len, const uint8_t bssid[6], uint32_t channel, int32_t rssi, uint32_t ok)
+{
+	char l[140];
+
+	SWSTA_MEMSET(&s->kept, 0, sizeof s->kept);
+	if ((ok & 3u) != 3u || ssid == NULL || ssid_len == 0 || ssid_len > 32u || bssid == NULL) {
+		swr_gap(s, "kept link not set: the firmware's SSID or BSSID was not read");
+		return 0;
+	}
+	s->kept.joined = 1;
+	SWSTA_MEMCPY(s->kept.ssid, ssid, ssid_len);
+	s->kept.ssid_len = (uint8_t)ssid_len;
+	SWSTA_MEMCPY(s->kept.bssid, bssid, 6);
+	s->kept.sec = SWSTA_SEC_WPA2_PSK;	/* the boot run joined with the WPA2-PSK credentials (swc_creds security 0) and the 4-way installed CCMP keys [src sweet_wlan_cred.h, sweet_wlan_l25_hs.h] */
+	s->on = 1;
+	s->kept.channel = (ok & 4u) ? channel : 0u;
+	s->kept.rssi = (ok & 8u) ? rssi : 0;
+	if (!(ok & 4u)) swr_gap(s, "kept link: channel not read from the firmware, answered 0");
+	if (!(ok & 8u)) swr_gap(s, "kept link: RSSI not read from the firmware, answered 0");
+	swr_gap(s, "kept link: firmware values read once at the hand-over; RSSI is refreshed only by swr_kept_rssi (patch 0273 keep thread), channel/BSSID/SSID are that snapshot");
+	SWSTA_SNPRINTF(l, sizeof l, "radio kept link: joined (firmware values) ssid_len=%u chan=%u rssi=%d sec=wpa2-psk ok=%#x", (unsigned)ssid_len, (unsigned)s->kept.channel, (int)s->kept.rssi, (unsigned)ok);
+	if (s->cb.log) s->cb.log(s->cb.cx, l);
+	return 1;
+}
+
+/* Part A (sprint-wifi 2026-11-09): a newer RSSI the FIRMWARE reported (WLC_GET_RSSI, -127..-1) for the kept link; what Get 16 / the link status answer from now on. 1 = taken, 0 = refused (not joined / out of range, a GAP) */
+static inline int swr_kept_rssi(struct swr *s, int32_t rssi)
+{
+	if (!s->kept.joined || rssi >= 0 || rssi < -127) {
+		swr_gap(s, "kept link: RSSI refresh refused (not joined or value outside -127..-1)");
+		return 0;
+	}
+	s->kept.rssi = rssi;
+	s->kept_rssi_n++;
+	return 1;
+}
+
+/* patch 0281 (W-D6): the AP link is gone (the keep thread's detector saw a link-loss event). Clears kept.joined (swr_status then reports not joined, so the LINK_CHANGED payload byte 0 is isLinkDown = 1), remembers it (kept_down: swr_join answers failure), and,
+ * when `post` is non-zero, fires SWSTA_REV_LINK_DOWN so wifid gets LINK_CHANGED. The caller holds the radio mutex (sweet_wlan_a80211_kept_link). No firmware command, no bus access. 1 = cleared and posted/ready, 0 = nothing to clear (not kept-joined, or already down). */
+static inline int swr_kept_clear(struct swr *s, int post)
+{
+	struct swsta_rev ev;
+
+	if (s->kept_down || !s->kept.joined) {
+		return 0;
+	}
+	s->kept.joined = 0;
+	s->kept_down = 1;
+	s->kept_down_n++;
+	if (s->cb.log) s->cb.log(s->cb.cx, "radio kept link: DOWN (AP link lost), joined cleared, join requests are refused");
+	if (post) {
+		if (s->radio.up) { ev.kind = SWSTA_REV_LINK_DOWN; ev.result = 0; ev.reason = 0; s->radio.up(s->radio.up_ctx, &ev); }
+		else swr_gap(s, "kept link DOWN: LINK_DOWN not posted, no event callback set (swsta_init not run)");
+	}
+	return 1;
+}
+
+/* 2026-11-11 (W-D3-weak-security): the join target's record as the boot scan (L23) or the BSS_INFO answer carried it, handed over with the kept link. ie = the IE block (ie_len bytes, ie_short = the record had more than the caller kept), rates = 500 kbps entries.
+ * The IEs are cut to SWR_IE_CAP at an IE boundary with the same GAPs as a scan record (swr_ie). Only for the kept BSSID: another BSSID is refused with a GAP (an earlier record stays). No IEs at all = a GAP that says Settings will show Weak Security (the privacy bit is NOT dropped). 1 = taken */
+static inline int swr_kept_target(struct swr *s, const uint8_t bssid[6], const uint8_t *ie, uint32_t ie_len, uint32_t ie_short, uint32_t chspec, uint32_t beacon, int32_t noise, int32_t snr, const uint8_t *rates, uint32_t nrates)
+{
+	struct swsta_bss b;
+	uint32_t i;
+
+	if (bssid == NULL || !s->kept.joined || !swr_same6(s->kept.bssid, bssid)) {
+		swr_gap(s, "kept target record is not for the kept BSSID, ignored");
+		return 0;
+	}
+	SWSTA_MEMSET(&b, 0, sizeof b);
+	SWSTA_MEMCPY(b.bssid, bssid, 6);
+	SWSTA_MEMCPY(b.ssid, s->kept.ssid, s->kept.ssid_len);
+	b.ssid_len = s->kept.ssid_len;
+	b.channel = s->kept.channel; b.rssi = s->kept.rssi; b.sec = s->kept.sec;
+	s->sgap = 0;
+	b.chflags = swr_chflags(s, chspec);
+	b.beacon = (uint16_t)beacon;
+	b.noise = (int16_t)noise; b.snr = (int16_t)snr;
+	if (nrates > SWSTA_RATE_MAX) { swr_gap1(s, SWR_SG_RATES, "kept target rate count above 15, clamped"); nrates = SWSTA_RATE_MAX; }
+	b.nrates = (uint8_t)nrates;
+	for (i = 0; i < nrates; i++) b.rates[i] = (uint8_t)((rates[i] & 0x7Fu) / 2u);
+	if (ie_len != 0 && ie != NULL) swr_ie(s, &b, ie, ie_len);
+	if (ie_short) swr_gap1(s, SWR_SG_IEPOS, "kept target IE block longer than 1024 B, the tail is not kept");
+	if (b.ie_len == 0) swr_gap(s, "kept target record has no IEs: Get 103 answers privacy without RSN IE, Settings will show Weak Security");
+	s->kept_bss = b;
+	s->kept_bss_ok = 1;
+	if (s->cb.log) {
+		char l[100];
+		SWSTA_SNPRINTF(l, sizeof l, "radio kept target record: ie_len=%u rates=%u beacon=%u chflags=%#x", (unsigned)b.ie_len, (unsigned)b.nrates, (unsigned)b.beacon, (unsigned)b.chflags);
+		s->cb.log(s->cb.cx, l);
+	}
+	return 1;
+}
+
+/* patch 0282 (W-D6 boot B): the keep thread's re-join is done (new SSID/LINK events, a new 4-way, keys installed). The kept SSID stays; the BSSID (a re-join may land on another AP), the channel and the RSSI are the values the FIRMWARE just reported (swl25h.live_*; `ok` bits as swr_kept_set:
+ * 2 bssid, 4 channel, 8 rssi; the BSSID is required). Sets kept.joined, clears kept_down and fires SWSTA_REV_ASSOC_DONE result 0 (kev 9, 2, 3, 4 incl. LINK_CHANGED isLinkDown 0), as swr_kept_announce does at the hand-over. The caller holds the radio mutex. No bus access.
+ * 1 = joined again and posted, 0 = refused (not DOWN, or no BSSID: a GAP) */
+static inline int swr_kept_up(struct swr *s, const uint8_t bssid[6], uint32_t channel, int32_t rssi, uint32_t ok)
+{
+	struct swsta_rev ev;
+
+	if (!s->kept_down || s->kept.ssid_len == 0 || bssid == NULL || (ok & 2u) == 0u) {
+		swr_gap(s, "kept link UP refused: the link was not DOWN, the SSID is not kept or the BSSID was not read");
+		return 0;
+	}
+	if (s->kept_bss_ok && !swr_same6(s->kept_bss.bssid, bssid)) { s->kept_bss_ok = 0; swr_gap(s, "kept link UP on another BSSID: the kept target record (IEs) is dropped"); }
+	SWSTA_MEMCPY(s->kept.bssid, bssid, 6);
+	if (ok & 4u) s->kept.channel = channel; else swr_gap(s, "kept link UP: channel not read from the firmware, the previous one stays");
+	if ((ok & 8u) && rssi < 0 && rssi >= -127) s->kept.rssi = rssi; else swr_gap(s, "kept link UP: RSSI not read from the firmware, the previous one stays");
+	s->kept.joined = 1;
+	s->kept_down = 0;
+	s->kept_up_n++;
+	if (s->cb.log) s->cb.log(s->cb.cx, "radio kept link: UP again (re-joined by the keep thread), joined set, ASSOC_DONE posted");
+	if (s->radio.up) { ev.kind = SWSTA_REV_ASSOC_DONE; ev.result = 0; ev.reason = 0; s->radio.up(s->radio.up_ctx, &ev); }
+	else swr_gap(s, "kept link UP: ASSOC_DONE not posted, no event callback set (swsta_init not run)");
+	return 1;
+}
+
+/* After swsta_init (the radio.up callback exists now): tell the station that the kept link is up, exactly as a finished join does (ASSOC_DONE result 0 -> kev 9, 2, 3, 4; Get 21 then answers success). 1 = posted. */
+static inline int swr_kept_announce(struct swr *s)
+{
+	struct swsta_rev ev;
+
+	if (!s->kept.joined) return 0;
+	if (!s->radio.up) { swr_gap(s, "kept link: ASSOC_DONE not posted, no event callback set (swsta_init not run)"); return 0; }
+	ev.kind = SWSTA_REV_ASSOC_DONE; ev.result = 0; ev.reason = 0;
+	s->radio.up(s->radio.up_ctx, &ev);
+	if (s->cb.log) s->cb.log(s->cb.cx, "radio kept link: ASSOC_DONE posted (wifid sees the boot-run link as joined; Get 21 answers success)");
+	return 1;
+}
+
+static inline void swr_init(struct swr *s, const struct swr_link *link, const struct swr_cb *cb)
+{
+	SWSTA_MEMSET(s, 0, sizeof *s);
+	if (link) s->link = *link;
+	if (cb) s->cb = *cb;
+	s->radio.power = swr_power; s->radio.scan_start = swr_scan_start; s->radio.bss_next = swr_bss_next; s->radio.bss_find = swr_bss_find;
+	s->radio.join = swr_join; s->radio.leave = swr_leave; s->radio.status = swr_status; s->radio.ctx = s;
+}
+
+static inline void swr_summary(struct swr *s)
+{
+	char l[160];
+	SWSTA_SNPRINTF(l, sizeof l, "radio scans=%u events=%u parsed=%u dup=%u dropped=%u ignored=%u partial=%u gaps=%u replaced=%u", (unsigned)s->scans, (unsigned)s->events,
+	    (unsigned)s->parsed, (unsigned)s->dup, (unsigned)s->dropped, (unsigned)s->ignored, (unsigned)s->partial, (unsigned)s->gaps, (unsigned)s->replaced);
+	if (s->cb.log) s->cb.log(s->cb.cx, l);
+	if (s->kept.joined) {
+		SWSTA_SNPRINTF(l, sizeof l, "radio kept joins_answered=%u refused=%u", (unsigned)s->kept_joins, (unsigned)s->kept_refused);
+		if (s->cb.log) s->cb.log(s->cb.cx, l);
+	}
+	if (s->ascan.request != NULL) {
+		SWSTA_SNPRINTF(l, sizeof l, "radio live scans requested=%u done=%u refused=%u fallback=%u bad_result=%u", (unsigned)s->live_req, (unsigned)s->live_done, (unsigned)s->live_refused, (unsigned)s->live_fallback, (unsigned)s->live_bad);
+		if (s->cb.log) s->cb.log(s->cb.cx, l);
+	}
+}
+
+#endif /* SWEET_WLAN_RADIO_H */
diff --git a/bsd/dev/sweet_wlan_a80211.c b/bsd/dev/sweet_wlan_a80211.c
new file mode 100644
index 0000000..ade16f0
--- /dev/null
+++ b/bsd/dev/sweet_wlan_a80211.c
@@ -0,0 +1,347 @@
+/*
+ * sweet_wlan_a80211.c - XNU glue of the Apple80211 ioctls and events on the Wi-Fi `en0` ifnet (patch 0201, T-7241; goal W-D7, research 110 s.3 and s.5).
+ * The logic is the host-tested bsd/dev/sweet_wlan_a80211.h (shim/sweet_wlan_a80211.h) over the station handler bsd/dev/sweet_wlan_sta.h; this file only
+ * supplies what the kernel provides: copyin/copyout of the user buffer behind req_data, one mutex, kev_post_msg_nowait, printf, and the if_ioctl hook.
+ * Not compiled against XNU here (CI builds the tree), not run on hardware. sweet_wlan_a80211_attach() takes any radio; sweet_wlan_a80211_radio_attach() (T-431f,
+ * called by sweet_wlan_en0_init after en0 is up) attaches the swsta_radio backend of sweet_wlan_radio.h with the 16.7 codec and an escan link that replays the
+ * ESCAN_RESULT events the boot-time G2 scan recorded (T-08fd, swr_replay_escan; the chip cannot scan again after the boot run). Without a recorded scan, or on a
+ * board without that G2 code, a scan is a counted, loud EIO with a WIFI GAP line and never an empty success.
+ */
+#include <sys/types.h>
+#include <sys/systm.h>
+#include <sys/errno.h>
+#include <sys/kern_event.h>
+#include <libkern/libkern.h>
+#include <kern/locks.h>
+#include <net/if.h>
+#include <net/if_var.h>
+#include <net/kpi_interface.h>
+
+#define SWSTA_MEMCPY memcpy
+#define SWSTA_MEMSET memset
+#define SWSTA_SNPRINTF snprintf
+#define SWSTA_MEMCMP memcmp
+#define SWSTA_PROBE_LOG(l) printf("SWEET PROBE: %s\n", (l))      /* patch 0363 (lowclk B3): the Set 383 key log of sweet_wlan_sta.h swsta_p383 */
+extern int sweet_probe_on(void);   /* patch 0363: bsd/dev/sweet_probe.c, boot-arg sweetprobe (0 / absent = off) */
+#include "sweet_wlan_sta.h"
+#include "sweet_wlan_a80211.h"
+#include "sweet_wlan_radio.h"
+
+static struct a80211 sw_a80211;
+static lck_mtx_t *sw_a80211_mtx;
+static ifnet_ioctl_func sw_a80211_prev;
+
+static int
+sw_a80211_copyin(void *ctx __unused, uint64_t uaddr, void *dst, uint32_t n)
+{
+	return copyin((user_addr_t)uaddr, dst, n);
+}
+
+static int
+sw_a80211_copyout(void *ctx __unused, const void *src, uint64_t uaddr, uint32_t n)
+{
+	return copyout(src, (user_addr_t)uaddr, n);
+}
+
+static void
+sw_a80211_lock(void *ctx __unused)
+{
+	lck_mtx_lock(sw_a80211_mtx);
+}
+
+static void
+sw_a80211_unlock(void *ctx __unused)
+{
+	lck_mtx_unlock(sw_a80211_mtx);
+}
+
+static int
+sw_a80211_kev(void *ctx __unused, const struct a80211_kev *k)
+{
+	struct kev_msg m;
+	uint32_t i;
+
+	bzero(&m, sizeof(m));
+	m.vendor_code = k->vendor;
+	m.kev_class = k->kclass;
+	m.kev_subclass = k->subclass;
+	m.event_code = k->code;
+	for (i = 0; i < k->n && i < 2; i++) {
+		m.dv[i].data_length = k->dv[i].len;
+		m.dv[i].data_ptr = (void *)(uintptr_t)k->dv[i].ptr;
+	}
+	return kev_post_msg_nowait(&m);          /* may be called from a radio thread: never wait */
+}
+
+static void
+sw_a80211_log(void *ctx __unused, const char *line)
+{
+	printf("SWEET WLAN: %s\n", line);
+}
+
+static void
+sw_a80211_gap(void *ctx __unused, const char *text)
+{
+	printf("WIFI GAP: %s\n", text);
+}
+
+static int
+sw_a80211_chain(void *ifp, unsigned long cmd, void *data)
+{
+	if (sw_a80211_prev == NULL) {
+		printf("WIFI GAP: A80211 chain has no previous if_ioctl: command 0x%lx refused\n", cmd);
+		return EOPNOTSUPP;
+	}
+	return (int)sw_a80211_prev((ifnet_t)ifp, cmd, data);
+}
+
+static errno_t
+sw_a80211_if_ioctl(ifnet_t ifp, unsigned long cmd, void *data)
+{
+	return (errno_t)a80211_if_ioctl(&sw_a80211, ifp, cmd, data);
+}
+
+/* Installs the A80211 handler in front of en0's own if_ioctl (SIOCGIFMEDIA, flags, multicast stay there). Call once, after sweet_wlan_en0_init() and before
+ * wifid starts. The radio and the codec stay owned by the caller. Returns 0, or a positive errno with a GAP line (nothing installed). */
+int
+sweet_wlan_a80211_attach(ifnet_t ifp, struct swsta_radio *radio, const struct swsta_codec *codec)
+{
+	static const struct a80211_io io = {
+		NULL, sw_a80211_copyin, sw_a80211_copyout, sw_a80211_lock, sw_a80211_unlock, sw_a80211_kev, sw_a80211_log, sw_a80211_gap
+	};
+	lck_grp_t *grp;
+
+	if (ifp == NULL || radio == NULL) {
+		printf("WIFI GAP: A80211 attach refused: no ifnet or no radio\n");
+		return EINVAL;
+	}
+	if (sw_a80211_mtx != NULL) {
+		printf("WIFI GAP: A80211 attach refused: already attached\n");
+		return EBUSY;
+	}
+	grp = lck_grp_alloc_init("sweet_a80211", LCK_GRP_ATTR_NULL);
+	sw_a80211_mtx = lck_mtx_alloc_init(grp, LCK_ATTR_NULL);
+	sw_a80211_prev = ifp->if_ioctl;
+	a80211_init(&sw_a80211, radio, codec, &io, if_name(ifp), sw_a80211_chain);
+	sw_a80211.sta.probe = sweet_probe_on() ? 1u : 0u;    /* patch 0363: boot-arg sweetprobe=1 logs the Set 383 property keys (names only); a80211_init zeroed it */
+	ifp->if_ioctl = sw_a80211_if_ioctl;
+	printf("SWEET WLAN: A80211 ioctl glue installed on %s (SIOCSA80211 0x%lx, SIOCGA80211 0x%lx)\n", if_name(ifp), A80211_SIOCS, A80211_SIOCG);
+	return 0;
+}
+
+static struct swr sw_radio;
+static struct swr sw_scan_tab;         /* patch 0292: the scratch table of the live scan; written ONLY by the keep thread (events, under the en0 lock) after sw_scan_req reset it, read by swr_scan_finish (the same thread, under the radio lock) */
+
+/* The escan link of the radio (T-08fd): the chip scan ran once inside the boot run (G2 L23, patch 0174), which recorded every ESCAN_RESULT event of our sync id; this replays them to the sink.
+ * The listing is the boot-time one (stale), a gap line says so on every scan. No bus access, no store, no wait (sweet_wlan_radio.h swr_replay_escan). The record is written by the synchronous boot path
+ * (sweet_wlan_init) and read here without a lock: sweet_wlan_en0_init, which attaches this radio, must run after sweet_wlan_init returned (T-4505 keeps that order). */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+extern int sweet_wlan_g2_escan_rec(uint32_t i, uint32_t *status, uint8_t *out, uint32_t cap);
+extern uint32_t sweet_wlan_g2_escan_lost(void);
+
+static const struct swr_replay sw_radio_replay = { sweet_wlan_g2_escan_rec, sweet_wlan_g2_escan_lost, sw_a80211_gap, NULL };
+#else
+/* a board without the G2 scan code (sweet_wlan.c is SWEET only): no record to replay, the scan is refused loudly */
+static int
+sw_radio_no_rec(uint32_t i __unused, uint32_t *status __unused, uint8_t *out __unused, uint32_t cap __unused)
+{
+	return 0;
+}
+
+static const struct swr_replay sw_radio_replay = { sw_radio_no_rec, NULL, sw_a80211_gap, NULL };
+#endif
+
+/* patch 0292 (WIFI-COVERAGE D3/D4): the LIVE scan of the kept link. sw_scan_req is the radio's ascan.request (called by swr_scan_start under the handler's lock, i.e. from the iOS ioctl thread): it empties the scratch table and asks the keep thread (sweet_wlan.c
+ * sweet_wlan_keep_scan_request: one flag, no engine access, no lock). The keep thread feeds every ESCAN_RESULT event to sweet_wlan_a80211_scan_event (the sink: swr_event on the scratch table, same parser as the replay, no SSID or BSSID in any log line) and, when the scan ended,
+ * calls sweet_wlan_a80211_scan_done outside its en0 lock; that takes the handler's lock (the order the keep thread uses for every call into this file) and swr_scan_finish swaps the list in and posts SCAN_DONE. */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+extern int sweet_wlan_keep_scan_request(void);      /* bsd/dev/sweet_wlan.c (patch 0292): 0 accepted, else a positive errno (6 = scan off, 50 = link not UP, 16 = busy) */
+#else
+static int
+sweet_wlan_keep_scan_request(void)
+{
+	return 6;       /* a board without the G2 engine (sweet_wlan.c is SWEET only): no live scan */
+}
+#endif
+
+static int
+sw_scan_req(void *cx __unused)
+{
+	swr_tab_reset(&sw_scan_tab);
+	return sweet_wlan_keep_scan_request();
+}
+
+/* Attach point of the en0 path: puts the swsta_radio backend behind the A80211 handler on `ifp`. Returns 0 or a positive errno (GAP line, nothing installed). */
+int
+sweet_wlan_a80211_radio_attach(ifnet_t ifp)
+{
+	static const struct swr_link link = SWR_REPLAY_LINK(&sw_radio_replay);
+	static const struct swr_cb cb = { sw_a80211_log, sw_a80211_gap, NULL };
+
+	if (sw_a80211_mtx != NULL) {      /* before swr_init: a second attach must not wipe the live radio (review T-431f MEDIUM 1) */
+		printf("WIFI GAP: A80211 radio attach refused: already attached\n");
+		return EBUSY;
+	}
+	swr_init(&sw_radio, &link, &cb);
+	return sweet_wlan_a80211_attach(ifp, &sw_radio.radio, NULL);
+}
+
+/* 2026-11-11 (W-D3-weak-security, patch 0293): the join target's own record (IEs, rates, beacon, noise, SNR, chanspec) as the boot scan read it, handed over by the hook (sw_keep_capture) BEFORE the radio is attached. Stored here, outside sw_radio
+ * (swr_init wipes that), and applied by sweet_wlan_a80211_radio_attach_kept right after swr_kept_set, so Get 103 carries the real IEs from its first answer (Settings snapshots the record once). Not secret. */
+static struct {
+	uint8_t ok, bssid[6], ie_short, nrates, rates[16];
+	uint16_t chspec, beacon;
+	int16_t noise, snr;
+	uint32_t ie_len;
+	uint8_t ie[1024];
+} sw_kept_tgt;
+
+void
+sweet_wlan_a80211_kept_target(const uint8_t *bssid, const uint8_t *ie, uint32_t ie_len, uint32_t ie_short, uint32_t chspec, uint32_t beacon, int32_t noise, int32_t snr, const uint8_t *rates, uint32_t nrates)
+{
+	memset(&sw_kept_tgt, 0, sizeof sw_kept_tgt);
+	if (bssid == NULL || ie_len > sizeof sw_kept_tgt.ie || nrates > sizeof sw_kept_tgt.rates) {
+		printf("WIFI GAP: A80211 kept target record refused (no BSSID or too long), Get 103 will carry no IEs\n");
+		return;
+	}
+	memcpy(sw_kept_tgt.bssid, bssid, 6);
+	if (ie_len != 0 && ie != NULL) {
+		memcpy(sw_kept_tgt.ie, ie, ie_len);
+		sw_kept_tgt.ie_len = ie_len;
+	}
+	if (nrates != 0 && rates != NULL) {
+		memcpy(sw_kept_tgt.rates, rates, nrates);
+		sw_kept_tgt.nrates = (uint8_t)nrates;
+	}
+	sw_kept_tgt.ie_short = (uint8_t)ie_short;
+	sw_kept_tgt.chspec = (uint16_t)chspec; sw_kept_tgt.beacon = (uint16_t)beacon;
+	sw_kept_tgt.noise = (int16_t)noise; sw_kept_tgt.snr = (int16_t)snr;
+	sw_kept_tgt.ok = 1;
+}
+
+/* W-UI (sprint 2026-11-08, xnu patch 0268 keep mode): the same attach for the case that the boot run's link is still up. `ssid`, `bssid`, `channel`, `rssi` are what the FIRMWARE reported after L26
+ * (sweet_wlan_l25_hs.h swl25_live, copied by the caller before the engine record is reused); `ok` says which were read (1 ssid, 2 bssid, 4 channel, 8 rssi). Read once, not refreshed (a GAP says so). The radio then answers joined (sweet_wlan_radio.h swr_kept_set), the station is told so (ASSOC_DONE -> kev 9, 2, 3, 4)
+ * once the handler is installed. Prints the install line of sweet_wlan_a80211_attach and `SWEET WLAN: A80211 kept link announced` on success; any refusal is a WIFI GAP and nothing is announced. Returns 0 or a positive errno. */
+int
+sweet_wlan_a80211_radio_attach_kept(ifnet_t ifp, const uint8_t *ssid, uint32_t ssid_len, const uint8_t *bssid, uint32_t channel, int32_t rssi, uint32_t ok)
+{
+	static const struct swr_link link = SWR_REPLAY_LINK(&sw_radio_replay);
+	static const struct swr_cb cb = { sw_a80211_log, sw_a80211_gap, NULL };
+	int rc;
+
+	if (sw_a80211_mtx != NULL) {
+		printf("WIFI GAP: A80211 radio attach refused: already attached\n");
+		return EBUSY;
+	}
+	swr_init(&sw_radio, &link, &cb);
+	swr_init(&sw_scan_tab, NULL, &cb);      /* patch 0292: the scratch table of the live scan; its gap lines (a record dropped, a bad event) print through the same callbacks */
+	swr_ascan_set(&sw_radio, sw_scan_req, NULL);      /* patch 0292: in keep mode Set 10 scans live; the replay link above is the fallback when the live scan is off */
+	(void)swr_kept_set(&sw_radio, ssid, ssid_len, bssid, channel, rssi, ok);      /* before the handler: swsta_init reads the power flag (on) */
+	if (sw_kept_tgt.ok) {      /* patch 0293: the join target's record, so that the very first Get 103 carries its IEs */
+		(void)swr_kept_target(&sw_radio, sw_kept_tgt.bssid, sw_kept_tgt.ie, sw_kept_tgt.ie_len, sw_kept_tgt.ie_short, sw_kept_tgt.chspec, sw_kept_tgt.beacon, sw_kept_tgt.noise, sw_kept_tgt.snr, sw_kept_tgt.rates, sw_kept_tgt.nrates);
+		memset(&sw_kept_tgt, 0, sizeof sw_kept_tgt);
+	} else {
+		swr_gap(&sw_radio, "no kept target record was handed over: Get 103 carries no IEs, Settings will show Weak Security");
+	}
+	if (!sw_radio.kept.joined) {
+		printf("WIFI GAP: A80211 kept attach: the boot link is unknown, the radio answers not joined\n");
+	}
+	rc = sweet_wlan_a80211_attach(ifp, &sw_radio.radio, NULL);
+	if (rc == 0 && swr_kept_announce(&sw_radio)) {
+		printf("SWEET WLAN: A80211 kept link announced on %s (Get 1/9/4/16/103/21 answer joined, join of the same SSID answers success)\n", if_name(ifp));
+	}
+	return rc;
+}
+
+/* The sink of the keep thread's ESCAN_RESULT events (sweet_wlan_g2.h swg_ke_escan): called with the en0 lock held, never with the handler's lock, from the keep thread only. status, the 12 B wl_escan_result header and the first record bytes, as swr_event wants them. */
+void
+sweet_wlan_a80211_scan_event(uint32_t status, const uint8_t *res, uint32_t len)
+{
+	swr_event(&sw_scan_tab, status, res, len);
+}
+
+/* The keep thread's live scan ended (kind SWR_SCAN_*, how long, ESCAN_RESULT events of ours): swap the collected list in and post SCAN_DONE. Outside the en0 lock. 0 = delivered, EINVAL = refused (GAP printed) */
+int
+sweet_wlan_a80211_scan_done(uint32_t kind, uint32_t ms, uint32_t ev)
+{
+	int r;
+
+	if (sw_a80211_mtx == NULL) {
+		printf("WIFI GAP: A80211 live scan done: no radio attached, iOS is not told\n");
+		return EINVAL;
+	}
+	lck_mtx_lock(sw_a80211_mtx);
+	r = swr_scan_finish(&sw_radio, &sw_scan_tab, kind, ms, ev);
+	lck_mtx_unlock(sw_a80211_mtx);
+	return r ? 0 : EINVAL;
+}
+
+/* Part A (sprint-wifi 2026-11-09, xnu patch 0273 keep thread): the firmware's current RSSI for the kept link, taken under the handler's lock (the ioctl path reads it there). 0 = taken, EINVAL = refused (GAP) */
+int
+sweet_wlan_a80211_kept_rssi(int32_t rssi)
+{
+	int ok;
+
+	if (sw_a80211_mtx == NULL) {
+		printf("WIFI GAP: A80211 kept RSSI refresh: no radio attached\n");
+		return EINVAL;
+	}
+	lck_mtx_lock(sw_a80211_mtx);
+	ok = swr_kept_rssi(&sw_radio, rssi);
+	lck_mtx_unlock(sw_a80211_mtx);
+	return ok ? 0 : EINVAL;
+}
+
+/* patch 0281 (W-D6 boot A, called by the keep thread outside the en0 lock): the keep thread's link-loss detector says the AP link is DOWN. Under the handler's lock (the ioctl path holds it when it reads the radio): swr_kept_clear clears kept.joined
+ * (Get 103 then answers not joined) and fires SWSTA_REV_LINK_DOWN (wifid gets LINK_CHANGED with isLinkDown = 1). `up` != 0 is refused: the UP side has its own call, sweet_wlan_a80211_kept_up (patch 0282), because it carries the values the firmware reported.
+ * No firmware command, no bus access. 0 = done, EINVAL = refused or nothing to clear (GAP printed) */
+int
+sweet_wlan_a80211_kept_link(int up)
+{
+	int ok;
+
+	if (up != 0) {
+		printf("WIFI GAP: A80211 kept link: UP goes through sweet_wlan_a80211_kept_up, not posted\n");
+		return EINVAL;
+	}
+	if (sw_a80211_mtx == NULL) {
+		printf("WIFI GAP: A80211 kept link DOWN: no radio attached, iOS is not told\n");
+		return EINVAL;
+	}
+	lck_mtx_lock(sw_a80211_mtx);
+	ok = swr_kept_clear(&sw_radio, 1);
+	lck_mtx_unlock(sw_a80211_mtx);
+	if (!ok) {
+		printf("WIFI GAP: A80211 kept link DOWN: the radio was not kept-joined or is already down, nothing posted\n");
+	}
+	return ok ? 0 : EINVAL;
+}
+
+/* patch 0282 (W-D6 boot B, called by the keep thread outside the en0 lock): the re-join is done. Under the handler's lock: swr_kept_up stores the BSSID / channel / RSSI the firmware reported (ok bits as swl25h.live_ok), sets kept.joined and fires SWSTA_REV_ASSOC_DONE result 0
+ * (kev 9, 2, 3, 4: LINK_CHANGED isLinkDown 0). No firmware command, no bus access. 0 = done, EINVAL = refused (GAP printed) */
+int
+sweet_wlan_a80211_kept_up(const uint8_t *bssid, uint32_t channel, int32_t rssi, uint32_t ok)
+{
+	int r;
+
+	if (sw_a80211_mtx == NULL) {
+		printf("WIFI GAP: A80211 kept link UP: no radio attached, iOS is not told\n");
+		return EINVAL;
+	}
+	lck_mtx_lock(sw_a80211_mtx);
+	r = swr_kept_up(&sw_radio, bssid, channel, rssi, ok);
+	lck_mtx_unlock(sw_a80211_mtx);
+	if (!r) {
+		printf("WIFI GAP: A80211 kept link UP: refused by the radio (see the line above), nothing posted\n");
+	}
+	return r ? 0 : EINVAL;
+}
+
+void
+sweet_wlan_a80211_summary(void)
+{
+	swr_summary(&sw_radio);
+	swsta_summary(&sw_a80211.sta);
+	printf("SWEET WLAN: A80211 glue reqs=%u faults=%u big=%u bad=%u chained=%u ev_posted=%u ev_failed=%u\n", sw_a80211.reqs, sw_a80211.faults,
+	    sw_a80211.big, sw_a80211.bad, sw_a80211.chained, sw_a80211.ev_posted, sw_a80211.ev_failed);
+}
