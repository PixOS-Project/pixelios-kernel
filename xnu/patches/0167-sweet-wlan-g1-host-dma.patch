diff --git a/bsd/dev/sweet_wlan_dma.h b/bsd/dev/sweet_wlan_dma.h
new file mode 100644
--- /dev/null
+++ b/bsd/dev/sweet_wlan_dma.h
@@ -0,0 +1,184 @@
+/*
+ * BCM4389 msgbuf host DMA block, run G1 (docs/research/83-wlan-g1-host-dma-spec.md): the pure part, host-tested by shim/wlan_dma_host_test.c and killed by
+ * tools/test_wlan_dma_mutants.py. No libc, no device access, no allocation: swl_dma_plan() lays out the five common rings, the
+ * 8-byte scratch buffer and the four DMA index arrays inside ONE block, swd_audit() is dhd_dma_buf_audit() plus the alignment
+ * and padding rules of this port. The kernel glue (sweet_wlan_g1() in sweet_wlan.c) allocates and prints; nothing here or there
+ * writes to the chip.
+ * Keys: G = dhd_msgbuf.c, H = bcmmsgbuf.h, P = dhd_pcie.c of ~/pixelios-artifacts/refs/wlan-stage5.
+ */
+#ifndef SWEET_WLAN_DMA_H
+#define SWEET_WLAN_DMA_H
+
+#include <stdint.h>
+
+#define SWD_PAD         128u    /* DHD_DMA_PAD, G:370-372; dhd_dma_buf_alloc pads every buffer to it, G:1887-1893 */
+#define SWD_PAGE        16384u  /* this port runs 16K pages (patch 0004:227, 0010:128; PAGE_SIZE = 1 << ARM_PGSHIFT 14); the block is page aligned and a whole number of pages (kmem_alloc_contig, patch 0028) */
+#define SWD_TRAP_LEN    4096u   /* host_trap_addr buffer: 4096 B, 4 KiB aligned PA in the golden (0xff2e0000) [R94 s.2 step 3]; a 4 KiB offset inside the 16K aligned block keeps that */
+#define SWD_EVBUF_LEN   8192u   /* W-D4b D-10: the one event buffer the first ring-0 post names; the DHD size is not known yet [guess], G2 prints a WIFI GAP for it */
+#define SWD_EVBUF_N     8u      /* W-D4e (sweetwlan>=21): 8 event buffers of SWD_EVBUF_LEN each, contiguous (DHD posts 32: DHD_FLOWRING_MAX_EVENTBUF_POST, dhd_msgbuf.c:152, 4283-4286; 8 is what Linux posts and the minimum of docs/research/108 s.4 step 1: the shortfall is a WIFI GAP) */
+#define SWD_EVBUF_ALIGN 4096u   /* W-D4b D-10: 4 KiB aligned PA like the trap page; sits in the slack after the trap page (167936..180224 of the 11 x 16 KiB allocation) [SPEC-WIFI D-10] */
+#define SWD_RESPBUF_LEN 8192u   /* W-D4d: the one ioctl-response buffer (DHD_FLOWRING_IOCTL_BUFPOST_PKTSZ 8192, refs/wlan-stage5/dhd_msgbuf.c:149; host_buf_len = PKTLEN of it, dhd_msgbuf.c:6383-6385) */
+#define SWD_IOCTBUF_LEN 8200u   /* W-D4d: the ioctl request payload buffer (IOCT_RETBUF_SIZE = RX_DMA_OFFSET 8 + WLC_IOCTL_MAXLEN 8192, dhd_msgbuf.c:122-123, wlioctl_defs.h.new:667; allocated at dhd_msgbuf.c:3582); padded to SWD_PAD in the plan */
+#define SWD_RESPBUF_N   8u      /* W-D4e (sweetwlan>=21): 8 ioctl-response buffers of SWD_RESPBUF_LEN each, contiguous (DHD_FLOWRING_MAX_IOCTLRESPBUF_POST 8, dhd_msgbuf.c:153, 4286) */
+#define SWD_D4D_ALIGN   4096u   /* W-D4d: both buffers 4 KiB aligned like the trap page and the event buffer [guess, U4 of docs/research/W-D4d-ioctl-get-version.md s.7: DHD only logs a misalignment below 4 B, dhd_msgbuf.c:10914-10915] */
+#define SWD_MAX_RINGS   256u    /* sanity bound on a ring count read from ring_info (u16 there); observed 43 and 4 (run F3) */
+
+/* Inputs pinned from run F3 (wlan-runF3-0136, observed): shared flags 0x70050107 has PCIE_SHARED_2BYTE_INDICES (0x100000) clear -> rw_index_sz 4 (P:13771-13772);
+ * ring_info max_submission_queues 43 and max_completion_rings 4 (P:13889-13890). G1 does not re-read them (a swl_gap says so); G2 reads them from the dongle and compares. */
+#define SWD_RW_INDEX_SZ 4u
+#define SWD_MAX_SUB     43u
+#define SWD_MAX_CPL     4u
+
+enum {
+	SWD_H2D_CTRL,   /* H2D control submission ring, ring 0 */
+	SWD_H2D_RXP,    /* H2D rxpost, ring 1 */
+	SWD_D2H_CTRL,   /* D2H control completion, ring 2 */
+	SWD_D2H_TXC,    /* D2H tx completion, ring 3 */
+	SWD_D2H_RXC,    /* D2H rx completion, ring 4 */
+	SWD_SCRATCH,    /* D2H scratch buffer */
+	SWD_IDX_H2D_W,  /* DMA index array: H2D write (host updates) */
+	SWD_IDX_H2D_R,  /* H2D read (dongle updates) */
+	SWD_IDX_D2H_W,  /* D2H write (dongle updates) */
+	SWD_IDX_D2H_R,  /* D2H read (host updates) */
+	SWD_TRAP,       /* host firmware-trap buffer: 4096 B at a 4 KiB aligned offset (R94 step 3: host_trap_addr, S+0x58) */
+	SWD_EVBUF,      /* W-D4b D-10: SWD_EVBUF_N (W-D4e: 8) event buffers of SWD_EVBUF_LEN B at a 4 KiB aligned offset right after the trap page */
+	SWD_RESPBUF,    /* W-D4d: SWD_RESPBUF_N (W-D4e: 8) ioctl-response buffers of SWD_RESPBUF_LEN B at the next 4 KiB aligned offset (sweetwlan >= 17) */
+	SWD_IOCTBUF,    /* W-D4d: ioctl request payload buffer, SWD_IOCTBUF_LEN B (padded) at the next 4 KiB aligned offset (sweetwlan >= 18) */
+	SWD_NBUF
+};
+
+struct swd_buf {
+	const char *name;
+	uint32_t off;   /* from the block start, multiple of SWD_PAD */
+	uint32_t len;   /* padded to SWD_PAD */
+};
+
+struct swd_plan {
+	struct swd_buf b[SWD_NBUF];
+	uint32_t total; /* end of the last buffer (the trap page and the event buffer are 4 KiB aligned, so this can exceed the sum of len) */
+};
+
+/* Ring depth x item size: depth is a host choice (dhd_prot_ring_init, G:11080-11103), the constants are DHD's: G:3525-3528 / H:60,93; G:3534-3537 / H:59,90; G:3543-3546 / H:70,104;
+ * G:3552-3555 / H:62,91; G:3562-3565 / H:63,92. Scratch: DMA_D2H_SCRATCH_BUF_LEN 8, G:140. */
+/* sprint 2026-11-08: the ring depths as constants, the ONE source the engines (sweet_wlan_g2.h SWG_R0_DEPTH / SWG_R2_DEPTH) and the host tests' copies are checked against */
+#define SWD_R0_ITEMS    128u    /* h2d ctrl submit */
+#define SWD_R1_ITEMS    2048u   /* h2d rxpost */
+#define SWD_R2_ITEMS    64u     /* d2h ctrl complete */
+#define SWD_R3_ITEMS    2048u   /* d2h tx complete */
+#define SWD_R4_ITEMS    1024u   /* d2h rx complete */
+
+struct swd_ring {
+	const char *name;
+	uint32_t items, isz;
+};
+
+static const struct swd_ring swd_rings[SWD_SCRATCH + 1] = {
+	{ "h2d ctrl submit", SWD_R0_ITEMS, 40 },
+	{ "h2d rxpost", SWD_R1_ITEMS, 32 },
+	{ "d2h ctrl complete", SWD_R2_ITEMS, 24 },
+	{ "d2h tx complete", SWD_R3_ITEMS, 24 },
+	{ "d2h rx complete", SWD_R4_ITEMS, 40 },
+	{ "scratch", 1, 8 },
+};
+
+static inline uint32_t
+swd_pad(uint32_t n)
+{
+	return (n + SWD_PAD - 1u) / SWD_PAD * SWD_PAD;
+}
+
+/* The layout. rw_index_sz is 2 or 4 (P:13771); the h2d arrays hold max_sub entries, the d2h arrays max_cpl (P:13925-13945; bufsz = rw_index_sz * length, G:12148-12151).
+ * 0 ok; -1 rw_index_sz is not 2 or 4; -2 a ring count is 0 or above SWD_MAX_RINGS; -3 NULL plan. */
+static inline int
+swd_plan_make(uint32_t rw_index_sz, uint32_t max_sub, uint32_t max_cpl, struct swd_plan *p)
+{
+	static const char *const idx_name[4] = { "idx h2d wr", "idx h2d rd", "idx d2h wr", "idx d2h rd" };
+	uint32_t off = 0, len;
+	unsigned i;
+
+	if (!p) {
+		return -3;
+	}
+	if (rw_index_sz != 2u && rw_index_sz != 4u) {
+		return -1;
+	}
+	if (max_sub == 0 || max_sub > SWD_MAX_RINGS || max_cpl == 0 || max_cpl > SWD_MAX_RINGS) {
+		return -2;
+	}
+	for (i = 0; i < SWD_NBUF; i++) {
+		if (i == SWD_TRAP) {
+			off = (off + SWD_TRAP_LEN - 1u) / SWD_TRAP_LEN * SWD_TRAP_LEN;
+			len = SWD_TRAP_LEN;
+			p->b[i].name = "trap";
+		} else if (i == SWD_EVBUF) {
+			off = (off + SWD_EVBUF_ALIGN - 1u) / SWD_EVBUF_ALIGN * SWD_EVBUF_ALIGN;
+			len = SWD_EVBUF_N * SWD_EVBUF_LEN;
+			p->b[i].name = "evbuf";
+		} else if (i == SWD_RESPBUF || i == SWD_IOCTBUF) {
+			off = (off + SWD_D4D_ALIGN - 1u) / SWD_D4D_ALIGN * SWD_D4D_ALIGN;
+			len = i == SWD_RESPBUF ? SWD_RESPBUF_N * SWD_RESPBUF_LEN : swd_pad(SWD_IOCTBUF_LEN);
+			p->b[i].name = i == SWD_RESPBUF ? "respbuf" : "ioctbuf";
+		} else if (i <= SWD_SCRATCH) {
+			len = swd_pad(swd_rings[i].items * swd_rings[i].isz);
+			p->b[i].name = swd_rings[i].name;
+		} else {
+			len = swd_pad(rw_index_sz * ((i == SWD_IDX_H2D_W || i == SWD_IDX_H2D_R) ? max_sub : max_cpl));
+			p->b[i].name = idx_name[i - SWD_IDX_H2D_W];
+		}
+		p->b[i].off = off;
+		p->b[i].len = len;
+		off += len;
+	}
+	p->total = off;
+	return 0;
+}
+
+/* dhd_dma_buf_audit() (G:1848-1865) + this port's rules. 0 ok; 1 pa is 0; 2 pa not aligned to `align` (a power of two); 3 len is 0 or not a multiple of SWD_PAD;
+ * 4 the 32-bit end address wraps (the dongle uses 32-bit pointer arithmetic: DHD tests `(uint32)(pa_lo + len) < pa_lo`, so an end at exactly 4 GiB is refused too). */
+static inline int
+swd_audit(uint64_t pa, uint32_t len, uint32_t align)
+{
+	uint32_t lo = (uint32_t)pa;
+
+	if (pa == 0) {
+		return 1;
+	}
+	if ((pa & (uint64_t)(align - 1u)) != 0) {
+		return 2;
+	}
+	if (len == 0 || len % SWD_PAD != 0) {
+		return 3;
+	}
+	if ((uint32_t)(lo + len) < lo) {
+		return 4;
+	}
+	return 0;
+}
+
+/* The block is physically contiguous when the last page lies exactly (sz - page) bytes after the first. 0 yes; 1 no (also sz 0 or not a whole number of pages). */
+static inline int
+swd_contig(uint64_t pa_first, uint64_t pa_last, uint64_t sz, uint32_t page)
+{
+	if (sz == 0 || sz % page != 0) {
+		return 1;
+	}
+	return pa_last == pa_first + sz - page ? 0 : 1;
+}
+
+/* Audit of the whole block and of every planned sub-buffer at pa + off. 0 ok, else the first swd_audit() code. */
+static inline int
+swd_audit_all(uint64_t pa, uint32_t sz, const struct swd_plan *p)
+{
+	int rc = swd_audit(pa, sz, SWD_PAGE);
+	unsigned i;
+
+	for (i = 0; rc == 0 && i < SWD_NBUF; i++) {
+		rc = swd_audit(pa + p->b[i].off, p->b[i].len, i == SWD_TRAP ? SWD_TRAP_LEN : i == SWD_EVBUF ? SWD_EVBUF_ALIGN : (i == SWD_RESPBUF || i == SWD_IOCTBUF) ? SWD_D4D_ALIGN : SWD_PAD);
+	}
+	if (rc == 0 && p->total > sz) {
+		rc = 3;         /* the plan does not fit the block */
+	}
+	return rc;
+}
+
+#endif /* SWEET_WLAN_DMA_H */
