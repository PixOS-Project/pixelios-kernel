@@ -373,14 +373,40 @@
 } sweet_priv_logged[SWEET_PRIV_LOG_MAX];
 static int sweet_priv_logged_count;
 
+/*
+ * Network privileges the real Sandbox/AMFI grant by entitlement; the closed
+ * entitlement-to-privilege map is not in the xnu source, so this stand-in
+ * grants exactly these two privileges to the daemons that were denied them
+ * (socket delegate 10001, network statistics 10003 seen denied in boot logs),
+ * keyed on the process name (p_name, set from the executable: spoofable). Anything else stays denied and logged.
+ */
+static const struct {
+	int         priv;
+	const char *name;
+} sweet_priv_net_grants[] = {
+	{ PRIV_NET_PRIVILEGED_SOCKET_DELEGATE, "kernel_task" },
+	{ PRIV_NET_PRIVILEGED_SOCKET_DELEGATE, "dasd" },
+	{ PRIV_NET_PRIVILEGED_SOCKET_DELEGATE, "cloudd" },
+	{ PRIV_NET_PRIVILEGED_SOCKET_DELEGATE, "tipsd" },
+	{ PRIV_NET_PRIVILEGED_SOCKET_DELEGATE, "itunesstored" },
+	{ PRIV_NET_PRIVILEGED_SOCKET_DELEGATE, "dataaccessd" },
+	{ PRIV_NET_PRIVILEGED_NETWORK_STATISTICS, "symptomsd" },
+};
+
 static int
-sweet_sandbox_priv_grant(kauth_cred_t cred __unused, int priv)
