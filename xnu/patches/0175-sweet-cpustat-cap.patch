+/* Fill cs_watch_names from a comma list; every name that is empty, too long or over CS_WATCH_MAX is a loud GAP (rule 8). */
+static void
+cs_parse_watch(char *watch)
+{
+	for (char *t = watch; *t;) {
+		char *end = strchr(t, ',');
+		size_t tl = end ? (size_t)(end - t) : strlen(t);
+		if (tl == 0 || tl >= sizeof(cs_watch_names[0]) || cs_watch_n >= CS_WATCH_MAX) {
+			printf("SWEET GAP: CPUSTAT sweetcpuwatch name %d (len %lu) not watched (%s; max %d names of < %lu chars)\n",
+			    cs_watch_n, (unsigned long)tl, cs_watch_n >= CS_WATCH_MAX ? "list full" : "bad length", CS_WATCH_MAX,
+			    (unsigned long)sizeof(cs_watch_names[0]));
+		} else {
+			strlcpy(cs_watch_names[cs_watch_n], t, tl + 1);
+			cs_watch_n++;
+		}
+		if (!end) {
+			break;
+		}
+		t = end + 1;
+	}
+	if (cs_watch_n == 0) {
+		printf("SWEET GAP: CPUSTAT sweetcpuwatch \"%s\" gives no name: only pid 1 is printed outside the cap\n", watch);
+	} else {
+		printf("CPUSTAT watching %d names from \"%s\" (max %d)\n", cs_watch_n, watch, CS_WATCH_MAX);
+	}
+}
